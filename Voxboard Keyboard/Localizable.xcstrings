            "value": "Transkript gespeichert, aber der verbleibende Text konnte nicht sicher eingefügt werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript saved, but the remaining text could not be safely inserted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El transcripto se salvó, pero el texto restante no pudo ser insertado de forma segura"
          }
        },
        "fr": {
          "stringUnit": {
