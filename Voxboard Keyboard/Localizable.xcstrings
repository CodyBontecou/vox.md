    "Tap the mic and speak — words appear here as you talk.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الميكروفون وتحدث — تظهر الكلمات هنا أثناء حديثك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইকে ট্যাপ করে বলুন — বলার সঙ্গে সঙ্গে শব্দ এখানে দেখাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe aufs Mikro und sprich – die Wörter erscheinen hier, während du redest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the mic and speak — words appear here as you talk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el micro y habla: las palabras aparecen aquí mientras hablas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le micro et parlez — les mots s’affichent ici au fil de votre voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक पर टैप करें और बोलें — बोलते ही शब्द यहाँ दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk mikrofon dan bicara — kata muncul di sini saat Anda berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il microfono e parla: le parole appaiono qui mentre parli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクをタップして話すと、話した言葉がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 탭하고 말하세요 — 말하는 대로 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de microfoon en spreek — de woorden verschijnen hier terwijl je praat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij mikrofon i mów — słowa pojawią się tutaj w trakcie mówienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no microfone e fale — as palavras aparecem aqui enquanto você fala."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на микрофон и говорите — слова появляются здесь по ходу речи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்கைத் தட்டிப் பேசுங்கள் — பேசும்போதே சொற்கள் இங்கே தோன்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะไมค์แล้วพูด — คำจะปรากฏที่นี่ขณะที่คุณพูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofona dokunup konuşun — sözcükler siz konuştukça burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться мікрофона й говоріть — слова з’являються тут під час мовлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیک پر ٹیپ کریں اور بولیں — بولتے ہی الفاظ یہاں ظاہر ہوں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm micrô và nói — chữ sẽ hiện ở đây khi bạn nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点麦克风开始说话 — 文字会随着你说话显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下麥克風開始說話 — 文字會隨著你說話顯示在這裡。"
          }
        }
      }
    },
    "Tap the mic to open Vox.md and start listening.": {
      "localizations": {
        "ar": {
