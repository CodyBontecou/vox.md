    "Limit reached — open Vox.md to unlock": {
      "comment": "Error status shown in the keyboard toolbar when the free-tier limit is hit",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الوصول إلى الحد — افتح Vox.md لإلغاء القفل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমা পূর্ণ — আনলক করতে Vox.md খুলুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit erreicht – Vox.md öffnen zum Freischalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit reached — open Vox.md to unlock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite alcanzado — abre Vox.md para desbloquear"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite atteinte — ouvrez Vox.md pour débloquer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा पूरी हो गई — अनलॉक करने के लिए Vox.md खोलें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas tercapai — buka Vox.md untuk membuka"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite raggiunto — apri Vox.md per sbloccare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限に達しました — Vox.md を開いて解除してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도에 도달했습니다 — 잠금을 해제하려면 Vox.md를 여세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiet bereikt — open Vox.md om te ontgrendelen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto limit — otwórz Vox.md, aby odblokować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite atingido — abra o Vox.md para desbloquear"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит достигнут — откройте Vox.md, чтобы разблокировать"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரம்பு எட்டியது — திறக்க Vox.md ஐத் திறக்கவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถึงขีดจำกัดแล้ว — เปิด Vox.md เพื่อปลดล็อก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınıra ulaşıldı — kilidi açmak için Vox.md'u açın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ліміт досягнуто — відкрийте Vox.md, щоб розблокувати"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حد مکمل ہو گئی — غیر مقفل کرنے کے لیے Vox.md کھولیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đạt giới hạn — mở Vox.md để mở khóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达上限 — 打开 Vox.md 以解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已達上限 — 開啟 Vox.md 解鎖"
          }
        }
      }
    },
