    "Allow Full Access for Vox.md in Settings › Keyboards to dictate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول الكامل لـ Vox.md في الإعدادات › لوحات المفاتيح للإملاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিক্টেশনের জন্য সেটিংস › কীবোর্ড-এ Vox.md-এর পূর্ণ অ্যাক্সেস চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Vollzugriff für Vox.md unter Einstellungen › Tastaturen, um zu diktieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Full Access for Vox.md in Settings › Keyboards to dictate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso completo a Vox.md en Ajustes › Teclados para dictar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès complet pour Vox.md dans Réglages › Claviers pour dicter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिक्टेट करने के लिए सेटिंग्स › कीबोर्ड में Vox.md को पूर्ण ऐक्सेस दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Akses Penuh untuk Vox.md di Pengaturan › Papan Ketik untuk mendikte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso completo a Vox.md in Impostazioni › Tastiere per dettare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力するには、設定 › キーボードで Vox.md のフルアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기하려면 설정 › 키보드에서 Vox.md의 전체 접근을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta volledige toegang toe voor Vox.md in Instellingen › Toetsenborden om te dicteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na pełny dostęp dla Vox.md w Ustawienia › Klawiatury, aby dyktować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso total ao Vox.md em Ajustes › Teclados para ditar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите полный доступ для Vox.md в Настройки › Клавиатуры, чтобы диктовать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டிக்டேட் செய்ய அமைப்புகள் › விசைப்பலகைகளில் Vox.md-க்கு முழு அணுகலை அனுமதிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงเต็มรูปแบบสำหรับ Vox.md ในการตั้งค่า › แป้นพิมพ์ เพื่อพูดป้อนข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte etmek için Ayarlar › Klavyeler’de Vox.md’ye Tam Erişim verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте повний доступ для Vox.md у Параметри › Клавіатури, щоб диктувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈکٹیشن کے لیے سیٹنگز › کی بورڈز میں Vox.md کو مکمل رسائی دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Truy cập đầy đủ cho Vox.md trong Cài đặt › Bàn phím để đọc chính tả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”›“键盘”中允许 Vox.md 完全访问以进行听写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」›「鍵盤」中允許 Vox.md 完整取用權限以進行聽寫。"
          }
        }
      }
    },
