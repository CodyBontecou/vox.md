    "Transcription timed out — try again": {
      "comment": "Error status shown in the keyboard toolbar when transcription takes too long",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة التفريغ — حاول مرة أخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সক্রিপশন টাইম আউট — আবার চেষ্টা করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei der Transkription – versuchen Sie es erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription timed out — try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción expiró — inténtalo de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription expirée — réessayez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्शन का समय समाप्त हुआ — फिर से प्रयास करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsi habis waktu — coba lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeout della trascrizione — riprova"
          }
        },
        "ja": {
