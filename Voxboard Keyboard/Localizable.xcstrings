          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사 시간이 초과되었습니다 — 다시 시도하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriptie time-out — probeer opnieuw"
          }
        },
        "pl": {
          "stringUnit": {
