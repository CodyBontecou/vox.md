        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на микрофон, чтобы открыть Vox.md и начать слушать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md-ஐத் திறந்து கேட்கத் தொடங்க மைக்கைத் தட்டவும்."
          }
