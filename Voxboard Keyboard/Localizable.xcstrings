    "Vox.md did not start recording — reopen Listening Mode and try again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md لم يبدأ الإصدار - قم بإعادة فتح وضع الاستماع ثم محاولة مرة أخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md রেকর্ডিং শুরু হয়নি – শুনানির মোডটি পুনরায় চালু করুন এবং আবার চেষ্টা করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md hat die Aufnahme nicht gestartet – öffnen Sie den Listening-Modus erneut und versuchen Sie es noch einmal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md did not start recording — reopen Listening Mode and try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md No se inició la grabación: reabre el modo de escucha y intenta de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md n'a pas démarré l'enregistrement - ouvrez à nouveau le mode écoute et essayez à nouveau"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md रिकॉर्डिंग शुरू नहीं हुआ - सुनने मोड को फिर से खोलें और फिर से कोशिश करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Tidak memulai rekaman – buka Mode Mendengarkan lagi dan coba lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md non ha iniziato la registrazione: riaprite la modalità ascolto e riprovate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 録音を開始しなかった - 再度聴くモードを開いて再度試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 녹음이 시작되지 않았습니다. - 청취 모드를 다시 열고 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md niet begonnen met opnemen - open de luistermodus opnieuw en probeer het opnieuw"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md nie rozpoczął nagrywania – ponownie otwórz tryb słuchania i spróbuj ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Não iniciou a gravação – reabre o Modo de escuta e tente novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md не начали запись — перезапустите режим прослушивания и попробуйте снова"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md எழுதவில்லை – மீண்டும் செவியேற்கும் முறை திறக்கவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ไม่เริ่มการบันทึก - เปิดโหมดฟังอีกครั้งและลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Kayıt başlamadı – Dinleme Modunu yeniden açın ve tekrar deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md не почав записувати — знову відкрити режим прослуховування та спробувати"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md نہیں شروع کیا گیا ہے - دوبارہ سننے کے طریقے کو کھولیں اور دوبارہ کوشش کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md không bắt đầu ghi âm – mở lại Chế độ nghe và thử lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 未开始录制 - 重新打开听取模式,然后再试一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 未開始錄製 - 重新打開聽取模式,然後再試一次"
          }
        }
      }
    },
