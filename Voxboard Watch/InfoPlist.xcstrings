    "NSMicrophoneUsageDescription": {
      "comment": "Privacy prompt explaining microphone access on Apple Watch.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md يُسجلّ نصائح صوتية على Apple Watch ويقوم بتسجيلها إلى iPhonee الخاص بك لتسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md রেকর্ডিং নোটের ভয়েস Apple Watch তাদেরকে আপনার কাছে নিয়ে যান। iPhone অনুবাদে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Aufzeichnungen Voice Notes auf Apple Watch und synchronisiert sie mit deinem iPhone für die Transkription."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md records voice notes on Apple Watch and syncs them to your iPhone for transcription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Notas de voz en Apple Watch y los sincroniza con su iPhone para la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Les notes vocales sont en Apple Watch et les synchroniser avec votre iPhone pour la transcription."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Voice Notes पर रिकॉर्ड्स Apple Watch और उन्हें अपने iPhone ट्रांसक्शंस के लिए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Catatan suara pada Apple Watch dan menyatukan mereka denganmu iPhone Untuk transcription"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md registrazione delle note vocali su Apple Watch e li sincronizza con il tuo iPhone per la trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 音声ノート Record Voice Notes On Apple Watch あなたのものに合流し、 iPhone トランスクリプションについて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Record Voice Notes에 대한 리뷰 보기 Apple Watch 그들을 당신의 곁으로 옮기라. iPhone transcription 을 위한"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Voicemail opnamen op Apple Watch en synchroniseert ze met uw iPhone voor transcriptie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Zapisywanie notatek głosowych na Apple Watch i synchronizuj je z Twoimi iPhone Dla transkrypcji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Notas de Voz em Apple Watch e os sinalizes com o vosso iPhone para a transcrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md записывает голосовые записи на Apple Watch и синхронизируйте их с вашими iPhone Для транскрипции ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Voice notes எழுதப்பட்ட Apple Watch உன் கையால் அவர்களை iPhone transcription என்று"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md บันทึกบันทึกเสียง Apple Watch และซิงค์พวกเขาไปยังของคุณ iPhone สําหรับการถ่ายภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Sesli Notlar İle Apple Watch Onları seninle birlikte birleştirin iPhone Transcription için"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Запис голосових записів на Apple Watch і синхронізує їх з вашими iPhone Для транскрипції"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md کی آواز کے نوٹ پر Apple Watch اور ان کو آپ کے ساتھ شامل کریں iPhone ٹرانسفر کے لئے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Record Voice Notes trên Apple Watch và đồng bộ chúng với bạn iPhone Đối với transcription"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 音频记录在 Apple Watch 并将其合并到您的 iPhone 为了转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 音頻記錄在 Apple Watch 並將其合併到您的 iPhone 為了轉錄。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy prompt explaining one-shot Watch location access.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تفعيل الموقع لمسار، يحصل Vox.md على موقع واحد من Apple Watch هذه عند توقف التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনও রুটের জন্য অবস্থান চালু থাকলে, রেকর্ডিং থামার সময় Vox.md এই Apple Watch থেকে একবার অবস্থান নেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Standort für eine Route aktiviert ist, ermittelt Vox.md beim Beenden der Aufnahme einmalig den Standort dieser Apple Watch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When location is enabled for a Route, Vox.md gets one location from this Apple Watch when recording stops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la ubicación está activada para una ruta, Vox.md obtiene una ubicación de este Apple Watch al detenerse la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque la localisation est activée pour un parcours, Vox.md obtient une seule position depuis cette Apple Watch à l’arrêt de l’enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब किसी रूट के लिए स्थान चालू होता है, तब रिकॉर्डिंग रुकने पर Vox.md इस Apple Watch से एक बार स्थान प्राप्त करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat lokasi diaktifkan untuk Rute, Vox.md mengambil satu lokasi dari Apple Watch ini ketika perekaman berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la posizione è abilitata per un percorso, Vox.md rileva una posizione da questo Apple Watch al termine della registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルートで位置情報が有効な場合、Vox.md は録音の停止時にこの Apple Watch から位置情報を一度取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트에서 위치가 활성화된 경우 Vox.md는 녹음이 중지될 때 이 Apple Watch에서 위치를 한 번 가져옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als locatie voor een route is ingeschakeld, bepaalt Vox.md één locatie van deze Apple Watch wanneer de opname stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy lokalizacja jest włączona dla trasy, Vox.md jednorazowo pobiera lokalizację z tego Apple Watch po zatrzymaniu nagrywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a localização está ativada para uma Rota, o Vox.md obtém uma localização deste Apple Watch quando a gravação para."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если для маршрута включена геопозиция, Vox.md однократно получает геопозицию с этих Apple Watch при остановке записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழித்தடத்துக்கு இருப்பிடம் இயக்கப்பட்டிருந்தால், பதிவு நிறுத்தப்படும்போது Vox.md இந்த Apple Watch இலிருந்து ஒரு முறை இருப்பிடத்தைப் பெறுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดใช้ตำแหน่งสำหรับเส้นทาง Vox.md จะรับตำแหน่งจาก Apple Watch เรือนนี้หนึ่งครั้งเมื่อหยุดบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir rota için konum etkinse Vox.md, kayıt durduğunda bu Apple Watch’tan konumu bir kez alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо для маршруту ввімкнено геопозицію, Vox.md одноразово отримує геопозицію з цього Apple Watch після зупинки запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کسی روٹ کے لیے مقام فعال ہو تو ریکارڈنگ رکنے پر Vox.md اس Apple Watch سے ایک بار مقام حاصل کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi vị trí được bật cho một lộ trình, Vox.md lấy một vị trí từ Apple Watch này khi dừng ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为路线启用位置后，Vox.md 会在录音停止时从此 Apple Watch 获取一次位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為路線啟用位置後，Vox.md 會在錄音停止時從此 Apple Watch 取得一次位置。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
