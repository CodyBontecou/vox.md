              "type": "null"
            }
          ]
        },
        "locationSnapshot": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "accuracyMillimeters": {
                  "oneOf": [
                    {
                      "maximum": 100000000,
                      "minimum": 0,
                      "type": "integer"
