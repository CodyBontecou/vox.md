                "type": "string"
              },
              "kind": {
                "const": "link"
              },
              "label": {
                "maxLength": 4096,
                "type": "string"
              },
              "url": {
                "maxLength": 8192,
                "minLength": 1,
                "pattern": "^https?://",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id",
              "url",
              "label"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "id": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              "kind": {
                "const": "asset"
              },
              "length": {
                "maximum": 1073741824,
                "minimum": 0,
                "type": "integer"
              },
              "mediaType": {
                "maxLength": 127,
                "minLength": 1,
                "type": "string"
              },
              "originalNamePolicy": {
                "enum": [
                  "discard",
                  "safeStem"
