                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "sourceID": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id",
              "sourceID",
              "mediaType",
              "length",
              "sha256",
              "safeExtension",
              "originalNamePolicy"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "pins": {
      "additionalProperties": false,
      "properties": {
        "coreVersion": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
