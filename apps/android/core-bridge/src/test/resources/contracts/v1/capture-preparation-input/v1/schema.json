    "createdAtEpochMilliseconds": {
      "maximum": 4102444800000,
      "minimum": 0,
      "type": "integer"
    },
    "invocation": {
      "additionalProperties": false,
      "properties": {
        "locationOutcome": {
          "enum": [
            "notRequested",
            "unavailable",
            "coordinatesFrozen",
            "labelFrozen"
          ]
        },
        "locationAttemptedAtEpochMilliseconds": {
          "oneOf": [
            {
              "maximum": 4102444800000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "locationUnavailableReason": {
          "enum": [
            "permissionDenied",
            "restricted",
            "notDetermined",
            "reducedAccuracy",
            "timeout",
            "cancelled",
            "unavailable"
          ]
        },
        "locationLabelObservation": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "consentVersion": {
                  "oneOf": [
                    {
                      "maximum": 2147483647,
                      "minimum": 1,
                      "type": "integer"
