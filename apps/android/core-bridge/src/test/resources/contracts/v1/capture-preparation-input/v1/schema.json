      "required": [
        "id",
        "revision",
        "snapshotHash",
        "templateFreezePoint",
        "retryMarkerPolicy",
        "routePolicy",
        "metadataPolicy",
        "destinationPolicy"
      ],
      "type": "object"
    },
    "requestID": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "timezone": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "requestID",
    "captureSource",
    "createdAtEpochMilliseconds",
    "timezone",
    "calendar",
    "locale",
    "operation",
    "pins",
    "payloads",
    "preset",
    "invocation"
  ],
  "title": "capture-preparation-input",
  "type": "object"
}
