                          ]
                        },
                        "place": {
                          "oneOf": [
                            {
                              "maxLength": 512,
                              "minLength": 1,
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "region": {
                          "oneOf": [
                            {
                              "maxLength": 512,
                              "minLength": 1,
                              "type": "string"
                            },
                            {
                              "type": "null"
