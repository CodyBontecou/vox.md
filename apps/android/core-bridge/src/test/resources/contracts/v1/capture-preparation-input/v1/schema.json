        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "locationPolicy": {
          "additionalProperties": false,
          "properties": {
            "advancedTemplate": {
              "maxLength": 8192,
