        "routePolicy": {
          "additionalProperties": false,
          "properties": {
            "attachmentFolder": {
              "items": {
                "maxLength": 255,
                "minLength": 1,
                "pattern": "^(?!\\.{1,2}$)(?!.*[\\/\\x00]).+$",
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            "collisionPolicy": {
              "enum": [
                "fail",
                "reuseIfHashMatches",
                "deterministicSuffix"
              ]
            },
            "entryPrefix": {
              "maxLength": 16384,
              "type": "string"
            },
            "entrySuffix": {
              "maxLength": 16384,
              "type": "string"
            },
            "extensionPolicy": {
              "const": "markdownDotMd"
            },
            "headingLevel": {
              "maximum": 6,
              "minimum": 1,
              "type": "integer"
            },
            "headingTitle": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "logicalFolder": {
              "items": {
                "maxLength": 255,
                "minLength": 1,
                "pattern": "^(?!\\.{1,2}$)(?!.*[\\/\\x00]).+$",
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            "missingHeadingBehavior": {
              "enum": [
                "fail",
                "create"
              ]
            },
            "noteNameTemplate": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "placement": {
              "enum": [
                "append",
                "prepend",
                "beneathHeading"
              ]
            },
            "rollingPeriod": {
              "enum": [
                "daily",
                "weekly",
                "monthly",
                "quarterly",
                "yearly"
              ]
            }
          },
          "required": [
            "logicalFolder",
            "noteNameTemplate",
            "extensionPolicy",
            "collisionPolicy",
            "attachmentFolder"
