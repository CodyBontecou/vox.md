{
  "$defs": {},
  "$id": "https://vox.md/contracts/capture-preparation-input/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calendar": {
      "const": "gregorian"
    },
    "captureSource": {
      "enum": [
        "app",
        "share",
        "keyboard",
        "widget",
        "shortcut",
        "watch",
        "wear"
