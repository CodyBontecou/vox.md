<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Vox.md connects to the local endpoint you configure when you explicitly send a capture or test URL delivery.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>Geist-Regular.ttf</string>
		<string>Geist-Medium.ttf</string>
		<string>Geist-SemiBold.ttf</string>
		<string>GeistMono-Regular.ttf</string>
		<string>GeistMono-Medium.ttf</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.bontecou.Voxboard</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>voxboard</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.bontecou.Voxboard.captureInboxDrain</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Vox.md uses the microphone when you choose to transcribe speech or attach a voice recording to a local Markdown note.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Vox.md uses Apple Speech to transcribe your recording locally while you speak.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Vox.md gets your location once when you insert a map link, or when you send or stop recording with a location-enabled Capture Preset.</string>
	<key>NSCameraUsageDescription</key>
	<string>Vox.md uses the camera only when you choose to capture a photo or scan into your local Markdown notes.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Vox.md reads only the photos you choose for a local Markdown capture.</string>
	<key>ONBOARDING_ANALYTICS_ENDPOINT_URL</key>
	<string>https://voxboard-onboarding-analytics.costream.workers.dev</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
