    "Synced to iPhone queue. You can record another.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشغيلها من iPhone. يمكنك تسجيل آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সৃষ্টি iPhone রান আপনি অন্যটি রেকর্ড করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der iPhone-Warteschlange synchronisiert. Sie können eine weitere Aufnahme starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synced to iPhone queue. You can record another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Síntomas iPhone La cola. Puedes grabar otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synthèse iPhone La queue ! Vous pouvez enregistrer un autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंहासन iPhone कूदना आप एक और रिकॉर्ड कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync yang iPhone Titik yang Anda bisa mencatat yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzati iPhone La coda Puoi registrare un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンジョン iPhone 尾行 もう一つ録画できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "죄를 iPhone 꼬리 또 하나를 기록할 수 있다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseren met iPhone De staart. Je kunt er nog een opnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synodzyści iPhone Okrągły Możesz nagrać jeszcze jeden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Síntese de iPhone A cauda. Você pode gravar outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синтетический iPhone Охота Вы можете записать еще один."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync அழுத்த iPhone கோபம் வேறு ஒரு எழுத்து முடியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเลขรุ่น: Synced to iPhone ตูด คุณสามารถบันทึกอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sünneti iPhone Sırt Başka bir kayıt yapabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізується iPhone За чергою Можна записати ще один."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سنسنی iPhone چودہ آپ ایک اور کو ریکارڈ کر سکتے ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync Đã iPhone đuôi Bạn có thể ghi lại một"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成 iPhone 尾巴 你可以录制另一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成 iPhone 尾巴 你可以錄製另一個。"
          }
        }
      }
    },
