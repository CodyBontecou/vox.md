    "Keep Original and Apply To control text only. Image descriptions are optional.": {
      "comment": "On-device image descriptions: preset control, help, availability, or capture progress.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ بالأصل والتطبيق على يتحكمان في النص فقط. أوصاف الصور اختيارية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল রাখুন এবং প্রয়োগ করুন শুধু টেক্সট নিয়ন্ত্রণ করে। ছবির বর্ণনা ঐচ্ছিক।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Original beibehalten und Anwenden auf steuern nur Text. Bildbeschreibungen sind optional."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Original and Apply To control text only. Image descriptions are optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar original y Aplicar a solo controlan el texto. Las descripciones de imágenes son opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver l’original et Appliquer à concernent uniquement le texte. Les descriptions d’images sont facultatives."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल रखें और इस पर लागू करें केवल टेक्स्ट को नियंत्रित करते हैं। छवि विवरण वैकल्पिक हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan Asli dan Terapkan Ke hanya mengontrol teks. Deskripsi gambar bersifat opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni originale e Applica a controllano solo il testo. Le descrizioni delle immagini sono facoltative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「オリジナルを保持」と「適用先」はテキストのみを制御します。画像の説明は任意です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 유지 및 적용 대상은 텍스트에만 적용됩니다. 이미지 설명은 선택 사항입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Origineel behouden en Toepassen op gelden alleen voor tekst. Afbeeldingsbeschrijvingen zijn optioneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj oryginał i Zastosuj do dotyczą tylko tekstu. Opisy obrazów są opcjonalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter original e Aplicar a controlam apenas o texto. As descrições de imagens são opcionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить оригинал и Применить к управляют только текстом. Описания изображений необязательны."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசலை வைத்திரு மற்றும் இதற்குப் பயன்படுத்து ஆகியவை உரையை மட்டுமே கட்டுப்படுத்தும். பட விளக்கங்கள் விருப்பத்திற்குரியவை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บต้นฉบับและใช้กับควบคุมเฉพาะข้อความ คำอธิบายรูปภาพเป็นตัวเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinali Koru ve Uygula yalnızca metni kontrol eder. Görüntü açıklamaları isteğe bağlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти оригінал і Застосувати до керують лише текстом. Описи зображень необов’язкові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اصل برقرار رکھیں اور لاگو کریں صرف متن کو کنٹرول کرتے ہیں۔ تصاویر کی وضاحتیں اختیاری ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nguyên bản gốc và Áp dụng cho chỉ điều khiển văn bản. Mô tả ảnh là tùy chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“保留原文”和“应用于”仅控制文本。图像描述为可选功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「保留原文」和「套用至」僅控制文字。影像描述為選用功能。"
          }
        }
      }
    },
