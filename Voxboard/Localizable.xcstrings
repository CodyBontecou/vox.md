    "Reopen Vox.md to recover and sync this recording.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد فتح Vox.md لاستعادة هذا التسجيل ومزامنته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডিং পুনরুদ্ধার এবং সিঙ্ক করতে Vox.md আবার খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Vox.md erneut, um diese Aufnahme wiederherzustellen und zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen Vox.md to recover and sync this recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a abrir Vox.md para recuperar y sincronizar esta grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez Vox.md pour récupérer et synchroniser cet enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्डिंग को पुनर्प्राप्त और सिंक करने के लिए Vox.md को फिर से खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kembali Vox.md untuk memulihkan dan menyinkronkan rekaman ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri Vox.md per recuperare e sincronizzare questa registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md を再度開き、この録音を復元して同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음을 복구하고 동기화하려면 Vox.md를 다시 엽니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Vox.md opnieuw om deze opname te herstellen en te synchroniseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz ponownie Vox.md, aby odzyskać i zsynchronizować to nagranie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabra Vox.md para recuperar e sincronizar esta gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова откройте Vox.md, чтобы восстановить и синхронизировать эту запись."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவை மீட்டெடுத்து ஒத்திசைக்க Vox.md ஐ மீண்டும் திறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Vox.md อีกครั้งเพื่อกู้คืนและซิงค์การบันทึกนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaydı kurtarmak ve senkronize etmek için Vox.md'yi yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову відкрийте Vox.md, щоб відновити та синхронізувати цей запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ریکارڈنگ کو بازیافت اور مطابقت پذیر کرنے کے لیے Vox.md کو دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở lại Vox.md để khôi phục và đồng bộ hóa bản ghi này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开 Vox.md 以恢复并同步此录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟 Vox.md 以恢復並同步此錄音。"
          }
        }
      }
    },
