    "The recording is safe, but its queue could not be updated.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تحديث التسجيل بأمان ، ولكن لا يمكن تحديث الترتيب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং নিরাপদ, কিন্তু তার রেখা আপডেট করা যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist sicher, aber ihre Warteschlange konnte nicht aktualisiert werden."
