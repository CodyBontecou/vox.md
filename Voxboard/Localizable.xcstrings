    "Transcription failed because the Watch audio could not be converted to the required format.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إرسال الإشارة لأن صوت Watch لم يتم تحويلها إلى المكون المطلوب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সপ্লিকেশন ব্যর্থ হয় কারণ ঘড়ি অডিও প্রয়োজনীয় ফরম্যাটে রূপান্তর করা সম্ভব হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription ist gescheitert, weil das Watch Audio nicht in das erforderliche Format konvertiert werden konnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription failed because the Watch audio could not be converted to the required format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción falló porque el audio de Watch no se pudo convertir al formato requerido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription a échoué car l'audio de la montre ne pouvait pas être converti au format requis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्शन विफल रहा क्योंकि घड़ी ऑडियो को आवश्यक प्रारूप में परिवर्तित नहीं किया जा सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription gagal karena audio Watch tidak dapat dikonversi ke format yang diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione non è riuscita perché l'audio Watch non poteva essere convertito nel formato richiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオの変換が必要なフォーマットにできないため、トランスクリプションが失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 오디오가 필요한 형식으로 변환되지 않았기 때문에 번역이 실패했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriptie mislukt omdat de Watch audio niet kon worden geconverteerd naar het vereiste formaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription nie powiodło się, ponieważ audio Watch nie można było przekonwertować do wymaganej formatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição falhou porque o áudio do Watch não pôde ser convertido para o formato necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипция не удалась, потому что аудио Watch не удалось конвертировать в требуемый формат."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription failed because the watch audio could not be converted to the required format."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแปลงไม่ได้เนื่องจากเสียงของนาฬิกาไม่สามารถแปลงเป็นรูปแบบที่ต้องการได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription başarısız oldu çünkü Watch sesini gerekli biçime dönüştüremez."
