    "Prepared locally. No HTTP attempt has been made.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التحضير محليًا. لم تتم أي محاولة HTTP."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয়ভাবে প্রস্তুত। এখনও কোনো HTTP চেষ্টা করা হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal vorbereitet. Es wurde noch kein HTTP-Versuch unternommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepared locally. No HTTP attempt has been made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparada localmente. Aún no se ha hecho ningún intento HTTP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparé localement. Aucune tentative HTTP n’a été effectuée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय रूप से तैयार किया गया। कोई HTTP प्रयास नहीं किया गया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disiapkan secara lokal. Belum ada percobaan HTTP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparata in locale. Non è stato effettuato alcun tentativo HTTP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルで準備済み。HTTPの送信はまだ行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬에서 준비되었습니다. 아직 HTTP 시도가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaal voorbereid. Er is nog geen HTTP-poging gedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowano lokalnie. Nie podjęto jeszcze próby HTTP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparada localmente. Nenhuma tentativa HTTP foi feita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовлено локально. HTTP-запросов не было."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூரில் தயாரிக்கப்பட்டது. HTTP முயற்சி எதுவும் செய்யப்படவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตรียมไว้ในเครื่องแล้ว ยังไม่มีการพยายามส่ง HTTP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel olarak hazırlandı. Henüz HTTP denemesi yapılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготовлено локально. HTTP-запитів не було."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی طور پر تیار۔ ابھی تک کوئی HTTP کوشش نہیں کی گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chuẩn bị cục bộ. Chưa thử gửi HTTP lần nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在本地准备好。尚未进行 HTTP 尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在本機準備好。尚未進行 HTTP 嘗試。"
          }
        }
      }
    },
