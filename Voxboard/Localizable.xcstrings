          "stringUnit": {
            "state": "translated",
            "value": "หยุดชั่วคราว — ดำเนินการต่อเพื่อบันทึกโน้ตนี้ต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldı — bu notu kaydetmeye devam etmek için sürdürün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза — продовжте, щоб записувати цю нотатку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موقوف — یہ نوٹ ریکارڈ کرتے رہنے کے لیے دوبارہ شروع کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng — tiếp tục để ghi tiếp ghi chú này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停——继续录音以完成此笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停——繼續錄音以完成此筆記。"
          }
        }
      }
    },
