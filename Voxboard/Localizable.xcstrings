        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலியை இறக்குமதி செய்ய முடியவில்லை: %@. இறக்குமதி செய்த மூலம் பாதுகாக்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถนำเข้าเสียงได้: %@ ไฟล์ต้นฉบับที่นำเข้าได้รับการเก็บรักษาไว้"
          }
        },
        "tr": {
