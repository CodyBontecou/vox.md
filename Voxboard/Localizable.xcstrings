          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz jedno kompletne emoji. Użyj Control–Command–Spacja, aby otworzyć Przeglądarkę znaków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um emoji completo. Use Control–Command–Espaço para abrir o Visualizador de Caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите один полный эмодзи. Нажмите Control–Command–Пробел, чтобы открыть «Эмодзи и символы»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு முழுமையான எமோஜியை உள்ளிடவும். எழுத்துப் பார்வையாளரைத் திறக்க Control–Command–Space ஐப் பயன்படுத்தவும்."
          }
