    "Opens Quick Capture and adds screenshots with the selected Route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الالتقاط السريع ويضيف لقطات الشاشة باستخدام المسار المحدد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কুইক ক্যাপচার খোলে এবং বেছে নেওয়া রুট দিয়ে স্ক্রিনশট যোগ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet „Schnellerfassung“ und fügt Bildschirmfotos mit der ausgewählten Route hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Quick Capture and adds screenshots with the selected Route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Captura rápida y añade capturas de pantalla con la ruta seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Capture rapide et ajoute des captures d’écran avec le parcours sélectionné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्विक कैप्चर खोलता है और चुने गए रूट से स्क्रीनशॉट जोड़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Tangkapan Cepat dan menambahkan jepretan layar dengan Rute yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Acquisizione rapida e aggiunge istantanee dello schermo con il percorso selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイックキャプチャを開き、選択したルートでスクリーンショットを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 캡처를 열고 선택한 루트로 스크린샷을 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Snel vastleggen en voegt schermafbeeldingen toe met de geselecteerde route."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Szybkie przechwytywanie i dodaje zrzuty ekranu wybraną trasą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a Captura Rápida e adiciona capturas de tela com a rota selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает «Быстрый захват» и добавляет снимки экрана по выбранному маршруту."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரைவுப் பிடிப்பைத் திறந்து, தேர்ந்தெடுத்த வழித்தடத்துடன் திரைப்பிடிப்புகளைச் சேர்க்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการจับภาพด่วนและเพิ่มภาพหน้าจอด้วยเส้นทางที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı Yakalama'yı açar ve seçilen Rota ile ekran görüntüleri ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває «Швидке захоплення» й додає знімки екрана вибраним маршрутом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فوری کیپچر کھولتا ہے اور منتخب روٹ کے ساتھ اسکرین شاٹس شامل کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Ghi nhanh và thêm ảnh màn hình bằng lộ trình đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开快速采集，并使用所选路线添加截屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開快速擷取，並使用所選路線加入截圖。"
          }
        }
      }
    },
    "Opens Quick Capture and records with the selected Route entirely on device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الالتقاط السريع ويسجّل باستخدام المسار المحدد بالكامل على الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কুইক ক্যাপচার খোলে এবং বেছে নেওয়া রুট দিয়ে পুরোপুরি ডিভাইসে রেকর্ড করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet „Schnellerfassung“ und nimmt mit der ausgewählten Route vollständig auf dem Gerät auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Quick Capture and records with the selected Route entirely on device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Captura rápida y graba con la ruta seleccionada totalmente en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Capture rapide et enregistre avec le parcours sélectionné, entièrement sur l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्विक कैप्चर खोलता है और चुने गए रूट से पूरी तरह डिवाइस पर रिकॉर्ड करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Tangkapan Cepat dan merekam dengan Rute yang dipilih sepenuhnya di perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Acquisizione rapida e registra con il percorso selezionato, interamente sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイックキャプチャを開き、選択したルートで完全にデバイス上で録音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 캡처를 열고 선택한 루트로 완전히 기기에서 녹음합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Snel vastleggen en neemt op met de geselecteerde route, volledig op het apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Szybkie przechwytywanie i nagrywa wybraną trasą w całości na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a Captura Rápida e grava com a rota selecionada inteiramente no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает «Быстрый захват» и записывает по выбранному маршруту полностью на устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரைவுப் பிடிப்பைத் திறந்து, தேர்ந்தெடுத்த வழித்தடத்துடன் முழுவதும் சாதனத்திலேயே பதிவுசெய்யும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการจับภาพด่วนและบันทึกด้วยเส้นทางที่เลือกบนอุปกรณ์ทั้งหมด"
          }
