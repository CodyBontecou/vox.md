    "1 recording will be canceled because location is required.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إلغاء تسجيل واحد لأن الموقع مطلوب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "1টি রেকর্ডিং বাতিল করা হবে কারণ লোকেশন প্রয়োজন৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Aufnahme wird abgebrochen, da ein Standort erforderlich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 recording will be canceled because location is required."
          }
        },
        "es": {
