    "iPhone could not save this transfer. Watch will retry automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على iPhone حفظ عملية النقل هذه. ستعيد Watch المحاولة تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone এই ট্রান্সফারটি সেভ করতে পারেনি। Watch নিজে থেকেই আবার চেষ্টা করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone konnte diese Übertragung nicht sichern. Die Watch versucht es automatisch erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone could not save this transfer. Watch will retry automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone no pudo guardar esta transferencia. El Watch lo reintentará automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone n’a pas pu enregistrer ce transfert. La Watch réessaiera automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone यह ट्रांसफ़र सहेज नहीं सका। Watch अपने आप फिर से प्रयास करेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone tidak dapat menyimpan transfer ini. Watch akan mencoba lagi secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone non è riuscito a salvare questo trasferimento. Watch riproverà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでこの転送を保存できませんでした。Watchが自動的に再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 이 전송을 저장할 수 없습니다. Watch가 자동으로 재시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De iPhone kon deze overdracht niet bewaren. De Watch probeert het automatisch opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone nie mógł zapisać tego transferu. Zegarek automatycznie ponowi próbę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone não conseguiu salvar esta transferência. O Watch tentará novamente de forma automática."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не удалось сохранить эту передачу. Часы повторят попытку автоматически."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone இந்தப் பரிமாற்றத்தைச் சேமிக்க முடியவில்லை. Watch தானாக மீண்டும் முயற்சிக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ไม่สามารถบันทึกการถ่ายโอนนี้ได้ Watch จะลองอีกครั้งโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone bu aktarımı kaydedemedi. Watch otomatik olarak yeniden deneyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не вдалося зберегти це передавання. Годинник повторить спробу автоматично."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone یہ منتقلی محفوظ نہیں کر سکا۔ Watch خودکار طور پر دوبارہ کوشش کرے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone không thể lưu lần truyền này. Watch sẽ tự động thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 无法保存此次传输。手表将自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 無法儲存此次傳輸。手錶會自動重試。"
          }
        }
      }
    },
    "It will be removed from this iPhone and won’t be delivered.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالته من هذا الـ iPhone ولن يتم تسليمه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি এই iPhone থেকে সরিয়ে দেওয়া হবে এবং ডেলিভার করা হবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wird von diesem iPhone entfernt und nicht zugestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be removed from this iPhone and won’t be delivered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará de este iPhone y no se entregará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle sera supprimée de cet iPhone et ne sera pas livrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे इस iPhone से हटा दिया जाएगा और डिलीवर नहीं किया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan akan dihapus dari iPhone ini dan tidak akan dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà rimossa da questo iPhone e non verrà consegnata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneから削除され、配信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 제거되며 전달되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze wordt van deze iPhone verwijderd en niet afgeleverd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie usunięte z tego iPhone i nie zostanie dostarczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela será removida deste iPhone e não será entregue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он будет удален с этого iPhone и не будет доставлен."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இந்த iPhone இலிருந்து அகற்றப்படும், வழங்கப்படாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการนี้จะถูกเอาออกจาก iPhone เครื่องนี้และจะไม่ถูกส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'dan kaldırılacak ve teslim edilmeyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його буде видалено з цього iPhone, і його не буде доставлено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے اس iPhone سے ہٹا دیا جائے گا اور یہ ڈیلیور نہیں ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi nhanh sẽ bị xóa khỏi iPhone này và không được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将从此 iPhone 中移除，且不会被递送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會從此 iPhone 中移除，且不會被傳送。"
          }
        }
      }
    },
