          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нова нотатка чи аудіовкладення не записуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کوئی اور نوٹ یا آڈیو منسلکہ نہیں لکھتا۔"
