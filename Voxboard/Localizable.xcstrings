    "Custom keyboard, widgets, Dynamic Island, and Live Activities remain iOS-specific.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال الكاميرا المخصصة، والفيديوهات، والمسجد الديناميكي، والأنشطة الحية iOS محددة."
