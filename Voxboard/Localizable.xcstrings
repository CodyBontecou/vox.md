        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identificazione degli oratori è stata ignorata perché questa trascrizione non contiene informazioni sui tempi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書き起こしにはタイミング情報がないため、話者識別はスキップされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기록에 타이밍 정보가 없어 화자 식별을 건너뛰었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprekerherkenning is overgeslagen omdat deze transcriptie geen timinginformatie bevat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominięto identyfikację mówców, ponieważ ta transkrypcja nie ma informacji o znacznikach czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identificação de falantes foi ignorada porque esta transcrição não tem informações de tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание говорящих пропущено, поскольку в этой расшифровке нет информации о времени."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நகலெடுப்பில் நேரத் தகவல் இல்லாததால் பேச்சாளர் அடையாளம் தவிர்க்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้ามการระบุผู้พูดเนื่องจากถอดเสียงนี้ไม่มีข้อมูลจังหวะเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu transkript zaman bilgisi içermediği için konuşmacı tanımlama atlandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовців пропущено, оскільки у цій розшифровці немає інформації про час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ٹرانسکرپٹ میں ٹائمنگ کی معلومات نہ ہونے کی وجہ سے اسپیکر شناخت چھوڑ دی گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bỏ qua nhận dạng người nói vì bản ghi chép này không có thông tin thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因此转录稿没有时间信息，已跳过说话人识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因此逐字稿沒有時間資訊，已略過說話者識別。"
          }
        }
      }
    },
    "Speaker identification was skipped because timing information did not cover the complete transcript.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker identification was skipped because timing information did not cover the complete transcript."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطي تحديد المتحدثين لأن معلومات التوقيت لم تغطِّ النسخ الكامل."
          }
        },
        "bn": {
          "stringUnit": {
