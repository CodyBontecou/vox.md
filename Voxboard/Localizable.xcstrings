            "value": "El acceso está desactivado en Privacidad y seguridad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès est désactivé dans Confidentialité et sécurité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोपनीयता और सुरक्षा में ऐक्सेस बंद है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses nonaktif di Privasi & Keamanan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso è disattivato in Privacy e sicurezza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プライバシーとセキュリティ」でアクセスがオフになっています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 및 보안에서 접근이 꺼져 있음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang staat uit in Privacy en beveiliging"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp jest wyłączony w Prywatność i ochrona"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso está desativado em Privacidade e Segurança"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ выключен в разделе «Конфиденциальность и безопасность»"
