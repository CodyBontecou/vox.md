        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 최근의 루트 선택이 이미 적용되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is al een nieuwere routekeuze toegepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowszy wybór trasy został już zastosowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma seleção de rota mais recente já foi aplicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже применен более новый выбор маршрута."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய வழித்தடத் தேர்வு ஏற்கனவே பயன்படுத்தப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการใช้การเลือกเส้นทางที่ใหม่กว่าไปแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yeni bir Rota seçimi zaten uygulandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже застосовано новіший вибір маршруту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک نیا روٹ انتخاب پہلے ہی لاگو ہو چکا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lựa chọn lộ trình mới hơn đã được áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已应用了更新的路线选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已套用了較新的路線選擇。"
          }
        }
      }
    },
    "A shared capture could not be delivered and is queued for retry. %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن من تقديم تصنيف مشترك ويقع في صفوف للتحقق. %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ভাগ করা ধরা দেওয়া সম্ভব হয়নি এবং পুনরায় রিটারির জন্য অপেক্ষা করা হয়। %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geteilte Erfassung konnte nicht zugestellt werden und wartet auf einen erneuten Versuch. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shared capture could not be delivered and is queued for retry. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una captura compartida no se pudo entregar y está en cola para retry. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capture partagée ne peut pas être livrée et est en file de file pour le retrait. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक साझा कैप्शन वितरित नहीं किया जा सकता है और रेट्री के लिए लाइन में है। %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah tangkapan bersama tidak dapat dikirim dan diikat untuk retry. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cattura condivisa non può essere consegnata ed è in coda per il retry. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有キャプチャは配信できませんでしたし、リトリに列を置いています。 %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 캡처는 배달할 수 없으며 재배치에 대기 중입니다. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gedeelde opname kon niet worden geleverd en wordt geëindigd voor retry. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wspólny złap nie mógł zostać dostarczony i jest w kolejce do ponownego przetestowania. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma captura compartilhada não pode ser entregue e está na fila para retry. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий улов не мог быть доставлен и стоит в очереди на перезагрузку. %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு சேமிப்பு அடைப்பு வழங்க முடியாது மற்றும் retry க்கு காத்திருக்கிறது. %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพที่แชร์ไม่สามารถส่งมอบและถูกจัดอันดับเพื่อรีท %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan bir yakalama teslim edilemez ve yeniden arama için sırada. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділений вилучення не могло бути доставлено і чергується на перевірку. %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک مشترکہ پکڑنے کو فراہم نہیں کیا جا سکتا ہے اور ریٹوری کے لئے چیلنج کیا جاتا ہے. %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một câu bắt được chia sẻ không thể được giao và đang đứng đợi để tái chế. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享捕获无法交付,并被排队进行重新捕获。 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享捕獲無法交付,並被排隊進行重新捕獲。 %@"
          }
        }
      }
    },
    "A small on-device voice detector can stop any live recording on this iPhone or iPad after you finish speaking, regardless of the transcription model or capture destination.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يوقف اكتشاف صوت صغير على الجهاز أي تسجيل في الهاتف iPhone أو iPad بعد انتهاء الكلام ، بغض النظر عن نموذج الترجمة أو وجهة التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ছোট ডিভাইসের ভয়েস ডিটেক্টর এই সাইটের কোনও লাইভ রেকর্ডিং বন্ধ করতে পারে। iPhone বা iPad কথা বলার পরে, যাই হোক না কেন, ট্রান্সপ্লোরেশন মডেল বা ক্যাপচারের উদ্দেশ্য।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner Sprachdetektor auf dem Gerät kann jede Live-Aufnahme auf diesem iPhone oder iPad beenden, sobald Sie zu Sprechen aufhören – unabhängig vom Transkriptionsmodell oder Erfassungsziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small on-device voice detector can stop any live recording on this iPhone or iPad after you finish speaking, regardless of the transcription model or capture destination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pequeño detector de voz en el dispositivo puede detener cualquier grabación en vivo en este iPhone o iPad Cuando terminas de hablar, independientemente del modelo de transcripción o destino de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit détecteur de voix sur l'appareil peut arrêter toute enregistrement en direct sur ce iPhone ou iPad Quand tu as fini de parler, indépendamment du modèle de transcription ou de la destination de capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक छोटे से डिवाइस पर आवाज डिटेक्टर इस पर किसी भी लाइव रिकॉर्डिंग को रोक सकता है iPhone या iPad जब आप बोलने के बाद, चाहे वह कैप्शन हो या कैप्शन का डिजाइन हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah detektor suara kecil pada perangkat dapat menghentikan rekaman langsung pada iPhone atau iPad Setelah selesai berbicara, Terlepas dari model transcription atau tujuan penangkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo rilevatore vocale sul dispositivo può fermare qualsiasi registrazione dal vivo su questo iPhone o iPad Quando hai finito di parlare, indipendentemente dal modello di trascrizione o dalla destinazione di cattura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さなデバイス上の音声検出器が、この音声に生中継を停止できる。 iPhone か iPad 話し終わったら、 移転モデルや捕獲目的地に関係なく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 장치 음성 탐지기는 이 장치에서 라이브 녹음을 중단할 수 있습니다. iPhone 또는 iPad 말을 마치고 나면, 캡처 모델이나 캡처 목적지에 관계없이."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kleine spraakdetector op het apparaat kan alle live-opname op deze iPhone of iPad Als je klaar bent met praten, ongeacht het transcriptiemodel of de bestemming van de opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mały wykrywacz głosu na urządzeniu może zatrzymać nagrywanie na żywo na tym iPhone lub iPad Gdy skończysz mówić, Niezależnie od modelu transkrypcji lub miejsca przeznaczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pequeno detector de voz no dispositivo pode parar qualquer gravação ao vivo sobre este iPhone ou iPad Quando você terminar de falar, independentemente do modelo de transcrição ou destino de captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небольшой голосовой детектор на устройстве может остановить любую запись в прямом эфире на этом устройстве. iPhone или iPad Когда ты закончишь говорить, независимо от модели транскрипции или места назначения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு சிறிய அணுகுமுறை பேச்சு ஆய்வு இந்த நேரத்தில் எந்த நேரடி எழுத்துகளை நிறுத்த முடியும் iPhone அல்லது iPad பேசுவதற்கும் முடிந்தால், எப்படியும், transcription model அல்லது capture destination என்பதால்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องตรวจจับเสียงขนาดเล็กในอุปกรณ์สามารถหยุดการบันทึกสดใด ๆ ที่นี้ iPhone หรือ iPad เมื่อคุณจบการพูดคุย ไม่ว่ารูปแบบการถ่ายภาพหรือเป้าหมายการจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir cihazda küçük bir ses detektörü bu cihazda canlı kayıtları durdurabilir. iPhone veya iPad Konuşmayı bitirdikten sonra, Transcription modeline veya yakalama hedefe bakılmaksızın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невеликий на пристрої голосовий детектор може зупинити будь-який живий запис на цьому пристрої. iPhone або iPad Коли ви закінчите розмову, незалежно від типу транскрипції або призначення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک چھوٹا سا آلہ پر آواز ڈیکٹر اس پر کسی بھی لائیو ریکارڈنگ کو روک سکتا ہے. iPhone یا iPad جب آپ بات چیت ختم کر دیں تو کسی بھی صورت میں، ٹرانسفر ماڈل یا گرفتاری مقصد."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một máy dò giọng nói nhỏ trên thiết bị có thể ngăn chặn bất kỳ bản ghi trực tiếp nào trên thiết bị này. iPhone hoặc iPad Sau khi nói xong, Bất kể mô hình chuyển đổi hoặc mục đích chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个小型设备语音探测器可以阻止任何现场录制。 iPhone 或 iPad 當你說完話後, 无论是转录模型还是捕获目的地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個小型設備語音探測器可以阻止任何現場錄製。 iPhone 或 iPad 當你說完話後, 無論是轉錄模型還是捕獲目的地。"
          }
        }
      }
    },
