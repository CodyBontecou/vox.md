    "No text was found in those journal images. Try brighter, straighter photos with the writing filling the frame.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على أي نص في تلك الصور من المجلة.حاول صور أكثر إثارة وأكثر صرامة مع الكتابة التي تغطي الصورة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পত্রিকার ছবিতে কোনও টেক্সট পাওয়া যায়নি. ফ্রেমটি পূরণ করে লিখিত চিত্রগুলির সাথে উজ্জ্বল, সরল ছবিগুলি চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Tagebuchbildern wurde kein Text gefunden. Versuchen Sie hellere, geradere Fotos, bei denen die Schrift den Rahmen ausfüllt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text was found in those journal images. Try brighter, straighter photos with the writing filling the frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró texto en esas imágenes de periódicos. Intente fotos más brillantes, más rectas con la escritura que llena el marco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun texte n'a été trouvé dans ces images du journal. Essayez des photos plus claires et plus droites avec l'écriture remplissant le cadre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन पत्रिका चित्रों में कोई पाठ नहीं मिला. फ्रेम को भरने वाले लेखन के साथ चमकदार, सीधा चित्रों की कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada teks yang ditemukan dalam gambar jurnal tersebut. cobalah foto yang lebih terang, lebih lurus dengan tulisan yang mengisi bingkai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun testo è stato trovato in quelle immagini di giornale. Prova foto più chiare, più dritte con la scrittura che riempie il telaio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナル画像にはテキストが見つかりませんでした. フレームを埋める文字で明るく、より直線の写真を試してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 잡지 이미지에서 텍스트가 발견되지 않았습니다.이 프레임을 채우는 글꼴로 밝고 직선한 사진을 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er werd geen tekst gevonden in die tijdschriftafbeeldingen. Probeer helderder, rechtzamer foto's met de schrijving die het frame vult."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tych zdjęciach z dziennika nie znaleziono tekstu. spróbuj jasniejszych, prostszych zdjęć z napisem wypełniającym ramy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrado texto nessas imagens de jornal. tente fotos mais claras e retas com a escrita preenchendo o quadro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этих изображениях журнала не было найдено текста. Попробуйте яркие, прямые фотографии с надписью, заполняющей рамку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்த நாட்குறிப்பு படங்களில் எந்த உரையும் காணப்படவில்லை. எழுத்து சட்டகத்தை நிரப்பும் வகையில், அதிக வெளிச்சத்துடன் நேராக எடுத்த படங்களை முயற்சிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อความที่พบในภาพนิตยสารเหล่านี้ ลองภาพสดใสและตรงกับภาพที่มีการเขียนเต็มรูปแบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraflarda hiçbir metin bulunamadı.Kara dolduran yazılıma sahip daha parlak, daha düz fotoğraflar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цих зображеннях журналу не було знайдено тексту. Спробуйте яскравіші, пряміші фотографії з написом, що заповнює рамку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان جوا تصاویر میں کوئی متن نہیں پایا گیا. فہرست پر لکھنے کے ساتھ روشن، زیادہ سیدھے تصاویر کی کوشش کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có văn bản nào được tìm thấy trong những hình ảnh tạp chí đó. Hãy thử những bức ảnh sáng hơn, thẳng hơn với chữ viết lấp đầy khung hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这些日志图像中没有找到任何文本,试着用填充框架的文字来拍照更亮、更直。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這些日誌圖像中沒有找到任何文本,試著用填充框架的文字來拍照更亮、更直。"
          }
        }
      }
    },
