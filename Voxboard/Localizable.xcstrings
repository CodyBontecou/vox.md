            "state": "translated",
            "value": "Зберігати обмежений час"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقررہ مدت کی برقراری استعمال کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
