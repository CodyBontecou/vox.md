          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис тексту перевищує границю безпеки 100 000 символів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کا مطلب یہ ہے کہ 100،000 حروف کی حفاظت کی حد سے زیادہ ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tín hiệu chụp là trên giới hạn bảo mật 100.000 ký tự."
          }
        },
        "zh-Hans": {
