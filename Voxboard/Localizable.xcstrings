          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрошенная настройка Capture Preset больше не существует или отключена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேவைப்பட்ட ஆவணப் பதிப்பு இனி இல்லை அல்லது அநியாயக்காரமாக உள்ளது."
