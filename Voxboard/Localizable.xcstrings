    "One purchase unlocks unlimited local Capture and private, on-device transcription across Vox.md.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شراء واحد يفتح الحظر غير محدودة من السماح بالبث في المحيط والمراجعة الخاصة على جهاز في جميع أنحاء Vox.md."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ক্রয় সীমাহীন স্থানীয় ক্যাপচার এবং ব্যক্তিগত, ডিভাইসের মাধ্যমে transcription Vox.md."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf schaltet unbegrenzte lokale Erfassung und private Transkription auf dem Gerät in ganz Vox.md frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase unlocks unlimited local Capture and private, on-device transcription across Vox.md."
          }
