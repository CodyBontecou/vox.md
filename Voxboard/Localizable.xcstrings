          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone انتقال کو بچانے کے قابل نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Không thể cứu được chuyển nhượng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 无法挽救转会。"
          }
        },
