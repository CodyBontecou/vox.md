        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullato perché la preimpostazione richiede una posizione temporale di origine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットには原点時間の位置が必要なためキャンセルされました"
