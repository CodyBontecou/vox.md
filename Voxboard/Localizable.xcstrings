        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹائپنگ کی ضرورت ہے.آپ کو ایک لمحے کے لئے انتظار کرنا چاہئے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp giao hàng đang hoạt động. Chờ một chút trước khi loại bỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉交付已启动. 等待一会儿,然后丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉交付已啟動. 等待一會兒,然後丟棄。"
          }
        }
      }
    },
