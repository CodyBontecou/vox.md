          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以將檔案拖到擷取文件中的任何位置。"
          }
        }
      }
    },
    "You can edit or add more any time.": {
      "localizations": {
