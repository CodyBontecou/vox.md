    "Delivered successfully. You can record another.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التسليم بنجاح. يمكنك بدء تسجيل جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সফলভাবে পৌঁছেছে। আপনি আরেকটি রেকর্ডিং করতে পারেন।"
          }
