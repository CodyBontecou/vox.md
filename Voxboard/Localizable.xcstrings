            "state": "translated",
            "value": "No se puede registrar %1$@. Pruebe un corto diferente. (Estado de %2$d)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne peut pas enregistrer %1$@. Essayez une autre raccourci. (Situation %2$d)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नहीं कर सकते रजिस्टर %1$@. एक अलग संक्षिप्त प्रयास करें। (अनुबंध %2$d)"
