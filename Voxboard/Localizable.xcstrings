        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech untuk teks langsung. Unduh model lokal di bawah untuk digunakan sebagai cadangannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech per il testo in tempo reale. Scarica un modello locale qui sotto da usare come alternativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブテキストにはApple Speechを使用します。フォールバックとして使うローカルモデルを下でダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 텍스트에는 Apple Speech를 사용합니다. 대체용으로 사용할 로컬 모델을 아래에서 다운로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech voor live tekst. Download hieronder een lokaal model om als reserve te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech do tekstu na żywo. Pobierz poniżej model lokalny, który posłuży jako zapasowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech para texto ao vivo. Baixe um modelo local abaixo para usar como alternativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech для текста в реальном времени. Загрузите локальную модель ниже в качестве резервной."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரலை உரைக்கு Apple Speech. மாற்றாகப் பயன்படுத்த கீழே ஒரு உள்ளூர் மாதிரியைப் பதிவிறக்கவும்."
