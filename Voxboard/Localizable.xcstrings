    "Failed or deferred URL deliveries appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا عمليات التسليم إلى URL الفاشلة أو المؤجلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যর্থ বা স্থগিত URL ডেলিভারি এখানে দেখা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlgeschlagene oder zurückgestellte URL-Zustellungen erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed or deferred URL deliveries appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen las entregas por URL fallidas o aplazadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les livraisons URL en échec ou différées s’affichent ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विफल या स्थगित URL डिलीवरी यहाँ दिखती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiriman URL yang gagal atau ditunda muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui vengono mostrate le consegne URL non riuscite o rinviate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗または延期されたURL配信がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패했거나 연기된 URL 전달이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mislukte of uitgestelde URL-leveringen verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawiają się nieudane lub odroczone dostarczenia pod URL."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entregas por URL com falha ou adiadas aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появляются неудачные или отложенные доставки по URL."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோல்வியடைந்த அல்லது ஒத்திவைக்கப்பட்ட URL வழங்கல்கள் இங்கே காண்பிக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งไปยัง URL ที่ล้มเหลวหรือเลื่อนไว้จะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarısız veya ertelenen URL teslimleri burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являються невдалі або відкладені доставки за URL."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ناکام یا مؤخر URL ڈیلیوریز یہاں دکھائی دیتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lần gửi qua URL không thành công hoặc bị hoãn sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败或延迟的 URL 递送会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗或延後的 URL 傳送會顯示在這裡。"
          }
        }
      }
    },
    "Failed recordings remain available until you retry or delete them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى التسجيلات الفاشلة متاحة حتى تعيد المحاولة أو تحذفها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যর্থ রেকর্ডিং আপনি আবার চেষ্টা বা ডিলিট না করা পর্যন্ত উপলব্ধ থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlgeschlagene Aufnahmen bleiben verfügbar, bis Sie sie erneut versuchen oder löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed recordings remain available until you retry or delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones fallidas siguen disponibles hasta que las reintentes o elimines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements en échec restent disponibles jusqu’à ce que vous les réessayiez ou les supprimiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विफल रिकॉर्डिंग तब तक उपलब्ध रहती हैं जब तक आप फिर से प्रयास या डिलीट नहीं करते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman yang gagal tetap tersedia sampai Anda mencoba lagi atau menghapusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le registrazioni non riuscite restano disponibili finché non le riprovi o le elimini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗した録音は、再試行するか削除するまで残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패한 녹음은 재시도하거나 삭제할 때까지 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mislukte opnamen blijven beschikbaar tot je ze opnieuw probeert of verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieudane nagrania pozostają dostępne, dopóki ich nie ponowisz lub nie usuniesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravações com falha ficam disponíveis até você tentar novamente ou apagá-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неудачные записи остаются доступными, пока вы их не повторите или не удалите."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோல்வியடைந்த பதிவுகள், நீங்கள் மீண்டும் முயற்சிக்கும் வரை அல்லது நீக்கும் வரை கிடைக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกที่ล้มเหลวจะยังคงอยู่จนกว่าคุณจะลองอีกครั้งหรือลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarısız kayıtlar siz yeniden deneyene veya silene kadar kullanılabilir kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невдалі записи залишаються доступними, доки ви їх не повторите або не видалите."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ناکام ریکارڈنگز تب تک دستیاب رہتی ہیں جب تک آپ دوبارہ کوشش یا انہیں حذف نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm không thành công vẫn có sẵn cho đến khi bạn thử lại hoặc xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败的录音会一直保留，直到你重试或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗的錄音會一直保留，直到你重試或刪除。"
          }
        }
      }
