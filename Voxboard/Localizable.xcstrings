    "Path relative to the selected vault or folder, for example Projects/Vox.md.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طريق متصل إلى المقطع أو المجلد المختار، على سبيل المثال Project/Vox.md."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পথ বা ফোল্ডার নির্বাচন করা হয়। উদাহরণস্বরূপ, প্রকল্প /Vox.md."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfad relativ zum ausgewählten Vault oder Ordner, zum Beispiel Projects/Vox.md."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path relative to the selected vault or folder, for example Projects/Vox.md."
