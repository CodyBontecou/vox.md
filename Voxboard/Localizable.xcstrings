        }
      }
    },
    "The recording could not be saved to the durable draft. The temporary audio is still available while this screen remains open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حفظ المسجلات إلى النسخة المستمرة.المعرفة مؤقتة لا تزال متاحة في حين أن الشاشة لا تتمكن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডটি স্থায়ী ড্রাইফে সংরক্ষণ করা সম্ভব হয়নি. অডিও এখনও উপলব্ধ, যখন এই স্ক্রিন খোলা থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht im dauerhaften Entwurf gesichert werden. Das temporäre Audio ist verfügbar, solange dieser Bildschirm geöffnet bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording could not be saved to the durable draft. The temporary audio is still available while this screen remains open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación no se pudo guardar en el dibujo duradero.El audio temporal sigue disponible mientras esta pantalla permanece abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement ne peut pas être enregistré dans le draft durable. L'audio temporaire est toujours disponible alors que cet écran reste ouvert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड को स्थायी ड्राफ्ट में सहेजा नहीं जा सका. अस्थायी ऑडियो अभी भी उपलब्ध है जबकि यह स्क्रीन खुला रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tidak dapat disimpan ke draft yang tahan lama. audio sementara masih tersedia sementara layar ini tetap terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio temporaneo è ancora disponibile mentre questo schermo rimane aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は永続的なスライドに保存できませんでした. 暫定的なオーディオは、この画面が開いている間も利用可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 지속적인 드래프트에 저장할 수 없으며, 이 화면이 열려 있는 동안 임시 오디오는 여전히 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname kon niet worden opgeslagen in de duurzame draft. Het tijdelijke audio is nog steeds beschikbaar terwijl dit scherm open blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania nie można zapisać do trwałego projektu. Tymczasowe dźwięki są nadal dostępne, podczas gdy ten ekran pozostaje otwarty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação não pode ser salvo para o desenho duradouro. áudio temporário ainda está disponível enquanto esta tela permanece aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись не могла быть сохранена в долговременном проекте. Временный аудио все еще доступен, пока этот экран остается открытым."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவை எழுதி முடித்தவுடன், இந்த பதிவை எழுத முடியாது.இந்த பதிவை எழுதி முடித்தவுடன், இந்த பதிவை எழுதலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกไม่สามารถบันทึกไว้ในวาดภาพที่ทนทานได้ เสียงชั่วคราวยังคงมีอยู่ในขณะที่หน้าจอนี้ยังคงเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt kalıcı taslakta kaydedilemez.Bu ekran açık kalırken geçici ses hala mevcuttur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис не можна було зберегти в довговічний проект. Тимчасовий аудіо доступний, поки цей екран залишається відкритим."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کی ریکارڈنگ کو بیکٹیریا ڈراپ میں محفوظ نہیں کیا جا سکتا.آج کی آڈیو اب بھی دستیاب ہے جبکہ یہ سکرین کھلی رہتی ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc ghi âm không thể được lưu vào bản thảo lâu dài. Âm thanh tạm thời vẫn có sẵn trong khi màn hình này vẫn mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音无法保存到持久草案中,暂时的音频仍然可用,而这个屏幕仍在打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
