    "Fix the %@ route too, so this doesn’t happen again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصلح المسار %@ أيضًا، حتى لا يتكرر ذلك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ রুটটিও ঠিক করুন, যাতে এটি আর না ঘটে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch die Route %@ korrigieren, damit das nicht wieder passiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix the %@ route too, so this doesn’t happen again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige también la ruta %@ para que no vuelva a pasar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corriger aussi le parcours %@ pour que cela ne se reproduise pas"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ रूट को भी ठीक करें, ताकि ऐसा फिर न हो"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbaiki juga rute %@ agar hal ini tidak terulang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggi anche il percorso %@ per evitare che succeda di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再発を防ぐため、%@ルートも修正する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 발생하지 않도록 %@ 루트도 수정"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigeer ook de route %@, zodat dit niet opnieuw gebeurt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw też trasę %@, aby to się nie powtórzyło"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija também a rota %@ para que isso não aconteça de novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправьте и маршрут %@, чтобы это не повторилось"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது மீண்டும் நடக்காமல் இருக்க %@ வழித்தடத்தையும் சரிசெய்யவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขเส้นทาง %@ ด้วย เพื่อไม่ให้เกิดขึ้นอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
