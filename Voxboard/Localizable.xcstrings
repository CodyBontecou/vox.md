    "Review local hotkey, recording, export, and purchase restore diagnostics.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة التشخيصات المحلية لاختصارات المفاتيح والتسجيل والتصدير واستعادة المشتريات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় হটকি, রেকর্ডিং, এক্সপোর্ট ও কেনাকাটা পুনরুদ্ধারের ডায়াগনস্টিকস পর্যালোচনা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Diagnosedaten zu Tastenkürzeln, Aufnahme, Export und Wiederherstellung von Käufen prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review local hotkey, recording, export, and purchase restore diagnostics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el diagnóstico local de atajos, grabación, exportación y restauración de compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les diagnostics locaux des raccourcis clavier, de l’enregistrement, de l’exportation et de la restauration des achats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय हॉटकी, रिकॉर्डिंग, एक्सपोर्ट और ख़रीदारी रीस्टोर डायग्नोस्टिक्स की समीक्षा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjau diagnostik pintasan lokal, perekaman, ekspor, dan pemulihan pembelian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la diagnostica locale di abbreviazioni, registrazione, esportazione e ripristino degli acquisti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのホットキー、録音、書き出し、購入の復元に関する診断情報を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 단축키, 녹음, 내보내기 및 구입 복원 진단 정보를 검토합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk lokale diagnostische gegevens over sneltoetsen, opnemen, exporteren en herstellen van aankopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj lokalną diagnostykę skrótów klawiszowych, nagrywania, eksportu i odtwarzania zakupów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise os diagnósticos locais de atalhos, gravação, exportação e restauração de compras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка локальной диагностики сочетаний клавиш, записи, экспорта и восстановления покупок."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர் சூடான விசை, பதிவு, ஏற்றுமதி மற்றும் வாங்குதல் மீட்டெடுப்புக் கண்டறிதல்களை மதிப்பாய்வு செய்யவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบข้อมูลการวินิจฉัยของปุ่มลัด การบันทึก การส่งออก และการกู้คืนการซื้อในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel kısayol tuşu, kayıt, dışa aktarma ve satın alma geri yükleme tanılama verilerini gözden geçirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляд локальної діагностики сполучень клавіш, запису, експорту й відновлення покупок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی ہاٹ کی، ریکارڈنگ، ایکسپورٹ اور خریداری کی بحالی کی تشخیص کا جائزہ لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại thông tin chẩn đoán cục bộ về phím tắt, ghi âm, xuất và khôi phục giao dịch mua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看本地快捷键、录音、导出和恢复购买的诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查本機快速鍵、錄音、輸出和回復購買的診斷資訊。"
          }
        }
      }
    },
    "Review saved HTTP payloads, retry with corrected credentials, or discard": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة حمولات HTTP المحفوظة، أو إعادة المحاولة ببيانات اعتماد مصححة، أو التجاهل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেভ করা HTTP পেলোড পর্যালোচনা করুন, সংশোধিত ক্রেডেনশিয়াল দিয়ে আবার চেষ্টা করুন, বা বাতিল করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesicherte HTTP-Daten prüfen, mit korrigierten Anmeldedaten erneut versuchen oder verwerfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review saved HTTP payloads, retry with corrected credentials, or discard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las cargas HTTP guardadas, reintenta con credenciales corregidas o descártalas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier les charges utiles HTTP enregistrées, réessayer avec des identifiants corrigés ou abandonner"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए HTTP पेलोड की समीक्षा करें, ठीक किए गए क्रेडेंशियल्स से फिर से प्रयास करें या हटाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjau payload HTTP yang tersimpan, coba lagi dengan kredensial yang diperbaiki, atau buang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i payload HTTP salvati, riprova con credenziali corrette o scartali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたHTTPペイロードを確認し、修正した認証情報で再試行するか破棄します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 HTTP 페이로드를 검토하고, 수정된 자격 증명으로 재시도하거나 폐기합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk bewaarde HTTP-gegevens, probeer opnieuw met gecorrigeerde inloggegevens of verwijder ze"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj zapisane dane HTTP, ponów z poprawionymi danymi uwierzytelniającymi lub odrzuć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise os conteúdos HTTP salvos, tente novamente com credenciais corrigidas ou descarte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка сохраненных данных HTTP, повтор с исправленными учетными данными или удаление"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமித்த HTTP தரவை மதிப்பாய்வு செய்யவும், திருத்திய சான்றுகளுடன் மீண்டும் முயற்சிக்கவும் அல்லது நிராகரிக்கவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบข้อมูล HTTP ที่บันทึกไว้ ลองอีกครั้งด้วยข้อมูลประจำตัวที่แก้ไขแล้ว หรือละทิ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı HTTP yüklerini gözden geçirin, düzeltilmiş kimlik bilgileriyle yeniden deneyin veya atın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляд збережених даних HTTP, повтор з виправленими обліковими даними або видалення"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ HTTP پے لوڈز کا جائزہ لیں، درست اسناد کے ساتھ دوبارہ کوشش کریں، یا رد کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại payload HTTP đã lưu, thử lại với thông tin xác thực đã sửa hoặc hủy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看已保存的 HTTP 负载，使用更正后的凭证重试，或丢弃"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查已儲存的 HTTP 承載資料，使用更正後的憑證重試，或丟棄"
          }
        }
      }
    },
