    "Pauses or resumes the active Vox.md recording segment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف مقطع تسجيل Vox.md النشط مؤقتًا أو يستأنفه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সক্রিয় Vox.md রেকর্ডিং অংশ থামায় বা আবার চালায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert oder setzt den aktiven Vox.md-Aufnahmeabschnitt fort."
          }
        },
