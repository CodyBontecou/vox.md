          "stringUnit": {
            "state": "translated",
            "value": "Alcune opzioni di acquisto sono temporaneamente indisponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入オプションは一時的に利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 구매 옵션은 일시적으로 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige aankoopopties zijn tijdelijk niet beschikbaar."
