    "Sets this route’s saved voice-audio filename. Leave blank for automatic naming. Unsafe path input is sanitized, and the actual audio extension replaces any typed extension.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيّن اسم ملف الصوت المحفوظ لهذا المسار. اتركه فارغًا للتسمية التلقائية. تُنظَّف إدخالات المسارات غير الآمنة، ويحل امتداد الصوت الفعلي محل أي امتداد مكتوب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রুটের সেভ করা ভয়েস-অডিওর ফাইলনাম সেট করে। স্বয়ংক্রিয় নামের জন্য ফাঁকা রাখুন। অনিরাপদ পাথ ইনপুট পরিষ্কার করা হয়, এবং টাইপ করা যেকোনো এক্সটেনশনের বদলে প্রকৃত অডিও এক্সটেনশন বসে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt den Dateinamen für gesicherte Sprachaufnahmen dieser Route fest. Leer lassen für automatische Benennung. Unsichere Pfadeingaben werden bereinigt, und die tatsächliche Audioendung ersetzt jede eingegebene Endung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets this route’s saved voice-audio filename. Leave blank for automatic naming. Unsafe path input is sanitized, and the actual audio extension replaces any typed extension."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define el nombre de archivo del audio de voz guardado de esta ruta. Déjalo en blanco para usar un nombre automático. Las entradas de ruta de acceso no seguras se limpian y la extensión real del audio reemplaza cualquier extensión escrita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le nom de fichier de l’audio vocal enregistré pour ce parcours. Laissez vide pour un nom automatique. Les saisies de chemin non sûres sont nettoyées, et l’extension audio réelle remplace toute extension saisie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रूट के सहेजे गए आवाज़-ऑडियो का फ़ाइलनाम सेट करता है। स्वचालित नाम के लिए खाली छोड़ें। असुरक्षित पाथ इनपुट साफ़ कर दिया जाता है, और वास्तविक ऑडियो एक्सटेंशन किसी भी टाइप किए गए एक्सटेंशन की जगह लेता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur nama file audio suara yang disimpan untuk rute ini. Biarkan kosong untuk penamaan otomatis. Input jalur yang tidak aman dibersihkan, dan ekstensi audio sebenarnya menggantikan ekstensi yang diketik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il nome file dell’audio vocale salvato per questo percorso. Lascia vuoto per la denominazione automatica. Gli input di percorso non sicuri vengono ripuliti e l’estensione audio reale sostituisce quella digitata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルートで保存する音声オーディオのファイル名を設定します。空欄にすると自動で名前が付けられます。安全でないパスの入力は整えられ、入力した拡張子は実際のオーディオの拡張子に置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 루트에 저장되는 음성 오디오 파일 이름을 설정합니다. 자동으로 이름을 지정하려면 비워 두세요. 안전하지 않은 경로 입력은 정리되며, 입력한 확장자는 실제 오디오 확장자로 대체됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de bestandsnaam in voor bewaarde spraakaudio van deze route. Laat leeg voor automatische naamgeving. Onveilige padinvoer wordt opgeschoond en de werkelijke audio-extensie vervangt een getypte extensie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia nazwę zapisywanego pliku audio głosu dla tej trasy. Pozostaw puste, aby nazywać automatycznie. Niebezpieczne dane ścieżki są oczyszczane, a rzeczywiste rozszerzenie audio zastępuje wpisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o nome do arquivo de áudio de voz salvo desta rota. Deixe em branco para nomeação automática. Entradas de caminho inseguras são corrigidas, e a extensão real do áudio substitui qualquer extensão digitada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задает имя сохраняемого голосового аудиофайла для этого маршрута. Оставьте пустым для автоматического имени. Небезопасные пути очищаются, а фактическое расширение аудио заменяет введенное."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வழித்தடத்தின் சேமித்த குரல் ஒலிக் கோப்புப்பெயரை அமைக்கும். தானியங்குப் பெயரிடலுக்குக் காலியாக விடவும். பாதுகாப்பற்ற பாதை உள்ளீடு சுத்திகரிக்கப்படும், தட்டச்சு செய்த நீட்டிப்புக்குப் பதிலாக உண்மையான ஒலி நீட்டிப்பு பயன்படுத்தப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งชื่อไฟล์เสียงพูดที่บันทึกของเส้นทางนี้ เว้นว่างไว้เพื่อตั้งชื่ออัตโนมัติ ข้อมูลพาธที่ไม่ปลอดภัยจะถูกปรับแก้ และนามสกุลเสียงจริงจะแทนที่นามสกุลที่พิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rotanın kaydedilen ses dosyası adını ayarlar. Otomatik adlandırma için boş bırakın. Güvenli olmayan yol girdileri temizlenir ve yazılan uzantının yerini gerçek ses uzantısı alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задає назву збереженого голосового аудіофайлу для цього маршруту. Залиште порожнім для автоматичної назви. Небезпечні шляхи очищуються, а фактичне розширення аудіо замінює введене."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس روٹ کی محفوظ آواز آڈیو کا فائل نام سیٹ کرتا ہے۔ خودکار نام کے لیے خالی چھوڑ دیں۔ غیر محفوظ راستے کا ان پٹ صاف کیا جاتا ہے، اور اصل آڈیو ایکسٹینشن کسی بھی ٹائپ کردہ ایکسٹینشن کی جگہ لیتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tên tệp âm thanh giọng nói được lưu của lộ trình này. Để trống để đặt tên tự động. Dữ liệu nhập đường dẫn không an toàn sẽ được làm sạch và phần mở rộng âm thanh thực sẽ thay thế phần mở rộng bạn nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置此路线保存的语音音频文件名。留空则自动命名。不安全的路径输入会被清理，实际的音频扩展名会替换任何输入的扩展名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定此路線儲存的語音音訊檔名。留空則自動命名。不安全的路徑輸入會被清理，實際的音訊副檔名會取代任何輸入的副檔名。"
          }
        }
      }
    },
