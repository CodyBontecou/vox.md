    "Obsidian is not installed. Use Reveal in Finder instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian غير مثبّت. استخدم «إظهار في Finder» بدلًا من ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian ইনস্টল করা নেই। এর বদলে ‘Finder-এ দেখান’ ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian ist nicht installiert. Verwenden Sie stattdessen „Im Finder zeigen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian is not installed. Use Reveal in Finder instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian no está instalado. Usa Mostrar en Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian n’est pas installé. Utilisez plutôt Afficher dans le Finder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian इंस्टॉल नहीं है। इसकी जगह Finder में दिखाएँ का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian tidak terinstal. Gunakan Tampilkan di Finder sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian non è installato. Usa invece Mostra nel Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidianがインストールされていません。代わりに「Finderに表示」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian이 설치되어 있지 않습니다. 대신 Finder에서 보기를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian is niet geïnstalleerd. Gebruik in plaats daarvan ‘Toon in Finder’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian nie jest zainstalowany. Zamiast tego użyj Pokaż w Finderze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Obsidian não está instalado. Use Mostrar no Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian не установлен. Используйте «Показать в Finder»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian நிறுவப்படவில்லை. பதிலாக Finder இல் காட்டு என்பதைப் பயன்படுத்தவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ติดตั้ง Obsidian ใช้ “แสดงใน Finder” แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian yüklü değil. Bunun yerine Finder'da Göster'i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian не встановлено. Скористайтеся «Показати у Finder»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian انسٹال نہیں ہے۔ اس کی بجائے Finder میں دکھائیں استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian chưa được cài đặt. Hãy dùng Hiển thị trong Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装 Obsidian。请改用“在访达中显示”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未安裝 Obsidian。請改用「在 Finder 中顯示」。"
          }
        }
      }
    },
