        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक लोकेशन अनुरोध पहले से जारी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan lokasi sedang berlangsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È già in corso una richiesta di posizione."
          }
        },
        "ja": {
