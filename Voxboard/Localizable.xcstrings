    "Provider links disclose the privacy-adjusted coordinates to Apple, Google, or OpenStreetMap only when you open a link.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider links disclose the privacy-adjusted coordinates to Apple, Google, or OpenStreetMap only when you open a link."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تكشف روابط موفري الخدمة الإحداثيات المعدّلة لحماية الخصوصية إلى Apple أو Google أو OpenStreetMap إلا عند فتح رابط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রোভাইডার লিংক কেবল আপনি কোনো লিংক খুললেই গোপনীয়তার জন্য সমন্বয় করা স্থানাঙ্ক Apple, Google বা OpenStreetMap-কে জানায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anbieterlinks geben die für den Datenschutz angepassten Koordinaten nur beim Öffnen eines Links an Apple, Google oder OpenStreetMap weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de proveedores revelan las coordenadas ajustadas para proteger la privacidad a Apple, Google u OpenStreetMap solo cuando abres un enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens des fournisseurs communiquent les coordonnées ajustées pour la confidentialité à Apple, Google ou OpenStreetMap uniquement lorsque vous ouvrez un lien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोवाइडर लिंक केवल आपके लिंक खोलने पर गोपनीयता के लिए समायोजित निर्देशांक Apple, Google या OpenStreetMap को बताते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan penyedia hanya mengungkapkan koordinat yang disesuaikan untuk privasi kepada Apple, Google, atau OpenStreetMap saat Anda membuka tautan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link dei fornitori comunicano le coordinate modificate per la privacy ad Apple, Google o OpenStreetMap solo quando apri un link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダリンクは、リンクを開いた場合にのみ、プライバシーに配慮して調整された座標を Apple、Google、または OpenStreetMap に開示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자 링크는 링크를 열 때만 개인정보 보호를 위해 조정된 좌표를 Apple, Google 또는 OpenStreetMap에 공개합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Providerlinks maken de voor privacy aangepaste coördinaten alleen bekend aan Apple, Google of OpenStreetMap wanneer je een link opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącza dostawców ujawniają współrzędne dostosowane pod kątem prywatności firmom Apple, Google lub OpenStreetMap tylko po otwarciu łącza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links dos provedores revelam as coordenadas ajustadas para privacidade à Apple, Google ou OpenStreetMap somente quando você abre um link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки на сервисы передают скорректированные для конфиденциальности координаты Apple, Google или OpenStreetMap только при открытии ссылки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழங்குநர் இணைப்புகள், நீங்கள் ஓர் இணைப்பைத் திறக்கும்போது மட்டுமே தனியுரிமைக்காகச் சரிசெய்யப்பட்ட ஆயங்களை Apple, Google அல்லது OpenStreetMap-க்கு வெளிப்படுத்தும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ผู้ให้บริการจะเปิดเผยพิกัดที่ปรับเพื่อความเป็นส่วนตัวแก่ Apple, Google หรือ OpenStreetMap เฉพาะเมื่อคุณเปิดลิงก์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcı bağlantıları, gizlilik için ayarlanmış koordinatları yalnızca bir bağlantıyı açtığınızda Apple, Google veya OpenStreetMap ile paylaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання постачальників передають скориговані для конфіденційності координати Apple, Google або OpenStreetMap лише після відкриття посилання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فراہم کنندہ کے لنکس رازداری کے لیے ایڈجسٹ کردہ محددات صرف لنک کھولنے پر Apple، Google یا OpenStreetMap کو ظاہر کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết của nhà cung cấp chỉ tiết lộ tọa độ đã điều chỉnh để bảo vệ quyền riêng tư cho Apple, Google hoặc OpenStreetMap khi bạn mở liên kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当您打开链接时，提供商链接才会向 Apple、Google 或 OpenStreetMap 披露为保护隐私而调整过的坐标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你開啟連結時，供應商連結才會向 Apple、Google 或 OpenStreetMap 揭露為保護隱私而調整過的座標。"
          }
        }
      }
    },
