    "Activity keeps routes and status only — never your words, links or locations.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ النشاط بالمسارات والحالة فقط — وليس بكلماتك أو روابطك أو مواقعك أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্যকলাপ শুধু রুট ও স্ট্যাটাস রাখে — কখনও আপনার কথা, লিংক বা লোকেশন নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktivität speichert nur Routen und Status – niemals Ihre Worte, Links oder Standorte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity keeps routes and status only — never your words, links or locations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad solo guarda rutas y estados, nunca tus palabras, enlaces ni ubicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activité ne conserve que les parcours et les états, jamais vos mots, liens ou positions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गतिविधि केवल रूट और स्थिति रखती है — आपके शब्द, लिंक या लोकेशन कभी नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitas hanya menyimpan rute dan status — tidak pernah kata-kata, tautan, atau lokasi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attività conserva solo percorsi e stati, mai le tue parole, i link o le posizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティにはルートとステータスのみが記録されます — 言葉、リンク、位置情報は記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동에는 루트와 상태만 남습니다. 사용자의 말, 링크 또는 위치는 저장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activiteit bewaart alleen routes en status – nooit je woorden, links of locaties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywność przechowuje tylko trasy i stan — nigdy Twoje słowa, linki ani lokalizacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Atividade guarda apenas rotas e status — nunca suas palavras, links ou localizações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активность хранит только маршруты и статусы — никогда не ваши слова, ссылки или геопозиции."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்பாடு வழித்தடங்களையும் நிலையையும் மட்டுமே வைத்திருக்கும் — உங்கள் சொற்கள், இணைப்புகள் அல்லது இருப்பிடங்களை ஒருபோதும் அல்ல."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมจะเก็บเฉพาะเส้นทางและสถานะ — ไม่เก็บคำพูด ลิงก์ หรือตำแหน่งของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlik yalnızca rotaları ve durumu tutar — sözcüklerinizi, bağlantılarınızı veya konumlarınızı asla tutmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активність зберігає лише маршрути та статуси — ніколи не ваші слова, посилання чи геопозиції."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرگرمی صرف روٹس اور اسٹیٹس رکھتی ہے — کبھی آپ کے الفاظ، لنکس یا مقامات نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động chỉ lưu lộ trình và trạng thái — không bao giờ lưu lời nói, liên kết hay vị trí của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“活动”仅保留路线和状态——绝不保留你的文字、链接或位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「活動」僅保留路線和狀態——絕不保留你的文字、連結或位置。"
          }
        }
      }
    },
