    "Saved locally. Open URL Deliveries to review it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ محليًا. افتح «عمليات التسليم إلى URL» لمراجعته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয়ভাবে সেভ হয়েছে। পর্যালোচনা করতে URL ডেলিভারি খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal gesichert. Öffnen Sie „URL-Zustellungen“, um es zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved locally. Open URL Deliveries to review it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado localmente. Abre Entregas por URL para revisarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré localement. Ouvrez Livraisons URL pour le vérifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय रूप से सहेजा गया। इसकी समीक्षा के लिए URL डिलीवरी खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan secara lokal. Buka Pengiriman URL untuk meninjaunya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvata in locale. Apri Consegne URL per controllarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルに保存しました。「URL配信」を開いて確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬에 저장되었습니다. ‘URL 전달’을 열어 검토하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaal bewaard. Open ‘URL-leveringen’ om het te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano lokalnie. Otwórz Dostarczanie pod URL, aby to przejrzeć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo localmente. Abra Entregas por URL para revisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено локально. Откройте «Доставки по URL», чтобы проверить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூரில் சேமிக்கப்பட்டது. மதிப்பாய்வு செய்ய URL வழங்கல்களைத் திறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไว้ในเครื่องแล้ว เปิด “การส่งไปยัง URL” เพื่อตรวจสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel olarak kaydedildi. İncelemek için URL Teslimleri'ni açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено локально. Відкрийте «Доставки за URL», щоб переглянути."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی طور پر محفوظ ہو گیا۔ جائزہ لینے کے لیے URL ڈیلیوریز کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu cục bộ. Mở Gửi qua URL để xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存在本地。打开“URL 递送”以查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存在本機。打開「URL 傳送」以檢查。"
          }
        }
      }
    },
