        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "7 днів безкоштовно, потім %@ %@ . Автоматично поновлюється."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "7 دن مفت، پھر %@ %@ ۔ خودکار تجدید۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "7 ngày miễn phí, sau đó %@ %@ . Tự động gia hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天免费，然后%@ %@ 。自动续订。"
