    "Send as many local notes as you like": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال الكثير من الرسائل المحلية كما تريد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যতটুকু স্থানীয় নোটগুলি আপনি পছন্দ করেন ততটাই পাঠান"
          }
        },
        "de": {
          "stringUnit": {
