          }
        }
      }
    },
    "Capture canceled because this preset requires an origin-time location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء الالتقاط لأن هذا الإعداد المسبق يتطلب موقعًا زمنيًا أصليًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার বাতিল হয়েছে কারণ এই প্রিসেটটির জন্য একটি উৎপত্তি-সময় অবস্থান প্রয়োজন৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde abgebrochen, da für diese Voreinstellung ein Ursprungs-Zeit-Standort erforderlich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture canceled because this preset requires an origin-time location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura cancelada porque este ajuste preestablecido requiere una ubicación de tiempo de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture annulée car ce préréglage nécessite un emplacement origine-heure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर रद्द कर दिया गया क्योंकि इस प्रीसेट के लिए मूल-समय स्थान की आवश्यकता होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengambilan gambar dibatalkan karena preset ini memerlukan lokasi waktu asal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisizione annullata perché questa preimpostazione richiede una posizione temporale di origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプリセットには原点時間の位置が必要なため、キャプチャがキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사전 설정에는 원본 시간 위치가 필요하므로 캡처가 취소되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname geannuleerd omdat deze voorinstelling een oorsprong-tijdlocatie vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechwytywanie zostało anulowane, ponieważ to ustawienie wstępne wymaga lokalizacji początkowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura cancelada porque esta predefinição requer um local de horário de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват отменен, поскольку для этой предустановки требуется местоположение исходного времени."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த முன்னமைவுக்கு அசல் நேர இருப்பிடம் தேவைப்படுவதால், படம்பிடித்தல் ரத்துசெய்யப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพถูกยกเลิกเนื่องจากค่าที่ตั้งไว้ล่วงหน้านี้ต้องใช้ตำแหน่งเวลาต้นทาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ön ayar başlangıç zamanı konumu gerektirdiğinden yakalama iptal edildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зйомку скасовано, оскільки для цього попереднього налаштування потрібне місце походження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر منسوخ کر دیا گیا کیونکہ اس پیش سیٹ کے لیے اصل وقت کا مقام درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc chụp bị hủy vì cài đặt trước này yêu cầu vị trí thời gian gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获已取消，因为此预设需要原始时间位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取已取消，因為此預設需要原始時間位置。"
          }
        }
      }
    },
