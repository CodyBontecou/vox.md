    "Create or select a template to edit its reusable Markdown formatting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ قالبًا أو اختره لتعديل تنسيق Markdown القابل لإعادة الاستخدام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনর্ব্যবহারযোগ্য Markdown ফরম্যাটিং সম্পাদনা করতে একটি টেমপ্লেট তৈরি করুন বা বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen oder wählen Sie eine Vorlage, um ihre wiederverwendbare Markdown-Formatierung zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create or select a template to edit its reusable Markdown formatting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea o selecciona una plantilla para editar su formato Markdown reutilizable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez ou sélectionnez un modèle pour modifier sa mise en forme Markdown réutilisable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी टेम्पलेट की दोबारा उपयोग होने वाली Markdown फ़ॉर्मेटिंग संपादित करने के लिए उसे बनाएँ या चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat atau pilih templat untuk mengedit format Markdown-nya yang dapat digunakan ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea o seleziona un modello per modificarne la formattazione Markdown riutilizzabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再利用可能なMarkdownの書式を編集するには、テンプレートを作成または選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재사용 가능한 Markdown 서식을 편집하려면 템플릿을 생성하거나 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak of selecteer een sjabloon om de herbruikbare Markdown-opmaak ervan te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz lub wybierz szablon, aby edytować jego formatowanie Markdown wielokrotnego użytku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie ou selecione um modelo para editar sua formatação Markdown reutilizável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте или выберите шаблон, чтобы изменить его многоразовое оформление Markdown."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் பயன்படுத்தக்கூடிய Markdown வடிவமைப்பைத் திருத்த ஒரு வார்ப்புருவை உருவாக்கவும் அல்லது தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างหรือเลือกเทมเพลตเพื่อแก้ไขรูปแบบ Markdown ที่ใช้ซ้ำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden kullanılabilir Markdown biçimlendirmesini düzenlemek için bir şablon oluşturun veya seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть або виберіть шаблон, щоб змінити його багаторазове оформлення Markdown."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کی دوبارہ قابل استعمال Markdown فارمیٹنگ میں ترمیم کے لیے کوئی ٹیمپلیٹ بنائیں یا منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo hoặc chọn một mẫu để sửa định dạng Markdown dùng lại được của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建或选择一个模板，以编辑其可重复使用的 Markdown 格式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立或選擇一個範本，以編輯其可重複使用的 Markdown 格式。"
          }
        }
      }
    },
