          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi finché non scegli Elabora ora in Attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティで「今すぐ処理」を選ぶまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동에서 ‘지금 처리’를 선택할 때까지 대기합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot je ‘Verwerk nu’ kiest in Activiteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekaj, aż wybierzesz Przetwórz teraz w Aktywności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarda até você escolher Processar Agora na Atividade."
          }
        },
