            "state": "translated",
            "value": "Transcript i audio są przechowywane do retry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio e a transcrição são mantidos para retry"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио и транскрипт сохраняются для ретри"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio and transcript is retained for retry (அதிகப்பதிவு மற்றும் பதிப்புகள் retry)"
          }
        },
        "th": {
