    "No Dock icon or Cmd-Tab entry. Click the menu bar item to reveal Vox.md.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يظهر أي ألبوم Dock أو مكتبة Cmd-Tab. انقر فوق العنوان على صفحة الملفات لتظهر Vox.md."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইকন বা ডকুমেন্টস Cmd-Tab প্রবেশ খোঁজার জন্য মেনু বার আইটেমটি ক্লিক করুন Vox.md."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Dock-Symbol und kein Cmd-Tab-Eintrag. Klicken Sie auf das Menüleisten-Symbol, um Vox.md anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Dock icon or Cmd-Tab entry. Click the menu bar item to reveal Vox.md."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay iconos o Cmd-Tab La entrada. Haga clic en el menú de la barra para mostrar Vox.md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’icône ou Cmd-Tab Entrée Cliquez sur la barre de menu pour afficher Vox.md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई आईक्यूब नहीं है या Cmd-Tab प्रवेश दिखाने के लिए मेनू बार पर क्लिक करें Vox.md."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada ikon atau Cmd-Tab Masuknya Klik menu bar untuk mengungkapkan Vox.md."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun icone o Cmd-Tab di entrata. Clicca sulla barra del menu per rivelare Vox.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンもないし、 Cmd-Tab 入場。 メニューバーをクリックして、表示する Vox.md."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘이 없거나 Cmd-Tab 입구에 들어가 메뉴 바 항목을 클릭하여 공개 Vox.md."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen Icon of Cmd-Tab De ingang. Klik op de menu bar om te onthullen Vox.md."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma ikony dokującej lub Cmd-Tab Wejście Kliknij menu bar, aby odkryć Vox.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há icônicos ou Cmd-Tab A entrada. Clique na barra de menu para revelar Vox.md."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Икона Док или Cmd-Tab Вход в Нажмите на пункт меню для раскрытия Vox.md."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon ஐ இல்லை Cmd-Tab உள்ளே Menu bar item என்பதை அறியவும் Vox.md."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มี Dock ไอคอน หรือ Cmd-Tab การเข้าสู่ระบบ คลิกที่รายการแถบเมนูเพื่อเปิดเผย Vox.md."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock icona sahip değil Cmd-Tab Giriş yapın Menü çubuğunu göstermek için tıklayın Vox.md."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ікони не є іконами або Cmd-Tab Вхідні Натисніть на пункт меню, щоб розкрити Vox.md."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی ڈک آؤٹ یا Cmd-Tab داخلہ مینو بار پر کلک کریں کہ ظاہر ہو جائے Vox.md."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có icon hoặc Cmd-Tab Lối vào Click vào menu bar để tiết lộ Vox.md."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有Dock 图标或 Cmd-Tab 入口。 点击菜单栏项来显示 Vox.md."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有Dock 圖標或 Cmd-Tab 入口。 點擊菜單欄項來顯示 Vox.md."
          }
        }
      }
    },
