    "One-time purchase. Doesn’t cancel an existing subscription. Prices shown from the App Store.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية شراء لمرة واحدة. لا تُلغي أي اشتراك حالي. الأسعار معروضة من App Store."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এককালীন কেনাকাটা। বিদ্যমান সাবস্ক্রিপশন বাতিল করে না। মূল্য App Store থেকে দেখানো হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger Kauf. Ein bestehendes Abo wird dadurch nicht gekündigt. Preise laut App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time purchase. Doesn’t cancel an existing subscription. Prices shown from the App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. No cancela una suscripción existente. Precios obtenidos del App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat unique. N’annule pas un abonnement existant. Prix indiqués par l’App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार की ख़रीदारी। मौजूदा सब्सक्रिप्शन रद्द नहीं करती। कीमतें App Store से दिखाई गई हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian satu kali. Tidak membatalkan langganan yang ada. Harga ditampilkan dari App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto una tantum. Non annulla un abbonamento esistente. Prezzi indicati dall’App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りです。既存のサブスクリプションはキャンセルされません。価格はApp Storeの表示です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일회성 구입입니다. 기존 구독은 취소되지 않습니다. 가격은 App Store 기준입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige aankoop. Een bestaand abonnement wordt niet opgezegd. Prijzen volgens de App Store."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup jednorazowy. Nie anuluje istniejącej subskrypcji. Ceny według App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. Não cancela uma assinatura existente. Preços exibidos pela App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка. Не отменяет существующую подписку. Цены указаны по данным App Store."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒருமுறை வாங்குதல். ஏற்கனவே உள்ள சந்தாவை ரத்துசெய்யாது. விலைகள் App Store இலிருந்து காட்டப்படுகின்றன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อครั้งเดียว ไม่ได้ยกเลิกการสมัครรับที่มีอยู่ ราคาแสดงจาก App Store"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik satın alma. Mevcut bir aboneliği iptal etmez. Fiyatlar App Store'dan alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноразова покупка. Не скасовує наявну підписку. Ціни вказано за даними App Store."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار کی خریداری۔ موجودہ سبسکرپشن منسوخ نہیں کرتی۔ قیمتیں App Store سے دکھائی گئی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần. Không hủy gói đăng ký hiện có. Giá hiển thị từ App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买。不会取消现有订阅。价格以 App Store 显示为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性購買。不會取消現有的訂閱。價格以 App Store 顯示為準。"
          }
        }
      }
    },
    "Only pinned routes appear on Apple Watch. Until you change this, every route is available.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر المسارات المثبّتة فقط على Apple Watch. إلى أن تغيّر ذلك، يكون كل مسار متاحًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-এ শুধু পিন করা রুটগুলো দেখা যায়। আপনি এটি না বদলানো পর্যন্ত প্রতিটি রুট উপলব্ধ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur angeheftete Routen erscheinen auf der Apple Watch. Bis Sie dies ändern, ist jede Route verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only pinned routes appear on Apple Watch. Until you change this, every route is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las rutas fijadas aparecen en el Apple Watch. Hasta que lo cambies, todas las rutas están disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les parcours épinglés apparaissent sur l’Apple Watch. Tant que vous ne modifiez pas ce réglage, tous les parcours sont disponibles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch पर केवल पिन किए गए रूट्स दिखते हैं। जब तक आप इसे नहीं बदलते, हर रूट उपलब्ध है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya rute yang disematkan yang muncul di Apple Watch. Sampai Anda mengubahnya, setiap rute tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i percorsi fissati appaiono su Apple Watch. Finché non modifichi questa impostazione, tutti i percorsi sono disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchにはピン留めしたルートのみが表示されます。これを変更するまでは、すべてのルートが利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch에는 고정된 루트만 표시됩니다. 이 설정을 변경하기 전까지는 모든 루트를 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen vastgezette routes verschijnen op de Apple Watch. Tot je dit wijzigt, is elke route beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Apple Watch pojawiają się tylko przypięte trasy. Dopóki tego nie zmienisz, dostępna jest każda trasa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as rotas fixadas aparecem no Apple Watch. Até você alterar isso, todas as rotas ficam disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Apple Watch отображаются только закрепленные маршруты. Пока вы это не измените, доступны все маршруты."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொருத்திய வழித்தடங்கள் மட்டுமே Apple Watch இல் தோன்றும். நீங்கள் இதை மாற்றும் வரை, ஒவ்வொரு வழித்தடமும் கிடைக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเส้นทางที่ปักหมุดเท่านั้นที่จะแสดงบน Apple Watch จนกว่าคุณจะเปลี่ยนการตั้งค่านี้ ทุกเส้นทางจะพร้อมใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch'ta yalnızca sabitlenen rotalar görünür. Bunu değiştirene kadar tüm rotalar kullanılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На Apple Watch відображаються лише закріплені маршрути. Доки ви це не зміните, доступні всі маршрути."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch پر صرف پن شدہ روٹس دکھائی دیتے ہیں۔ جب تک آپ اسے تبدیل نہ کریں، ہر روٹ دستیاب ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ các lộ trình đã ghim xuất hiện trên Apple Watch. Cho đến khi bạn thay đổi, mọi lộ trình đều khả dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已固定的路线会显示在 Apple Watch 上。在你更改此设置前，所有路线均可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已釘選的路線會顯示在 Apple Watch 上。在你變更此設定前，所有路線均可使用。"
          }
        }
      }
    },
    "Only typed Capture text is processed; voice transcriptions stay exactly as captured.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم معالجة نص الالتقاط المكتوب فقط؛ وتبقى النسخ الصوتية تمامًا كما تم التقاطها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু টাইপ করা ক্যাপচার টেক্সট প্রসেস করা হয়; ভয়েস ট্রান্সক্রিপশন ঠিক যেমন ক্যাপচার হয়েছে তেমনই থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur getippter Erfassungstext wird verarbeitet; Sprachtranskriptionen bleiben genau wie erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only typed Capture text is processed; voice transcriptions stay exactly as captured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se procesa el texto escrito en la captura; las transcripciones de voz se mantienen tal como se capturaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le texte saisi dans la capture est traité ; les transcriptions vocales restent telles quelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल टाइप किया गया कैप्चर टेक्स्ट प्रोसेस किया जाता है; आवाज़ के ट्रांसक्रिप्शन ठीक वैसे ही रहते हैं जैसे कैप्चर किए गए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya teks Tangkapan yang diketik yang diproses; transkripsi suara tetap persis seperti saat ditangkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene elaborato solo il testo digitato nelle acquisizioni; le trascrizioni vocali restano esattamente come acquisite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力したキャプチャのテキストのみが処理されます。音声の文字起こしはキャプチャしたまま保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 캡처 텍스트만 처리됩니다. 음성 전사는 캡처한 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen getypte vastlegtekst wordt verwerkt; spraaktranscripties blijven precies zoals vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przetwarzany jest tylko wpisany tekst przechwyceń; transkrypcje głosu pozostają dokładnie takie, jak przechwycono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o texto digitado na captura é processado; as transcrições de voz permanecem exatamente como capturadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывается только введенный текст захвата; голосовые транскрипции остаются как есть."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தட்டச்சு செய்த பிடிப்பு உரை மட்டுமே செயலாக்கப்படும்; குரல் உரைமாற்றங்கள் பிடித்தபடியே இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประมวลผลเฉพาะข้อความการจับภาพที่พิมพ์ การถอดเสียงพูดจะคงไว้ตามที่จับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yazılan Yakalama metni işlenir; ses transkripsiyonları tam olarak yakalandığı gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обробляється лише введений текст захоплення; голосові транскрипції залишаються як є."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف ٹائپ کردہ کیپچر متن پروسیس ہوتا ہے؛ آواز کی ٹرانسکرپشنز بالکل ویسی ہی رہتی ہیں جیسی کیپچر ہوئیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xử lý văn bản ghi nhanh đã nhập; bản chép lời giọng nói được giữ nguyên như khi ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅处理输入的采集文本；语音转录将完全保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅處理輸入的擷取文字；語音轉錄會完全保持原樣。"
          }
        }
      }
    },
