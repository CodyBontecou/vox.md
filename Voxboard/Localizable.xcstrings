        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Vox.md in Impostazioni di Sistema › Generali › Elementi login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」›「一般」›「ログイン項目」でVox.mdを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 일반 › 로그인 항목에서 Vox.md를 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Vox.md toe in Systeeminstellingen › Algemeen › Inlogonderdelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na Vox.md w Ustawienia systemowe › Ogólne › Rzeczy otwierane podczas logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
