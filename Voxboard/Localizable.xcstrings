            "state": "translated",
            "value": "捕捉文本超过了100,000字符的安全限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉文本超過了100,000字符的安全限制。"
          }
        }
      }
    },
