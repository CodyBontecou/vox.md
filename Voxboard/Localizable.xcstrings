        }
      }
    },
    "Permission is requested only when you allow it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُطلب الإذن إلا عندما تسمح بذلك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অনুমতি দিলেই কেবল অনুমতির অনুরোধ করা হয়"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigung wird erst angefragt, wenn Sie es erlauben"
