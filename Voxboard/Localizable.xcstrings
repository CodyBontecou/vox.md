            "value": "تعذّر استيراد الصوت: %@. تم الاحتفاظ بالمصدر المستورد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও ইমপোর্ট করা যায়নি: %@। ইমপোর্ট করা উৎসটি সংরক্ষিত আছে।"
          }
        },
        "de": {
