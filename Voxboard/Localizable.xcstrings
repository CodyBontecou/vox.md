    "Finish the current recording before extracting text from images.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إكمال المسح الحالي قبل استخراج النص من الصور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমেজ থেকে পাঠ্য অতিক্রম করার আগে বর্তমান রেকর্ডিং শেষ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie die aktuelle Aufnahme, bevor Sie Text aus Bildern extrahieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the current recording before extracting text from images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizar la grabación actual antes de extraer texto de imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez l'enregistrement actuel avant d'extraire du texte à partir d'images."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्रों से पाठ निकालने से पहले वर्तमान रिकॉर्डिंग को पूरा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan rekaman saat ini sebelum mengekstrak teks dari gambar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completare la registrazione corrente prima di estrarre il testo dalle immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像からテキストを抽出する前に、現在の録音を完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 텍스트를 추출하기 전에 현재 녹음을 완료합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi de huidige opname voordat u tekst uit afbeeldingen extrahert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończ bieżące nagrywanie przed wyodrębnieniem tekstu z obrazów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminar a gravação atual antes de extrair texto de imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите текущую запись, прежде чем извлекать текст из изображений."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது எழுதப்பட்ட பதிவுகளை வெளியிடுவதற்கு முன் எழுதுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสร็จสิ้นการบันทึกปัจจุบันก่อนที่จะสกัดข้อความจากภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntülerden metin çıkarmadan önce mevcut kaydetmeyi tamamlayın."
          }
