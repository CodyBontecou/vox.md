    "This Capture changed or became busy. Open the route again to switch safely.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر هذا الالتقاط أو أصبح مشغولًا. افتح المسار مرة أخرى للتبديل بأمان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ক্যাপচার পরিবর্তিত বা ব্যস্ত হয়ে গেছে। নিরাপদে বদলাতে রুটটি আবার খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Erfassung wurde geändert oder ist beschäftigt. Öffnen Sie die Route erneut, um sicher zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Capture changed or became busy. Open the route again to switch safely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta captura cambió o está ocupada. Vuelve a abrir la ruta para cambiarla de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette capture a changé ou est occupée. Rouvrez le parcours pour en changer en toute sécurité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कैप्चर बदल गया या व्यस्त हो गया। सुरक्षित रूप से बदलने के लिए रूट फिर से खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan ini berubah atau sedang sibuk. Buka rute lagi untuk beralih dengan aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa acquisizione è cambiata o è occupata. Apri di nuovo il percorso per cambiarlo in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキャプチャは変更されたか、処理中です。安全に切り替えるには、ルートをもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 캡처가 변경되었거나 사용 중입니다. 안전하게 전환하려면 루트를 다시 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vastlegging is gewijzigd of bezet. Open de route opnieuw om veilig te wisselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To przechwycenie zmieniło się lub jest zajęte. Otwórz trasę ponownie, aby bezpiecznie ją zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta captura mudou ou ficou ocupada. Abra a rota novamente para trocá-la com segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот захват изменился или занят. Откройте маршрут снова, чтобы безопасно переключиться."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பிடிப்பு மாறியது அல்லது பணியில் உள்ளது. பாதுகாப்பாக மாற வழித்தடத்தை மீண்டும் திறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพนี้มีการเปลี่ยนแปลงหรือกำลังทำงานอยู่ เปิดเส้นทางอีกครั้งเพื่อสลับอย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Yakalama değişti veya meşgul. Güvenle geçiş yapmak için rotayı yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це захоплення змінилося або зайняте. Відкрийте маршрут знову, щоб безпечно перемкнутися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کیپچر تبدیل ہو گیا یا مصروف ہو گیا۔ محفوظ طریقے سے تبدیل کرنے کے لیے روٹ دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi nhanh này đã thay đổi hoặc đang bận. Mở lại lộ trình để chuyển an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此采集已更改或正忙。请重新打开路线以安全切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此擷取已變更或正忙碌。請重新打開路線以安全切換。"
          }
        }
      }
    },
    "This capture was delivered before Vox.md kept a copy of the written Markdown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسليم هذا الالتقاط قبل أن يحتفظ Vox.md بنسخة من ملف Markdown المكتوب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md লেখা Markdown-এর কপি রাখা শুরু করার আগেই এই ক্যাপচার ডেলিভার হয়েছিল।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Erfassung wurde zugestellt, bevor Vox.md eine Kopie des geschriebenen Markdown aufbewahrt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This capture was delivered before Vox.md kept a copy of the written Markdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta captura se entregó antes de que Vox.md guardara una copia del Markdown escrito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette capture a été livrée avant que Vox.md ne conserve une copie du Markdown écrit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कैप्चर तब डिलीवर हुआ था जब Vox.md लिखे गए Markdown की कॉपी नहीं रखता था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan ini dikirim sebelum Vox.md menyimpan salinan Markdown yang ditulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa acquisizione è stata consegnata prima che Vox.md conservasse una copia del Markdown scritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキャプチャは、Vox.mdが書き込んだMarkdownのコピーを保持するようになる前に配信されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 캡처는 Vox.md가 기록된 Markdown의 사본을 보관하기 전에 전달되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vastlegging is afgeleverd voordat Vox.md een kopie van de geschreven Markdown bewaarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To przechwycenie zostało dostarczone, zanim Vox.md zaczął przechowywać kopię zapisanego pliku Markdown."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta captura foi entregue antes de o Vox.md manter uma cópia do Markdown escrito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот захват был доставлен до того, как Vox.md начал сохранять копию записанного Markdown."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுதப்பட்ட Markdown இன் நகலை Vox.md வைத்திருக்கத் தொடங்கும் முன்பே இந்தப் பிடிப்பு வழங்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพนี้ถูกส่งก่อนที่ Vox.md จะเก็บสำเนา Markdown ที่เขียนไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yakalama, Vox.md yazılan Markdown'ın bir kopyasını tutmaya başlamadan önce teslim edildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це захоплення було доставлено до того, як Vox.md почав зберігати копію записаного Markdown."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کیپچر اس وقت ڈیلیور ہوا تھا جب Vox.md لکھے گئے Markdown کی کاپی نہیں رکھتا تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi nhanh này được gửi trước khi Vox.md lưu bản sao của Markdown đã ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此采集是在 Vox.md 开始保留写入的 Markdown 副本之前送达的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此擷取是在 Vox.md 開始保留寫入的 Markdown 副本之前送達的。"
          }
        }
      }
    },
    "This deletes the Activity and Library record. Any delivered Markdown file stays in place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف هذا السجل من «النشاط» و«المكتبة». يبقى أي ملف Markdown تم تسليمه في مكانه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি কার্যকলাপ ও লাইব্রেরির রেকর্ড ডিলিট করে। ডেলিভার করা যেকোনো Markdown ফাইল যেমন আছে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Eintrag in „Aktivität“ und der Mediathek gelöscht. Eine bereits zugestellte Markdown-Datei bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the Activity and Library record. Any delivered Markdown file stays in place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el registro de Actividad y de la biblioteca. Los archivos Markdown entregados se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime la fiche dans Activité et la bibliothèque. Tout fichier Markdown livré reste en place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे गतिविधि और लाइब्रेरी रिकॉर्ड डिलीट हो जाता है। डिलीवर की गई कोई भी Markdown फ़ाइल अपनी जगह रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus catatan di Aktivitas dan Pustaka. File Markdown yang sudah dikirim tetap di tempatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione elimina il record in Attività e nella Libreria. I file Markdown consegnati restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティとライブラリの記録を削除します。配信済みのMarkdownファイルはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동 및 보관함 기록을 삭제합니다. 전달된 Markdown 파일은 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de record in Activiteit en de bibliotheek verwijderd. Een afgeleverd Markdown-bestand blijft staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie rekordu w Aktywności i Bibliotece. Dostarczone pliki Markdown pozostaną na miejscu."
