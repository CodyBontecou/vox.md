    "“Remind me to book flights for Lisbon”": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«ذكّرني بحجز رحلات إلى لشبونة»"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“লিসবনের ফ্লাইট বুক করার কথা মনে করিয়ে দিও”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Erinnere mich daran, Flüge nach Lissabon zu buchen“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Remind me to book flights for Lisbon”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Recuérdame reservar vuelos a Lisboa”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Rappelle-moi de réserver les vols pour Lisbonne »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“लिस्बन के लिए फ़्लाइट बुक करना याद दिलाओ”"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ingatkan saya memesan tiket pesawat ke Lisbon”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ricordami di prenotare i voli per Lisbona”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「リスボン行きの航空券の予約をリマインドして」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“리스본행 항공권 예약 알려 줘”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Herinner me eraan vluchten naar Lissabon te boeken’"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Przypomnij mi o rezerwacji lotów do Lizbony”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Lembre-me de reservar voos para Lisboa”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Напомни забронировать билеты в Лиссабон»"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“லிஸ்பனுக்கு விமான டிக்கெட் முன்பதிவு செய்ய நினைவூட்டு”"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“เตือนให้จองเที่ยวบินไปลิสบอน”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bana Lizbon için uçak bileti almayı hatırlat”"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Нагадай забронювати квитки до Лісабона»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“مجھے لزبن کی پروازیں بک کرنے کی یاد دلاؤ”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nhắc tôi đặt vé máy bay đi Lisbon”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“提醒我订去里斯本的机票”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「提醒我訂去里斯本的機票」"
          }
        }
      }
    },
