    "The Capture was cancelled because its preset requires an origin-time location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء الالتقاط لأن إعداده المسبق يتطلب موقعًا زمنيًا أصليًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার বাতিল করা হয়েছে কারণ এর প্রিসেটের জন্য একটি উৎপত্তি-সময় অবস্থান প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erfassung wurde abgebrochen, da ihr Preset einen Standort zum Ursprungszeitpunkt erfordert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Capture was cancelled because its preset requires an origin-time location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura fue cancelada porque su configuración preestablecida requiere una ubicación de tiempo de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture a été annulée car son préréglage nécessite un emplacement origine-heure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर रद्द कर दिया गया क्योंकि इसके प्रीसेट के लिए मूल-समय स्थान की आवश्यकता होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengambilan dibatalkan karena presetnya memerlukan lokasi waktu asal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cattura è stata annullata perché la sua preimpostazione richiede una posizione temporale di origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットには原点時間の位置が必要なため、キャプチャはキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 설정에 원본 시간 위치가 필요하므로 캡처가 취소되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is geannuleerd omdat de voorinstelling een oorsprong-tijdlocatie vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechwytywanie zostało anulowane, ponieważ jego ustawienie wstępne wymaga lokalizacji w czasie rozpoczęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A captura foi cancelada porque sua predefinição requer uma localização de horário de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват был отменен, поскольку его предустановка требует указания местоположения во времени."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிடிப்பு ரத்துசெய்யப்பட்டது, ஏனெனில் அதன் முன்னமைவுக்கு அசல் நேர இருப்பிடம் தேவை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพถูกยกเลิกเนื่องจากการตั้งค่าล่วงหน้าต้องใช้ตำแหน่งเวลาต้นทาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama, ön ayarının başlangıç zamanı konumunu gerektirmesi nedeniyle iptal edildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зйомку скасовано, оскільки для її попереднього налаштування потрібне місце походження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر منسوخ کر دیا گیا تھا کیونکہ اس کے پیش سیٹ کے لیے اصل وقت کا مقام درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình Chụp đã bị hủy vì cài đặt trước của nó yêu cầu vị trí tại thời điểm gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获被取消，因为其预设需要原始时间位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捕獲被取消，因為其預設需要原始時間位置。"
          }
        }
      }
    },
    "The Family upgrade is available to existing Unlimited owners.": {
