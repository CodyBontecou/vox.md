            "value": "Non si può registrare %1$@. Prova un altro taglio. (Statuto %2$d)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録できない %1$@. 別の短縮方法を試してみてください。 (オススメ) %2$d)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록할 수 없음 %1$@. 다른 짧은 길을 시도해 보세요. (이상한 %2$d)"
          }
        },
        "nl": {
