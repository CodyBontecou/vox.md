    "Capture an idea, task, link, file, scan, or recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط فكرة أو مهمة أو رابطًا أو ملفًا أو مسحًا ضوئيًا أو تسجيلًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ভাবনা, কাজ, লিংক, ফাইল, স্ক্যান বা রেকর্ডিং ক্যাপচার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassen Sie eine Idee, eine Aufgabe, einen Link, eine Datei, einen Scan oder eine Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture an idea, task, link, file, scan, or recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura una idea, tarea, enlace, archivo, escaneo o grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturez une idée, une tâche, un lien, un fichier, un scan ou un enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई विचार, कार्य, लिंक, फ़ाइल, स्कैन या रिकॉर्डिंग कैप्चर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkap ide, tugas, tautan, file, pindaian, atau rekaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisisci un’idea, un’attività, un link, un file, una scansione o una registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイデア、タスク、リンク、ファイル、スキャン、録音をキャプチャ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이디어, 작업, 링크, 파일, 스캔 또는 녹음을 캡처하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg een idee, taak, link, bestand, scan of opname vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz pomysł, zadanie, link, plik, skan lub nagranie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture uma ideia, tarefa, link, arquivo, digitalização ou gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафиксируйте идею, задачу, ссылку, файл, скан или запись."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு எண்ணம், பணி, இணைப்பு, கோப்பு, ஸ்கேன் அல்லது பதிவைப் பிடியுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับไอเดีย งาน ลิงก์ ไฟล์ สแกน หรือการบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fikir, görev, bağlantı, dosya, tarama veya kayıt yakalayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафіксуйте ідею, завдання, посилання, файл, скан або запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی خیال، کام، لنک، فائل، اسکین یا ریکارڈنگ کیپچر کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại ý tưởng, tác vụ, liên kết, tệp, bản quét hoặc bản ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
