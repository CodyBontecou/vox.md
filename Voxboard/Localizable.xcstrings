    "Transcription and processing stay on this Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى النسخ الصوتي والمعالجة على هذا الـ Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সক্রিপশন ও প্রসেসিং এই Mac-এই থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
