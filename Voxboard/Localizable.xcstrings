    "Open Stats from Settings to see lifetime totals for recordings, captures, recorded time, and attachments, all stored on your device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بفتح الإحصاء من الإعدادات لترجمة مجموعات مدة حياة للمسجلات والخرائط والمرحلة المرسلة والملفات المرسومة، كلها تم تخزينها على جهازك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ট্যাটাসটি সেটিংস থেকে খুলুন, যাতে রেকর্ডিংয়ের জন্য লাইফটাইম মোটগুলি, ক্যাপচার, রেকআপ করা সময় এবং অ্যাডেঞ্জগুলির জন্য দেখা যায়, যা সব আপনার ডিভাইসে সংরক্ষিত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Statistiken in den Einstellungen, um Lebenszeit-Summen für Aufnahmen, Erfassungen, Aufnahmezeit und Anhänge zu sehen – alles auf Ihrem Gerät gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Stats from Settings to see lifetime totals for recordings, captures, recorded time, and attachments, all stored on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Estadísticas en Configuración para ver los totales de vida de las grabaciones, capturas, tiempo grabado y anexos, todos almacenados en su dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez les états dans les paramètres pour voir les totalisations de la durée de vie des enregistrements, des captures, du temps enregistré et des pièces jointes, toutes stockées sur votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स से स्टेट्स पर जाएं ताकि आप रिकॉर्डिंग, कैप्चर, रिकॉर्ड समय और संलग्नकों के जीवनकाल कुल देखें, जो सभी आपके डिवाइस पर संग्रहीत हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Stats dari Pengaturan untuk melihat total masa hidup untuk rekaman, capture, waktu yang tercatat, dan lampiran, semua disimpan di perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprire Stati da Impostazioni per visualizzare i totali di vita per le registrazioni, le catture, il tempo registrato e gli allegati, tutti memorizzati sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定から「統計」を開き、録画、キャプチャ、録音時間、および添付ファイルの生涯合計を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 통계를 열어 기록, 캡처, 기록 시간 및 첨부 파일의 평생 총을 볼 수 있습니다.Open Stats from Settings to see lifetime totals for recordings, captures, recorded time, and attachments, all stored on your device."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Staten in Instellingen om levensduurtotaal voor opnamen, opnames, opgenomen tijd en bijlagen te bekijken, allemaal opgeslagen op uw apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz pozycję Statystyki w ustawieniach, aby wyświetlić sumy okresu życia nagrań, nagrań, czasu nagrywania i załączników, wszystkie przechowywane na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Estatísticas em Configurações para ver os totais de vida útil de gravações, capturas, tempo gravado e anexos, todos armazenados no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Статистики в Настройках, чтобы просмотреть суммы за всю жизнь записей, записей, записанного времени и приложений, все они хранятся на вашем устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அதாவது, அ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดสถิติจาก Settings เพื่อดูรวมอายุการใช้งานสําหรับบันทึก, การจับเวลาและไฟล์แนบทั้งหมดที่เก็บไว้บนอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlardan İstatistikler'i açın, kayıtlar, yakalama, kaydedilen zaman ve ekler için ömür boyu toplamları görüntüleyebilirsiniz, hepsi cihazınızda depolanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Статистика в Налаштуваннях, щоб переглянути суми за всю життя записів, зйомок, записаного часу та додань, всі вони зберігаються на вашому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیبات سے اسٹافز کھولیں، آپ کے آلے پر ذخیرہ کردہ ریکارڈز، گرفتاریوں، ریکارڈ وقت اور ملحقہ کے لئے زندگی بھر کل دیکھیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Stats từ Settings để xem tổng số cuộc sống cho các bản ghi, ghi lại, thời gian được ghi lại và đính kèm, tất cả đều được lưu trữ trên thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“设置”打开“统计”,查看记录,捕获,记录时间和附件的终身总数,所有这些都存储在您的设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從“設置”打開“統計”,查看記錄,捕獲,記錄時間和附件的終身總數,所有這些都存儲在您的設備上。"
          }
        }
      }
    },
