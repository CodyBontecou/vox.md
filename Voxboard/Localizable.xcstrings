        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与统一的关系 Markdown 目的地 空白,使用其默认附件文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與統一的關係 Markdown 目的地 空白,使用其默認附件文件夾。"
          }
        }
      }
