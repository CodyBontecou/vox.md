          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオを読み込めませんでした：%@。読み込み元のファイルは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 가져올 수 없습니다: %@. 가져온 원본은 보존되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
