    "Pay once and keep it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادفع مرة واحدة واحفظها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার টাকা দেন এবং তা রাখুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal bezahlen und behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay once and keep it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga una vez y lo mantendrás"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez une fois et gardez-le"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार भुगतान करें और इसे रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayar sekali dan simpan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagare una volta e tenerlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い1回、保管"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한번 지불하고 그것을 유지하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaal een keer en houd het"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płać raz i zachowaj"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague uma vez e mantenha"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заплати один раз и держи"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு முறை செலுத்துங்கள், அதைக் கவனியுங்கள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จ่ายเงินครั้งเดียวและเก็บไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez ödeme yapın ve tutun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заплати один раз і збережи"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار ادا کریں اور اسے رکھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả tiền một lần và giữ nó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付一次,留下来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付一次,留下來"
          }
        }
      }
    },
    "Pay once. No subscription or renewal.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفع مرة واحدة: لا توزيع أو إعادة التدوير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবারে অর্থ প্রদান করুন. কোন সাবস্ক্রিপশন বা পুনর্নবীকরণ নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal bezahlen. Keine Abonnement- oder Erneuerungspflicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay once. No subscription or renewal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga una vez. Sin suscripción ni renovación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez une fois, pas de renouvellement ni d’abonnement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार भुगतान करें. कोई सदस्यता या नवीनीकरण नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayar sekali, tidak ada pembaruan atau pendaftaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagare una volta, senza abbonamento o rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約なし、更新なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1회 지불, 가입 또는 갱신 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaal één keer, geen abonnement of verlenging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność raz. bez subskrypcji lub odnowienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pague uma vez. sem subscrição ou renovação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платить один раз. Без подписки или продления."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு முறை செலுத்தும்.ஒரு முறை அல்லது ஒரு முறை செலுத்தவும் இல்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การชําระเงินครั้งเดียว ไม่มีการสมัครสมาชิกหรือการต่ออายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik ödeme.Hiçbir abonelik veya yenileme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата одноразова, без підписки або поновлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار ادا کریں. کوئی سائن اپ یا تجدید نہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "- Thanh toán 1 lần, không đăng ký hoặc gia hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付一次,无订阅或续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付一次,無訂閱或續訂。"
          }
        }
      }
    },
