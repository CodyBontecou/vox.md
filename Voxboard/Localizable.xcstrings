    "Voice transcriptions and typed Capture text are processed on device using this mode.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم معالجة النسخ الصوتية ونص الالتقاط المكتوب على الجهاز باستخدام هذا الوضع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভয়েস ট্রান্সক্রিপশন ও টাইপ করা ক্যাপচার টেক্সট এই মোডে ডিভাইসেই প্রসেস করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachtranskriptionen und getippter Erfassungstext werden mit diesem Modus auf dem Gerät verarbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice transcriptions and typed Capture text are processed on device using this mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transcripciones de voz y el texto escrito en la captura se procesan en el dispositivo con este modo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transcriptions vocales et le texte saisi dans une capture sont traités sur l’appareil selon ce mode."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ के ट्रांसक्रिप्शन और टाइप किया गया कैप्चर टेक्स्ट इस मोड से डिवाइस पर प्रोसेस किए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsi suara dan teks Tangkapan yang diketik diproses di perangkat menggunakan mode ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trascrizioni vocali e il testo digitato nelle acquisizioni vengono elaborati sul dispositivo con questa modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の文字起こしと入力したキャプチャのテキストは、このモードを使用してデバイス上で処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 전사와 입력한 캡처 텍스트는 이 모드를 사용하여 기기에서 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraaktranscripties en getypte vastlegtekst worden met deze modus op het apparaat verwerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcje głosu i wpisany tekst przechwyceń są przetwarzane na urządzeniu w tym trybie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrições de voz e texto digitado na captura são processados no dispositivo com este modo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовые транскрипции и введенный текст захвата обрабатываются на устройстве в этом режиме."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குரல் உரைமாற்றங்களும் தட்டச்சு செய்த பிடிப்பு உரையும் இந்தப் பயன்முறையைப் பயன்படுத்தி சாதனத்திலேயே செயலாக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอดเสียงพูดและข้อความการจับภาพที่พิมพ์จะได้รับการประมวลผลบนอุปกรณ์โดยใช้โหมดนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses transkripsiyonları ve yazılan Yakalama metni bu mod kullanılarak aygıtta işlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосові транскрипції та введений текст захоплення обробляються на пристрої в цьому режимі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آواز کی ٹرانسکرپشنز اور ٹائپ کردہ کیپچر متن اس موڈ کے ذریعے آلے پر پروسیس ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chép lời giọng nói và văn bản ghi nhanh đã nhập được xử lý trên thiết bị bằng chế độ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音转录和输入的采集文本将使用此模式在设备上处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音轉錄和輸入的擷取文字會使用此模式在裝置上處理。"
          }
        }
      }
    },
