    "Restore purchases or Family Sharing access from your Apple Account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة الوصول إلى الشراء أو مشاركة الأسرة من حساب Apple الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Apple অ্যাকাউন্ট থেকে কেনাকাটা বা পারিবারিক ভাগ করার অ্যাক্সেস পুনরুদ্ধার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Käufe oder Familienfreigabe-Zugriff aus Ihrem Apple-Konto wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore purchases or Family Sharing access from your Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer los compradores o el acceso a la Familia desde su Cuenta Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer les achats ou l’accès au Partage familial à partir de votre compte Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Apple खाते से खरीद या परिवार साझा करने का उपयोग बहाल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan akses pembelian atau Family Sharing dari Akun Apple Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinare gli acquisti o l'accesso alla Condivisione Familiare dal tuo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple アカウントから購入またはファミリー共有アクセスを復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정에서 구매 또는 가족 공유 액세스를 복원합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel aankopen of toegang tot Family Sharing vanuit uw Apple-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywracanie dostępu do zakupów lub udostępniania rodzinnego z konta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar compras ou acesso ao Compartilhamento Familiar da sua Conta Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите доступ к покупкам или семейному общению с учетной записи Apple."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Apple Account-ல் இருந்து வாங்குதல் அல்லது Family Sharing அணுகல் மீட்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกู้คืนการซื้อหรือการเข้าถึงการแชร์ครอบครัวจากบัญชี Apple ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Hesabınızdan satın alma veya Aile Paylaşımı erişimi kurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлення доступу до покупки або сімейного спільного доступу з облікового запису Apple."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے Apple اکاؤنٹ سے خریداری یا خاندان کا اشتراک کرنے کی رسائی کو دوبارہ کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục quyền truy cập mua hàng hoặc chia sẻ gia đình từ Tài khoản Apple của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Apple 帳戶恢復購買或家庭共享存取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Apple 帳戶恢復購買或家庭共享存取。"
          }
        }
      }
    },
