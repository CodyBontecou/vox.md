    "Recovered after an interrupted save. Choose a Preset to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة بعد إزالة متكرر. اختر إعداد متكررة لمواصلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সঞ্চয় বন্ধ পরে পুনরুদ্ধার করা. একটি অগ্রাধিকার নির্বাচন করুন যাতে আপনি চালিয়ে যেতে পারেন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhergestellt nach einer unterbrochenen Speicherung. Wählen Sie eine Voreinstellung, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovered after an interrupted save. Choose a Preset to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar después de una interrupción del guardar. Seleccione un Predefinición para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupéré après une interruption de sauvegarde. Sélectionnez un préréglage pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टूटने के बाद पुनर्प्राप्त किया गया. जारी करने के लिए एक पूर्वानुमान चुनें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah selesai, pilih Pre-Setting untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperato dopo un salvataggio interrotto. Selezionare una preimpostazione per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存中断後復元. プレセットを選択して継続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단된 저장 후 복구.지속하기 위해 미리 설정을 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hersteld na een onderbroken opslag. Kies een voorinstelling om verder te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odzyskane po przerwaniu zapisywania. Wybierz ustawienie wstępne, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar após uma interrupção de armazenamento. Selecione um Predefinição para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановлено после перерыва с сохранением. Выберите предварительное"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு முறை எழுதப்பட்ட பின்னர் மீண்டும் எழுதப்பட்டது.முடிவு செய்ய ஒரு முன்னேற்றம் தேர்வு."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขหลังจากหยุดการบันทึก เลือกการตั้งค่าก่อนเพื่อดําเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kaydetme kesildiğinde geri yüklendi. Devam etmek için bir Ön ayar seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлено після перерви в збереженні. Виберіть попереднє налаштування, щоб продовжити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار پھر سے دوبارہ شروع کریں.پھر آپ کو دوبارہ شروع کرنے کے لئے ایک پیشہ ورانہ انتخاب کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục sau khi lưu bị gián đoạn. Chọn một Pre-Set để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被中断保存后恢复. 选择预设以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被中斷保存後恢復. 選擇預設以繼續。"
          }
        }
      }
    },
