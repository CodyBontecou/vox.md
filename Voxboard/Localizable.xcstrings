    "Watch recordings stay saved locally and appear in your iPhone queue when your devices reconnect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل أحدث إخفاقات مشاهدة تخزينًا محليًا وتظهر في سلة iPhone عند اتصال الأجهزة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডগুলি স্থানীয়ভাবে সংরক্ষণ করা থাকে এবং আপনার iPhone যখন আপনার ডিভাইস পুনরায় সংযোগ করে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-Aufnahmen bleiben lokal gesichert und erscheinen in Ihrer iPhone-Warteschlange, sobald die Geräte wieder verbunden sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch recordings stay saved locally and appear in your iPhone queue when your devices reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver las grabaciones permanecen guardadas localmente y aparecen en su iPhone de la línea cuando sus dispositivos se reconectan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarder les enregistrements restent enregistrés localement et apparaissent dans votre iPhone La ligne de cote lorsque vos appareils se reconnectent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड्स को स्थानीय रूप से संग्रहीत किया जाता है और आपके iPhone जब आपके डिवाइस फिर से कनेक्ट हो जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat rekaman tetap disimpan secara lokal dan muncul di iPhone Tunggu sampai perangkat Anda terhubung kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza le registrazioni salvate localmente e appaiono nel tuo iPhone La coda quando i dispositivi si riconnetteranno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レコーディングを視聴して、ローカルに保存され、あなたの iPhone デバイスが再接続する際の列です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 로컬로 저장되어 있고 귀하의 iPhone 장치가 다시 연결될 때 꼬리를 니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk opnamen die lokaal worden opgeslagen en in uw iPhone wachtrij wanneer uw apparaten opnieuw verbinding maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglądanie nagrań pozostaje zapisane lokalnie i pojawia się w iPhone kolejki, gdy urządzenia się ponownie podłączą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assista as gravações permanecem salvas localmente e aparecem no seu iPhone Acompanhe quando os dispositivos se conectarem novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотреть записи сохраняются локально и появляются в вашем iPhone Затем выходите в очереди, когда ваши устройства восстанавливаются."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கண்காணிப்பு அட்டவணைகள் இடத்தில் சேமிக்கப்பட்டு உங்கள் iPhone உங்கள் கணினியில் மீண்டும் இணைப்பு"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูบันทึกที่เก็บไว้ในท้องถิ่นและปรากฏใน iPhone คู่หลังเมื่ออุปกรณ์ของคุณเชื่อมต่อใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtları yerel olarak kaydedilir ve iPhone Cihazınız yeniden bağlandığında sıralamaya devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянути записи зберігаються локально і з'являються у вашому iPhone Залишайте чергу, коли пристрої знову підключаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویڈیو دیکھیں، ریکارڈز مقامی طور پر محفوظ رہیں اور آپ کے iPhone جب آپ کے آلات دوبارہ متصل کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem các bản ghi được lưu trữ cục bộ và xuất hiện trong iPhone hàng đợi khi thiết bị của bạn kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观看录音记录保持本地保存并显示在您的 iPhone 等待你的设备重新连接时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀看錄音記錄保持本地保存並顯示在您的 iPhone 等待你的設備重新連接時。"
          }
        }
      }
    },
