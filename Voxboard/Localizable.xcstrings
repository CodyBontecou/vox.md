          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साझा कैप्चर भंडारण उपलब्ध नहीं है। पुनः स्थापित करें Vox.md या अपने App Group की योग्यता की जाँच करें।"
          }
        },
        "id": {
          "stringUnit": {
