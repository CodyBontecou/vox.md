    "The Capture Preset editor explains Keep Original, Clean Prose, Todo Checklist, Meeting Notes, and Custom Instruction modes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشرح المدون المفتوح Capture الوضع Keep Original، Clean Prose، Todo Checklist، Meeting Notes، و Custom Instruction."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার প্রাসঙ্গিক সম্পাদক Keep Original, Clean Prose, Todo Checklist, Meeting Notes এবং Custom Instruction মোড ব্যাখ্যা করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aufnahme-Preset-Editor erklärt die Modi Original behalten, Überarbeiteter Text, Todo-Checkliste, Besprechungsnotizen und Benutzerdefinierte Anweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Capture Preset editor explains Keep Original, Clean Prose, Todo Checklist, Meeting Notes, and Custom Instruction modes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor de Predefinición de Capture explica los modos Keep Original, Clean Prose, Todo Checklist, Notas de reunión y Instrucciones personalizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur de préréglage de capture explique les modes Keep Original, Clean Prose, Todo Checklist, Meeting Notes et Custom Instruction."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर पूर्वावलोकन संपादक Keep Original, Clean Prose, Todo Checklist, Meeting Notes और Custom Instruction मोड को समझाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor Capture Preset menjelaskan mode Keep Original, Clean Prose, Todo Checklist, Meeting Notes, dan Custom Instruction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'editor di impostazione predefinita di Capture spiega le modalità Keep Original, Clean Prose, Todo Checklist, Meeting Notes e Custom Instruction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Preset Editor では、Keep Original、Clean Prose、Todo Checklist、Meeting Notes、Custom Instruction モードを説明します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Preset Editor에서는 Keep Original, Clean Prose, Todo Checklist, Meeting Notes 및 Custom Instruction 모드를 설명합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Capture Preet-editor legt de modi Keep Original, Clean Prose, Todo Checklist, Meeting Notes en Custom Instruction uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytor ustawień wstępnych Capture wyjaśnia tryby Keep Original, Clean Prose, Todo Checklist, Meeting Notes i Custom Instruction."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor de Predefinição de Capture explica os modos Keep Original, Clean Prose, Todo Checklist, Notas de Reunião e Instruções personalizadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор Capture Preet объясняет режимы Keep Original, Clean Prose, Todo Checklist, Meeting Notes и Custom Instruction."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Preet Editor, Keep Original, Clean Prose, Todo Checklist, Meeting Notes மற்றும் Custom Instruction Mode ஆகியவை பற்றி விளக்கப்படுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวแก้ไขการตั้งค่าก่อนการจับภาพอธิบายโหมด Keep Original, Clean Prose, Todo Checklist, Meeting Notes และ Custom Instruction"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Preset editörü, Keep Original, Clean Prose, Todo Checklist, Meeting Notes ve Custom Instruction modlarını açıklıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор Capture Preset пояснює режими Keep Original, Clean Prose, Todo Checklist, Meeting Notes та Custom Instruction."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Preet ایڈیٹر Keep Original، Clean Prose، Todo Checklist، Meeting Notes اور Custom Instruction موڈ کی وضاحت کرتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình chỉnh sửa Capture Preset giải thích các chế độ Keep Original, Clean Prose, Todo Checklist, Meeting Notes và Custom Instruction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉预设编辑器解释了保持原始、清洁的散文、Todo 检查列表、会议笔记和自定义指令模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉預設編輯器解釋了保持原始、清潔的散文、Todo 檢查列表、會議筆記和自定義指令模式。"
          }
        }
      }
    },
    "The Capture Preset to use for recordings started by this control.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم إعداداً سابقاً لتسجيلات بدأت بها هذه التحكم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নিয়ন্ত্রণ দ্বারা শুরু করা রেকর্ডগুলির জন্য ব্যবহার করার জন্য ক্যাপচার প্রাসঙ্গিক সেটিং।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aufnahme-Preset für Aufnahmen, die über dieses Steuerelement gestartet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Capture Preset to use for recordings started by this control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Preset de captura para usar para grabaciones iniciadas por este control."
          }
        },
