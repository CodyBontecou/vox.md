    "Entry formatting can use {location} without writing additional metadata.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entry formatting can use {location} without writing additional metadata."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لتنسيق الإدخال استخدام {location} دون كتابة بيانات وصفية إضافية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এন্ট্রি ফরম্যাটিং অতিরিক্ত মেটাডেটা না লিখেই {location} ব্যবহার করতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eintragsformatierung kann {location} verwenden, ohne zusätzliche Metadaten zu schreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato de entrada puede usar {location} sin escribir metadatos adicionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le formatage de l’entrée peut utiliser {location} sans écrire de métadonnées supplémentaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एंट्री फ़ॉर्मैटिंग अतिरिक्त मेटाडेटा लिखे बिना {location} का उपयोग कर सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemformatan entri dapat menggunakan {location} tanpa menulis metadata tambahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La formattazione della voce può usare {location} senza scrivere metadati aggiuntivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エントリの書式設定では、追加のメタデータを書き込まずに {location} を使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 서식은 추가 메타데이터를 작성하지 않고 {location}을 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoeropmaak kan {location} gebruiken zonder extra metagegevens te schrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatowanie wpisu może używać {location} bez zapisywania dodatkowych metadanych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A formatação da entrada pode usar {location} sem gravar metadados adicionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форматирование записи может использовать {location} без добавления дополнительных метаданных."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கூடுதல் மெட்டாடேட்டாவை எழுதாமல் பதிவு வடிவமைப்பு {location} ஐப் பயன்படுத்தலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจัดรูปแบบรายการสามารถใช้ {location} ได้โดยไม่เขียนข้อมูลเมตาเพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdi biçimlendirmesi ek meta veri yazmadan {location} kullanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Форматування запису може використовувати {location} без додавання додаткових метаданих."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اندراج کی فارمیٹنگ اضافی میٹا ڈیٹا لکھے بغیر {location} استعمال کر سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định dạng mục nhập có thể dùng {location} mà không ghi thêm siêu dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目格式可以使用 {location}，而无需写入其他元数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目格式可以使用 {location}，而無需寫入其他後設資料。"
          }
        }
      }
