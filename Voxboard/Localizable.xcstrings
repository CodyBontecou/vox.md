    "Vox.md needs permission to save notes for the \"%@\" Route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Vox.md إلى إذن لحفظ الملاحظات للمسار \"%@\"."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" রুটের জন্য নোট সেভ করতে Vox.md-এর অনুমতি প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md benötigt die Berechtigung, Notizen für die Route „%@“ zu sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md needs permission to save notes for the \"%@\" Route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md necesita permiso para guardar notas de la ruta “%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md a besoin d’une autorisation pour enregistrer les notes du parcours « %@ »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md को \"%@\" रूट के लिए नोट्स सहेजने की अनुमति चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md memerlukan izin untuk menyimpan catatan untuk Rute \"%@\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ha bisogno dell’autorizzazione per salvare le note del percorso “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」ルートのメモを保存するには、Vox.mdにアクセス許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 루트의 메모를 저장하려면 Vox.md에 권한이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md heeft toestemming nodig om notities te bewaren voor de route \"%@\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md potrzebuje uprawnień do zapisywania notatek dla trasy „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vox.md precisa de permissão para salvar notas da rota “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md нужно разрешение на сохранение заметок для маршрута «%@»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" வழித்தடத்திற்கான குறிப்புகளைச் சேமிக்க Vox.md க்கு அனுமதி தேவை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ต้องได้รับสิทธิ์เพื่อบันทึกโน้ตสำหรับเส้นทาง \"%@\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md'nin \"%@\" Rotası için not kaydetme iznine ihtiyacı var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md потребує дозволу на збереження нотаток для маршруту «%@»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md کو \"%@\" روٹ کے لیے نوٹس محفوظ کرنے کی اجازت درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md cần quyền để lưu ghi chú cho lộ trình \"%@\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 需要权限才能为“%@”路线保存笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 需要權限才能為「%@」路線儲存筆記。"
          }
        }
      }
    },
