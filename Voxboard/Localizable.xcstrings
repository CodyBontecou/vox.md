    "A dictation segment could not be saved and will be retried": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ مقطع إملاء وستتم إعادة المحاولة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ডিক্টেশন অংশ সেভ করা যায়নি এবং আবার চেষ্টা করা হবে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Diktatsegment konnte nicht gesichert werden und wird erneut versucht"
