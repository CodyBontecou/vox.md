            "state": "translated",
            "value": "एक लक्ष्य निर्धारित करें %@ है iPhone, फिर रिट्री।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menentukan tujuan untuk %@ adalah iPhone, Kemudian kembali lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare una destinazione per %@ è iPhone, Poi il Retr."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的地を設定するための %@ オイ iPhone, 次にリトル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
