        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예시 참고 사항 · 어디서나 시작할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeldnotitie · De jouwe kan overal beginnen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przykładowa notatka · Twoja może zacząć się w dowolnym miejscu"
