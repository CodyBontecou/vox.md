    "Keeps typed Markdown, OCR, and voice text exactly as captured.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ على كتابة Markdown، OCR، والرسائل الصوتية على ما تم ضبطه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাইপ রাখুন Markdown, অক্লান্ত যেমনটা কপি করেছিলেন ঠিক তেমনিই লেখা ছিল।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält getipptes Markdown, OCR- und Sprachtext genau so, wie er erfasst wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps typed Markdown, OCR, and voice text exactly as captured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el tipo Markdown, OCR  y el texto de voz exactamente como capturado."
          }
        },
        "fr": {
