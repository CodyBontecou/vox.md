    "Vox.md no longer has permission to access this destination. Choose the folder again in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد لدى Vox.md إذن بالوصول إلى هذه الوجهة. اختر المجلد مرة أخرى في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই গন্তব্যে অ্যাক্সেসের অনুমতি Vox.md-এর আর নেই। সেটিংসে ফোল্ডারটি আবার বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md hat keine Berechtigung mehr, auf dieses Ziel zuzugreifen. Wählen Sie den Ordner in den Einstellungen erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md no longer has permission to access this destination. Choose the folder again in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ya no tiene permiso para acceder a este destino. Vuelve a elegir la carpeta en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md n’a plus l’autorisation d’accéder à cette destination. Choisissez à nouveau le dossier dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md को अब इस गंतव्य तक पहुँचने की अनुमति नहीं है। सेटिंग्ज़ में फ़ोल्डर फिर से चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md tidak lagi memiliki izin untuk mengakses tujuan ini. Pilih folder lagi di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md non ha più l’autorizzazione ad accedere a questa destinazione. Scegli di nuovo la cartella in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.mdにはこの保存先へのアクセス許可がなくなりました。「設定」でフォルダをもう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md에 더 이상 이 저장 위치에 접근할 권한이 없습니다. 설정에서 폴더를 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md heeft geen toestemming meer om deze bestemming te openen. Kies de map opnieuw in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md nie ma już uprawnień dostępu do tego miejsca docelowego. Wybierz folder ponownie w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vox.md não tem mais permissão para acessar este destino. Escolha a pasta novamente nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Vox.md больше нет разрешения на доступ к этому месту назначения. Выберите папку снова в Настройках."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md க்கு இனி இந்தச் சேருமிடத்தை அணுக அனுமதி இல்லை. அமைப்புகளில் கோப்புறையை மீண்டும் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ไม่มีสิทธิ์เข้าถึงปลายทางนี้แล้ว เลือกโฟลเดอร์อีกครั้งในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md'nin artık bu hedefe erişim izni yok. Ayarlar'da klasörü yeniden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md більше не має дозволу на доступ до цього місця призначення. Виберіть папку знову в Параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md کو اب اس منزل تک رسائی کی اجازت نہیں۔ سیٹنگز میں فولڈر دوبارہ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md không còn quyền truy cập đích này. Hãy chọn lại thư mục trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 已没有访问此目标位置的权限。请在“设置”中重新选择文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 已沒有取用此目標位置的權限。請在「設定」中重新選擇資料夾。"
          }
        }
      }
    },
