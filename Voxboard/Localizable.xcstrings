    "Playback is unavailable, but the audio can still be added.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إعادة تشغيل، ولكن يمكن حتى الآن إضافة الصوت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্লেবাকিং অসম্ভব, কিন্তু অডিও এখনও যোগ করা যেতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe ist nicht verfügbar, aber das Audio kann noch hinzugefügt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback is unavailable, but the audio can still be added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción no está disponible, pero el audio todavía se puede añadir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture n'est pas disponible, mais l'audio peut encore être ajouté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लेबैक उपलब्ध नहीं है, लेकिन ऑडियो अभी भी जोड़ा जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback tidak tersedia, tetapi audio masih dapat ditambahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione non è disponibile, ma l'audio può ancora essere aggiunto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生は不可ですが、オーディオはまだ追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생은 사용할 수 없지만 오디오는 여전히 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspelen is niet beschikbaar, maar het audio kan nog steeds worden toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie nie jest dostępne, ale można nadal dodawać dźwięk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução não está disponível, mas o áudio ainda pode ser adicionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проигрывание недоступно, но аудио все равно можно добавить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback கிடைக்கவில்லை, ஆனால் ஆடியோ இன்னும் சேர்க்க முடியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเล่นไม่สามารถใช้ได้ แต่ยังสามารถเพิ่มเสียงได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma kullanılamaz, ancak ses hala eklenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворення не доступне, але аудіо все ще можна додати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریلیپ دستیاب نہیں ہے، لیکن آڈیو اب بھی شامل کیا جا سکتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback không sẵn dùng, nhưng âm thanh vẫn có thể được thêm vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放无法使用,但音频仍然可以添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放無法使用,但音頻仍然可以添加。"
          }
        }
      }
    },
    "Playback is unavailable, but the audio remains safely attached.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إعادة التشغيل، ولكن الأندرويد لا يزال محفوظًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্লেবাকিং অসম্ভব, কিন্তু অডিও নিরাপদে সংযুক্ত থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe ist nicht verfügbar, aber das Audio bleibt sicher angeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback is unavailable, but the audio remains safely attached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción no está disponible, pero el audio permanece conectado de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture n'est pas disponible, mais l'audio reste relié en toute sécurité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लेबैक उपलब्ध नहीं है, लेकिन ऑडियो सुरक्षित रूप से जोड़ा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback tidak tersedia, tetapi audio tetap aman terpasang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione non è disponibile, ma l'audio rimane attaccato in modo sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生は不可ですが、オーディオは安全に付属しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생은 사용할 수 없지만 오디오는 안전하게 연결되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspelen is niet beschikbaar, maar de audio blijft veilig aangesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie nie jest dostępne, ale audio pozostaje bezpiecznie przymocowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução não está disponível, mas o áudio permanece seguramente anexado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизведение не доступно, но аудио остается безопасно прикрепленным."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback கிடைக்கவில்லை, ஆனால் audio பாதுகாப்பாக இணைக்கப்பட்டுள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเล่นไม่สามารถใช้ได้ แต่เสียงยังคงติดอยู่ได้อย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma kullanılamaz, ancak ses güvenli bir şekilde bağlı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворення не доступне, але аудіо залишається безпечно прикріпленим."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریلیز دستیاب نہیں ہے، لیکن آڈیو محفوظ طور پر شامل رہتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi không sẵn dùng, nhưng âm thanh vẫn được gắn an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放不可用,但音频仍然安全地附加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放不可用,但音頻仍然安全地附加。"
          }
        }
      }
    },
    "Precise Location is off, so this preset’s exact location could not be captured.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف تشغيل الموقع الدقيق، لذلك لا يمكن التقاط الموقع الدقيق لهذا الإعداد المسبق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুনির্দিষ্ট অবস্থান বন্ধ, তাই এই প্রিসেটের সঠিক অবস্থান ক্যাপচার করা যায়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Präziser Standort“ ist deaktiviert, daher konnte der genaue Standort dieser Voreinstellung nicht erfasst werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise Location is off, so this preset’s exact location could not be captured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación precisa está desactivada, por lo que no se pudo capturar la ubicación exacta de este ajuste preestablecido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement précis est désactivé, l'emplacement exact de ce préréglage n'a donc pas pu être capturé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सटीक स्थान बंद है, इसलिए इस प्रीसेट का सटीक स्थान कैप्चर नहीं किया जा सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi Tepat tidak aktif, jadi lokasi persis preset ini tidak dapat diambil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione precisa è disattivata, quindi non è stato possibile acquisire la posizione esatta di questa preimpostazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確な位置がオフになっているため、このプリセットの正確な位置をキャプチャできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 위치가 꺼져 있으므로 이 사전 설정의 정확한 위치를 캡처할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Precieze locatie is uitgeschakeld, dus de exacte locatie van deze voorinstelling kan niet worden vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokładna lokalizacja jest wyłączona, dlatego nie można było przechwycić dokładnej lokalizacji tego ustawienia wstępnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização precisa está desativada, portanto, a localização exata desta predefinição não pôde ser capturada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точное местоположение отключено, поэтому точное местоположение этого пресета невозможно зафиксировать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "துல்லியமான இருப்பிடம் முடக்கப்பட்டுள்ளது, எனவே இந்த முன்னமைவின் சரியான இடத்தைப் பிடிக்க முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งที่แน่นอนปิดอยู่ ดังนั้นจึงไม่สามารถบันทึกตำแหน่งที่แน่นอนของการตั้งค่าล่วงหน้านี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesin Konum kapalı olduğundan bu ön ayarın tam konumu yakalanamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точне місцезнаходження вимкнено, тому точне місцезнаходження цього стилю не вдалося зафіксувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درست مقام آف ہے، اس لیے اس پیش سیٹ کا درست مقام کیپچر نہیں کیا جا سکا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí chính xác bị tắt nên không thể ghi lại vị trí chính xác của giá trị đặt trước này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精确位置已关闭，因此无法捕获该预设的精确位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精確位置已關閉，因此無法擷取該預設的精確位置。"
          }
        }
      }
    },
