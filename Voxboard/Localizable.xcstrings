    "The Apple Speech live session ended unexpectedly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلسة Apple Speech في الأماكن المعيشية بشكل غير متوقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এ Apple Speech অপেক্ষাকৃতই শেষ হয় লাইভ সেশন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Sitzung von Apple Speech wurde unerwartet beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Speech live session ended unexpectedly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple Speech La sesión en vivo terminó inesperadamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Apple Speech La séance se termine inattendue."
          }
        },
        "hi": {
