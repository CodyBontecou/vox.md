    "Opens Quick Capture and adds screenshots with the selected Capture Preset.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Quick Capture ويضيف صور الشاشة مع اختيار Capture Preset."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত ক্যাপচার খুলুন এবং নির্বাচিত ক্যাপশন প্রাসঙ্গিক দিয়ে স্ক্রিনশট যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Quick Capture und fügt Screenshots mit dem ausgewählten Capture Preset hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Quick Capture and adds screenshots with the selected Capture Preset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la captura rápida y agrega capturas de pantalla con el preset de captura seleccionado."
