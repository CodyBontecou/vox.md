        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is veilig, maar de wachtrij kon niet worden bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie jest bezpieczne, ale jego kolejka nie mogła zostać zaktualizowana."
