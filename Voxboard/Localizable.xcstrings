    "Stats update as you capture while keeping captured content, filenames, and destinations out of analytics.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديث الإحصاءات أثناء استخدامه في حين الحفاظ على المحتوى المكتوب، واللامعة والمستهدفات من التحليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ট্যাটাস আপডেট করুন যখন আপনি ক্যাপচার করেন, তবে ক্যাপশন করা সামগ্রী, ফাইল নাম এবং ডিজাইনগুলি বিশ্লেষণ থেকে বাদ রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiken aktualisieren sich beim Erfassen, ohne erfasste Inhalte, Dateinamen oder Ziele in die Analyse einfließen zu lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats update as you capture while keeping captured content, filenames, and destinations out of analytics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estados se actualizan a medida que captura, manteniendo el contenido capturado, los nombres de archivos y los destinos fuera de la analítica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les statistiques sont mises à jour lorsque vous capturez tout en gardant le contenu capturé, les noms de fichiers et les destinations hors de l’analyse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टेट्स को कैप्चर के दौरान अपडेट किया जाता है, जबकि कैप्चर किए गए सामग्री, फ़ाइल नाम और गंतव्य विश्लेषण से बाहर रखे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik diperbarui saat Anda menangkap sambil menjaga konten, nama file, dan tujuan yang ditangkap dari analisis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stati vengono aggiornati mentre si cattura mantenendo il contenuto, i nomi dei file e le destinazioni catturati fuori dall'analisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データは、キャプチャをしながら、キャプチャしたコンテンツ、ファイル名、および目的地を分析から外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처하는 동안 업데이트된 내용, 파일 이름 및 목적지를 분석에서 유지합니다.Stats update as you capture while keeping captured content, file names, and destinations out of analytics."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistieken worden bijgewerkt terwijl u de opgenomen inhoud, bestandsnamen en bestemmingen uit de analyse houdt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statystyki są aktualizowane podczas przechwytywania, a przechowywane treści, nazwy plików i miejsca docelowe są wyłączone z analizy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os estatutos são atualizados à medida que você captura, mantendo o conteúdo capturado, nomes de arquivos e destinos fora da análise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика обновляется по мере захвата, при этом захваченный контент, имена файлов и цели не удаляются из аналитики."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats update as you capture while keeping captured content, file names, and destinations out of analytics."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถิติจะอัปเดตเมื่อคุณจับภาพในขณะที่เก็บเนื้อหาที่จับภาพชื่อไฟล์และเป้าหมายออกจากการวิเคราะห์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstatistikler, kaydedilen içeriği, dosya adlarını ve hedefleri analizden uzak tutarak kaydettikçe güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика оновлюється, коли ви захоплюєте, зберігаючи захоплений вміст, назви файлів та напрямки призначення з аналітики."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسٹٹٹس کو اپ ڈیٹ کرتے وقت آپ کی فہرستیں، جمع کردہ مواد، فائلوں اور مقاصد کو تجزیہ سے باہر رکھیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats cập nhật khi bạn chụp trong khi giữ nội dung, tên tệp và điểm đến bị thu thập khỏi phân tích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据更新时,您捕获,同时将捕获的内容、文件名和目的地从分析中保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數據更新時,您捕獲,同時將捕獲的內容、文件名和目的地從分析中保留。"
          }
        }
      }
    },
