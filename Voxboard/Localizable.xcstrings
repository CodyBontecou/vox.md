    "Recording stopped because another audio session needed the microphone. The audio is ready to add.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء تسجيل الإذاعة لأن جلسة إدخال صوتي أخرى بحاجة إلى ميكروفون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং বন্ধ হয়ে গেল কারণ একটি অডিও সেশন মাইক্রোফোন প্রয়োজন. অডিয়াম যোগ করার জন্য প্রস্তুত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde gestoppt, weil eine andere Audiositzung das Mikrofon benötigte. Das Audio kann direkt hinzugefügt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped because another audio session needed the microphone. The audio is ready to add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se detuvo porque otra sesión de audio necesitaba el micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement a été arrêté parce qu'une autre session audio avait besoin du microphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग बंद हो गई क्योंकि एक और ऑडियो सत्र को माइक्रोफोन की आवश्यकता थी. ऑडियो जोड़ने के लिए तैयार है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman berhenti karena sesi audio lain membutuhkan mikrofon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è stata interrotta perché un'altra sessione audio ha bisogno del microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は別のオーディオセッションにマイクが必要だったため停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 중단되었는데, 다른 오디오 세션이 마이크를 필요로 했기 때문에."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname is gestopt omdat een andere audiosessie de microfoon nodig heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie zostało przerwane, ponieważ inna sesja audio wymagała mikrofonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi interrompida porque outra sessão de áudio precisava do microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись прекращена, потому что для очередной аудиосессии необходим микрофон."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதாவது, ஒரு இடுகைக்குள் ஒரு மைக்ரோபன் தேவைப்படும் போது, மற்றொரு இடுகைக்கு இடுகைகள் சேர்க்கப்பட்டுள்ளன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกหยุดเพราะเซสชันเสียงอื่น ๆ ต้องใช้ไมโครโฟน เสียงพร้อมที่จะเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt, başka bir ses oturumuna mikrofonun ihtiyacı olduğu için durduruldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис зупинився, оскільки іншому аудіосесії потрібен мікрофон."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ روک دیا گیا کیونکہ ایک اور آڈیو سیشن کو مائیکروفون کی ضرورت تھی.آڈیو شامل کرنے کے لئے تیار ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm đã dừng lại vì một phiên âm thanh khác cần micro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制停止,因为另一个音频会话需要麦克风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製停止,因為另一個音頻會話需要麥克風。"
          }
        }
      }
    },
    "Recording stopped when Vox.md left the foreground. The audio is ready to add.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم وقف تسجيلك عندما خرج Vox.md من المرتبة الأولى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ড বন্ধ হয়ে গেল যখন Vox.md সামনে বেরিয়ে আসেন। অডিও যোগ করার জন্য প্রস্তুত।"
          }
        },
        "de": {
          "stringUnit": {
