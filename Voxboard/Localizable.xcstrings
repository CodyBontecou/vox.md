    "Stops and permanently deletes this recording without syncing it to your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف ويغلق دائمًا هذه المسح دون تثبيتها على iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ড বন্ধ করে এবং স্থায়ীভাবে আপনার সিনেমায় সিনেমা না করে মুছে ফেলুন iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt und löscht diese Aufnahme dauerhaft, ohne sie mit Ihrem iPhone zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops and permanently deletes this recording without syncing it to your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene y elimina permanentemente esta grabación sin sincronizarla con su iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête et supprime définitivement cette enregistrement sans le synchroniser avec votre iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोकता है और इस रिकॉर्डिंग को स्थायी रूप से हटा देता है, इसे अपने iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan dan secara permanen menghapus rekaman ini tanpa menyinkronkannya ke iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smette e cancella in modo permanente questa registrazione senza sincronizzarla con il iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止し、このレコーディングをあなたの iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음을 중지하고 영구적으로 삭제하여 귀하의 iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt en verwijdert deze opname permanent zonder deze te synchroniseren met uw iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje i trwale usuwa ten nagrywanie bez synchronizacji z iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar e excluir permanentemente esta gravação sem sincronizá-la com o seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановит и удалит эту запись, не синхронизируя ее с вашим iPhone."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவை நிறுத்துங்கள் மற்றும் உங்கள் கணினியில் சேமிக்கப்படாததால் இந்த பதிவை நீட்டிப்பீர்கள். iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดและลบการบันทึกนี้อย่างถาวรโดยไม่ต้องซิงค์กับ iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaydı, kaydınızı kendi iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "зупиняє та назавжди видаляє цей запис, не синхронізуючи його з iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ریکارڈ کو روکتا ہے اور اس کے ساتھ سائن اپ کرنے کے بغیر اس ریکارڈ کو ہمیشہ حذف کرتا ہے. iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngừng và xóa vĩnh viễn bản ghi này mà không đồng bộ nó với iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止并永久删除此录音,而不将其同步到您的 iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止並永久刪除此錄音,而不將其同步到您的 iPhone."
          }
        }
      }
    },
    "Stops and safely saves this recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة وتخزين هذه الصورة بأمان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডটি নিরাপদে সংরক্ষণ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt und speichert diese Aufnahme sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops and safely saves this recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene y guarda de forma segura esta grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez et sauvegardez en toute sécurité cet enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्ड को सुरक्षित रूप से बंद करें और बचाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan dan menyimpan rekaman ini dengan aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smette e salva in modo sicuro questo record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に保存して、このレコードを停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음을 안전하게 저장하고 중지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop en beveilig deze opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje i bezpiecznie zapisuje ten nagrywarek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar e salvar com segurança esta gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановите и безопасно сохранить эту запись."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவை பாதுகாப்பாக பதிவிறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดและบันทึกการบันทึกนี้ได้อย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıtları durdurun ve güvenle kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захисти та безпечно зберегти цей запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ریکارڈ کو محفوظ اور محفوظ رکھیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngừng và lưu lại an toàn bản ghi này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止并安全地保存此录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止並安全地保存此錄音。"
          }
        }
      }
    },
    "Stops the active Vox.md recording segment.": {
