          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica questo widget oppure apri Vox.md, poi Impostazioni > Percorsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィジェットを編集するか、Vox.md を開いて 設定 > ルート に進んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위젯을 편집하거나 Vox.md를 열고 설정 > 경로로 이동하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig deze widget of open Vox.md en ga naar Instellingen > Routes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj ten widżet albo otwórz Vox.md, a potem Ustawienia > Trasy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite este widget ou abra o Vox.md e vá em Ajustes > Rotas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените этот виджет или откройте Vox.md, затем Настройки > Маршруты."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த விட்ஜெட்டைத் திருத்தவும், அல்லது Vox.md-ஐத் திறந்து அமைப்புகள் > வழிகள் செல்லவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขวิดเจ็ตนี้ หรือเปิด Vox.md แล้วไปที่ การตั้งค่า > เส้นทาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu widget’ı düzenleyin ya da Vox.md’yi açıp Ayarlar > Rotalar’a gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
