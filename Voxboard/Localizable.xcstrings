    "Keeps this capture waiting on this device until vault access is back.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقي هذا الالتقاط في الانتظار على هذا الجهاز حتى يعود الوصول إلى الخزنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্ট অ্যাক্সেস ফিরে না আসা পর্যন্ত এই ক্যাপচারটি এই ডিভাইসে অপেক্ষমাণ রাখে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält diese Erfassung auf diesem Gerät, bis der Zugriff auf den Tresor wieder möglich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this capture waiting on this device until vault access is back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene esta captura en espera en este dispositivo hasta que vuelva el acceso a la bóveda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde cette capture en attente sur cet appareil jusqu’au retour de l’accès au coffre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्ट एक्सेस वापस आने तक इस कैप्चर को इस डिवाइस पर प्रतीक्षा में रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menahan tangkapan ini di perangkat ini sampai akses vault kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene questa acquisizione in attesa su questo dispositivo finché l’accesso al vault non torna disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫へのアクセスが回復するまで、このキャプチャをこのデバイスで待機させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼트 접근이 복구될 때까지 이 캡처를 이 기기에서 대기시킵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt deze vastlegging op dit apparaat totdat er weer toegang tot de kluis is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To przechwycenie zaczeka na tym urządzeniu, aż dostęp do sejfu zostanie przywrócony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém esta captura aguardando neste dispositivo até que o acesso ao cofre volte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот захват будет ожидать на устройстве, пока доступ к хранилищу не восстановится."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "களஞ்சிய அணுகல் மீண்டும் கிடைக்கும் வரை இந்தப் பிடிப்பை இந்தச் சாதனத்தில் காத்திருக்க வைக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บการจับภาพนี้ไว้รอบนอุปกรณ์นี้จนกว่าจะเข้าถึงวอลต์ได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yakalamayı kasa erişimi geri gelene kadar bu aygıtta bekletir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це захоплення чекатиме на пристрої, доки доступ до сховища не відновиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ تک رسائی بحال ہونے تک اس کیپچر کو اس آلے پر انتظار میں رکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ bản ghi nhanh này chờ trên thiết bị này cho đến khi truy cập lại được kho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在恢复对仓库的访问之前，此采集将在此设备上等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在恢復儲存庫取用權限之前，此擷取會在此裝置上等待。"
          }
        }
      }
    },
