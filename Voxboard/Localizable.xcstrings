          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie ou pare a gravação com a rota selecionada no momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать или остановить запись с текущим выбранным маршрутом."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்போது தேர்ந்தெடுக்கப்பட்ட வழித்தடத்துடன் பதிவைத் தொடங்கு அல்லது நிறுத்து."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มหรือหยุดบันทึกด้วยเส้นทางที่เลือกอยู่ในขณะนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O anda hangi Rota seçiliyse onunla kaydı başlatın veya durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
