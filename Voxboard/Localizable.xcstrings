          "stringUnit": {
            "state": "translated",
            "value": "রুটগুলো স্ক্রিনে একটি রুট দীর্ঘক্ষণ চেপে ধরুন এবং ক্যাপচার বারে পিন করুন বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie auf dem Bildschirm „Routen“ den Finger auf eine Route und wählen Sie „An Erfassungsleiste anheften“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press a route on the Routes screen and choose Pin to Capture Bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una ruta en la pantalla Rutas y elige “Fijar en la barra de captura”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur un parcours dans l’écran Parcours, puis choisissez « Épingler à la barre de capture »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूट्स स्क्रीन पर किसी रूट को देर तक दबाएँ और कैप्चर बार पर पिन करें चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama rute di layar Rute, lalu pilih Sematkan ke Bilah Tangkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un percorso nella schermata Percorsi e scegli “Fissa alla barra di acquisizione”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ルート」画面でルートを長押しし、「キャプチャバーにピン留め」を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트 화면에서 루트를 길게 누른 다음 캡처 막대에 고정을 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd op het scherm ‘Routes’ een route ingedrukt en kies ‘Zet vast in vastlegbalk’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj trasę na ekranie Trasy i wybierz Przypnij do paska przechwytywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionada uma rota na tela Rotas e escolha “Fixar na Barra de Captura”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте маршрут на экране «Маршруты» и выберите «Закрепить на панели захвата»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழித்தடங்கள் திரையில் ஒரு வழித்தடத்தை நீண்ட நேரம் அழுத்தி, பிடிப்புப் பட்டியில் பொருத்து என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเส้นทางค้างไว้บนหน้าจอเส้นทาง แล้วเลือกปักหมุดไว้ที่แถบจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotalar ekranında bir rotaya uzun basın ve Yakalama Çubuğu'na Sabitle'yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте маршрут на екрані «Маршрути» та виберіть «Закріпити на панелі захоплення»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روٹس اسکرین پر کسی روٹ کو دیر تک دبائیں اور کیپچر بار پر پن کریں منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ một lộ trình trên màn hình Lộ trình và chọn Ghim vào Thanh ghi nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“路线”屏幕上长按路线，然后选取“置顶到采集栏”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「路線」畫面上長按路線，然後選擇「釘選到擷取列」。"
          }
        }
      }
    },
    "Long-press a route to pin it to widgets, Control Center, the keyboard and Apple Watch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على مسار لتثبيته في الأدوات ومركز التحكم ولوحة المفاتيح وApple Watch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উইজেট, কন্ট্রোল সেন্টার, কীবোর্ড ও Apple Watch-এ পিন করতে একটি রুট টাচ করে ধরে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie lange auf eine Route, um sie an Widgets, das Kontrollzentrum, die Tastatur und die Apple Watch anzuheften."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press a route to pin it to widgets, Control Center, the keyboard and Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionada una ruta para fijarla en los widgets, el centro de control, el teclado y el Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez longuement un parcours pour l’épingler aux widgets, au centre de contrôle, au clavier et à l’Apple Watch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी रूट को विजेट, कंट्रोल सेंटर, कीबोर्ड और Apple Watch पर पिन करने के लिए उसे देर तक दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama rute untuk menyematkannya ke widget, Pusat Kontrol, papan ketik, dan Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un percorso per fissarlo a widget, Centro di Controllo, tastiera e Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルートを長押しすると、ウィジェット、コントロールセンター、キーボード、Apple Watchにピン留めできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트를 길게 누르면 위젯, 제어 센터, 키보드 및 Apple Watch에 고정할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een route ingedrukt om hem vast te zetten in widgets, het bedieningspaneel, het toetsenbord en op de Apple Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj trasę, aby przypiąć ją do widżetów, centrum sterowania, klawiatury i Apple Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure uma rota para fixá-la nos widgets, na Central de Controle, no teclado e no Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте маршрут, чтобы закрепить его в виджетах, Пункте управления, на клавиатуре и Apple Watch."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விட்ஜெட்கள், கட்டுப்பாட்டு மையம், விசைப்பலகை மற்றும் Apple Watch இல் பொருத்த ஒரு வழித்தடத்தை நீண்ட நேரம் அழுத்தவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดเส้นทางค้างไว้เพื่อปักหมุดไว้ที่วิดเจ็ต ศูนย์ควบคุม แป้นพิมพ์ และ Apple Watch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir rotayı widget'lara, Denetim Merkezi'ne, klavyeye ve Apple Watch'a sabitlemek için uzun basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте маршрут, щоб закріпити його у віджетах, Центрі керування, на клавіатурі та Apple Watch."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی روٹ کو ویجیٹس، کنٹرول سینٹر، کی بورڈ اور Apple Watch پر پن کرنے کے لیے دبا کر رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ một lộ trình để ghim vào tiện ích, Trung tâm điều khiển, bàn phím và Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按路线可将其固定到小组件、控制中心、键盘和 Apple Watch。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按路線可將其釘選到小工具、控制中心、鍵盤和 Apple Watch。"
          }
        }
      }
    },
