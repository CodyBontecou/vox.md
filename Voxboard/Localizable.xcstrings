            "state": "translated",
            "value": "Доступ к Apple Family Sharing неограничен."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வாழ்நாள் Unlimited Access Apple Family Sharing ஆதரவு."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
