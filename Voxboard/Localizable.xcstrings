          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обробляти, поки Vox.md відкрито й запис не триває."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب Vox.md کھلا ہو اور کوئی ریکارڈنگ فعال نہ ہو تب پروسیس کریں۔"
          }
        },
        "vi": {
