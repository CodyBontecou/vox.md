          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è sicura, ma la coda non è stata aggiornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は安全ですが、列が更新できませんでした。"
