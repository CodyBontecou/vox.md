    "The original endpoint and content stay unchanged. Opening or refreshing this list never sends.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى نقطة النهاية الأصلية والمحتوى دون تغيير. فتح هذه القائمة أو تحديثها لا يرسل أي شيء أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল এন্ডপয়েন্ট ও কনটেন্ট অপরিবর্তিত থাকে। এই তালিকা খোলা বা রিফ্রেশ করলে কখনও কিছু পাঠানো হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ursprüngliche Endpunkt und Inhalt bleiben unverändert. Beim Öffnen oder Aktualisieren dieser Liste wird nie etwas gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original endpoint and content stay unchanged. Opening or refreshing this list never sends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El punto de conexión y el contenido originales no cambian. Abrir o actualizar esta lista nunca envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point de terminaison et le contenu d’origine restent inchangés. Ouvrir ou actualiser cette liste n’envoie jamais rien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल एंडपॉइंट और सामग्री नहीं बदलते। यह सूची खोलने या रीफ़्रेश करने से कभी कुछ नहीं भेजा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint dan konten asli tidak berubah. Membuka atau menyegarkan daftar ini tidak pernah mengirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’endpoint e il contenuto originali restano invariati. Aprire o aggiornare questo elenco non invia mai nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のエンドポイントと内容は変更されません。このリストを開いたり更新したりしても送信は行われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 엔드포인트와 콘텐츠는 변경되지 않습니다. 이 목록을 열거나 새로 고쳐도 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het oorspronkelijke eindpunt en de inhoud blijven ongewijzigd. Openen of vernieuwen van deze lijst verstuurt nooit iets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginalny punkt końcowy i treść pozostają bez zmian. Otwarcie lub odświeżenie tej listy nigdy niczego nie wysyła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endpoint e o conteúdo originais permanecem inalterados. Abrir ou atualizar esta lista nunca envia nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный адрес и содержимое не меняются. Открытие или обновление этого списка ничего не отправляет."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசல் முனைப்புள்ளியும் உள்ளடக்கமும் மாறாமல் இருக்கும். இந்தப் பட்டியலைத் திறப்பதோ புதுப்பிப்பதோ ஒருபோதும் அனுப்பாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลายทางและเนื้อหาเดิมจะไม่เปลี่ยนแปลง การเปิดหรือรีเฟรชรายการนี้จะไม่ส่งข้อมูลใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özgün uç nokta ve içerik değişmeden kalır. Bu listeyi açmak veya yenilemek asla gönderim yapmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Початкова адреса та вміст не змінюються. Відкриття чи оновлення цього списку нічого не надсилає."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اصل اینڈ پوائنٹ اور مواد تبدیل نہیں ہوتے۔ یہ فہرست کھولنے یا ریفریش کرنے سے کبھی کچھ نہیں بھیجا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm cuối và nội dung gốc giữ nguyên. Mở hoặc làm mới danh sách này không bao giờ gửi đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始端点和内容保持不变。打开或刷新此列表绝不会发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始端點和內容保持不變。打開或重新整理此列表絕不會傳送。"
          }
        }
      }
    },
    "The recording could not be queued. %@ The original audio was preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إضافة التسجيل إلى قائمة الانتظار. %@ تم الاحتفاظ بالصوت الأصلي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিংটি সারিতে যোগ করা যায়নি। %@ মূল অডিও সংরক্ষিত আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht in die Warteschlange gestellt werden. %@ Das Originalaudio wurde beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording could not be queued. %@ The original audio was preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo poner en cola la grabación. %@ Se conservó el audio original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre l’enregistrement en file d’attente. %@ L’audio d’origine a été conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग कतार में नहीं डाली जा सकी। %@ मूल ऑडियो सुरक्षित रखा गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tidak dapat dimasukkan ke antrean. %@ Audio asli tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile mettere in coda la registrazione. %@ L’audio originale è stato conservato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音をキューに追加できませんでした。%@ 元のオーディオは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 대기열에 추가할 수 없습니다. %@ 원본 오디오는 보존되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname kon niet in de wachtrij worden gezet. %@ De originele audio is behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dodać nagrania do kolejki. %@ Oryginalne audio zostało zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível colocar a gravação na fila. %@ O áudio original foi preservado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось поставить запись в очередь. %@ Исходное аудио сохранено."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவை வரிசையில் சேர்க்க முடியவில்லை. %@ அசல் ஒலி பாதுகாக்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเพิ่มการบันทึกลงในคิวได้ %@ เสียงต้นฉบับได้รับการเก็บรักษาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt kuyruğa alınamadı. %@ Özgün ses korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося поставити запис у чергу. %@ Оригінальне аудіо збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ قطار میں نہیں ڈالی جا سکی۔ %@ اصل آڈیو محفوظ رکھی گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đưa bản ghi âm vào hàng đợi. %@ Âm thanh gốc vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将录音加入队列。%@ 原始音频已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將錄音加入佇列。%@ 原始音訊已保留。"
          }
        }
      }
    },
    "The recording handoff could not be preserved. The original audio was preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاحتفاظ بتسليم التسجيل. تم الاحتفاظ بالصوت الأصلي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং হস্তান্তর সংরক্ষণ করা যায়নি। মূল অডিও সংরক্ষিত আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahmeübergabe konnte nicht beibehalten werden. Das Originalaudio wurde beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording handoff could not be preserved. The original audio was preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conservar la transferencia de la grabación. Se conservó el audio original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert de l’enregistrement n’a pas pu être conservé. L’audio d’origine a été conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग हैंडऑफ़ सुरक्षित नहीं रखा जा सका। मूल ऑडियो सुरक्षित रखा गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Serah terima rekaman tidak dapat dipertahankan. Audio asli tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile conservare il passaggio della registrazione. L’audio originale è stato conservato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音の引き継ぎを保持できませんでした。元のオーディオは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 인계를 보존할 수 없습니다. 원본 오디오는 보존되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De overdracht van de opname kon niet worden behouden. De originele audio is behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zachować przekazania nagrania. Oryginalne audio zostało zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preservar a transferência da gravação. O áudio original foi preservado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить передачу записи. Исходное аудио сохранено."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு ஒப்படைப்பைப் பாதுகாக்க முடியவில்லை. அசல் ஒலி பாதுகாக்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเก็บรักษาการส่งต่อการบันทึกได้ เสียงต้นฉบับได้รับการเก็บรักษาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt aktarımı korunamadı. Özgün ses korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти передавання запису. Оригінальне аудіо збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ کی منتقلی محفوظ نہیں ہو سکی۔ اصل آڈیو محفوظ رکھی گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể giữ lại phần chuyển giao bản ghi âm. Âm thanh gốc vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保留录音交接。原始音频已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法保留錄音交接。原始音訊已保留。"
          }
        }
      }
    },
    "The recording was too quiet. Move closer to the microphone, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان التسجيل منخفض الصوت جدًا. اقترب من الميكروفون، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং খুব নিচু স্বরে হয়েছে। মাইক্রোফোনের কাছে এসে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme war zu leise. Gehen Sie näher an das Mikrofon und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording was too quiet. Move closer to the microphone, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación tenía muy poco volumen. Acércate al micrófono y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement était trop faible. Rapprochez-vous du micro, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग बहुत धीमी थी। माइक्रोफ़ोन के पास जाएँ, फिर से प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman terlalu pelan. Dekatkan diri ke mikrofon, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione era troppo bassa. Avvicinati al microfono, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音の音量が小さすぎました。マイクに近づいてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 소리가 너무 작았습니다. 마이크에 더 가까이 다가간 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname was te zacht. Ga dichter bij de microfoon en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie było zbyt ciche. Przybliż się do mikrofonu i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação ficou baixa demais. Aproxime-se do microfone e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись слишком тихая. Поднесите микрофон ближе и повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு மிகவும் அமைதியாக இருந்தது. மைக்ரோஃபோனுக்கு அருகில் சென்று மீண்டும் முயற்சிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกเบาเกินไป ขยับเข้าใกล้ไมโครโฟนแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt çok sessizdi. Mikrofona yaklaşın, ardından yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис надто тихий. Підійдіть ближче до мікрофона й спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ بہت دھیمی تھی۔ مائیکروفون کے قریب جائیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm quá nhỏ. Hãy lại gần micrô hơn, sau đó thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音音量太小。请靠近麦克风，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音音量太小。請靠近麥克風，然後再試一次。"
          }
        }
      }
    },
    "The route deletion could not be confirmed. Its Capture Bar pin was kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد حذف المسار. تم الاحتفاظ بتثبيته في شريط الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুট ডিলিট নিশ্চিত করা যায়নি। এর ক্যাপচার বার পিন রাখা হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen der Route konnte nicht bestätigt werden. Ihre Anheftung in der Erfassungsleiste wurde beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route deletion could not be confirmed. Its Capture Bar pin was kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la eliminación de la ruta. Se mantuvo su fijación en la barra de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression du parcours n’a pas pu être confirmée. Son épingle dans la barre de capture a été conservée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूट डिलीट होने की पुष्टि नहीं हो सकी। इसका कैप्चर बार पिन बना रहा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penghapusan rute tidak dapat dikonfirmasi. Sematan Bilah Tangkapannya dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare l’eliminazione del percorso. Il suo fissaggio nella barra di acquisizione è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルートの削除を確認できませんでした。キャプチャバーのピン留めはそのまま残されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트 삭제를 확인할 수 없습니다. 캡처 막대 고정은 유지되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verwijderen van de route kon niet worden bevestigd. De vastgezette plek in de vastlegbalk is behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić usunięcia trasy. Jej przypięcie na pasku przechwytywania zostało zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a exclusão da rota. A fixação na Barra de Captura foi mantida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить удаление маршрута. Его закрепление на панели захвата сохранено."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழித்தட நீக்கத்தை உறுதிப்படுத்த முடியவில்லை. அதன் பிடிப்புப் பட்டிப் பொருத்தம் வைக்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถยืนยันการลบเส้นทางได้ หมุดบนแถบจับภาพยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotanın silinmesi onaylanamadı. Yakalama Çubuğu sabitlemesi korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підтвердити видалення маршруту. Його закріплення на панелі захоплення збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روٹ کے حذف ہونے کی تصدیق نہیں ہو سکی۔ اس کا کیپچر بار پن برقرار رکھا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác nhận việc xóa lộ trình. Ghim trên Thanh ghi nhanh vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认路线删除。其采集栏固定项已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認路線刪除。其擷取列釘選項目已保留。"
          }
        }
      }
    },
    "The saved Capture Bar order could not be read. Pin a route to replace it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة ترتيب شريط الالتقاط المحفوظ. ثبّت مسارًا لاستبداله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেভ করা ক্যাপচার বারের ক্রম পড়া যায়নি। এটি প্রতিস্থাপন করতে একটি রুট পিন করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesicherte Reihenfolge der Erfassungsleiste konnte nicht gelesen werden. Heften Sie eine Route an, um sie zu ersetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved Capture Bar order could not be read. Pin a route to replace it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el orden guardado de la barra de captura. Fija una ruta para reemplazarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’ordre enregistré de la barre de capture. Épinglez un parcours pour le remplacer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया कैप्चर बार क्रम पढ़ा नहीं जा सका। इसे बदलने के लिए कोई रूट पिन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urutan Bilah Tangkapan yang tersimpan tidak dapat dibaca. Sematkan rute untuk menggantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’ordine salvato della barra di acquisizione. Fissa un percorso per sostituirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたキャプチャバーの順序を読み取れませんでした。ルートをピン留めすると置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 캡처 막대 순서를 읽을 수 없습니다. 루트를 고정하면 대체됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewaarde volgorde van de vastlegbalk kon niet worden gelezen. Zet een route vast om deze te vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać zapisanej kolejności paska przechwytywania. Przypnij trasę, aby ją zastąpić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a ordem salva da Barra de Captura. Fixe uma rota para substituí-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать сохраненный порядок панели захвата. Закрепите маршрут, чтобы заменить его."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமித்த பிடிப்புப் பட்டி வரிசையைப் படிக்க முடியவில்லை. அதை மாற்ற ஒரு வழித்தடத்தைப் பொருத்தவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอ่านลำดับแถบจับภาพที่บันทึกไว้ได้ ปักหมุดเส้นทางเพื่อแทนที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı Yakalama Çubuğu sırası okunamadı. Değiştirmek için bir rota sabitleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати збережений порядок панелі захоплення. Закріпіть маршрут, щоб замінити його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر بار کی محفوظ ترتیب پڑھی نہیں جا سکی۔ اسے بدلنے کے لیے کوئی روٹ پن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc thứ tự đã lưu của Thanh ghi nhanh. Ghim một lộ trình để thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已保存的采集栏顺序。固定一条路线即可替换它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取已儲存的擷取列順序。釘選一條路線即可取代它。"
          }
        }
      }
    },
