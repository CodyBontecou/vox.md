    "Watch recordings use this route's normal on-device transcription and Capture destination workflow.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم تسجيلات Watch النسخ الصوتي المعتاد على الجهاز لهذا المسار وسير عمل وجهة الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch রেকর্ডিং এই রুটের স্বাভাবিক ডিভাইসে ট্রান্সক্রিপশন ও ক্যাপচার গন্তব্য ওয়ার্কফ্লো ব্যবহার করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-Aufnahmen verwenden die normale Transkription auf dem Gerät und den Zielablauf für Erfassungen dieser Route."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch recordings use this route's normal on-device transcription and Capture destination workflow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones del Watch usan la transcripción en el dispositivo y el flujo de destino de capturas habituales de esta ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements de la Watch utilisent la transcription sur l’appareil habituelle de ce parcours et son processus de destination de capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch रिकॉर्डिंग इस रूट के सामान्य ऑन-डिवाइस ट्रांसक्रिप्शन और कैप्चर गंतव्य वर्कफ़्लो का उपयोग करती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman Watch menggunakan transkripsi di perangkat dan alur kerja tujuan Tangkapan normal milik rute ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le registrazioni di Watch usano la normale trascrizione sul dispositivo di questo percorso e il suo flusso di destinazione delle acquisizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchの録音には、このルートの通常のデバイス上の文字起こしとキャプチャの保存先ワークフローが使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 녹음은 이 루트의 일반적인 기기 내 전사 및 캡처 저장 위치 워크플로를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-opnamen gebruiken de normale transcriptie op het apparaat en de bestemmingsworkflow voor vastleggingen van deze route."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania z zegarka korzystają ze zwykłej transkrypcji na urządzeniu i miejsca docelowego tej trasy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações do Watch usam a transcrição no dispositivo e o fluxo de destino de captura normais desta rota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи с часов используют обычную транскрипцию на устройстве и процесс доставки захвата этого маршрута."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch பதிவுகள் இந்த வழித்தடத்தின் வழக்கமான சாதனத்திலேயே நடைபெறும் உரைமாற்றம் மற்றும் பிடிப்புச் சேருமிடப் பணிப்பாய்வைப் பயன்படுத்தும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจาก Watch จะใช้การถอดเสียงบนอุปกรณ์และเวิร์กโฟลว์ปลายทางการจับภาพตามปกติของเส้นทางนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch kayıtları, bu rotanın normal aygıt üzerinde transkripsiyon ve Yakalama hedefi iş akışını kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи з годинника використовують звичайну транскрипцію на пристрої та процес доставки захоплення цього маршруту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch کی ریکارڈنگز اس روٹ کی معمول کی آلے پر ٹرانسکرپشن اور کیپچر منزل کا ورک فلو استعمال کرتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm trên Watch dùng quy trình chép lời trên thiết bị và đích ghi nhanh thông thường của lộ trình này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表录音会使用此路线常规的设备端转录和采集目标位置流程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手錶錄音會使用此路線一般的裝置端轉錄和擷取目標位置流程。"
          }
        }
      }
    },
