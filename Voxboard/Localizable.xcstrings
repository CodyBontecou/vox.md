    "Keep capturing. Everything is held on this iPhone and delivers as soon as access is back.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع الالتقاط. يُحتفظ بكل شيء على هذا iPhone ويُسلَّم فور عودة الوصول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার চালিয়ে যান। সবকিছু এই iPhone-এ রাখা হয় এবং অ্যাক্সেস ফিরলেই ডেলিভার হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse einfach weiter. Alles bleibt auf diesem iPhone und wird zugestellt, sobald der Zugriff wieder da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep capturing. Everything is held on this iPhone and delivers as soon as access is back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue capturando. Todo se guarda en este iPhone y se entrega en cuanto vuelva el acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à capturer. Tout est conservé sur cet iPhone et livré dès que l’accès revient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर करते रहें। सब कुछ इसी iPhone पर रखा जाता है और ऐक्सेस लौटते ही डिलीवर होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus tangkap. Semuanya disimpan di iPhone ini dan dikirim begitu akses kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua ad acquisire. Tutto resta su questo iPhone e viene consegnato appena l’accesso torna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャを続けてください。すべてこの iPhone に保持され、アクセスが戻りしだい配信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 캡처하세요. 모든 내용은 이 iPhone에 보관되며 접근이 복구되는 즉시 전달됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf vastleggen. Alles blijft op deze iPhone en wordt afgeleverd zodra er weer toegang is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechwytuj dalej. Wszystko jest przechowywane na tym iPhone i zostanie dostarczone, gdy dostęp wróci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue capturando. Tudo fica neste iPhone e é entregue assim que o acesso voltar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте записывать. Всё хранится на этом iPhone и будет доставлено, как только доступ восстановится."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்ந்து பிடியுங்கள். அனைத்தும் இந்த iPhone-இல் வைக்கப்பட்டு, அணுகல் திரும்பியதும் டெலிவர் ஆகும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกต่อได้เลย ทุกอย่างถูกเก็บไว้บน iPhone เครื่องนี้และจะส่งทันทีที่เข้าถึงได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalamaya devam edin. Her şey bu iPhone’da tutulur ve erişim geri gelir gelmez teslim edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуйте записувати. Усе зберігається на цьому iPhone і буде доставлено, щойно доступ відновиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر کرتے رہیں۔ سب کچھ اسی iPhone پر محفوظ رہتا ہے اور رسائی واپس آتے ہی ڈیلیور ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cứ tiếp tục ghi. Mọi thứ được giữ trên iPhone này và sẽ gửi ngay khi có lại quyền truy cập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续捕捉。所有内容都会保留在此 iPhone 上，一旦恢复访问就会送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續擷取。所有內容都會保留在此 iPhone 上，一旦恢復取用就會送達。"
          }
        }
      }
    },
    "Keep transcript only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
