        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "استعمال کریں {period} روزانہ منتخب ہونے والے ہفتہ وار ، مہینے کے چارج، سالانہ بیکٹ ٹوکری بھی شامل ہیں {date}, {year}, {YR} (۲) سال کے لئے {month}, {day}, اور {week}."
          }
