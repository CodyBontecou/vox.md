        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용할 때만 권한을 요청합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toestemming wordt pas gevraagd als je die toestaat"
