    "Enable a Capture Preset in Vox.md on iPhone before recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إحذري إعداد إعداد متقدم لإنشاء Vox.md على iPhone قبل تسجيل."
          }
        },
        "bn": {
          "stringUnit": {
