    "Saved audio uses a subfolder inside the unified Markdown destination, and that route survives deferred retries.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم المفاتيح الضوئية المختصة في الوجهة المشتركة Markdown ، وهذا الطريق يستمر في إعادة التجديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত অডিও ইউনিফাইডের ভেতরে একটি সাবম্যাপার ব্যবহার করে Markdown গন্তব্য, আর সেই রাস্তাটাও বেঁচে আছে অবসরপ্রাপ্তদের।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesichertes Audio nutzt einen Unterordner im zusammengeführten Markdown-Ziel, und diese Route übersteht aufgeschobene Wiederholungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved audio uses a subfolder inside the unified Markdown destination, and that route survives deferred retries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio guardado utiliza una subcarpeta dentro del Markdown El destino, Y ese camino sobrevive a retiros pospuestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde audio utilise un sous-dossier à l'intérieur du Markdown La destination, Cette route survit aux retraites reportées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saveed Audio एक यूनिवरेटेड फ़ोल्डर के अंदर एक उप फ़ोल्डर का उपयोग करता है Markdown लक्ष्य के लिए, इस रास्ते में रैली का निपटारा जारी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Audio menggunakan subfolder di dalam unified Markdown Untuk tujuan, Dan jalan itu bertahan dari penundaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo audio, utilizza una sottocarta all'interno dell'unificato Markdown di destinazione, E questo percorso sopravvive ai ritiri rinviati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved Audio は、統合されたファイル内のサブフォルダーを使用します。 Markdown 目的地、 その道は、延期の引退を生き残る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Saveed Audio는 통합된 폴더 내부의 하위 폴더를 사용합니다.Saved audio uses a subfolder inside Markdown 목적지 , 그 길은 늦은 퇴근을 살아남는다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
