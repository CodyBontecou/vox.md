    "Could not register %@. Try a different shortcut. (OSStatus %d)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تسجل %1$@. حاول إجراء اختبار مختلف. (OSStatus %2$d)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিবন্ধন করতে পারিনি %1$@. অন্য রকম ছোট্ট চেষ্টা করুন। (অনুসরণ %2$d)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ konnte nicht registriert werden. Versuchen Sie ein anderes Tastenkürzel. (OSStatus %2$d)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not register %1$@. Try a different shortcut. (OSStatus %2$d)"
          }
        },
        "es": {
