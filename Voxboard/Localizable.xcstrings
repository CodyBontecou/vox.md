            "state": "translated",
            "value": "ஆப் தேர்வு ரத்துசெய்யப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลือกแอปพลิเคชันถูกยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama seçimi iptal edildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір застосунку скасовано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپلیکیشن کا انتخاب منسوخ کر دیا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy chọn ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消选择应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消選擇 App。"
          }
        }
      }
    },
    "Applies to every route. When off, Mac, iPad and the Vox keyboard keep their own rows.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على كل المسارات. عند إيقافه، يحتفظ Mac وiPad ولوحة مفاتيح Vox بصفوفها الخاصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি রুটে প্রযোজ্য। বন্ধ থাকলে Mac, iPad ও Vox কীবোর্ড নিজেদের সারি রাখে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jede Route. Wenn deaktiviert, behalten Mac, iPad und die Vox-Tastatur ihre eigenen Leisten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to every route. When off, Mac, iPad and the Vox keyboard keep their own rows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todas las rutas. Si está desactivado, Mac, iPad y el teclado de Vox conservan sus propias filas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à tous les parcours. Si l’option est désactivée, le Mac, l’iPad et le clavier Vox conservent leurs propres rangées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर रूट पर लागू होता है। बंद होने पर Mac, iPad और Vox कीबोर्ड अपनी-अपनी पंक्तियाँ रखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku untuk setiap rute. Saat nonaktif, Mac, iPad, dan papan ketik Vox memiliki barisnya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a tutti i percorsi. Se disattivata, Mac, iPad e la tastiera Vox mantengono le proprie righe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのルートに適用されます。オフの場合、Mac、iPad、Voxキーボードはそれぞれ独自の行を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 루트에 적용됩니다. 끄면 Mac, iPad 및 Vox 키보드가 각자의 행을 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor elke route. Als dit uit staat, houden Mac, iPad en het Vox-toetsenbord hun eigen rijen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy każdej trasy. Gdy wyłączone, Mac, iPad i klawiatura Vox mają własne rzędy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todas as rotas. Quando desativado, Mac, iPad e o teclado Vox mantêm suas próprias fileiras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется ко всем маршрутам. Если выключено, у Mac, iPad и клавиатуры Vox свои ряды."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு வழித்தடத்திற்கும் பொருந்தும். முடக்கப்பட்டிருந்தால், Mac, iPad மற்றும் Vox விசைப்பலகை தங்கள் சொந்த வரிசைகளை வைத்திருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับทุกเส้นทาง เมื่อปิด Mac, iPad และแป้นพิมพ์ Vox จะใช้แถวของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm rotalar için geçerlidir. Kapalıyken Mac, iPad ve Vox klavyesi kendi satırlarını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовується до всіх маршрутів. Якщо вимкнено, Mac, iPad і клавіатура Vox мають власні ряди."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر روٹ پر لاگو ہوتا ہے۔ بند ہونے پر Mac، iPad اور Vox کی بورڈ اپنی اپنی قطاریں رکھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho mọi lộ trình. Khi tắt, Mac, iPad và bàn phím Vox giữ hàng riêng của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于所有路线。关闭后，Mac、iPad 和 Vox 键盘将各自保留自己的操作行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於所有路線。關閉後，Mac、iPad 和 Vox 鍵盤會各自保留自己的動作列。"
          }
        }
      }
    },
    "Applies where you choose": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبَّق حيث تختار"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যেখানে চান সেখানে প্রযোজ্য"
          }
        },
        "de": {
