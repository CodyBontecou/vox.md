    "Start a local Watch recording and sync it to Vox.md.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء تسجيل الساعة المحلية وتسجيلها إلى Vox.md."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি স্থানীয় ঘড়ি রেকর্ডিং শুরু করুন এবং এটি সিনাকল করা Vox.md."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet eine lokale Watch-Aufnahme und synchronisiert sie mit Vox.md."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a local Watch recording and sync it to Vox.md."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una grabación de reloj local y sincroniza con Vox.md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez une enregistrement de l'horloge locale et synchronisez-la avec Vox.md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्थानीय घड़ी रिकॉर्डिंग शुरू करें और इसे सिंक्रनाइज़ करें Vox.md."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai merekam lokal Watch dan sinkronisasi ke Vox.md."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviare un'inserzione locale di Watch e sincronizzarla con Vox.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル Watch レコーディングを開始し、それを同期して Vox.md."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 시계 녹음 시작 및 동기화 Vox.md."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start een lokale Watch-opname en synchroniseer deze met Vox.md."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom lokalny nagrywanie zegarka i zsynchronizuj go z Vox.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma gravação local do relógio e sincronize-a com Vox.md."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите локальную запись часов и синхронизируйте ее с Vox.md."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு Local Watch Recording தொடங்கவும், அதை Sync செய்யவும் Vox.md."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มบันทึกนาฬิกาในท้องถิ่นและซิงค์กับ Vox.md."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel bir saat kaydını başlatın ve onu Vox.md."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть локальний запис годинника та синхронізуйте його з Vox.md."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک مقامی گھڑی ریکارڈنگ شروع کریں اور اس کو سنکنرن کریں Vox.md."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu ghi âm đồng hồ cục bộ và đồng bộ nó với Vox.md."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动本地 Watch 录制并同步到 Vox.md."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動本地 Watch 錄製並同步到 Vox.md."
          }
        }
      }
    },
    "Start a voice note from your Apple Watch face and sync it to Vox.md on iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء ملاحظة صوتية من وجهك Apple Watch ونتمثلها إلى Vox.md على iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার থেকে একটি ভয়েস নোট শুরু করুন Apple Watch মুখ এবং এটি সিনাকলিগ Vox.md এ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie eine Sprachnotiz über das Ziffernblatt Ihrer Apple Watch und synchronisieren Sie sie mit Vox.md auf dem iPhone."
          }
        },
        "en": {
