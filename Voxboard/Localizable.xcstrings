    "%@ %@. Auto-renews until canceled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@. Auto-renews until canceled."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . التجديد التلقائي حتى يتم إلغاؤه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ । বাতিল না হওয়া পর্যন্ত অটো-রিনিউ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Automatische Verlängerung bis zur Kündigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Se renueva automáticamente hasta que se cancele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Se renouvelle automatiquement jusqu'à annulation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . रद्द होने तक स्वतः नवीनीकरण।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Perpanjangan otomatis hingga dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Rinnovo automatico fino all'annullamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 。キャンセルされるまで自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . 취소할 때까지 자동 갱신됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Automatische verlenging tot annulering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Automatyczne odnawianie do momentu anulowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Renova automaticamente até ser cancelado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Автоматическое продление до отмены."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . ரத்து செய்யப்படும் வரை தானாக புதுப்பிக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . ต่ออายุอัตโนมัติจนกว่าจะยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . İptal edilene kadar otomatik olarak yenilenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Автоматично поновлюється до скасування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ منسوخ ہونے تک خودکار تجدید ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ . Tự động gia hạn cho đến khi bị hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 。自动续订直至取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 。自動續訂直至取消。"
          }
        }
      }
    },
    "%@, once. No subscription.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, once. No subscription."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ، مرة واحدة. لا يوجد اشتراك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , একবার। কোন সাবস্ক্রিপশন নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , einmal. Kein Abonnement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , una vez. Sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , une fois. Pas d'abonnement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , एक बार। कोई सदस्यता नहीं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , sekali. Tidak ada langganan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , una volta. Nessun abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 、 一度。購読はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , 한 번. 구독이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , eenmaal. Geen abonnement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , raz. Brak subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , uma vez. Sem assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , один раз. Нет подписки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , ஒருமுறை. சந்தா இல்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , ครั้งหนึ่ง. ไม่มีการสมัครสมาชิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , bir kere. Abonelik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , один раз. Немає підписки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ، ایک بار۔ کوئی رکنیت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ , một lần. Không có đăng ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ， 一次。没有订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ， 一次。沒有訂閱。"
          }
        }
      }
    },
    "7 days free, then %@ %@. Auto-renews.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7 days free, then %@ %@. Auto-renews."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "7 أيام مجانية ثم %@ %@ . التجديد التلقائي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "7 দিন বিনামূল্যে, তারপর %@ %@ । অটো-রিনিউ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage kostenlos, dann %@ %@ . Automatische Verlängerung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "7 días gratis, luego %@ %@ . Renovación automática."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 jours gratuits, puis %@ %@ . Renouvellement automatique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "7 दिन मुफ़्त, फिर %@ %@ . स्वतः नवीनीकरण."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis 7 hari, lalu %@ %@ . Perpanjangan otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "7 giorni gratis, poi %@ %@ . Rinnovo automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7 日間無料、その後は%@ %@ 。自動更新。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일 무료 사용 후 %@ %@ . 자동 갱신됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dagen gratis, daarna %@ %@ . Automatische verlenging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dni za darmo, potem %@ %@ . Automatyczne odnawianie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dias grátis, então %@ %@ . Renovação automática."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7 дней бесплатно, затем %@ %@ . Автоматическое продление."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "7 நாட்கள் இலவசம், பிறகு %@ %@ . தானாக புதுப்பிக்கிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟรี 7 วัน จากนั้น %@ %@ ต่ออายุอัตโนมัติ"
