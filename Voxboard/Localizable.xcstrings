    "Your symbol is kept as a fallback for surfaces that cannot display emoji.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الاحتفاظ برمزك كبديل للأماكن التي لا يمكنها عرض الرموز التعبيرية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব জায়গায় ইমোজি দেখানো যায় না সেখানে বিকল্প হিসেবে আপনার সিম্বল রাখা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Symbol bleibt als Ersatz für Stellen erhalten, die keine Emojis anzeigen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your symbol is kept as a fallback for surfaces that cannot display emoji."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu símbolo se conserva como alternativa para las superficies que no pueden mostrar emojis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre symbole est conservé comme solution de repli pour les endroits qui ne peuvent pas afficher d’emoji."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सिंबल उन जगहों के लिए विकल्प के रूप में रखा जाता है जहाँ इमोजी नहीं दिख सकते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simbol Anda disimpan sebagai cadangan untuk tampilan yang tidak dapat menampilkan emoji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il simbolo viene mantenuto come alternativa dove le emoji non possono essere mostrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字を表示できない場所では、記号が代わりに使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지를 표시할 수 없는 곳에서는 기호가 대체용으로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je symbool blijft behouden als reserve voor plekken die geen emoji kunnen tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol zostanie zachowany jako zapasowy tam, gdzie nie można wyświetlić emoji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu símbolo é mantido como alternativa para superfícies que não exibem emojis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Символ сохраняется как запасной вариант для мест, где эмодзи не отображаются."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எமோஜியைக் காட்ட முடியாத இடங்களுக்கு உங்கள் சின்னம் மாற்றாக வைக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญลักษณ์ของคุณจะถูกเก็บไว้เป็นตัวสำรองสำหรับส่วนที่ไม่สามารถแสดงอีโมจิได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simgeniz, emoji gösteremeyen yüzeyler için yedek olarak saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Символ зберігається як запасний варіант для місць, де емодзі не відображаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی علامت ان جگہوں کے لیے متبادل کے طور پر رکھی جاتی ہے جو ایموجی نہیں دکھا سکتیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu tượng của bạn được giữ làm phương án dự phòng cho những nơi không hiển thị được emoji."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的符号将作为备用，用于无法显示表情符号的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的符號會作為備用，用於無法顯示表情符號的位置。"
          }
        }
      }
    },
    "Your transcript was saved locally, but file export failed. %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ الترجمة المحلية ولكن تم نقل الملفات من دون جدوى. %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ট্রান্সিক্রিপ্টটি স্থানীয়ভাবে সংরক্ষিত হয়েছিল, ফাইল রপ্তানি ব্যর্থ হয়েছে। %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Transkript wurde lokal gesichert, aber der Dateiexport schlug fehl. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your transcript was saved locally, but file export failed. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su transcripción se salvó localmente, Pero la exportación de archivos falló. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre transcription a été sauvegardée localement, L’exportation de fichiers a échoué. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी प्रतिलिपि को स्थानीय रूप से सहेजा गया है, लेकिन फाइल निर्यात विफल रहा। %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript Anda disimpan secara lokal, Namun file export gagal. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua transcrizione è stata salvata localmente, L’esportazione dei file è fallita. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのトランスクリプトは地元で保存されました。 ファイルの輸出が失敗しました。 %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 번역서는 로컬로 저장되었습니다. 파일 수출이 실패했습니다. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw transcript is lokaal opgeslagen, De export van het bestand mislukt. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój transkrypcja została zapisana lokalnie, Eksport plików nie powiodł się. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição foi guardada localmente. Exportação de arquivos falhou. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш транскрипт был сохранен локально, Однако экспорт файлов не удается. %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பதிவுகள் இடையில் சேமிக்கப்பட்டுள்ளன. File Export க்கு விடை கிடைக்கவில்லை. %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถ่ายภาพของคุณได้รับการบันทึกในท้องถิ่น แต่ไฟล์ส่งออกไม่ได้ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar yerel olarak kaydedildi, Dosya ihracatı başarısız oldu. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш транскрипт був збережений локально, Експорт файлів не вдався. %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ٹرانسفر مقامی طور پر محفوظ کیا گیا تھا، فائل کی برآمد ناکام ہوگئی %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao của bạn đã được lưu tại địa phương, File export thất bại. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的转录被保存在本地, 文件导出失败了。 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的轉錄被保存在本地, 文件導出失敗了。 %@"
          }
        }
      }
    },
    "Your transcript was saved locally, but the requested audio could not be prepared. The recording was preserved for recovery.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخزين الترجمة المحلية، ولكن لم يتم إعداد الصوت المطلوب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ট্রান্সক্রিপ্ট স্থানীয়ভাবে সংরক্ষিত হয়েছিল, কিন্তু অনুরোধিত অডিও প্রস্তুত করা সম্ভব হয়নি. রেকর্ডিং পুনরুদ্ধার জন্য সংরক্ষিত হয়েছে."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Transkript wurde lokal gespeichert, aber das angeforderte Audio konnte nicht vorbereitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your transcript was saved locally, but the requested audio could not be prepared. The recording was preserved for recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su transcripción se guardó localmente, pero el audio solicitado no pudo ser preparado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre transcription a été enregistrée localement, mais l'audio demandé n'a pas pu être préparé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी प्रतिलिपि को स्थानीय रूप से सहेजा गया था, लेकिन अनुरोधित ऑडियो तैयार नहीं किया जा सका. रिकॉर्डिंग को पुनर्प्राप्ति के लिए संरक्षित किया गया था."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript Anda disimpan secara lokal, tetapi audio yang diminta tidak dapat disiapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua trascrizione è stata salvata localmente, ma l'audio richiesto non è stato preparato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのトランスクリプトはローカルに保存されたが、要求されたオーディオは準備できなかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 전송은 로컬로 저장되었지만 요청된 오디오는 준비할 수 없었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw transcript werd lokaal opgeslagen, maar de gevraagde audio kon niet worden voorbereid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój transkrypcja została zapisana lokalnie, ale żądany dźwięk nie można było przygotować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição foi salvo localmente, mas o áudio solicitado não pôde ser preparado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш транскрипт был сохранен локально, но запрошенный аудио не мог быть подготовлен."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பதிப்பு இடத்தில் சேமிக்கப்பட்டது, ஆனால் தேர்ந்தெடுக்கப்பட்ட ஆடியோ தயாரிக்க முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถ่ายภาพของคุณถูกบันทึกในท้องถิ่น แต่ไม่สามารถเตรียมเสียงที่ต้องการได้ การบันทึกถูกเก็บไว้เพื่อการกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript yerel olarak kaydedildi, ancak talep edilen ses hazırlanamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш транскрипт був збережений локально, але запис не був підготовлений для відновлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ٹرانسپیٹ مقامی طور پر محفوظ کیا گیا تھا، لیکن درخواست کردہ آڈیو تیار نہیں کیا جا سکتا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao của bạn đã được lưu cục bộ, nhưng âm thanh yêu cầu không thể được chuẩn bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的转录本地保存,但无法准备所需的音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的轉錄本地保存,但無法準備所需的音頻。"
          }
        }
      }
    },
