          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவைப் படித்துக் கொள்ள முடியாது, ஆனால் ஓவியம் பாதுகாப்பாக அமைந்துள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถ่ายภาพไม่สามารถแนบมา แต่การบันทึกเสียงจะถูกจัดขึ้นอย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript'i ekleyemiyordum, ancak ses kaydı güvenle sahneye kondu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт не можна було прикріпити, але аудіозапис безпечно сценується."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسپیٹ شامل نہیں کیا جا سکتا ہے، لیکن آڈیو ریکارڈ محفوظ طریقے سے اسٹیج کیا جاتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm không thể được đính kèm, nhưng bản ghi âm được tổ chức an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录无法附加,但音频录制安全地进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉錄無法附加,但音頻錄製安全地進行。"
          }
        }
      }
    },
    "The transcript could not be saved. The recording remains attached to the Capture draft.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حفظ الترجمة. يبقى المسجل ملحقًا بالخطط السينمائية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডটি সংরক্ষণ করা সম্ভব হয়নি. রেকডিংটি ক্যাপচার ড্রাইফে যুক্ত থাকে।"
          }
        },
        "de": {
          "stringUnit": {
