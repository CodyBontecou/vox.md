    "Every action is pinned.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل الإجراءات مثبّتة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব অ্যাকশন পিন করা আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Aktionen sind angeheftet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every action is pinned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las acciones están fijadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les actions sont épinglées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर ऐक्शन पिन किया गया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tindakan sudah disematkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le azioni sono fissate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアクションがピン留めされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 동작이 고정되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle acties zijn vastgezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie akcje są przypięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as ações estão fixadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все действия закреплены."
