    "Library searches what Vox.md captured on this device. Older notes live in your vault.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبحث المكتبة فيما التقطه Vox.md على هذا الجهاز. الملاحظات الأقدم موجودة في خزنتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইব্রেরি এই ডিভাইসে Vox.md যা ক্যাপচার করেছে তা খোঁজে। পুরোনো নোট আপনার ভল্টে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mediathek durchsucht, was Vox.md auf diesem Gerät erfasst hat. Ältere Notizen liegen in deinem Vault."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library searches what Vox.md captured on this device. Older notes live in your vault."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca busca lo que Vox.md capturó en este dispositivo. Las notas anteriores están en tu vault."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque cherche dans ce que Vox.md a capturé sur cet appareil. Les notes plus anciennes sont dans votre coffre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी इस डिवाइस पर Vox.md द्वारा कैप्चर की गई चीज़ें खोजती है। पुराने नोट आपके वॉल्ट में रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka mencari apa yang ditangkap Vox.md di perangkat ini. Catatan lama ada di vault Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La libreria cerca ciò che Vox.md ha acquisito su questo dispositivo. Le note più vecchie sono nel tuo vault."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリでは、このデバイスで Vox.md がキャプチャした内容を検索します。古いメモは保管庫にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함은 이 기기에서 Vox.md가 캡처한 내용을 검색합니다. 이전 메모는 보관소에 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bibliotheek doorzoekt wat Vox.md op dit apparaat heeft vastgelegd. Oudere notities staan in je kluis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteka przeszukuje to, co Vox.md przechwyciło na tym urządzeniu. Starsze notatki są w Twoim sejfie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca busca o que o Vox.md capturou neste dispositivo. Notas mais antigas ficam no seu cofre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиатека ищет то, что Vox.md записал на этом устройстве. Более старые заметки — в вашем хранилище."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் Vox.md பிடித்தவற்றை நூலகம் தேடும். பழைய குறிப்புகள் உங்கள் வால்ட்டில் உள்ளன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังจะค้นหาสิ่งที่ Vox.md จับไว้บนอุปกรณ์นี้ โน้ตที่เก่ากว่าอยู่ในคลังของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşiv, Vox.md’nin bu cihazda yakaladıklarında arar. Eski notlar kasanızda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіатека шукає те, що Vox.md записав на цьому пристрої. Старіші нотатки — у вашому сховищі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائبریری وہ تلاش کرتی ہے جو Vox.md نے اس ڈیوائس پر کیپچر کیا۔ پرانے نوٹس آپ کے والٹ میں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện tìm trong những gì Vox.md đã ghi trên thiết bị này. Ghi chú cũ hơn nằm trong kho của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库搜索 Vox.md 在此设备上捕捉的内容。更早的笔记在你的资料库文件夹中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫會搜尋 Vox.md 在此裝置上擷取的內容。較早的筆記在你的資料庫資料夾中。"
          }
        }
      }
    },
