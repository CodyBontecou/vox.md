    "%@ audio dropped because the writer could not keep up.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إسقاط صوت %@ لأن أداة الكتابة لم تستطع المواكبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রাইটার তাল রাখতে না পারায় %@ অডিও বাদ পড়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Audio wurde verworfen, weil der Schreiber nicht mehr mithalten konnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ audio dropped because the writer could not keep up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartó audio (%@) porque la escritura no pudo seguir el ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio (%@) abandonné, car l’écriture n’a pas pu suivre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ऑडियो छोड़ दिया गया क्योंकि राइटर साथ नहीं चल सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio %@ terbuang karena penulis tidak dapat mengimbangi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio (%@) scartato perché la scrittura non riusciva a tenere il passo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みが追いつかなかったため、%@のオーディオが破棄されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록이 따라가지 못해 %@ 오디오가 삭제되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio (%@) is verwijderd omdat het wegschrijven het niet kon bijhouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk (%@) utracony, bo zapis nie nadążał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
