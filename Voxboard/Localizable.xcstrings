    "URL delivery could not be saved. Your draft is preserved. %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ التسليم إلى URL. تم الاحتفاظ بمسودتك. %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "URL ডেলিভারি সেভ করা যায়নি। আপনার খসড়া সংরক্ষিত আছে। %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die URL-Zustellung konnte nicht gesichert werden. Ihr Entwurf bleibt erhalten. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL delivery could not be saved. Your draft is preserved. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la entrega por URL. Tu borrador se conserva. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la livraison URL. Votre brouillon est conservé. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL डिलीवरी सहेजी नहीं जा सकी। आपका ड्राफ़्ट सुरक्षित है। %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiriman URL tidak dapat disimpan. Draf Anda tetap tersimpan. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la consegna URL. La bozza è stata conservata. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL配信を保存できませんでした。下書きは保持されています。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 전달을 저장할 수 없습니다. 초안은 보존되었습니다. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De URL-levering kon niet worden bewaard. Je concept blijft behouden. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać dostarczania pod URL. Wersja robocza została zachowana. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a entrega por URL. Seu rascunho foi preservado. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить доставку по URL. Черновик сохранен. %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "URL வழங்கலைச் சேமிக்க முடியவில்லை. உங்கள் வரைவு பாதுகாக்கப்பட்டுள்ளது. %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกการส่งไปยัง URL ได้ ฉบับร่างของคุณยังคงอยู่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL teslimi kaydedilemedi. Taslağınız korundu. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти доставку за URL. Чернетку збережено. %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "URL ڈیلیوری محفوظ نہیں ہو سکی۔ آپ کا ڈرافٹ محفوظ ہے۔ %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu thiết lập gửi qua URL. Bản nháp của bạn vẫn được giữ. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存 URL 递送。你的草稿已保留。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存 URL 傳送。你的草稿已保留。%@"
          }
        }
      }
    },
    "URL delivery needs attention. Open URL Deliveries in Settings. %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسليم إلى URL بحاجة إلى انتباه. افتح «عمليات التسليم إلى URL» في الإعدادات. %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "URL ডেলিভারিতে মনোযোগ প্রয়োজন। সেটিংসে URL ডেলিভারি খুলুন। %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die URL-Zustellung erfordert Aufmerksamkeit. Öffnen Sie „URL-Zustellungen“ in den Einstellungen. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL delivery needs attention. Open URL Deliveries in Settings. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrega por URL requiere atención. Abre Entregas por URL en Ajustes. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La livraison vers l’URL nécessite votre attention. Ouvrez Livraisons URL dans Réglages. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL डिलीवरी पर ध्यान देना ज़रूरी है। सेटिंग्ज़ में URL डिलीवरी खोलें। %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiriman URL perlu perhatian. Buka Pengiriman URL di Pengaturan. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La consegna all’URL richiede attenzione. Apri Consegne URL in Impostazioni. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL配信の確認が必要です。設定で「URL配信」を開いてください。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 전달을 확인해야 합니다. 설정에서 ‘URL 전달’을 여세요. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Levering via URL vereist aandacht. Open ‘URL-leveringen’ in Instellingen. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostarczanie pod URL wymaga uwagi. Otwórz Dostarczanie pod URL w Ustawieniach. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A entrega por URL precisa de atenção. Abra Entregas por URL nos Ajustes. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доставка по URL требует внимания. Откройте «Доставки по URL» в Настройках. %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "URL வழங்கலுக்குக் கவனம் தேவை. அமைப்புகளில் URL வழங்கல்களைத் திறக்கவும். %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งไปยัง URL ต้องได้รับการตรวจสอบ เปิด “การส่งไปยัง URL” ในการตั้งค่า %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL teslimi ilgi gerektiriyor. Ayarlar'da URL Teslimleri'ni açın. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доставка за URL потребує уваги. Відкрийте «Доставки за URL» у Параметрах. %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "URL ڈیلیوری پر توجہ درکار ہے۔ سیٹنگز میں URL ڈیلیوریز کھولیں۔ %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi qua URL cần chú ý. Mở Gửi qua URL trong Cài đặt. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 递送需要处理。请在“设置”中打开“URL 递送”。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 傳送需要處理。請在「設定」中打開「URL 傳送」。%@"
          }
        }
      }
    },
