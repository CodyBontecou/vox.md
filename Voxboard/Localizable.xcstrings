    "Copy immediately when processed now. Deferred results wait in Activity so they never overwrite your clipboard later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ فورًا عند المعالجة الآن. تنتظر النتائج المؤجلة في «النشاط» حتى لا تستبدل محتوى الحافظة لاحقًا أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনই প্রসেস হলে সাথে সাথে কপি করুন। স্থগিত ফলাফল কার্যকলাপ-এ অপেক্ষা করে, যাতে পরে কখনও আপনার ক্লিপবোর্ড ওভাররাইট না হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofort kopieren, wenn direkt verarbeitet wird. Zurückgestellte Ergebnisse warten in „Aktivität“, damit sie Ihre Zwischenablage nie später überschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy immediately when processed now. Deferred results wait in Activity so they never overwrite your clipboard later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se copia de inmediato si se procesa ahora. Los resultados aplazados esperan en Actividad para no sobrescribir nunca tu portapapeles más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier immédiatement si le traitement est immédiat. Les résultats différés attendent dans Activité pour ne jamais écraser votre presse-papiers plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी प्रोसेस होने पर तुरंत कॉपी करें। स्थगित परिणाम गतिविधि में प्रतीक्षा करते हैं, ताकि वे बाद में कभी आपके क्लिपबोर्ड को ओवरराइट न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin segera jika diproses sekarang. Hasil yang ditunda menunggu di Aktivitas sehingga tidak pernah menimpa papan klip Anda nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia subito se elaborato immediatamente. I risultati rinviati attendono in Attività, così non sovrascrivono mai gli Appunti in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに処理された場合は即座にコピーします。後で処理された結果はアクティビティで待機するので、あとからクリップボードが上書きされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 처리되면 바로 복사합니다. 지연된 결과는 활동에서 대기하므로 나중에 클립보드를 덮어쓰지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer direct wanneer het nu wordt verwerkt. Uitgestelde resultaten wachten in Activiteit, zodat ze je klembord later nooit overschrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuj natychmiast, gdy przetwarzanie odbywa się od razu. Odroczone wyniki czekają w Aktywności, aby nigdy później nie nadpisać schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia imediatamente quando processado na hora. Resultados adiados aguardam na Atividade para nunca sobrescrever sua área de transferência depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копировать сразу при немедленной обработке. Отложенные результаты ждут в разделе «Активность», чтобы никогда не перезаписать буфер обмена позже."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போதே செயலாக்கப்படும்போது உடனடியாக நகலெடு. ஒத்திவைக்கப்பட்ட முடிவுகள் பின்னர் உங்கள் கிளிப்போர்டை மேலெழுதாமல் இருக்க செயல்பாட்டில் காத்திருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกทันทีเมื่อประมวลผลเสร็จในตอนนี้ ผลลัพธ์ที่เลื่อนไว้จะรออยู่ในกิจกรรมเพื่อไม่ให้เขียนทับคลิปบอร์ดของคุณในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen işlendiğinde anında kopyala. Ertelenen sonuçlar Etkinlik'te bekler; böylece panonuzun üzerine daha sonra asla yazmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіювати одразу під час негайної обробки. Відкладені результати чекають у розділі «Активність», щоб ніколи не перезаписати буфер обміну пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی پروسیس ہونے پر فوراً کاپی کریں۔ مؤخر نتائج سرگرمی میں انتظار کرتے ہیں تاکہ بعد میں کبھی آپ کا کلپ بورڈ اوور رائٹ نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép ngay khi được xử lý luôn. Kết quả hoãn lại chờ trong Hoạt động để không bao giờ ghi đè bảng nhớ tạm của bạn sau này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即处理时会立即拷贝。延后的结果会在“活动”中等待，因此绝不会在之后覆盖你的剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即處理時會立即拷貝。延後的結果會在「活動」中等待，因此絕不會在之後覆寫你的剪貼簿。"
          }
        }
      }
    },
