          "stringUnit": {
            "state": "translated",
            "value": "Ottenere la posizione di questo orologio una volta prima di salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存する前に、このウォッチの位置を一度取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하기 전에 이 시계의 위치를 한 번 가져옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
