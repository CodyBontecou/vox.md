          "stringUnit": {
            "state": "translated",
            "value": "Nada em andamento agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас ничего не обрабатывается."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது எதுவும் நடைபெறவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ไม่มีรายการที่กำลังดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda işlemde olan bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз нічого не обробляється."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت کچھ بھی جاری نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không có gì đang xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有进行中的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有進行中的內容。"
          }
        }
      }
    },
    "Nothing needs you right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء بحاجة إليك الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে কিছুতেই আপনাকে প্রয়োজন নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade erfordert nichts Ihre Aufmerksamkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing needs you right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada requiere tu atención ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à traiter pour le moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी किसी चीज़ को आपकी ज़रूरत नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang memerlukan Anda saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non c’è nulla da controllare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、対応が必要な項目はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 확인이 필요한 항목이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nu niets dat je aandacht nodig heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic teraz nie wymaga Twojej uwagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada precisa de você agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас ничего не требует вашего участия."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது எதற்கும் உங்கள் கவனம் தேவையில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ไม่มีอะไรที่ต้องการคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda sizi bekleyen bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз ніщо не потребує вашої участі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس وقت کسی چیز کو آپ کی ضرورت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không có gì cần bạn xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前没有需要你处理的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有需要你處理的內容。"
          }
        }
      }
    },
    "Nothing pinned. Everything stays under •••.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء مثبت. يبقى كل شيء ضمن •••."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই পিন করা নেই। সবকিছু ••• এর নিচে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts angeheftet. Alles bleibt unter •••."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing pinned. Everything stays under •••."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada fijado. Todo queda en •••."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est épinglé. Tout se trouve sous •••."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी पिन नहीं किया गया। सब कुछ ••• में रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang disematkan. Semuanya tetap ada di bawah •••."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla di fissato. Tutto rimane sotto •••."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めされた項目はありません。すべて•••に入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 항목이 없습니다. 모두 ••• 아래에 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets vastgezet. Alles blijft onder •••."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie przypięto. Wszystko pozostaje pod •••."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada fixado. Tudo fica em •••."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не закреплено. Все остается под •••."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் பொருத்தப்படவில்லை. அனைத்தும் ••• இன் கீழ் இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายการที่ปักหมุด ทุกอย่างอยู่ใต้ •••"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenen bir şey yok. Her şey ••• altında kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не закріплено. Усе залишається під •••."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ بھی پن نہیں۔ سب کچھ ••• کے تحت رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa ghim gì. Mọi thứ vẫn nằm trong •••."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未固定任何操作。所有操作都保留在 ••• 下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未釘選任何動作。所有動作都保留在 ••• 下。"
          }
        }
      }
    },
    "Nothing waiting. Captures from the keyboard, Watch and Mac show up here while they’re on the way to your vault.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء في الانتظار. تظهر هنا الالتقاطات من لوحة المفاتيح وWatch وMac أثناء طريقها إلى خزنتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই অপেক্ষায় নেই। কীবোর্ড, Watch ও Mac থেকে আসা ক্যাপচারগুলো আপনার ভল্টে যাওয়ার পথে এখানে দেখা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wartet. Erfassungen von Tastatur, Watch und Mac erscheinen hier, während sie auf dem Weg zu Ihrem Tresor sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing waiting. Captures from the keyboard, Watch and Mac show up here while they’re on the way to your vault."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en espera. Las capturas del teclado, el Watch y el Mac aparecen aquí mientras van camino a tu bóveda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien en attente. Les captures du clavier, de la Watch et du Mac s’affichent ici pendant leur acheminement vers votre coffre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी प्रतीक्षा में नहीं। कीबोर्ड, Watch और Mac से आए कैप्चर आपके वॉल्ट तक पहुँचने के दौरान यहाँ दिखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang menunggu. Tangkapan dari papan ketik, Watch, dan Mac muncul di sini selama dalam perjalanan ke vault Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla in attesa. Le acquisizioni da tastiera, Watch e Mac vengono mostrate qui mentre sono dirette al tuo vault."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中の項目はありません。キーボード、Watch、Macからのキャプチャは、保管庫へ届くまでここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 항목이 없습니다. 키보드, Watch 및 Mac에서 보낸 캡처는 볼트로 전달되는 동안 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wacht niets. Vastleggingen van het toetsenbord, de Watch en de Mac verschijnen hier terwijl ze onderweg zijn naar je kluis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie oczekuje. Przechwycenia z klawiatury, zegarka i Maca pojawiają się tutaj, gdy są w drodze do sejfu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aguardando. Capturas do teclado, do Watch e do Mac aparecem aqui enquanto estão a caminho do seu cofre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не ожидает. Захваты с клавиатуры, Watch и Mac появляются здесь, пока отправляются в хранилище."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் காத்திருக்கவில்லை. விசைப்பலகை, Watch மற்றும் Mac இலிருந்து வரும் பிடிப்புகள் உங்கள் களஞ்சியத்திற்குச் செல்லும் வழியில் இங்கே காண்பிக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายการรอ การจับภาพจากแป้นพิมพ์ Watch และ Mac จะแสดงที่นี่ระหว่างที่กำลังส่งไปยังวอลต์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen bir şey yok. Klavyeden, Watch'tan ve Mac'ten gelen yakalamalar kasanıza giderken burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не очікує. Захоплення з клавіатури, Watch і Mac з’являються тут, поки надсилаються до сховища."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ بھی منتظر نہیں۔ کی بورڈ، Watch اور Mac سے کیپچرز آپ کے والٹ تک جاتے ہوئے یہاں دکھائی دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì đang chờ. Bản ghi nhanh từ bàn phím, Watch và Mac sẽ hiện ở đây trong lúc được gửi đến kho của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有等待中的内容。来自键盘、手表和 Mac 的采集在送往仓库途中会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有等待中的內容。來自鍵盤、手錶和 Mac 的擷取在送往儲存庫途中會顯示在這裡。"
          }
        }
      }
    },
    "Nothing waiting. Recordings show up here while they’re queued or transcribing, and interrupted recordings return here for recovery.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء في الانتظار. تظهر التسجيلات هنا أثناء وجودها في قائمة الانتظار أو أثناء نسخها صوتيًا، وتعود التسجيلات المتقطعة إلى هنا لاستردادها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই অপেক্ষায় নেই। রেকর্ডিং সারিতে থাকা বা ট্রান্সক্রাইব হওয়ার সময় এখানে দেখা যায়, আর বাধাগ্রস্ত রেকর্ডিং পুনরুদ্ধারের জন্য এখানে ফিরে আসে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wartet. Aufnahmen erscheinen hier, während sie in der Warteschlange sind oder transkribiert werden, und unterbrochene Aufnahmen kehren zur Wiederherstellung hierher zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing waiting. Recordings show up here while they’re queued or transcribing, and interrupted recordings return here for recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en espera. Las grabaciones aparecen aquí mientras están en cola o transcribiéndose, y las interrumpidas vuelven aquí para recuperarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien en attente. Les enregistrements s’affichent ici lorsqu’ils sont en file d’attente ou en cours de transcription, et les enregistrements interrompus y reviennent pour être récupérés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी प्रतीक्षा में नहीं। रिकॉर्डिंग कतार में होने या ट्रांसक्राइब होने के दौरान यहाँ दिखती हैं, और रुकी हुई रिकॉर्डिंग रिकवरी के लिए यहाँ लौट आती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang menunggu. Rekaman muncul di sini selama dalam antrean atau sedang ditranskripsi, dan rekaman yang terganggu kembali ke sini untuk dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla in attesa. Le registrazioni vengono mostrate qui mentre sono in coda o in trascrizione, e quelle interrotte tornano qui per il recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中の項目はありません。録音はキューに入っている間や文字起こし中にここに表示され、中断された録音は復元のためにここに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 항목이 없습니다. 녹음은 대기열에 있거나 전사되는 동안 여기에 표시되며, 중단된 녹음은 복구를 위해 여기로 돌아옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wacht niets. Opnamen verschijnen hier terwijl ze in de wachtrij staan of worden getranscribeerd, en onderbroken opnamen komen hier terug om te worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie oczekuje. Nagrania pojawiają się tutaj, gdy czekają w kolejce lub trwa ich transkrypcja, a przerwane nagrania wracają tu do odzyskania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aguardando. As gravações aparecem aqui enquanto estão na fila ou sendo transcritas, e as interrompidas voltam para cá para recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не ожидает. Записи появляются здесь, пока они в очереди или транскрибируются, а прерванные записи возвращаются сюда для восстановления."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் காத்திருக்கவில்லை. பதிவுகள் வரிசையில் இருக்கும்போதோ உரைமாற்றம் செய்யப்படும்போதோ இங்கே காண்பிக்கப்படும், இடைநின்ற பதிவுகள் மீட்புக்காக இங்கே திரும்பும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายการรอ การบันทึกจะแสดงที่นี่ขณะอยู่ในคิวหรือกำลังถอดเสียง และการบันทึกที่ถูกขัดจังหวะจะกลับมาที่นี่เพื่อกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen bir şey yok. Kayıtlar kuyruktayken veya transkripsiyonları yapılırken burada görünür; kesintiye uğrayan kayıtlar kurtarma için buraya döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не очікує. Записи з’являються тут, поки вони в черзі або транскрибуються, а перервані записи повертаються сюди для відновлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ بھی منتظر نہیں۔ ریکارڈنگز قطار میں یا ٹرانسکرائب ہوتے وقت یہاں دکھائی دیتی ہیں، اور رکاوٹ والی ریکارڈنگز بازیافت کے لیے یہاں واپس آتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì đang chờ. Bản ghi âm hiện ở đây khi đang trong hàng đợi hoặc đang chép lời, và bản ghi âm bị gián đoạn sẽ quay lại đây để khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有等待中的内容。录音在排队或转录时会显示在这里，被中断的录音也会回到这里以便恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有等待中的內容。錄音在排隊或轉錄時會顯示在這裡，被中斷的錄音也會回到這裡以便復原。"
          }
        }
      }
    },
