    "%@ can’t be opened right now. Your capture is safe on this iPhone. Re-grant folder access from Activity to deliver.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن فتح %@ الآن. التقاطك آمن على هذا الـ iPhone. امنح الوصول إلى المجلد مجددًا من «النشاط» للتسليم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এই মুহূর্তে খোলা যাচ্ছে না। আপনার ক্যাপচার এই iPhone-এ নিরাপদ আছে। ডেলিভার করতে কার্যকলাপ থেকে আবার ফোল্ডার অ্যাক্সেস দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann gerade nicht geöffnet werden. Ihre Erfassung ist auf diesem iPhone sicher. Erteilen Sie unter „Aktivität“ erneut Ordnerzugriff, um zuzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can’t be opened right now. Your capture is safe on this iPhone. Re-grant folder access from Activity to deliver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir %@ en este momento. Tu captura está a salvo en este iPhone. Vuelve a conceder acceso a la carpeta desde Actividad para entregarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir %@ pour le moment. Votre capture est en sécurité sur cet iPhone. Accordez à nouveau l’accès au dossier depuis Activité pour la livrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अभी खोला नहीं जा सकता। आपका कैप्चर इस iPhone पर सुरक्षित है। डिलीवर करने के लिए गतिविधि से फ़ोल्डर ऐक्सेस फिर से दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak dapat dibuka sekarang. Tangkapan Anda aman di iPhone ini. Berikan ulang akses folder dari Aktivitas untuk mengirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è possibile aprire %@. La tua acquisizione è al sicuro su questo iPhone. Concedi di nuovo l’accesso alla cartella da Attività per consegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、%@を開けません。キャプチャはこのiPhoneに安全に保存されています。配信するには、アクティビティからフォルダへのアクセスを再度許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 %@ 항목을 열 수 없습니다. 캡처는 이 iPhone에 안전하게 보관되어 있습니다. 전달하려면 활동에서 폴더 접근 권한을 다시 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan nu niet worden geopend. Je vastlegging is veilig op deze iPhone. Geef via Activiteit opnieuw toegang tot de map om af te leveren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz otworzyć: %@. Przechwycenie jest bezpieczne na tym iPhone. Aby dostarczyć, ponownie przyznaj dostęp do folderu w Aktywności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível abrir %@ no momento. Sua captura está segura neste iPhone. Conceda novamente o acesso à pasta na Atividade para entregar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сейчас не открывается. Ваш захват в безопасности на этом iPhone. Снова предоставьте доступ к папке в разделе «Активность», чтобы доставить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐ இப்போது திறக்க முடியாது. உங்கள் பிடிப்பு இந்த iPhone இல் பாதுகாப்பாக உள்ளது. வழங்க, செயல்பாட்டிலிருந்து கோப்புறை அணுகலை மீண்டும் வழங்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้ไม่สามารถเปิด %@ ได้ การจับภาพของคุณปลอดภัยบน iPhone เครื่องนี้ อนุญาตการเข้าถึงโฟลเดอร์อีกครั้งจากกิจกรรมเพื่อส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ şu anda açılamıyor. Yakalamanız bu iPhone'da güvende. Teslim etmek için Etkinlik'ten klasör erişimini yeniden verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зараз не відкривається. Ваше захоплення в безпеці на цьому iPhone. Знову надайте доступ до папки в розділі «Активність», щоб доставити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ اس وقت کھولا نہیں جا سکتا۔ آپ کا کیپچر اس iPhone پر محفوظ ہے۔ ڈیلیور کرنے کے لیے سرگرمی سے فولڈر تک رسائی دوبارہ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không thể mở %@. Bản ghi nhanh của bạn vẫn an toàn trên iPhone này. Cấp lại quyền truy cập thư mục từ Hoạt động để gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法打开 %@。你的采集已安全保存在此 iPhone 上。请在“活动”中重新授予文件夹访问权限以递送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法打開 %@。你的擷取已安全儲存在此 iPhone 上。請在「活動」中重新授與資料夾取用權限以傳送。"
          }
        }
      }
    },
