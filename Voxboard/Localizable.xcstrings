            "value": "อนุญาต HTTP ในเครื่องที่ไม่ปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli olmayan yerel HTTP'ye izin ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити незахищений локальний HTTP"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غیر محفوظ مقامی HTTP کی اجازت دیں"
          }
