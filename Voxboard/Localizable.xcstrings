        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de transcript-inhoud en de metadata van de levering van Capture verwijderd. Het verwijdert niet de uitgevoerde Markdown Notities of bijlagen."
