        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனியுரிமை & பாதுகாப்பில் அணுகல் முடக்கப்பட்டுள்ளது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงปิดอยู่ในความเป็นส่วนตัวและความปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik ve Güvenlik'te erişim kapalı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ вимкнено в розділі «Приватність і безпека»"
