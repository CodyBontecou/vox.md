            "value": "ใช้ {period} สําหรับรายวันที่เลือก สัปดาห์ เดือน สี่เหลี่ยม หรือถุงน่องประจําปี Tokens ยังรวมถึง {date}, {year}, {YR} (2 หมายเลขปี) {month}, {day}, และ {week}."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kullanmak {period} Günlük seçenekler için, Haftalık olarak, Aylık olarak, Çeyrekte bir Ya da yıllık bir çubuk. Tokenler de dahil {date}, {year}, {YR} ( 2 yıl önce ) {month}, {day}, ve {week}."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте {period} Для вибраного щоденника, щотижневий щомісяця, на квартал, або щорічний букет. Токени також включають {date}, {year}, {YR} (наприклад, у два роки) {month}, {day}, та {week}."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "استعمال کریں {period} روزانہ منتخب ہونے والے ہفتہ وار ، مہینے کے چارج، سالانہ بیکٹ ٹوکری بھی شامل ہیں {date}, {year}, {YR} (۲) سال کے لئے {month}, {day}, اور {week}."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng {period} Đối với những ngày được chọn, Tuần Tý, tháng nào, Tứ nhân , hoặc bucket hàng năm. Tokens cũng bao gồm {date}, {year}, {YR} (Từ 2 năm trở lên), {month}, {day}, và {week}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 {period} 对于选择的日常, 周日, 月经, 四季度, 或年份的。 标签也包括 {date}, {year}, {YR} (二)年份, {month}, {day}, 和 {week}."
          }
