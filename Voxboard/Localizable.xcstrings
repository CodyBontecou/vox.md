        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिलिपि के बाद स्पीकर लेबल जोड़े जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Label speaker ditambahkan setelah transkripsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le etichette degli altoparlanti vengono aggiunte dopo la trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランスクリプションの後、スピーカーラベルが追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스피커 라벨은 번역 후에 추가됩니다.Speaker labels are added after transcription."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker labels worden toegevoegd na transcriptie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
