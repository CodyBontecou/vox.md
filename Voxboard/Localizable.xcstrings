        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং এর উৎপত্তি-সময় অবস্থান অবস্থার সাথে নিরাপদ।"
          }
        },
        "de": {
          "stringUnit": {
