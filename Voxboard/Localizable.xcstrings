    "Capture Bar storage is unavailable. Reload after your routes are available.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخزين شريط الالتقاط غير متاح. أعد التحميل بعد أن تصبح مساراتك متاحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার বারের স্টোরেজ অনুপলব্ধ। আপনার রুটগুলো উপলব্ধ হলে রিলোড করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher der Erfassungsleiste ist nicht verfügbar. Laden Sie neu, sobald Ihre Routen verfügbar sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Bar storage is unavailable. Reload after your routes are available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento de la barra de captura no está disponible. Recarga cuando tus rutas estén disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage de la barre de capture est indisponible. Actualisez une fois vos parcours disponibles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर बार स्टोरेज उपलब्ध नहीं है। आपके रूट्स उपलब्ध होने के बाद रीलोड करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan Bilah Tangkapan tidak tersedia. Muat ulang setelah rute Anda tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’archivio della barra di acquisizione non è disponibile. Ricarica quando i percorsi saranno disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャバーのストレージを利用できません。ルートが利用可能になってから再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 막대 저장 공간을 사용할 수 없습니다. 루트를 사용할 수 있게 된 후 다시 불러오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opslag van de vastlegbalk is niet beschikbaar. Laad opnieuw zodra je routes beschikbaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięć paska przechwytywania jest niedostępna. Odśwież, gdy trasy będą dostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento da Barra de Captura está indisponível. Recarregue quando suas rotas estiverem disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище панели захвата недоступно. Обновите, когда маршруты станут доступны."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிடிப்புப் பட்டிச் சேமிப்பகம் கிடைக்கவில்லை. உங்கள் வழித்தடங்கள் கிடைத்த பிறகு மீண்டும் ஏற்றவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่จัดเก็บของแถบจับภาพไม่พร้อมใช้งาน โหลดใหม่หลังจากเส้นทางของคุณพร้อมใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama Çubuğu depolama alanı kullanılamıyor. Rotalarınız kullanılabilir olduğunda yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сховище панелі захоплення недоступне. Оновіть, коли маршрути стануть доступні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر بار کا اسٹوریج دستیاب نہیں۔ اپنے روٹس دستیاب ہونے کے بعد دوبارہ لوڈ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ của Thanh ghi nhanh không khả dụng. Tải lại khi các lộ trình đã sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集栏存储不可用。请在路线可用后重新载入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取列儲存空間無法使用。請在路線可用後重新載入。"
          }
        }
      }
    },
