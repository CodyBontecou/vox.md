    "Restore a previous purchase made with your Apple Account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة الشراء السابق الذي تم إنشاؤه باستخدام حساب Apple الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাপল অ্যাকাউন্ট দিয়ে তৈরি একটি আগের কেনা পুনরুদ্ধার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt einen früheren Kauf wieder her, der mit Ihrem Apple-Konto getätigt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore a previous purchase made with your Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer una compra anterior realizada con su Cuenta Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer un achat précédent effectué avec votre compte Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Apple खाते के साथ किए गए पिछले खरीद को पुनर्स्थापित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengembalikan pembelian sebelumnya yang dilakukan dengan Akun Apple Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina un acquisto precedente effettuato con il tuo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple アカウントで購入した以前の購入を復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정으로 이전에 구입한 제품을 복원합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel van eerdere aankopen die u met uw Apple-account hebt gedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć poprzednie zakupy dokonane za pomocą konta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar uma compra anterior feita com a sua Conta Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите предыдущую покупку, сделанную с помощью учетной записи Apple."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Apple Account மூலம் செய்த முந்தைய வாங்குதல் மீட்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกู้คืนการซื้อก่อนหน้านี้ที่ทําด้วยบัญชี Apple ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Hesabınızla yapılan bir önceki satın alma işlemini kurtarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлення попереднього придбання, зробленого за допомогою облікового запису Apple."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے Apple اکاؤنٹ کے ساتھ پہلے سے ہی خریداری کو دوبارہ کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục một giao dịch mua trước đó đã thực hiện với Tài khoản Apple của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复使用您的 Apple 帐户进行的以前购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復使用您的 Apple 帳戶進行的以前購買。"
          }
        }
      }
    },
