    "Falls back only to a model you have chosen to download.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعود فقط إلى النماذج التي اخترت تحميلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধুমাত্র আপনি ডাউনলোড করার জন্য নির্বাচন করেছেন একটি মডেলের উপর ফেরত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fällt nur auf ein Modell zurück, das Sie zum Herunterladen ausgewählt haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls back only to a model you have chosen to download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuelve sólo a un modelo que ha elegido para descargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne revient qu'à un modèle que vous avez choisi de télécharger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एक मॉडल पर वापस गिरता है जिसे आपने डाउनलोड करने का विकल्प चुना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya kembali ke model yang telah Anda pilih untuk diunduh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritorna solo a un modello che hai scelto di scaricare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードすることを選択したモデルにのみ戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드하도록 선택한 모델만으로 돌아가십시오.Falls back only to a model you have chosen to download."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valt alleen terug naar een model dat u hebt gekozen om te downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wraca tylko do modelu, który wybrałeś do pobrania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retorna apenas a um modelo que você escolheu para baixar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуться только к модели, которую вы выбрали для загрузки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பதிவிறக்க தேர்வு செய்த ஒரு மாதிரி மட்டுமே திரும்பும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับไปที่รูปแบบที่คุณเลือกที่จะดาวน์โหลดเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece indirmek istediğiniz bir model için geri döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повертається тільки до моделі, яку ви обрали для завантаження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف ایک ماڈل پر واپس آتا ہے جس کو آپ ڈاؤن لوڈ کرنے کا انتخاب کرتے ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ quay trở lại một mô hình mà bạn đã chọn để tải xuống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只返回您选择下载的模型。"
