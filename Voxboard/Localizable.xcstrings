    "Precise Location is off, so this route’s exact location could not be captured.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع الدقيق متوقف، لذا تعذّر التقاط الموقع الدقيق لهذا المسار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুনির্দিষ্ট লোকেশন বন্ধ, তাই এই রুটের সঠিক লোকেশন ক্যাপচার করা যায়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Genauer Standort“ ist deaktiviert, daher konnte der exakte Standort für diese Route nicht erfasst werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise Location is off, so this route’s exact location could not be captured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación exacta está desactivada, así que no se pudo obtener la ubicación precisa de esta ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position exacte est désactivée : la position précise de ce parcours n’a pas pu être enregistrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सटीक लोकेशन बंद है, इसलिए इस रूट की सटीक लोकेशन कैप्चर नहीं की जा सकी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi Akurat nonaktif, sehingga lokasi persis untuk rute ini tidak dapat diambil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizione esatta è disattivata, quindi non è stato possibile rilevare la posizione precisa per questo percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「正確な位置情報」がオフのため、このルートの正確な位置を取得できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘정확한 위치’가 꺼져 있어 이 루트의 정확한 위치를 가져올 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Exacte locatie’ staat uit, dus de exacte locatie voor deze route kon niet worden vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokładna lokalizacja jest wyłączona, więc nie udało się ustalić dokładnej lokalizacji dla tej trasy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Localização Exata está desativada, então não foi possível obter a localização precisa desta rota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точная геопозиция выключена, поэтому точное местоположение для этого маршрута получить не удалось."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "துல்லியமான இருப்பிடம் முடக்கப்பட்டுள்ளதால், இந்த வழித்தடத்தின் சரியான இருப்பிடத்தைப் பெற முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งที่แม่นยำปิดอยู่ จึงไม่สามารถบันทึกตำแหน่งที่แน่นอนของเส้นทางนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hassas Konum kapalı olduğundan bu rotanın tam konumu yakalanamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точну геопозицію вимкнено, тому точне розташування для цього маршруту отримати не вдалося."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درست مقام بند ہے، اس لیے اس روٹ کا عین مقام کیپچر نہیں ہو سکا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí chính xác đang tắt nên không thể lấy vị trí chính xác cho lộ trình này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“精确位置”已关闭，因此无法采集此路线的确切位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「精確位置」已關閉，因此無法擷取此路線的確切位置。"
          }
        }
      }
    },
