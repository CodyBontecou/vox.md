        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संसाधनों, कवर्ट रास्ते, आइटम प्रारूपण, अपग्रेड और रिट्री व्यवहार को कॉन्फ़िगर करें।"
