    "Destinations using this template will keep its current prefix and suffix as inline formatting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستحتفظ الوجهات التي تستخدم هذا القالب بالبادئة واللاحقة الحاليتين كتنسيق مضمّن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই টেমপ্লেট ব্যবহারকারী গন্তব্যগুলো এর বর্তমান প্রিফিক্স ও সাফিক্স ইনলাইন ফরম্যাটিং হিসেবে রাখবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziele, die diese Vorlage verwenden, behalten ihr aktuelles Präfix und Suffix als Inline-Formatierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinations using this template will keep its current prefix and suffix as inline formatting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los destinos que usan esta plantilla conservarán su prefijo y sufijo actuales como formato en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les destinations qui utilisent ce modèle conserveront son préfixe et son suffixe actuels comme mise en forme intégrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस टेम्पलेट का उपयोग करने वाले गंतव्य इसके मौजूदा प्रीफ़िक्स और सफ़िक्स को इनलाइन फ़ॉर्मेटिंग के रूप में रखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tujuan yang menggunakan templat ini akan mempertahankan prefiks dan sufiksnya saat ini sebagai format sebaris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le destinazioni che usano questo modello manterranno prefisso e suffisso attuali come formattazione in linea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテンプレートを使用している保存先では、現在のプレフィックスとサフィックスがインラインの書式として保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 템플릿을 사용하는 저장 위치는 현재 접두사와 접미사를 인라인 서식으로 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestemmingen die dit sjabloon gebruiken, behouden het huidige voor- en achtervoegsel als inline opmaak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsca docelowe używające tego szablonu zachowają jego bieżący prefiks i sufiks jako formatowanie wbudowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os destinos que usam este modelo manterão o prefixo e o sufixo atuais como formatação em linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Места назначения, использующие этот шаблон, сохранят его текущие префикс и суффикс как встроенное оформление."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வார்ப்புருவைப் பயன்படுத்தும் சேருமிடங்கள் அதன் தற்போதைய முன்னொட்டையும் பின்னொட்டையும் வரிசை வடிவமைப்பாக வைத்திருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลายทางที่ใช้เทมเพลตนี้จะคงคำนำหน้าและคำต่อท้ายปัจจุบันไว้เป็นการจัดรูปแบบในบรรทัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şablonu kullanan hedefler, şablonun geçerli önekini ve sonekini satır içi biçimlendirme olarak korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місця призначення, що використовують цей шаблон, збережуть його поточні префікс і суфікс як вбудоване оформлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ٹیمپلیٹ استعمال کرنے والی منزلیں اس کا موجودہ سابقہ اور لاحقہ ان لائن فارمیٹنگ کے طور پر برقرار رکھیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đích dùng mẫu này sẽ giữ tiền tố và hậu tố hiện tại của mẫu làm định dạng nội dòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此模板的目标位置将以内联格式保留其当前的前缀和后缀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此範本的目標位置將以行內格式保留其目前的前綴和後綴。"
          }
        }
      }
    },
