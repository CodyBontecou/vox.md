          "stringUnit": {
            "state": "translated",
            "value": "Modelos locais opcionais que você pode baixar e selecionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательные локальные модели, которые можно скачать и выбрать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவிறக்கம் செய்து தேர்ந்தெடுக்கக்கூடிய விருப்ப உள்ளூர் மாதிரிகள்."
