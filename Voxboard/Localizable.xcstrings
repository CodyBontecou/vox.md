    "Configure a destination for a Route in Vox.md before running this shortcut.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط وجهة لمسار في Vox.md قبل تشغيل هذا الاختصار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই শর্টকাট চালানোর আগে Vox.md-এ একটি রুটের জন্য গন্তব্য কনফিগার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie in Vox.md ein Ziel für eine Route, bevor Sie diesen Kurzbefehl ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure a destination for a Route in Vox.md before running this shortcut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un destino para una ruta en Vox.md antes de ejecutar este atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez une destination pour un parcours dans Vox.md avant d’exécuter ce raccourci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह शॉर्टकट चलाने से पहले Vox.md में किसी रूट के लिए गंतव्य कॉन्फ़िगर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasikan tujuan untuk Rute di Vox.md sebelum menjalankan pintasan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura una destinazione per un percorso in Vox.md prima di eseguire questo comando rapido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットを実行する前に、Vox.mdでルートの保存先を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단축어를 실행하기 전에 Vox.md에서 루트의 저장 위치를 구성하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Configureer in Vox.md een bestemming voor een route voordat je deze opdracht uitvoert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skonfiguruj miejsce docelowe trasy w Vox.md przed uruchomieniem tego skrótu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure um destino para uma rota no Vox.md antes de executar este atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте место назначения для маршрута в Vox.md, прежде чем запускать эту команду."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஷார்ட்கட்டை இயக்கும் முன் Vox.md இல் ஒரு வழித்தடத்திற்கான சேருமிடத்தை உள்ளமைக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดค่าปลายทางสำหรับเส้นทางใน Vox.md ก่อนเรียกใช้คำสั่งลัดนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kestirmeyi çalıştırmadan önce Vox.md'de bir Rota için hedef yapılandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте місце призначення для маршруту у Vox.md, перш ніж запускати цю команду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ شارٹ کٹ چلانے سے پہلے Vox.md میں کسی روٹ کے لیے منزل ترتیب دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình đích cho một lộ trình trong Vox.md trước khi chạy phím tắt này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行此快捷指令前，请先在 Vox.md 中为路线配置目标位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行此捷徑前，請先在 Vox.md 中為路線設定目標位置。"
          }
        }
      }
    },
