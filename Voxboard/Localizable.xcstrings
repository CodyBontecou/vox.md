    "The Apple Speech live session ended unexpectedly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلسة Apple Speech في الأماكن المعيشية بشكل غير متوقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এ Apple Speech অপেক্ষাকৃতই শেষ হয় লাইভ সেশন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Sitzung von Apple Speech wurde unerwartet beendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Speech live session ended unexpectedly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple Speech La sesión en vivo terminó inesperadamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Apple Speech La séance se termine inattendue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "के Apple Speech अचानक से ही सीट खत्म हो गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "yang Apple Speech Sesi live berakhir tak terduga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Apple Speech La sessione live si è conclusa inaspettatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ザ・ Apple Speech 会場は意外に終わりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple Speech 곧바로 인해 예기치 않은 시기가 끝났다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Apple Speech De live sessie eindigde onverwacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Speech Sesja zakończyła się niespodziewanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Speech A sessão terminou inesperadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ТЭ Apple Speech Сеанс в прямом эфире закончился неожиданно."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அந்நிய Apple Speech Live session முடிந்து விட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โซ Apple Speech การประชุมสดเสร็จสิ้นอย่างไม่คาดคิด"
          }
        },
        "tr": {
          "stringUnit": {
