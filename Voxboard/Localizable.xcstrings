            "value": "ٹیبلنگ کیشن تیار ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard Listening đã sẵn sàng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘听力准备好了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤聽力準備好了"
          }
        }
      }
    },
    "Keyboard listening is ready. Return to your keyboard to use it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسجيل الدخول إلى الكاميرا لتستخدمها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যাবলেট শুনতে প্রস্তুত. এটি ব্যবহার করার জন্য আপনার ট্যাবে ফেরত যান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tastatur-Diktat ist bereit. Kehren Sie zu Ihrer Tastatur zurück, um es zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard listening is ready. Return to your keyboard to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado está listo. regresa a su teclado para usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écoute du clavier est prête. Retournez à votre clavier pour l'utiliser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सुनने के लिए तैयार है. इसे उपयोग करने के लिए अपनी टैबलेट पर वापस जाएं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol ke keyboard Anda sudah siap untuk digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ascolto della tastiera è pronto. Torna alla tastiera per usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの聴き取りが完了しました。 キーボードに戻って使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 청취가 준비되어 있습니다.이를 사용하기 위해 키보드로 돌아가십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaviatuur luisteren is klaar. Ga terug naar uw toetsenbord om het te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słuchanie klawiatury jest gotowe. Wróć do klawiatury, aby go użyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado está pronto para ser ouvido. Volte ao seu teclado para usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушать клавиатуру готово. Вернитесь к клавиатуре, чтобы использовать ее."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது உங்கள் கணினியில் மீண்டும் மீண்டும் உங்கள் கணினியில் மீண்டும் அதைப் பயன்படுத்தி கொள்ளுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การฟังแป้นพิมพ์พร้อมแล้ว กลับไปที่แป้นพิมพ์ของคุณเพื่อใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye dinleme hazır.Klavyenize geri dönün ve kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажити клавіатуру, поверніться до клавіатури, щоб використовувати її."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیبلٹ سننے کے لئے تیار ہے. اسے استعمال کرنے کے لئے اپنے ٹیبلٹ پر واپس جائیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lắng nghe bàn phím đã sẵn sàng. Trở lại bàn phím của bạn để sử dụng nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘听力准备好了,回到键盘上使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤聽力準備好了,回到鍵盤上使用它。"
          }
        }
      }
    },
    "Keyboard-owned recordings no longer light up the Quick Capture microphone or export a second raw-audio capture.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتحرك أرقام ذات مكتبة الكاميرا إلى ميكروفون Quick Capture أو تنتج إرشادات صوتية ثانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কীবোর্ডের মালিকানাধীন রেকর্ডগুলি আর Quick Capture মাইক্রোফোনটি অগ্নিকাণ্ড করে না বা দ্বিতীয় কাঁচা অডিও ক্যাপচার রপ্তানি করে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastatur-eigene Aufnahmen aktivieren nicht mehr das Quick-Capture-Mikrofon und exportieren keine zweite Roh-Audio-Erfassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard-owned recordings no longer light up the Quick Capture microphone or export a second raw-audio capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones de teclado ya no iluminan el micrófono de captura rápida ni exportan una segunda captura de audio en bruto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements appartenant au clavier ne s'allument plus sur le microphone Quick Capture ou n'exportent plus une deuxième capture audio brute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैबलेट-सब्ज रिकॉर्डिंग अब Quick Capture माइक्रोफोन को रोशन नहीं करते हैं या एक दूसरा कच्चा ऑडियो कैप्चर निर्यात नहीं करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman yang dimiliki keyboard tidak lagi menyalakan mikrofon Quick Capture atau mengekspor rekaman audio mentah kedua."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le registrazioni di proprietà del tastierino non accendono più il microfono Quick Capture o esportano una seconda cattura audio cruda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード所有のレコーディングは、もう Quick Capture マイクを点灯したり、第二回のサウンドオーディオキャプチャをエクスポートしたりしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 소유의 녹음은 더 이상 Quick Capture 마이크를 켜지거나 두 번째 원시 오디오 캡처를 내보내지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnamen die door het toetsenbord worden gebruikt, verlichten de Quick Capture-microfoon niet meer of exporteren een tweede ruwe audiobeelden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania należące do klawiatury nie podświetlają już mikrofonu Quick Capture ani nie eksportują drugiego nagrania surowego dźwięku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações de teclado não iluminam mais o microfone Quick Capture ou exportam uma segunda captura de áudio bruto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи, принадлежащие клавиатуре, больше не освещают микрофон Quick Capture или не экспортируют вторую сырую аудиозапись."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard-owned recordings no longer light the Quick Capture microphone or export a second raw audio capture."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกที่อยู่ในคีย์บอร์ดไม่เปิดไฟไมโครโฟน Quick Capture หรือส่งออกการจับภาพเสียงแบบดิบครั้งที่สอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye sahip kayıtlar artık Quick Capture mikrofonunu aydınlatmaz veya ikinci bir çalıntı ses kaydı ihraç etmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи, що належать клавіатурі, більше не освітлюють мікрофон Quick Capture або не експортують другий сиро-аудіозапис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیبلڈ کے مالک ریکارڈز اب Quick Capture مائیکرو فون کو روشن نہیں کرتے ہیں یا دوسری خام آڈیو کی گرفتاری کو برآمد نہیں کرتے ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản ghi thuộc sở hữu bàn phím không còn chiếu sáng micro Quick Capture hoặc xuất một bản ghi âm thô thứ hai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘所有录音不再点亮 Quick Capture 麦克风或导出第二个原始音频录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤所有錄音不再點亮 Quick Capture 麥克風或導出第二個原始音頻錄音。"
          }
        }
      }
    },
