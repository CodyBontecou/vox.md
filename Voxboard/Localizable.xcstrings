    "This removes the retained audio and any capture that is still queued for delivery.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يجري حذف الصوت المختبئ و أي تسجيل لا يزال في صفوف للحصول على التبرع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি রক্ষিত অডিও এবং যে কোনও ক্যাপচারটি এখনও প্রেরণের জন্য রেখে যাওয়া মুছে ফেলবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden das aufbewahrte Audio und alle noch zur Zustellung in der Warteschlange stehenden Erfassungen entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the retained audio and any capture that is still queued for delivery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el audio retenido y cualquier captura que todavía esté en cola para la entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime l'audio retenu et toute capture qui est encore en file d'attente pour la livraison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रखी हुई ऑडियो और किसी भी कैप्चर को हटाता है जो अभी भी वितरण के लिए लाइन में है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus audio yang disimpan dan setiap capture yang masih menunggu untuk pengiriman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove l'audio conservato e qualsiasi cattura che è ancora in coda per la consegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、保存されたオーディオと、まだ配信の待機中であるすべてのキャプチャが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 보존된 오디오와 배달을 위해 여전히 꼬리표에 있는 모든 캡처가 제거됩니다.This removes the retained audio and any capture that is still in line for delivery."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de bewaard gebleven audio en alle opnames die nog steeds in wachtrijen staan voor levering verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa to zachowane dźwięki i wszelkie nagrania, które są nadal w kolejce do dostarczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o áudio retido e qualquer captura que ainda esteja na fila para entrega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удаляет сохранившийся аудио и любые записи, которые все еще находятся в очереди для доставки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதன் மூலம், காட்டப்பட்ட ஆடியோ மற்றும் இன்னும் அனுப்பப்படும் எந்த பதிவையும் இழக்கப்படுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี้จะลบเสียงที่เก็บไว้และบันทึกใด ๆ ที่ยังคงอยู่ในการจัดอันดับเพื่อจัดส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, saklanan ses ve hala teslimat için sırada kalan herhangi bir yakalama kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видаляє збережений аудіо і будь-який запис, який ще перебуває в черзі для доставки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ محفوظ آڈیو اور کسی بھی کیپٹن کو ہٹا دیتا ہے جو اب بھی ترسیل کے لئے چیلنج ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này loại bỏ âm thanh được giữ lại và bất kỳ bản ghi nào vẫn còn chờ giao hàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除保留的音频和任何仍在排队的录像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除保留的音頻和任何仍在排隊的錄像。"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "ar": {
