    "Enable microphone access in Settings to record audio.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمكنك من الوصول إلى ميكروفون في الإعدادات لتسجيل الصوت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও রেকর্ড করার জন্য সেটিংসের মধ্যে মাইক্রোফোন অ্যাক্সেস সক্ষম করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie den Zugriff auf das Mikrofon in den Einstellungen, um Audio aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable microphone access in Settings to record audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la sección Configuración, habilite el acceso al micrófono para grabar audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer l'accès au microphone dans les paramètres pour enregistrer de l'audio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में माइक्रोफोन पहुंच को सक्षम करें ऑडियो रिकॉर्ड करने के लिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan akses mikrofon di Pengaturan untuk merekam audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivare l'accesso al microfono nelle Impostazioni per registrare l'audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でマイクのアクセスを有効にし、オーディオを録音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 마이크 액세스를 사용하여 오디오를 녹음합니다.Enable microphone access in Settings to record audio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de instellingen microfoontoegang inschakelen om audio op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz dostęp do mikrofonu w ustawieniach, aby nagrywać dźwięk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o acesso ao microfone nas configurações para gravar áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настройках включите доступ микрофона для записи аудио."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதாவது, இடுகைகள் மூலம் audio recording கிடைக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้งานการเข้าถึงไมโครโฟนในเมนูตั้งค่าเพื่อบันทึกเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kaydı için Ayarlar'da mikrofon erişimi etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть доступ до мікрофона в Налаштуваннях для запису аудіо."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آڈیو ریکارڈ کرنے کے لئے ترتیبات میں مائیکروفون تک رسائی کو فعال کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích hoạt truy cập microphone trong Cài đặt để ghi âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中启用麦克风访问以录制音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設置中啟用麥克風訪問以錄製音頻。"
          }
        }
      }
    },
