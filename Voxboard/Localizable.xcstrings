    "Unlock unlimited local Capture and private, on-device transcription. Pay once with no subscription.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء إرسال غير محدود في المحيط والمراجعة الخاصة في الجهاز. ادفع مرة واحدة بدون توقيع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমাহীন স্থানীয় ক্যাপচার এবং ব্যক্তিগত, ডিভাইসের ট্রান্সপ্লিকেশনটি লক করুন. কোন সাবস্ক্রিপশন ছাড়া একবার অর্থ প্রদান করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie unbegrenzte lokale Erfassung und private Transkription auf dem Gerät frei. Einmal zahlen, kein Abo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock unlimited local Capture and private, on-device transcription. Pay once with no subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear capturas locales ilimitadas y transcripciones privadas en el dispositivo. Pagar una vez sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquer la capture locale illimitée et la transcription privée sur l'appareil. Payer une fois sans abonnement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असीमित स्थानीय कैप्चर और निजी, डिवाइस पर ट्रांसक्रिप्शन को अनलॉक करें. बिना सदस्यता के एक बार भुगतान करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock unlimited local Capture dan private, on-device transcription. bayar sekali tanpa langganan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca il localizzatore illimitato e la trascrizione privata sul dispositivo. Paghi una volta senza abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限のローカルキャプチャとデバイス上のプライベートトランスクリプションをロック解除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무제한 로컬 캡처 및 개인, 장치 전송을 해제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbeperkt lokaal opnemen en privé transcriptie op het apparaat. Betaal eenmaal zonder abonnement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj nieograniczone lokalne przechwytywanie i prywatne transkrypcje na urządzeniu.Płać raz bez subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie captura local ilimitada e transcrição privada no dispositivo. Pague uma vez sem assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите неограниченное локальное захват и частную транскрипцию на устройстве.Платить один раз без подписки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதாவது, ஒருவர் தன்னைப் பற்றியும், ஒருவர் தனது சொந்தக் கருத்துக்களைப் பற்றிப் பேசுவதற்காக, அவரைப் பற்றியும், ஒருவர் தனது சொந்தக் கருத்துக்களைப் பற்றிப் பேசுவதற்காக, அவரைப் பற்றிய"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการจับภาพในท้องถิ่นไม่ จํากัด และการถ่ายโอนข้อมูลส่วนตัวบนอุปกรณ์ การชําระเงินครั้งเดียวโดยไม่ต้องสมัครสมาชิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırsız yerel Kapatma ve özel, cihazdaki transkripsiyonun kilidini açın. Abonelik olmadan bir kez ödeme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відключити необмежену локальну версію Capture і приватну транскрипцію на пристрої.Платити один раз без підписки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غیر محدود مقامی کٹ اور ذاتی، آلہ پر ٹرانسپیشن کو بند کریں. ایک بار ادائیگی بغیر کوئی امانت."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa bỏ không giới hạn địa phương Capture và riêng tư, trên thiết bị chuyển đổi. trả một lần mà không có đăng ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁无限的本地捕获和私人,设备上的转录. 付一次,没有订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖無限的本地捕獲和私人,設備上的轉錄. 付一次,沒有訂閱。"
          }
        }
      }
    },
