          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите объект, чтобы увидеть его статус, транскрипт и доступные действия."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு உருப்படியின் நிலை, உரைப்படி மற்றும் கிடைக்கும் செயல்களைக் காண அதைத் தேர்ந்தெடுக்கவும்."
