    "Process voice transcriptions, typed Capture text, or both via “Apply To.”": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معالجة النسخ الصوتية أو نص الالتقاط المكتوب أو كليهما عبر «تطبيق على»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“প্রয়োগ করুন” দিয়ে ভয়েস ট্রান্সক্রিপশন, টাইপ করা ক্যাপচার টেক্সট বা উভয় প্রসেস করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verarbeiten Sie über „Anwenden auf“ Sprachtranskriptionen, getippten Erfassungstext oder beides."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Process voice transcriptions, typed Capture text, or both via “Apply To.”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesa transcripciones de voz, texto escrito en la captura o ambos mediante “Aplicar a”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traitez les transcriptions vocales, le texte saisi dans la capture, ou les deux, via « Appliquer à »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“इस पर लागू करें” से आवाज़ के ट्रांसक्रिप्शन, टाइप किया गया कैप्चर टेक्स्ट या दोनों प्रोसेस करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses transkripsi suara, teks Tangkapan yang diketik, atau keduanya melalui “Terapkan Ke.”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elabora le trascrizioni vocali, il testo digitato nelle acquisizioni o entrambi tramite “Applica a”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「適用対象」で、音声の文字起こし、入力したキャプチャのテキスト、またはその両方を処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘적용 대상’에서 음성 전사, 입력한 캡처 텍스트 또는 둘 다를 처리합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwerk spraaktranscripties, getypte vastlegtekst of beide via ‘Toepassen op’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przetwarzaj transkrypcje głosu, wpisany tekst przechwyceń lub oba za pomocą „Zastosuj do”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Processe transcrições de voz, texto digitado na captura ou ambos com “Aplicar a”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обработка голосовых транскрипций, введенного текста захвата или обоих через «Применять к»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“இதற்குப் பயன்படுத்து” மூலம் குரல் உரைமாற்றங்கள், தட்டச்சு செய்த பிடிப்பு உரை அல்லது இரண்டையும் செயலாக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประมวลผลการถอดเสียงพูด ข้อความการจับภาพที่พิมพ์ หรือทั้งสองอย่างผ่าน “ใช้กับ”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Uygulama Kapsamı” ile ses transkripsiyonlarını, yazılan Yakalama metnini veya her ikisini işleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обробка голосових транскрипцій, введеного тексту захоплення або обох через «Застосовувати до»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "“لاگو کریں برائے” کے ذریعے آواز کی ٹرانسکرپشنز، ٹائپ کردہ کیپچر متن، یا دونوں پروسیس کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xử lý bản chép lời giọng nói, văn bản ghi nhanh đã nhập hoặc cả hai qua “Áp dụng cho.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过“应用于”处理语音转录、输入的采集文本或两者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過「套用於」處理語音轉錄、輸入的擷取文字或兩者。"
          }
        }
      }
    },
    "Process while Vox.md is open and no recording is active.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعالجة أثناء فتح Vox.md وعدم وجود تسجيل نشط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md খোলা থাকলে এবং কোনো রেকর্ডিং সক্রিয় না থাকলে প্রসেস করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verarbeiten, während Vox.md geöffnet ist und keine Aufnahme läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Process while Vox.md is open and no recording is active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesa mientras Vox.md está abierto y no hay ninguna grabación activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traiter lorsque Vox.md est ouvert et qu’aucun enregistrement n’est en cours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md खुला होने और कोई रिकॉर्डिंग सक्रिय न होने पर प्रोसेस करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses saat Vox.md terbuka dan tidak ada rekaman yang aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elabora quando Vox.md è aperto e non è attiva alcuna registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.mdが開いていて録音中でないときに処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md가 열려 있고 녹음 중이 아닐 때 처리합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwerk terwijl Vox.md open is en er geen opname actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przetwarzaj, gdy Vox.md jest otwarty i nie trwa nagrywanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Processa enquanto o Vox.md está aberto e nenhuma gravação está ativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывать, пока Vox.md открыт и запись не идет."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md திறந்திருந்து எந்தப் பதிவும் செயலில் இல்லாதபோது செயலாக்கு."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประมวลผลขณะที่ Vox.md เปิดอยู่และไม่มีการบันทึกที่กำลังทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
