    "Finish the current recording, import, send or route decision before changing this Capture’s route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ التسجيل أو الاستيراد أو الإرسال أو قرار التوجيه الحالي قبل تغيير مسار هذا الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ক্যাপচারের রুট বদলানোর আগে বর্তমান রেকর্ডিং, ইমপোর্ট, পাঠানো বা রুটের সিদ্ধান্ত শেষ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die aktuelle Aufnahme, den Import, das Senden oder die Routenauswahl ab, bevor Sie die Route dieser Erfassung ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the current recording, import, send or route decision before changing this Capture’s route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la grabación, importación, envío o decisión de ruta actual antes de cambiar la ruta de esta captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez l’enregistrement, l’importation, l’envoi ou le choix de parcours en cours avant de changer le parcours de cette capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कैप्चर का रूट बदलने से पहले मौजूदा रिकॉर्डिंग, इम्पोर्ट, भेजना या रूट का निर्णय पूरा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan perekaman, impor, pengiriman, atau keputusan rute saat ini sebelum mengubah rute Tangkapan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la registrazione, l’importazione, l’invio o la scelta del percorso in corso prima di cambiare il percorso di questa acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキャプチャのルートを変更する前に、現在の録音、読み込み、送信、またはルートの選択を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 캡처의 루트를 변경하기 전에 현재 녹음, 가져오기, 보내기 또는 루트 결정을 완료하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond de huidige opname, import, verzending of routekeuze af voordat je de route van deze vastlegging wijzigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ bieżące nagrywanie, import, wysyłanie lub wybór trasy, zanim zmienisz trasę tego przechwycenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a gravação, importação, envio ou decisão de rota atual antes de alterar a rota desta captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите текущую запись, импорт, отправку или выбор маршрута, прежде чем менять маршрут этого захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பிடிப்பின் வழித்தடத்தை மாற்றும் முன் தற்போதைய பதிவு, இறக்குமதி, அனுப்புதல் அல்லது வழித்தட முடிவை முடிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำการบันทึก การนำเข้า การส่ง หรือการเลือกเส้นทางปัจจุบันให้เสร็จก่อนเปลี่ยนเส้นทางของการจับภาพนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Yakalamanın rotasını değiştirmeden önce geçerli kaydı, içe aktarmayı, gönderimi veya rota kararını tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть поточний запис, імпорт, надсилання або вибір маршруту, перш ніж змінювати маршрут цього захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کیپچر کا روٹ تبدیل کرنے سے پہلے موجودہ ریکارڈنگ، امپورٹ، بھیجنے یا روٹ کا فیصلہ مکمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất bản ghi âm, quá trình nhập, gửi hoặc lựa chọn lộ trình hiện tại trước khi đổi lộ trình của bản ghi nhanh này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成当前的录音、导入、发送或路线选择，再更改此采集的路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先完成目前的錄音、匯入、傳送或路線選擇，再變更此擷取的路線。"
          }
        }
      }
    },
