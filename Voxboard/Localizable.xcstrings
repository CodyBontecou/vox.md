    "Audio embeds require a Markdown note export. Switch this route to MD, a Markdown template, or YAML with the .md extension.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب تضمينات الصوت تصدير ملاحظة Markdown. بدّل هذا المسار إلى MD أو قالب Markdown أو YAML بامتداد .md."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও এম্বেডের জন্য Markdown নোট এক্সপোর্ট প্রয়োজন। এই রুটটিকে MD, একটি Markdown টেমপ্লেট, বা .md এক্সটেনশনসহ YAML-এ বদলান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio-Einbettungen erfordern einen Markdown-Notizexport. Stellen Sie diese Route auf MD, eine Markdown-Vorlage oder YAML mit der Endung .md um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio embeds require a Markdown note export. Switch this route to MD, a Markdown template, or YAML with the .md extension."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Insertar audio requiere exportar a una nota Markdown. Cambia esta ruta a MD, a una plantilla Markdown o a YAML con la extensión .md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les intégrations audio nécessitent une exportation de note Markdown. Passez ce parcours en MD, en modèle Markdown ou en YAML avec l’extension .md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो एम्बेड के लिए Markdown नोट एक्सपोर्ट ज़रूरी है। इस रूट को MD, किसी Markdown टेम्पलेट या .md एक्सटेंशन वाले YAML पर स्विच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sematan audio memerlukan ekspor catatan Markdown. Ubah rute ini ke MD, templat Markdown, atau YAML dengan ekstensi .md."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli audio incorporati richiedono l’esportazione di una nota Markdown. Imposta questo percorso su MD, un modello Markdown o YAML con estensione .md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオの埋め込みには、Markdownメモの書き出しが必要です。このルートをMD、Markdownテンプレート、または拡張子が .md のYAMLに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 임베드에는 Markdown 메모 내보내기가 필요합니다. 이 루트를 MD, Markdown 템플릿 또는 .md 확장자의 YAML로 전환하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingesloten audio vereist een export als Markdown-notitie. Zet deze route op MD, een Markdown-sjabloon of YAML met de extensie .md."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osadzanie audio wymaga eksportu notatki Markdown. Przełącz tę trasę na MD, szablon Markdown lub YAML z rozszerzeniem .md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorporar áudio exige exportar para uma nota Markdown. Mude esta rota para MD, um modelo Markdown ou YAML com a extensão .md."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для встраивания аудио нужен экспорт заметки в Markdown. Переключите маршрут на MD, шаблон Markdown или YAML с расширением .md."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலி உட்பொதிப்புகளுக்கு Markdown குறிப்பு ஏற்றுமதி தேவை. இந்த வழித்தடத்தை MD, ஒரு Markdown வார்ப்புரு அல்லது .md நீட்டிப்புடன் YAML க்கு மாற்றவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การฝังเสียงต้องใช้การส่งออกโน้ต Markdown เปลี่ยนเส้นทางนี้เป็น MD, เทมเพลต Markdown หรือ YAML ที่มีนามสกุล .md"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses yerleştirmeleri bir Markdown not dışa aktarımı gerektirir. Bu rotayı MD'ye, bir Markdown şablonuna veya .md uzantılı YAML'ye geçirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вбудовування аудіо потрібен експорт нотатки в Markdown. Перемкніть маршрут на MD, шаблон Markdown або YAML з розширенням .md."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آڈیو ایمبیڈز کے لیے Markdown نوٹ ایکسپورٹ درکار ہے۔ اس روٹ کو MD، Markdown ٹیمپلیٹ، یا .md ایکسٹینشن والے YAML پر سوئچ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhúng âm thanh yêu cầu xuất ghi chú Markdown. Chuyển lộ trình này sang MD, một mẫu Markdown hoặc YAML với phần mở rộng .md."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌入音频需要导出 Markdown 笔记。请将此路线切换为 MD、Markdown 模板或使用 .md 扩展名的 YAML。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嵌入音訊需要輸出 Markdown 筆記。請將此路線切換為 MD、Markdown 範本或使用 .md 副檔名的 YAML。"
          }
        }
      }
    },
