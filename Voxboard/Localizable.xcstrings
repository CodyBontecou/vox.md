        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट बचाया गया है। लेकिन उनकी ऑडियो अपील विफल रही। %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan itu diselamatkan, Namun, audio yang ditampilkan gagal. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota è stata salvata, Ma il suo audio non è riuscito. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモが保存され、 オーディオの配信が失敗しました。 %@"
