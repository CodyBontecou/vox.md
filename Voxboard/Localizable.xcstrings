    "Type Markdown, dictate, paste, or drop files anywhere in this window.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب Markdown أو أملِ النص أو الصقه أو أفلت الملفات في أي مكان في هذه النافذة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown লিখুন, ডিক্টেট করুন, পেস্ট করুন বা এই উইন্ডোর যেকোনো স্থানে ফাইল ছেড়ে দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie Markdown, diktieren Sie, fügen Sie Text ein oder ziehen Sie Dateien an eine beliebige Stelle in diesem Fenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type Markdown, dictate, paste, or drop files anywhere in this window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe Markdown, dicta, pega o suelta archivos en cualquier lugar de esta ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez du Markdown, dictez, collez ou déposez des fichiers n’importe où dans cette fenêtre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown लिखें, बोलकर लिखाएँ, पेस्ट करें या इस विंडो में कहीं भी फ़ाइलें छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Markdown, diktekan, tempel, atau letakkan file di mana saja dalam jendela ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi Markdown, detta, incolla o trascina file in qualsiasi punto della finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdownを入力、音声入力、ペーストするか、このウインドウ内にファイルをドロップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown을 입력하거나 받아쓰기, 붙여넣기를 사용하고 이 창 어디에나 파일을 놓으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ Markdown, dicteer, plak of zet bestanden ergens in dit venster neer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz Markdown, dyktuj, wklej lub upuść pliki w dowolnym miejscu tego okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite Markdown, dite, cole ou solte arquivos em qualquer lugar desta janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите Markdown, продиктуйте или вставьте текст либо перетащите файлы в это окно."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown-ஐத் தட்டச்சு செய்யவும், குரல்வழி உள்ளிடவும், ஒட்டவும் அல்லது இந்தச் சாளரத்தில் எங்கும் கோப்புகளை விடவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ Markdown ป้อนตามคำบอก วาง หรือลากไฟล์มาวางที่ใดก็ได้ในหน้าต่างนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown yazın, dikte edin, yapıştırın veya dosyaları bu pencerenin herhangi bir yerine bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть Markdown, продиктуйте або вставте текст чи перетягніть файли в це вікно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown لکھیں، بول کر لکھوائیں، پیسٹ کریں یا اس ونڈو میں کہیں بھی فائلیں چھوڑیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập Markdown, đọc chính tả, dán hoặc thả tệp vào bất kỳ đâu trong cửa sổ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 Markdown、使用听写、粘贴内容，或将文件拖放到此窗口中的任意位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 Markdown、使用聽寫、貼上內容，或將檔案拖放到此視窗中的任意位置。"
          }
        }
      }
    },
