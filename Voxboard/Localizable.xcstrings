    "Vault access restored. Waiting captures are delivering.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت استعادة الوصول إلى الخزنة. جارٍ تسليم الالتقاطات المنتظرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্টের অ্যাক্সেস ফিরে এসেছে। অপেক্ষমাণ ক্যাপচারগুলো ডেলিভার হচ্ছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tresorzugriff wiederhergestellt. Wartende Erfassungen werden zugestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault access restored. Waiting captures are delivering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restauró el acceso a la bóveda. Las capturas en espera se están entregando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès au coffre rétabli. Les captures en attente sont en cours de livraison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्ट ऐक्सेस वापस मिल गया। प्रतीक्षारत कैप्चर डिलीवर हो रहे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses vault dipulihkan. Tangkapan yang menunggu sedang dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso al vault ripristinato. Le acquisizioni in attesa vengono consegnate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫へのアクセスが回復しました。待機中のキャプチャを配信しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼트 접근 권한이 복원되었습니다. 대기 중인 캡처를 전달하는 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot kluis hersteld. Wachtende vastleggingen worden afgeleverd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócono dostęp do sejfu. Oczekujące przechwycenia są dostarczane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso ao cofre restaurado. As capturas em espera estão sendo entregues."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к хранилищу восстановлен. Ожидающие захваты доставляются."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "களஞ்சிய அணுகல் மீட்டமைக்கப்பட்டது. காத்திருக்கும் பிடிப்புகள் வழங்கப்படுகின்றன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนการเข้าถึงวอลต์แล้ว การจับภาพที่รออยู่กำลังถูกส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa erişimi geri yüklendi. Bekleyen yakalamalar teslim ediliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до сховища відновлено. Захоплення в очікуванні доставляються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ تک رسائی بحال ہو گئی۔ منتظر کیپچرز ڈیلیور ہو رہے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục quyền truy cập kho. Các bản ghi nhanh đang chờ đang được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库访问权限已恢复。正在递送等待中的采集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫取用權限已恢復。正在傳送等待中的擷取。"
          }
        }
      }
    },
