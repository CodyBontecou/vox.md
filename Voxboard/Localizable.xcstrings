    "The Capture was cancelled because its route requires an origin-time location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء الالتقاط لأن مساره يتطلب الموقع وقت الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচারটি বাতিল হয়েছে, কারণ এর রুটের জন্য উৎস-সময়ের লোকেশন প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erfassung wurde abgebrochen, da ihre Route einen Standort zum Erfassungszeitpunkt erfordert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Capture was cancelled because its route requires an origin-time location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura se canceló porque su ruta requiere la ubicación del momento de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture a été annulée, car son parcours exige la position au moment de la capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर रद्द कर दिया गया, क्योंकि इसके रूट को मूल-समय की लोकेशन चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan dibatalkan karena rutenya memerlukan lokasi saat tangkapan dibuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisizione è stata annullata perché il suo percorso richiede la posizione al momento dell’acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキャプチャは、ルートで記録時の位置情報が必要なためキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 캡처는 루트에 캡처 시점의 위치가 필요하여 취소되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vastlegging is geannuleerd omdat de route ervan een locatie op het moment van vastleggen vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechwycenie zostało anulowane, ponieważ jego trasa wymaga lokalizacji z chwili przechwycenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A captura foi cancelada porque sua rota exige a localização do momento de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват отменен: его маршруту нужна геопозиция в момент захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பிடிப்பின் வழித்தடத்திற்கு தொடக்க நேர இருப்பிடம் தேவைப்படுவதால் அது ரத்துசெய்யப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพถูกยกเลิกเนื่องจากเส้นทางของการจับภาพนี้ต้องใช้ตำแหน่ง ณ เวลาต้นทาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotası kaynak zamanı konumu gerektirdiği için Yakalama iptal edildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоплення скасовано: його маршруту потрібна геопозиція в момент захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر منسوخ کر دیا گیا کیونکہ اس کے روٹ کو آغاز کے وقت کا مقام درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi nhanh đã bị hủy vì lộ trình của nó yêu cầu vị trí tại thời điểm ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集已取消，因为其路线需要采集时的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取已取消，因為其路線需要擷取當下的位置。"
          }
        }
      }
    },
    "The Family upgrade is available to existing Unlimited owners.": {
      "localizations": {
        "ar": {
