    "Choose a vault or folder and define where this Route writes Markdown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر خزنة أو مجلدًا وحدد مكان كتابة هذا المسار لملفات Markdown."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ভল্ট বা ফোল্ডার বেছে নিন এবং এই রুট কোথায় Markdown লিখবে তা নির্ধারণ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Tresor oder Ordner und legen Sie fest, wohin diese Route Markdown schreibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a vault or folder and define where this Route writes Markdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una bóveda o carpeta y define dónde escribe Markdown esta ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un coffre ou un dossier et définissez où ce parcours écrit le Markdown."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्ट या फ़ोल्डर चुनें और तय करें कि यह रूट Markdown कहाँ लिखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih vault atau folder dan tentukan tempat Rute ini menulis Markdown."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un vault o una cartella e definisci dove questo percorso scrive il Markdown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫またはフォルダを選択し、このルートがMarkdownを書き込む場所を指定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼트 또는 폴더를 선택하고 이 루트가 Markdown을 기록할 위치를 지정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
