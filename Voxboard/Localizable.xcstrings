    "Foundation Models cleans transcripts, adds titles/tags/categories, and powers smart folder routing on-device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models يمنع الترجمة، إضافة عناوين / علامات / فئات، وتشغيل الملفات الذكية على الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models কাল্পনিক ট্রান্সপ্লোরেশন, ট্যাগ / ট্যাগ / বিভাগ যোগ করুন আর এতে করে মডেলের রুটের ক্ষমতা বাড়বে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models bereinigt Transkripte, ergänzt Titel/Tags/Kategorien und ermöglicht Smartes Ordner-Routing auf dem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models cleans transcripts, adds titles/tags/categories, and powers smart folder routing on-device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models Limpieza de transcripciones, añade títulos/etiquetas/categorias, y permite el enrutamiento de carpetas inteligentes en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models Les transcriptions de nettoyage, Ajouter des titres / tags / catégories, et permet le routage de dossier intelligent sur appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models साफ-सफाई के लिए अनुवाद, शीर्षक / टैग / श्रेणियों को जोड़ें, और स्मार्ट फ़ोल्डर routing on-device को सक्षम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models Membersihkan Transcript Menambahkan judul / tag / kategori, dan power smart folder routing on-device."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models trascrizioni pulite, aggiunge titoli/tag / categorie, e Power Smart folder routing on-device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models クリーンなトランスクリプト、 タイトル/タグ/カテゴリを追加する スマートフォルダーのオンデバイスルーティングをサポート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models 청소한 글쓰기, 제목/ 태그/ 카테고리 추가 그리고 똑똑한 폴더를 사용하여 On-Device 로우팅을 가능하게 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models schone transcripties maken, toevoegen van titels/tags/categorieën, en power smart map routing op het apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models czystości transkrypcji, dodaje tytuły / tagi / kategorie, i umożliwia inteligentne routowanie folderów na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models A limpeza das transcrições, Adicionar títulos/tags ou categorias e permite a roteamento de pastas inteligentes no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models Чистые транскрипты добавляет заголовки/таги/категории, и позволяет умную папку маршрутизировать на устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models சுத்தமான பதிவுகள் குறிப்புகள் / tags / categories Smart Routing - அணுகுமுறைக்குள் பயணிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models การทําความสะอาดการถ่ายภาพ เพิ่มชื่อ / แท็ก / หมวดหมู่ และอํานาจโฟลเดอร์สมาร์ทในการเรียกใช้บนอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models Çeviri Yazıları , Başlıklar / Kategoriler / Etiketler Akıllı dosya yönlendiricisi cihazda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models Чистий перепис додає заголовки / теги / категорії, За допомогою Smart Routing можна рухатися на пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models پاکیزہ ٹرانسفر ٹیگ / ٹیگ / کیمرہ شامل کریں اور طاقتور ذہین فارم روٹنگ on-device."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models Tạo sạch các bản dịch, Thêm tiêu đề / tags / category, Power Smart Routing trên thiết bị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models 清洁的转录 添加标题/标签/类别, 智能文件夹在设备上路由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Foundation Models 清潔的轉錄 添加標題/標籤/類別, 智能文件夾在設備上路由。"
          }
        }
      }
    },
