        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অপশনীয় উন্নত স্থানীয় মডেলগুলি আপনি ডাউনলোড করতে পারেন এবং স্পষ্টভাবে নির্বাচন করতে পারেন।"
