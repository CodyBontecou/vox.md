          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna Vox.md su iPhone per usare il percorso di questa registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音のルートを使用するには、iPhoneのVox.mdをアップデートしてください。"
