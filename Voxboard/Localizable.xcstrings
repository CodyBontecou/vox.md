    "Some purchase options are temporarily unavailable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض خيارات الشراء غير متوفرة مؤقتا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু ক্রয় বিকল্প সাময়িকভাবে অপ্রয়োজনীয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Kaufoptionen sind vorübergehend nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some purchase options are temporarily unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas opciones de compra no están disponibles temporalmente."
          }
        },
