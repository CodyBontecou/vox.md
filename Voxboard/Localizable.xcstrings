    "iPhone isn’t nearby. It’ll transcribe and deliver when they reconnect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ليس قريبًا. سيُنسخ ويُسلَّم عند إعادة الاتصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone কাছে নেই। আবার সংযুক্ত হলে ট্রান্সক্রাইব করে ডেলিভার হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone ist nicht in der Nähe. Transkription und Zustellung folgen, sobald sie wieder verbunden sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone isn’t nearby. It’ll transcribe and deliver when they reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone no está cerca. Se transcribirá y entregará cuando vuelvan a conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone n’est pas à proximité. La transcription et la livraison auront lieu à la reconnexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पास में नहीं है। फिर से जुड़ने पर यह ट्रांसक्राइब और डिलीवर होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone tidak di dekat Anda. Akan ditranskripsi dan dikirim saat tersambung lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone non è vicino. Verrà trascritto e consegnato quando si riconnettono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone が近くにありません。再接続すると文字起こしして配信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 근처에 없습니다. 다시 연결되면 전사하고 전달합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone is niet in de buurt. Transcriptie en aflevering volgen zodra ze weer verbonden zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone nie ma w pobliżu. Transkrypcja i dostarczenie nastąpią po ponownym połączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone não está por perto. Será transcrito e entregue quando reconectarem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не рядом. Транскрипция и доставка выполнятся при повторном подключении."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone அருகில் இல்லை. மீண்டும் இணைந்ததும் உரைமாற்றம் செய்து டெலிவர் ஆகும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ไม่ได้อยู่ใกล้ๆ จะถอดเสียงและส่งเมื่อเชื่อมต่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone yakında değil. Yeniden bağlandıklarında yazıya dökülüp teslim edilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone не поруч. Транскрипцію й доставку буде виконано після повторного під’єднання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone قریب نہیں ہے۔ دوبارہ جڑنے پر یہ ٹرانسکرائب اور ڈیلیور ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone không ở gần. Sẽ chép lời và gửi khi kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 不在附近。重新连接后会转写并送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 不在附近。重新連線後會轉寫並送達。"
          }
        }
      }
    },
