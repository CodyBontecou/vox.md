    "Copy plain text to the clipboard without creating a note, saving to History, or retaining audio.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخ النص الشمسي إلى لوحة المفاتيح دون إنشاء ملاحظة أو حفظ إلى التاريخ أو الاحتفاظ باللغة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি নোট তৈরি না করে, ইতিহাসে সংরক্ষণ বা অডিও রক্ষা ছাড়া কপি সহজ টেক্সট ক্লিপবোর্ডে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert reinen Text in die Zwischenablage, ohne eine Notiz zu erstellen, im Verlauf zu speichern oder Audio aufzubewahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy plain text to the clipboard without creating a note, saving to History, or retaining audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie texto simple al clipboard sin crear una nota, guardar en el historial o conservar el audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez du texte simple sur le clipboard sans créer de notes, enregistrer dans l'historique ou conserver l'audio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट बनाने, इतिहास में सहेजें या ऑडियो को बनाए रखने के बिना सीप्लेबॉर्ड में सरल पाठ का कॉपी करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin teks sederhana ke papan klip tanpa membuat catatan, menyimpan ke Sejarah, atau menyimpan audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia il testo semplice al clipboard senza creare una nota, salvare in Storia o mantenere l'audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートを作成し、歴史に保存したり、オーディオを保持することなく、単純なテキストをクリップボードにコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모를 만들거나, 역사에 저장하거나, 오디오를 유지하지 않고 클립보드에 간단한 텍스트를 복사합니다.Copy simple text to the clipboard without creating a note, saving to History, or retaining"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer eenvoudige tekst naar het clipboard zonder een notitie te maken, op te slaan in geschiedenis of audio te behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiuj zwykły tekst do klipu bez tworzenia notatki, zapisania do historii lub zachowania dźwięku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie texto simples para o painel sem criar uma nota, salvar para Histórico ou manter áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копируйте простой текст в клипборд, не создавая заметки, не сохраняя аудио или не записывая в историю."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பதிவு எழுதப்பட்டால், ஒரு பதிவு எழுத முடியாது, ஒரு பதிவு எழுத முடியாது, ஒரு பதிவு எழுத முடியாது, அல்லது ஒரு பதிவு எழுத முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกข้อความที่เรียบง่ายลงในคลิปบอร์ดโดยไม่ต้องสร้างบันทึกบันทึกลงในประวัติหรือเก็บเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not oluşturmadan, Tarih'e kaydetmeden veya ses tutmadan basit metinleri klip tahtasına kopyalayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіюйте простий текст на кліпборд, не створюючи нот, не зберігаючи звуку або збережуючи історію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک نوٹ بنانا، تاریخ میں بچانے یا آڈیو کو برقرار رکھنے کے بغیر کلپ بورڈ پر سادہ متن کاپی کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép văn bản đơn giản vào clipboard mà không tạo ghi chú, lưu vào lịch sử hoặc giữ lại âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将简单的文本复制到剪辑板中,而不创建笔记、保存到历史或保留音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將簡單的文本複製到剪輯板中,而不創建筆記、保存到歷史或保留音頻。"
          }
        }
      }
    },
