          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md அந்தக் கோப்புறையை நினைவில் வைக்க முடியவில்லை: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ไม่สามารถจดจำโฟลเดอร์นั้นได้: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
