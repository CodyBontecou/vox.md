          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette in pausa o riprende il segmento di registrazione attivo di Vox.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中の Vox.md 録音セグメントを一時停止または再開します。"
