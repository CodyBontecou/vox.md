          "stringUnit": {
            "state": "translated",
            "value": "Le Préfet Capture à utiliser pour les enregistrements commencés par ce contrôle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस नियंत्रण से शुरू होने वाले रिकॉर्डिंग के लिए उपयोग करने के लिए कैप्चर पूर्वानुमान।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Preset untuk digunakan untuk rekaman yang dimulai dengan kontrol ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il preset di cattura da utilizzare per le registrazioni avviate da questo controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコントロールで始まったレコーディングに使用する Capture Preset です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컨트롤로 시작된 녹음에 사용하는 캡처 미리 설정.The Capture Preset to use for recordings started by this control."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Capture Preset om te gebruiken voor opnames die met dit besturingselement zijn gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefiniowanie przechwytywania do użycia w przypadku nagrań rozpoczynających się za pomocą tego kontrolka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Predefinição de captura para usar para gravações iniciadas por este controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительная настройка Capture для записи, начатой этим контролем."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த படத்தை முதலில் எழுதினார்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าการจับภาพเพื่อใช้สําหรับบันทึกที่เริ่มโดยควบคุมนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kontrol ile başlayan kayıtlar için kullanılacak Capture Preset."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажити запис, який починається з цього контролера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کنٹرول کے ساتھ شروع ہونے والے ریکارڈز کے لئے استعمال کرنے کے لئے کمانے کی پیشگی ترتیبات."
