    "You already own lifetime Unlimited. Upgrade once to support Apple Family Sharing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت بالفعل لديك Lifetime Unlimited.إعادة التحديث مرة واحدة لتعزيز دعم Apple Family Sharing."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ইতিমধ্যে লাইফটাইম অলিমেটেডের মালিক।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie besitzen bereits lebenslanges Unlimited. Upgraden Sie einmal, um Apple Family Sharing zu unterstützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already own lifetime Unlimited. Upgrade once to support Apple Family Sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes un servicio de vida ilimitado. actualiza una vez para soportar el Apple Family Sharing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous possédez déjà Lifetime Unlimited. Mettez à niveau une fois pour prendre en charge le Partage familial Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पहले से ही लाइफ टाइम अनधिकृत के मालिक हैं. Apple परिवार साझा करने का समर्थन करने के लिए एक बार अपग्रेड करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah memiliki Lifetime Unlimited. upgrade sekali untuk mendukung Apple Family Sharing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
