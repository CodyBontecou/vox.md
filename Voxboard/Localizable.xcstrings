        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Presets でプレフィックス、frontmatter、およびサフキスを再利用するテンプレートを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋을 통해 프리픽스, 프론트마터 및 부작용을 재사용할 템플릿을 만듭니다.Create a template to reuse prefixes, frontmatter"
          }
        },
        "nl": {
