    "Canceled because the route requires an origin-time location": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإلغاء لأن المسار يتطلب الموقع وقت الالتقاط"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাতিল হয়েছে, কারণ এই রুটের জন্য উৎস-সময়ের লোকেশন প্রয়োজন"
