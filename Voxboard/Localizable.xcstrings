    "Hold to talk · tap to record": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا للتحدث · اضغط للتسجيل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথা বলতে ধরে রাখুন · রেকর্ড করতে ট্যাপ করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten zum Sprechen · Tippen zum Aufnehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to talk · tap to record"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionado para hablar · toca para grabar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez pour parler · touchez pour enregistrer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलने के लिए दबाकर रखें · रिकॉर्ड करने के लिए टैप करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan untuk bicara · ketuk untuk merekam"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per parlare · tocca per registrare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しで話す · タップで録音"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 눌러 말하기 · 탭하여 녹음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd vast om te praten · tik om op te nemen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj, aby mówić · stuknij, aby nagrywać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure para falar · toque para gravar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте, чтобы говорить · коснитесь для записи"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பேச பிடித்திருக்கவும் · பதிவுசெய்ய தட்டவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดค้างเพื่อพูด · แตะเพื่อบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmak için basılı tutun · kaydetmek için dokunun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте, щоб говорити · торкніться для запису"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بولنے کے لیے دبا کر رکھیں · ریکارڈ کرنے کے لیے تھپتھپائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ để nói · chạm để ghi âm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话 · 轻点录音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住說話 · 點一下錄音"
          }
        }
      }
    },
    "How was today?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف كان يومك؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের দিন কেমন গেল?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie war heute?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How was today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué tal estuvo hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment s’est passée la journée ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का दिन कैसा रहा?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana hari ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Com’è andata oggi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はどんな一日でしたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 하루는 어땠나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe was je dag?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak minął dzień?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como foi o dia?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как прошел день?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று எப்படி இருந்தது?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้เป็นอย่างไรบ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün nasıldı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як минув день?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کا دن کیسا رہا؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay thế nào?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天过得怎么样？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天過得怎麼樣？"
          }
        }
      }
    },
    "HTTP sends your capture and credentials without encryption. Only enable this for a trusted local endpoint.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل HTTP الالتقاط وبيانات الاعتماد بدون تشفير. فعّل هذا فقط لنقطة نهاية محلية موثوقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP আপনার ক্যাপচার ও ক্রেডেনশিয়াল এনক্রিপশন ছাড়াই পাঠায়। শুধু বিশ্বস্ত স্থানীয় এন্ডপয়েন্টের জন্য এটি চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP sendet Ihre Erfassung und Anmeldedaten unverschlüsselt. Aktivieren Sie dies nur für einen vertrauenswürdigen lokalen Endpunkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP sends your capture and credentials without encryption. Only enable this for a trusted local endpoint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP envía tu captura y tus credenciales sin cifrado. Actívalo solo para un punto de conexión local de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP envoie votre capture et vos identifiants sans chiffrement. N’activez cette option que pour un point de terminaison local de confiance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP आपके कैप्चर और क्रेडेंशियल्स को बिना एन्क्रिप्शन के भेजता है। इसे केवल किसी भरोसेमंद स्थानीय एंडपॉइंट के लिए चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP mengirim tangkapan dan kredensial Anda tanpa enkripsi. Aktifkan ini hanya untuk endpoint lokal tepercaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP invia l’acquisizione e le credenziali senza crittografia. Attiva questa opzione solo per un endpoint locale attendibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPではキャプチャと認証情報が暗号化されずに送信されます。信頼できるローカルのエンドポイントでのみ有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP는 캡처와 자격 증명을 암호화하지 않고 보냅니다. 신뢰할 수 있는 로컬 엔드포인트에서만 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP verstuurt je vastlegging en inloggegevens zonder versleuteling. Schakel dit alleen in voor een vertrouwd lokaal eindpunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP przesyła przechwycenie i dane uwierzytelniające bez szyfrowania. Włączaj to tylko dla zaufanego lokalnego punktu końcowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HTTP envia sua captura e suas credenciais sem criptografia. Ative apenas para um endpoint local confiável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP передает ваш захват и учетные данные без шифрования. Включайте только для доверенного локального адреса."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP உங்கள் பிடிப்பையும் சான்றுகளையும் குறியாக்கம் இல்லாமல் அனுப்பும். நம்பகமான உள்ளூர் முனைப்புள்ளிக்கு மட்டும் இதை இயக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP จะส่งการจับภาพและข้อมูลประจำตัวของคุณโดยไม่เข้ารหัส เปิดใช้เฉพาะกับปลายทางในเครื่องที่เชื่อถือได้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP, yakalamanızı ve kimlik bilgilerinizi şifrelemeden gönderir. Bunu yalnızca güvenilir bir yerel uç nokta için etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP передає ваше захоплення та облікові дані без шифрування. Вмикайте лише для довіреної локальної адреси."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP آپ کا کیپچر اور اسناد بغیر انکرپشن کے بھیجتا ہے۔ اسے صرف کسی قابل اعتماد مقامی اینڈ پوائنٹ کے لیے فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP gửi bản ghi nhanh và thông tin xác thực của bạn mà không mã hóa. Chỉ bật tùy chọn này cho điểm cuối cục bộ đáng tin cậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 会以未加密方式发送你的采集和凭证。仅对受信任的本地端点启用此选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 會以未加密方式傳送你的擷取和憑證。僅對信任的本機端點啟用此選項。"
          }
        }
      }
    },
