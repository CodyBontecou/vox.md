    },
    "Create presets for meetings, journal entries, tasks, ideas, or any setup you use often.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ إعدادات مسبقة للاجتماعات أو إدخالات اليوميات أو المهام أو الأفكار أو أي إعداد تستخدمه كثيرًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিটিং, জার্নাল এন্ট্রি, কাজ, ভাবনা বা নিয়মিত ব্যবহৃত যেকোনো সেটআপের জন্য প্রিসেট তৈরি করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie Presets für Besprechungen, Tagebucheinträge, Aufgaben, Ideen oder häufig genutzte Abläufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create presets for meetings, journal entries, tasks, ideas, or any setup you use often."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea preajustes para reuniones, entradas de diario, tareas, ideas o cualquier configuración que uses con frecuencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez des préréglages pour les réunions, le journal, les tâches, les idées ou toute configuration fréquente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीटिंग, जर्नल प्रविष्टि, कार्य, विचार या बार-बार उपयोग होने वाली किसी भी व्यवस्था के लिए प्रीसेट बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat preset untuk rapat, entri jurnal, tugas, ide, atau pengaturan lain yang sering digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea preset per riunioni, voci di diario, attività, idee o qualsiasi configurazione usata spesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議、日記、タスク、アイデアなど、よく使う用途ごとにプリセットを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의, 일지, 작업, 아이디어 등 자주 사용하는 설정별로 프리셋을 만드세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak voorinstellingen voor vergaderingen, dagboeknotities, taken, ideeën of andere vaak gebruikte instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórz ustawienia dla spotkań, wpisów w dzienniku, zadań, pomysłów i innych często używanych konfiguracji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie predefinições para reuniões, entradas de diário, tarefas, ideias ou qualquer configuração frequente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте наборы параметров для встреч, дневниковых записей, задач, идей и других частых сценариев."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கூட்டங்கள், குறிப்பேட்டுப் பதிவுகள், பணிகள், எண்ணங்கள் அல்லது அடிக்கடி பயன்படுத்தும் அமைப்புகளுக்கு முன்னமைவுகளை உருவாக்குங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างค่าที่ตั้งไว้สำหรับการประชุม บันทึกประจำวัน งาน ไอเดีย หรือการตั้งค่าที่ใช้บ่อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplantılar, günlük girdileri, görevler, fikirler veya sık kullandığınız ayarlar için ön ayarlar oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюйте налаштування для зустрічей, записів у щоденнику, завдань, ідей та інших частих сценаріїв."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میٹنگز، جرنل اندراجات، کاموں، خیالات یا اکثر استعمال ہونے والی کسی بھی ترتیب کے لیے پری سیٹس بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo cấu hình cho cuộc họp, nhật ký, tác vụ, ý tưởng hoặc bất kỳ thiết lập nào bạn thường dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为会议、日记条目、任务、想法或其他常用场景创建预设。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為會議、日記項目、任務、想法或其他常用情境建立預設。"
          }
        }
      }
    },
