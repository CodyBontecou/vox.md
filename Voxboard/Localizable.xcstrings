    "Default. Click “Show Vox.md” from the menu bar or use Cmd-Tab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر فوق \"شاهد Vox.md\" من حزمة الملفات أو استخدام Cmd-Tab."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুর্বল ক্লিক করুন “show” Vox.md» মেনু বার বা ব্যবহার Cmd-Tab."
          }
        },
        "de": {
