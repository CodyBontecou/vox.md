          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz też przeciągać pliki w dowolne miejsce dokumentu przechwycenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode arrastar arquivos para qualquer lugar do documento de captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также можно перетащить файлы в любое место документа захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிடிப்பு ஆவணத்தின் எந்த இடத்திலும் கோப்புகளை இழுத்து விடலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังสามารถลากไฟล์ไปวางที่ใดก็ได้บนเอกสารการจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları Yakalama belgesinin herhangi bir yerine de sürükleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також можна перетягнути файли в будь-яке місце документа захоплення."
