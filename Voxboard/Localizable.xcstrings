    "Set a destination for %@ on iPhone, then retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد وجهة لل %@ على iPhone ثم إعادة تشغيلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ডিগ্রি নির্ধারণ করুন %@ এ iPhone, এরপর রিটার্ন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie ein Ziel für %@ auf dem iPhone fest und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a destination for %@ on iPhone, then retry."
          }
