    "Parakeet detects language automatically. Manual language hints are unavailable for this engine.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet يكتشف اللغة تلقائيا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet ভাষা স্বয়ংক্রিয়ভাবে সনাক্ত করে। এই ইঞ্জিনের জন্য ম্যানুয়াল ভাষা টিপস উপলব্ধ নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet erkennt die Sprache automatisch. Manuelle Sprachhinweise sind für diese Engine nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet detects language automatically. Manual language hints are unavailable for this engine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet El lenguaje se detecta automáticamente. Las pistas de idioma manual no están disponibles para este motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet Détecter automatiquement la langue. Les indications manuelles de langue ne sont pas disponibles pour ce moteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet भाषा को स्वचालित रूप से पता लगाता है। मैन्युअल भाषा सुझाव इस इंजन के लिए उपलब्ध नहीं हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet Bahasa yang secara otomatis Tanda bahasa manual tidak tersedia untuk mesin ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet Il linguaggio viene rilevato automaticamente. Le indicazioni di lingua manuali non sono disponibili per questo motore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet 言語を自動的に検出する。 マニュアル言語ヒントはこのエンジンでは利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet 언어를 자동으로 탐지합니다. 이 엔진에 대해 수동 언어 힌트가 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet De taal wordt automatisch herkend. Handmatige taaltips zijn niet beschikbaar voor deze motor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet automatycznie wykrywa język. Podręczniki językowe nie są dostępne dla tego silnika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet Detecta automaticamente a linguagem. As dicas de idioma manuais não estão disponíveis para este motor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet Язык автоматически вычисляется. Ручные языковые подсказки недоступны для этого двигателя."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet மொழி அறிமுகமாகிவிடும் இந்த மொழியின் மொழிபெயர்ப்புகள் இந்த மொழியில் இல்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet ภาษาตรวจจับโดยอัตโนมัติ คําแนะนําภาษาแบบมือไม่ได้ใช้งานสําหรับเครื่องยนต์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet Dil otomatik olarak algılanır. Manuel dil ipuçları bu motor için kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet Визначення мови автоматично. Ручні натяки на мову недоступні для цього двигуна."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet زبان کو خود بخود استعمال کریں ہینڈل زبان ہدایات اس انجن کے لئے دستیاب نہیں ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet Tự động phát hiện ngôn ngữ Hướng dẫn ngôn ngữ thủ công không sẵn dùng cho công cụ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet 语言自动检测。 手动语言提示不适用于此引擎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet 語言自動檢測。 手動語言提示不適用於此引擎。"
          }
        }
      }
    },
