    "Microphone wasn't receiving audio — please try again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم قبول الصوتيات - يرجى محاولة مرة أخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোন অডিও গ্রহণ করে না - আবার চেষ্টা করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon empfing kein Audio – bitte versuchen Sie es erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone wasn't receiving audio — please try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono no estaba recibiendo audio — por favor, intente de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone ne reçoit pas d'audio - veuillez réessayer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफोन ऑडियो नहीं ले रहा था - कृपया फिर से कोशिश करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tidak menerima audio - silakan coba lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono non riceve l'audio - si prega di riprovare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクがオーディオを受け取っていない - 再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 오디오를 수신하지 않았습니다 - 다시 시도해 주십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon ontving geen audio - probeer het alstublieft opnieuw"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon nie odbierał dźwięku – spróbuj ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone não estava recebendo áudio - por favor tente novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон не получал звук — попробуйте еще раз"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்ரோபின் அட்டை ஏற்கவில்லை - தயவு செய்து மீண்டும் முயற்சி செய்யவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนไม่ได้รับเสียง - โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon ses almadı - tekrar deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон не приймав аудіо — спробуйте ще раз"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیکروفون آڈیو نہیں لیتا تھا - براہ مہربانی دوبارہ کوشش کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro không nhận được âm thanh - vui lòng thử lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
