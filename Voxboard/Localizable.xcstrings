    "No Dock icon or Cmd-Tab entry. Click the menu bar item to reveal Vox.md.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يظهر أي ألبوم Dock أو مكتبة Cmd-Tab. انقر فوق العنوان على صفحة الملفات لتظهر Vox.md."
          }
        },
        "bn": {
          "stringUnit": {
