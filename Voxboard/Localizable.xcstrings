            "value": "Kayıtlı dosya toplam güvenlik sınırı 250 MB'yi aşmaktadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис додатків перевищує загальний обмеження безпеки 250 МБ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کٹنگ ملحقہ 250 MB مجموعی سیکورٹی حد سے زیادہ ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tích hợp tệp đính kèm vượt quá giới hạn bảo mật tổng thể 250 MB."
          }
        },
        "zh-Hans": {
