    "Unlimited access you can share with your Apple Family Sharing group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ويمكنك مشاركة الوصول غير المحدود مع مجموعة Apple Family Sharing."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্তত অন্তর্ভুক্ত অ্যাক্সেস আপনি আপনার Apple পরিবার ভাগ গ্রুপের সাথে শেয়ার করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzten Zugriff, den Sie mit Ihrer Apple Family Sharing-Gruppe teilen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited access you can share with your Apple Family Sharing group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso ilimitado que puede compartir con su grupo de Apple Family Sharing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès illimité que vous pouvez partager avec votre groupe Apple Famille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असीमित पहुंच आप अपने Apple परिवार साझा समूह के साथ साझा कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses tidak terbatas yang dapat Anda bagikan dengan kelompok Apple Family Sharing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso illimitato che puoi condividere con il tuo gruppo di Condivisione Famiglia Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Family Sharing グループと共有できる無制限のアクセスを提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 가족 공유 그룹과 공유할 수 있는 무제한 액세스."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbeperkte toegang die u kunt delen met uw Apple Family Sharing-groep."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieograniczony dostęp, który możesz udostępnić swojej grupie Apple Family Sharing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ilimitado que você pode compartilhar com o grupo de partilha da família Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неограниченный доступ, который вы можете поделиться с группой Apple Family Sharing."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Apple Family Sharing Group-ஐ நீங்கள் இணைக்க முடியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงไม่ จํากัด คุณสามารถแบ่งปันกับกลุ่มการแชร์ Apple Family ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Aile Paylaşımı grubunuzla paylaşabileceğiniz sınırsız erişim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не обмежений доступ, який ви можете надати своїй групі Apple Family Sharing."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اپنے Apple خاندان اشتراک گروپ کے ساتھ اشتراک کر سکتے ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truy cập không giới hạn bạn có thể chia sẻ với nhóm Apple Family Sharing của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
