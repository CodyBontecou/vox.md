      }
    },
    "Another recording is still updating this Capture. Retry the queued recording after it finishes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال تسجيل آخر يحدّث هذا الالتقاط. أعد محاولة التسجيل في قائمة الانتظار بعد انتهائه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য একটি রেকর্ডিং এখনও এই ক্যাপচার আপডেট করছে। সেটি শেষ হলে সারিতে থাকা রেকর্ডিং আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Aufnahme aktualisiert diese Erfassung noch. Versuchen Sie die wartende Aufnahme erneut, wenn sie abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another recording is still updating this Capture. Retry the queued recording after it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra grabación aún está actualizando esta captura. Reintenta la grabación en cola cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre enregistrement met encore à jour cette capture. Réessayez l’enregistrement en file d’attente une fois celui-ci terminé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरी रिकॉर्डिंग अभी भी इस कैप्चर को अपडेट कर रही है। उसके पूरा होने के बाद कतार वाली रिकॉर्डिंग का फिर से प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman lain masih memperbarui Tangkapan ini. Coba ulang rekaman dalam antrean setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra registrazione sta ancora aggiornando questa acquisizione. Riprova la registrazione in coda quando sarà terminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の録音がこのキャプチャを更新中です。完了後に、キュー内の録音を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 녹음이 아직 이 캡처를 업데이트하는 중입니다. 완료된 후 대기열의 녹음을 재시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere opname werkt deze vastlegging nog bij. Probeer de opname in de wachtrij opnieuw als die klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne nagranie wciąż aktualizuje to przechwycenie. Ponów nagranie z kolejki, gdy się zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra gravação ainda está atualizando esta captura. Tente novamente a gravação na fila quando ela terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другая запись все еще обновляет этот захват. Повторите запись из очереди после ее завершения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்றொரு பதிவு இன்னும் இந்தப் பிடிப்பைப் புதுப்பிக்கிறது. அது முடிந்ததும் வரிசையிலுள்ள பதிவை மீண்டும் முயற்சிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกอื่นยังคงอัปเดตการจับภาพนี้อยู่ ลองบันทึกที่อยู่ในคิวอีกครั้งหลังจากเสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir kayıt hâlâ bu Yakalamayı güncelliyor. Bitince kuyruktaki kaydı yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший запис усе ще оновлює це захоплення. Повторіть запис із черги після його завершення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک اور ریکارڈنگ ابھی اس کیپچر کو اپ ڈیٹ کر رہی ہے۔ اس کے مکمل ہونے کے بعد قطار میں موجود ریکارڈنگ کی دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bản ghi âm khác vẫn đang cập nhật bản ghi nhanh này. Hãy thử lại bản ghi âm trong hàng đợi sau khi nó hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一段录音仍在更新此采集。请在其完成后重试排队的录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一段錄音仍在更新此擷取。請在其完成後重試排入佇列的錄音。"
          }
        }
      }
    },
