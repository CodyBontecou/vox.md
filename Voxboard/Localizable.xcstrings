    "The link remains in the durable Capture draft until it is sent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل الرابط في مشروع السماح المستمر حتى يتم إرسالها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিঙ্কটি পাঠানো পর্যন্ত স্থায়ী ক্যাপচার নোটিশে থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link bleibt im dauerhaften Erfassungsentwurf, bis er gesendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link remains in the durable Capture draft until it is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace permanece en el proyecto de captura duradero hasta que se envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien reste dans le projet de capture durable jusqu'à son envoi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक भेजे जाने तक स्थायी कैप्चर डिजाइन में रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Link tetap berada di rancangan Capture yang tahan lama sampai dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link rimane nel progetto di Capture duraturo fino a quando non viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは、送信されるまで持続可能なキャプチャプロジェクトに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크는 보내질 때까지 지속적인 캡처 프로젝트에 남아 있습니다.The link remains in the durable Capture draft until it is sent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link blijft in de duurzame Capture-ontwerp totdat het wordt verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link pozostaje w trwałym projekcie przechwytywania, aż zostanie wysłany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link permanece no projeto de captura duradouro até ser enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка остается в долговременном проекте Capture, пока не будет отправлена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த படத்தின் காப்புரிமை முடிந்தவரை எழுதப்பட்ட படம் வெளியாகும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมโยงยังคงอยู่ในโครงการ Capture ที่คงทนจนกว่าจะถูกส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı, gönderilene kadar kalıcı Capture taslakında kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання залишається в довгостроковому проекті захоплення, поки не буде відправлено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لنک بھیجنے تک بیک اپ ڈراپ میں باقی رہتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết vẫn còn trong bản thảo Capture lâu dài cho đến khi nó được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接在持久捕捉草案中,直到发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏈接在持久捕捉草案中,直到發送。"
          }
        }
      }
    },
    "The link stays in your durable draft until the note is captured.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل الرابط في مشروعك المستمر حتى يتم تسجيل الملاحظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিঙ্কটি আপনার স্থায়ী নোটটি ক্যাপচার না হওয়া পর্যন্ত আপনার টেকসই নোটে থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link bleibt in Ihrem dauerhaften Entwurf, bis die Notiz erfasst wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link stays in your durable draft until the note is captured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace permanece en su proyecto duradero hasta que se capture la nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien reste dans votre projet durable jusqu'à ce que la note soit capturée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक आपके स्थायी नक्शे में तब तक रहता है जब तक नोट पकड़ा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Link tetap berada di draft Anda yang tahan lama sampai catatan ditangkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link rimane nel tuo disegno duraturo fino a quando la nota non viene catturata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは、ノートがキャプチャされるまで、あなたの持続的な草案に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크는 메모가 캡처 될 때까지 지속적인 초안에 남아 있습니다.The link remains in your durable draft until the note is captured."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link blijft in uw duurzame ontwerp totdat de notitie wordt vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link pozostaje w trwałym projekcie, aż do złapania notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link permanece em seu projeto duradouro até que a nota seja capturada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка остается в вашем долговременном проекте, пока запись не будет захвачена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் எழுத்துக்களில் எழுதப்பட்ட பதிவுகள் எழுதப்படும் வரை இந்த எழுத்துக்களில் எழுதப்படுகின்றன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมโยงยังคงอยู่ในโครงการของคุณที่ทนทานจนกว่าจะจับบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı, notu yakalamana kadar kalıcı taslakta kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання залишається у вашому довготривалому проекті, поки не буде захоплена нота."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لنک آپ کے طویل مدتی ڈراپ میں رہتا ہے جب تک نوٹ پکڑ لیا جاتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết vẫn còn trong bản phác thảo lâu dài của bạn cho đến khi ghi chú được chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接将留在您的持久草案中,直到笔记被捕获。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏈接將留在您的持久草案中,直到筆記被捕獲。"
          }
        }
      }
    },
    "The meeting recording could not be finalized. Any completed chunks remain in Recordings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنهاء تسجيل الاجتماع. تبقى أي أجزاء مكتملة في التسجيلات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিটিং রেকর্ডিং চূড়ান্ত করা যায়নি। সম্পূর্ণ হওয়া অংশগুলো রেকর্ডিং-এ রয়ে গেছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Besprechungsaufnahme konnte nicht abgeschlossen werden. Fertiggestellte Abschnitte verbleiben in den Aufnahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting recording could not be finalized. Any completed chunks remain in Recordings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo finalizar la grabación de la reunión. Los fragmentos completados permanecen en Grabaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de finaliser l’enregistrement de la réunion. Les segments terminés restent dans Enregistrements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीटिंग रिकॉर्डिंग को अंतिम रूप नहीं दिया जा सका। पूरे हुए सभी हिस्से रिकॉर्डिंग में बने रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman rapat tidak dapat diselesaikan. Bagian yang sudah selesai tetap ada di Rekaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile finalizzare la registrazione della riunione. Le parti completate restano in Registrazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミーティングの録音を完了できませんでした。完了したチャンクは「録音」に残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 녹음을 마무리할 수 없습니다. 완료된 청크는 녹음에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergaderopname kon niet worden afgerond. Voltooide delen blijven in Opnamen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sfinalizować nagrania spotkania. Ukończone fragmenty pozostają w Nagraniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível finalizar a gravação da reunião. Os trechos concluídos permanecem em Gravações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить запись встречи. Готовые фрагменты остаются в разделе «Записи»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கூட்டப் பதிவை இறுதிசெய்ய முடியவில்லை. முடிந்த பகுதிகள் பதிவுகளில் இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถทำให้การบันทึกการประชุมเสร็จสมบูรณ์ได้ ส่วนที่เสร็จแล้วยังคงอยู่ในการบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplantı kaydı sonlandırılamadı. Tamamlanan parçalar Kayıtlar'da kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити запис зустрічі. Готові фрагменти залишаються в розділі «Записи»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میٹنگ ریکارڈنگ کو حتمی شکل نہیں دی جا سکی۔ کوئی بھی مکمل حصے ریکارڈنگز میں موجود ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn thiện bản ghi cuộc họp. Các phần đã hoàn tất vẫn nằm trong Bản ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成会议录音。所有已完成的片段仍保留在“录音”中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成會議錄音。所有已完成的片段仍保留在「錄音」中。"
          }
        }
      }
    },
    "The meeting was preserved but could not enter the processing queue: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ بالاجتماع لكن تعذّر إدخاله في قائمة انتظار المعالجة: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিটিংটি সংরক্ষিত হয়েছে কিন্তু প্রসেসিং সারিতে যোগ করা যায়নি: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Besprechung wurde gesichert, konnte jedoch nicht in die Verarbeitungswarteschlange aufgenommen werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting was preserved but could not enter the processing queue: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reunión se conservó, pero no pudo entrar en la cola de procesamiento: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réunion a été conservée, mais n’a pas pu entrer dans la file de traitement : %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीटिंग सुरक्षित रखी गई, लेकिन प्रोसेसिंग कतार में नहीं जा सकी: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapat tetap tersimpan tetapi tidak dapat masuk ke antrean pemrosesan: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riunione è stata conservata ma non è potuta entrare nella coda di elaborazione: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミーティングは保持されましたが、処理キューに追加できませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의는 보존되었지만 처리 대기열에 들어갈 수 없음: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergadering is behouden, maar kon niet in de verwerkingswachtrij worden gezet: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotkanie zostało zachowane, ale nie mogło trafić do kolejki przetwarzania: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reunião foi preservada, mas não pôde entrar na fila de processamento: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встреча сохранена, но не попала в очередь обработки: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கூட்டம் பாதுகாக்கப்பட்டது, ஆனால் செயலாக்க வரிசையில் சேர முடியவில்லை: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประชุมได้รับการเก็บรักษาไว้ แต่ไม่สามารถเข้าสู่คิวการประมวลผลได้: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplantı korundu ancak işleme kuyruğuna giremedi: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зустріч збережено, але вона не потрапила до черги обробки: %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میٹنگ محفوظ رکھی گئی لیکن پروسیسنگ کی قطار میں داخل نہیں ہو سکی: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc họp đã được giữ lại nhưng không thể vào hàng đợi xử lý: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议已保留，但无法进入处理队列：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會議已保留，但無法進入處理佇列：%@"
          }
        }
      }
    },
    "The microphone could not be started.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء الميكروفون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোন চালু করা যায়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon konnte nicht gestartet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone could not be started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le micro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन शुरू नहीं किया जा सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tidak dapat dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを開始できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 시작할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon kon niet worden gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić mikrofonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить микрофон."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்ரோஃபோனைத் தொடங்க முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเริ่มไมโครโฟนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon başlatılamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося запустити мікрофон."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیکروفون شروع نہیں ہو سکا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khởi động micrô."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动麦克风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動麥克風。"
          }
        }
      }
    },
    "The microphone could not start recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تبدأ ميكروفون الإذاعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোনটি রেকর্ডিং শুরু করতে পারেনি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon konnte die Aufnahme nicht starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone could not start recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono no pudo comenzar la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro n'a pas pu démarrer l'enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफोन रिकॉर्डिंग शुरू नहीं कर सकता था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tidak bisa memulai rekaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono non ha potuto iniziare la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが録音を開始できなかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 녹음을 시작할 수 없었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
