    "Saved on Watch. It’ll deliver when iPhone reconnects.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ على الساعة. سيُسلَّم عند إعادة اتصال iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-এ সংরক্ষিত। iPhone আবার সংযুক্ত হলে ডেলিভার হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Watch gesichert. Wird zugestellt, sobald das iPhone wieder verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on Watch. It’ll deliver when iPhone reconnects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en el Watch. Se entregará cuando el iPhone vuelva a conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré sur la Watch. Il sera livré quand l’iPhone se reconnectera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch पर सहेजा गया। iPhone फिर से जुड़ने पर डिलीवर होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersimpan di Watch. Akan dikirim saat iPhone tersambung lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato su Watch. Verrà consegnato quando l’iPhone si riconnette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch に保存しました。iPhone が再接続されると配信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch에 저장됨. iPhone이 다시 연결되면 전달됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard op Watch. Wordt afgeleverd zodra iPhone weer verbinding heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano na Watch. Zostanie dostarczone po ponownym połączeniu iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo no Watch. Será entregue quando o iPhone se reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено на Watch. Будет доставлено, когда iPhone снова подключится."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-இல் சேமிக்கப்பட்டது. iPhone மீண்டும் இணைந்ததும் டெலிவர் ஆகும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไว้บน Watch แล้ว จะส่งเมื่อ iPhone เชื่อมต่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch’a kaydedildi. iPhone yeniden bağlandığında teslim edilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено на Watch. Буде доставлено, коли iPhone знову під’єднається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch پر محفوظ۔ iPhone دوبارہ جڑنے پر ڈیلیور ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu trên Watch. Sẽ được gửi khi iPhone kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存在手表上。iPhone 重新连接后会送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存在手錶上。iPhone 重新連線後會送達。"
          }
        }
      }
    },
    "Scan a document straight into the chosen Route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح مستندًا مباشرة إلى المسار المختار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেছে নেওয়া রুটে সরাসরি একটি ডকুমেন্ট স্ক্যান করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne ein Dokument direkt in die gewählte Route."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a document straight into the chosen Route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea un documento directamente en la ruta elegida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numérisez un document directement dans la route choisie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दस्तावेज़ को सीधे चुने रूट में स्कैन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai dokumen langsung ke Rute yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona un documento direttamente nel percorso scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだルートに書類を直接スキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 경로로 문서를 바로 스캔합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan een document direct naar de gekozen route."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj dokument prosto do wybranej trasy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalize um documento direto na rota escolhida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканируйте документ прямо в выбранный маршрут."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்த வழிக்கு நேரடியாக ஒரு ஆவணத்தை ஸ்கேன் செய்யவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนเอกสารเข้าสู่เส้นทางที่เลือกโดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir belgeyi doğrudan seçilen rotaya tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте документ просто у вибраний маршрут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی دستاویز کو براہ راست منتخب روٹ میں اسکین کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét tài liệu thẳng vào Tuyến đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文稿直接扫描到所选路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將文件直接掃描到所選路線。"
          }
        }
      }
    },
