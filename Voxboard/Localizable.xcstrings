            "value": "Plaatshouders: {title} (eerste regel van de vastlegging), {timestamp}, {date}, {time}, {hour}, {minute}, {second}, {year}, {YR} (jaartal met 2 cijfers), {month}, {day}, {id8}, {id}. Bestaande bestandsnamen worden automatisch uniek gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
