    "Templates can contain multiline Markdown or YAML frontmatter. Tokens include {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, {id8}, and {location}.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للمصطلحات أن تحتوي على Multiline Markdown أو YAML الوسوم: تكنولوجيا تكنولوجيات تكنولوجية تكنولوجيت تكنولوجا تكنولوجيه {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}و و {id8}, {location}."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টেমপ্লেটগুলি মাল্টিলাইন অন্তর্ভুক্ত করতে পারে Markdown বা YAML ফ্রন্টম্যাটর টোকেন অন্তর্ভুক্ত {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, এবং {id8}, {location}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen können mehrzeiliges Markdown oder YAML-Frontmatter enthalten. Tokens: {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, {id8} und {location}."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates can contain multiline Markdown or YAML frontmatter. Tokens include {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, {id8}, and {location}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los templos pueden contener multilineas Markdown o YAML El frontón. Los tokens incluyen {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, y {id8}, {location}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles peuvent contenir des multilines Markdown ou YAML Le fronton. Les tokens comprennent {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, et {id8}, {location}."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मल्टीलिन में हो सकता है मल्टीलिन Markdown या YAML फ्रंटमेटर टोकन शामिल हैं {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, और {id8}, {location}."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Template dapat berisi multiline Markdown atau YAML Front yang Token termasuk {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, dan {id8}, {location}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede possono contenere multilinei Markdown o YAML Il frontale. I token includono {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, e {id8}, {location}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートは、Multilineを含むことができます。 Markdown か YAML フロントマッサージ トークンは含む。 {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, 和 {id8}, {location}."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿은 다중 라인을 포함할 수 있습니다.Templates can contain multiline Markdown 또는 YAML 프론트모터 토큰은 포함 {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, 그리고 {id8}, {location}."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates kunnen multiline bevatten Markdown of YAML De frontmatter. Tokens omvatten {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, en {id8}, {location}."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzory mogą zawierać wielokrotności Markdown lub YAML Fronty przednie. Tokeny obejmują {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, i {id8}, {location}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os templates podem conter multilíneas Markdown ou YAML A frente. Tokens incluem {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, e {id8}, {location}."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны могут содержать многолинейные Markdown или YAML фронтальный матерь Токены включают {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, и {id8}, {location}."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பல வகைகள் உள்ளன Markdown அல்லது YAML Frontmatter அறையுலகம் டோனி அதாவது {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, அ {id8}, {location}."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates สามารถมีหลายแถว Markdown หรือ YAML หน้าแรก Tokens รวมถึง {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, และ {id8}, {location}."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablonlar çoklu sayıda içerebilir Markdown veya YAML Öncelikler Tokenler dahil {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, ve {id8}, {location}."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони можуть містити мультилінії Markdown або YAML фронту на фронт. Токени включають {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, та {id8}, {location}."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیبلٹ بھی شامل کر سکتے ہیں multiline Markdown یا YAML frontmatter کے لئے ٹوکری شامل ہے {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, اور {id8}, {location}."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Templates có thể chứa multiline Markdown hoặc YAML Mặt trận Token bao gồm {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, và {id8}, {location}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板可以包含多行 Markdown 或 YAML 前面人 图标包括 {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, 和 {id8}, {location}."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模板可以包含多行 Markdown 或 YAML 前面人 圖標包括 {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, 和 {id8}, {location}."
          }
