          "stringUnit": {
            "state": "translated",
            "value": "Ждать, пока вы не выберете «Обработать сейчас» в разделе «Активность»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்பாட்டில் இப்போது செயலாக்கு என்பதைத் தேர்ந்தெடுக்கும் வரை காத்திரு."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
