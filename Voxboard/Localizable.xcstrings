    "Custom keyboard, widgets, Dynamic Island, and Live Activities remain iOS-specific.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال الكاميرا المخصصة، والفيديوهات، والمسجد الديناميكي، والأنشطة الحية iOS محددة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাস্টম ট্যাবলেট, উইজেট ডায়নামিক দ্বীপ জীবন্ত কর্মসূচি অব্যাহত থাকবে iOSবিশেষ করে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerdefinierte Tastatur, Widgets, Dynamic Island und Live-Aktivitäten bleiben iOS-exklusiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom keyboard, widgets, Dynamic Island, and Live Activities remain iOS-specific."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
