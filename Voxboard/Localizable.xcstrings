          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz Etkinlik'te Şimdi İşle'yi seçene kadar bekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекати, доки ви не виберете «Обробити зараз» у розділі «Активність»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
