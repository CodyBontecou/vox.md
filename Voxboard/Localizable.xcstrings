    "Applying Symbols replaces the emoji with the selected SF Symbol.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي تطبيق «الرموز» إلى استبدال الرمز التعبيري برمز SF Symbol المحدد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "‘সিম্বল’ প্রয়োগ করলে ইমোজির বদলে বেছে নেওয়া SF Symbol বসে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Anwenden von „Symbole“ wird das Emoji durch das ausgewählte SF Symbol ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying Symbols replaces the emoji with the selected SF Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al aplicar Símbolos, el emoji se reemplaza por el SF Symbol seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer Symboles remplace l’emoji par le SF Symbol sélectionné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंबल लागू करने से इमोजी चुने गए SF Symbol से बदल जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerapkan Simbol akan mengganti emoji dengan SF Symbol yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicare Simboli sostituisce l’emoji con il SF Symbol selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「記号」を適用すると、絵文字が選択したSF Symbolに置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기호를 적용하면 이모지가 선택한 SF Symbol로 대체됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je Symbolen toepast, wordt de emoji vervangen door het geselecteerde SF Symbol."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastosowanie Symboli zastępuje emoji wybranym symbolem SF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar Símbolos substitui o emoji pelo SF Symbol selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При применении «Символов» эмодзи заменяется выбранным символом SF."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சின்னங்களைப் பயன்படுத்துவது எமோஜியைத் தேர்ந்தெடுத்த SF Symbol ஆல் மாற்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้ “สัญลักษณ์” จะแทนที่อีโมจิด้วย SF Symbol ที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simgeler'i uygulamak, emojiyi seçilen SF simgesiyle değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час застосування «Символів» емодзі замінюється вибраним символом SF."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "علامات لاگو کرنے سے ایموجی منتخب SF Symbol سے بدل جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng Biểu tượng sẽ thay emoji bằng SF Symbol đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用“符号”会将表情符号替换为所选的 SF Symbol 符号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用「符號」會將表情符號取代為所選的 SF Symbol 符號。"
          }
        }
      }
    },
