        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप फ़ाइलों को कैप्चर दस्तावेज़ पर कहीं भी ड्रैग भी कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda juga dapat menyeret file ke mana saja di dokumen Tangkapan."
          }
        },
        "it": {
          "stringUnit": {
