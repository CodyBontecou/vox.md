    "Pick a vault and routes in Vox.md, then they appear on your Watch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر خزنة ومسارات في Vox.md، وستظهر بعد ذلك على Watch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md-এ একটি ভল্ট ও রুট বেছে নিন, তারপর সেগুলো আপনার Watch-এ দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie in Vox.md einen Tresor und Routen aus, dann erscheinen sie auf Ihrer Watch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a vault and routes in Vox.md, then they appear on your Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una bóveda y rutas en Vox.md y aparecerán en tu Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un coffre et des parcours dans Vox.md : ils apparaîtront ensuite sur votre Watch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md में वॉल्ट और रूट्स चुनें, फिर वे आपकी Watch पर दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih vault dan rute di Vox.md, lalu semuanya akan muncul di Watch Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un vault e dei percorsi in Vox.md: poi appariranno su Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.mdで保管庫とルートを選ぶと、Watchに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md에서 볼트와 루트를 선택하면 Watch에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een kluis en routes in Vox.md, dan verschijnen ze op je Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sejf i trasy w Vox.md, a pojawią się na zegarku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um cofre e rotas no Vox.md e elas aparecerão no seu Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите хранилище и маршруты в Vox.md, и они появятся на ваших часах."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md இல் ஒரு களஞ்சியத்தையும் வழித்தடங்களையும் தேர்ந்தெடுக்கவும், பின்னர் அவை உங்கள் Watch இல் தோன்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกวอลต์และเส้นทางใน Vox.md แล้วรายการเหล่านั้นจะแสดงบน Watch ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md'de bir kasa ve rotalar seçin, ardından bunlar Watch'unuzda görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть сховище й маршрути у Vox.md, і вони з’являться на вашому годиннику."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md میں والٹ اور روٹس منتخب کریں، پھر وہ آپ کی Watch پر دکھائی دیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn kho và lộ trình trong Vox.md, sau đó chúng sẽ hiện trên Watch của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Vox.md 中选择仓库和路线，然后它们就会显示在你的手表上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Vox.md 中選擇儲存庫和路線，然後它們就會顯示在你的手錶上。"
          }
        }
      }
    },
    "Pick Vox.md’s language in Settings on iPhone and iPad — no need to change your whole device language to use the app your way.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لغة Vox.md في الإعدادات على iPhone وiPad — لا حاجة لتغيير لغة جهازك بالكامل لاستخدام التطبيق بطريقتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ও iPad-এ সেটিংসে Vox.md-এর ভাষা বেছে নিন — নিজের মতো অ্যাপ ব্যবহার করতে পুরো ডিভাইসের ভাষা বদলানোর দরকার নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Sprache von Vox.md in den Einstellungen auf iPhone und iPad – Sie müssen nicht die Sprache des ganzen Geräts ändern, um die App nach Ihren Wünschen zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick Vox.md’s language in Settings on iPhone and iPad — no need to change your whole device language to use the app your way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el idioma de Vox.md en Ajustes en el iPhone y el iPad, sin cambiar el idioma de todo el dispositivo para usar la app a tu manera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la langue de Vox.md dans Réglages sur iPhone et iPad, sans changer la langue de tout l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone और iPad पर सेटिंग्ज़ में Vox.md की भाषा चुनें — ऐप को अपने तरीके से इस्तेमाल करने के लिए पूरे डिवाइस की भाषा बदलने की ज़रूरत नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bahasa Vox.md di Pengaturan pada iPhone dan iPad — tidak perlu mengubah bahasa seluruh perangkat untuk menggunakan app sesuai keinginan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la lingua di Vox.md in Impostazioni su iPhone e iPad, senza dover cambiare la lingua dell’intero dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneとiPadの設定でVox.mdの言語を選べます — デバイス全体の言語を変えなくても、好みの言語でアプリを使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 및 iPad의 설정에서 Vox.md의 언어를 선택하세요. 기기 전체 언어를 바꾸지 않고도 원하는 방식으로 앱을 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de taal van Vox.md in Instellingen op iPhone en iPad – je hoeft niet de taal van je hele apparaat te wijzigen om de app op jouw manier te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz język Vox.md w Ustawieniach na iPhone i iPad — bez zmieniania języka całego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o idioma do Vox.md nos Ajustes do iPhone e iPad — sem precisar mudar o idioma do dispositivo inteiro para usar o app do seu jeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите язык Vox.md в Настройках на iPhone и iPad — не нужно менять язык всего устройства, чтобы пользоваться приложением по-своему."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone மற்றும் iPad இல் அமைப்புகளில் Vox.md இன் மொழியைத் தேர்ந்தெடுக்கவும் — உங்கள் விருப்பப்படி ஆப்பைப் பயன்படுத்த முழுச் சாதன மொழியையும் மாற்ற வேண்டியதில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกภาษาของ Vox.md ในการตั้งค่าบน iPhone และ iPad — ไม่ต้องเปลี่ยนภาษาของทั้งอุปกรณ์เพื่อใช้แอปในแบบของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md'nin dilini iPhone ve iPad'de Ayarlar'dan seçin — uygulamayı istediğiniz gibi kullanmak için tüm aygıt dilinizi değiştirmenize gerek yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть мову Vox.md у Параметрах на iPhone і iPad — не треба змінювати мову всього пристрою, щоб користуватися застосунком по-своєму."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone اور iPad پر سیٹنگز میں Vox.md کی زبان منتخب کریں — ایپ کو اپنے طریقے سے استعمال کرنے کے لیے پورے آلے کی زبان بدلنے کی ضرورت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ngôn ngữ của Vox.md trong Cài đặt trên iPhone và iPad — không cần đổi ngôn ngữ của cả thiết bị để dùng ứng dụng theo cách của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 和 iPad 的“设置”中选择 Vox.md 的语言——无需更改整个设备的语言即可按你的方式使用 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 和 iPad 的「設定」中選擇 Vox.md 的語言——不必變更整個裝置的語言即可依你的方式使用 App。"
          }
        }
      }
    },
    "Pin %@": {
