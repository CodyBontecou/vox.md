          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट बचाया गया है। लेकिन उनकी ऑडियो अपील विफल रही। %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan itu diselamatkan, Namun, audio yang ditampilkan gagal. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota è stata salvata, Ma il suo audio non è riuscito. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモが保存され、 オーディオの配信が失敗しました。 %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모가 구해졌고, 하지만 오디오 첨부가 실패했다. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De brief is gered, Maar de audio-aansluiting is mislukt. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatka została uratowana, Ale jego audio-przełącznik nie powiodł się. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota foi salvo, Mas o seu anexo de áudio falhou. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер был спасен, Но его аудиоприложение потерпело неудачу. %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுத்து காப்பாற்றப்பட்டது ஆனால் அவரது audio attachment நஷ்டமாகிவிட்டது. %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกที่ได้รับการบันทึก แต่การเชื่อมต่อเสียงของมันล้มเหลว %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlar kurtarıldı, Ama sesli bağlantı başarısız oldu. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звістка була збережена, Але його аудіозапис провалився. %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ پیغام محفوظ کیا گیا ہے، لیکن اس کی آڈیو ایپلی کیشن ناکام ہوگئی. %@"
          }
        },
        "vi": {
          "stringUnit": {
