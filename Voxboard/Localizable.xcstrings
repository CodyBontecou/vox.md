          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처리, vault 경로, 엔트리 포맷, 첨부 파일 및 리트리 동작을 구성합니다.Configure processing, vault routes, entry formatting, attachments, and retry behavi"
          }
        },
