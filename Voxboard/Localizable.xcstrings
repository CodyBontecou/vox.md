    "This permanently removes the queued Capture that could not resolve its required location.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة الالتقاط الموجود في قائمة الانتظار نهائيًا، لأنه تعذّر تحديد الموقع المطلوب له."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি প্রয়োজনীয় লোকেশন নির্ধারণ করতে না পারা সারিতে থাকা ক্যাপচারটি স্থায়ীভাবে সরিয়ে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die wartende Erfassung, deren erforderlicher Standort nicht ermittelt werden konnte, endgültig entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes the queued Capture that could not resolve its required location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de forma permanente la captura en cola que no pudo obtener la ubicación requerida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement la capture en file d’attente qui n’a pas pu obtenir la position requise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे कतार वाला वह कैप्चर स्थायी रूप से हट जाता है जिसकी ज़रूरी लोकेशन तय नहीं हो सकी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus secara permanen Tangkapan dalam antrean yang tidak dapat menentukan lokasi yang diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione rimuove definitivamente l’acquisizione in coda per cui non è stato possibile ottenere la posizione richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な位置情報を解決できなかったキュー内のキャプチャを完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 위치를 확인할 수 없었던 대기열의 캡처를 영구적으로 제거합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de vastlegging in de wachtrij waarvan de vereiste locatie niet kon worden bepaald, definitief verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie przechwycenia z kolejki, dla którego nie udało się ustalić wymaganej lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove permanentemente a captura na fila que não conseguiu obter a localização exigida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват из очереди, для которого не удалось определить обязательную геопозицию, будет удален навсегда."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது தேவையான இருப்பிடத்தைப் பெற முடியாத வரிசையிலுள்ள பிடிப்பை நிரந்தரமாக அகற்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะเอาการจับภาพในคิวที่ไม่สามารถระบุตำแหน่งที่จำเป็นได้ออกอย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, gerekli konumunu çözümleyemeyen kuyruktaki Yakalamayı kalıcı olarak kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоплення з черги, для якого не вдалося визначити обов’язкову геопозицію, буде видалено назавжди."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ قطار میں موجود اس کیپچر کو مستقل طور پر ہٹا دیتا ہے جو اپنا مطلوبہ مقام حاصل نہیں کر سکا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa vĩnh viễn bản ghi nhanh trong hàng đợi không thể xác định vị trí bắt buộc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久移除无法获取所需位置的队列中采集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久移除無法取得所需位置的佇列中擷取。"
          }
        }
      }
    },
    "This removes the queued recording and its retained audio. This action can’t be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذا التسجيل الموجود في قائمة الانتظار والصوت المحتفظ به. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সারিতে থাকা রেকর্ডিং ও এর সংরক্ষিত অডিও সরিয়ে দেয়। এই কাজটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die wartende Aufnahme und ihr aufbewahrtes Audio entfernt. Dies kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the queued recording and its retained audio. This action can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la grabación en cola y su audio conservado. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime l’enregistrement en file d’attente et l’audio conservé. Elle est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे कतार वाली रिकॉर्डिंग और उसका रखा गया ऑडियो हट जाता है। इस ऐक्शन को पूर्ववत् नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus rekaman dalam antrean dan audio yang disimpannya. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione rimuove la registrazione in coda e l’audio conservato. Non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュー内の録音と保持されているオーディオを削除します。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열의 녹음과 보관된 오디오를 제거합니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de opname in de wachtrij en de bewaarde audio verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie nagrania z kolejki i zachowanego audio. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove a gravação na fila e o áudio retido. Não é possível desfazer esta ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись из очереди и сохраненное аудио будут удалены. Это действие нельзя отменить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது வரிசையிலுள்ள பதிவையும் அதன் தக்கவைக்கப்பட்ட ஒலியையும் அகற்றும். இந்தச் செயலைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะเอาการบันทึกในคิวและเสียงที่เก็บไว้ออก การกระทำนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem kuyruktaki kaydı ve saklanan sesini kaldırır. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис із черги та збережене аудіо буде видалено. Цю дію не можна скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ قطار میں موجود ریکارڈنگ اور اس کی محفوظ آڈیو ہٹا دیتا ہے۔ اس کارروائی کو واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa bản ghi âm trong hàng đợi và âm thanh được lưu giữ. Bạn không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除队列中的录音及其保留的音频。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除佇列中的錄音及其保留的音訊。此動作無法還原。"
          }
        }
      }
    },
