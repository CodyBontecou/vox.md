    "Open Vox.md to run this recording action.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Vox.md لتنفيذ إجراء التسجيل هذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডিং অ্যাকশন চালাতে Vox.md খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Vox.md, um diese Aufnahmeaktion auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Vox.md to run this recording action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Vox.md para ejecutar esta acción de grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Vox.md pour exécuter cette action d’enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रिकॉर्डिंग कार्रवाई चलाने के लिए Vox.md खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Vox.md untuk menjalankan tindakan rekaman ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Vox.md per eseguire questa azione di registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音アクションを実行するには Vox.md を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음 동작을 실행하려면 Vox.md를 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Vox.md om deze opnameactie uit te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Vox.md, aby wykonać tę akcję nagrywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Vox.md para executar esta ação de gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Vox.md, чтобы выполнить это действие записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பதிவுச் செயலை இயக்க Vox.md-ஐத் திறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Vox.md เพื่อเรียกใช้การบันทึกนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıt eylemini çalıştırmak için Vox.md’yi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Vox.md, щоб виконати цю дію запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ریکارڈنگ کارروائی چلانے کے لیے Vox.md کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Vox.md để chạy tác vụ ghi âm này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Vox.md 以运行此录音操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Vox.md 以執行此錄音動作。"
          }
        }
      }
    },
    "Open Vox.md when recording. Background recording requires iOS 26+. Leave unset to keep this control's original behavior.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Vox.md عند التسجيل. يتطلب التسجيل في الخلفية iOS 26 أو أحدث. اتركه دون تعيين للحفاظ على السلوك الأصلي لعنصر التحكم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ড করার সময় Vox.md খুলুন। ব্যাকগ্রাউন্ড রেকর্ডিংয়ের জন্য iOS 26+ প্রয়োজন। এই কন্ট্রোলের মূল আচরণ রাখতে সেট না করে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md beim Aufnehmen öffnen. Hintergrundaufnahme erfordert iOS 26+. Nicht festlegen, um das ursprüngliche Verhalten dieser Steuerung beizubehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Vox.md when recording. Background recording requires iOS 26+. Leave unset to keep this control's original behavior."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Vox.md al grabar. La grabación en segundo plano requiere iOS 26 o posterior. Déjalo sin definir para mantener el comportamiento original de este control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Vox.md pendant l’enregistrement. L’enregistrement en arrière-plan nécessite iOS 26 ou version ultérieure. Laissez vide pour conserver le comportement d’origine de ce contrôle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड करते समय Vox.md खोलें। बैकग्राउंड रिकॉर्डिंग के लिए iOS 26+ चाहिए। इस कंट्रोल का मूल व्यवहार रखने के लिए सेट न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Vox.md saat merekam. Perekaman latar belakang memerlukan iOS 26+. Biarkan kosong untuk mempertahankan perilaku asli kontrol ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Vox.md durante la registrazione. La registrazione in background richiede iOS 26 o versioni successive. Lascia vuoto per mantenere il comportamento originale di questo controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音時に Vox.md を開きます。バックグラウンド録音には iOS 26 以降が必要です。未設定のままにすると、このコントロールの元の動作が保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음할 때 Vox.md를 엽니다. 백그라운드 녹음에는 iOS 26 이상이 필요합니다. 이 제어 항목의 원래 동작을 유지하려면 설정하지 마세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Vox.md bij het opnemen. Opnemen op de achtergrond vereist iOS 26+. Laat leeg om het oorspronkelijke gedrag van deze regelaar te behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwieraj Vox.md podczas nagrywania. Nagrywanie w tle wymaga iOS 26+. Pozostaw nieustawione, aby zachować pierwotne działanie tego elementu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o Vox.md ao gravar. A gravação em segundo plano requer iOS 26 ou posterior. Deixe sem definir para manter o comportamento original deste controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать Vox.md при записи. Запись в фоне требует iOS 26+. Оставьте пустым, чтобы сохранить исходное поведение этого элемента."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு செய்யும்போது Vox.md-ஐத் திறக்கவும். பின்னணிப் பதிவுக்கு iOS 26+ தேவை. இந்தக் கட்டுப்பாட்டின் அசல் நடத்தையை வைத்திருக்க அமைக்காமல் விடவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Vox.md เมื่อบันทึก การบันทึกเบื้องหลังต้องใช้ iOS 26 ขึ้นไป เว้นว่างไว้เพื่อคงการทำงานเดิมของตัวควบคุมนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt sırasında Vox.md’yi aç. Arka planda kayıt iOS 26+ gerektirir. Bu denetimin özgün davranışını korumak için ayarlamadan bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривати Vox.md під час запису. Запис у фоні потребує iOS 26+. Залиште незаданим, щоб зберегти початкову поведінку цього елемента."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈ کرتے وقت Vox.md کھولیں۔ بیک گراؤنڈ ریکارڈنگ کے لیے iOS 26+ درکار ہے۔ اس کنٹرول کا اصل رویہ برقرار رکھنے کے لیے سیٹ نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Vox.md khi ghi âm. Ghi âm nền cần iOS 26 trở lên. Để trống để giữ hành vi gốc của điều khiển này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音时打开 Vox.md。后台录音需要 iOS 26 或更高版本。不设置则保留此控制的原有行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音時打開 Vox.md。背景錄音需要 iOS 26 或以上版本。不設定則保留此控制項目的原有行為。"
          }
        }
      }
    },
