    "Notifications are off. Vox.md cannot alert you if an unattended Files delivery needs attention.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md لا يمكن أن تلقى إشعارات إذا كان تسليم الملفات غير المرخصة يحتاج إلى الاهتمام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞপ্তি বন্ধ হয়ে গেছে। Vox.md আপনি সতর্ক করতে পারবেন না যদি একটি অসামান্য ফাইলের ডেলিভারি মনোযোগ প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind deaktiviert. Vox.md kann Sie nicht warnen, wenn eine unbeaufsichtigte Dateien-Zustellung Aufmerksamkeit braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Vox.md cannot alert you if an unattended Files delivery needs attention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones se apagan. Vox.md No puede advertirle si una entrega de archivos no supervisada necesita atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont supprimées. Vox.md ne peut pas vous alerter si une livraison de fichiers non surveillée a besoin d'attention."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाएं बंद हो गई हैं। Vox.md आप नहीं जान सकते कि क्या एक अनदेखी फ़ाइल वितरण को ध्यान देने की आवश्यकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan sudah dihentikan. Vox.md tidak dapat memberi tahu Anda jika pengiriman File yang tidak diamankan membutuhkan perhatian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono spente. Vox.md Non è possibile avvisare se una consegna di file non sorvegliata richiede attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が切れてしまいました。 Vox.md 監視されていないファイルの配信が注意を必要とする場合に通知できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통지가 끊어졌습니다. Vox.md 감독되지 않은 파일 배달이 주의가 필요할 때 알릴 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificaties zijn uitgeschakeld. Vox.md kan u niet waarschuwen als een onbewaakte bestanden levering aandacht nodig heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone. Vox.md Nie możemy ostrzec, jeśli nieprzestrzegana dostawa plików wymaga uwagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desligadas. Vox.md Não é possível alertá-lo se uma entrega de arquivos não supervisionada precisa de atenção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотификации отключены . Vox.md не может предупредить вас, если незамеченная доставка файлов нуждается в внимании."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்புகள் வெளியிடப்பட்டுள்ளன. Vox.md ஒரு கணிசமான பதிவுகள் தேவை என்றால் நீங்கள் எச்சரிக்கை செய்ய முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนจะปิด Vox.md ไม่สามารถแจ้งเตือนคุณหากการส่งไฟล์ที่ไม่ได้รับการดูแลต้องการความสนใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haberler Dışarı çıktı. Vox.md Görevsiz dosya teslimatı dikkat gerektirir mi sizi uyaramaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення відключені Vox.md не може попередити вас, якщо безпідставний Доставка файлів потребує уваги."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹس بند ہو گئے ہیں. Vox.md آپ کو خبردار نہیں کر سکتے ہیں اگر ایک ناظرین فائلوں کی ترسیل پر توجہ کی ضرورت ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đã tắt. Vox.md không thể cảnh báo bạn nếu một giao hàng tệp không được giám sát cần sự chú ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。 Vox.md 不能提醒您,如果无人监督的文件交付需要注意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉。 Vox.md 不能提醒您,如果無人監督的文件交付需要注意。"
          }
        }
      }
    },
    "Now press a letter, number, Space, arrow, or function key to finish the shortcut.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن اضغط على كلمة، عدد، مساحة، ألقاب أو مفتاح العلامة التجارية لتكمل المفتاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন সংক্ষিপ্তটি শেষ করার জন্য একটি চিঠি, সংখ্যা, স্পেস, পাইল বা ফাংশন কী চাপুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie nun einen Buchstaben, eine Zahl, die Leertaste, eine Pfeil- oder Funktionstaste, um das Tastenkürzel abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now press a letter, number, Space, arrow, or function key to finish the shortcut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presione una letra, número, espacio, flecha o tecla de función para terminar el acortador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez maintenant sur une lettre, un nombre, un espace, une flèche ou une clé de fonction pour terminer le raccourci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब संक्षिप्त को पूरा करने के लिए एक पत्र, संख्या, स्पेस, तीर या फ़ंक्शन कुंजी दबाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang tekan huruf, angka, ruang, panah, atau tombol fungsi untuk menyelesaikan pendekatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora premere una lettera, un numero, uno spazio, una freccia o una chiave di funzione per completare la raccolta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、文字、数字、スペース、矢印、または関数キーを押して、ショートカットを完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 문자, 숫자, 공간, 화살표 또는 함수 키를 누르고 간단한 단계를 완료합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk nu op een letter, getal, ruimte, pijl of functie-toets om de snelkoppeling te voltooien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz naciśnij literę, liczbę, przestrzeń, strzałkę lub klucz funkcji, aby zakończyć skrót."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora pressione uma letra, número, espaço, seta ou tecla de função para terminar o atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь нажмите букву, число, пространство, стрелку или клавишу функции, чтобы закончить сокращение."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது ஒரு வேத, எண், Space, அலை அல்லது செயல்பாடு கிளிக் முடிவு செய்ய."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้กดตัวอักษรหมายเลขพื้นที่ปุ่มลูกศรหรือคีย์ฟังก์ชั่นเพื่อเสร็จสิ้นการสกัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi kısayolunu tamamlamak için bir harf, sayı, uzay, ok veya işlev tuşuna basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть клавішу літери, числа, простір, стрілку або функцію, щоб завершити коротку відгук."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اب ایک خط، نمبر، جگہ، پھاڑ یا تقریب کی کلید پر کلک کریں تا کہ جلد ختم ہو جائے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bây giờ nhấn một chữ cái, số, không gian, mũi tên hoặc phím chức năng để hoàn thành phím tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在,按一个字母、数字、空间、箭头或函数键来完成快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在,按一個字母、數字、空間、箭頭或函數鍵來完成快捷鍵。"
          }
        }
      }
    },
