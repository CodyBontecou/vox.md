    "Inline Entry Fields writes queryable `key:: value` lines with each entry, keeping rolling-note metadata separate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتب Fields Inline Entry خطات `key:: value` المختارة مع كل ورقة ، وحفظ البيانات المتحركة من الملاحظة منفصلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields লিখে থাকে queryable `key:: value` প্রত্যেকটি প্রবেশের সাথে সাথে, রুটিন-টোয়েন্টি মিটার আলাদা রাখুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline-Eintragsfelder schreibt bei jedem Eintrag abfragbare `key:: value`-Zeilen und hält Metadaten der Laufnotiz getrennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields writes queryable `key:: value` lines with each entry, keeping rolling-note metadata separate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace Inline Fields escribe queryable `key:: value` con cada entrada, Mantener los metadatos de la nota de rol separados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields écrit queryable `key:: value` avec chaque entrée, Mettre en place des méta-informations de rolling note."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields लिखता है queryable `key:: value` हर प्रवेश के साथ, रोलिंग नोट मेटाडेटा को अलग रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields menulis queryable `key:: value` dengan setiap entri, Menggunakan Metadata Rolling Note secara terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields scrive queryable `key:: value` con ogni ingresso, Metadati di rolling note separati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields writes queryable を参照 `key:: value` 各入口のラインは、 ローリングノートメタデータを分離する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields 는 쿼리 가능한 글을 쓰는 `key:: value` 각 항목에 대한 링크, 롤링 노트 메타데이터를 분리하여 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields schrijft queryable `key:: value` met elke ingang, Metadata van rolling-note afzonderlijk houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields pisze queryable `key:: value` z każdym wejściem, Metadane notatki rolling-note są oddzielone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields escreve queryable `key:: value` com cada entrada, Manter os metadados de nota de rolamento separados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля входа Inline Fields пишет queryable `key:: value` с каждой строкой входа, Сохранение метаданных rolling-note отдельно."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields - Queryable எழுதுகிறது `key:: value` ஒவ்வொரு வரிசையிலும், Rolling-Note MetaData ஐ தனித்து வைத்துக் கொள்ளவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields เขียน queryable `key:: value` เส้นกับแต่ละทางเข้า ปกป้องข้อมูลเมตาเดทแบบโรลลิง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields yazar queryable `key:: value` Her giriş ile ilgili, Rolling-Note metadata ayrılmak için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля входу в лінію Inline Entry Fields пише queryable `key:: value` з кожним входом, Розділяти метадані з рульових нот."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields لکھتا ہے queryable `key:: value` ہر داخلہ کے ساتھ خطوط رولنگ نوٹ میٹا ڈیٹا کو الگ رکھیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields viết queryable `key:: value` Các dòng với mỗi lối vào, Giữ các metadata rolling-note riêng biệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内线入口字段写查询可用 `key:: value` 每条线路,每条线路, 将滚动笔记元数据分开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內線入口字段寫查詢可用 `key:: value` 每條線路,每條線路, 將滾動筆記元數據分開。"
          }
        }
      }
    },
    "Inline Entry Fields writes the selected `key:: value` fields beside each captured entry. No frontmatter collection is written.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقوم حقول الإدخال المضمنة بكتابة حقول `key:: value` المحددة بجانب كل إدخال تم التقاطه. لم يتم كتابة أي مجموعة Frontmatter."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনলাইন এন্ট্রি ক্ষেত্রগুলি প্রতিটি ক্যাপচার করা এন্ট্রির পাশে নির্বাচিত `key:: value` ক্ষেত্রগুলিকে লেখে। কোন ফ্রন্টম্যাটার সংগ্রহ লেখা হয় না."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline-Eintragsfelder schreibt die ausgewählten `key:: value`-Felder neben jeden erfassten Eintrag. Es wird keine Frontmatter-Sammlung geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields writes the selected `key:: value` fields beside each captured entry. No frontmatter collection is written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Campos de entrada en línea escribe los campos `key:: value` seleccionados al lado de cada entrada capturada. No se escribe ninguna colección de temas iniciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields écrit les champs `key:: value` sélectionnés à côté de chaque entrée capturée. Aucune collection de frontmatters n’est écrite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनलाइन एंट्री फ़ील्ड प्रत्येक कैप्चर की गई प्रविष्टि के बगल में चयनित `key:: value` फ़ील्ड लिखती है। कोई फ्रंटमैटर संग्रह नहीं लिखा गया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bidang Entri Sebaris menulis bidang `key:: value` yang dipilih di samping setiap entri yang diambil. Tidak ada koleksi frontmatter yang ditulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Campi voce in linea scrive i campi `key:: value` selezionati accanto a ciascuna voce acquisita. Non viene scritta alcuna raccolta di argomenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インライン エントリ フィールドは、選択した `key:: value` フィールドをキャプチャされた各エントリの横に書き込みます。フロントマターコレクションは書き込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인라인 항목 필드는 캡처된 각 항목 옆에 선택한 `key:: value` 필드를 기록합니다. 서문 컬렉션이 작성되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields schrijft de geselecteerde `key:: value` velden naast elk vastgelegd item. Er is geen frontmatter-collectie geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields zapisuje wybrane pola `key:: value` obok każdego przechwyconego wpisu. Nie napisano żadnej kolekcji frontmatter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Campos de entrada embutidos gravam os campos `key:: value` selecionados ao lado de cada entrada capturada. Nenhuma coleção de frontmatter foi escrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные поля ввода записывают выбранные поля `key:: value` рядом с каждой захваченной записью. Сборник вставок не написан."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்லைன் என்ட்ரி ஃபீல்ட்ஸ் தேர்ந்தெடுக்கப்பட்ட `key:: value` புலங்களை ஒவ்வொரு கைப்பற்றப்பட்ட உள்ளீட்டின் அருகிலும் எழுதுகிறது. எந்த முன்னுரை சேகரிப்பும் எழுதப்படவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟิลด์รายการแบบอินไลน์จะเขียนฟิลด์ `key:: value` ที่เลือกไว้ข้างแต่ละรายการที่บันทึกไว้ ไม่มีการเขียนคอลเลกชัน frontmatter"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır İçi Giriş Alanları, seçilen `key:: value` alanlarını yakalanan her girişin yanına yazar. Hiçbir ön madde koleksiyonu yazılmamıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Entry Fields записує вибрані поля `key:: value` поруч із кожним записом. Збірка frontmatter не написана."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان لائن انٹری فیلڈز ہر کیپچر شدہ اندراج کے ساتھ منتخب کردہ `key:: value` فیلڈز لکھتا ہے۔ کوئی فرنٹ میٹر کلیکشن نہیں لکھا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trường nhập nội tuyến ghi các trường `key:: value` đã chọn bên cạnh mỗi mục nhập đã chụp. Không có bộ sưu tập frontmatter nào được viết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内联条目字段将选定的 `key:: value` 字段写入每个捕获的条目旁边。没有写前言集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內聯條目欄位將選定的 `key:: value` 欄位寫入每個捕獲的條目旁邊。沒有寫前言集。"
          }
        }
      }
    },
