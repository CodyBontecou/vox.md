    "Add Apple Family Sharing to your existing Unlimited purchase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف Apple Family Sharing إلى شراءك غير محدود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অস্তিত্বের অন্তর্ভুক্ত অ্যাপল পারিবারিক শেয়ারিং যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Apple Family Sharing zu Ihrem vorhandenen Unlimited-Kauf hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Apple Family Sharing to your existing Unlimited purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade Apple Family Sharing a tu compra de Unlimited existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le Partage Familial Apple à votre achat illimité existant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने मौजूदा असीमित खरीद में Apple Family Sharing जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan Apple Family Sharing ke pembelian Unlimited Anda yang ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la Condivisione Famiglia Apple all'acquisto Unlimited esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Family Sharing を既存の Unlimited 購入に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 가족 공유를 기존 무제한 구매에 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg Apple Family Sharing toe aan uw bestaande Onbeperkte aankoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj funkcję Apple Family Sharing do istniejącego zakupu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a Compartilhamento Familiar da Apple à sua compra existente de Compartilhamento Sem Limitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте Apple Family Sharing к существующей покупке."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Family Sharing உங்கள் இப்போது உள்ள Unlimited வாங்கிய சேவைக்கு சேர்க்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มการแชร์ Apple Family ไปยังการซื้อ Unlimited ที่คุณมีอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Aile Paylaşımı mevcut Sınırsız satın alma işleminize ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте Apple Family Sharing до існуючої покупки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple خاندان اشتراک کو آپ کے موجودہ غیر محدود خریداری میں شامل کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm Apple Family Sharing vào Mua hàng Không giới hạn hiện có của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Apple 家庭共享添加到现有的无限购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Apple 家庭共享添加到現有的無限購買。"
          }
        }
      }
    },
    "Add Apple Family Sharing to your existing lifetime Unlimited purchase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف Apple Family Sharing إلى شراءك الحالي لمدة حياتك غير محدودة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাপল ফ্যামিলি শেয়ারিং অন্তর্ভুক্ত করুন আপনার বিদ্যমান লাইফলাইফ অসীম ক্রয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Apple Family Sharing zu Ihrem bestehenden Unlimited-Lebenszeitkauf hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Apple Family Sharing to your existing lifetime Unlimited purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade Apple Family Sharing a tu compra de una oferta de vida ilimitada existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le Partage Familial Apple à votre achat existant d'une durée de vie illimitée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने मौजूदा जीवनकाल असीमित खरीद में Apple परिवार साझा करना जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan Apple Family Sharing ke pembelian Unlimited yang ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la Condivisione Famiglia Apple all'acquisto di un'acquisto illimitata per tutta la vita esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Family Sharing を既存のライフスタイル無制限購入に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 가족 공유를 기존 평생 무제한 구매에 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg Apple Family Sharing toe aan uw bestaande levenslange Onbeperkte aankoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj funkcję Apple Family Sharing do istniejącego zakupu na całe życie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o Apple Family Sharing à sua compra existente de Unlimited."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте Apple Family Sharing к существующей покупке по сроку действия."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Family Sharing உங்கள் வாழ்நாள் முழுவதும் Unlimited வாங்கியதுக்கு சேர்க்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มการแชร์ Apple Family ไปยังการซื้อ Unlimited อายุการใช้งานที่อยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Aile Paylaşımı mevcut ömür boyu Sınırsız satın alma işleminize ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте Apple Family Sharing до існуючої покупки без обмежень на життя."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple خاندان اشتراک کو آپ کی موجودہ زندگی کے لامحدود خریداری میں شامل کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm Apple Family Sharing vào mua hàng Không giới hạn suốt đời hiện có của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Apple 家庭共享添加到现有的终身无限购买中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Apple 家庭共享添加到現有的終身無限購買中。"
          }
        }
      }
    },
