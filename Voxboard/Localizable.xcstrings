          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps typed Markdown, OCR, and voice text exactly as captured. Static frontmatter and route settings still apply."
          }
        },
        "es": {
          "stringUnit": {
