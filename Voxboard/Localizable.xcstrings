    "iPhone could not save the transfer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone لم يتمكن من حفظ التحويل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone তবে ট্রান্সফার বাঁচাতে পারেননি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone konnte die Übertragung nicht sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone could not save the transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone No pudo salvar el traslado."
          }
        },
