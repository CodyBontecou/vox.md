    "Turns captured tasks into `- [ ]` Markdown checklist items without inventing new tasks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل المهام المكتوبة إلى عناصر قائمة `- [ ]` Markdown دون اختراع المهام الجديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জড়িত কাজগুলোকে বদলে দেয় `- [ ]` Markdown নতুন কাজের সন্ধান না করে চেকলিস্ট আইটেম।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelt erfasste Aufgaben in `- [ ]`-Markdown-Checklistenpunkte um, ohne neue Aufgaben zu erfinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns captured tasks into `- [ ]` Markdown checklist items without inventing new tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma las tareas capturadas en `- [ ]` Markdown Elementos de la lista de verificación sin inventar nuevas tareas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformer les tâches en `- [ ]` Markdown Les éléments de la liste de contrôle sans inventer de nouvelles tâches."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संभालने वाले कार्यों को बदलते हैं `- [ ]` Markdown नए कार्यों का आविष्कार किए बिना चेकलिस्ट आइटम।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah tugas yang ditempuh menjadi `- [ ]` Markdown Daftar item tanpa menemukan tugas baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "trasforma i compiti in `- [ ]` Markdown Elenco di controlli senza inventare nuovi compiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "捕獲されたタスクを変える `- [ ]` Markdown 新しいタスクを発明することなくチェックリストの項目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처된 작업을 변환 `- [ ]` Markdown 새로운 작업을 발명하지 않고 체크리스트 항목."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang de opgaven die in `- [ ]` Markdown Checklist items zonder het uitvinden van nieuwe taken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekształca zadania w `- [ ]` Markdown Zadanie jest bez wymyślania nowych zadań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformar tarefas capturadas em `- [ ]` Markdown Eles são listados sem inventar novas tarefas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превращает захваченные задачи в `- [ ]` Markdown Перечень элементов без изобретения новых задач."
          }
        },
        "ta": {
