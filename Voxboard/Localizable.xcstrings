    "Configure a destination for a Capture Preset in Vox.md before running this shortcut.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديد وجهة موجهة لـ Capture Preset في Vox.md قبل إجراء هذا المساعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ক্যাপচার প্রাক সেটের জন্য একটি গন্তব্য কনফিগার করুন Vox.md এই ছোট্ট হওয়ার আগে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie ein Ziel für ein Aufnahme-Preset in Vox.md, bevor Sie diesen Kurzbefehl ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure a destination for a Capture Preset in Vox.md before running this shortcut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar un destino para una Predefinición de captura en Vox.md antes de realizar este recorte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurer une destination pour un Préfet de capture dans Vox.md avant de courir ce raccourci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक कैप्चर पूर्वानुमान के लिए एक गंतव्य सेट करें Vox.md इस छूट को लेकर आगे बढ़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur tujuan untuk Capture Preset di Vox.md Sebelum melakukan pendekatan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurare una destinazione per un Preset di cattura in Vox.md prima di uscire da questa corsa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャプレセットの目的地を設定する Vox.md この短縮を踏み出す前に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 미리 설정에 대한 목적지를 구성합니다.Configure a destination for a Capture Preset in Vox.md 이 짧은 길을 걷기 전에"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bestemming instellen voor een Capture Preset in Vox.md Voordat je deze snelkoppeling gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurowanie miejsca docelowego w celu przechwycenia Vox.md Przed rozpoczęciem tej skrótów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar um destino para uma Predefinição de captura em Vox.md antes de fazer esse corte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте место назначения для предварительного настройки Vox.md Перед тем как сделать этот сокращение."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு இலக்கியத்தில் ஒரு முகவரி எழுதப்பட்டால் Vox.md இந்த குழப்பத்தை முன்வைக்கும் போது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กําหนดเป้าหมายสําหรับ Capture Preet ใน Vox.md ก่อนที่จะเรียกใช้สั้น ๆ นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Capture Preset için bir hedefe ayarlayın Vox.md Bu kısaltmayı yapmadan önce"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштувати призначення для попереднього захоплення в Vox.md Перед тим, як запустити цей короткий"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک مقصد کو ترتیب دیں Capture Preet Vox.md اس مختصر وقت کے بعد"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết lập một điểm đến cho một Capture Preset trong Vox.md Trước khi chạy đoạn ngắn này."
          }
        },
        "zh-Hans": {
