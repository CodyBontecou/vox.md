    "Location access is off. Enable it in Settings to add location metadata.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الموقع معطل. قم بتمكينه في الإعدادات لإضافة البيانات الوصفية للموقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান অ্যাক্সেস বন্ধ আছে. অবস্থান মেটাডেটা যোগ করতে সেটিংসে এটি সক্ষম করুন৷"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff ist deaktiviert. Aktivieren Sie ihn in den Einstellungen, um Standortmetadaten hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off. Enable it in Settings to add location metadata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación está desactivado. Habilítelo en Configuración para agregar metadatos de ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la localisation est désactivé. Activez-le dans Paramètres pour ajouter des métadonnées de localisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान पहुंच बंद है. स्थान मेटाडेटा जोड़ने के लिए इसे सेटिंग्स में सक्षम करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses lokasi tidak aktif. Aktifkan di Pengaturan untuk menambahkan metadata lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla posizione è disattivato. Abilitalo in Impostazioni per aggiungere metadati sulla posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報へのアクセスがオフになっています。設定で有効にして位置メタデータを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 액세스가 사용 중지되었습니다. 위치 메타데이터를 추가하려면 설정에서 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatietoegang is uitgeschakeld. Schakel dit in Instellingen in om locatiemetagegevens toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do lokalizacji jest wyłączony. Włącz tę opcję w Ustawieniach, aby dodać metadane lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao local está desativado. Ative-o em Configurações para adicionar metadados de localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к местоположению отключен. Включите его в настройках, чтобы добавить метаданные о местоположении."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருப்பிட அணுகல் முடக்கப்பட்டுள்ளது. இருப்பிட மெட்டாடேட்டாவைச் சேர்க்க, அமைப்புகளில் அதை இயக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงตำแหน่งปิดอยู่ เปิดใช้งานในการตั้งค่าเพื่อเพิ่มข้อมูลเมตาของตำแหน่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum erişimi kapalı. Konum meta verileri eklemek için bunu Ayarlar'da etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до місцезнаходження вимкнено. Увімкніть його в налаштуваннях, щоб додати метадані про місцезнаходження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام تک رسائی بند ہے۔ مقام کا میٹا ڈیٹا شامل کرنے کے لیے اسے سیٹنگز میں فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập vị trí bị tắt. Kích hoạt nó trong Cài đặt để thêm siêu dữ liệu vị trí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置访问已关闭。在“设置”中启用它以添加位置元数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置存取已關閉。在“設定”中啟用它以新增位置元資料。"
          }
        }
      }
    },
    "Location access is off. Enable it in Settings to use Current Location.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off. Enable it in Settings to use Current Location."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الموقع متوقف. فعّله في الإعدادات لاستخدام الموقع الحالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান অ্যাক্সেস বন্ধ আছে। বর্তমান অবস্থান ব্যবহার করতে সেটিংসে এটি চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff ist deaktiviert. Aktiviere ihn in den Einstellungen, um den aktuellen Standort zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación está desactivado. Actívalo en Ajustes para usar la ubicación actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la localisation est désactivé. Activez-le dans Réglages pour utiliser la localisation actuelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान एक्सेस बंद है। वर्तमान स्थान का उपयोग करने के लिए इसे सेटिंग्स में चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses lokasi nonaktif. Aktifkan di Pengaturan untuk menggunakan Lokasi Saat Ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso alla posizione è disattivato. Attivalo in Impostazioni per usare la posizione corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報へのアクセスがオフです。現在地を使用するには「設定」で有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 접근이 꺼져 있습니다. 현재 위치를 사용하려면 설정에서 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatietoegang is uitgeschakeld. Schakel deze in bij Instellingen om Huidige locatie te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do lokalizacji jest wyłączony. Włącz go w Ustawieniach, aby używać bieżącej lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à localização está desativado. Ative-o nos Ajustes para usar a localização atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к геопозиции отключен. Включите его в Настройках, чтобы использовать текущее местоположение."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருப்பிட அணுகல் முடக்கப்பட்டுள்ளது. தற்போதைய இருப்பிடத்தைப் பயன்படுத்த அமைப்புகளில் அதை இயக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการเข้าถึงตำแหน่งอยู่ เปิดใช้ในการตั้งค่าเพื่อใช้ตำแหน่งปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum erişimi kapalı. Mevcut Konumu kullanmak için Ayarlar'da etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до геопозиції вимкнено. Увімкніть його в Параметрах, щоб використовувати поточне місцезнаходження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام تک رسائی بند ہے۔ موجودہ مقام استعمال کرنے کے لیے اسے ترتیبات میں فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập vị trí đang tắt. Hãy bật trong Cài đặt để sử dụng vị trí hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置访问已关闭。请在“设置”中启用，以使用当前位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置取用已關閉。請在「設定」中啟用，以使用目前位置。"
          }
        }
      }
    },
    "Location is requested once at Capture send or recording stop. Exact keeps the origin fix; City rounds coordinates and omits a point-of-interest label. Vox.md does not track location in the background.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم طلب الموقع مرة واحدة عند إيقاف الإرسال أو التسجيل. بالضبط يحافظ على إصلاح الأصل؛ تقوم جولات المدينة بالتنسيق وتحذف تسمية نقطة الاهتمام. Vox.md لا يتتبع الموقع في الخلفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার পাঠাতে বা রেকর্ডিং স্টপে একবার অবস্থানের অনুরোধ করা হয়। সঠিক উৎপত্তি ঠিক রাখে; সিটি রাউন্ডগুলি স্থানাঙ্ক করে এবং একটি পয়েন্ট-অফ-ইন্টারেস্ট লেবেল বাদ দেয়। Vox.md ব্যাকগ্রাউন্ডে অবস্থান ট্র্যাক করে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort wird einmal beim Senden der Erfassung oder beim Stoppen der Aufnahme abgefragt. „Exakt“ behält die Ursprungsfixierung; „Stadt“ rundet Koordinaten und lässt die POI-Bezeichnung weg. Vox.md verfolgt den Standort nicht im Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is requested once at Capture send or recording stop. Exact keeps the origin fix; City rounds coordinates and omits a point-of-interest label. Vox.md does not track location in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación se solicita una vez al enviar la captura o al detener la grabación. Exact mantiene la corrección del origen; La ciudad redondea las coordenadas y omite una etiqueta de punto de interés. Vox.md no rastrea la ubicación en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est demandée une fois à l'envoi de la capture ou à l'arrêt de l'enregistrement. Exact conserve le correctif d'origine ; La ville arrondit les coordonnées et omet une étiquette de point d'intérêt. Vox.md ne suit pas l'emplacement en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर सेंड या रिकॉर्डिंग स्टॉप पर एक बार स्थान का अनुरोध किया जाता है। सटीक मूल को स्थिर रखता है; शहर का दौर समन्वय करता है और रुचि के बिंदु वाले लेबल को हटा देता है। Vox.md पृष्ठभूमि में स्थान को ट्रैक नहीं करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi diminta satu kali saat pengiriman Tangkap atau penghentian perekaman. Exact mempertahankan asal tetap; Putaran kota mengoordinasikan dan menghilangkan label tempat menarik. Vox.md tidak melacak lokasi di latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione viene richiesta una volta all'invio della cattura o all'interruzione della registrazione. Esatto mantiene la correzione dell'origine; La città arrotonda le coordinate e omette l'etichetta del punto di interesse. Vox.md non tiene traccia della posizione in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報はキャプチャ送信時または録画停止時に一度要求されます。 Exact は原点の修正を維持します。市は座標を四捨五入し、POI ラベルを省略します。 Vox.md はバックグラウンドで位置を追跡しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 전송 또는 녹음 중지 시 위치가 한 번 요청됩니다. Exact는 원점 수정을 유지합니다. 도시 라운드는 관심 지점 라벨을 조정하고 생략합니다. Vox.md는 백그라운드에서 위치를 추적하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie wordt één keer gevraagd bij het verzenden of stoppen van de opname. Exact behoudt de oorsprongsfix; Stad rondt de coördinaten af ​​en laat een point-of-interest-label weg. Vox.md houdt de locatie niet bij op de achtergrond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytanie o lokalizację jest wysyłane raz w momencie wysyłania przechwytywania lub zatrzymania nagrywania. Funkcja Dokładna zachowuje stałe pochodzenie; Miasto zaokrągla współrzędne i pomija etykietę interesującego miejsca. Vox.md nie śledzi lokalizacji w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização é solicitada uma vez no envio do Capture ou na parada da gravação. Exato mantém a correção da origem; As rondas da cidade coordenam e omitem um rótulo de ponto de interesse. Vox.md não rastreia a localização em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение запрашивается один раз при отправке Capture или остановке записи. Exact сохраняет исходное положение; Координаты по городу округляются, а метка достопримечательности отсутствует. Vox.md не отслеживает местоположение в фоновом режиме."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேப்சர் சென்ட் அல்லது ரெக்கார்டிங் நிறுத்தத்தில் ஒருமுறை இருப்பிடம் கோரப்பட்டது. துல்லியமான தோற்றம் பிழைத்திருத்தம் வைத்திருக்கிறது; நகர சுற்றுகள் ஒருங்கிணைக்கிறது மற்றும் ஆர்வமுள்ள லேபிளைத் தவிர்க்கிறது. Vox.md பின்னணியில் இருப்பிடத்தைக் கண்காணிக்காது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการขอตำแหน่งหนึ่งครั้งเมื่อส่งการจับภาพหรือหยุดการบันทึก แน่นอนเก็บการแก้ไขต้นกำเนิด พิกัดรอบเมืองและละเว้นป้ายกำกับจุดสนใจ Vox.md ไม่ติดตามตำแหน่งในเบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama gönderme veya kayıt durdurma sırasında konum bir kez istenir. Exact, kökeni sabit tutar; Şehir koordinatları yuvarlar ve ilgi çekici nokta etiketini çıkarır. Vox.md arka planda konumu izlemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місцезнаходження запитується один раз під час надсилання або зупинки запису. Точний зберігає виправлення походження; Місто об’їжджає координати та пропускає позначку об’єкта інтересу. Vox.md не відстежує місцезнаходження у фоновому режимі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر بھیجنے یا ریکارڈنگ اسٹاپ پر ایک بار مقام کی درخواست کی جاتی ہے۔ عین مطابق اصل کو درست رکھتا ہے۔ سٹی راؤنڈز کوآرڈینیٹ کرتے ہیں اور دلچسپی کا ایک لیبل چھوڑ دیتے ہیں۔ Vox.md پس منظر میں مقام کو ٹریک نہیں کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí được yêu cầu một lần tại điểm dừng gửi hoặc ghi. Chính xác giữ nguyên bản gốc; Thành phố điều phối vòng quanh và bỏ qua nhãn điểm ưa thích. Vox.md không theo dõi vị trí ở chế độ nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在捕获发送或记录停止时请求一次位置。精确保持原点固定；城市对坐标进行四舍五入并省略兴趣点标签。 Vox.md 不会在后台跟踪位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在捕獲發送或記錄停止時請求一次位置。精確保持原點固定；城市對座標進行四捨五入並省略興趣點標籤。 Vox.md 不會在後台追蹤位置。"
          }
        }
      }
    },
    "Location is unavailable. Open Vox.md to send this exact Capture without location or discard it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع غير متاح. افتح Vox.md لإرسال هذا الالتقاط الدقيق بدون موقع أو تجاهله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান অনুপলব্ধ. অবস্থান ছাড়া এই সঠিক ক্যাপচার পাঠাতে বা এটি বাতিল করতে Vox.md খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort ist nicht verfügbar. Öffnen Sie Vox.md, um genau diese Aufnahme ohne Standort zu senden oder sie zu verwerfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is unavailable. Open Vox.md to send this exact Capture without location or discard it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación no está disponible. Abra Vox.md para enviar esta captura exacta sin ubicación o deséchela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement n'est pas disponible. Ouvrez Vox.md pour envoyer cette capture exacte sans localisation ou jetez-la."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान अनुपलब्ध है. इस सटीक कैप्चर को बिना स्थान के भेजने या इसे त्यागने के लिए Vox.md खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi tidak tersedia. Buka Vox.md untuk mengirim Tangkapan persis ini tanpa lokasi atau membuangnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione non è disponibile. Apri Vox.md per inviare questa cattura esatta senza posizione o scartarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報が利用できません。 Vox.md を開いて、この正確なキャプチャを場所なしで送信するか、破棄します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 확인할 수 없습니다. Vox.md를 열어 위치 없이 정확한 캡처를 보내거나 폐기하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie is niet beschikbaar. Open Vox.md om deze exacte opname zonder locatie te verzenden of te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja jest niedostępna. Otwórz Vox.md, aby wysłać dokładnie to przechwycenie bez lokalizacji lub odrzuć je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização não está disponível. Abra Vox.md para enviar esta captura exata sem localização ou descartá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение недоступно. Откройте Vox.md, чтобы отправить этот точный захват без указания местоположения, или удалите его."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடம் கிடைக்கவில்லை. இந்த துல்லியமான படப்பிடிப்பை இருப்பிடம் இல்லாமல் அனுப்ப அல்லது நிராகரிக்க Vox.md ஐத் திறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งไม่พร้อมใช้งาน เปิด Vox.md เพื่อส่งการจับภาพที่แน่นอนนี้โดยไม่มีตำแหน่งหรือทิ้งไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum kullanılamıyor. Bu Yakalamayı konum olmadan göndermek veya atmak için Vox.md'yi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місцезнаходження недоступне. Відкрийте Vox.md, щоб надіслати цей точний запис без місцезнаходження або відкинути його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام دستیاب نہیں ہے۔ اس عین مطابق کیپچر کو مقام کے بغیر بھیجنے یا اسے ضائع کرنے کے لیے Vox.md کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí không có sẵn. Mở Vox.md để gửi Bản chụp chính xác này mà không có vị trí hoặc loại bỏ nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置不可用。打开 Vox.md 发送这个没有位置的精确捕获或丢弃它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置不可用。打開 Vox.md 發送這個沒有位置的精確捕獲或丟棄它。"
          }
        }
      }
    },
