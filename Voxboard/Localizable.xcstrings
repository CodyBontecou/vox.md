    },
    "The M4A is retained safely for Files retry": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم حفظ M4A بأمان لإنشاء ملفات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এ M4A ফাইল রিট্রি জন্য নিরাপদে সংরক্ষিত"
          }
        },
        "de": {
