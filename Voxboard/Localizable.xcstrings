            "value": "Kasanızdaki not değiştirilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотатка у сховищі не зміниться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے والٹ میں موجود نوٹ تبدیل نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
