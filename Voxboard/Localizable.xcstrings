            "state": "translated",
            "value": "Vox.md necesitan permiso para guardar notas para el \"%@“Captura de precaución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md besoin d'autorisation pour enregistrer des notes pour le \"%@« Précédent Capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md नोटों को बचाने के लिए अनुमति की आवश्यकता है \"%@“पेटिंग सेट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md membutuhkan izin untuk menyimpan catatan untuk \"%@“Pengambilan yang sudah ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md bisogno di permesso per salvare le note per il \"%@“Cattura di preset."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md メモを保存するための許可が必要です」%@「キャプチャを予想する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 메모를 저장할 수 있는 권한이 필요합니다. needs permission to save notes for the \"%@“전제로 잡아라."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md behoefte aan toestemming om notities op te slaan voor de \"%@“De voorlopige opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md potrzebujesz uprawnień do zapisania notatek dla \"%@„Przedstawienie do przechwytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md necessita de permissão para salvar notas para o \"%@“Apresentar o pré-requisito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md нужны разрешения для сохранения записей для \"%@«Захват предварительно."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md தேவைப்பட்ட பதிவுகளை எழுதுவதற்கு அனுமதி தேவை »%@“முதலில் கட்டிட"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ต้องการอนุญาตในการบันทึกบันทึกสําหรับ \"%@“จับตัวตั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Notlar için izin almanız gerekiyor\"%@“Öncelikle yakalamak lazım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md потрібна дозвіл для збереження записів для \"%@«Захоплення попереднього."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md \"مجھے نوٹ محفوظ کرنے کی اجازت ہے\"%@“پرسٹ پیش کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md cần quyền lưu ghi chú cho \"%@“Chiếm được trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 需要允许保存笔记“%@“抓住预先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 需要允許保存筆記“%@“抓住預先。"
          }
        }
      }
    },
