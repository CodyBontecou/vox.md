    "Check your connection and endpoint before retrying.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الاتصال ونقطة النهاية قبل إعادة المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার চেষ্টা করার আগে আপনার সংযোগ ও এন্ডপয়েন্ট পরীক্ষা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie Ihre Verbindung und den Endpunkt, bevor Sie es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and endpoint before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión y el punto de conexión antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et le point de terminaison avant de réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से प्रयास करने से पहले अपना कनेक्शन और एंडपॉइंट जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa koneksi dan endpoint Anda sebelum mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la connessione e l’endpoint prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行する前に、接続とエンドポイントを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시도하기 전에 연결 상태와 엔드포인트를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer je verbinding en eindpunt voordat je het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie i punkt końcowy przed ponowieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua conexão e o endpoint antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед повтором проверьте подключение и адрес."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் முயற்சிக்கும் முன் உங்கள் இணைப்பையும் முனைப்புள்ளியையும் சரிபார்க்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการเชื่อมต่อและปลายทางก่อนลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden denemeden önce bağlantınızı ve uç noktanızı denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед повтором перевірте з’єднання та адресу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ کوشش سے پہلے اپنا کنکشن اور اینڈ پوائنٹ چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra kết nối và điểm cuối trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试前请检查你的网络连接和端点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試前請檢查你的網路連線和端點。"
          }
        }
      }
    },
