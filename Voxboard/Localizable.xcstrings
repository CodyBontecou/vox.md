          "stringUnit": {
            "state": "translated",
            "value": "Model di perangkat tidak dapat mendeskripsikan gambar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello sul dispositivo non può descrivere le immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上のモデルは画像を説明できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 모델이 이미지를 설명할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model op het apparaat kan geen afbeeldingen beschrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model na urządzeniu nie może opisywać obrazów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo no dispositivo não pode descrever imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель на устройстве не может описывать изображения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதனத்தில் உள்ள மாதிரியால் படங்களை விவரிக்க முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลบนอุปกรณ์ไม่สามารถอธิบายรูปภาพได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıttaki model görüntüleri açıklayamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель на пристрої не може описувати зображення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیوائس پر موجود ماڈل تصاویر کی وضاحت نہیں کر سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình trên thiết bị không thể mô tả ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端模型无法描述图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置端模型無法描述影像。"
          }
        }
      }
    },
    "The on-device transcript will be added to this durable draft.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إضافة الترجمة على الجهاز إلى هذا المشروع المستمر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই স্থায়ী নকশাতে ডিভাইসের ট্রান্সক্রিপ্ট যোগ করা হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die auf dem Gerät vorhandene Transkription wird zu diesem dauerhaften Entwurf hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device transcript will be added to this durable draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en el dispositivo se añadirá a este proyecto duradero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription sur l'appareil sera ajoutée à ce projet durable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्थायी प्रिंटिंग में डिवाइस ट्रांसक्रिप्ट जोड़ा जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript pada perangkat akan ditambahkan ke draft yang tahan lama ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione sul dispositivo sarà aggiunta a questo progetto duraturo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上のトランスクリプトは、この持続可能な草案に追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장치에 있는 번역본은 이 지속적인 초안에 추가될 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transcript op het apparaat wordt toegevoegd aan dit duurzame ontwerp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript na urządzeniu zostanie dodany do tego trwałego projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição no dispositivo será adicionada a este projeto duradouro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт на устройстве будет добавлен в этот долговечный проект."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஆவணத்தின் அடிப்படையில் இந்த ஆவணத்தைப் பதிவு செய்யலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถ่ายภาพบนอุปกรณ์จะถูกเพิ่มลงในโครงการนี้ที่ทนทาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazın içindeki transkripsiyon bu kalıcı taslakta eklenecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт на пристрої буде додано до цього довготривалого проекту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس طویل مدتی منصوبے میں آلہ پر ٹرانسفر شامل کیا جائے گا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản ghi trên thiết bị sẽ được thêm vào bản thảo lâu dài này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备上的转录将添加到这个持久草案中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設備上的轉錄將添加到這個持久草案中。"
          }
        }
      }
    },
    "The previous recording is still safely attached. Remove it from the draft before retrying.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إزالة الملف من النسخة السابقة قبل إعادة إزالتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্ববর্তী রেকর্ডটি নিরাপদে সংযুক্ত রয়েছে. পুনরায় রেকড করার আগে এটি নকশা থেকে মুছে ফেলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorherige Aufnahme ist noch sicher angehängt. Entfernen Sie sie aus dem Entwurf, bevor Sie es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous recording is still safely attached. Remove it from the draft before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación anterior sigue siendo adjuntada de forma segura. Retire la grabación del proyecto antes de volver a trabajar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement précédent est toujours relié en toute sécurité. Retirez-le du dessin avant de le réécrire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले की रिकॉर्डिंग सुरक्षित रूप से जुड़ी हुई है. इसे पुनः संपादन करने से पहले प्रीस्करण से हटा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman sebelumnya masih aman ditempelkan. Hapus dari rancangan sebelum mengulanginya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione precedente è ancora saldamente allegata. Rimuovela dal progetto prima di ripetere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の録音はまだ安全に付属しています。再読み直す前に、草案から削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 녹음은 여전히 안전하게 붙여져 있습니다. 다시 녹음하기 전에 텍스트에서 제거합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vorige opname is nog steeds veilig bevestigd. Verwijder deze uit de ontwerpbalk voordat u opnieuw gaat werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzedni nagrywarka jest nadal bezpiecznie dołączona. Usuń ją z projektu przed ponownym przetwarzaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação anterior ainda está seguramente anexada. Remova-a do projeto antes de reaproveitá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущая запись все еще надежно прикреплена. Удалите ее из проекта перед повторным обработкой."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous articleதமிழ்நாட்டில் உள்ள பத்திரிகையாளர்கள், கட்சிகளின் ஆலோசனைகளை முன்னெடுக்க வேண்டும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกก่อนหน้านี้ยังคงติดอยู่ได้อย่างปลอดภัย ลบออกจากวาดภาพก่อนที่จะรีด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki kayıt hala güvenli bir şekilde takılı kalmıştır. Yeniden çalıştırmadan önce taslaktan çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередній запис все ще безпечно прикріплений. Видалити його з проекту перед повторним переглядом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous ڈیزائن کا استعمال کریں اور دوبارہ شروع کرنے سے پہلے اسے ڈیزائن سے ہٹا دیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi trước vẫn được gắn an toàn. Xóa nó khỏi bản thảo trước khi tái xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以前的录音仍然安全地附加,请在重新处理之前从草案中删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以前的錄音仍然安全地附加,請在重新處理之前從草案中刪除。"
          }
        }
      }
    },
    "The recording could not be attached to the Capture draft.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إدخال المقطع إلى مشروع Capture."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডটি ক্যাপচার নথিতে যোগ করা যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht an den Erfassungsentwurf angehängt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording could not be attached to the Capture draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación no pudo ser adjuntada al proyecto de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement ne pouvait pas être joint au projet de capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्ड को कैप्चर परियोजना के साथ जोड़ा नहीं जा सकता था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tidak dapat disambungkan ke Rencana Capture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione non poteva essere allegata al progetto di Captura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音はキャプチャープロジェクトに付加されなかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 Capture draft에 첨부할 수 없었다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname kon niet worden gehecht aan het Capture-ontwerp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania nie mogły być dołączone do projektu Capture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação não poderia ser anexada ao projeto de capture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись не могла быть приложена к проекту Capture."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த படத்தை Capture draft இல் இணைக்க முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกไม่สามารถแนบมากับโครงการ Capture"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıt, Capture taslakına eklenemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис не міг бути прикріплений до проекту Capture."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کی ریکارڈنگ کو قبضہ منصوبہ پر شامل نہیں کیا جا سکتا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc ghi âm không thể được đính kèm vào dự thảo Capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音不能附加到捕获草案中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音不能附加到捕獲草案中。"
          }
        }
      }
    },
    "The recording could not be encoded.": {
