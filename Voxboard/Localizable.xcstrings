          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sejf lub folder i określ, gdzie ta trasa zapisuje pliki Markdown."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um cofre ou pasta e defina onde esta rota escreve o Markdown."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите хранилище или папку и укажите, куда этот маршрут записывает Markdown."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு களஞ்சியம் அல்லது கோப்புறையைத் தேர்ந்தெடுத்து, இந்த வழித்தடம் Markdown ஐ எங்கு எழுதுகிறது என்பதை வரையறுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกวอลต์หรือโฟลเดอร์ และกำหนดตำแหน่งที่เส้นทางนี้จะเขียน Markdown"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
