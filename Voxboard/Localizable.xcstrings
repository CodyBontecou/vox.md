        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canceled because the route requires an origin-time location"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelada porque la ruta requiere la ubicación del momento de origen"
