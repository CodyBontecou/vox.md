    "Unlimited Capture. Private, on-device transcription. Your words, in your own Markdown files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited Capture. Private, on-device transcription. Your words, in your own Markdown files."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقاط غير محدود. النسخ الخاص على الجهاز. كلماتك، في ملفات Markdown الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনলিমিটেড ক্যাপচার। ব্যক্তিগত, ডিভাইসে ট্রান্সক্রিপশন। আপনার কথা, আপনার নিজের Markdown ফাইলে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzte Aufnahme. Private Transkription auf dem Gerät. Ihre Worte, in Ihren eigenen Markdown Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura ilimitada. Transcripción privada en el dispositivo. Tus palabras, en tus propios archivos Markdown ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture illimitée. Transcription privée sur l'appareil. Vos mots, dans vos propres fichiers Markdown ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असीमित कब्जा. निजी, ऑन-डिवाइस ट्रांसक्रिप्शन। आपके शब्द, आपकी अपनी Markdown फ़ाइलों में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan Tanpa Batas. Transkripsi pribadi di perangkat. Kata-kata Anda, dalam file Markdown Anda sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cattura illimitata. Trascrizione privata sul dispositivo. Le tue parole, nei tuoi file Markdown ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限のキャプチャ。プライベートなオンデバイス文字起こし。あなたの言葉をあなた自身のMarkdownファイルに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무제한 캡처. 비공개, 기기 내 전사. 귀하의 Markdown 파일에 귀하의 단어가 포함되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbeperkte opname. Privétranscriptie op het apparaat. Jouw woorden, in je eigen Markdown bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieograniczone przechwytywanie. Prywatna transkrypcja na urządzeniu. Twoje słowa we własnych plikach Markdown ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura ilimitada. Transcrição privada no dispositivo. Suas palavras, em seus próprios arquivos Markdown ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неограниченный захват. Частная транскрипция на устройстве. Ваши слова в ваших собственных файлах Markdown ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரம்பற்ற பிடிப்பு. தனிப்பட்ட, சாதனத்தில் டிரான்ஸ்கிரிப்ஷன். உங்கள் சொந்த Markdown கோப்புகளில் உங்கள் வார்த்தைகள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับภาพได้ไม่จำกัด การถอดเสียงแบบส่วนตัวบนอุปกรณ์ คำพูดของคุณในไฟล์ Markdown ของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırsız Yakalama. Özel, cihaz üzerinde transkripsiyon. Kendi Markdown dosyalarınızdaki sözleriniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необмежене захоплення. Приватна транскрипція на пристрої. Ваші слова у ваших власних файлах Markdown ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لامحدود کیپچر۔ پرائیویٹ، آن ڈیوائس ٹرانسکرپشن۔ آپ کے الفاظ، آپ کی اپنی Markdown فائلوں میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp không giới hạn. Phiên âm riêng tư trên thiết bị. Lời nói của bạn, trong các tập tin Markdown của riêng bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限捕捉。设备上的私密转录。你的话，在你自己的Markdown文件中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無限捕捉。裝置上的私密轉錄。你的話，在你自己的Markdown文件中。"
          }
        }
      }
    },
