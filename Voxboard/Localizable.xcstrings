    "Recording retained on Watch. Reopen Vox.md to recover it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إعادة فتح Vox.md لتعويضها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং রাখা হয়েছে দর্শনে। পুনরায় খোলা Vox.md ফিরিয়ে আনার জন্য।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme auf der Watch aufbewahrt. Öffnen Sie Vox.md erneut, um sie wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording retained on Watch. Reopen Vox.md to recover it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se conserva en Watch. Reabierto Vox.md para recuperarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement conservé sur Watch. Réouverture Vox.md pour le récupérer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड में रखी गई है नजर पुनरारंभ Vox.md इसे पुनर्प्राप्त करने के लिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman yang disimpan di Watch. Reopen Vox.md untuk memulihkan itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è stata mantenuta su Watch. Riapertura Vox.md per recuperare la"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は、Watchで保存。 再開 Vox.md を回復するため。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 시계에 남아있다. 재개 Vox.md 그것을 회복하기 위해서다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname bewaard op Watch. heropenen Vox.md Om het te herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie zostało zachowane na Watch. ReOpen Vox.md Aby go odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação mantida em Watch. Reabertura Vox.md para recuperá-lo em"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись сохранилась на Watch. Реабилитация Vox.md Чтобы восстановить его."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காத்திருப்பதைப் போலவே எழுதினேன். மீண்டும் திறந்த Vox.md அதை மீட்க"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
