            "value": "Apple Intelligence está preparando su modelo en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence prépare son modèle sur l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence डिवाइस पर अपना मॉडल तैयार कर रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sedang menyiapkan model di perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sta preparando il modello sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceがデバイス上のモデルを準備しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 기기 내 모델을 준비하고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence bereidt het model op het apparaat voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence przygotowuje model na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está preparando seu modelo no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence подготавливает модель на устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence சாதனத்தில் தனது மாதிரியைத் தயாரிக்கிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence กำลังเตรียมโมเดลบนอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aygıttaki modelini hazırlıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence готує модель на пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ڈیوائس پر اپنا ماڈل تیار کر رہا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence đang chuẩn bị mô hình trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 正在准备设备端模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 正在準備裝置端模型。"
          }
        }
      }
    },
    "Apple Intelligence no longer leaves stray quotation marks or braces around processed notes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد Apple Intelligence يترك علامات اقتباس أو أقواسًا زائدة حول الملاحظات المعالجة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence আর প্রসেস করা নোটের চারপাশে অপ্রয়োজনীয় উদ্ধৃতিচিহ্ন বা বন্ধনী রেখে যায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence hinterlässt keine überflüssigen Anführungszeichen oder Klammern mehr um verarbeitete Notizen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no longer leaves stray quotation marks or braces around processed notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ya no deja comillas ni llaves sueltas alrededor de las notas procesadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ne laisse plus de guillemets ni d’accolades parasites autour des notes traitées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence अब प्रोसेस किए गए नोट्स के आसपास फ़ालतू उद्धरण चिह्न या ब्रेसेज़ नहीं छोड़ता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence tidak lagi menyisakan tanda kutip atau kurung kurawal yang tersasar di sekitar catatan yang diproses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence non lascia più virgolette o parentesi graffe superflue attorno alle note elaborate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceで処理したメモの周囲に、余分な引用符や括弧が残らなくなりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 처리한 메모 주변에 불필요한 따옴표나 괄호가 더 이상 남지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence laat geen losse aanhalingstekens of accolades meer achter rond verwerkte notities."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence nie zostawia już zbędnych cudzysłowów ani nawiasów wokół przetworzonych notatek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence não deixa mais aspas ou chaves soltas nas notas processadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence больше не оставляет лишние кавычки или скобки вокруг обработанных заметок."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலாக்கப்பட்ட குறிப்புகளைச் சுற்றி Apple Intelligence இனி தேவையற்ற மேற்கோள் குறிகளையோ அடைப்புக்குறிகளையோ விடாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence จะไม่ทิ้งเครื่องหมายคำพูดหรือวงเล็บปีกกาที่หลงเหลือไว้รอบโน้ตที่ประมวลผลแล้วอีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence artık işlenen notların çevresinde başıboş tırnak işaretleri veya ayraçlar bırakmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence більше не залишає зайвих лапок чи дужок навколо оброблених нотаток."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence اب پروسیس شدہ نوٹس کے گرد فالتو کوٹیشن مارکس یا بریسز نہیں چھوڑتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence không còn để lại dấu ngoặc kép hay dấu ngoặc nhọn thừa quanh các ghi chú đã xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 不再在处理后的笔记周围留下多余的引号或括号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 不再於處理後的筆記周圍留下多餘的引號或括號。"
          }
        }
      }
    },
    "Apple Intelligence off · kept as captured": {
