    "Download %@ or choose an existing copy before recording.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download %@ or choose an existing copy before recording."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزّل %@ أو اختر نسخة موجودة قبل التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ড করার আগে %@ ডাউনলোড করুন বা বিদ্যমান একটি কপি বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie %@ herunter oder wählen Sie eine vorhandene Kopie aus, bevor Sie aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga %@ o elige una copia existente antes de grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez %@ ou choisissez une copie existante avant d'enregistrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड करने से पहले %@ डाउनलोड करें या मौजूदा कॉपी चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh %@ atau pilih salinan yang ada sebelum merekam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica %@ o scegli una copia esistente prima di registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音する前に%@をダウンロードするか、既存のコピーを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하기 전에 %@을(를) 다운로드하거나 기존 사본을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download %@ of kies een bestaande kopie voordat je opneemt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz %@ lub wybierz istniejącą kopię przed nagraniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe %@ ou escolha uma cópia existente antes de gravar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачайте %@ или выберите существующую копию перед записью."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு செய்வதற்கு முன் %@-ஐப் பதிவிறக்கவும் அல்லது ஏற்கனவே உள்ள நகலைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลด %@ หรือเลือกสำเนาที่มีอยู่ก่อนบันทึกเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmeden önce %@ indirin veya mevcut bir kopya seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте %@ або виберіть наявну копію перед записом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ سے پہلے %@ ڈاؤن لوڈ کریں یا موجودہ کاپی منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống %@ hoặc chọn bản sao có sẵn trước khi ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在录制前下载 %@ 或选择现有的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在錄音前下載 %@ 或選擇現有的副本。"
          }
        }
      }
    },
