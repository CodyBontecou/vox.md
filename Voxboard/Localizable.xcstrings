    "Capture is safely queued in Vox.md. Open Vox.md to finish delivery, then tap Done here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إجراء التفتيش بأمان في Vox.md. افتح Vox.md لتكمل التفتاز، ثم اضغط هنا على الانتهاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিরাপদে বন্দি হয়েছেন ক্যাচিং Vox.md. খোলা Vox.md পাঠানোর পরে, এরপর এখানে ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erfassung liegt sicher in der Warteschlange von Vox.md. Öffnen Sie Vox.md, um die Zustellung abzuschließen, und tippen Sie hier dann auf „Fertig“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture is safely queued in Vox.md. Open Vox.md to finish delivery, then tap Done here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura se lleva a cabo de forma segura en Vox.md. abierta Vox.md Para finalizar la entrega, Y luego tapamos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture est sécurisée dans Vox.md. ouvert Vox.md Pour finir la livraison, Tapez Done ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित रूप से पकड़ लिया गया Vox.md. खुले Vox.md डिलीवरी को खत्म करने के लिए, और यहां पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangan yang aman diikat dalam Vox.md. terbuka Vox.md Untuk menyelesaikan pengiriman, Kemudian tekan Done di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cattura è sicura in Vox.md. aperto Vox.md per completare la consegna, Tapp Done qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に収容されているのは、 Vox.md. オープン Vox.md 配達を終えるため、 タップはこちらから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처는 안전하게 체크인되어 있습니다 Vox.md. 오픈 Vox.md 배달을 마무리 하려면, 그리고 여기서 Done을 탭합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gevangenen zijn veilig in de wacht Vox.md. Open Vox.md Om de levering te beëindigen, Klik hier voor Done."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Złapany jest bezpiecznie w Vox.md. Otwarcie Vox.md Aby zakończyć dostawę, Kliknij Done tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A captura é segura em Vox.md. aberta Vox.md Para concluir a entrega, Depois, toque em Done aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват безопасно закреплен в Vox.md. Открытый Vox.md Для завершения доставки, Нажмите Done здесь."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதுகாப்பாக உள்ளே நுழைந்தார் Vox.md. திறந்த Vox.md முடிவு செய்து கொடுத்து, இதில் TAP DONE இல்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพถูกเก็บไว้ในสายที่ปลอดภัย Vox.md. เปิด Vox.md เพื่อให้เสร็จสิ้นการจัดส่ง แล้วคลิก Done ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli bir şekilde kapalı kalıyor Vox.md. Açık Vox.md Teslimatın tamamlanması için, O zaman buraya tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закарпаття безпечно затримано в Vox.md. Відкритий Vox.md Щоб закінчити доставку, Натисніть Done тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ رہنے کے لئے محفوظ ہے Vox.md. کھولنے Vox.md تحفہ ختم کرنے کے لئے، یہاں پر کلک کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chú ý: Chú ý được xếp hàng an toàn trong Vox.md. Mở Vox.md Để hoàn thành giao hàng, Sau đó click Done tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被捕者安全排队 Vox.md. 开放 Vox.md 完成交付, 然后点击这里做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被捕者安全排隊 Vox.md. 開放 Vox.md 完成交付, 然後點擊這裡做。"
          }
        }
      }
    },
