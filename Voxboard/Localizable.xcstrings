        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ না বদলে রেকর্ডিং শুরু করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme starten, ohne die App zu wechseln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording without switching apps"
          }
        },
        "es": {
          "stringUnit": {
