        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos permitidos para »%@“Extinção . Edite o destino e selecione sua pasta novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на файлы для »%@«Окончался Измените место назначения и выберите его папку снова."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "File permission for ‘அறிவுப் பதிவுகள்’%@“நெறி இலக்குகளை மாற்றவும், அதன் கோப்புகளை மீண்டும் தேர்வு செய்யவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่อนุญาตให้ใช้สําหรับ»%@“หมดอายุ แก้ไขเป้าหมายและเลือกโฟลเดอร์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya İzinleri »%@“Dönüştü Hedef düzenleyin ve klasörünü tekrar seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл на файли для »%@«Відбувся Редагуйте пункт призначення і виберіть його папку знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کے لئے فائلوں کی اجازت »%@’’پیدا ہوا۔ مقصد کو ترمیم کریں اور اس کے فارم کو دوبارہ منتخب کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "File cho phép cho »%@“Hết hạn. Sửa mục đích và chọn thư mục của nó một lần nữa."
          }
        },
        "zh-Hans": {
