          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত অডিও নোটের মতো একই ঐতিহ্যবাহী রপ্তানি ডিরেক্টরি এবং বেস ফাইল নাম ব্যবহার করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesichertes Audio nutzt dasselbe alte Exportverzeichnis und denselben Basis-Dateinamen wie die Notiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved audio uses the same legacy export directory and base filename as the note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio guardado utiliza el mismo directorio de exportación de legado y el nombre de archivo de base que la nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio enregistré utilise le même répertoire d'exportation de la base et le même nom de fichier de base que la note."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया ऑडियो नोट के रूप में एक ही विरासत निर्यात निर्देशिका और आधार फ़ाइल नाम का उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Audio menggunakan direktori ekspor legacy yang sama dan nama file basis seperti catatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio salvato utilizza lo stesso directory di esportazione legacy e il nome del file base della nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved Audio は、メモと同じ古いエクスポートディレクトリとベースファイル名を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Saveed Audio는 노트와 동일한 Legacy Export 디렉토리 및 Base 파일 이름을 사용합니다.Saved audio uses the same legacy export directory and base file name as the note."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaarde audio gebruikt dezelfde legacy export directory en basisbestandsnaam als de notitie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisany audio używa tego samego katalogi eksportu i nazwy pliku bazy, co notatka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio salvo usa o mesmo diretório de exportação legado e o nome de arquivo base que a nota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраненный аудио использует тот же список экспорта наследников и название файла базы, что и записка."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Audio என்ற பெயரில் அதே Legacy Export Directory மற்றும் Base File Name ஐ பயன்படுத்துகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกเสียงใช้ชื่อไฟล์ต้นกําเนิดและฐานเดียวกันกับบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetilen ses notu ile aynı eski ihracat dizinini ve temel dosya adını kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережений аудіо використовує той же директорій експорту спадщини та базу файлового імені, що і нота."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ آڈیو نوٹ کے طور پر اسی وارث برآمد ڈائریکٹری اور بنیادی فائل نام استعمال کرتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu âm thanh sử dụng cùng một thư mục xuất khẩu cổ xưa và tên tệp cơ sở như ghi chú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存音频使用与笔记相同的传统导出目录和基础文件名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保存音頻使用與筆記相同的傳統導出目錄和基礎文件名。"
          }
        }
      }
    },
    "Saved on Watch, but iPhone sync is unavailable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخزينها على Watch ، ولكن iPhone التمثيل غير متاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উদ্ধার করা হয়েছে দর্শকদের। কিন্তু iPhone Sync অসম্ভব।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Watch gesichert, aber die iPhone-Synchronisierung ist nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on Watch, but iPhone sync is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo en la vigilancia, pero iPhone Sin embargo, el sincro no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvé en veille, Mais iPhone Sync est indisponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बचाव के लिए देखो, लेकिन iPhone Sync उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat dari penjaga, Namun iPhone Sync tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "salvataggio in guardia, Ma iPhone Sync non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "救われたのは、見張りながら、 だが iPhone sync が利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구원받은 시계, 하지만 iPhone Sync는 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reddingsdienst op de wacht, maar iPhone Sync is niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "uratowany w czuwaniu, ale iPhone Sync nie jest dostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo em vigilância, Mas iPhone O Sync não está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасая на стороже, Но iPhone Синхронизация недоступна."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காத்திருப்பதை காப்பாற்றும் ஆனால் iPhone Sync கிடைக்கவில்லை"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการตรวจสอบ แต่ iPhone Sync ไม่สามารถใช้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözaltına alınanlar, Ama iPhone Sync kullanılamaz hale geldi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Врятували на сторожі, Але iPhone Синхронізація недоступна."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نگاہ میں بچاؤ لیکن iPhone sync دستیاب نہیں ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cứu em trong cảnh, nhưng iPhone Sync không sẵn dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "救了在看, 但是 iPhone sync 不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "救了在看, 但是 iPhone sync 不可用。"
          }
        }
      }
    },
    "Saved on Watch, sync failed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخزينها على Watch ، لم يتم تسجيلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিনেমাটিতে অসুবিধা হয়, সিনিয়রটি ব্যর্থ হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
