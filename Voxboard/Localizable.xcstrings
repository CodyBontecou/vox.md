    "Vault templates support the same tokens, including {location}, which follows the delivering Capture Preset's location setting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault templates support the same tokens, including {location}, which follows the delivering Capture Preset's location setting."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدعم قوالب Vault الرموز نفسها، بما فيها {location}، الذي يتبع إعداد الموقع في إعداد الالتقاط المسبق الذي يسلّم الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault টেমপ্লেট একই টোকেন সমর্থন করে, যার মধ্যে {location} রয়েছে; এটি ক্যাপচার পৌঁছে দেওয়া ক্যাপচার প্রিসেটের অবস্থান সেটিং অনুসরণ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault-Vorlagen unterstützen dieselben Tokens, einschließlich {location}, das der Standorteinstellung des übermittelnden Aufnahme-Presets folgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas de Vault admiten los mismos tokens, incluido {location}, que sigue el ajuste de ubicación del preajuste de captura que realiza la entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles Vault prennent en charge les mêmes jetons, dont {location}, qui suit le réglage de localisation du préréglage de capture chargé de la transmission."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault टेम्प्लेट इन्हीं टोकन का समर्थन करते हैं, जिनमें {location} भी शामिल है; यह कैप्चर पहुँचाने वाले कैप्चर प्रीसेट की स्थान सेटिंग का पालन करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat Vault mendukung token yang sama, termasuk {location}, yang mengikuti pengaturan lokasi Preset Pengambilan yang mengirimkan hasil pengambilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli Vault supportano gli stessi token, incluso {location}, che segue l’impostazione della posizione del preset di acquisizione che effettua la consegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault テンプレートは {location} を含む同じトークンに対応し、配信するキャプチャプリセットの位置情報設定に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault 템플릿은 {location}을 포함한 동일한 토큰을 지원하고, 캡처를 전달하는 캡처 프리셋의 위치 설정을 따릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault-sjablonen ondersteunen dezelfde tokens, waaronder {location}, dat de locatie-instelling volgt van de opnamevoorinstelling die de opname aflevert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szablony Vault obsługują te same tokeny, w tym {location}, który korzysta z ustawienia lokalizacji presetu przechwytywania dostarczającego treść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos do Vault aceitam os mesmos tokens, incluindo {location}, que segue o ajuste de localização da predefinição de captura responsável pela entrega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны Vault поддерживают те же токены, включая {location}, который использует настройку местоположения предустановки захвата, доставляющей запись."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault டெம்ப்ளேட்கள் {location} உள்ளிட்ட அதே டோக்கன்களை ஆதரிக்கின்றன; இது பதிவை வழங்கும் பதிவு முன்னமைவின் இருப்பிட அமைப்பைப் பின்பற்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทมเพลต Vault รองรับโทเค็นเดียวกัน รวมถึง {location} ซึ่งจะทำตามการตั้งค่าตำแหน่งของค่าที่ตั้งไว้ล่วงหน้าสำหรับการบันทึกที่ส่งรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault şablonları {location} dahil aynı belirteçleri destekler ve yakalamayı ileten Yakalama Ön Ayarının konum ayarını izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони Vault підтримують ті самі токени, зокрема {location}, який використовує налаштування місцезнаходження пресета запису, що доставляє запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault ٹیمپلیٹس انہی ٹوکنز کو سپورٹ کرتے ہیں، بشمول {location}، جو کیپچر پہنچانے والے کیپچر پری سیٹ کی مقام کی ترتیب کے مطابق ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu Vault hỗ trợ các token tương tự, bao gồm {location}; token này tuân theo cài đặt vị trí của cấu hình chụp sẵn chuyển nội dung chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault 模板支持相同的令牌，包括 {location}；它会遵循传送捕捉内容的捕捉预设的位置设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault 範本支援相同的代碼，包括 {location}；它會依照傳送擷取內容的擷取預設之位置設定。"
          }
        }
      }
    },
