    "%@. Your capture is safe on this iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. التقاطك آمن على هذا الـ iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। আপনার ক্যাপচার এই iPhone-এ নিরাপদ আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Ihre Erfassung ist auf diesem iPhone sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Your capture is safe on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Tu captura está a salvo en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Votre capture est en sécurité sur cet iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@। आपका कैप्चर इस iPhone पर सुरक्षित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Tangkapan Anda aman di iPhone ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. La tua acquisizione è al sicuro su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。キャプチャはこのiPhoneに安全に保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 캡처는 이 iPhone에 안전하게 보관되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Je vastlegging is veilig op deze iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Przechwycenie jest bezpieczne na tym iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Sua captura está segura neste iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Ваш захват в безопасности на этом iPhone."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. உங்கள் பிடிப்பு இந்த iPhone இல் பாதுகாப்பாக உள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ การจับภาพของคุณปลอดภัยบน iPhone เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Yakalamanız bu iPhone'da güvende."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Ваше захоплення в безпеці на цьому iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@۔ آپ کا کیپچر اس iPhone پر محفوظ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Bản ghi nhanh của bạn vẫn an toàn trên iPhone này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。你的采集已安全保存在此 iPhone 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。你的擷取已安全儲存在此 iPhone 上。"
          }
        }
      }
    },
