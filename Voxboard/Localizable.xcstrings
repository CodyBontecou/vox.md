    "Turn on Apple Intelligence in system settings to describe images.": {
      "comment": "On-device image descriptions: preset control, help, availability, or capture progress.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل Apple Intelligence في إعدادات النظام لوصف الصور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবির বর্ণনার জন্য সিস্টেম সেটিংসে Apple Intelligence চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Apple Intelligence in den Systemeinstellungen, um Bilder zu beschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in system settings to describe images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Apple Intelligence en los ajustes del sistema para describir imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans les réglages système pour décrire les images."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवियों का वर्णन करने के लिए सिस्टम सेटिंग में Apple Intelligence चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Apple Intelligence di pengaturan sistem untuk mendeskripsikan gambar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Apple Intelligence nelle impostazioni di sistema per descrivere le immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を説明するには、システム設定でApple Intelligenceをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 설명하려면 시스템 설정에서 Apple Intelligence를 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Apple Intelligence in de systeeminstellingen in om afbeeldingen te beschrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Apple Intelligence w ustawieniach systemu, aby opisywać obrazy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Apple Intelligence nos ajustes do sistema para descrever imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Apple Intelligence в настройках системы, чтобы описывать изображения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படங்களை விவரிக்க, கணினி அமைப்புகளில் Apple Intelligence ஐ இயக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Apple Intelligence ในการตั้งค่าระบบเพื่ออธิบายรูปภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüleri açıklamak için sistem ayarlarında Apple Intelligence özelliğini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Apple Intelligence у параметрах системи, щоб описувати зображення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر کی وضاحت کے لیے سسٹم کی ترتیبات میں Apple Intelligence آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Apple Intelligence trong cài đặt hệ thống để mô tả ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中打开 Apple Intelligence 以描述图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中開啟 Apple Intelligence 以描述影像。"
          }
        }
      }
    },
    "Turn this on to save a copy of the recorded audio when a note is exported.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإطلاق هذا لتخزين نسخة من الصوت المرسوم عند تصدير الملاحظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি নোট রপ্তানি করার সময় রেকর্ড করা অডিওটির একটি কপি সংরক্ষণ করতে এটি চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie dies, um eine Kopie des aufgezeichneten Audios zu speichern, wenn eine Notiz exportiert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on to save a copy of the recorded audio when a note is exported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar esto para guardar una copia del audio grabado cuando se exporta una nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer cette fonction pour enregistrer une copie de l'audio enregistré lors de l'exportation d'une note."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सक्रिय करें जब नोट निर्यात किया जाता है तो रिकॉर्ड किए गए ऑडियो का एक प्रति सहेजने के लिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan ini untuk menyimpan salinan audio yang direkam saat sebuah catatan diekspor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivare questo per salvare una copia dell'audio registrato quando viene esportata una nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能を有効にすると、ノートをエクスポートするときに録音されたオーディオのコピーを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능을 사용하여 노트를 내보낼 때 녹음된 오디오의 사본을 저장합니다.Enable this to save a copy of the recorded audio when a note is exported."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel deze functie in om een kopie van de opgenomen audio te bewaren wanneer een notitie wordt geëxporteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz to, aby zapisać kopię nagranego dźwięku podczas eksportowania notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative esta opção para salvar uma cópia do áudio gravado quando uma nota é exportada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите это, чтобы сохранить копию записанного аудио при экспорте заметки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவை படித்து விட்டு, ஒரு பதிவை எழுதிக் கொண்டால் அது வெளியாகும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดตัวนี้เพื่อบันทึกสําเนาของเสียงที่บันทึกเมื่อมีการส่งออกบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notu dışa aktarırken kaydedilen sesin bir kopyasını kaydetmek için bu özelliğini etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть це, щоб зберегти копію записаного аудіо при експорті ноти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ کو ایک نوٹ کو برآمد کرتے وقت ریکارڈ آڈیو کا ایک کاپی محفوظ کرنے کے لئے فعال کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật điều này để lưu một bản sao của âm thanh được ghi lại khi một ghi chú được xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用此功能,以便在导出笔记时保存录制的音频副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用此功能,以便在導出筆記時保存錄制的音頻副本。"
          }
        }
      }
    },
