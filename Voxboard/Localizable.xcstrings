          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme unterbrochen - Bitte versuchen Sie es erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording interrupted — please try again"
          }
        },
        "es": {
