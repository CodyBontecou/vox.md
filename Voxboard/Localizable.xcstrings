    "Could not save Watch sync progress.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ تقدم مزامنة الساعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch সিঙ্কের অগ্রগতি সংরক্ষণ করা যায়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Watch-Synchronisierungsfortschritt konnte nicht gesichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save Watch sync progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el progreso de sincronización del Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la progression de la synchronisation de la Watch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch सिंक की प्रगति सहेजी नहीं जा सकी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan progres sinkronisasi Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l’avanzamento della sincronizzazione di Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch の同期状況を保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 동기화 진행 상황을 저장할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de voortgang van de Watch-synchronisatie niet bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać postępu synchronizacji z Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o progresso da sincronização do Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить ход синхронизации Watch."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch ஒத்திசைவு முன்னேற்றத்தைச் சேமிக்க முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกความคืบหน้าการซิงค์ของ Watch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch eşzamanlama ilerlemesi kaydedilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти перебіг синхронізації Watch."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch سنک کی پیش رفت محفوظ نہیں ہو سکی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu tiến trình đồng bộ của Watch."
          }
        },
        "zh-Hans": {
