        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu aygıtta kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе залишається на цьому пристрої."
          }
        },
