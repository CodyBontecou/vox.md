          "stringUnit": {
            "state": "translated",
            "value": "Перестаёт использовать эту модель, не удаляя её с вашего Mac."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மாதிரியை உங்கள் Mac-இலிருந்து நீக்காமல் பயன்படுத்துவதை நிறுத்துகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดใช้โมเดลนี้โดยไม่ลบออกจาก Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modeli Mac'inizden silmeden kullanmayı bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Припиняє використовувати цю модель, не видаляючи її з вашого Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ماڈل کا استعمال بند کر دیتا ہے لیکن اسے آپ کے Mac سے حذف نہیں کرتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngừng sử dụng mô hình này mà không xóa nó khỏi Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止使用此模型，但不会将其从 Mac 上删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止使用此模型，但不會將其從 Mac 上刪除。"
          }
        }
      }
    },
