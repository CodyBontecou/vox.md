    "Review a seven-day activity chart and a breakdown of captures from the app, keyboard, Share Sheet, widgets, Shortcuts, and Apple Watch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة جدول الأنشطة لمدة سبع أيام ومقاطعة من الصيغ من التطبيق، والصور، وكالة الشبكة، والفيديوهات، والخرائط المباشرة، وApple Watch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সাত দিনের কার্যকলাপ চার্ট এবং অ্যাপ্লিকেশন থেকে ক্যাপশনের একটি বিতরণ পরীক্ষা, ট্যাবলেট শেয়ারিং সাইট, উইজেট ছোটখাটো এবং Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie ein Sieben-Tage-Aktivitätsdiagramm und eine Aufschlüsselung der Erfassungen aus App, Tastatur, Teilen-Menü, Widgets, Kurzbefehlen und Apple Watch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review a seven-day activity chart and a breakdown of captures from the app, keyboard, Share Sheet, widgets, Shortcuts, and Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa un gráfico de actividad de siete días y una descomposición de las capturas de la aplicación, El teclado, Compartir la hoja, los widgets, cortes de tiempo, y Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner un graphique d'activité de sept jours et une décomposition des captures de l'application, Le clavier, Partager le tableau, Les widgets, Les courts, et Apple Watch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सात-दिन की गतिविधि चार्ट और ऐप से कैप्चर का एक विभाजन देखें, कीबोर्ड, Share Sheet के लिए विंडोज्स छोटे कटवाने, और Apple Watch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa grafik aktivitas tujuh hari dan pemecahan catatan dari aplikasi, dengan keyboard, Berbagi dengan lembar, Untuk widget, pendekatan, dan Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esaminare un grafico di attività di sette giorni e una ripartizione delle catture dall'app, Il keyboard, condividere il foglio, dei widget, dei cortocircuiti, e Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間の活動図とアプリからのキャプチャの分解をレビューする キーボード、 シェアシート、 ウィジェット、 ショートカット、 和 Apple Watch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일간의 활동 차트와 앱에서 캡처하는 분할을 검토, 키보드 잎을 공유하기, 위젯을 사용하고, 짧은 짧은 그리고 Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zevendaagse activiteitsdiagram en een verdeling van opnames uit de app bekijken, Het keyboard, Deel het blad, De widgets, kortsluiting , en Apple Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegląd siedmiodniowego wykresu aktywności i podział zdjęć z aplikacji, klawiatury , Podziel się tablicą, widżety , krótkie kroki, i Apple Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise um gráfico de atividade de sete dias e uma desintegração de capturas do aplicativo, O teclado, Compartilhe a folha, Os widgets, curtas, e Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка семидневной графики активности и распределение снимков из приложения, клавиатура , Сделать лист, Виджитс , короткие штрихи, и Apple Watch."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "7 நாள் வேலை பார்க்கும் அலுவலகத்தில், க்ளூப்டா Share அட்டை Widgetகள் குறுகிய அ Apple Watch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบแผนภูมิกิจกรรม 7 วันและแบ่งปันการจับภาพจากแอพ คีย์บอร์ด Share Sheet วิดเจ็ต ตัด และ Apple Watch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 günlük bir aktivite grafikini ve uygulama çekimlerinin bölünmesini gözden geçirin, Klavye ile, Paylaşım sayfası , Widgetler için, Kısa Çözümler , ve Apple Watch."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянути семиденну графіку активності та розбиток зйомок з додатка, клавіатури, Спільно з Лідером, Виджіти , короткострокові, та Apple Watch."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک سات دن کی سرگرمی گراف اور ایپ سے فہرستوں کا ایک تقسیم، ٹیبلٹ، Share کیجئے ویڈیوز کے مختصر کرنے کے لئے، اور Apple Watch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại biểu đồ hoạt động bảy ngày và phân chia các bản ghi từ ứng dụng, Bàn phím , Chia sẻ tấm, Các widget, ngắn gọn , và Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看七天的活动图表和应用程序的捕获分布, 键盘, 分享片段, 维基, 短片, 和 Apple Watch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看七天的活動圖表和應用程序的捕獲分佈, 鍵盤, 分享片段, 維基, 短片, 和 Apple Watch."
          }
        }
      }
    },
