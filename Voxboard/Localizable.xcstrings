          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग करें {period} चुने हुए दिन के लिए, सप्ताह के लिए, महीने के चौथाई, या वार्षिक बकवास। टोकन भी शामिल हैं {date}, {year}, {YR} (२ वर्ष की आयु) {month}, {day}, और {week}."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan {period} Untuk harian yang dipilih, Setiap minggu, Bulan yang Untuk kuartal, atau bucket tahunan. Token juga termasuk {date}, {year}, {YR} (Dalam dua tahun terakhir) {month}, {day}, dan {week}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "utilizzo {period} per il giorno selezionato, settimanale di Il mese, Quartiere di o di bucket annuale. I token includono anche {date}, {year}, {YR} (il secondo anno di vita), {month}, {day}, e {week}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用 {period} 選ばれた日々の、 週刊、 月間、 四半期、 毎年バケット トークンも含む。 {date}, {year}, {YR} (平成2年) {month}, {day}, 和 {week}."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하기 {period} 선택한 매일매일을 위해, 주간 월간 쿼리로 써서 또는 매년 버킷을 토큰은 또한 포함 {date}, {year}, {YR} ( 2년간의 연속적인 연속적인 연속적인 연속적인 연속적인 연속적인 {month}, {day}, 그리고 {week}."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik {period} voor de geselecteerde dagelijkse, wekelijkse, maandelijkse, Het kwartal, Of een jaarlijkse bucket. Tokens omvatten ook {date}, {year}, {YR} (Twee jaar later) {month}, {day}, en {week}."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj {period} w wybranym dniu, tygodniowe , miesięczne , w kwartale , lub rocznego bucket. Tokeny obejmują również {date}, {year}, {YR} (w ciągu dwóch lat) {month}, {day}, i {week}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar {period} Para o dia a dia escolhido, Semana do Dia, mensalidade , Quartos de trabalho, ou de um bucket anual. Os tokens também incluem {date}, {year}, {YR} (dois anos de idade) {month}, {day}, e {week}."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте {period} Для выбранного дня, Недельный → Месячные , в квартале, Или ежегодный букет. Токены также включают {date}, {year}, {YR} (в два года) {month}, {day}, и {week}."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்படுத்த {period} நாளைய தினம் தேர்வு, வாரம் , மாதம் மூன்றாவது அல்லது வருமான வரிசை. Tokens கூட உள்ளன {date}, {year}, {YR} (2 ஆண்டுகள் கழித்து) {month}, {day}, அ {week}."
          }
        },
        "th": {
          "stringUnit": {
