    "Temporarily stops adding audio without ending the recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف مؤقتا إضافة الصوت دون الانتهاء من تسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও অ্যাডমিন্টিং বন্ধ করে দেয়, অডিয়াম অ্যাকাউন্ট শেষ না করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert das Hinzufügen von Audio vorübergehend, ohne die Aufnahme zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily stops adding audio without ending the recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parará temporalmente la adición de audio sin terminar la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête temporairement l'ajout d'audio sans finir l'enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो जोड़ने को अस्थायी रूप से रोकता है, रिकॉर्डिंग को समाप्त किए बिना।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan sementara menambahkan audio tanpa mengakhiri rekaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smette temporaneamente di aggiungere audio senza terminare la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を終了せずにオーディオの追加を一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 끝나지 않고 오디오 추가를 일시적으로 중단합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt tijdelijk met het toevoegen van audio zonder de opname te beëindigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tymczasowo zatrzymuje dodawanie dźwięku bez zakończenia nagrywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar temporariamente a adição de áudio sem terminar a gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временно прекращает добавление аудио без окончания записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது இசை எழுத முடிவதில்லை, இசை எழுத முடிவதில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการเพิ่มเสียงชั่วคราวโดยไม่หยุดการบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt bitmeden geçici olarak ses eklemeyi durdurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасово припиняє додавання аудіо без закінчення запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آڈیو شامل کرنے کے لئے موقوف طور پر ختم کرتا ہے، بغیر ریکارڈنگ کا اختتام."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm thời ngừng thêm âm thanh mà không kết thúc bản ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时停止添加音频而不结束录制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時停止添加音頻而不結束錄製。"
          }
        }
      }
    },
