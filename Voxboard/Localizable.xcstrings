    "iOS blocks background mic start. Open Vox.md or leave Keyboard mic on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS يمنع بدء ميكروبيك في الخلف. افتح Vox.md أو تترك ميكروفون الكاميرا على."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ফোনে মাইক্রো স্টার্টিং খোলা Vox.md বা ট্যাবলেট মাইক্রোতে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS blockiert den Mikrofonstart im Hintergrund. Öffnen Sie Vox.md oder lassen Sie das Tastatur-Mikrofon aktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS blocks background mic start. Open Vox.md or leave Keyboard mic on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Inicio de micrófono de fondo. abierta Vox.md O dejar el micrófono de teclado en."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Démarrage de micro-ondes de fond. ouvert Vox.md Ou laissez le microfone de clavier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS फ्लैट फ्लैट शुरू करें। खुले Vox.md या फिर Keyboard Mic पर रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Mengatur background mic untuk memulai. terbuka Vox.md Atau tinggalkan keyboard mic di."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Inizia il backend mic. aperto Vox.md o lasciare il Keyboard mic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 背景のマイクロを起動する。 オープン Vox.md Keyboard Mic を起動する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 백업을 시작하는 뒷마이크 오픈 Vox.md 또는 Keyboard Mic를 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS De achtergrondmicro start. Open Vox.md Of laat de keyboard mic op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Blokuj mikrofon startujący. Otwarcie Vox.md lub pozostaw Keyboard Mic na."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Blocos de início do microfone. aberta Vox.md Ou deixe o microfone do teclado ligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Задний микрофон начинается. Открытый Vox.md или оставить клавиатуру на микрофоне."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Background mic start ஐ மாற்றவும். திறந்த Vox.md அல்லது Keyboard Mic ஐ வைத்துக் கொள்ளுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS บล็อกพื้นหลังเริ่มต้นไมโคร เปิด Vox.md หรือปล่อย Keyboard Mic บน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Arka planı mic start. Açık Vox.md Keyboard Mic’i açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Завантажити Background Mic Start Відкритий Vox.md або залишити клавіатуру мікром."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS پیچھے کی طرف سے شروع کرنے کے لئے mic. کھولنے Vox.md یا کلائنٹ کی طرف سے ایک ہی میٹر پر چھوڑ دیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Bắt đầu với background mic. Mở Vox.md Hoặc để keyboard mic vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 背景mic 开始。 开放 Vox.md 或者把键盘mic 放进去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 背景mic 開始。 開放 Vox.md 或者把鍵盤mic 放進去。"
          }
        }
      }
    },
