    "The audio and any transcript are removed from this iPhone. This can’t be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة الصوت وأي نص مفرّغ من هذا الـ iPhone. لا يمكن التراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও এবং যেকোনো ট্রান্সক্রিপ্ট এই iPhone থেকে সরিয়ে দেওয়া হবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio und ein etwaiges Transkript werden von diesem iPhone entfernt. Dies kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio and any transcript are removed from this iPhone. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio y cualquier transcripción se eliminarán de este iPhone. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio et toute transcription seront supprimés de cet iPhone. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो और कोई भी ट्रांसक्रिप्ट इस iPhone से हटा दिए जाएँगे। इसे पूर्ववत् नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio dan transkrip apa pun akan dihapus dari iPhone ini. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio ed eventuali trascrizioni verranno rimossi da questo iPhone. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオと文字起こしはこのiPhoneから削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오와 모든 전사본이 이 iPhone에서 제거됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audio en een eventuele transcriptie worden van deze iPhone verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio i ewentualna transkrypcja zostaną usunięte z tego iPhone. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio e qualquer transcrição serão removidos deste iPhone. Não é possível desfazer esta ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио и расшифровка будут удалены с этого iPhone. Это действие нельзя отменить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலியும் ஏதேனும் எழுத்துப்படியும் இந்த iPhone இலிருந்து அகற்றப்படும். இதைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงและข้อความถอดเสียงใดๆ จะถูกเอาออกจาก iPhone เครื่องนี้ การกระทำนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses ve varsa transkript bu iPhone'dan kaldırılır. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо та розшифровку буде видалено з цього iPhone. Цю дію не можна скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آڈیو اور کوئی بھی ٹرانسکرپٹ اس iPhone سے ہٹا دیے جائیں گے۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh và mọi bản chép lời sẽ bị xóa khỏi iPhone này. Bạn không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频及所有转写内容将从此 iPhone 中移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊及所有轉寫內容將從此 iPhone 中移除。此動作無法還原。"
          }
        }
      }
    },
