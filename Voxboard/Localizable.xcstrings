    "Capture Preset %@. Change preset. %lld recordings in the Watch queue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلقاء القبض على %1$@تغيير المفاهيم %2$lld أرقام في العادة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগামি ধরা %1$@. পরিবর্তন করে প্রসেসর %2$lld ঘড়ির রেকর্ডে রেকর্ডিং"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme-Preset %1$@. Preset wechseln. %2$lld Aufnahmen in der Watch-Warteschlange."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Preset %1$@. Change preset. %2$lld recordings in the Watch queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar Prep %1$@. Cambio de prescripción. %2$lld Encuentros en la cueva del reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture préalable %1$@. Changer de préambule. %2$lld Enregistrement de la queue de la montre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर सेट %1$@. बदलते हैं प्रीमियम %2$lld घड़ी की रस्सी में रिकॉर्ड।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menangkap Preset %1$@. Perubahan preset %2$lld Rekaman di baris Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cattura di preset %1$@. Cambia il presetto. %2$lld Le registrazioni sono in coda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャプレス %1$@. プレスリリース変更 %2$lld 時計の列に収録。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 캡처 %1$@. 사전 변경하기 %2$lld 시계 꼬리에 있는 녹음."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture vooruit %1$@. Verander de voorstelling. %2$lld De opnames in de wachtrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Złapanie pre- %1$@. Zmień predefiniowane. %2$lld Nagrania w kolejce na zegarek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar pré- %1$@. Mude o presépio. %2$lld gravado na fila do relógio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват пресекает %1$@. Изменить префикс %2$lld Записи в часы."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முன்பதிவு Capture %1$@. மாற்றங்கள் முகவரி %2$lld காட்சிகளில் கண் விழிப்புணர்வு"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพ Preet %1$@. เปลี่ยนตั้งค่า %2$lld การบันทึกในสายการมอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki İçerikKapı %1$@. Önceki Değiştirme %2$lld Watch Coue’da kayıtlar yapılıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоплення пресету %1$@. Зміни в пресі. %2$lld Запис на часі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشگی پکڑنے %1$@. پیشگی تبدیلیاں کریں %2$lld گھڑی کی چہرہ پر ڈسپلے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp trước %1$@. Thay đổi Preview %2$lld Các bản ghi trong Watch queue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抓取预先 %1$@. 改變預設 %2$lld 时钟排队的录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抓取預先 %1$@. 改變預設 %2$lld 時鐘排隊的錄音。"
          }
        }
      }
    },
