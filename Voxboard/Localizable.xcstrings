          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите Markdown, продиктуйте или вставьте текст либо перетащите файлы в это окно."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown-ஐத் தட்டச்சு செய்யவும், குரல்வழி உள்ளிடவும், ஒட்டவும் அல்லது இந்தச் சாளரத்தில் எங்கும் கோப்புகளை விடவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ Markdown ป้อนตามคำบอก วาง หรือลากไฟล์มาวางที่ใดก็ได้ในหน้าต่างนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown yazın, dikte edin, yapıştırın veya dosyaları bu pencerenin herhangi bir yerine bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть Markdown, продиктуйте або вставте текст чи перетягніть файли в це вікно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown لکھیں، بول کر لکھوائیں، پیسٹ کریں یا اس ونڈو میں کہیں بھی فائلیں چھوڑیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập Markdown, đọc chính tả, dán hoặc thả tệp vào bất kỳ đâu trong cửa sổ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 Markdown、使用听写、粘贴内容，或将文件拖放到此窗口中的任意位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 Markdown、使用聽寫、貼上內容，或將檔案拖放到此視窗中的任意位置。"
          }
        }
      }
    },
    "Type, or hold %@ to talk…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب، أو اضغط مطولًا على %@ للتحدث…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাইপ করুন, বা কথা বলতে %@ ধরে রাখুন…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen oder %@ halten, um zu sprechen …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type, or hold %@ to talk…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe o mantén pulsado %@ para hablar…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez, ou maintenez %@ pour parler…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइप करें, या बोलने के लिए %@ दबाकर रखें…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik, atau tahan %@ untuk bicara…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi o tieni premuto %@ per parlare…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力するか、%@を押したまま話す…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하거나 %@ 키를 길게 눌러 말하기…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ, of houd %@ vast om te praten…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisz lub przytrzymaj %@, aby mówić…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite ou segure %@ para falar…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите текст или удерживайте %@, чтобы говорить…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தட்டச்சு செய்யவும், அல்லது பேச %@ ஐப் பிடித்திருக்கவும்…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ หรือกด %@ ค้างไว้เพื่อพูด…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazın veya konuşmak için %@ basılı tutun…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть текст або утримуйте %@, щоб говорити…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹائپ کریں، یا بولنے کے لیے %@ دبا کر رکھیں…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập hoặc giữ %@ để nói…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入，或按住 %@ 说话…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入，或按住 %@ 說話…"
          }
        }
      }
    },
    "Type, paste or attach — or turn on the microphone to speak.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب أو الصق أو أرفق — أو شغّل الميكروفون للتحدث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাইপ করুন, পেস্ট করুন বা অ্যাটাচ করুন — অথবা কথা বলতে মাইক্রোফোন চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, einfügen oder anhängen – oder das Mikrofon einschalten, um zu sprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type, paste or attach — or turn on the microphone to speak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe, pega o adjunta, o activa el micrófono para hablar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez, collez ou joignez du contenu, ou activez le micro pour parler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइप करें, पेस्ट करें या अटैच करें — या बोलने के लिए माइक्रोफ़ोन चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik, tempel, atau lampirkan — atau nyalakan mikrofon untuk berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi, incolla o allega, oppure attiva il microfono per parlare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力、ペースト、添付 — またはマイクをオンにして話しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하거나 붙여넣거나 첨부하세요. 또는 마이크를 켜고 말하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ, plak of voeg iets toe – of zet de microfoon aan om te spreken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisz, wklejaj lub załączaj — albo włącz mikrofon, aby mówić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite, cole ou anexe — ou ative o microfone para falar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите, вставьте или прикрепите — или включите микрофон, чтобы говорить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தட்டச்சு செய்யவும், ஒட்டவும் அல்லது இணைக்கவும் — அல்லது பேச மைக்ரோஃபோனை இயக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ วาง หรือแนบ — หรือเปิดไมโครโฟนเพื่อพูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazın, yapıştırın veya ekleyin — ya da konuşmak için mikrofonu açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть, вставте або прикріпіть — або ввімкніть мікрофон, щоб говорити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹائپ کریں، پیسٹ کریں یا منسلک کریں — یا بولنے کے لیے مائیکروفون آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập, dán hoặc đính kèm — hoặc bật micrô để nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入、粘贴或添加附件——或打开麦克风说话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入、貼上或加入附件——或開啟麥克風說話。"
          }
        }
      }
    },
