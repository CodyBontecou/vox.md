    "iPhone could not save the transfer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone لم يتمكن من حفظ التحويل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone তবে ট্রান্সফার বাঁচাতে পারেননি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone konnte die Übertragung nicht sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone could not save the transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone No pudo salvar el traslado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Il n’a pas pu sauver le transfert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone हमने इस ट्रांसफर को बचा नहीं पाया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Tidak bisa menyelamatkan transfer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Non si poteva salvare il trasferimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 移転を救えなかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 이송을 구할 수 없었다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone De overdracht kon niet gered worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Nie udało się uratować transferu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Não consegui salvar a transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Перевод не удалось спасти."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone transfer காப்பாற்ற முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ไม่สามารถบันทึกการถ่ายโอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Transferden kurtulamadık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
