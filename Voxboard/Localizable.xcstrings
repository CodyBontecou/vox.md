          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄在 Apple Watch 它會自動出現。"
          }
        }
      }
    },
    "Record on this Watch. Syncs to iPhone later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقى رسالة من هذا النوع.سماحة إلى iPhone في وقت لاحق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ঘড়ির রেকর্ড সিন্ধু iPhone পরে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dieser Watch aufnehmen. Synchronisiert später mit dem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record on this Watch. Syncs to iPhone later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Record en este reloj. Sinónimos iPhone Más tarde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le record de cette montre. Synchronisation à iPhone plus tard"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस घड़ी पर रिकॉर्ड। सिंक्रनाइज़ iPhone बाद में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman di jam tangan ini. Sync yang iPhone kemudian"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il record su questo orologio. Sincronizzati iPhone Più tardi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時計の記録 シンクス iPhone 後で"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시계에 기록된 Sync 이 iPhone 나중에"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorder op deze klok. Synchroniseren met iPhone Later nog"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis na zegarku. Synchronizacja iPhone Później"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresentação deste relógio. Sincronização iPhone Mais tarde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись на этот часовник. Синхронизировать iPhone Позже"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மணிக்கு பதிவேடு. Sync இல் iPhone பிறகு"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกในนาฬิกานี้ สัญญาณ iPhone หลังจากนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatte kayıt yaptırın. Sinemalar iPhone Daha sonra"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис на цей годинник. Синхронізм iPhone Пізніше"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس گھڑی پر ایک ریکارڈ سنسنی iPhone بعد میں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh giá về đồng hồ này Sync Đã iPhone Sau này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个手表上的记录。 合成 iPhone 后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個手錶上的記錄。 合成 iPhone 後。"
          }
        }
      }
    },
    "Record or send a Capture to add it to your Library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل أو أرسل التقاطًا لإضافته إلى مكتبتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইব্রেরিতে যোগ করতে একটি ক্যাপচার রেকর্ড করুন বা পাঠান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehmen Sie eine Erfassung auf oder senden Sie eine, um sie Ihrer Mediathek hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record or send a Capture to add it to your Library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba o envía una captura para añadirla a tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ou envoyez une capture pour l’ajouter à votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर को अपनी लाइब्रेरी में जोड़ने के लिए उसे रिकॉर्ड करें या भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam atau kirim Tangkapan untuk menambahkannya ke Pustaka Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra o invia un’acquisizione per aggiungerla alla Libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャを録音または送信すると、ライブラリに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처를 녹음하거나 보내면 보관함에 추가됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een vastlegging op of verstuur er een om die aan je bibliotheek toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj lub wyślij przechwycenie, aby dodać je do Biblioteki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave ou envie uma captura para adicioná-la à sua Biblioteca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите или отправьте захват, чтобы добавить его в библиотеку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகத்தில் சேர்க்க ஒரு பிடிப்பைப் பதிவுசெய்யவும் அல்லது அனுப்பவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกหรือส่งการจับภาพเพื่อเพิ่มลงในคลังของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivinize eklemek için bir Yakalama kaydedin veya gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть або надішліть захоплення, щоб додати його до бібліотеки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی لائبریری میں شامل کرنے کے لیے کیپچر ریکارڈ کریں یا بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm hoặc gửi một bản ghi nhanh để thêm vào Thư viện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音或发送一个采集，即可将其添加到资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音或傳送一個擷取，即可將其加入資料庫。"
          }
        }
      }
    },
