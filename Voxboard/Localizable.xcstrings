    },
    "This does not write another note or audio attachment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يكتب هذا ملاحظة أخرى أو مرفقًا صوتيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আরেকটি নোট বা অডিও অ্যাটাচমেন্ট লেখে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
