            "state": "translated",
            "value": "Las descripciones de imágenes requieren un dispositivo compatible con Apple Intelligence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les descriptions d’images nécessitent un appareil compatible avec Apple Intelligence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि विवरण के लिए Apple Intelligence समर्थित डिवाइस चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsi gambar memerlukan perangkat yang mendukung Apple Intelligence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le descrizioni delle immagini richiedono un dispositivo compatibile con Apple Intelligence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の説明にはApple Intelligence対応デバイスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 설명에는 Apple Intelligence를 지원하는 기기가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbeeldingsbeschrijvingen vereisen een apparaat dat Apple Intelligence ondersteunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisy obrazów wymagają urządzenia obsługującego Apple Intelligence."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As descrições de imagens exigem um dispositivo compatível com Apple Intelligence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для описания изображений требуется устройство с поддержкой Apple Intelligence."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பட விளக்கங்களுக்கு Apple Intelligence ஐ ஆதரிக்கும் சாதனம் தேவை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำอธิบายรูปภาพต้องใช้อุปกรณ์ที่รองรับ Apple Intelligence"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü açıklamaları Apple Intelligence destekleyen bir aygıt gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для опису зображень потрібен пристрій із підтримкою Apple Intelligence."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر کی وضاحت کے لیے Apple Intelligence کی معاونت والی ڈیوائس درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả ảnh yêu cầu thiết bị hỗ trợ Apple Intelligence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
