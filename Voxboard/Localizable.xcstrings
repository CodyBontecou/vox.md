    "Choose a folder for your Markdown notes. Nothing is saved until you tap Send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا لملاحظات Markdown. لا يُحفظ شيء حتى تضغط إرسال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Markdown নোটের জন্য একটি ফোল্ডার বেছে নিন। Send চাপার আগে কিছুই সংরক্ষিত হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner für deine Markdown-Notizen. Gespeichert wird erst, wenn du auf „Senden“ tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder for your Markdown notes. Nothing is saved until you tap Send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta para tus notas Markdown. No se guarda nada hasta que toques Enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier pour vos notes Markdown. Rien n’est enregistré avant d’appuyer sur Envoyer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Markdown नोट्स के लिए फ़ोल्डर चुनें। Send टैप करने तक कुछ भी सहेजा नहीं जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder untuk catatan Markdown Anda. Tidak ada yang disimpan sampai Anda mengetuk Kirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella per le note Markdown. Non viene salvato nulla finché non tocchi Invia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdownメモ用のフォルダを選んでください。「送信」をタップするまで何も保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown 메모를 저장할 폴더를 선택하세요. 보내기를 탭하기 전에는 아무것도 저장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map voor je Markdown-notities. Er wordt niets bewaard tot je op Verstuur tikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder na notatki Markdown. Nic nie zostanie zapisane, dopóki nie stukniesz Wyślij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta para suas notas Markdown. Nada é salvo até você tocar em Enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку для заметок Markdown. Ничего не сохранится, пока вы не нажмёте «Отправить»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Markdown குறிப்புகளுக்கு ஒரு கோப்புறையைத் தேர்வுசெய்யவும். அனுப்பு தட்டும் வரை எதுவும் சேமிக்கப்படாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์สำหรับโน้ต Markdown จะยังไม่มีการบันทึกจนกว่าคุณจะแตะส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown notlarınız için bir klasör seçin. Gönder'e dokunana kadar hiçbir şey kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть папку для нотаток Markdown. Нічого не збережеться, доки ви не торкнетеся «Надіслати»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے Markdown نوٹس کے لیے فولڈر منتخب کریں۔ بھیجیں ٹیپ کرنے تک کچھ محفوظ نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thư mục cho ghi chú Markdown. Chưa có gì được lưu cho đến khi bạn chạm Gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Markdown 笔记选择一个文件夹。轻点“发送”之前不会保存任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為 Markdown 筆記選擇資料夾。點一下「傳送」之前不會儲存任何內容。"
          }
        }
      }
    },
    "Choose a folder so these routes know where to write.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا لتعرف هذه المسارات أين تكتب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ফোল্ডার বেছে নিন যাতে এই রুটগুলো জানে কোথায় লিখতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Ordner, damit diese Routen wissen, wohin sie schreiben sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder so these routes know where to write."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta para que estas rutas sepan dónde escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier pour que ces parcours sachent où écrire."
          }
