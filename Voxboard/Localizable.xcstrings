    "Quick Capture and Quick Record widgets now adapt to light and dark mode so their text and controls stay readable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن، تتكيف أجهزة التصوير السريع و تسجيل السريعة مع وضع الضوء والشمس حتى تكون النصوص والسياسات مقبولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত ক্যাপচার এবং দ্রষ্টব্য রেকর্ড উইজেটগুলি এখন হালকা এবং অন্ধকার মোডে সংযুক্ত করে যাতে তাদের পাঠ্য এবং নিয়ন্ত্রণগুলি পড়া যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quick Capture- und Quick Record-Widgets passen sich nun an den Licht- und Dunkelmodus an, sodass Text und Steuerelemente lesbar bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Capture and Quick Record widgets now adapt to light and dark mode so their text and controls stay readable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los widgets de Captación rápida y Grabación rápida se adaptan ahora a los modos de luz y oscuridad para que su texto y controles permanezcan legibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets Quick Capture et Quick Record s’adaptent désormais au mode clair et au mode sombre pour que leur texte et leurs contrôles restent lisibles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "त्वरित कैप्चर और त्वरित रिकॉर्ड विड्ड अब प्रकाश और अंधेरे मोड में अनुकूलित होते हैं ताकि उनके पाठ और नियंत्रण पढ़ने योग्य रहें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Capture dan Quick Record widget sekarang beradaptasi dengan mode terang dan gelap sehingga teks dan kontrol mereka tetap dapat dibaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I widget Quick Capture e Quick Record si adattano ora alla modalità luce e buia in modo che il loro testo e i controlli rimangano leggibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Capture および Quick Record ウィジェットは、今や光と暗いモードに適応し、テキストとコントロールが読み取り可能になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 캡처 및 빠른 기록 위젯은 이제 빛과 어두운 모드로 적응하여 텍스트와 컨트롤이 읽을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De widgets Quick Capture en Quick Record passen zich nu aan in de licht- en donkere modus, zodat hun tekst en besturingselementen leesbaar blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgety Quick Capture i Quick Record dostosowują się do trybu światła i ciemności, aby ich tekst i kontrolki pozostały czytelne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os widgets de Captura Rápida e Registo Rápido agora se adaptam ao modo Luz e Escuridão para que seu texto e controles permaneçam legíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виджеты Quick Capture и Quick Record теперь адаптируются к световому и темному режимам, чтобы их текст и контроли оставались четкими."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Capture மற்றும் Quick Record widgets இப்போது ஒளி மற்றும் அரிதாக நிலைக்கு மாற்றும், எனவே தங்கள் உரை மற்றும் கட்டுப்பாடுகள் ஓதுபவையாக இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Capture และ Quick Record Widgets ตอนนี้ปรับตัวเข้ากับโหมดแสงและมืดเพื่อให้ข้อความและควบคุมของพวกเขายังคงสามารถอ่านได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı Kayıt ve Hızlı Kayıt widgetleri artık ışık ve karanlık modlara adapte olur, böylece metinleri ve kontrolleri okunabilir kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відіти Quick Capture і Quick Record тепер адаптуються до світлого та темного режимів, щоб їх текст та керування залишалися читами."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فوری ریکارڈ اور فوری ریکارڈ ویڈیٹ اب روشنی اور اندھیرے کی حالت میں متفق ہیں تاکہ ان کے متن اور کنٹرول پڑھنے کے قابل رہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tiện ích Quick Capture và Quick Record hiện đang thích ứng với chế độ Light và Dark để văn bản và điều khiển của họ vẫn có thể đọc được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速捕捉和快速记录小工具现在适应光和黑暗模式,以便其文本和控制保持可读性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速捕捉和快速記錄小工具現在適應光和黑暗模式,以便其文本和控制保持可讀性。"
          }
        }
      }
    },
