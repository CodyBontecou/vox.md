    "Language changes take effect the next time Vox.md is opened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachänderungen werden angewendet, wenn Vox.md das nächste Mal geöffnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language changes take effect the next time Vox.md is opened."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسري تغييرات اللغة في المرة التالية التي تفتح فيها Vox.md."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাষার পরিবর্তনগুলো পরের বার Vox.md খোলা হলে কার্যকর হবে।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de idioma se aplican la próxima vez que abras Vox.md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de langue prendront effet à la prochaine ouverture de Vox.md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा में किए गए बदलाव Vox.md के अगली बार खुलने पर लागू होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan bahasa berlaku saat Vox.md dibuka berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche della lingua avranno effetto alla prossima apertura di Vox.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の変更は次回 Vox.md を開いたときに有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 변경 사항은 다음에 Vox.md를 열 때 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taalwijzigingen worden van kracht wanneer je Vox.md de volgende keer opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany języka zostaną zastosowane przy następnym otwarciu Vox.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações de idioma entram em vigor na próxima vez que você abrir o Vox.md."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения языка вступят в силу при следующем открытии Vox.md."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மொழி மாற்றங்கள் Vox.md அடுத்த முறை திறக்கும்போது நடைமுறைக்கு வரும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนภาษาจะมีผลในครั้งถัดไปที่คุณเปิด Vox.md"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil değişiklikleri, Vox.md'yi bir dahaki sefere açtığınızda geçerli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни мови набудуть чинності під час наступного відкриття Vox.md."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زبان کی تبدیلیاں اگلی بار Vox.md کھلنے پر لاگو ہوں گی۔"
          }
