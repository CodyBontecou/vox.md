    "Unlimited Capture and transcription on devices signed in to your Apple Account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل غير محدود و الترجمة على الأجهزة التي تم تسجيلها في حساب Apple الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Apple অ্যাকাউন্টে লগইন করা ডিভাইসগুলিতে সীমাহীন ক্যাপচার এবং ট্রান্সপ্লিপশন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzte Erfassung und Transkription auf Geräten, die bei Ihrem Apple-Konto angemeldet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited Capture and transcription on devices signed in to your Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captación y transcripción ilimitadas en dispositivos conectados a su Cuenta Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture et transcription illimités sur les appareils connectés à votre compte Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनधिकृत कैप्चर और ट्रांसक्रिप्शन आपके Apple खाते में लॉग इन किए गए उपकरणों पर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture dan transcription tidak terbatas pada perangkat yang masuk ke Akun Apple Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture e trascrizioni illimitate su dispositivi connessi al tuo account Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple アカウントにサインインしたデバイスでの無制限のキャプチャとトランスクリプション。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정에 로그인한 장치에서 무제한 캡처 및 트랜스피리"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbeperkte opname en transcriptie op apparaten die zijn ingelogd bij uw Apple-account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieograniczone przechwytywanie i transkrypcja na urządzeniach zalogowanych do konta Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captação e transcrição ilimitadas em dispositivos conectados à sua Conta Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неограниченное захват и транскрипция на устройствах, вошедших в учетную запись Apple."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Apple Account-க்கு உள்ள இணைப்புகளில் Unlimited Capture and Transcription."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพและคัดลอกแบบไม่ จํากัด บนอุปกรณ์ที่เข้าสู่ระบบกับบัญชี Apple ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Hesabınıza giriş yaptığınız cihazlarda Sınırsız Kayıt ve Transcription."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неограничене захоплення та транскрипція на пристроях, ввімкнених до облікового запису Apple."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے Apple اکاؤنٹ میں لاگ ان کردہ آلات پر لامحدود کپی اور ٹرانسپی."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp và sao chép không giới hạn trên các thiết bị đã đăng nhập vào Tài khoản Apple của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在登录到您的 Apple 帐户的设备上无限的捕捉和转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在登錄到您的 Apple 帳戶的設備上無限的捕捉和轉錄。"
          }
        }
      }
    },
