          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड संसाधित किया जाएगा और भेजा जाएगा %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman akan diproses dan dikirim dengan %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione verrà elaborata e inviata con %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は処理され、送信されます。 %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 처리되고 보내질 것입니다.The recording will be processed and sent with %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname wordt verwerkt en verzonden met %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania zostaną przetworzone i wysłane z %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações serão processadas e enviadas com %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись будет обработана и отправлена с %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுத்துக்கள் எழுதப்படும் மற்றும் அனுப்பப்படும். %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจะถูกประมวลผลและส่งด้วย %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kayıtları işlenecek ve gönderilecektir. %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис буде оброблятися та відправлятися з %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے ساتھ بھیج دیا جائے گا اور اس کے ساتھ %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản ghi sẽ được xử lý và gửi với %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制将被处理并发送与 %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製將被處理併發送與 %@."
          }
        }
      }
    },
    "The requested Route no longer exists or is disabled.": {
