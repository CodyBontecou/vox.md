    "Second position in medium and large widgets.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموضع الثاني في الأدوات المتوسطة والكبيرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাঝারি ও বড় উইজেটে দ্বিতীয় অবস্থান।"
          }
        },
        "de": {
          "stringUnit": {
