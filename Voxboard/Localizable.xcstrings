    "System managed · No app model download": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يديره النظام · لا يلزم تنزيل نموذج داخل التطبيق"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম পরিচালিত · অ্যাপে মডেল ডাউনলোডের প্রয়োজন নেই"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom System verwaltet · Kein Modell-Download in der App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System managed · No app model download"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionado por el sistema · No requiere descargar un modelo en la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Géré par le système · Aucun modèle à télécharger dans l’app"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम द्वारा प्रबंधित · ऐप में मॉडल डाउनलोड आवश्यक नहीं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikelola sistem · Tidak perlu mengunduh model di aplikasi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestito dal sistema · Nessun modello da scaricare nell’app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム管理 · アプリでのモデルダウンロード不要"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 관리 · 앱에서 모델을 다운로드할 필요 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door het systeem beheerd · Geen modeldownload in de app nodig"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzane przez system · Bez pobierania modelu w aplikacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerenciado pelo sistema · Não requer baixar modelo no app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляется системой · Загружать модель в приложении не нужно"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்பால் நிர்வகிக்கப்படுகிறது · செயலியில் மாதிரியைப் பதிவிறக்கத் தேவையில்லை"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจัดการ · ไม่ต้องดาวน์โหลดโมเดลในแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem tarafından yönetilir · Uygulamada model indirmek gerekmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керується системою · Завантажувати модель у застосунку не потрібно"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم کے زیر انتظام · ایپ میں ماڈل ڈاؤن لوڈ کی ضرورت نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Do hệ thống quản lý · Không cần tải mô hình trong ứng dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由系统管理 · 无需在 App 中下载模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由系統管理 · 無需在 App 中下載模型"
          }
        }
      }
    },
