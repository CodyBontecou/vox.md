    "Choose whether auto-stop ends recording or saves a segment and keeps listening.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كان الإيقاف التلقائي ينهي التسجيل أو يحفظ مقطعًا ويتابع الاستماع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অটো-স্টপ রেকর্ডিং শেষ করবে, নাকি একটি অংশ সেভ করে শুনতে থাকবে, তা বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie fest, ob der automatische Stopp die Aufnahme beendet oder ein Segment sichert und weiter zuhört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether auto-stop ends recording or saves a segment and keeps listening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si la detención automática termina la grabación o guarda un segmento y sigue escuchando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si l’arrêt automatique termine l’enregistrement ou enregistre un segment et continue l’écoute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि ऑटो-स्टॉप रिकॉर्डिंग ख़त्म करे या सेगमेंट सहेजकर सुनता रहे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apakah henti otomatis mengakhiri rekaman atau menyimpan segmen dan terus mendengarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se l’interruzione automatica termina la registrazione o salva un segmento e continua ad ascoltare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動停止で録音を終了するか、セグメントを保存して聞き取りを続けるかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 중단 시 녹음을 끝낼지, 세그먼트를 저장하고 계속 들을지 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of automatisch stoppen de opname beëindigt of een segment bewaart en blijft luisteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy automatyczne zatrzymywanie kończy nagrywanie, czy zapisuje fragment i słucha dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se a parada automática encerra a gravação ou salva um segmento e continua ouvindo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, завершает ли автоостановка запись или сохраняет фрагмент и слушает дальше."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கு நிறுத்தம் பதிவை முடிக்க வேண்டுமா அல்லது ஒரு பகுதியைச் சேமித்துக் கேட்டுக்கொண்டே இருக்க வேண்டுமா என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าการหยุดอัตโนมัติจะสิ้นสุดการบันทึก หรือบันทึกส่วนแล้วฟังต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik durdurmanın kaydı bitirip bitirmeyeceğini ya da bir bölümü kaydedip dinlemeye devam edeceğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, чи автозупинка завершує запис, чи зберігає фрагмент і слухає далі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کریں کہ آیا خودکار رکاؤ ریکارڈنگ ختم کرے یا حصہ محفوظ کر کے سنتا رہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tự dừng sẽ kết thúc ghi âm hay lưu một đoạn và tiếp tục nghe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择自动停止时是结束录音，还是保存片段并继续聆听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇自動停止時是結束錄音，還是儲存片段並繼續聆聽。"
          }
        }
      }
    },
