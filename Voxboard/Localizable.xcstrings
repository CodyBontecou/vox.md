    },
    "Queued captures stay safe on this Mac and retry automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الالتقاطات في قائمة الانتظار آمنة على هذا الـ Mac وتُعاد محاولتها تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সারিতে থাকা ক্যাপচার এই Mac-এ নিরাপদ থাকে এবং স্বয়ংক্রিয়ভাবে আবার চেষ্টা করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartende Erfassungen bleiben sicher auf diesem Mac und werden automatisch erneut versucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued captures stay safe on this Mac and retry automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas en cola se mantienen a salvo en este Mac y se reintentan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures en file d’attente restent en sécurité sur ce Mac et réessaient automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कतार वाले कैप्चर इस Mac पर सुरक्षित रहते हैं और अपने आप फिर से प्रयास करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan dalam antrean tetap aman di Mac ini dan dicoba lagi secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le acquisizioni in coda restano al sicuro su questo Mac e vengono riprovate automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュー内のキャプチャはこのMacに安全に保存され、自動的に再試行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열의 캡처는 이 Mac에 안전하게 보관되며 자동으로 재시도됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastleggingen in de wachtrij blijven veilig op deze Mac en worden automatisch opnieuw geprobeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechwycenia w kolejce są bezpieczne na tym Macu i ponawiane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas na fila ficam seguras neste Mac e são tentadas novamente de forma automática."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захваты в очереди надежно хранятся на этом Mac и повторяются автоматически."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரிசையிலுள்ள பிடிப்புகள் இந்த Mac இல் பாதுகாப்பாக இருந்து, தானாக மீண்டும் முயற்சிக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพในคิวจะปลอดภัยบน Mac เครื่องนี้และจะลองอีกครั้งโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruktaki yakalamalar bu Mac'te güvende kalır ve otomatik olarak yeniden denenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоплення в черзі надійно зберігаються на цьому Mac і повторюються автоматично."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطار میں موجود کیپچرز اس Mac پر محفوظ رہتے ہیں اور خودکار طور پر دوبارہ کوشش کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản ghi nhanh trong hàng đợi vẫn an toàn trên máy Mac này và tự động thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队列中的采集会安全保存在此 Mac 上并自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佇列中的擷取會安全儲存在此 Mac 上並自動重試。"
          }
        }
      }
    },
    "Queued recordings run when Vox.md is active and idle. iOS background execution is not guaranteed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل التسجيلات في قائمة الانتظار عندما يكون Vox.md نشطًا وخاملًا. التنفيذ في الخلفية على iOS غير مضمون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md সক্রিয় ও নিষ্ক্রিয় অবস্থায় থাকলে সারিতে থাকা রেকর্ডিং চলে। iOS ব্যাকগ্রাউন্ডে চলার নিশ্চয়তা নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartende Aufnahmen werden ausgeführt, wenn Vox.md aktiv und im Leerlauf ist. Die Ausführung im Hintergrund unter iOS ist nicht garantiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued recordings run when Vox.md is active and idle. iOS background execution is not guaranteed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones en cola se procesan cuando Vox.md está activo e inactivo. La ejecución en segundo plano de iOS no está garantizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements en file d’attente s’exécutent lorsque Vox.md est actif et inoccupé. L’exécution en arrière-plan d’iOS n’est pas garantie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कतार वाली रिकॉर्डिंग तब चलती हैं जब Vox.md सक्रिय और निष्क्रिय हो। iOS में बैकग्राउंड निष्पादन की गारंटी नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman dalam antrean berjalan saat Vox.md aktif dan sedang tidak digunakan. Eksekusi latar belakang iOS tidak dijamin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le registrazioni in coda vengono elaborate quando Vox.md è attivo e inattivo. L’esecuzione in background di iOS non è garantita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュー内の録音は、Vox.mdがアクティブでアイドル状態のときに実行されます。iOSでのバックグラウンド実行は保証されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열의 녹음은 Vox.md가 활성 상태이고 유휴 상태일 때 실행됩니다. iOS 백그라운드 실행은 보장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnamen in de wachtrij worden verwerkt wanneer Vox.md actief en inactief is. Uitvoering op de achtergrond in iOS is niet gegarandeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania z kolejki są przetwarzane, gdy Vox.md jest aktywny i bezczynny. Działanie w tle w iOS nie jest gwarantowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações na fila são processadas quando o Vox.md está ativo e ocioso. A execução em segundo plano no iOS não é garantida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи в очереди обрабатываются, когда Vox.md активен и простаивает. Фоновое выполнение в iOS не гарантируется."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md செயலில் மற்றும் செயலற்ற நிலையில் இருக்கும்போது வரிசையிலுள்ள பதிவுகள் இயங்கும். iOS பின்னணி இயக்கத்திற்கு உத்தரவாதம் இல்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกในคิวจะทำงานเมื่อ Vox.md เปิดอยู่และไม่ได้ใช้งาน ไม่รับประกันการทำงานในเบื้องหลังของ iOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruktaki kayıtlar Vox.md etkin ve boştayken çalışır. iOS arka plan yürütmesi garanti edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи в черзі обробляються, коли Vox.md активний і простоює. Фонове виконання в iOS не гарантується."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطار میں موجود ریکارڈنگز تب چلتی ہیں جب Vox.md فعال اور فارغ ہو۔ iOS پر پس منظر میں چلنے کی ضمانت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm trong hàng đợi chạy khi Vox.md đang mở và rảnh. iOS không đảm bảo việc chạy nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 处于活跃且空闲状态时，队列中的录音才会运行。iOS 不保证后台执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 處於使用中且閒置狀態時，佇列中的錄音才會執行。iOS 不保證背景執行。"
          }
        }
      }
    },
    "Queued recordings run while Vox.md is open and no recording is active.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل التسجيلات في قائمة الانتظار أثناء فتح Vox.md وعدم وجود تسجيل نشط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md খোলা থাকলে এবং কোনো রেকর্ডিং সক্রিয় না থাকলে সারিতে থাকা রেকর্ডিং চলে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartende Aufnahmen werden ausgeführt, während Vox.md geöffnet ist und keine Aufnahme läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued recordings run while Vox.md is open and no recording is active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones en cola se procesan mientras Vox.md está abierto y no hay ninguna grabación activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements en file d’attente s’exécutent lorsque Vox.md est ouvert et qu’aucun enregistrement n’est en cours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कतार वाली रिकॉर्डिंग तब चलती हैं जब Vox.md खुला हो और कोई रिकॉर्डिंग सक्रिय न हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman dalam antrean berjalan saat Vox.md terbuka dan tidak ada rekaman yang aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le registrazioni in coda vengono elaborate quando Vox.md è aperto e non è attiva alcuna registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュー内の録音は、Vox.mdが開いていて録音中でないときに実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열의 녹음은 Vox.md가 열려 있고 녹음 중이 아닐 때 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnamen in de wachtrij worden verwerkt terwijl Vox.md open is en er geen opname actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania z kolejki są przetwarzane, gdy Vox.md jest otwarty i nie trwa nagrywanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações na fila são processadas enquanto o Vox.md está aberto e nenhuma gravação está ativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи в очереди обрабатываются, пока Vox.md открыт и запись не идет."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md திறந்திருந்து எந்தப் பதிவும் செயலில் இல்லாதபோது வரிசையிலுள்ள பதிவுகள் இயங்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกในคิวจะทำงานขณะที่ Vox.md เปิดอยู่และไม่มีการบันทึกที่กำลังทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruktaki kayıtlar Vox.md açıkken ve etkin kayıt yokken çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи в черзі обробляються, поки Vox.md відкрито й запис не триває."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطار میں موجود ریکارڈنگز تب چلتی ہیں جب Vox.md کھلا ہو اور کوئی ریکارڈنگ فعال نہ ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm trong hàng đợi chạy khi Vox.md đang mở và không có bản ghi âm nào đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 打开且没有进行录音时，队列中的录音才会运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 打開且沒有進行錄音時，佇列中的錄音才會執行。"
          }
        }
      }
    },
