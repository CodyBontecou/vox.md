          "stringUnit": {
            "state": "translated",
            "value": "Certaines options d'achat sont temporairement indisponibles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ खरीद विकल्प अस्थायी रूप से उपलब्ध नहीं हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa pilihan pembelian sementara tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune opzioni di acquisto sono temporaneamente indisponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入オプションは一時的に利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 구매 옵션은 일시적으로 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige aankoopopties zijn tijdelijk niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre opcje zakupu są tymczasowo niedostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas opções de compra estão temporariamente indisponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые варианты покупки временно недоступны."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சில விற்பனை முறைகள் நேரடியாக கிடைக்கவில்லை."
          }
        },
        "th": {
          "stringUnit": {
