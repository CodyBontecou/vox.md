    "Describe photos, screenshots, and sketches on this device when you attach them. Existing descriptions are preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِف الصور ولقطات الشاشة والرسومات على هذا الجهاز عند إرفاقها. يتم الاحتفاظ بالأوصاف الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি, স্ক্রিনশট ও স্কেচ অ্যাটাচ করার সময় এই ডিভাইসেই সেগুলোর বর্ণনা তৈরি করুন। বিদ্যমান বর্ণনা রাখা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, Bildschirmfotos und Skizzen beim Anhängen auf diesem Gerät beschreiben. Vorhandene Beschreibungen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe photos, screenshots, and sketches on this device when you attach them. Existing descriptions are preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe fotos, capturas de pantalla y dibujos en este dispositivo al adjuntarlos. Se conservan las descripciones existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrit les photos, captures d’écran et croquis sur cet appareil lorsque vous les joignez. Les descriptions existantes sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो, स्क्रीनशॉट और स्केच अटैच करते समय इसी डिवाइस पर उनका विवरण बनाएँ। मौजूदा विवरण बने रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsikan foto, jepretan layar, dan sketsa di perangkat ini saat Anda melampirkannya. Deskripsi yang ada tetap dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrive foto, istantanee dello schermo e schizzi su questo dispositivo quando li alleghi. Le descrizioni esistenti vengono mantenute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真、スクリーンショット、スケッチを添付したときに、このデバイス上で説明を生成します。既存の説明は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진, 스크린샷 및 스케치를 첨부할 때 이 기기에서 설명을 생성합니다. 기존 설명은 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf foto's, schermafbeeldingen en schetsen op dit apparaat wanneer je ze toevoegt. Bestaande beschrijvingen blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisuj zdjęcia, zrzuty ekranu i szkice na tym urządzeniu podczas ich załączania. Istniejące opisy zostają zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva fotos, capturas de tela e desenhos neste dispositivo ao anexá-los. As descrições existentes são preservadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Описывать фото, снимки экрана и рисунки на этом устройстве при прикреплении. Существующие описания сохраняются."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படங்கள், திரைப்பிடிப்புகள் மற்றும் வரைபடங்களை இணைக்கும்போது அவற்றை இந்தச் சாதனத்திலேயே விவரிக்கவும். ஏற்கனவே உள்ள விவரிப்புகள் பாதுகாக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อธิบายรูปภาพ ภาพหน้าจอ และภาพร่างบนอุปกรณ์นี้เมื่อคุณแนบ คำอธิบายที่มีอยู่จะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları, ekran görüntülerini ve çizimleri eklediğinizde bu aygıtta açıklayın. Mevcut açıklamalar korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Описувати фото, знімки екрана й малюнки на цьому пристрої під час прикріплення. Наявні описи зберігаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر، اسکرین شاٹس اور خاکے منسلک کرتے وقت اسی آلے پر ان کی وضاحت کریں۔ موجودہ وضاحتیں برقرار رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả ảnh, ảnh màn hình và bản phác thảo trên thiết bị này khi bạn đính kèm. Các mô tả hiện có được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附加照片、截屏和草图时，在此设备上为其生成描述。现有描述会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附加照片、截圖和草圖時，在此裝置上為其產生描述。現有描述會保留。"
          }
        }
      }
    },
    "Describes Audio, Import Audio, and Keyboard Listening": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصف «الصوت» و«استيراد الصوت» و«الاستماع من لوحة المفاتيح»"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও, অডিও ইমপোর্ট ও কীবোর্ডে শোনা বর্ণনা করে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibt Audio, Audio importieren und Tastatur-Zuhören"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describes Audio, Import Audio, and Keyboard Listening"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe Audio, Importar audio y Escucha del teclado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrit Audio, Importer l’audio et Écoute du clavier"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो, ऑडियो इम्पोर्ट करें और कीबोर्ड लिसनिंग का वर्णन करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjelaskan Audio, Impor Audio, dan Mendengarkan via Papan Ketik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrive Audio, Importa audio e Ascolto tastiera"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「オーディオ」「オーディオを読み込む」「キーボードの聞き取り」について説明します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오, 오디오 가져오기 및 키보드 듣기에 대해 설명합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijft Audio, Importeer audio en Luisteren via toetsenbord"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisuje Audio, Importuj audio i Słuchanie klawiatury"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreve Áudio, Importar Áudio e Escuta do Teclado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Описывает «Аудио», «Импорт аудио» и «Прослушивание клавиатуры»"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலி, ஒலியை இறக்குமதி செய் மற்றும் விசைப்பலகை கேட்டல் ஆகியவற்றை விவரிக்கிறது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อธิบายเสียง นำเข้าเสียง และการฟังของแป้นพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses, Ses İçe Aktar ve Klavye Dinleme'yi açıklar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Описує «Аудіо», «Імпорт аудіо» та «Прослуховування клавіатури»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آڈیو، آڈیو امپورٹ کریں اور کی بورڈ کا سننا بیان کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả Âm thanh, Nhập âm thanh và Nghe qua bàn phím"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "介绍“音频”“导入音频”和“键盘聆听”"
          }
        },
