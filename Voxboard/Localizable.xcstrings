    "Uses Apple's system-managed, on-device speech recognizer when this device and language support it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم أداة التعرف على الكلام التي يديرها نظام Apple على الجهاز عندما يدعمها الجهاز واللغة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইস ও ভাষা সমর্থন করলে Apple-এর সিস্টেম-পরিচালিত অন-ডিভাইস স্পিচ রিকগনাইজার ব্যবহার করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet Apples systemverwaltete Spracherkennung auf dem Gerät, wenn Gerät und Sprache sie unterstützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Apple's system-managed, on-device speech recognizer when this device and language support it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el reconocimiento de voz en el dispositivo gestionado por Apple cuando el dispositivo y el idioma son compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la reconnaissance vocale sur l’appareil gérée par Apple lorsque l’appareil et la langue sont compatibles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस और भाषा के समर्थित होने पर Apple का सिस्टम-मैनेज्ड ऑन-डिवाइस स्पीच रिकग्नाइज़र इस्तेमाल करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan pengenal suara di perangkat yang dikelola sistem Apple jika perangkat dan bahasa mendukungnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il riconoscimento vocale sul dispositivo gestito da Apple quando dispositivo e lingua sono supportati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスと言語が対応している場合、Appleがシステム管理するオンデバイス音声認識を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기와 언어가 지원되면 Apple이 시스템에서 관리하는 온디바이스 음성 인식을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt Apples systeembeheerde spraakherkenning op het apparaat wanneer apparaat en taal dit ondersteunen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa systemowego rozpoznawania mowy Apple na urządzeniu, jeśli urządzenie i język są obsługiwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o reconhecimento de voz no dispositivo gerenciado pela Apple quando o dispositivo e o idioma são compatíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует системное распознавание речи Apple на устройстве, если устройство и язык поддерживаются."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதனமும் மொழியும் ஆதரிக்கும்போது Apple அமைப்பு நிர்வகிக்கும் சாதனத்திலுள்ள பேச்சு அறிதலைப் பயன்படுத்தும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้การรู้จำเสียงบนอุปกรณ์ที่ระบบ Apple จัดการ เมื่ออุปกรณ์และภาษารองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt ve dil destekliyorsa Apple’ın sistem tarafından yönetilen aygıt içi konuşma tanımayı kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує системне розпізнавання мовлення Apple на пристрої, якщо пристрій і мова підтримуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیوائس اور زبان معاون ہوں تو Apple کا نظام کے زیر انتظام آن ڈیوائس آواز شناسی استعمال کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng nhận dạng giọng nói trên thiết bị do hệ thống Apple quản lý khi thiết bị và ngôn ngữ được hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当设备和语言受支持时，使用由 Apple 系统管理的设备端语音识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當裝置與語言受支援時，使用由 Apple 系統管理的裝置端語音辨識。"
          }
        }
      }
    },
