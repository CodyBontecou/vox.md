    "Add Apple Family Sharing to your existing Unlimited purchase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف Apple Family Sharing إلى شراءك غير محدود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অস্তিত্বের অন্তর্ভুক্ত অ্যাপল পারিবারিক শেয়ারিং যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Apple Family Sharing zu Ihrem vorhandenen Unlimited-Kauf hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Apple Family Sharing to your existing Unlimited purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade Apple Family Sharing a tu compra de Unlimited existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le Partage Familial Apple à votre achat illimité existant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने मौजूदा असीमित खरीद में Apple Family Sharing जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan Apple Family Sharing ke pembelian Unlimited Anda yang ada."
          }
        },
        "it": {
