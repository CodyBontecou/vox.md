            "value": "Permitir HTTP Local Não Seguro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить небезопасный локальный HTTP"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதுகாப்பற்ற உள்ளூர் HTTP ஐ அனுமதி"
