    "Vibrate on key press. Requires Allow Full Access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اهتز عند الضغط على مفتاح. يتطلب السماح بالوصول الكامل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী চাপলে কম্পন দিন। সম্পূর্ণ অ্যাক্সেসের অনুমতি প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Tastendruck vibrieren. Erfordert „Vollen Zugriff erlauben“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrate on key press. Requires Allow Full Access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra al pulsar una tecla. Requiere permitir acceso total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibre à chaque appui. Nécessite l’autorisation d’accès complet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी दबाने पर कंपन करें। पूर्ण एक्सेस की अनुमति आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergetar saat tombol ditekan. Memerlukan Izinkan Akses Penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra alla pressione dei tasti. Richiede Consenti accesso completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押したときに振動します。「フルアクセスを許可」が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
