    "Check microphone access, then try again from your keyboard.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الوصول إلى الميكروفون، ثم محاولة مرة أخرى من محرك الويب الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোন অ্যাক্সেস চেক করুন, তারপর আপনার কীবোর্ড থেকে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie den Zugriff auf das Mikrofon und versuchen Sie es dann erneut von Ihrer Tastatur aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check microphone access, then try again from your keyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compruebe el acceso al micrófono y, a continuación, intente de nuevo desde su teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l'accès au microphone, puis réessayez à partir de votre clavier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफोन पहुंच की जाँच करें, फिर अपनी टैबलेट से फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa akses mikrofon, lalu coba lagi dari keyboard Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l'accesso al microfono e prova nuovamente dal tuo tastierino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクのアクセスを確認し、キーボードから再度試してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근을 확인하고 키보드에서 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de toegang tot de microfoon en probeer het opnieuw vanaf uw toetsenbord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź dostęp do mikrofonu, a następnie spróbuj ponownie z klawiatury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o acesso ao microfone e tente novamente com o teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте доступ микрофона, а затем попробуйте снова с клавиатуры."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மெகாபார்ட் அணுகும் முறை, பின்னர் உங்கள் கதவுகளை மீண்டும் முயற்சி."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการเข้าถึงไมโครโฟนแล้วลองอีกครั้งจากแป้นพิมพ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon erişimi kontrol edin, sonra klavye üzerinde tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте доступ до мікрофона, а потім спробуйте ще раз з клавіатури."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیکروفون تک رسائی کی جانچ پڑتال کریں، پھر اپنے ٹیبلٹ سے دوبارہ کوشش کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra truy cập micro, sau đó thử lại từ bàn phím của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查麦克风访问,然后从键盘中再次尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查麥克風訪問,然後從鍵盤中再次嘗試。"
          }
        }
      }
    },
