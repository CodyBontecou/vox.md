    "Already selected. One-off routing is kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محدد بالفعل. سيتم الاحتفاظ بالتوجيه لمرة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগেই বেছে নেওয়া আছে। এককালীন রাউটিং রাখা হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits ausgewählt. Einmaliges Routing bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already selected. One-off routing is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está seleccionada. Se mantiene el enrutamiento puntual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà sélectionné. Le routage ponctuel est conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले से चुना गया है। एक बार की रूटिंग बनी रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah dipilih. Perutean sekali pakai tetap dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già selezionato. L’instradamento una tantum viene mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択済みです。一時的なルート設定は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 선택되어 있습니다. 일회성 루트 설정은 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al geselecteerd. Eenmalige routering blijft behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już wybrano. Jednorazowe ustawienia trasy zostają zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já selecionada. O roteamento avulso é mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже выбран. Разовая маршрутизация сохранена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்கனவே தேர்ந்தெடுக்கப்பட்டது. ஒருமுறை வழித்தட மாற்றம் வைக்கப்பட்டுள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไว้แล้ว การกำหนดเส้นทางแบบครั้งเดียวยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten seçili. Tek seferlik yönlendirme korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже вибрано. Разову маршрутизацію збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے سے منتخب ہے۔ ایک بار کی روٹنگ برقرار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã được chọn. Định tuyến dùng một lần vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选中。一次性路由设置保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選取。單次路線設定保持不變。"
          }
        }
      }
    },
