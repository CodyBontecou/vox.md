        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने हुए फ़ोल्डर या बॉल के लिए पथ, उदाहरण के लिए, परियोजनाओं /Vox.md."
          }
        },
        "id": {
          "stringUnit": {
