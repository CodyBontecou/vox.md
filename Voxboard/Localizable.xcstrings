            "value": "Bản sao không thể lưu được. Bản ghi vẫn được đính kèm vào bản thảo Capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录无法保存,记录仍附加到捕捉草案中。"
          }
        },
        "zh-Hant": {
