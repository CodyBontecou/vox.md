    "Add the Vox.md Watch face shortcut for a quick path into recording from supported Apple Watch faces.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة إشارة سريعة للعين Vox.md لوسائل تسجيل سريعة من الوجهات Apple Watch المجموعات المقبولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ করুন Vox.md সহজে রেকর্ডিং থেকে দ্রুত পথের জন্য মুখের স্ক্রুটি দেখুন Apple Watch মুখে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie das Vox.md-Ziffernblatt-Kurzbefehl hinzu, um von unterstützten Ziffernblättern der Apple Watch aus schnell mit der Aufnahme zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the Vox.md Watch face shortcut for a quick path into recording from supported Apple Watch faces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el Vox.md Ver el activo de cara para un camino rápido a la grabación desde soportado Apple Watch Las caras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le Vox.md Regardez le raccourci visage pour un chemin rapide vers l'enregistrement depuis le support Apple Watch des visages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ें Vox.md समर्थन से रिकॉर्डिंग में एक त्वरित मार्ग के लिए चेहरे का दृश्य संक्षिप्त दृश्य देखें Apple Watch चेहरे"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan yang Vox.md Tonton pendekatan wajah untuk jalan cepat ke rekaman dari yang didukung Apple Watch Wajah yang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il Vox.md Guardare il shortcut faccia per un percorso rapido in registrazione da supportato Apple Watch dei volti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加する Vox.md サポートされているから録音への迅速な道のりを表示する顔ショートカットをチェック Apple Watch 顔"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가하기 The Vox.md 지원된 녹음으로 빠른 경로를 위한 얼굴 단추를 시청하세요. Apple Watch 얼굴을 다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de Vox.md Bekijk gezichtskortscherm voor een snel pad naar opname vanaf ondersteund Apple Watch Gezicht op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj do Vox.md Obejrzyj skrót twarzy dla szybkiej ścieżki do nagrywania z obsługiwanego Apple Watch Twarze się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o Vox.md Assista o atalho facial para um caminho rápido para a gravação a partir do suportado Apple Watch os rostos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте к Vox.md Смотреть короткий штрих-файл для быстрого пути к записи от поддерживаемого Apple Watch Лица"
          }
        },
        "ta": {
          "stringUnit": {
