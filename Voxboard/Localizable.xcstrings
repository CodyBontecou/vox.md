    "Collapse pinned Routes. Use the Show Menu action for all Routes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طي المسارات المثبّتة. استخدم إجراء «إظهار القائمة» لعرض كل المسارات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন করা রুটগুলো সংকুচিত করুন। সব রুটের জন্য ‘মেনু দেখান’ অ্যাকশন ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Routen einklappen. Verwenden Sie die Aktion „Menü zeigen“ für alle Routen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse pinned Routes. Use the Show Menu action for all Routes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraer las rutas fijadas. Usa la acción Mostrar menú para ver todas las rutas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire les parcours épinglés. Utilisez l’action Afficher le menu pour voir tous les parcours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन किए गए रूट्स समेटें। सभी रूट्स के लिए मेनू दिखाएँ ऐक्शन का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciutkan Rute yang disematkan. Gunakan tindakan Tampilkan Menu untuk semua Rute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimi i percorsi fissati. Usa l’azione Mostra menu per tutti i percorsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めしたルートを折りたたみます。すべてのルートを表示するには「メニューを表示」アクションを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 루트를 접습니다. 모든 루트를 보려면 ‘메뉴 보기’ 동작을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastgezette routes samenvouwen. Gebruik de actie ‘Toon menu’ voor alle routes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwiń przypięte trasy. Użyj akcji Pokaż menu, aby zobaczyć wszystkie trasy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolher as rotas fixadas. Use a ação Mostrar Menu para ver todas as rotas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свернуть закрепленные маршруты. Все маршруты — в действии «Показать меню»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொருத்திய வழித்தடங்களைச் சுருக்கு. அனைத்து வழித்தடங்களுக்கும் மெனுவைக் காட்டு செயலைப் பயன்படுத்தவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยุบเส้นทางที่ปักหมุด ใช้การทำงาน “แสดงเมนู” เพื่อดูเส้นทางทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
