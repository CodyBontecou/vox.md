          "stringUnit": {
            "state": "translated",
            "value": "Почніть голосову записку з вашого Apple Watch Face і синхронізувати його Vox.md Є iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے سے ایک آواز نوٹ شروع کریں Apple Watch face اور sync it to کے لئے Vox.md ہے iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu một ghi chú giọng nói từ Apple Watch Face và Sync It to Vox.md Có iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始从您的语音笔记 Apple Watch 面部和同步它到 Vox.md 是 iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始從您的語音筆記 Apple Watch 面部和同步它到 Vox.md 是 iPhone."
          }
        }
      }
    },
    "Start and stop voice notes directly from Vox.md on Apple Watch without reaching for your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء ووقف الملاحظات الصوتية مباشرة من Vox.md على Apple Watch دون الوصول إلى iPhone"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু এবং বন্ধ শব্দ নোট সরাসরি থেকে Vox.md এ Apple Watch আপনার জন্য পৌঁছানোর সময় iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten und stoppen Sie Sprachnotizen direkt in Vox.md auf der Apple Watch – ganz ohne zum iPhone zu greifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start and stop voice notes directly from Vox.md on Apple Watch without reaching for your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia y detiene las notas de voz directamente desde Vox.md es Apple Watch Sin llegar a su iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer et arrêter les notes vocales directement à partir de Vox.md est Apple Watch Sans atteindre votre iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज नोट्स को सीधे से शुरू और बंद करें Vox.md है Apple Watch बिना आपके लिए पहुंचने के iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulai dan menghentikan catatan suara langsung dari Vox.md adalah Apple Watch Tanpa sampai ke tempatmu iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvio e fermo delle note vocali direttamente da Vox.md è Apple Watch Senza raggiungere il tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ノートを開始・停止する 直接から Vox.md オイ Apple Watch あなたのために届かないこと iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 및 중지 음성 노트 직접 Vox.md 는 Apple Watch 당신의 곁에 도달하지 않고 iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten en stoppen van spraaknotities direct vanaf Vox.md is Apple Watch Zonder je te bereiken voor iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczęcie i zatrzymanie notatek głosowych bezpośrednio z Vox.md Jest Apple Watch Nie dotarcie do Twojego iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar e parar as notas de voz diretamente a partir do Vox.md É Apple Watch Sem chegar ao seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск и остановка голосовых записей непосредственно от Vox.md Он Apple Watch Не достигая своего iPhone."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Start and stop voice notes - இன் விரைவில் வெளியேறும் Vox.md அனானி Apple Watch உன் காதலின் அடியில் iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มและหยุดบันทึกเสียงโดยตรงจาก Vox.md สะพาน Apple Watch โดยไม่ถึงการของคุณ iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli notlar doğrudan Vox.md ı Apple Watch Senin için ulaşamadan iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск та зупинка голосових записів безпосередньо з Vox.md Є Apple Watch Не досягаючи свого iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع اور بند آواز نوٹس براہ راست سے Vox.md ہے Apple Watch آپ کے لئے نہیں پہنچنے کے لئے iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu và dừng ghi chú thoại trực tiếp từ Vox.md Có Apple Watch Không đạt đến cho bạn iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始和停止语音笔记直接从 Vox.md 是 Apple Watch 没有达到你的 iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始和停止語音筆記直接從 Vox.md 是 Apple Watch 沒有達到你的 iPhone."
          }
        }
      }
    },
