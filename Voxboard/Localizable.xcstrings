    "The transcript could not be attached to the Capture draft.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إرفاق النص المكتوب بمسودة الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সক্রিপ্টটি ক্যাপচার খসড়ায় সংযুক্ত করা যায়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Transkript konnte nicht an den Erfassungsentwurf angehängt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript could not be attached to the Capture draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo adjuntar la transcripción al borrador de la captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre la transcription au brouillon de capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्ट को कैप्चर ड्राफ़्ट में अटैच नहीं किया जा सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrip tidak dapat dilampirkan ke draf Tangkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile allegare la trascrizione alla bozza di acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしをキャプチャの下書きに添付できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사본을 캡처 초안에 첨부할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het transcript kon niet aan het vastlegconcept worden toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dołączyć transkrypcji do wersji roboczej przechwycenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível anexar a transcrição ao rascunho da captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прикрепить транскрипт к черновику захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரைப்படியைப் பிடிப்பு வரைவில் இணைக்க முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถแนบข้อความถอดเสียงไปยังฉบับร่างการจับภาพได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript Yakalama taslağına eklenemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прикріпити транскрипт до чернетки захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسکرپٹ کیپچر ڈرافٹ کے ساتھ منسلک نہیں ہو سکا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đính kèm bản chép lời vào bản nháp ghi nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将转录文本附加到采集草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將逐字稿附加到擷取草稿。"
          }
        }
      }
    },
    "The transcript was created but could not be copied to the clipboard. Copy it from the recording queue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء النص المكتوب لكن تعذّر نسخه إلى الحافظة. انسخه من قائمة انتظار التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সক্রিপ্ট তৈরি হয়েছে কিন্তু ক্লিপবোর্ডে কপি করা যায়নি। রেকর্ডিং সারি থেকে এটি কপি করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Transkript wurde erstellt, konnte aber nicht in die Zwischenablage kopiert werden. Kopieren Sie es aus der Aufnahmewarteschlange."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript was created but could not be copied to the clipboard. Copy it from the recording queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se creó la transcripción, pero no se pudo copiar al portapapeles. Cópiala desde la cola de grabaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription a été créée, mais n’a pas pu être copiée dans le presse-papiers. Copiez-la depuis la file d’attente d’enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्ट बन गई, लेकिन क्लिपबोर्ड पर कॉपी नहीं की जा सकी। इसे रिकॉर्डिंग कतार से कॉपी करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrip sudah dibuat tetapi tidak dapat disalin ke papan klip. Salin dari antrean rekaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione è stata creata ma non è stato possibile copiarla negli Appunti. Copiala dalla coda di registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしは作成されましたが、クリップボードにコピーできませんでした。録音キューからコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사본이 생성되었지만 클립보드에 복사할 수 없습니다. 녹음 대기열에서 복사하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het transcript is gemaakt, maar kon niet naar het klembord worden gekopieerd. Kopieer het vanuit de opnamewachtrij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja została utworzona, ale nie można jej skopiować do schowka. Skopiuj ją z kolejki nagrań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição foi criada, mas não pôde ser copiada para a área de transferência. Copie-a na fila de gravações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт создан, но его не удалось скопировать в буфер обмена. Скопируйте его из очереди записей."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரைப்படி உருவாக்கப்பட்டது, ஆனால் கிளிப்போர்டுக்கு நகலெடுக்க முடியவில்லை. பதிவு வரிசையிலிருந்து அதை நகலெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างข้อความถอดเสียงแล้ว แต่ไม่สามารถคัดลอกไปยังคลิปบอร์ดได้ คัดลอกได้จากคิวการบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript oluşturuldu ancak panoya kopyalanamadı. Kayıt kuyruğundan kopyalayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт створено, але його не вдалося скопіювати в буфер обміну. Скопіюйте його з черги записів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسکرپٹ بن گیا لیکن کلپ بورڈ پر کاپی نہیں ہو سکا۔ اسے ریکارڈنگ کی قطار سے کاپی کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chép lời đã được tạo nhưng không thể sao chép vào bảng nhớ tạm. Hãy sao chép từ hàng đợi ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录文本已生成，但无法拷贝到剪贴板。请从录音队列中拷贝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐字稿已產生，但無法拷貝到剪貼簿。請從錄音佇列中拷貝。"
          }
        }
      }
    },
    "The transcript was saved, but its configured destination did not finish. The source recording was preserved for retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ النص المكتوب، لكن وجهته المُعدّة لم تكتمل. تم الاحتفاظ بالتسجيل المصدر لإعادة المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সক্রিপ্ট সেভ হয়েছে, কিন্তু এর কনফিগার করা গন্তব্য শেষ হয়নি। আবার চেষ্টার জন্য উৎস রেকর্ডিং সংরক্ষিত আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Transkript wurde gesichert, aber das konfigurierte Ziel wurde nicht abgeschlossen. Die Quellaufnahme wurde für einen erneuten Versuch beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript was saved, but its configured destination did not finish. The source recording was preserved for retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción se guardó, pero su destino configurado no terminó. Se conservó la grabación de origen para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription a été enregistrée, mais sa destination configurée n’a pas abouti. L’enregistrement source a été conservé pour un nouvel essai."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्ट सहेजी गई, लेकिन उसका कॉन्फ़िगर किया गया गंतव्य पूरा नहीं हुआ। फिर से प्रयास के लिए स्रोत रिकॉर्डिंग सुरक्षित रखी गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrip disimpan, tetapi tujuan yang dikonfigurasi tidak selesai. Rekaman sumber tetap tersimpan untuk dicoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione è stata salvata, ma la destinazione configurata non è stata completata. La registrazione di origine è stata conservata per un nuovo tentativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしは保存されましたが、設定された保存先への配信が完了しませんでした。再試行のために元の録音は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사본은 저장되었지만 구성된 저장 위치로의 전달이 완료되지 않았습니다. 재시도를 위해 원본 녹음은 보존되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het transcript is bewaard, maar de geconfigureerde bestemming is niet voltooid. De bronopname is behouden om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja została zapisana, ale skonfigurowane miejsce docelowe nie zakończyło działania. Nagranie źródłowe zachowano do ponowienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição foi salva, mas o destino configurado não foi concluído. A gravação de origem foi preservada para nova tentativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт сохранен, но доставка в настроенное место назначения не завершилась. Исходная запись сохранена для повтора."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரைப்படி சேமிக்கப்பட்டது, ஆனால் அதன் உள்ளமைக்கப்பட்ட சேருமிடம் முடிவடையவில்லை. மீண்டும் முயற்சிக்க மூலப் பதிவு பாதுகாக்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อความถอดเสียงแล้ว แต่ปลายทางที่กำหนดค่าไว้ทำงานไม่เสร็จ การบันทึกต้นฉบับได้รับการเก็บรักษาไว้เพื่อลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript kaydedildi ancak yapılandırılmış hedefi tamamlanmadı. Kaynak kayıt yeniden deneme için korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт збережено, але доставка в налаштоване місце призначення не завершилася. Початковий запис збережено для повтору."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسکرپٹ محفوظ ہو گیا، لیکن اس کی ترتیب شدہ منزل مکمل نہیں ہوئی۔ ماخذ ریکارڈنگ دوبارہ کوشش کے لیے محفوظ رکھی گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chép lời đã được lưu nhưng đích đã cấu hình chưa hoàn tất. Bản ghi âm nguồn được giữ để thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录文本已保存，但其配置的目标位置未完成。源录音已保留以便重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐字稿已儲存，但其設定的目標位置未完成。來源錄音已保留以便重試。"
          }
        }
      }
    },
