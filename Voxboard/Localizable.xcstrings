          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیبلٹ کی نمائش"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải keyboard"
          }
        },
        "zh-Hans": {
