    "Voice and text stay on-device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال الصوت والرسالة على الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শব্দ এবং টেক্সট ডিভাইসের উপর থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
