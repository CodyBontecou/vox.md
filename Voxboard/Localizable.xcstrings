    "Recordings, scans and the Today summary use this Route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم التسجيلات والمسوحات وملخص «اليوم» هذا المسار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং, স্ক্যান ও আজকের সারাংশ এই রুট ব্যবহার করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmen, Scans und die Heute-Übersicht nutzen diese Route."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordings, scans and the Today summary use this Route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones, los escaneos y el resumen de Hoy usan esta ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements, les scans et le résumé du jour utilisent cette route."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग, स्कैन और आज का सारांश यह रूट उपयोग करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman, pindaian, dan ringkasan Hari Ini menggunakan Rute ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazioni, scansioni e il riepilogo di oggi usano questo percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音、スキャン、今日のまとめはこのルートを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음, 스캔, 오늘 요약에 이 경로를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnames, scans en het overzicht van vandaag gebruiken deze route."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania, skany i podsumowanie dnia używają tej trasy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravações, digitalizações e o resumo de Hoje usam esta rota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи, сканы и сводка «Сегодня» используют этот маршрут."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவுகள், ஸ்கேன்கள் மற்றும் இன்றைய சுருக்கம் இந்த வழியைப் பயன்படுத்தும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึก การสแกน และสรุปวันนี้ใช้เส้นทางนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar, taramalar ve Bugün özeti bu rotayı kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи, скани й підсумок «Сьогодні» використовують цей маршрут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگز، اسکینز اور آج کا خلاصہ یہ روٹ استعمال کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi, bản quét và tóm tắt Hôm nay dùng Tuyến này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音、扫描和“今天”摘要使用此路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音、掃描和「今天」摘要使用此路線。"
          }
        }
      }
    },
    "Records now and delivers to your iPhone default when it connects.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل الآن ويسلّم إلى الافتراضي على iPhone عند اتصاله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনই রেকর্ড করে এবং iPhone সংযুক্ত হলে ডিফল্টে ডেলিভার করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt jetzt auf und stellt bei Verbindung an deinen iPhone-Standard zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records now and delivers to your iPhone default when it connects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba ahora y entrega en la opción predeterminada del iPhone cuando se conecte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre maintenant et livre vers la route par défaut de l’iPhone à la connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी रिकॉर्ड करता है और iPhone जुड़ने पर डिफ़ॉल्ट पर डिलीवर करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merekam sekarang dan mengirim ke default iPhone saat tersambung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra ora e consegna al predefinito dell’iPhone quando si connette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ録音し、iPhone に接続したときにデフォルトへ配信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 녹음하고 iPhone에 연결되면 기본값으로 전달합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neemt nu op en levert af bij je iPhone-standaard zodra er verbinding is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywa teraz i dostarcza do domyślnej trasy iPhone po połączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava agora e entrega no padrão do iPhone quando ele conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывает сейчас и доставляет в маршрут по умолчанию на iPhone при подключении."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போதே பதிவுசெய்து, iPhone இணைந்ததும் இயல்புநிலைக்கு டெலிவர் செய்யும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกตอนนี้และส่งไปยังค่าเริ่มต้นของ iPhone เมื่อเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi kaydeder ve bağlandığında iPhone varsayılanına teslim eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записує зараз і доставляє в маршрут за замовчуванням на iPhone після під’єднання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی ریکارڈ کرتا ہے اور جڑنے پر iPhone کے ڈیفالٹ پر ڈیلیور کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi ngay và gửi đến mặc định của iPhone khi kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即录音，并在连接后送达 iPhone 上的默认路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即錄音，並在連線後送達 iPhone 上的預設路線。"
          }
        }
      }
    },
