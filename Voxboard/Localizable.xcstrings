    "Cancelled or previous recording sessions can no longer replace or clear the text from a newer recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استبدال أو إلغاء جلسات تسجيل السابقة أو إزالة النص من تسجيل أحدث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাতিল বা আগের রেকর্ডিং সেশনগুলি আর নতুন রেকআপ থেকে টেক্সট প্রতিস্থাপন বা মুছে ফেলতে পারে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochene oder frühere Aufnahmesitzungen können den Text einer neueren Aufnahme nicht mehr ersetzen oder löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled or previous recording sessions can no longer replace or clear the text from a newer recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones de grabación canceladas o anteriores ya no pueden reemplazar o borrar el texto de una grabación más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions d'enregistrement annulées ou précédentes ne peuvent plus remplacer ou supprimer le texte d'une enregistrement plus récente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द या पिछले रिकॉर्डिंग सत्र अब एक नए रिकॉर्डिंग से पाठ को प्रतिस्थापित या हटाने में सक्षम नहीं हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi rekaman yang dibatalkan atau sebelumnya tidak lagi dapat menggantikan atau menghapus teks dari rekaman baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni di registrazione annullate o precedenti non possono più sostituire o cancellare il testo da una registrazione più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルされたまたは以前の録音セッションは、新しい録音からテキストを置き換えたり削除したりすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소된 또는 이전 녹음 세션은 더 이상 새 녹음에서 텍스트를 대체하거나 삭제할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Getrokken of eerdere opnamesessies kunnen de tekst van een nieuwere opname niet meer vervangen of verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowane lub poprzednie sesje nagrywania nie mogą już zastępować ani usuwać tekstu z nowszych sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões de gravação canceladas ou anteriores não podem mais substituir ou excluir o texto de uma gravação mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменены или предыдущие сессии записи больше не могут заменить или удалить текст из более новой записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முந்தைய பதிவிறக்க அல்லது பதிவிறக்க முறைகள் இப்போது பதிவிறக்க அல்லது பதிவிறக்க முறைகளில் பதிவிறக்க செய்ய முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกที่ถูกลบหรือการบันทึกก่อนหน้านี้ไม่สามารถแทนที่หรือลบข้อความจากบันทึกใหม่ได้อีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edilmiş veya önceki kayıt oturumları artık yeni bir kayıttan metni değiştiremez veya silemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відмінені або попередні сеанси запису більше не можуть замінити або видалити текст з нового запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف یا پچھلے ریکارڈنگ سیشنز کو اب نئے ریکارڈنگ سے متن کو تبدیل یا حذف نہیں کر سکتے ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phiên ghi đã hủy hoặc trước đó không thể thay thế hoặc xóa văn bản từ một bản ghi mới hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消或以前的录音会话不再可以替代或清除新录音中的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消或以前的錄音會話不再可以替代或清除新錄音中的文本。"
          }
        }
      }
    },
