    "This destination belongs to this route, including its note target, placement, formatting, attachments, and retry behavior.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الوجهة خاصة بهذا المسار، بما في ذلك الملاحظة المستهدفة والموضع والتنسيق والمرفقات وسلوك إعادة المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই গন্তব্যটি এই রুটের, যার মধ্যে আছে নোটের লক্ষ্য, স্থান, ফরম্যাটিং, অ্যাটাচমেন্ট ও পুনরায় চেষ্টার আচরণ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ziel gehört zu dieser Route, einschließlich Notizziel, Platzierung, Formatierung, Anhängen und Verhalten bei erneuten Versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
