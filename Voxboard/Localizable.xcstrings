    "Pinning adds Capture Bar quick actions without changing your default or keyboard route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف التثبيت إجراءات سريعة إلى شريط الالتقاط دون تغيير المسار الافتراضي أو مسار لوحة المفاتيح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন করলে আপনার ডিফল্ট বা কীবোর্ড রুট না বদলে ক্যাপচার বারে কুইক অ্যাকশন যোগ হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Anheften werden Schnellaktionen zur Erfassungsleiste hinzugefügt, ohne Ihre Standard- oder Tastaturroute zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinning adds Capture Bar quick actions without changing your default or keyboard route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar añade acciones rápidas a la barra de captura sin cambiar tu ruta predeterminada ni la del teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’épinglage ajoute des actions rapides à la barre de capture sans modifier votre parcours par défaut ni celui du clavier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन करने से आपका डिफ़ॉल्ट या कीबोर्ड रूट बदले बिना कैप्चर बार क्विक ऐक्शन जुड़ जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyematkan akan menambahkan tindakan cepat Bilah Tangkapan tanpa mengubah rute default atau rute papan ketik Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissare un percorso aggiunge azioni rapide alla barra di acquisizione senza cambiare il percorso predefinito o quello della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めすると、デフォルトのルートやキーボードのルートを変更せずに、キャプチャバーのクイックアクションに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정하면 기본 루트나 키보드 루트를 변경하지 않고 캡처 막대 빠른 동작이 추가됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastzetten voegt snelle acties toe aan de vastlegbalk zonder je standaard- of toetsenbordroute te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypinanie dodaje szybkie akcje do paska przechwytywania bez zmiany trasy domyślnej ani trasy klawiatury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixar adiciona ações rápidas à Barra de Captura sem alterar sua rota padrão nem a do teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепление добавляет быстрые действия на панель захвата, не меняя маршрут по умолчанию и маршрут клавиатуры."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொருத்துவது உங்கள் இயல்புநிலை அல்லது விசைப்பலகை வழித்தடத்தை மாற்றாமல் பிடிப்புப் பட்டி விரைவுச் செயல்களைச் சேர்க்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปักหมุดจะเพิ่มการทำงานด่วนบนแถบจับภาพโดยไม่เปลี่ยนเส้นทางเริ่มต้นหรือเส้นทางของแป้นพิมพ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitleme, varsayılan veya klavye rotanızı değiştirmeden Yakalama Çubuğu hızlı eylemleri ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закріплення додає швидкі дії на панель захоплення, не змінюючи типовий маршрут і маршрут клавіатури."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پن کرنا آپ کے ڈیفالٹ یا کی بورڈ روٹ کو تبدیل کیے بغیر کیپچر بار کی فوری کارروائیاں شامل کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghim sẽ thêm tác vụ nhanh vào Thanh ghi nhanh mà không đổi lộ trình mặc định hay lộ trình bàn phím của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定后会添加采集栏快捷操作，但不会更改你的默认路线或键盘路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釘選後會加入擷取列快速動作，但不會變更你的預設路線或鍵盤路線。"
          }
        }
      }
    },
