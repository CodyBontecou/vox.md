            "state": "translated",
            "value": "Ngôn ngữ hệ thống"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统语言"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統語言"
          }
        }
      }
    },
    "System Language follows your device language. Choose a language explicitly when the recording uses another language.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع لغة النظام لغة الجهاز. اختر لغة بشكل واضح عندما يستخدم التسجيل لغة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম ভাষা আপনার ডিভাইসের ভাষার অনুসরণ করে. রেকর্ডিং করার সময় অন্য ভাষা ব্যবহার করার সময় একটি ভাষা স্পষ্টভাবে নির্বাচন করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemsprache folgt der Sprache Ihres Geräts. Wählen Sie eine Sprache ausdrücklich aus, wenn die Aufnahme eine andere Sprache verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Language follows your device language. Choose a language explicitly when the recording uses another language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma del sistema sigue el idioma del dispositivo. Seleccione un idioma explícitamente cuando la grabación utilice otro idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le langage système suit la langue de votre appareil. Choisissez une langue explicitement lorsque l'enregistrement utilise une autre langue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम भाषा आपके डिवाइस की भाषा का पालन करती है. रिकॉर्डिंग के लिए एक अन्य भाषा का उपयोग करते समय एक भाषा को स्पष्ट रूप से चुनें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Bahasa mengikuti bahasa perangkat Anda. Pilih bahasa secara eksplisit ketika rekaman menggunakan bahasa lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il linguaggio del sistema segue la lingua del dispositivo. Scegliere una lingua esplicitamente quando la registrazione utilizza un'altra lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム言語は、デバイスの言語に従います。 録音に別の言語を使用する場合、言語を明示的に選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 언어는 장치 언어를 따릅니다. 녹음에 다른 언어를 사용하는 경우 언어를 명시적으로 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeemtaal volgt de taal van uw apparaat. Kies een taal expliciet wanneer de opname een andere taal gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Język systemu jest zgodny z językiem urządzenia. Wybierz język wyraźnie, gdy nagrywanie będzie wykonywane w innym języku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma do sistema segue o idioma do seu dispositivo. Escolha um idioma explicitamente quando a gravação usar outro idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык системы следует за языком вашего устройства. Выберите язык явно, когда запись использует другой язык."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கணினியில் உள்ள ஒரு மொழியை தேர்வு செய்து, உங்கள் கணினியில் வேறு மொழியைப் பயன்படுத்தும் போது ஒரு மொழியை தேர்வு செய்யவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาษาระบบตามภาษาของอุปกรณ์ของคุณ เลือกภาษาอย่างชัดเจนเมื่อการบันทึกใช้ภาษาอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem dili cihazınızın dilini takip eder. Kayıt sırasında başka bir dil kullanıldığında açıkça bir dil seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системна мова слідує за мовою вашого пристрою. Виберіть мову явно, коли для запису використовується інша мова."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی آلہ کی زبان کے بعد سسٹم زبان. جب ریکارڈنگ میں ایک اور زبان استعمال ہوتا ہے تو ایک زبان کو واضح طور پر منتخب کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ hệ thống theo ngôn ngữ thiết bị của bạn. Chọn một ngôn ngữ rõ ràng khi ghi âm sử dụng một ngôn ngữ khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统语言跟随设备的语言. 当录音使用其他语言时,明确选择一种语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統語言跟隨設備的語言. 當錄音使用其他語言時,明確選擇一種語言。"
          }
        }
      }
    },
