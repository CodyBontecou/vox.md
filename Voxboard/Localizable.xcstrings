        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać transkrypcji. Nagranie pozostaje dołączone do projektu Capture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O transcrito não foi salvo.A gravação permanece anexada ao projeto de captura."
