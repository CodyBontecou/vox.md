    },
    "Could not resume this recording. Stop to save what was captured.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن من إعادة إدخال هذا التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডিং পুনরায় করতে পারিনি. যা ধরা হয়েছে তা সংরক্ষণ বন্ধ করুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme konnte nicht fortgesetzt werden. Stoppen Sie, um das bereits Erfasste zu sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not resume this recording. Stop to save what was captured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudo retomar esta grabación.Deja de guardar lo capturado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pouvait pas reprendre cette enregistrement. Arrêtez de sauvegarder ce qui a été capturé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्डिंग को फिर से नहीं किया जा सकता. कैप्शन किए गए सब कुछ को बचाने के लिए बंद करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat melanjutkan rekaman ini. berhenti menyimpan apa yang ditangkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile riprendere questa registrazione. Smettere di salvare ciò che è stato catturato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を再開できませんでしたので、保存を停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음을 다시 시작할 수 없었습니다. 캡처 된 것을 저장하는 중지."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan deze opname niet hervatten. Stop met het opslaan van wat is vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można było wznowić nagrywania.Zatrzymaj to, co zostało przechwycone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegui retomar a gravação.Pare de salvar o que foi capturado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не смог возобновить эту запись. Перестаньте сохранять то, что было захвачено."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவை மீண்டும் படிக்க முடியவில்லை.இந்த பதிவை படித்து முடித்தவுடன் எழுதலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถรีสตาร์ทการบันทึกนี้ได้ หยุดเพื่อบันทึกสิ่งที่ถูกจับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıtları tekrar edemiyorum.Kapattığı şeyi kaydetmeye durun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо відновити запис. перестаньте зберігати те, що було захоплено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کی ریکارڈنگ کو دوبارہ نہیں کر سکتے. محفوظ کرنے کے لئے روکنے کے لئے جو پکڑ لیا گیا تھا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tiếp tục ghi lại.Đừng lưu những gì đã bị bắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复录音,停止保存被捕获的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法恢復錄音,停止保存被捕獲的內容。"
          }
        }
      }
    },
