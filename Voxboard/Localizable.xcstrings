          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie jest bezpieczne dzięki statusowi lokalizacji w czasie pochodzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação é segura com seu status de localização no horário de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись безопасна благодаря своему статусу места происхождения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ரெக்கார்டிங் அதன் அசல் நேர இருப்பிட நிலையுடன் பாதுகாப்பாக உள்ளது."
