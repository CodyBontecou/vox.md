          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatka została uratowana, Ale jego audio-przełącznik nie powiodł się. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota foi salvo, Mas o seu anexo de áudio falhou. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер был спасен, Но его аудиоприложение потерпело неудачу. %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுத்து காப்பாற்றப்பட்டது ஆனால் அவரது audio attachment நஷ்டமாகிவிட்டது. %@"
