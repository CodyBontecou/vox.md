          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz emoji, aby je zastosować, lub wybierz Symbole, aby użyć symbolu SF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um emoji para aplicar ou escolha Símbolos para usar um SF Symbol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите эмодзи для применения или выберите «Символы», чтобы использовать символ SF."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்படுத்த ஒரு எமோஜியை உள்ளிடவும், அல்லது SF Symbol ஐப் பயன்படுத்த சின்னங்கள் என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนอีโมจิเพื่อใช้ หรือเลือก “สัญลักษณ์” เพื่อใช้ SF Symbol"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamak için bir emoji girin veya bir SF simgesi kullanmak için Simgeler'i seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть емодзі для застосування або виберіть «Символи», щоб використати символ SF."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لاگو کرنے کے لیے ایک ایموجی درج کریں، یا SF Symbol استعمال کرنے کے لیے علامات منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập một emoji để áp dụng hoặc chọn Biểu tượng để dùng một SF Symbol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入要应用的表情符号，或选择“符号”以使用 SF Symbol 符号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入要套用的表情符號，或選擇「符號」以使用 SF Symbol 符號。"
          }
        }
      }
    },
    "Enter one complete emoji, not multiple emoji or other text.": {
      "localizations": {
        "ar": {
