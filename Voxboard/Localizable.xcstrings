    "Shared capture storage is unavailable. Reinstall Vox.md or verify its App Group entitlement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أجهزة تثبيت مشتركة.إعادة تثبت Vox.md أو تحقق من حقها في مجموعة التطبيقات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেয়ার করা ক্যাপচার স্টোরেজ অসম্ভব। পুনর্নির্মাণ Vox.md অথবা আপনার অ্যাপ গ্রুপের অধিকার নিশ্চিত করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der geteilte Erfassungsspeicher ist nicht verfügbar. Installieren Sie Vox.md neu oder prüfen Sie die App-Group-Berechtigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared capture storage is unavailable. Reinstall Vox.md or verify its App Group entitlement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento compartido no está disponible. Reinstalación Vox.md o verificar su aptitud de grupo de aplicaciones."
