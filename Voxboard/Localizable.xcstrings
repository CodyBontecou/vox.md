    "Whisper and Parakeet models run locally with Metal/Core ML acceleration.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشغيل النماذج Whisper و Parakeet على المستوى المحلي مع تسلل Metal/Core ML."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper এবং Parakeet মডেলগুলি স্থানীয়ভাবে মেটাল / কোর ML গতিশীলতা দিয়ে চলছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper- und Parakeet-Modelle laufen lokal mit Metal/Core-ML-Beschleunigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper and Parakeet models run locally with Metal/Core ML acceleration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper y Parakeet Los modelos funcionan localmente con la aceleración Metal/Core ML."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper et Parakeet Les modèles fonctionnent localement avec l'accélération Metal/Core ML."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper और Parakeet मॉडल स्थानीय रूप से धातु / कोर एमएल ग्रेड के साथ चलते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper dan Parakeet Model ini berjalan secara lokal dengan akselerasi Metal/Core ML."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper e Parakeet I modelli sono eseguiti localmente con accelerazione ML Metal/Core."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper 和 Parakeet 現地でMetal/Core ML 加速を搭載する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper 그리고 Parakeet 모델은 Metal/Core ML 가속도로 로컬로 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper en Parakeet De modellen worden lokaal uitgevoerd met Metal/Core ML-versnelling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper i Parakeet Modele działają lokalnie z przyspieszeniem Metal/Core ML."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper e Parakeet Os modelos são executados localmente com a aceleração Metal/Core ML."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper и Parakeet Модели работают локально с ускорением Metal/Core ML."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper அ Parakeet மாதிரிகள் Metal/Core ML Acceleration மூலம் இடையில் இயங்குகின்றன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper และ Parakeet รุ่นทํางานในท้องถิ่นด้วยความเร็วโลหะ / Core ML"
          }
        },
        "tr": {
