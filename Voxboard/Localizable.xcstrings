          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио (%@) потеряно: запись не успевала."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுதி ஈடுகொடுக்க முடியாததால் %@ ஒலி கைவிடப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
