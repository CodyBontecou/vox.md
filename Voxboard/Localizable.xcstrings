    "Speaker identification could not process this recording.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker identification could not process this recording."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على تحديد المتحدثين معالجة هذا التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্পিকার শনাক্তকরণ এই রেকর্ডিং প্রক্রিয়া করতে পারেনি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprechererkennung konnte diese Aufnahme nicht verarbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identificación de hablantes no pudo procesar esta grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identification des orateurs n'a pas pu traiter cet enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पीकर पहचान इस रिकॉर्डिंग को प्रोसेस नहीं कर सकी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifikasi pembicara tidak dapat memproses rekaman ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identificazione degli oratori non ha potuto elaborare questa registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話者識別でこの録音を処理できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화자 식별이 이 녹음을 처리하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprekerherkenning kon deze opname niet verwerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Identyfikacja mówców nie mogła przetworzyć tego nagrania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identificação de falantes não pôde processar esta gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обработать эту запись с распознаванием говорящих."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பேச்சாளர் அடையாளம் இந்தப் பதிவைச் செயலாக்க முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การระบุผู้พูดไม่สามารถประมวลผลการบันทึกนี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmacı tanımlama bu kaydı işleyemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося обробити цей запис із розпізнаванням мовців."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسپیکر شناخت اس ریکارڈنگ کو پروسیس نہیں کر سکی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận dạng người nói không thể xử lý bản ghi này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话人识别无法处理此录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說話者識別無法處理此錄音。"
          }
        }
      }
    },
    "Speaker identification was skipped because its model could not be prepared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker identification was skipped because its model could not be prepared."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطي تحديد المتحدثين لأنه تعذّر تجهيز النموذج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেল প্রস্তুত করা যায়নি বলে স্পিকার শনাক্তকরণ বাদ দেওয়া হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprechererkennung wurde übersprungen, weil das Modell nicht vorbereitet werden konnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitió la identificación de hablantes porque no se pudo preparar el modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identification des orateurs a été ignorée parce que le modèle n'a pas pu être préparé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल तैयार नहीं किया जा सका, इसलिए स्पीकर पहचान छोड़ दी गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifikasi pembicara dilewati karena model tidak dapat disiapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identificazione degli oratori è stata ignorata perché non è stato possibile preparare il modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを準備できなかったため、話者識別はスキップされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 준비할 수 없어 화자 식별을 건너뛰었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprekerherkenning is overgeslagen omdat het model niet kon worden voorbereid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominięto identyfikację mówców, ponieważ nie można było przygotować modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identificação de falantes foi ignorada porque não foi possível preparar o modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание говорящих пропущено, поскольку не удалось подготовить модель."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாதிரியைத் தயார் செய்ய முடியாததால் பேச்சாளர் அடையாளம் தவிர்க்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้ามการระบุผู้พูดเนื่องจากเตรียมโมเดลไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model hazırlanamadığı için konuşmacı tanımlama atlandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовців пропущено, оскільки не вдалося підготувати модель."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماڈل تیار نہ ہو سکنے کی وجہ سے اسپیکر شناخت چھوڑ دی گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bỏ qua nhận dạng người nói vì không thể chuẩn bị mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因无法准备模型，已跳过说话人识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因無法準備模型，已略過說話者識別。"
          }
        }
      }
    },
    "Speaker identification was skipped because model storage was unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker identification was skipped because model storage was unavailable."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطي تحديد المتحدثين لأن تخزين النموذج غير متوفر."
          }
        },
        "bn": {
          "stringUnit": {
