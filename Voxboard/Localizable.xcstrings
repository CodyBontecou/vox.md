        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza Vox.md en el iPhone para usar la ruta de esta grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour Vox.md sur l’iPhone pour utiliser le parcours de cet enregistrement."
