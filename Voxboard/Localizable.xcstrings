    "Recording continues. Tap Stop on the keyboard when done.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التوقف على المفاتيح عند الانتهاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং চলছে. ট্যাপ বন্ধ কীবোর্ডে শেষ হলে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme läuft weiter. Tippen Sie auf der Tastatur auf „Stopp“, wenn Sie fertig sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording continues. Tap Stop on the keyboard when done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación continúa.Tap de parada en el teclado cuando se haya hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement continue. Tapez Stop sur le clavier lorsque vous avez terminé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग जारी है. टेप बंद करने के बाद कीबोर्ड पर टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman terus berlanjut. tekan Stop pada keyboard saat selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione continua. Toccare Stop sul tastierino quando è finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は続きます. 完成したときにキーボードで停止をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 계속됩니다. 탭을 멈추기 키보드에 완료 되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname gaat door. Tik op Stop op het toetsenbord wanneer het is gedaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie trwa. Po zakończeniu naciśnij przycisk Stop na klawiaturze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação continua.Tappa Stop no teclado quando concluído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись продолжается. Нажатие на клавиатуру, когда вы закончили."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இறுதிப் போட்டியில், பீட்டர் முடிந்ததும் அணியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจะดําเนินการต่อ เทป Stop บนแป้นพิมพ์เมื่อเสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt devam ediyor.Klavyeyi durdurun tuşuna basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис продовжується. Натисніть Stop на клавіатурі, коли ви зробите це."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹائپ کریں، ٹائپ کریں، ٹائپ کریں، ٹائپ کریں، ٹائپ کریں، ٹائپ کریں، ٹائپ کریں، ٹائ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy lại.Tạm dừng trên bàn phím khi đã hoàn thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制继续. 按下停止键盘完成后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製繼續. 按下停止鍵盤完成後。"
          }
        }
      }
