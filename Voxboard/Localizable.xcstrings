    "Manage queued audio and choose processing and retention defaults": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إدارة الصوت في قائمة الانتظار واختيار الإعدادات الافتراضية للمعالجة والاحتفاظ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সারিতে থাকা অডিও পরিচালনা করুন এবং প্রসেসিং ও সংরক্ষণের ডিফল্ট বেছে নিন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartende Audiodateien verwalten und Standards für Verarbeitung und Aufbewahrung festlegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage queued audio and choose processing and retention defaults"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona el audio en cola y elige los valores predeterminados de procesamiento y retención"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérer l’audio en file d’attente et choisir les réglages par défaut de traitement et de conservation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कतार वाले ऑडियो को प्रबंधित करें और प्रोसेसिंग व रिटेंशन डिफ़ॉल्ट चुनें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola audio dalam antrean dan pilih default pemrosesan dan retensi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci l’audio in coda e scegli le impostazioni predefinite di elaborazione e conservazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュー内のオーディオを管理し、処理と保持のデフォルトを選択します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열의 오디오를 관리하고 기본 처리 및 보관 설정을 선택합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer audio in de wachtrij en kies standaardinstellingen voor verwerking en bewaartermijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj audio w kolejce oraz wybierz domyślne przetwarzanie i przechowywanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie o áudio na fila e escolha os padrões de processamento e retenção"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление аудио в очереди и выбор параметров обработки и хранения по умолчанию"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரிசையிலுள்ள ஒலியை நிர்வகித்து, செயலாக்கம் மற்றும் தக்கவைப்பு இயல்புநிலைகளைத் தேர்ந்தெடுக்கவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการเสียงในคิว และเลือกค่าเริ่มต้นของการประมวลผลและการเก็บรักษา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruktaki sesi yönetin ve işleme ile saklama varsayılanlarını seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керування аудіо в черзі та вибір типових параметрів обробки й зберігання"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطار میں موجود آڈیو کا نظم کریں اور پروسیسنگ اور برقراری کے ڈیفالٹس منتخب کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý âm thanh trong hàng đợi và chọn mặc định xử lý và lưu giữ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理队列中的音频，并选择处理和保留默认设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理佇列中的音訊，並選擇處理和保留預設設定"
          }
        }
      }
    },
