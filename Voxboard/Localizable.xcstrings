    "Drag actions into the order you want. Turn off actions you do not want on the capture bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحريك الأفعال في الترتيب الذي تريد، إلغاء الأفعالات التي لا تريدها في حزام الصدمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ইচ্ছা আদেশে কাজগুলি ড্রাগ করুন. ক্যাপচার বারের উপর আপনি যা চান না তা বন্ধ করুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie Aktionen in die gewünschte Reihenfolge. Deaktivieren Sie Aktionen, die Sie nicht in der Erfassungsleiste möchten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag actions into the order you want. Turn off actions you do not want on the capture bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar las acciones que no desea en la barra de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les actions dans l'ordre que vous voulez. Désactiver les actions que vous ne voulez pas sur la barre de capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो चाहते हैं उससे आगे बढ़ें. आप जो नहीं चाहते हैं, उसे कैप्चर बार पर बंद करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik tindakan ke dalam urutan yang Anda inginkan. Hapus tindakan yang tidak Anda inginkan di bar capture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascinare le azioni nell'ordine desiderato. Disattivare le azioni che non si desidera nella barra di cattura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションを望む順に引きずり、キャプチャバーで望まないアクションをオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 순서로 작업을 끌어 내십시오. 캡처 바에서 원하지 않는 작업을 끄십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai acties in de gewenste volgorde. Schakel acties uit die u niet wilt op de opnamebalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij akcje w kolejności, w której chcesz. Wyłącz akcje, których nie chcesz na pasku przechwytywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue as ações que não deseja na barra de captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите действия в желаемом порядке. Выключите действия, которые вы не хотите на панели захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் விரும்பும் வகையில் நடவடிக்கைகளை சுருக்க.செய்யாத நடவடிக்கைகளை அழுத்த வரிசையில் மூடவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากการกระทําตามลําดับที่คุณต้องการ ปิดการกระทําที่คุณไม่ต้องการในแถบจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz şekilde hareket ettirin.Kapma çubuğunda istemeyeceğiniz eylemleri kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть дії у потрібний порядок. Вимкніть дії, які ви не хочете на панелі захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ چاہتے ہیں کہ آپ کی ترتیب میں کارروائیوں کو ہٹا دیں. آپ کی ضرورت نہیں ہے کہ آپ کو اس کی شکل میں شامل کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo các hành động theo thứ tự bạn muốn. Tắt các hành động bạn không muốn trên thanh chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将操作拖入您想要的顺序. 在捕捉栏上关闭您不想要的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將操作拖入您想要的順序. 在捕捉欄上關閉您不想要的操作。"
          }
        }
      }
    },
    "Draw with a mouse, trackpad, or connected tablet.": {
      "localizations": {
        "ar": {
