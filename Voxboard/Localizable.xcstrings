        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorizzazione viene richiesta solo quando la concedi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス許可は、許可したときにのみ要求されます"
