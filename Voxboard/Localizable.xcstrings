    "The reserved filename belongs to another Files folder. Choose a recording-only preset to retarget it explicitly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضم اسم الملف المخصص إلى ملف \"الملفات\" آخر. اختر إعداداً مبدئياً فقط لتحديد هدفه بشكل واضح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত ফাইল নামটি অন্য ফাইল ফোল্ডারে রয়েছে. এটি স্পষ্টভাবে পুনরায় লক্ষ্য করার জন্য একটি রেকর্ডিং-সুবিধে পূর্ব সেট নির্বাচন করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der reservierte Dateiname gehört zu einem anderen Dateien-Ordner. Wählen Sie ein Nur-Aufnahme-Preset, um ihn explizit umzuleiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reserved filename belongs to another Files folder. Choose a recording-only preset to retarget it explicitly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de archivo reservado pertenece a otra carpeta Archivos. Seleccione un predefinido de grabación para retargetarlo explícitamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de fichier réservé appartient à un autre dossier Fichiers. Choisissez une pré-configuration uniquement pour l'enregistrer pour le cibler explicitement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल नाम एक अन्य फ़ोल्डर में है. इसे स्पष्ट रूप से फिर से लक्षित करने के लिए एक रिकॉर्डिंग-केवल पूर्वानुमान चुनें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama file yang disimpan milik folder File lain. Pilih preset hanya untuk merekam untuk secara eksplisit mengarahkan kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome del file riservato appartiene a un'altra cartella File. Scegliere una preimpostazione solo per la registrazione per rivolgersi esplicitamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約されたファイル名は別のファイルフォルダに属します. 録音のみのプレセットを選択して、明示的にリターゲットします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약된 파일 이름은 다른 파일 폴더에 속합니다. 기록만 사용하는 프리셋을 선택하여 명시적으로 다시 대상으로 설정합니다.The reserved file name belongs to another Files folder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gereserveerde bestandsnaam behoort tot een andere map Bestanden. Kies een voorinstelling voor alleen opname om deze expliciet opnieuw te richten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastrzeżona nazwa pliku należy do innego folderu Pliki. Wybierz ustawienie wstępne tylko do nagrywania, aby wyraźnie ją ponownie ukierunkować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome de arquivo reservado pertence a outra pasta Arquivos. Selecione uma predefinição de gravação somente para redirecioná-lo explicitamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарезервированное имя файла принадлежит другой папке «Файлы». Выберите предварительную настройку для записи, чтобы перенацелить его явно."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒதுக்கப்பட்ட கோப்புப்பெயர் மற்றொரு Files கோப்புறைக்குச் சொந்தமானது. அதை வெளிப்படையாக மாற்ற, பதிவு மட்டும் கொண்ட முன்தொகுப்பைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อไฟล์ที่เก็บไว้เป็นส่วนหนึ่งของโฟลเดอร์ไฟล์อื่น เลือกการตั้งค่าล่วงหน้าเฉพาะการบันทึกเพื่อเป้าหมายใหม่อย่างชัดเจน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervasyonlu dosya adı başka bir Dosya klasörüne aittir. açıkça yeniden hedeflemek için sadece kayıt öncesi bir ayar seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарезервоване ім'я файлу належить до іншої папки \"Файли\". Виберіть попереднє налаштування, яке дозволяє тільки записувати, щоб перенапрямувати його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک اور فائلوں کے پاس محفوظ فائل کا نام ہے. صرف ریکارڈنگ کی پیشگی ترتیبات کو منتخب کریں تاکہ اسے واضح طور پر ہدف بنا لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên tệp được bảo lưu thuộc về thư mục File khác. Chọn một thiết đặt trước chỉ ghi để nhắm mục tiêu lại rõ ràng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的文件名属于另一个文件文件夹. 选择仅用于录制的预设,以明确地重新定位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的文件名屬於另一個文件文件夾. 選擇僅用於錄製的預設,以明確地重新定位。"
          }
        }
      }
    },
