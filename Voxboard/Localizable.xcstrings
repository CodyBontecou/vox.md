    "Apple Intelligence is off — turn it on above to apply this mode to voice transcriptions and Capture text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence متوقف — شغّله أعلاه لتطبيق هذا الوضع على النسخ الصوتية ونص الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence বন্ধ — ভয়েস ট্রান্সক্রিপশন ও ক্যাপচার টেক্সটে এই মোড প্রয়োগ করতে উপরে এটি চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist deaktiviert – aktivieren Sie es oben, um diesen Modus auf Sprachtranskriptionen und Erfassungstext anzuwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is off — turn it on above to apply this mode to voice transcriptions and Capture text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado; actívalo arriba para aplicar este modo a las transcripciones de voz y al texto de la captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé : activez-le ci-dessus pour appliquer ce mode aux transcriptions vocales et au texte de la capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence बंद है — आवाज़ के ट्रांसक्रिप्शन और कैप्चर टेक्स्ट पर यह मोड लागू करने के लिए इसे ऊपर चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence nonaktif — nyalakan di atas untuk menerapkan mode ini ke transkripsi suara dan teks Tangkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivata: attivala qui sopra per applicare questa modalità alle trascrizioni vocali e al testo delle acquisizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceはオフです — 音声の文字起こしとキャプチャのテキストにこのモードを適用するには、上でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 꺼져 있습니다. 음성 전사와 캡처 텍스트에 이 모드를 적용하려면 위에서 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence staat uit – zet het hierboven aan om deze modus toe te passen op spraaktranscripties en vastlegtekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence jest wyłączone — włącz je powyżej, aby zastosować ten tryb do transkrypcji głosu i tekstu przechwyceń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada — ative-a acima para aplicar este modo às transcrições de voz e ao texto da captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence выключен — включите выше, чтобы применять этот режим к голосовым транскрипциям и тексту захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence முடக்கப்பட்டுள்ளது — குரல் உரைமாற்றங்களுக்கும் பிடிப்பு உரைக்கும் இந்தப் பயன்முறையைப் பயன்படுத்த மேலே இயக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ปิดอยู่ — เปิดด้านบนเพื่อใช้โหมดนี้กับการถอดเสียงพูดและข้อความการจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kapalı — bu modu ses transkripsiyonlarına ve Yakalama metnine uygulamak için yukarıdan açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence вимкнено — увімкніть вище, щоб застосовувати цей режим до голосових транскрипцій і тексту захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence بند ہے — یہ موڈ آواز کی ٹرانسکرپشنز اور کیپچر متن پر لاگو کرنے کے لیے اوپر اسے آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence đang tắt — bật ở trên để áp dụng chế độ này cho bản chép lời giọng nói và văn bản ghi nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 已关闭——请在上方打开，以将此模式应用于语音转录和采集文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 已關閉——請在上方開啟，以將此模式套用於語音轉錄和擷取文字。"
          }
        }
      }
    },
    "Apple Intelligence is preparing its on-device model.": {
      "comment": "On-device image descriptions: preset control, help, availability, or capture progress.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحضّر Apple Intelligence نموذجه على الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ডিভাইসে তার মডেল প্রস্তুত করছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence bereitet sein Modell auf dem Gerät vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is preparing its on-device model."
          }
        },
        "es": {
          "stringUnit": {
