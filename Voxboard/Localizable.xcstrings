    "Download the selected local model, or choose Automatic to use Apple Speech when available. Audio recording still works.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحميل النماذج المحلية المختارة، أو اختيار تلقائي لاستخدام Apple Speech عندما تكون متاحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচন করা স্থানীয় মডেলটি ডাউনলোড করুন, অথবা ব্যবহারের জন্য স্বয়ংক্রিয় নির্বাচন করুন Apple Speech যখন পাওয়া যায়। অডিও রেকর্ডিং এখনও কাজ করছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie das ausgewählte lokale Modell herunter oder wählen Sie Automatisch, um Apple Speech zu nutzen, wenn verfügbar. Audioaufnahmen funktionieren weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the selected local model, or choose Automatic to use Apple Speech when available. Audio recording still works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga el modelo local seleccionado, o seleccione Automatic para usar Apple Speech cuando esté disponible. La grabación de audio sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger le modèle local sélectionné, ou choisissez Automatique pour utiliser Apple Speech quand elle est disponible. L’enregistrement audio fonctionne toujours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने हुए स्थानीय मॉडल को डाउनलोड करें, या स्वचालित रूप से उपयोग करने के लिए चुनें Apple Speech जब उपलब्ध हो। ऑडियो रिकॉर्डिंग अभी भी काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Download model lokal yang dipilih, atau pilih Automatic untuk digunakan Apple Speech Ketika tersedia Audio recording masih berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica il modello locale selezionato, o selezionare Automatico per utilizzare Apple Speech quando è disponibile. L’audio di registrazione funziona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した地元モデルをダウンロードするには、 自動で使用するかを選択します。 Apple Speech 利用可能な時 音声録音もまだ機能している。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 모델을 다운로드하여, 또는 사용하기 위해 자동으로 선택 Apple Speech 이용할 수 있을 때 오디오 녹음은 아직도 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download het geselecteerde lokale model, of selecteer Automatisch om te gebruiken Apple Speech wanneer beschikbaar is. De audio-opname werkt nog steeds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz wybrany model lokalny, lub wybierz pozycję Automatyczne do użycia Apple Speech Gdy jest dostępny. Nagrywanie audio nadal działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe o modelo local selecionado, Escolha automático para usar Apple Speech quando disponível . A gravação de áudio ainda funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачать выбранную локальную модель, или выберите Автоматическое использование Apple Speech когда они доступны. Аудиозапись продолжает работать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்வு செய்யப்பட்ட மாதிரி பதிவிறக்க, அல்லது AutoCAD தேர்வு செய்யவும் Apple Speech கிடைத்தால் Audio Recording இப்போது வேலை செய்கிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดรุ่นท้องถิ่นที่เลือก หรือเลือก อัตโนมัติเพื่อใช้ Apple Speech เมื่อมี การบันทึกเสียงยังคงทํางาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen yerel modelini indirin, veya Otomatik olarak kullanmak için Apple Speech mevcut olduğunda Audio kaydı hala çalışıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажити вибрану локальну модель, або виберіть Автоматичний для використання Apple Speech Коли є доступ. Аудіозапис все ще працює."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کردہ مقامی ماڈل ڈاؤن لوڈ، یا استعمال کرنے کے لئے خود کار طریقے سے منتخب کریں Apple Speech جب دستیاب ہے آڈیو ریکارڈنگ اب بھی کام کرتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống mô hình địa phương đã chọn, hoặc chọn Automatic để sử dụng Apple Speech khi có sẵn. Audio ghi âm vẫn hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载所选本地模型, 或者选择自动使用 Apple Speech 当可用。 音频录制仍然在工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
