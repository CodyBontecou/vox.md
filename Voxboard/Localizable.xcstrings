          "stringUnit": {
            "state": "translated",
            "value": "1 registrazione verrà annullata perché è richiesta la posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報が必要なため、1 件の録画がキャンセルされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치가 필요하므로 녹화 1개가 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
