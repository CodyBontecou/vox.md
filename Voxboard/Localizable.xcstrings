    "Example note · yours can start anywhere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example note · yours can start anywhere"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملاحظة على سبيل المثال · يمكن أن تبدأ أعمالك في أي مكان"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উদাহরণ নোট · আপনার যে কোনো জায়গায় শুরু করতে পারেন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispielnotiz: Ihre Notiz kann überall beginnen"
          }
        },
