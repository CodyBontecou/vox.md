            "value": "রেকর্ডটি ড্রাইভে নিরাপদে সংযুক্ত থাকবে কারণ এটি মুছে ফেলা সম্ভব হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme bleibt sicher am Entwurf befestigt, da sie nicht entfernt werden konnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording remains safely attached to the draft because it could not be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación permanece adjuntada de forma segura al proyecto porque no se podía eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement reste relié à l'ouvrage car il ne pouvait pas être retiré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड सुरक्षित रूप से प्रिंट के साथ जुड़ा हुआ है क्योंकि इसे हटाया नहीं जा सकता था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tetap aman diikat ke rancangan karena tidak dapat dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione rimane saldamente allegata al progetto perché non poteva essere rimossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は、削除できないため、草案に安全に付属しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 제거할 수 없기 때문에 프로젝트에 안전하게 붙여져 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname blijft veilig bij het ontwerp aangesloten omdat deze niet kon worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie pozostaje bezpiecznie dołączone do projektu, ponieważ nie można go usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação permanece seguramente anexada ao projeto, pois não poderia ser removida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись остается безопасно прикрепленной к проекту, потому что ее нельзя было удалить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவு பாதுகாப்பாக வெளியிடப்படவில்லை ஏனெனில் அதை வெளியிட முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกยังคงติดกับโครงการเพราะไม่สามารถถอดออกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt, taslakta güvenle bağlı kalır çünkü kaldırılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис залишається безпечно прикріплений до проекту, тому що його не можна було видалити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ریکارڈ کو ڈیزائن کے ساتھ محفوظ طور پر شامل کیا جاتا ہے کیونکہ اسے ہٹا نہیں دیا جا سکتا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm vẫn được gắn an toàn vào bản thảo vì nó không thể bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音仍然安全地附加到草案中,因为它无法删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音仍然安全地附加到草案中,因為它無法刪除。"
          }
        }
      }
    },
