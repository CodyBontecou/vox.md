    "Vox.md could not get an origin-time location. Your Capture draft is preserved and remains editable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Vox.md الحصول على الموقع وقت الالتقاط. تم الاحتفاظ بمسودة الالتقاط وتبقى قابلة للتحرير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md উৎস-সময়ের লোকেশন পায়নি। আপনার ক্যাপচার খসড়া সংরক্ষিত আছে এবং সম্পাদনাযোগ্য থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md konnte keinen Standort zum Erfassungszeitpunkt ermitteln. Ihr Erfassungsentwurf bleibt erhalten und kann weiter bearbeitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md could not get an origin-time location. Your Capture draft is preserved and remains editable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md no pudo obtener la ubicación del momento de origen. Tu borrador de captura se conserva y sigue siendo editable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md n’a pas pu obtenir la position au moment de la capture. Votre brouillon de capture est conservé et reste modifiable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md मूल-समय की लोकेशन प्राप्त नहीं कर सका। आपका कैप्चर ड्राफ़्ट सुरक्षित है और संपादन योग्य बना रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md tidak bisa mendapatkan lokasi saat tangkapan dibuat. Draf Tangkapan Anda tetap tersimpan dan masih dapat diedit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md non è riuscito a ottenere la posizione al momento dell’acquisizione. La bozza di acquisizione è stata conservata e resta modificabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.mdは記録時の位置情報を取得できませんでした。キャプチャの下書きは保持されており、引き続き編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md가 캡처 시점의 위치를 가져올 수 없습니다. 캡처 초안은 보존되었으며 계속 편집할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md kon geen locatie op het moment van vastleggen bepalen. Je vastlegconcept blijft behouden en kan nog worden gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md nie mógł ustalić lokalizacji z chwili przechwycenia. Wersja robocza przechwycenia została zachowana i można ją dalej edytować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vox.md não conseguiu obter a localização do momento de origem. Seu rascunho de captura foi preservado e continua editável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md не удалось получить геопозицию в момент захвата. Черновик захвата сохранен, и его можно редактировать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md தொடக்க நேர இருப்பிடத்தைப் பெற முடியவில்லை. உங்கள் பிடிப்பு வரைவு பாதுகாக்கப்பட்டு, திருத்தக்கூடியதாக உள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ไม่สามารถรับตำแหน่ง ณ เวลาต้นทางได้ ฉบับร่างการจับภาพของคุณยังคงอยู่และแก้ไขได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md kaynak zamanı konumunu alamadı. Yakalama taslağınız korundu ve düzenlenebilir durumda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md не вдалося отримати геопозицію в момент захоплення. Чернетку захоплення збережено, і її можна редагувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md آغاز کے وقت کا مقام حاصل نہیں کر سکا۔ آپ کا کیپچر ڈرافٹ محفوظ ہے اور قابل ترمیم ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md không thể lấy vị trí tại thời điểm ghi. Bản nháp ghi nhanh của bạn vẫn được giữ và có thể chỉnh sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 无法获取采集时的位置。你的采集草稿已保留，仍可编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 無法取得擷取當下的位置。你的擷取草稿已保留，仍可編輯。"
          }
        }
      }
    },
    "Vox.md could not remember that folder: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Vox.md تذكّر هذا المجلد: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ফোল্ডারটি মনে রাখতে পারেনি: %@"
          }
        },
        "de": {
          "stringUnit": {
