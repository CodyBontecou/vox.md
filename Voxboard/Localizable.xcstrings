    "Finish the current recording before importing audio": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ التسجيل الحالي قبل استيراد الصوت"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও ইমপোর্ট করার আগে বর্তমান রেকর্ডিং শেষ করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die aktuelle Aufnahme ab, bevor Sie Audio importieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the current recording before importing audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la grabación actual antes de importar audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez l’enregistrement en cours avant d’importer de l’audio"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो इम्पोर्ट करने से पहले मौजूदा रिकॉर्डिंग पूरी करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan rekaman saat ini sebelum mengimpor audio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la registrazione in corso prima di importare audio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオを読み込む前に現在の録音を終了してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 가져오기 전에 현재 녹음을 완료하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond de huidige opname af voordat je audio importeert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ bieżące nagrywanie przed importem audio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a gravação atual antes de importar áudio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите текущую запись, прежде чем импортировать аудио"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலியை இறக்குமதி செய்யும் முன் தற்போதைய பதிவை முடிக்கவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำการบันทึกปัจจุบันให้เสร็จก่อนนำเข้าเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses içe aktarmadan önce geçerli kaydı tamamlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть поточний запис, перш ніж імпортувати аудіо"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آڈیو امپورٹ کرنے سے پہلے موجودہ ریکارڈنگ مکمل کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất bản ghi âm hiện tại trước khi nhập âm thanh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入音频前请先完成当前录音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入音訊前請先完成目前錄音"
          }
        }
      }
    },
