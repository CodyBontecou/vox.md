    "Home now shows incoming Watch audio with recording time, a Process action, and a discard button before Vox.md transcribes it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر الآن الصفحة الرئيسية الموجودة في الصوت العادي مع الوقت المكتبي، والعمل عملية، وبدقة إزالة قبل أن يتم تسجيلها Vox.md."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Home এখন রেকর্ডিং সময় সঙ্গে আসন্ন ঘড়ি অডিও দেখায়, একটি প্রক্রিয়া, আগে একটি বাইনারি বোতাম Vox.md এটি অনুবাদ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start zeigt eingehende Watch-Audioaufnahmen jetzt mit Aufnahmezeit, einer „Verarbeiten“-Aktion und einem Verwerfen-Button an, bevor Vox.md sie transkribiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home now shows incoming Watch audio with recording time, a Process action, and a discard button before Vox.md transcribes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Home ahora muestra el audio de Watch entrantes con tiempo de grabación, un proceso de acción, Un botón de descarga antes de Vox.md transcribirlo en ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Home affiche maintenant l'audio Watch entrant avec le temps d'enregistrement, Un processus d’action, Un bouton de déchargement avant Vox.md transcrits à elle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Home अब रिकॉर्डिंग समय के साथ आने वाले घड़ी ऑडियो दिखाता है, एक प्रक्रिया का कार्य, पहले एक बटन से Vox.md इसे ट्रांसक्लिप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Home sekarang menampilkan audio Watch yang masuk dengan waktu rekaman, proses yang dilakukan, dan tombol discard sebelum Vox.md transcribe itu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Home ora mostra l'audio in arrivo Watch con tempo di registrazione, un processo di azione, Un pulsante di scarico prima Vox.md trascriverlo in modo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Now は、録音時間付き入力オーディオを表示します。 プロセス行動、 ボタンは、前から Vox.md 翻訳して"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Now는 녹음 시간과 함께 들어오는 시계 오디오를 표시합니다. 과정을 위한 행동, 1 배포 버튼을 사용하기 전에 Vox.md 이걸 번역해 봐"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Home toont nu inkomende Watch audio met opnametijd, een proces van actie, Een knopje vooruit Vox.md transcribeer het dan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Home teraz wyświetla przychodzące audio z nagrywaniem, w procesie działania, Przycisk odrzucenia przed Vox.md Przekazuj to"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Home agora mostra o áudio de Watch com tempo de gravação, um processo de ação, Um botão de desligamento antes Vox.md transcreva isso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Home теперь показывает входящий аудио Watch с временем записи, в процессе действия, Нажатие кнопки перед Vox.md Перепишите это"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Home இப்போது வெளியாகும் காட்சிகள், காட்சிகள் ஒரு செயற்பாடு , ஒரு முதியவர் முன்மொழிந்து Vox.md அதை transcribe செய்து"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Home ตอนนี้แสดงเสียงเข้า Watch พร้อมเวลาบันทึก การกระทํากระบวนการ และปุ่มลบก่อน Vox.md แปลงมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Home artık kaydetme süresine sahip gelen Watch audio'yu gösterir, Bir süreçte, Önceki İçerikBursa’da bir düğme Vox.md Bunu transcribe et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Home тепер показує вхідний аудіо Watch з часом запису, Проведення процесуального процесу, Натисніть кнопку перед Vox.md Перекладіть його"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Now میں آتے ہوئے آڈیو دیکھیں اور ریکارڈنگ وقت کے ساتھ، ایک عمل کے عمل، ایک بٹن پہلے سے ہی Vox.md اسے ٹرانسفر کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Home hiện hiển thị âm thanh Watch với thời gian ghi âm, Một quá trình hành động, Một nút tháo rời trước khi Vox.md Transcribe nó đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主页现在显示入口观看音频与录制时间, 一个过程的行动, 排除按钮之前 Vox.md 转载它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主頁現在顯示入口觀看音頻與錄製時間, 一個過程的行動, 排除按鈕之前 Vox.md 轉載它。"
          }
        }
      }
    },
