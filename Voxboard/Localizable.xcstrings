            "value": "One-note-per-capture routes کے لئے نوٹ frontmatter کا استعمال کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng Note frontmatter cho các tuyến One-Note-per-Capture."
