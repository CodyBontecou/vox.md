    "Vault templates support the same tokens, including {location}, which follows the delivering Route's location setting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدعم قوالب الخزنة الرموز نفسها، بما في ذلك {location}، الذي يتبع إعداد الموقع في المسار الذي يتولى التسليم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভল্ট টেমপ্লেটগুলো একই টোকেন সমর্থন করে, যার মধ্যে {location}-ও আছে, যা ডেলিভার করা রুটের লোকেশন সেটিং অনুসরণ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tresorvorlagen unterstützen dieselben Platzhalter, einschließlich {location}, das der Standorteinstellung der zustellenden Route folgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vault templates support the same tokens, including {location}, which follows the delivering Route's location setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas de la bóveda admiten los mismos tokens, incluido {location}, que sigue el ajuste de ubicación de la ruta que entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles du coffre prennent en charge les mêmes jetons, y compris {location}, qui suit le réglage de position du parcours qui livre la capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्ट टेम्पलेट वही टोकन समर्थित करते हैं, जिनमें {location} भी शामिल है, जो डिलीवर करने वाले रूट की लोकेशन सेटिंग का पालन करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat vault mendukung token yang sama, termasuk {location}, yang mengikuti pengaturan lokasi Rute pengirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli del vault supportano gli stessi token, incluso {location}, che segue l’impostazione di posizione del percorso che consegna l’acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫のテンプレートも同じトークンに対応しています。{location}は配信するルートの位置情報設定に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼트 템플릿도 동일한 토큰을 지원하며, {location}은 전달하는 루트의 위치 설정을 따릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kluissjablonen ondersteunen dezelfde plaatshouders, waaronder {location}, die de locatie-instelling van de afleverende route volgt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szablony sejfu obsługują te same tokeny, w tym {location}, który zależy od ustawienia lokalizacji trasy dostarczającej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos do cofre aceitam os mesmos tokens, incluindo {location}, que segue o ajuste de localização da rota que faz a entrega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны хранилища поддерживают те же токены, включая {location}, который следует настройке геопозиции маршрута доставки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "களஞ்சிய வார்ப்புருக்கள் அதே டோக்கன்களை ஆதரிக்கின்றன, {location} உட்பட; இது வழங்கும் வழித்தடத்தின் இருப்பிட அமைப்பைப் பின்பற்றுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทมเพลตของวอลต์รองรับโทเค็นเดียวกัน รวมถึง {location} ซึ่งจะเป็นไปตามการตั้งค่าตำแหน่งของเส้นทางที่ส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasa şablonları, teslim eden Rotanın konum ayarını izleyen {location} dahil aynı belirteçleri destekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони сховища підтримують ті самі токени, зокрема {location}, що залежить від налаштування геопозиції маршруту доставки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والٹ ٹیمپلیٹس انہی ٹوکنز کو سپورٹ کرتے ہیں، بشمول {location}، جو ڈیلیور کرنے والے روٹ کی مقام کی سیٹنگ کی پیروی کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu trong kho hỗ trợ cùng các token, kể cả {location}, theo cài đặt vị trí của lộ trình gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库模板支持相同的变量，包括 {location}，它遵循递送路线的位置设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫範本支援相同的變數，包括 {location}，它會依照傳送路線的位置設定。"
          }
        }
      }
    },
