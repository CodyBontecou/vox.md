          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan di awal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci all’inizio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先頭に追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞에 추가"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vooraan toevoegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj na początku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserir no início"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В начало"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடக்கத்தில் சேர்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มที่ด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başa ekle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На початок"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع میں شامل کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm vào đầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到开头"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加到開頭"
          }
        }
      }
    },
    "Press Control–Command–Space while editing to open Character Viewer. Flags, skin tones, and joined emoji are supported.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط Control–Command–Space أثناء التحرير لفتح عارض الأحرف. الأعلام ودرجات لون البشرة والرموز التعبيرية المدمجة مدعومة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যারেক্টার ভিউয়ার খুলতে সম্পাদনার সময় Control–Command–Space চাপুন। পতাকা, ত্বকের রং ও যুক্ত ইমোজি সমর্থিত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie beim Bearbeiten Control–Befehl–Leertaste, um die Zeichenübersicht zu öffnen. Flaggen, Hauttöne und kombinierte Emojis werden unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Control–Command–Space while editing to open Character Viewer. Flags, skin tones, and joined emoji are supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Control–Comando–Espacio mientras editas para abrir el Visor de caracteres. Se admiten banderas, tonos de piel y emojis combinados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Contrôle + Commande + Espace pendant la modification pour ouvrir le Visualiseur de caractères. Les drapeaux, les teintes de peau et les emojis combinés sont pris en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैरेक्टर व्यूअर खोलने के लिए संपादन के दौरान Control–Command–Space दबाएँ। झंडे, त्वचा के रंग और जुड़े हुए इमोजी समर्थित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Control–Command–Spasi saat mengedit untuk membuka Penampil Karakter. Bendera, warna kulit, dan emoji gabungan didukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Ctrl-Comando-Spazio durante la modifica per aprire il Visore caratteri. Sono supportate bandiere, tonalità della pelle ed emoji combinate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中にControl–Command–スペースキーを押すと、文字ビューアが開きます。旗、肌の色、結合した絵文字にも対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 중에 Control–Command–스페이스 바를 누르면 문자 뷰어가 열립니다. 국기, 피부색 및 결합된 이모지가 지원됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk tijdens het bewerken op Control–Command–spatiebalk om de Tekenweergave te openen. Vlaggen, huidskleuren en samengestelde emoji worden ondersteund."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij Control–Command–Spacja podczas edycji, aby otworzyć Przeglądarkę znaków. Obsługiwane są flagi, odcienie skóry i złożone emoji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione Control–Command–Espaço durante a edição para abrir o Visualizador de Caracteres. Bandeiras, tons de pele e emojis combinados são compatíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите Control–Command–Пробел при редактировании, чтобы открыть «Эмодзи и символы». Флаги, оттенки кожи и составные эмодзи поддерживаются."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுத்துப் பார்வையாளரைத் திறக்க, திருத்தும்போது Control–Command–Space ஐ அழுத்தவும். கொடிகள், தோல் நிறங்கள் மற்றும் இணைந்த எமோஜிகள் ஆதரிக்கப்படுகின்றன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด Control–Command–Space ขณะแก้ไขเพื่อเปิดตัวแสดงอักขระ รองรับธง สีผิว และอีโมจิแบบรวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlerken Karakter Görüntüleyici'yi açmak için Control–Command–Boşluk tuşlarına basın. Bayraklar, ten tonları ve birleşik emojiler desteklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть Control–Command–Пробіл під час редагування, щоб відкрити «Емодзі та символи». Прапори, відтінки шкіри та складені емодзі підтримуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترمیم کرتے وقت کریکٹر ویور کھولنے کے لیے Control–Command–Space دبائیں۔ جھنڈے، جلد کے رنگ اور جڑے ہوئے ایموجی معاون ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Control–Command–Phím cách khi đang sửa để mở Trình xem ký tự. Hỗ trợ cờ, tông màu da và emoji ghép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑时按下 Control–Command–空格键可打开字符检视器。支持旗帜、肤色和组合表情符号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯時按下 Control–Command–空白鍵可打開字元檢視器。支援旗幟、膚色和組合表情符號。"
          }
        }
      }
    },
    "Press to open Quick Capture. Hold to talk; release to stop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لفتح الالتقاط السريع. اضغط مطولًا للتحدث؛ واترك للإيقاف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কুইক ক্যাপচার খুলতে চাপুন। কথা বলতে ধরে রাখুন; বন্ধ করতে ছেড়ে দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken, um „Schnellerfassung“ zu öffnen. Halten zum Sprechen; loslassen zum Stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press to open Quick Capture. Hold to talk; release to stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa para abrir Captura rápida. Mantén pulsado para hablar y suelta para detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour ouvrir Capture rapide. Maintenez pour parler ; relâchez pour arrêter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्विक कैप्चर खोलने के लिए दबाएँ। बोलने के लिए दबाकर रखें; बंद करने के लिए छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan untuk membuka Tangkapan Cepat. Tahan untuk bicara; lepaskan untuk berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi per aprire Acquisizione rapida. Tieni premuto per parlare; rilascia per interrompere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押すとクイックキャプチャが開きます。押したまま話し、離すと停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르면 빠른 캡처가 열립니다. 길게 누른 채로 말하고 떼면 중단됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk om Snel vastleggen te openen. Houd vast om te praten; laat los om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij, aby otworzyć Szybkie przechwytywanie. Przytrzymaj, aby mówić; puść, aby zatrzymać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione para abrir a Captura Rápida. Mantenha pressionado para falar e solte para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы открыть «Быстрый захват». Удерживайте, чтобы говорить; отпустите для остановки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரைவுப் பிடிப்பைத் திறக்க அழுத்தவும். பேச பிடித்திருக்கவும்; நிறுத்த விடுவிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดเพื่อเปิดการจับภาพด่วน กดค้างไว้เพื่อพูด ปล่อยเพื่อหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı Yakalama'yı açmak için basın. Konuşmak için basılı tutun; durdurmak için bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть, щоб відкрити «Швидке захоплення». Утримуйте, щоб говорити; відпустіть, щоб зупинити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فوری کیپچر کھولنے کے لیے دبائیں۔ بولنے کے لیے دبا کر رکھیں؛ بند کرنے کے لیے چھوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn để mở Ghi nhanh. Giữ để nói; thả ra để dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下以打开快速采集。按住说话；松开即停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下以打開快速擷取。按住說話；放開即停止。"
          }
        }
      }
    },
    "Press to open the floating Quick Capture window. Hold to talk; release to stop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لفتح نافذة الالتقاط السريع العائمة. اضغط مطولًا للتحدث؛ واترك للإيقاف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাসমান কুইক ক্যাপচার উইন্ডো খুলতে চাপুন। কথা বলতে ধরে রাখুন; বন্ধ করতে ছেড়ে দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken, um das schwebende Fenster „Schnellerfassung“ zu öffnen. Halten zum Sprechen; loslassen zum Stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press to open the floating Quick Capture window. Hold to talk; release to stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa para abrir la ventana flotante de Captura rápida. Mantén pulsado para hablar y suelta para detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour ouvrir la fenêtre flottante Capture rapide. Maintenez pour parler ; relâchez pour arrêter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्लोटिंग क्विक कैप्चर विंडो खोलने के लिए दबाएँ। बोलने के लिए दबाकर रखें; बंद करने के लिए छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan untuk membuka jendela Tangkapan Cepat yang mengambang. Tahan untuk bicara; lepaskan untuk berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi per aprire la finestra mobile Acquisizione rapida. Tieni premuto per parlare; rilascia per interrompere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押すとフローティングのクイックキャプチャウインドウが開きます。押したまま話し、離すと停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르면 플로팅 빠른 캡처 윈도우가 열립니다. 길게 누른 채로 말하고 떼면 중단됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk om het zwevende venster Snel vastleggen te openen. Houd vast om te praten; laat los om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij, aby otworzyć pływające okno Szybkiego przechwytywania. Przytrzymaj, aby mówić; puść, aby zatrzymać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione para abrir a janela flutuante da Captura Rápida. Mantenha pressionado para falar e solte para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы открыть плавающее окно «Быстрый захват». Удерживайте, чтобы говорить; отпустите для остановки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மிதக்கும் விரைவுப் பிடிப்புச் சாளரத்தைத் திறக்க அழுத்தவும். பேச பிடித்திருக்கவும்; நிறுத்த விடுவிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดเพื่อเปิดหน้าต่างการจับภาพด่วนแบบลอย กดค้างไว้เพื่อพูด ปล่อยเพื่อหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayan Hızlı Yakalama penceresini açmak için basın. Konuşmak için basılı tutun; durdurmak için bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть, щоб відкрити плаваюче вікно «Швидке захоплення». Утримуйте, щоб говорити; відпустіть, щоб зупинити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تیرتی فوری کیپچر ونڈو کھولنے کے لیے دبائیں۔ بولنے کے لیے دبا کر رکھیں؛ بند کرنے کے لیے چھوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn để mở cửa sổ Ghi nhanh nổi. Giữ để nói; thả ra để dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下以打开浮动的快速采集窗口。按住说话；松开即停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下以打開浮動的快速擷取視窗。按住說話；放開即停止。"
          }
        }
      }
    },
    "Preview": {
      "localizations": {
