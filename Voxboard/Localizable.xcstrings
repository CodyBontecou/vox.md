    "Your lifetime Unlimited access supports Apple Family Sharing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول غير المحدود لعيشك يدعم Apple Family Sharing."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইফটাইম অ্যাক্সেস অসীম Apple ফ্যামিলি শেয়ারিং সমর্থন করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
