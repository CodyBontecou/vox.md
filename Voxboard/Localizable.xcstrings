        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте как много местных записей, как вам нравится"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் விரும்பும் பல இடங்கள் பதிவு செய்யவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งข้อความท้องถิ่นเท่าที่คุณต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz kadar yerel notlar gönderin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати стільки місцевих нот, скільки вам подобається"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے پسندیدہ طور پر مقامی نوٹس بھیجیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi nhiều ghi chú địa phương như bạn muốn"
          }
        },
        "zh-Hans": {
