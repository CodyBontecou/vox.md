    "Your unsent text and attachments will be removed from this Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة النص والمرفقات غير المرسلة من هذا الـ Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার না পাঠানো টেক্সট ও অ্যাটাচমেন্ট এই Mac থেকে সরিয়ে দেওয়া হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr nicht gesendeter Text und Ihre Anhänge werden von diesem Mac entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your unsent text and attachments will be removed from this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu texto y archivos adjuntos sin enviar se eliminarán de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre texte et vos pièces jointes non envoyés seront supprimés de ce Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका न भेजा गया टेक्स्ट और अटैचमेंट इस Mac से हटा दिए जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks dan lampiran Anda yang belum dikirim akan dihapus dari Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo e gli allegati non inviati verranno rimossi da questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未送信のテキストと添付ファイルはこのMacから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내지 않은 텍스트와 첨부 파일이 이 Mac에서 제거됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je niet-verstuurde tekst en bijlagen worden van deze Mac verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niewysłany tekst i załączniki zostaną usunięte z tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu texto e anexos não enviados serão removidos deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неотправленный текст и вложения будут удалены с этого Mac."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனுப்பாத உங்கள் உரையும் இணைப்புகளும் இந்த Mac இலிருந்து அகற்றப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความและไฟล์แนบที่ยังไม่ได้ส่งจะถูกเอาออกจาก Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilmemiş metniniz ve ekleriniz bu Mac'ten kaldırılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ненадісланий текст і вкладення буде видалено з цього Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا نہ بھیجا گیا متن اور منسلکات اس Mac سے ہٹا دیے جائیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản và tệp đính kèm chưa gửi sẽ bị xóa khỏi máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你未发送的文本和附件将从此 Mac 中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你未傳送的文字和附件將從此 Mac 中移除。"
          }
        }
      }
    },
    "Your words are never sent to us": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُرسل كلماتك إلينا أبدًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কথা কখনও আমাদের কাছে পাঠানো হয় না"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Worte werden niemals an uns gesendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your words are never sent to us"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus palabras nunca se nos envían"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos paroles ne nous sont jamais envoyées"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके शब्द कभी हमें नहीं भेजे जाते"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata Anda tidak pernah dikirim ke kami"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue parole non ci vengono mai inviate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの言葉が私たちに送信されることはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 말은 절대 당사로 전송되지 않습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je woorden worden nooit naar ons verstuurd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje słowa nigdy do nas nie trafiają"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas palavras nunca são enviadas para nós"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши слова никогда не отправляются нам"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சொற்கள் ஒருபோதும் எங்களுக்கு அனுப்பப்படாது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำพูดของคุณจะไม่ถูกส่งมาให้เรา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözcükleriniz asla bize gönderilmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші слова ніколи не надсилаються нам"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے الفاظ کبھی ہمیں نہیں بھیجے جاتے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nói của bạn không bao giờ được gửi cho chúng tôi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
