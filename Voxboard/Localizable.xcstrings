    "Add the Vox.md Watch face shortcut for a quick path into recording from supported Apple Watch faces.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة إشارة سريعة للعين Vox.md لوسائل تسجيل سريعة من الوجهات Apple Watch المجموعات المقبولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ করুন Vox.md সহজে রেকর্ডিং থেকে দ্রুত পথের জন্য মুখের স্ক্রুটি দেখুন Apple Watch মুখে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie das Vox.md-Ziffernblatt-Kurzbefehl hinzu, um von unterstützten Ziffernblättern der Apple Watch aus schnell mit der Aufnahme zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the Vox.md Watch face shortcut for a quick path into recording from supported Apple Watch faces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el Vox.md Ver el activo de cara para un camino rápido a la grabación desde soportado Apple Watch Las caras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le Vox.md Regardez le raccourci visage pour un chemin rapide vers l'enregistrement depuis le support Apple Watch des visages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ें Vox.md समर्थन से रिकॉर्डिंग में एक त्वरित मार्ग के लिए चेहरे का दृश्य संक्षिप्त दृश्य देखें Apple Watch चेहरे"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan yang Vox.md Tonton pendekatan wajah untuk jalan cepat ke rekaman dari yang didukung Apple Watch Wajah yang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il Vox.md Guardare il shortcut faccia per un percorso rapido in registrazione da supportato Apple Watch dei volti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加する Vox.md サポートされているから録音への迅速な道のりを表示する顔ショートカットをチェック Apple Watch 顔"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가하기 The Vox.md 지원된 녹음으로 빠른 경로를 위한 얼굴 단추를 시청하세요. Apple Watch 얼굴을 다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de Vox.md Bekijk gezichtskortscherm voor een snel pad naar opname vanaf ondersteund Apple Watch Gezicht op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj do Vox.md Obejrzyj skrót twarzy dla szybkiej ścieżki do nagrywania z obsługiwanego Apple Watch Twarze się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o Vox.md Assista o atalho facial para um caminho rápido para a gravação a partir do suportado Apple Watch os rostos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте к Vox.md Смотреть короткий штрих-файл для быстрого пути к записи от поддерживаемого Apple Watch Лица"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the உபயோகங்கள் Vox.md முகத்தைப் பார்த்து, ஒரு விரைவான வழியைக் கண்டுபிடித்து, Apple Watch முகங்கள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม Vox.md ดูหน้าสั้น ๆ สําหรับทางที่รวดเร็วในการบันทึกจากที่สนับสนุน Apple Watch หน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekleme yapın Vox.md Desteklenen kaydetmeye hızlı bir yol için Face Shortcut izleyin Apple Watch Yüzleri"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте його Vox.md Подивитися коротку сторінку для швидкого шляху до запису від підтримуваного Apple Watch обличчя"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "add کے Vox.md چہرے کی ٹریکنگ کو دیکھیں، سپورٹ سے ریکارڈنگ میں ایک تیز رفتار راستہ Apple Watch چہرے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm vào Vox.md Xem phím tắt khuôn mặt để có một con đường nhanh chóng vào ghi âm từ được hỗ trợ Apple Watch mặt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 该 Vox.md 观看面部快捷方式,以便快速进入支持的录音 Apple Watch 面孔"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 該 Vox.md 觀看面部快捷方式,以便快速進入支持的錄音 Apple Watch 面孔"
          }
        }
      }
    },
    "Add the Vox.md recording widget to supported Apple Watch faces for faster access to the Watch recorder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة ميزة Vox.md لتسجيل الذاكرة إلى وجهات Apple Watch المجموعات المقبولة لتوفير الوصول السريع إلى مستعرض Watch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ করুন Vox.md উইজেট রেকর্ডিং সমর্থন Apple Watch দ্রুত অ্যাক্সেসের জন্য টাইম রেকর্ডিং"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie das Vox.md-Aufnahme-Widget zu unterstützten Ziffernblättern der Apple Watch hinzu, um schneller zum Watch-Recorder zu gelangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the Vox.md recording widget to supported Apple Watch faces for faster access to the Watch recorder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el Vox.md Widget para grabar soportado Apple Watch Acceso más rápido al dispositivo de grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le Vox.md Enregistrement de widget à supporter Apple Watch Faces pour un accès plus rapide à l'enregistreur de la montre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ें Vox.md विंडोज को समर्थन देने के लिए Apple Watch घड़ी रिकॉर्डर के लिए तेजी से पहुंच के लिए चेहरे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan yang Vox.md Menggunakan widget untuk mendukung Apple Watch Cara Mudah Mengakses Rekaman Jam Tangan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il Vox.md Widget di registrazione per supportare Apple Watch Facce per un accesso più rapido al registratore di orologi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加する Vox.md サポートするウィジェットを録音する Apple Watch 時計レコーダーへのアクセスをより速くするための顔。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가하기 The Vox.md 녹음하기 widget to supported Apple Watch 시계 레코더에 더 빠른 액세스를 위한 얼굴."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de Vox.md Widget opnemen om te worden ondersteund Apple Watch voor snellere toegang tot de Watch-recorder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj do Vox.md Nagrywanie widgetów do obsługi Apple Watch - szybszy dostęp do rejestratora zegara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o Vox.md Recuperar widgets para suportar Apple Watch para um acesso mais rápido ao relógio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте к Vox.md Запись виджетов для поддержки Apple Watch - лица для более быстрого доступа к записывающему устройству."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the உபயோகங்கள் Vox.md Widget இல் எழுதவும் Apple Watch கணினிக்கு எதிரான விளைவுகளைக் கண்டுபிடிப்பதற்கு"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม Vox.md การบันทึก widget เพื่อสนับสนุน Apple Watch หน้าเพื่อเข้าถึงเครื่องบันทึกนาฬิกาได้เร็วขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekleme yapın Vox.md Widget'ı desteklemek için Apple Watch Daha hızlı bir şekilde Watch kayıt cihazına erişimi sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте його Vox.md Запис віджитків для підтримки Apple Watch - швидше доступу до запису годинника."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "add کے Vox.md ڈائریکٹرز کو سپورٹ کرنے کے لئے Apple Watch گھڑی ریکارڈنگ کے لئے تیز رفتار رسائی کے لئے چہرے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm vào Vox.md Ghi widget để được hỗ trợ Apple Watch Mặt để truy cập nhanh hơn vào bộ ghi âm đồng hồ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 该 Vox.md 录制 widget 以支持 Apple Watch 面部以便更快地访问手表录音器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 該 Vox.md 錄製 widget 以支持 Apple Watch 面部以便更快地訪問手錶錄音器。"
          }
        }
      }
    },
