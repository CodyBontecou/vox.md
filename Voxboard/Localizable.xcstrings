        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullata perché il percorso richiede la posizione al momento dell’acquisizione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルートで記録時の位置情報が必要なためキャンセルされました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트에 캡처 시점의 위치가 필요하여 취소됨"
