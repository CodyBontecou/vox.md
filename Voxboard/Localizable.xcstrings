    },
    "Use the Dock icon or Cmd-Tab to bring Vox.md forward.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدمت صورة Dock أو Cmd-Tab لإرسال Vox.md إلى الأمام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডক আইকন বা Cmd-Tab আনতে Vox.md সামনে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie das Dock-Symbol oder Cmd-Tab, um Vox.md nach vorn zu holen."
          }
        },
        "en": {
