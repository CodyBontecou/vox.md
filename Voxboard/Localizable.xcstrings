    "Type a thought or tap Record, then tap Send to save it in %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب فكرة أو اضغط تسجيل، ثم اضغط إرسال لحفظها في %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ভাবনা লিখুন বা Record চাপুন, তারপর %@-এ সংরক্ষণ করতে Send চাপুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib einen Gedanken oder tippe auf „Aufnehmen“ und dann auf „Senden“, um ihn in %@ zu speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a thought or tap Record, then tap Send to save it in %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una idea o toca Grabar y luego Enviar para guardarla en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez une idée ou appuyez sur Enregistrer, puis sur Envoyer pour l’enregistrer dans %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई विचार लिखें या Record टैप करें, फिर इसे %@ में सहेजने के लिए Send टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik pemikiran atau ketuk Rekam, lalu ketuk Kirim untuk menyimpannya di %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un pensiero o tocca Registra, poi tocca Invia per salvarlo in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "考えを入力するか「録音」をタップし、「送信」をタップして%@に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각을 입력하거나 녹음을 탭한 다음 보내기를 탭해 %@에 저장하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ een gedachte of tik op Neem op en tik dan op Verstuur om hem in %@ te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz myśl lub stuknij Nagraj, a potem Wyślij, aby zapisać ją w %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma ideia ou toque em Gravar e depois em Enviar para salvá-la em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите мысль или нажмите «Запись», затем «Отправить», чтобы сохранить её в %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு எண்ணத்தைத் தட்டச்சு செய்யவும் அல்லது பதிவு தட்டவும், பின் %@ இல் சேமிக்க அனுப்பு தட்டவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ความคิดหรือแตะบันทึกเสียง แล้วแตะส่งเพื่อบันทึกไว้ใน %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir düşünce yazın veya Kaydet'e dokunun, sonra %@ içine kaydetmek için Gönder'e dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишіть думку або торкніться «Запис», потім «Надіслати», щоб зберегти її в %@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی خیال لکھیں یا ریکارڈ ٹیپ کریں، پھر اسے %@ میں محفوظ کرنے کے لیے بھیجیں ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập một ý tưởng hoặc chạm Ghi âm, rồi chạm Gửi để lưu vào %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入想法或轻点“录音”，然后轻点“发送”将其保存到%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入想法或點一下「錄音」，然後點一下「傳送」將其儲存到%@。"
          }
        }
      }
    },
    "Type Markdown, dictate, paste, or drop files anywhere in this window.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب Markdown أو أملِ النص أو الصقه أو أفلت الملفات في أي مكان في هذه النافذة."
