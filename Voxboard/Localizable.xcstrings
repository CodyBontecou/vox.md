    "Stops the persistent listening session used by the Vox.md keyboard. This does not change Capture attachments.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف جلسة الاستماع المستمرة التي تستخدمها لوحة مفاتيح Vox.md. لا يغيّر هذا مرفقات الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md কীবোর্ডের ব্যবহৃত স্থায়ী শোনার সেশন বন্ধ করে। এটি ক্যাপচারের অ্যাটাচমেন্ট বদলায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt die dauerhafte Zuhörsitzung der Vox.md-Tastatur. Erfassungsanhänge werden dadurch nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops the persistent listening session used by the Vox.md keyboard. This does not change Capture attachments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene la sesión de escucha persistente que usa el teclado de Vox.md. No cambia los archivos adjuntos de la captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête la session d’écoute persistante utilisée par le clavier Vox.md. Cela ne modifie pas les pièces jointes de la capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md कीबोर्ड द्वारा उपयोग किया जाने वाला लगातार सुनने का सेशन बंद करता है। इससे कैप्चर अटैचमेंट नहीं बदलते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan sesi mendengarkan persisten yang digunakan oleh papan ketik Vox.md. Ini tidak mengubah lampiran Tangkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe la sessione di ascolto persistente usata dalla tastiera Vox.md. Non modifica gli allegati dell’acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.mdキーボードで使用する常時聞き取りセッションを停止します。キャプチャの添付ファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 키보드에서 사용하는 지속 듣기 세션을 중단합니다. 캡처 첨부 파일은 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt de blijvende luistersessie van het Vox.md-toetsenbord. Dit wijzigt de bijlagen van de vastlegging niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje trwałą sesję słuchania używaną przez klawiaturę Vox.md. Nie zmienia to załączników przechwycenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a sessão de escuta persistente usada pelo teclado do Vox.md. Isso não altera os anexos da captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает постоянный сеанс прослушивания для клавиатуры Vox.md. Вложения захвата не меняются."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md விசைப்பலகை பயன்படுத்தும் நிலையான கேட்கும் அமர்வை நிறுத்தும். இது பிடிப்பு இணைப்புகளை மாற்றாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดเซสชันการฟังต่อเนื่องที่แป้นพิมพ์ Vox.md ใช้ การดำเนินการนี้ไม่เปลี่ยนไฟล์แนบของการจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md klavyesinin kullandığı kalıcı dinleme oturumunu durdurur. Bu, Yakalama eklerini değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиняє постійний сеанс прослуховування для клавіатури Vox.md. Вкладення захоплення не змінюються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md کی بورڈ کا مستقل سننے کا سیشن بند کرتا ہے۔ اس سے کیپچر کے منسلکات تبدیل نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng phiên nghe liên tục mà bàn phím Vox.md sử dụng. Thao tác này không thay đổi tệp đính kèm của bản ghi nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 Vox.md 键盘使用的持续聆听会话。这不会更改采集附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 Vox.md 鍵盤使用的持續聆聽工作階段。這不會變更擷取附件。"
          }
        }
      }
    },
    "Stops using this model without deleting it from your Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops using this model without deleting it from your Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف استخدام هذا النموذج دون حذفه من جهاز Mac لديك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Mac থেকে মুছে না ফেলে এই মডেল ব্যবহার বন্ধ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet dieses Modell nicht mehr, ohne es von Ihrem Mac zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de usar este modelo sin eliminarlo de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cesse d'utiliser ce modèle sans le supprimer de votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मॉडल को आपके Mac से हटाए बिना इसका उपयोग करना बंद कर देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti menggunakan model ini tanpa menghapusnya dari Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smette di usare questo modello senza eliminarlo dal tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルをMacから削除せずに、使用を停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델을 Mac에서 삭제하지 않고 사용을 중지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt met het gebruiken van dit model zonder het van je Mac te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestaje używać tego modelu bez usuwania go z komputera Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa de usar este modelo sem excluí-lo do seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перестаёт использовать эту модель, не удаляя её с вашего Mac."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மாதிரியை உங்கள் Mac-இலிருந்து நீக்காமல் பயன்படுத்துவதை நிறுத்துகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดใช้โมเดลนี้โดยไม่ลบออกจาก Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modeli Mac'inizden silmeden kullanmayı bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Припиняє використовувати цю модель, не видаляючи її з вашого Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ماڈل کا استعمال بند کر دیتا ہے لیکن اسے آپ کے Mac سے حذف نہیں کرتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngừng sử dụng mô hình này mà không xóa nó khỏi Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止使用此模型，但不会将其从 Mac 上删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止使用此模型，但不會將其從 Mac 上刪除。"
          }
        }
      }
    },
