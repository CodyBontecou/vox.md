            "value": "Attivo — condiviso con il tuo gruppo famiglia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン — ファミリーグループと共有中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켬 — 가족 그룹과 공유 중"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan – gedeeld met je gezinsgroep"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączone — udostępniane grupie rodzinnej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado — compartilhado com seu grupo familiar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкл. — доступно вашей семейной группе"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கம் — உங்கள் குடும்பக் குழுவுடன் பகிரப்பட்டது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด — แชร์กับกลุ่มครอบครัวของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık — aile grubunuzla paylaşılıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімк. — доступно вашій сімейній групі"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آن — آپ کے فیملی گروپ کے ساتھ شیئر"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật — chia sẻ với nhóm gia đình của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开 — 已与你的家庭群组共享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 — 已與你的家庭群組分享"
          }
        }
      }
    },
