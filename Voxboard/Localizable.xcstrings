    "One purchase unlocks unlimited local Capture and private, on-device transcription across Vox.md.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شراء واحد يفتح الحظر غير محدودة من السماح بالبث في المحيط والمراجعة الخاصة على جهاز في جميع أنحاء Vox.md."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ক্রয় সীমাহীন স্থানীয় ক্যাপচার এবং ব্যক্তিগত, ডিভাইসের মাধ্যমে transcription Vox.md."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf schaltet unbegrenzte lokale Erfassung und private Transkription auf dem Gerät in ganz Vox.md frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase unlocks unlimited local Capture and private, on-device transcription across Vox.md."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra desbloquea captura local ilimitada y privada, Transcripción en dispositivo a través de Vox.md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat déverrouille un capture local illimité et privé, Transcription sur-dispositif à travers Vox.md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक खरीद असीमित स्थानीय कैप्चर और निजी, On-device transcription के माध्यम से Vox.md."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu pembelian membuka kunci yang tidak terbatas untuk Capture lokal dan pribadi, Transcription on-device dari Vox.md."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acquisto sblocca il localizzatore illimitato e privato, Transcrizione on-device attraverso Vox.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入1回では、無制限のローカルキャプチャとプライベート、 On-device transcription across トランスクリプション Vox.md."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 구매는 무제한 로컬 캡처 및 개인, On-device transcription 위의 문서 Vox.md."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aankoop ontgrendelt onbeperkte lokale opname en privé, On-device transcriptie door Vox.md."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden zakup odblokowuje nieograniczone lokalne przechwytywanie i prywatne, Transpozycja na urządzeniach Vox.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra desbloqueia captura local ilimitada e privada, Transcrição on-device em Vox.md."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна покупка разблокирует неограниченный локальный Захват и частное, Транскрипция через устройство Vox.md."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு வாங்குதல் அங்கீகரிக்கப்படாத இடத்தில் Capture மற்றும் Private, transcription on-device உள்நுழைவு Vox.md."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อครั้งเดียวเปิดการจับภาพที่อยู่อาศัยไม่ จํากัด และส่วนตัว transcription on-device ทั่ว Vox.md."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir satın alma sınırsız yerel yakalama ve özel, On-device transcription üzerinde yazılım Vox.md."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна покупка розблокує необмежену кількість локальних захоплень та приватних, Транскрипція через пристрій Vox.md."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک خریداری کو لٹاک نہیں ہے غیر محدود مقامی پکڑنے اور نجی، ‫‪ transcript‬→ transcript‬ Vox.md."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mua mở khóa không giới hạn địa phương Capture và riêng tư, Transcription on-device qua Vox.md."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个购买释放了无限的本地捕捉和私人, 设备转录 Vox.md."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個購買釋放了無限的本地捕捉和私人, 設備轉錄 Vox.md."
          }
        }
      }
    },
    "Only HTTP and HTTPS links can be captured.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تخزين روابط HTTP و HTTPS فقط."
