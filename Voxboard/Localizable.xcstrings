            "state": "translated",
            "value": "பாதுகாப்பாக தண்ணீர் iPhone வழக்கு எதிர்காலம்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคล็ดลับที่ปลอดภัย iPhone และรอการกระบวนการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli bir şekilde çarptırıldı iPhone Süreç beklemek için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безпечно зачепили iPhone І чекати на процес."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
