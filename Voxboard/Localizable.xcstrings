    "The Files copy succeeded, but delivery state could not be saved. Retry is safe.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إعادة نسخ الملفات بنجاح ، ولكن لا يمكن تخزين حالة التسليم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলগুলি কপি সফল হয়েছে, কিন্তু ডেলিভারি অবস্থা সংরক্ষণ করা সম্ভব হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien-Kopie war erfolgreich, aber der Zustellungsstatus konnte nicht gesichert werden. Ein erneuter Versuch ist sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Files copy succeeded, but delivery state could not be saved. Retry is safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de los archivos se logró, pero el estado de entrega no se pudo guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie de Fichiers a réussi, mais l'état de livraison ne pouvait pas être enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलों का कॉपी सफल हो गया, लेकिन वितरण की स्थिति को सहेजा नहीं जा सका. रीट्री सुरक्षित है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File copy berhasil, tetapi status pengiriman tidak dapat disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia dei file è riuscita, ma lo stato di consegna non è stato salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルのコピーは成功しましたが、配信状態は保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 복사 성공했지만 배달 상태는 저장할 수 없었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopie van de bestanden is geslaagd, maar de leveringsstatus kon niet worden opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia plików zakończyła się sukcesem, ale nie można zapisać stanu dostawy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia dos arquivos foi bem sucedida, mas o estado de entrega não foi salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирование файлов удалось, но состояние доставки не удалось сохранить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புகளை திரும்பப் பெற முடியாது, ஆனால் திரும்பப் பெற முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การคัดลอกไฟล์ประสบความสําเร็จ แต่สถานะการจัดส่งไม่สามารถบันทึกได้ Retry เป็นความปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya kopyası başarılı oldu, ancak teslimat durumunu kaydedemezsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копія файлів вдалася, але стан доставки не можна зберегти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فائلوں کا کاپی کامیاب ہوا، لیکن ترسیل کی حالت محفوظ نہیں کیا جا سکتا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "File đã được sao chép thành công, nhưng trạng thái giao hàng không thể được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件复制成功,但无法保存交付状态. 重复是安全的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件複製成功,但無法保存交付狀態. 重複是安全的。"
          }
        }
      }
    },
    "The Files permission for ‘%@’ expired. Edit the destination and choose its folder again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء حق الملفات لـ '%@'.إصلاح الهدف و اختيار ملفها مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "‘ফাইলের জন্য অনুমতি’%@‘অপরাধ। ডিজাইন সম্পাদনা করুন এবং তার ফোল্ডারটি আবার নির্বাচন করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien-Berechtigung für „%@“ ist abgelaufen. Bearbeiten Sie das Ziel und wählen Sie den Ordner erneut aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Files permission for ‘%@’ expired. Edit the destination and choose its folder again."
          }
        },
        "es": {
