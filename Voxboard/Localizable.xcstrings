    "→ Choose a destination": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "→ اختر وجهة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "→ একটি গন্তব্য বেছে নিন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Ziel auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Choose a destination"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Elige un destino"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Choisir une destination"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "→ गंतव्य चुनें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Pilih tujuan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Scegli una destinazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "→ 保存先を選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "→ 저장 위치 선택"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Kies een bestemming"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Wybierz miejsce docelowe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Escolha um destino"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Выберите место назначения"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "→ ஒரு சேருமிடத்தைத் தேர்ந்தெடுக்கவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "→ เลือกปลายทาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Bir hedef seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Виберіть місце призначення"
          }
        },
