    "No usable audio was captured. Try recording again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تسجيل أي صوت قابل للاستخدام.حاول تسجيلها مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনও অডিও ক্যাপচার করা হয়নি. আবার রেকর্ডিং চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein nutzbares Audio wurde aufgezeichnet. Versuchen Sie erneut aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usable audio was captured. Try recording again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se capturó audio útil. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun enregistrement audio n'a été capturé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई उपयोगी ऑडियो कैप्चर नहीं किया गया है. फिर से रिकॉर्डिंग की कोशिश करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada audio yang dapat digunakan. coba rekaman lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato registrato alcun audio utile. riprovare la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声が録音されていないので、再度録音してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 오디오가 캡처되지 않았습니다.더 보기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen gebruikbare audio vastgelegd. Probeer opnieuw te opnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie został zarejestrowany żaden użyteczny dźwięk. Spróbuj ponownie nagrać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi capturado áudio útil. tente gravar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не было запечатлено звука, который можно было использовать.Попробуйте снова записать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த ஒரு பதிவையும் எழுதவில்லை.இதை மீண்டும் எழுத முயற்சி செய்யுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้จับเสียงที่สามารถใช้งานได้ ลองบันทึกอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir ses kaydı alınmadı. Tekrar kaydetmeye çalışın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не було зафіксовано жодного звуку, який можна було використовувати. спробуйте записати знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی استعمال کیا جا سکتا آڈیو کی گرفتاری نہیں ہوئی۔ دوبارہ ریکارڈ کرنے کی کوشش کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có âm thanh nào được ghi lại.Cố gắng ghi lại lần nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
