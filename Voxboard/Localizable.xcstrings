    "Until this companion is downloaded, live recordings keep using manual stop.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى يتم تحميل هذا المرافق، لا تزال تسجيلات الحي باستخدام إزالة دستورية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সঙ্গীটি ডাউনলোড না হওয়া পর্যন্ত, লাইভ রেকর্ডিং ম্যানুয়াল স্টপ ব্যবহার করে চলবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis dieses Begleitmodell heruntergeladen ist, nutzen Live-Aufnahmen weiterhin den manuellen Stopp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until this companion is downloaded, live recordings keep using manual stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que se descargue este compañero, las grabaciones en vivo siguen usando el parada manual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à ce que ce compagnon soit téléchargé, les enregistrements en direct continuent d'utiliser un arrêt manuel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक यह साथी डाउनलोड नहीं किया जाता है, लाइव रिकॉर्डिंग मैनुअल स्टॉप का उपयोग जारी रखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampai teman ini diunduh, rekaman langsung terus menggunakan stop manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a quando questo compagno non viene scaricato, le registrazioni dal vivo continuano utilizzando il stop manuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォロワーがダウンロードされるまで、ライブレコーディングは手動停止を使用し続ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동반자가 다운로드될 때까지 라이브 녹음은 수동 정지기를 사용하여 계속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totdat deze metgezel wordt gedownload, blijven live opnames met behulp van handmatige stop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopóki ten towarzyszy nie zostanie pobrany, nagrania na żywo będą kontynuowane przy użyciu ręcznego zatrzymania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que este companheiro seja baixado, as gravações ao vivo continuam usando o stop manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До тех пор, пока этот спутник не будет загружен, записи в прямом эфире продолжают использовать ручной остановку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த இணைப்பை பதிவிறக்கப்படும் வரை, நேரடி சேமிப்புகளை manual stop ஐ பயன்படுத்தி தொடங்குகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จนกว่าผู้ติดตามนี้จะถูกดาวน์โหลดการบันทึกสดจะยังคงใช้การหยุดด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eşlikçi indirilene kadar, canlı kayıtlar manuel durak kullanmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доки цей компаньйон не завантажується, записи в прямому режимі продовжують використовувати ручний зупинок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تک یہ ساتھی ڈاؤن لوڈ نہیں کیا جاتا ہے، لائیو ریکارڈنگ کو دستی سٹپ کا استعمال کرتے ہوئے جاری رکھیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho đến khi người bạn đồng hành này được tải xuống, ghi âm trực tiếp tiếp tiếp tục sử dụng dừng tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直到下载此伴侣,直播录音继续使用手动停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直到下載此伴侶,直播錄音繼續使用手動停止。"
          }
        }
      }
    },
