    "Enter one complete emoji. Use Control–Command–Space to open Character Viewer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمزًا تعبيريًا واحدًا كاملًا. استخدم Control–Command–Space لفتح عارض الأحرف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সম্পূর্ণ ইমোজি লিখুন। ক্যারেক্টার ভিউয়ার খুলতে Control–Command–Space ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie ein vollständiges Emoji ein. Öffnen Sie mit Control–Befehl–Leertaste die Zeichenübersicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one complete emoji. Use Control–Command–Space to open Character Viewer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un emoji completo. Usa Control–Comando–Espacio para abrir el Visor de caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un emoji complet. Utilisez Contrôle + Commande + Espace pour ouvrir le Visualiseur de caractères."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पूरा इमोजी दर्ज करें। कैरेक्टर व्यूअर खोलने के लिए Control–Command–Space का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan satu emoji lengkap. Gunakan Control–Command–Spasi untuk membuka Penampil Karakter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un’emoji completa. Usa Ctrl-Comando-Spazio per aprire il Visore caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な絵文字を1つ入力してください。Control–Command–スペースキーで文字ビューアを開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전한 이모지를 하나 입력하세요. Control–Command–스페이스 바를 사용하여 문자 뷰어를 열 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
