        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வழித்தடத்திற்கு இயல்புநிலை விரைவுச் செயல்களைப் பயன்படுத்து"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้การทำงานด่วนเริ่มต้นสำหรับเส้นทางนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rota için varsayılan hızlı eylemleri kullan"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати типові швидкі дії для цього маршруту"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس روٹ کے لیے ڈیفالٹ فوری کارروائیاں استعمال کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng tác vụ nhanh mặc định cho lộ trình này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此路线使用默认快捷操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為此路線使用預設快速動作"
          }
        }
      }
    },
    "Use the Dock icon or Cmd-Tab to bring Vox.md forward.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدمت صورة Dock أو Cmd-Tab لإرسال Vox.md إلى الأمام."
