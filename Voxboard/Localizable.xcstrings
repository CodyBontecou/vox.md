          "stringUnit": {
            "state": "translated",
            "value": "Записи %lld будут отменены, поскольку требуется указать местоположение."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருப்பிடம் தேவைப்படுவதால் %lld பதிவுகள் ரத்துசெய்யப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึก %lld จะถูกยกเลิกเนื่องจากจำเป็นต้องมีสถานที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum gerekli olduğundan %lld kayıtları iptal edilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи %lld буде скасовано, оскільки потрібне місцезнаходження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ریکارڈنگز منسوخ کر دی جائیں گی کیونکہ مقام درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản ghi %lld sẽ bị hủy vì cần có vị trí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于需要位置，%lld 录制将被取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於需要位置，%lld 錄製將被取消。"
          }
        }
      }
    },
