          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As etiquetas de alto-falantes são adicionadas após a transcrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этикетки для спикеров добавляются после транскрипции."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription பின்னூட்டங்கள் சேர்க்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็กผู้พูดจะถูกเพิ่มหลังจากที่การถ่ายภาพ"
