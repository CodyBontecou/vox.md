    "You can also drag files anywhere onto the Capture document.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك أيضًا سحب الملفات إلى أي مكان في مستند الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ক্যাপচার ডকুমেন্টের যেকোনো জায়গায় ফাইল টেনেও আনতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Dateien auch an eine beliebige Stelle im Erfassungsdokument ziehen."
