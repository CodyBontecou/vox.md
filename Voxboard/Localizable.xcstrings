    "Location access is restricted on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الموقع مقيّد على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে লোকেশন অ্যাক্সেস সীমাবদ্ধ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff ist auf diesem Gerät eingeschränkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is restricted on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación está restringido en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position est restreint sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर लोकेशन एक्सेस प्रतिबंधित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses lokasi dibatasi di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso alla posizione è limitato su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは位置情報へのアクセスが制限されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 위치 접근이 제한되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatietoegang is beperkt op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do lokalizacji jest ograniczony na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à localização está restrito neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к геопозиции на этом устройстве ограничен."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் இருப்பிட அணுகல் கட்டுப்படுத்தப்பட்டுள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงตำแหน่งถูกจำกัดบนอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtta konum erişimi kısıtlı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до геопозиції на цьому пристрої обмежено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے پر مقام تک رسائی محدود ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập vị trí bị giới hạn trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的位置访问受限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的位置取用權限受到限制。"
          }
        }
      }
    },
