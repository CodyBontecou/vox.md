        }
      }
    },
    "Enter a single emoji, not text or multiple emoji. Your current icon has not changed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمزًا تعبيريًا واحدًا، وليس نصًا أو عدة رموز تعبيرية. لم تتغير أيقونتك الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটিমাত্র ইমোজি লিখুন, টেক্সট বা একাধিক ইমোজি নয়। আপনার বর্তমান আইকন বদলায়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie ein einzelnes Emoji ein, keinen Text und nicht mehrere Emojis. Ihr aktuelles Symbol wurde nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a single emoji, not text or multiple emoji. Your current icon has not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un solo emoji, no texto ni varios emojis. Tu icono actual no ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un seul emoji, pas du texte ni plusieurs emojis. Votre icône actuelle n’a pas changé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही इमोजी दर्ज करें, टेक्स्ट या कई इमोजी नहीं। आपका मौजूदा आइकन नहीं बदला है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan satu emoji, bukan teks atau beberapa emoji. Ikon Anda saat ini tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una sola emoji, non testo o più emoji. L’icona attuale non è cambiata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストや複数の絵文字ではなく、絵文字を1つだけ入力してください。現在のアイコンは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트나 여러 이모지가 아닌 이모지 하나만 입력하세요. 현재 아이콘은 변경되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer één emoji in, geen tekst of meerdere emoji. Je huidige symbool is niet gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz pojedyncze emoji, a nie tekst ani kilka emoji. Bieżąca ikona nie została zmieniona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um único emoji, não texto nem vários emojis. Seu ícone atual não foi alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите один эмодзи, а не текст или несколько эмодзи. Текущий значок не изменен."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரை அல்லது பல எமோஜிகள் அல்ல, ஒரே ஒரு எமோஜியை உள்ளிடவும். உங்கள் தற்போதைய ஐகான் மாற்றப்படவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนอีโมจิเพียงตัวเดียว ไม่ใช่ข้อความหรืออีโมจิหลายตัว ไอคอนปัจจุบันของคุณยังไม่เปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin veya birden çok emoji değil, tek bir emoji girin. Geçerli simgeniz değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть один емодзі, а не текст чи кілька емодзі. Поточний значок не змінено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ہی ایموجی درج کریں، متن یا متعدد ایموجی نہیں۔ آپ کا موجودہ آئیکن تبدیل نہیں ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập một emoji duy nhất, không phải văn bản hay nhiều emoji. Biểu tượng hiện tại của bạn chưa thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入单个表情符号，而不是文本或多个表情符号。你当前的图标未更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入單一表情符號，而不是文字或多個表情符號。你目前的圖示未變更。"
          }
        }
      }
    },
    "Enter an emoji to apply, or choose Symbols to use an SF Symbol.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمزًا تعبيريًا لتطبيقه، أو اختر «الرموز» لاستخدام رمز SF Symbol."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রয়োগ করতে একটি ইমোজি লিখুন, বা SF Symbol ব্যবহার করতে ‘সিম্বল’ বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie ein Emoji ein, um es anzuwenden, oder wählen Sie „Symbole“, um ein SF Symbol zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an emoji to apply, or choose Symbols to use an SF Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un emoji para aplicarlo o elige Símbolos para usar un SF Symbol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un emoji à appliquer, ou choisissez Symboles pour utiliser un SF Symbol."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लागू करने के लिए कोई इमोजी दर्ज करें, या SF Symbol उपयोग करने के लिए सिंबल चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan emoji untuk diterapkan, atau pilih Simbol untuk menggunakan SF Symbol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un’emoji da applicare oppure scegli Simboli per usare un SF Symbol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用する絵文字を入力するか、「記号」を選んでSF Symbolを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용할 이모지를 입력하거나, 기호를 선택하여 SF Symbol을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
