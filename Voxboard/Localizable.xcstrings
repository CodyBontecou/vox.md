    },
    "Use whichever route is currently selected in Capture.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام المسار المحدد حاليًا في الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার-এ বর্তমানে বেছে নেওয়া রুট ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route verwenden, die gerade in „Erfassung“ ausgewählt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use whichever route is currently selected in Capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la ruta que esté seleccionada en Captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le parcours actuellement sélectionné dans Capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर में अभी जो भी रूट चुना गया है, उसका उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan rute mana pun yang sedang dipilih di Tangkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il percorso attualmente selezionato in Acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャで現在選択されているルートを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처에서 현재 선택된 루트를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de route die nu is geselecteerd in Vastleggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj trasy aktualnie wybranej w Przechwytywaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a rota selecionada no momento na Captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать маршрут, выбранный сейчас в окне захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிடிப்பில் தற்போது தேர்ந்தெடுக்கப்பட்ட வழித்தடத்தைப் பயன்படுத்து."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เส้นทางที่เลือกอยู่ในการจับภาพขณะนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama'da o anda hangi rota seçiliyse onu kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати маршрут, вибраний зараз у вікні захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر میں اس وقت منتخب جو بھی روٹ ہو اسے استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng lộ trình đang được chọn trong Ghi nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前在“采集”中所选的路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目前在「擷取」中所選的路線。"
          }
        }
      }
    },
    "Use {period} for the selected daily, weekly, monthly, quarterly, or yearly bucket. Tokens also include {date}, {hour}, {minute}, {second}, {year}, {YR} (2-digit year), {month}, {day}, and {week}.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم {period} للفترة المحددة: يومية أو أسبوعية أو شهرية أو ربع سنوية أو سنوية. تشمل الرموز أيضًا {date}، {hour}، {minute}، {second}، {year}، {YR} (السنة برقمين)، {month}، {day}، و{week}."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেছে নেওয়া দৈনিক, সাপ্তাহিক, মাসিক, ত্রৈমাসিক বা বার্ষিক সময়সীমার জন্য {period} ব্যবহার করুন। টোকেনের মধ্যে আরও আছে {date}, {hour}, {minute}, {second}, {year}, {YR} (২-অঙ্কের বছর), {month}, {day} এবং {week}।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie {period} für den ausgewählten täglichen, wöchentlichen, monatlichen, vierteljährlichen oder jährlichen Zeitraum. Weitere Platzhalter sind {date}, {hour}, {minute}, {second}, {year}, {YR} (zweistelliges Jahr), {month}, {day} und {week}."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {period} for the selected daily, weekly, monthly, quarterly, or yearly bucket. Tokens also include {date}, {hour}, {minute}, {second}, {year}, {YR} (2-digit year), {month}, {day}, and {week}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa {period} para el periodo diario, semanal, mensual, trimestral o anual seleccionado. Los tokens también incluyen {date}, {hour}, {minute}, {second}, {year}, {YR} (año de 2 dígitos), {month}, {day} y {week}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez {period} pour la période quotidienne, hebdomadaire, mensuelle, trimestrielle ou annuelle sélectionnée. Les jetons comprennent aussi {date}, {hour}, {minute}, {second}, {year}, {YR} (année à 2 chiffres), {month}, {day} et {week}."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए दैनिक, साप्ताहिक, मासिक, तिमाही या वार्षिक समूह के लिए {period} का उपयोग करें। टोकन में {date}, {hour}, {minute}, {second}, {year}, {YR} (2-अंकों का वर्ष), {month}, {day} और {week} भी शामिल हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan {period} untuk periode harian, mingguan, bulanan, kuartalan, atau tahunan yang dipilih. Token juga mencakup {date}, {hour}, {minute}, {second}, {year}, {YR} (tahun 2 digit), {month}, {day}, dan {week}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa {period} per il periodo giornaliero, settimanale, mensile, trimestrale o annuale selezionato. I token includono anche {date}, {hour}, {minute}, {second}, {year}, {YR} (anno a 2 cifre), {month}, {day} e {week}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した日・週・月・四半期・年の区切りには{period}を使用します。ほかに{date}、{hour}、{minute}、{second}、{year}、{YR}（西暦下2桁）、{month}、{day}、{week}も使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 일별, 주별, 월별, 분기별 또는 연별 구간에는 {period}를 사용하세요. 그 밖에 {date}, {hour}, {minute}, {second}, {year}, {YR}(연도 2자리), {month}, {day}, {week} 토큰도 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik {period} voor de geselecteerde dagelijkse, wekelijkse, maandelijkse, driemaandelijkse of jaarlijkse periode. Andere plaatshouders zijn {date}, {hour}, {minute}, {second}, {year}, {YR} (jaartal met 2 cijfers), {month}, {day} en {week}."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj {period} dla wybranego okresu: dziennego, tygodniowego, miesięcznego, kwartalnego lub rocznego. Dostępne są też tokeny {date}, {hour}, {minute}, {second}, {year}, {YR} (rok dwucyfrowy), {month}, {day} i {week}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {period} para o período diário, semanal, mensal, trimestral ou anual selecionado. Os tokens também incluem {date}, {hour}, {minute}, {second}, {year}, {YR} (ano com 2 dígitos), {month}, {day} e {week}."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте {period} для выбранного периода: день, неделя, месяц, квартал или год. Также доступны токены {date}, {hour}, {minute}, {second}, {year}, {YR} (год из 2 цифр), {month}, {day} и {week}."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த தினசரி, வாராந்திர, மாதாந்திர, காலாண்டு அல்லது ஆண்டுத் தொகுப்புக்கு {period} ஐப் பயன்படுத்தவும். டோக்கன்களில் {date}, {hour}, {minute}, {second}, {year}, {YR} (2 இலக்க ஆண்டு), {month}, {day} மற்றும் {week} ஆகியவையும் அடங்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ {period} สำหรับช่วงรายวัน รายสัปดาห์ รายเดือน รายไตรมาส หรือรายปีที่เลือก โทเค็นยังรวมถึง {date}, {hour}, {minute}, {second}, {year}, {YR} (ปี 2 หลัก), {month}, {day} และ {week}"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen günlük, haftalık, aylık, üç aylık veya yıllık dönem için {period} kullanın. Belirteçler ayrıca {date}, {hour}, {minute}, {second}, {year}, {YR} (2 basamaklı yıl), {month}, {day} ve {week} içerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте {period} для вибраного періоду: день, тиждень, місяць, квартал або рік. Також доступні токени {date}, {hour}, {minute}, {second}, {year}, {YR} (рік із 2 цифр), {month}, {day} і {week}."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب روزانہ، ہفتہ وار، ماہانہ، سہ ماہی یا سالانہ مدت کے لیے {period} استعمال کریں۔ ٹوکنز میں {date}، {hour}، {minute}، {second}، {year}، {YR} (2 ہندسوں کا سال)، {month}، {day} اور {week} بھی شامل ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng {period} cho khoảng hằng ngày, hằng tuần, hằng tháng, hằng quý hoặc hằng năm đã chọn. Các token khác gồm {date}, {hour}, {minute}, {second}, {year}, {YR} (năm 2 chữ số), {month}, {day} và {week}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 {period} 表示所选的每日、每周、每月、每季度或每年分组。变量还包括 {date}、{hour}、{minute}、{second}、{year}、{YR}（两位数年份）、{month}、{day} 和 {week}。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 {period} 表示所選的每日、每週、每月、每季或每年分組。變數還包括 {date}、{hour}、{minute}、{second}、{year}、{YR}（兩位數年份）、{month}、{day} 和 {week}。"
          }
        }
      }
    },
    "Use {period} for the selected daily, weekly, monthly, quarterly, or yearly bucket. Tokens also include {date}, {year}, {YR} (2-digit year), {month}, {day}, and {week}.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام {period} على المفاتيح اليومية، الأسبوعية، الشهرية، الربعية أو السنوية المختارة. {date}, {year}, {YR} (بعد عامين من الزمن) {month}, {day}و و {week}."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যবহার {period} নির্বাচিত দিনের জন্য, সপ্তাহান্তে মাসিক চতুর্থ, বা বার্ষিক বুকিং। টোকেনও রয়েছে। {date}, {year}, {YR} (২০ বছর পর) {month}, {day}, এবং {week}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie {period} für den gewählten Tages-, Wochen-, Monats-, Quartals- oder Jahreszeitraum. Tokens umfassen außerdem {date}, {year}, {YR} (zweistelliges Jahr), {month}, {day} und {week}."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {period} for the selected daily, weekly, monthly, quarterly, or yearly bucket. Tokens also include {date}, {year}, {YR} (2-digit year), {month}, {day}, and {week}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso {period} Para el día de la elección, Semana de la semana, El mes, El cuartel, o el bucket anual. Los tokens también incluyen {date}, {year}, {YR} (Día de 2 años) {month}, {day}, y {week}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez {period} Pour le quotidien choisi, La semaine, Le mois, Quartier à ou du bucket annuel. Les tokens comprennent également {date}, {year}, {YR} (deux ans de plus) {month}, {day}, et {week}."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग करें {period} चुने हुए दिन के लिए, सप्ताह के लिए, महीने के चौथाई, या वार्षिक बकवास। टोकन भी शामिल हैं {date}, {year}, {YR} (२ वर्ष की आयु) {month}, {day}, और {week}."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan {period} Untuk harian yang dipilih, Setiap minggu, Bulan yang Untuk kuartal, atau bucket tahunan. Token juga termasuk {date}, {year}, {YR} (Dalam dua tahun terakhir) {month}, {day}, dan {week}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "utilizzo {period} per il giorno selezionato, settimanale di Il mese, Quartiere di o di bucket annuale. I token includono anche {date}, {year}, {YR} (il secondo anno di vita), {month}, {day}, e {week}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用 {period} 選ばれた日々の、 週刊、 月間、 四半期、 毎年バケット トークンも含む。 {date}, {year}, {YR} (平成2年) {month}, {day}, 和 {week}."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하기 {period} 선택한 매일매일을 위해, 주간 월간 쿼리로 써서 또는 매년 버킷을 토큰은 또한 포함 {date}, {year}, {YR} ( 2년간의 연속적인 연속적인 연속적인 연속적인 연속적인 연속적인 {month}, {day}, 그리고 {week}."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik {period} voor de geselecteerde dagelijkse, wekelijkse, maandelijkse, Het kwartal, Of een jaarlijkse bucket. Tokens omvatten ook {date}, {year}, {YR} (Twee jaar later) {month}, {day}, en {week}."
          }
