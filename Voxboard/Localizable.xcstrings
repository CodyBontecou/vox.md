    "Shift alone cannot be used. Add Control, Option, or Command plus one non-modifier key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استخدام Shift وحدها.إضافة التحكم أو الخيار أو الإدارة بالإضافة إلى مفتاح غير المتغير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু Shift ব্যবহার করা যাবে না. অ্যাপ্লিকেশন, কমান্ড বা নিয়ন্ত্রণ যোগ করুন এবং একটি অ-মডিফাইকার কী।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift allein genügt nicht. Fügen Sie Control, Option oder Command plus eine Nicht-Modifikatortaste hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift alone cannot be used. Add Control, Option, or Command plus one non-modifier key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede usar solo Shift.Añadir Control, Opción o Comando más una clave de no modificador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un contrôle, une option ou une commande plus une clé non-modifiant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल Shift का उपयोग नहीं किया जा सकता है. Control, Option, or Command plus one non-modifier key जोड़ें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift tidak dapat digunakan sendiri. tambahkan Control, Option, atau Command ditambah satu kunci non-modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile utilizzare solo Shift. Aggiungi Controllo, Opzione o Comando più una chiave non modificatrice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift だけでは使用できません. Add Control, Option, or Command plus one non-modifier key. コントロール、オプション、またはコマンドを追加し、変更しないキーを追加します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 혼자서는 사용할 수 없습니다.Control, Option, or Command plus one non-modifier key 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift alleen kan niet worden gebruikt.Toegevoeg Control, Option of Command plus één niet-modificatie-toets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można użyć tylko Shift. Dodaj kontrolę, opcję lub polecenie plus jeden klucz niemodyfikujący."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar Controle, Opção ou Comando mais uma chave não-modificadora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить Control, Option или Command плюс один ключ, не имеющий модификатора."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு மாற்றத்தைத் தவிர்க்க முடியாது.Add Control, Option, or Command plus one non-modifier key."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถใช้ Shift เท่านั้น เพิ่มการควบคุม ตัวเลือกหรือคําสั่งรวมถึงคีย์ที่ไม่ใช่ตัวแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift tek başına kullanılamaz.Control, Option veya Command ekleyin ve bir değiştirici olmayan anahtar ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте Control, Option або Command плюс один ключ, що не змінює."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift صرف استعمال نہیں کیا جا سکتا. Add Control, Option, or Command plus one non-modifier key."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể sử dụng Shift một mình.Thêm Control, Option, hoặc Command cộng với một phím không sửa đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能单独使用 Shift. 添加控制、选项或命令,加上一个非修改键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能單獨使用 Shift. 添加控制、選項或命令,加上一個非修改鍵。"
          }
        }
      }
    },
