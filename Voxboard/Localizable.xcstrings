          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسپیشن ناکام ہوا کیونکہ گھڑی آڈیو فائل کھولنے کے قابل نہیں تھا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trancription thất bại vì tệp âm thanh Watch không thể mở được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录失败了,因为无法打开 Watch 音频文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉錄失敗了,因為無法打開 Watch 音頻文件。"
          }
        }
      }
    },
    "Transcription failed because the Watch recording contains no readable audio.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يحدث الترجمة لأن تسجيل الساعة لا يحتوي على صوت قابل للتعرف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সপ্লিকেশন ব্যর্থ হয়েছে কারণ ঘড়ির রেকর্ডিং কোনও পাঠযোগ্য অডিও অন্তর্ভুক্ত করে না।"
          }
