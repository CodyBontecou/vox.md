    "The selected vault or folder permission expired. Choose it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء إمكانيات الحفرة أو المجلد المختار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচন করা ফোল্ডার বা ফোল্টর অনুমতি শেষ হয়েছে. এটি আবার নির্বাচন করুন."
          }
        },
        "de": {
