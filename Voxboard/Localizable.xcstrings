    "There is no supported content to capture.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد محتوى يدعم لتسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার করার জন্য কোনও সমর্থিত বিষয়বস্তু নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine unterstützten Inhalte zum Erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no supported content to capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay contenido compatible para capturar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de contenu pris en charge à capturer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कब्जा करने के लिए कोई समर्थित सामग्री नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada konten yang didukung untuk ditangkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono contenuti supportati da catturare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャするためのコンテンツはサポートされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처할 수 있는 지원되는 콘텐츠가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen ondersteunde inhoud om te vangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma obsługiwanej zawartości do przechwytywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há conteúdo suportado para capturar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет поддерживаемого контента для захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடிக்கடி எழுதப்பட்ட பொருட்கள் இல்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเนื้อหาที่สนับสนุนเพื่อจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabul etmek için desteklenen bir içerik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає підтримуваного контенту для захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پکڑنے کے لئے کوئی حمایت کردہ مواد نہیں ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nội dung được hỗ trợ để thu thập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有支持的内容可以捕捉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有支持的內容可以捕捉。"
          }
        }
      }
    },
    "These compatibility settings apply to direct voice runs only when no unified Capture route is selected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم هذه الإعدادات للتوافق على الممارسات الصوتية المباشرة فقط عندما لا يتم اختيار مسار تسجيل واحد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সামঞ্জস্যপূর্ণতা সেটিংসগুলি শুধুমাত্র সরাসরি ভয়েস চালানোর জন্য প্রযোজ্য যখন কোন একক ক্যাপচার রুট নির্বাচন করা হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kompatibilitätseinstellungen gelten nur für direkte Sprachläufe, wenn keine einheitliche Erfassungsroute ausgewählt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These compatibility settings apply to direct voice runs only when no unified Capture route is selected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas configuraciones de compatibilidad se aplican a las ejecuciones de voz directa sólo cuando no se selecciona una ruta unificada de Capture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces paramètres de compatibilité s’appliquent aux sorties vocales directes uniquement lorsque le parcours Unified Capture n’est pas sélectionné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन संगतता सेटिंग्स सीधे वॉइस चलाने पर केवल तब लागू होते हैं जब एकीकृत कैप्चर मार्ग नहीं चुना जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan kompatibilitas ini berlaku untuk suara langsung hanya ketika tidak ada rute Capture yang disatukan dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste impostazioni di compatibilità si applicano alle corse vocali dirette solo quando non è selezionato un percorso Unificato di Cattura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの互換性設定は、統一キャプチャルートが選択されていない場合にのみ、直接の音声実行に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 호환성 설정을 사용하면 통합 캡처 경로가 선택되지 않은 경우에만 직접 음성 실행이 가능합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze compatibiliteitsinstellingen zijn alleen van toepassing op directe spraakrondleidingen wanneer geen eenheidsgerichte route is geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te ustawienia zgodności mają zastosowanie do bezpośrednich głosów tylko wtedy, gdy nie jest zaznaczona jednolita trasa przechwytywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas configurações de compatibilidade aplicam-se às vozes diretas apenas quando não estiver selecionada uma rota Unified Capture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти параметры совместимости применяются к прямым голосовым вызовам только тогда, когда не выбран единый маршрут «Захват»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஒப்பிடும் நிலைமைகள் ஒரே நேரத்தில் ஒரு Unified Capture Route தேர்வு செய்யப்படவில்லை என்றால் நேரடி பேச்சு இயக்கங்கள் பயன்படுத்தப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าความเข้ากันได้เหล่านี้ใช้กับการทํางานเสียงโดยตรงเท่านั้นเมื่อไม่มีเส้นทางจับภาพแบบรวมที่เลือกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uyumluluk ayarları, yalnızca birleşik Capture rotası seçilmediğinde doğrudan ses çalıştırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці налаштування сумісності застосовуються до прямих голосових виступів тільки тоді, коли не вибрано єдиного маршруту Capture."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان مطابقت کی ترتیبات صرف براہ راست آواز چلانے پر لاگو ہوتے ہیں جب ایکس این سی پی راہ منتخب نہیں کیا جاتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thiết đặt tương thích này áp dụng cho các cuộc gọi thoại trực tiếp chỉ khi không có tuyến đường Capture thống nhất được chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些兼容性设置仅适用于没有选择统一捕捉路线的直接语音运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些兼容性設置僅適用於沒有選擇統一捕捉路線的直接語音運行。"
          }
        }
      }
    },
    "This Route is disabled or no longer exists on iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المسار معطّل أو لم يعد موجودًا على iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রুটটি নিষ্ক্রিয় বা iPhone-এ আর নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Route ist deaktiviert oder existiert auf dem iPhone nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Route is disabled or no longer exists on iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ruta está desactivada o ya no existe en el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce parcours est désactivé ou n’existe plus sur l’iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रूट बंद है या iPhone पर अब मौजूद नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rute ini dinonaktifkan atau sudah tidak ada di iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo percorso è disattivato o non esiste più su iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルートはiPhoneで無効になっているか、存在しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 루트는 iPhone에서 비활성화되었거나 더 이상 존재하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze route is uitgeschakeld of bestaat niet meer op de iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta trasa jest wyłączona lub już nie istnieje na iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rota está desativada ou não existe mais no iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот маршрут отключен или больше не существует на iPhone."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வழித்தடம் முடக்கப்பட்டுள்ளது அல்லது iPhone இல் இனி இல்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นทางนี้ถูกปิดใช้งานหรือไม่มีอยู่บน iPhone แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Rota iPhone'da devre dışı veya artık yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей маршрут вимкнено або він більше не існує на iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ روٹ iPhone پر غیر فعال ہے یا اب موجود نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
