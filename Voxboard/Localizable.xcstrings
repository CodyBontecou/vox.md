        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அனுமதிக்கும்போது மட்டுமே அனுமதி கோரப்படும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะขอสิทธิ์เฉพาะเมื่อคุณอนุญาตเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin yalnızca siz izin verdiğinizde istenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл запитується, лише коли ви це дозволите"
