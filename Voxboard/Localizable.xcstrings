    "Tap to start or stop. Long-press for detailed recording controls.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الـ Start or Stop. Long-press for detailed recording controls."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু বা থামানোর জন্য টপ করুন. বিস্তারিত রেকর্ডিং নিয়ন্ত্রণ জন্য দীর্ঘ চাপ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie zum Starten oder Stoppen. Lange gedrückt halten für detaillierte Aufnahmesteuerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to start or stop. Long-press for detailed recording controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse para iniciar o detener. Presione largo para obtener controles de grabación detallados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Start ou Stop.Prenez une pression longue pour obtenir des contrôles d'enregistrement détaillés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रारंभ या रोकने के लिए दबाएं. विस्तारित रिकॉर्डिंग नियंत्रणों के लिए लंबी दबाएं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan untuk memulai atau menghentikan. tekan panjang untuk kontrol rekaman yang rinci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccare per avviare o fermare. Premere a lungo per i controlli dettagliati di registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタートまたは停止するには、長い押しで詳細な録音コントロールをタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 또는 중지하기 위해 누르십시오.더 자세한 녹음 제어를 위해 긴 압력을 누릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om te starten of te stoppen. Druk lang voor gedetailleerde opnamecontrole."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij, aby rozpocząć lub zatrzymać.Długa naciśnięcie, aby uzyskać szczegółowe kontrolki nagrywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para iniciar ou parar. Pressione longamente para obter controles detalhados de gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы начать или остановиться.Долгое нажатие для детальных контролей записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில், நீண்ட நேரம் கழித்து, நீண்ட நேரம் கழித்து, நீண்ட நேரம் கழித்து, நீண்ட நேரம் கழித்து, நீண்ட நேரம் கழித்து, நீ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกเพื่อเริ่มต้นหรือหยุด การกดยาวเพื่อให้สามารถควบคุมการบันทึกรายละเอียดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlat veya durdurmak için dokunun. Detaylı kayıt kontrolleri için uzun basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть, щоб почати або зупинити. Довгий тиск для детальних контролів запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع یا روکنے کے لئے ٹکٹ کریں.مطابق کی تفصیل کے لئے طویل دباؤ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn để bắt đầu hoặc dừng lại. nhấn dài để kiểm soát ghi âm chi tiết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击开始或停止. 长按下详细的记录控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊開始或停止. 長按下詳細的記錄控制。"
          }
        }
      }
    },
