    "Catch a thought.\nKeep it close.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catch a thought.\nKeep it close."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبض على الفكر. \n أبقيه قريبًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি চিন্তা ধরা. \n এটাকে কাছে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fangen Sie einen Gedanken. \n Bleiben Sie dran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capte un pensamiento. \n Mantenlo cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attrapez une pensée. \n Gardez-le près de vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक विचार पकड़ो. \n इसे पास रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkap sebuah pemikiran. \n Dekatkan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cattura un pensiero. \n Tienilo vicino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "考えをキャッチしてください。 \n近くに置いておいてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각을 잡아라. \n 가까이 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vang een gedachte op. \n Houd het dichtbij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Złap myśl. \n Trzymaj go blisko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue um pensamento. \n Mantenha-o por perto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уловить мысль. \n Держите это под рукой."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு சிந்தனையைப் பிடிக்கவும். \n அருகில் வைக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับความคิด \n เก็บไว้ใกล้ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir düşünceyi yakalayın. \n Yakınınızda tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зловити думку. \n Тримайте його поруч."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک سوچ پکڑو۔ \n اسے قریب رکھیں۔"
          }
        },
        "vi": {
