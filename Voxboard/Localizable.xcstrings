    "Completed captures and transcripts will appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا الالتقاطات والنصوص المكتوبة المكتملة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পন্ন ক্যাপচার ও ট্রান্সক্রিপ্ট এখানে দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Erfassungen und Transkripte erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed captures and transcripts will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas y transcripciones completadas aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures et transcriptions terminées apparaîtront ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे हुए कैप्चर और ट्रांसक्रिप्ट यहाँ दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan dan transkrip yang selesai akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le acquisizioni e le trascrizioni completate appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したキャプチャと文字起こしがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 캡처와 전사본이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooide vastleggingen en transcripten verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się ukończone przechwycenia i transkrypcje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas e transcrições concluídas aparecerão aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся завершенные захваты и транскрипты."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிந்த பிடிப்புகளும் உரைப்படிகளும் இங்கே தோன்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพและข้อความถอดเสียงที่เสร็จสิ้นจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan yakalamalar ve transkriptler burada görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являться завершені захоплення й транскрипти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مکمل کیپچرز اور ٹرانسکرپٹس یہاں دکھائی دیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản ghi nhanh và bản chép lời đã hoàn tất sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的采集和转录文本将显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的擷取和逐字稿會顯示在這裡。"
          }
        }
      }
    },
