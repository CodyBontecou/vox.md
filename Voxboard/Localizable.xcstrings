    "Choose the physical screen edge for pinned route alternatives. The selected route and Send stay in their usual positions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر حافة الشاشة الفعلية لبدائل المسارات المثبّتة. يبقى المسار المحدد وزر «إرسال» في موضعيهما المعتادين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন করা বিকল্প রুটগুলোর জন্য স্ক্রিনের প্রান্ত বেছে নিন। বেছে নেওয়া রুট ও ‘পাঠান’ তাদের স্বাভাবিক জায়গায় থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den physischen Bildschirmrand für angeheftete Routenalternativen. Die ausgewählte Route und „Senden“ bleiben an ihrer gewohnten Position."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the physical screen edge for pinned route alternatives. The selected route and Send stay in their usual positions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el borde físico de la pantalla para las rutas fijadas alternativas. La ruta seleccionada y Enviar se mantienen en su posición habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le bord physique de l’écran pour les autres parcours épinglés. Le parcours sélectionné et Envoyer restent à leur place habituelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन किए गए वैकल्पिक रूट्स के लिए स्क्रीन का भौतिक किनारा चुनें। चुना गया रूट और भेजें अपनी सामान्य जगह पर रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tepi layar fisik untuk alternatif rute yang disematkan. Rute yang dipilih dan Kirim tetap di posisi biasanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il bordo fisico dello schermo per i percorsi fissati alternativi. Il percorso selezionato e Invia restano nella posizione abituale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めしたルートの候補を表示する画面の端を選択します。選択中のルートと「送信」は通常の位置のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 대체 루트를 표시할 화면 가장자리를 선택하세요. 선택된 루트와 보내기 버튼은 원래 위치에 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de fysieke schermrand voor vastgezette alternatieve routes. De geselecteerde route en ‘Verstuur’ blijven op hun gebruikelijke plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz fizyczną krawędź ekranu dla przypiętych alternatywnych tras. Wybrana trasa i Wyślij pozostają na zwykłych miejscach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a borda física da tela para as rotas fixadas alternativas. A rota selecionada e o botão Enviar ficam nas posições de sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите край экрана для альтернативных закрепленных маршрутов. Выбранный маршрут и «Отправить» остаются на обычных местах."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொருத்திய மாற்று வழித்தடங்களுக்கான திரையின் பக்க விளிம்பைத் தேர்ந்தெடுக்கவும். தேர்ந்தெடுத்த வழித்தடமும் அனுப்பு பொத்தானும் வழக்கமான இடங்களிலேயே இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกขอบหน้าจอสำหรับเส้นทางทางเลือกที่ปักหมุด เส้นทางที่เลือกและปุ่มส่งจะอยู่ในตำแหน่งเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenen alternatif rotalar için fiziksel ekran kenarını seçin. Seçili rota ve Gönder her zamanki konumlarında kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть край екрана для альтернативних закріплених маршрутів. Вибраний маршрут і «Надіслати» залишаються на звичних місцях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پن شدہ متبادل روٹس کے لیے اسکرین کا کنارہ منتخب کریں۔ منتخب روٹ اور بھیجیں اپنی معمول کی جگہ پر رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn cạnh màn hình vật lý cho các lộ trình thay thế đã ghim. Lộ trình đang chọn và nút Gửi vẫn ở vị trí thông thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择固定的备选路线显示在屏幕的哪一侧。所选路线和“发送”保持在原来的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇釘選的備選路線顯示在螢幕的哪一側。所選路線和「傳送」保持在原本的位置。"
          }
        }
      }
    },
