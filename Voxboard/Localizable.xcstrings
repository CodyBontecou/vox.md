    "Retained for existing shortcuts. New shortcuts should choose only a Route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محتفظ به للاختصارات الحالية. يجب أن تختار الاختصارات الجديدة مسارًا فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিদ্যমান শর্টকাটের জন্য রাখা হয়েছে। নতুন শর্টকাটে শুধু একটি রুট বেছে নেওয়া উচিত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für vorhandene Kurzbefehle beibehalten. Neue Kurzbefehle sollten nur eine Route auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retained for existing shortcuts. New shortcuts should choose only a Route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva para los atajos existentes. Los atajos nuevos solo deben elegir una ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé pour les raccourcis existants. Les nouveaux raccourcis ne doivent choisir qu’un parcours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा शॉर्टकट्स के लिए रखा गया है। नए शॉर्टकट्स में केवल रूट चुनना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipertahankan untuk pintasan yang ada. Pintasan baru sebaiknya hanya memilih Rute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenuto per i comandi rapidi esistenti. I nuovi comandi rapidi dovrebbero scegliere solo un percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のショートカット用に残されています。新しいショートカットではルートのみを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 단축어를 위해 유지됩니다. 새 단축어에서는 루트만 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behouden voor bestaande opdrachten. Nieuwe opdrachten hoeven alleen een route te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowane dla istniejących skrótów. Nowe skróty powinny wybierać tylko trasę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantido para atalhos existentes. Novos atalhos devem escolher apenas uma Rota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено для существующих команд. В новых командах выбирайте только маршрут."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்கனவே உள்ள ஷார்ட்கட்களுக்காக வைக்கப்பட்டுள்ளது. புதிய ஷார்ட்கட்கள் ஒரு வழித்தடத்தை மட்டும் தேர்ந்தெடுக்க வேண்டும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไว้สำหรับคำสั่งลัดที่มีอยู่ คำสั่งลัดใหม่ควรเลือกเฉพาะเส้นทาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut kestirmeler için korunur. Yeni kestirmeler yalnızca bir Rota seçmelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено для наявних команд. У нових командах вибирайте лише маршрут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ شارٹ کٹس کے لیے برقرار رکھا گیا۔ نئے شارٹ کٹس کو صرف روٹ منتخب کرنا چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được giữ lại cho các phím tắt hiện có. Phím tắt mới chỉ nên chọn lộ trình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为现有快捷指令保留。新的快捷指令只需选择路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為現有捷徑保留。新的捷徑只需選擇路線。"
          }
        }
      }
    },
