          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostawa jest aktywna.Czekaj chwilę przed wyrzuceniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A entrega de captura está ativa. Espere um momento antes de descartar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доставка захватывает активную.Подождите некоторое время, прежде чем выбросить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கதையை எழுதிவிட்டு, ஒரு நிமிடம் காத்திருக்க வேண்டும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจัดส่งการจับภาพใช้งานได้ รอชะตาก่อนที่จะถอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kablosuz teslimat aktiftir. atmadan önce bir an bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажити відео: Поки що неможливо, почекайте кілька хвилин, перш ніж викинути."
