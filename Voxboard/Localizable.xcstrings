        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது வேறொரு குறிப்பையோ ஒலி இணைப்பையோ எழுதாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะไม่เขียนโน้ตหรือไฟล์เสียงแนบเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
