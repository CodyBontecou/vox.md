    "Permission expired. Choose the folder again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الإذن. اختر المجلد مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
