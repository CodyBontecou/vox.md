          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Quick Capture e aggiungi screenshot con la preset di captura selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Capture を開いて、選択した Capture Preset でスクリーンショットを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
