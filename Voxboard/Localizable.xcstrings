          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル Keeping Typed Markdown, OCR、 録音された文字と同じように、"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
