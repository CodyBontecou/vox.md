    "%lld recordings will be canceled because location is required.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إلغاء تسجيلات %lld لأن الموقع مطلوب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld রেকর্ডিং বাতিল করা হবে কারণ অবস্থান প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Aufnahmen werden abgebrochen, da der Standort erforderlich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld recordings will be canceled because location is required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones de %lld se cancelarán porque se requiere la ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements %lld seront annulés car la localisation est requise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld रिकॉर्डिंग रद्द कर दी जाएगी क्योंकि स्थान आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman %lld akan dibatalkan karena memerlukan lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le registrazioni %lld verranno annullate perché è richiesta la posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld の録音は位置情報が必要なためキャンセルされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 녹음은 위치가 필요하기 때문에 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld opnames worden geannuleerd omdat locatie vereist is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania %lld zostaną anulowane, ponieważ wymagana jest lokalizacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações de %lld serão canceladas porque a localização é necessária."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи %lld будут отменены, поскольку требуется указать местоположение."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருப்பிடம் தேவைப்படுவதால் %lld பதிவுகள் ரத்துசெய்யப்படும்."
