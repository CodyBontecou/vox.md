    "Destination Not Configured. Choose where this Capture writes Markdown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد الوجهة. اختر مكان كتابة هذا الالتقاط لملف Markdown."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গন্তব্য কনফিগার করা নেই। এই ক্যাপচার কোথায় Markdown লিখবে তা বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel nicht konfiguriert. Wählen Sie, wohin diese Erfassung Markdown schreibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination Not Configured. Choose where this Capture writes Markdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destino sin configurar. Elige dónde escribe Markdown esta captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination non configurée. Choisissez où cette capture écrit le Markdown."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गंतव्य कॉन्फ़िगर नहीं है। चुनें कि यह कैप्चर Markdown कहाँ लिखे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tujuan Belum Dikonfigurasi. Pilih tempat Tangkapan ini menulis Markdown."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinazione non configurata. Scegli dove questa acquisizione scrive il Markdown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先が設定されていません。このキャプチャがMarkdownを書き込む場所を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 위치가 구성되지 않았습니다. 이 캡처가 Markdown을 기록할 위치를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestemming niet geconfigureerd. Kies waar deze vastlegging Markdown naartoe schrijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie skonfigurowano miejsca docelowego. Wybierz, gdzie to przechwycenie ma zapisać Markdown."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destino Não Configurado. Escolha onde esta captura escreve o Markdown."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место назначения не настроено. Выберите, куда этот захват записывает Markdown."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேருமிடம் உள்ளமைக்கப்படவில்லை. இந்தப் பிடிப்பு Markdown ஐ எங்கு எழுத வேண்டும் என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้กำหนดค่าปลายทาง เลือกตำแหน่งที่การจับภาพนี้จะเขียน Markdown"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef Yapılandırılmadı. Bu Yakalamanın Markdown'ı nereye yazacağını seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місце призначення не налаштовано. Виберіть, куди це захоплення записує Markdown."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منزل ترتیب نہیں دی گئی۔ منتخب کریں کہ یہ کیپچر Markdown کہاں لکھے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cấu hình đích. Chọn nơi bản ghi nhanh này ghi Markdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置目标位置。请选择此采集写入 Markdown 的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定目標位置。請選擇此擷取寫入 Markdown 的位置。"
          }
        }
      }
    },
