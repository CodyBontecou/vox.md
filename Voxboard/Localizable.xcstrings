            "value": "위치 요청이 이미 진행 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt al een locatieverzoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie lokalizacji jest już w toku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
