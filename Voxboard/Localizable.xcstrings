          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پروسیسنگ، کوالٹ راؤٹس، انٹرویو فارمیٹنگ، ملحقوں اور ریٹری رویے کو ترتیب دیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình xử lý, đường dẫn vault, định dạng mục nhập, đính kèm và hành vi retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
