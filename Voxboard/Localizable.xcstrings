          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвіл закінчився. Виберіть папку знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازت کی میعاد ختم ہو گئی۔ فولڈر دوبارہ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
