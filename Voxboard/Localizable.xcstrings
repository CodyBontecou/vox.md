    "The note was saved, but its audio attachment failed. %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخزين الملاحظة ولكن ملف الصوت قد لا يحدث. %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটটি সংরক্ষিত হয়েছে। কিন্তু তার অডিও অ্যাডভেঞ্জ ব্যর্থ হয়েছে। %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notiz wurde gesichert, aber der Audioanhang schlug fehl. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note was saved, but its audio attachment failed. %@"
          }
        },
        "es": {
