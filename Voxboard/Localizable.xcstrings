            "value": "Jalan yang relatif ke vault atau folder yang dipilih, Contohnya proyek/Vox.md."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Path relativo alla cassa o alla cartella selezionata, Per esempio, i progettiVox.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したボックスまたはフォルダーに関連するパス、 例えば、プロジェクト/Vox.md."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 vault 또는 folder에 대한 경로, 예를 들어 프로젝트/Vox.md."
          }
        },
        "nl": {
