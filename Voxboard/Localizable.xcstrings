    "The keyboard could not receive the transcript. The recording was preserved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على لوحة المفاتيح استلام النص المكتوب. تم الاحتفاظ بالتسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কীবোর্ড ট্রান্সক্রিপ্টটি গ্রহণ করতে পারেনি। রেকর্ডিংটি সংরক্ষিত আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur konnte das Transkript nicht empfangen. Die Aufnahme wurde beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyboard could not receive the transcript. The recording was preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado no pudo recibir la transcripción. Se conservó la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier n’a pas pu recevoir la transcription. L’enregistrement a été conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीबोर्ड को ट्रांसक्रिप्ट नहीं मिल सकी। रिकॉर्डिंग सुरक्षित रखी गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan ketik tidak dapat menerima transkrip. Rekaman tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera non ha potuto ricevere la trascrizione. La registrazione è stata conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードが文字起こしを受け取れませんでした。録音は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 전사본을 받을 수 없습니다. 녹음은 보존되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het toetsenbord kon het transcript niet ontvangen. De opname is behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawiatura nie mogła odebrać transkrypcji. Nagranie zostało zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado não conseguiu receber a transcrição. A gravação foi preservada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатура не смогла получить транскрипт. Запись сохранена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விசைப்பலகையால் உரைப்படியைப் பெற முடியவில்லை. பதிவு பாதுகாக்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แป้นพิมพ์ไม่สามารถรับข้อความถอดเสียงได้ การบันทึกได้รับการเก็บรักษาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye transkripti alamadı. Kayıt korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіатура не змогла отримати транскрипт. Запис збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کی بورڈ ٹرانسکرپٹ وصول نہیں کر سکا۔ ریکارڈنگ محفوظ رکھی گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím không thể nhận bản chép lời. Bản ghi âm vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘无法接收转录文本。录音已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤無法接收逐字稿。錄音已保留。"
          }
        }
      }
    },
    "The microphone is muted. Unmute it, then try recording again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميكروفون مكتوم. ألغِ الكتم، ثم حاول التسجيل مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোন মিউট করা আছে। আনমিউট করে আবার রেকর্ড করার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist stummgeschaltet. Heben Sie die Stummschaltung auf und versuchen Sie die Aufnahme dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is muted. Unmute it, then try recording again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está silenciado. Actívalo y vuelve a intentar grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro est coupé. Réactivez-le, puis réessayez d’enregistrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन म्यूट है। उसे अनम्यूट करें, फिर से रिकॉर्ड करके देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon dibisukan. Bunyikan, lalu coba rekam lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è disattivato. Riattivalo, poi prova di nuovo a registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが消音になっています。消音を解除してから、もう一度録音してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 음소거되어 있습니다. 음소거를 해제한 후 다시 녹음해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon is gedempt. Hef het dempen op en probeer daarna opnieuw op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon jest wyciszony. Wyłącz wyciszenie i spróbuj nagrać ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está silenciado. Ative o som e tente gravar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон выключен. Включите его и попробуйте записать снова."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்ரோஃபோன் ஒலியடக்கப்பட்டுள்ளது. ஒலியை இயக்கி, மீண்டும் பதிவுசெய்ய முயற்சிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนถูกปิดเสียงอยู่ เปิดเสียงแล้วลองบันทึกอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonun sesi kapalı. Sesini açın, ardından yeniden kaydetmeyi deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон вимкнено. Увімкніть його та спробуйте записати знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیکروفون میوٹ ہے۔ اسے ان میوٹ کریں، پھر دوبارہ ریکارڈ کرنے کی کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô đang bị tắt tiếng. Hãy bật tiếng rồi thử ghi âm lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风已静音。请取消静音，然后再次尝试录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風已靜音。請取消靜音，然後再次嘗試錄音。"
          }
        }
      }
    },
    "The microphone isn't receiving audio. Check your input device or restart your iPhone, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستقبل الميكروفون أي صوت. تحقق من جهاز الإدخال أو أعد تشغيل iPhone، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোনে কোনো অডিও আসছে না। আপনার ইনপুট ডিভাইস পরীক্ষা করুন বা iPhone রিস্টার্ট করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon empfängt kein Audio. Prüfen Sie Ihr Eingabegerät oder starten Sie Ihr iPhone neu und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone isn't receiving audio. Check your input device or restart your iPhone, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono no está recibiendo audio. Comprueba tu dispositivo de entrada o reinicia el iPhone y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro ne reçoit aucun son. Vérifiez votre périphérique d’entrée ou redémarrez votre iPhone, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन को ऑडियो नहीं मिल रहा है। अपना इनपुट डिवाइस जाँचें या अपना iPhone रीस्टार्ट करें, फिर से प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tidak menerima audio. Periksa perangkat input Anda atau mulai ulang iPhone, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono non riceve audio. Controlla il dispositivo di input o riavvia iPhone, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクにオーディオが入力されていません。入力デバイスを確認するかiPhoneを再起動してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크에 오디오가 입력되지 않습니다. 입력 기기를 확인하거나 iPhone을 재시동한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon ontvangt geen audio. Controleer je invoerapparaat of herstart je iPhone en probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon nie odbiera dźwięku. Sprawdź urządzenie wejściowe lub uruchom ponownie iPhone, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone não está recebendo áudio. Verifique o dispositivo de entrada ou reinicie o iPhone e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон не получает звук. Проверьте устройство ввода или перезапустите iPhone, затем повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்ரோஃபோன் ஒலியைப் பெறவில்லை. உங்கள் உள்ளீட்டுச் சாதனத்தைச் சரிபார்க்கவும் அல்லது iPhone ஐ மறுதொடக்கம் செய்து, மீண்டும் முயற்சிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟนไม่ได้รับเสียง ตรวจสอบอุปกรณ์ป้อนข้อมูลหรือรีสตาร์ท iPhone ของคุณ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon ses almıyor. Giriş aygıtınızı denetleyin veya iPhone'unuzu yeniden başlatın, ardından yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон не отримує звук. Перевірте пристрій введення або перезапустіть iPhone, потім спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیکروفون کو آڈیو موصول نہیں ہو رہی۔ اپنا ان پٹ آلہ چیک کریں یا اپنا iPhone ری اسٹارٹ کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô không nhận được âm thanh. Kiểm tra thiết bị đầu vào hoặc khởi động lại iPhone, sau đó thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风未接收到音频。请检查你的输入设备或重新启动 iPhone，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風未接收到音訊。請檢查你的輸入裝置或重新啟動 iPhone，然後再試一次。"
          }
        }
      }
    },
    "The model overrides Settings › Models for this route’s recordings. Identify Speakers detects and labels multiple voices entirely on device. The speaker model downloads the first time this route uses it. Speaker identification is best-effort; if it cannot run, Vox.md keeps the normal transcript.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز النموذج إعداد الإعدادات › النماذج لتسجيلات هذا المسار. تكتشف ميزة «تحديد المتحدثين» الأصوات المتعددة وتصنّفها بالكامل على الجهاز. يتم تنزيل نموذج المتحدثين في أول مرة يستخدمه فيها هذا المسار. تحديد المتحدثين هو أفضل جهد ممكن؛ وإذا تعذّر تشغيله، يحتفظ Vox.md بالنص المكتوب المعتاد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রুটের রেকর্ডিংয়ের জন্য মডেলটি সেটিংস › মডেল-কে ওভাররাইড করে। ‘বক্তা শনাক্ত করুন’ পুরোপুরি ডিভাইসে একাধিক কণ্ঠ শনাক্ত ও লেবেল করে। এই রুট প্রথমবার ব্যবহার করলে বক্তা মডেলটি ডাউনলোড হয়। বক্তা শনাক্তকরণ যথাসাধ্য চেষ্টা; এটি চালানো না গেলে Vox.md স্বাভাবিক ট্রান্সক্রিপ্ট রাখে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell überschreibt „Einstellungen“ › „Modelle“ für die Aufnahmen dieser Route. „Sprecher erkennen“ erkennt und kennzeichnet mehrere Stimmen vollständig auf dem Gerät. Das Sprechermodell wird geladen, wenn diese Route es zum ersten Mal verwendet. Die Sprechererkennung erfolgt nach bestem Bemühen; falls sie nicht ausgeführt werden kann, behält Vox.md das normale Transkript."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model overrides Settings › Models for this route’s recordings. Identify Speakers detects and labels multiple voices entirely on device. The speaker model downloads the first time this route uses it. Speaker identification is best-effort; if it cannot run, Vox.md keeps the normal transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo reemplaza Ajustes › Modelos para las grabaciones de esta ruta. Identificar hablantes detecta y etiqueta varias voces totalmente en el dispositivo. El modelo de hablantes se descarga la primera vez que esta ruta lo usa. La identificación de hablantes es aproximada; si no se puede ejecutar, Vox.md conserva la transcripción normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle remplace Réglages › Modèles pour les enregistrements de ce parcours. Identifier les intervenants détecte et étiquette plusieurs voix entièrement sur l’appareil. Le modèle d’intervenants est téléchargé la première fois que ce parcours l’utilise. L’identification des intervenants est approximative ; si elle ne peut pas s’exécuter, Vox.md conserve la transcription normale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मॉडल इस रूट की रिकॉर्डिंग के लिए सेटिंग्ज़ › मॉडल को ओवरराइड करता है। वक्ताओं की पहचान करें पूरी तरह डिवाइस पर कई आवाज़ों का पता लगाता है और उन्हें लेबल करता है। वक्ता मॉडल पहली बार तब डाउनलोड होता है जब यह रूट उसका उपयोग करता है। वक्ता की पहचान सर्वोत्तम प्रयास पर आधारित है; अगर यह नहीं चल पाती, तो Vox.md सामान्य ट्रांसक्रिप्ट रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini menggantikan Pengaturan › Model untuk rekaman rute ini. Identifikasi Pembicara mendeteksi dan melabeli beberapa suara sepenuhnya di perangkat. Model pembicara diunduh saat pertama kali rute ini menggunakannya. Identifikasi pembicara bersifat upaya terbaik; jika tidak dapat dijalankan, Vox.md menyimpan transkrip normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello sostituisce Impostazioni › Modelli per le registrazioni di questo percorso. Identifica interlocutori rileva ed etichetta più voci interamente sul dispositivo. Il modello degli interlocutori viene scaricato la prima volta che questo percorso lo usa. L’identificazione degli interlocutori non è garantita; se non può essere eseguita, Vox.md mantiene la trascrizione normale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルは、このルートの録音について「設定」›「モデル」の設定より優先されます。「話者を識別」は、複数の声を完全にデバイス上で検出してラベル付けします。話者モデルは、このルートで初めて使用するときにダウンロードされます。話者の識別はベストエフォートです。実行できない場合、Vox.mdは通常の文字起こしを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 이 루트의 녹음에 대해 설정 › 모델보다 우선합니다. ‘화자 식별’은 여러 목소리를 완전히 기기에서 감지하고 레이블을 붙입니다. 화자 모델은 이 루트가 처음 사용할 때 다운로드됩니다. 화자 식별은 최선의 노력으로 수행되며, 실행할 수 없으면 Vox.md는 일반 전사본을 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model overschrijft Instellingen › Modellen voor de opnamen van deze route. ‘Herken sprekers’ detecteert en labelt meerdere stemmen volledig op het apparaat. Het sprekermodel wordt gedownload wanneer deze route het voor het eerst gebruikt. Sprekerherkenning gebeurt naar beste vermogen; als dit niet lukt, behoudt Vox.md het normale transcript."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model zastępuje ustawienie Ustawienia › Modele dla nagrań tej trasy. Identyfikacja mówców wykrywa i oznacza wiele głosów w całości na urządzeniu. Model mówców zostanie pobrany przy pierwszym użyciu przez tę trasę. Identyfikacja mówców działa w miarę możliwości; jeśli nie może zostać uruchomiona, Vox.md zachowa zwykłą transkrypcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo substitui Ajustes › Modelos para as gravações desta rota. Identificar Locutores detecta e rotula várias vozes inteiramente no dispositivo. O modelo de locutores é baixado na primeira vez que esta rota o usa. A identificação de locutores é aproximada; se não puder ser executada, o Vox.md mantém a transcrição normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель заменяет Настройки › Модели для записей этого маршрута. «Определять говорящих» распознает и помечает несколько голосов полностью на устройстве. Модель говорящих загружается при первом использовании этим маршрутом. Определение говорящих работает по возможности; если оно не сработает, Vox.md сохранит обычный транскрипт."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வழித்தடத்தின் பதிவுகளுக்கு, மாதிரி அமைப்புகள் › மாதிரிகள் என்பதை மேலெழுதுகிறது. பேச்சாளர்களை அடையாளம் காண் என்பது பல குரல்களை முழுவதும் சாதனத்திலேயே கண்டறிந்து குறியிடும். இந்த வழித்தடம் முதன்முறையாகப் பயன்படுத்தும்போது பேச்சாளர் மாதிரி பதிவிறக்கப்படும். பேச்சாளர் அடையாளம் சிறந்த முயற்சி அடிப்படையிலானது; அது இயங்க முடியாவிட்டால், Vox.md வழக்கமான உரைப்படியை வைத்திருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลนี้จะแทนที่การตั้งค่า › โมเดล สำหรับการบันทึกของเส้นทางนี้ “ระบุผู้พูด” จะตรวจหาและติดป้ายเสียงพูดหลายเสียงบนอุปกรณ์ทั้งหมด โมเดลผู้พูดจะดาวน์โหลดในครั้งแรกที่เส้นทางนี้ใช้งาน การระบุผู้พูดเป็นแบบพยายามอย่างดีที่สุด หากทำงานไม่ได้ Vox.md จะเก็บข้อความถอดเสียงปกติไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model, bu rotanın kayıtları için Ayarlar › Modeller'i geçersiz kılar. Konuşmacıları Tanımla, birden çok sesi tamamen aygıtta algılar ve etiketler. Konuşmacı modeli, bu rota onu ilk kez kullandığında indirilir. Konuşmacı tanımlama en iyi çaba esasına dayanır; çalışamazsa Vox.md normal transkripti korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця модель замінює Параметри › Моделі для записів цього маршруту. «Визначати мовців» розпізнає й позначає кілька голосів повністю на пристрої. Модель мовців завантажується під час першого використання цим маршрутом. Визначення мовців працює за можливості; якщо воно не спрацює, Vox.md збереже звичайний транскрипт."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ماڈل اس روٹ کی ریکارڈنگز کے لیے سیٹنگز › ماڈلز کو اوور رائیڈ کرتا ہے۔ اسپیکرز کی شناخت کریں متعدد آوازوں کا پتہ لگا کر مکمل طور پر آلے پر لیبل لگاتا ہے۔ اسپیکر ماڈل پہلی بار اس روٹ کے استعمال پر ڈاؤن لوڈ ہوتا ہے۔ اسپیکر کی شناخت بہترین کوشش پر مبنی ہے؛ اگر یہ نہ چل سکے تو Vox.md معمول کا ٹرانسکرپٹ رکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình này ghi đè Cài đặt › Mô hình cho các bản ghi âm của lộ trình này. Nhận diện người nói phát hiện và gắn nhãn nhiều giọng nói hoàn toàn trên thiết bị. Mô hình người nói được tải về ở lần đầu lộ trình này sử dụng. Nhận diện người nói không phải lúc nào cũng chính xác; nếu không chạy được, Vox.md giữ bản chép lời thông thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于此路线的录音，该模型会覆盖“设置” › “模型”中的设置。“识别发言人”会完全在设备上检测并标记多个声音。发言人模型会在此路线首次使用时下载。发言人识别会尽力而为；如果无法运行，Vox.md 会保留常规转录文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於此路線的錄音，該模型會覆寫「設定」›「模型」中的設定。「辨識說話者」會完全在裝置上偵測並標示多個聲音。說話者模型會在此路線首次使用時下載。說話者辨識會盡力而為；如果無法執行，Vox.md 會保留一般逐字稿。"
          }
        }
      }
    },
    "The model server returned an invalid response.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد خادم النماذج استجابة غير صالحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেল সার্ভার একটি অবৈধ প্রতিক্রিয়া দিয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modellserver hat eine ungültige Antwort zurückgegeben."
          }
        },
        "en": {
          "stringUnit": {
