    "Waiting for iPhone. Until confirmed, recordings keep using the selected preset above.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار iPhone. حتى يتم تأكيدها، لا تزال المسجلات تستخدم الإعدادات المحددة المختارة أعلاه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অপেক্ষা iPhone. নিশ্চিত হওয়ার পরে, উপরের নির্বাচন করেই রেকর্ডিং চালু করা হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf das iPhone. Bis zur Bestätigung verwenden Aufnahmen weiterhin das oben ausgewählte Preset."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for iPhone. Until confirmed, recordings keep using the selected preset above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando por iPhone. Hasta que se confirmó, Los registros siguen utilizando el preset seleccionado arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attendant iPhone. Jusqu’à confirmation Enregistrement en utilisant le préréglage sélectionné ci-dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंतजार करना iPhone. जब तक पुष्टि नहीं हुई, उपरोक्त सूची में चयनित प्रिंट का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu untuk iPhone. Sampai akhirnya dikonfirmasi, Anda dapat menggunakan preset yang dipilih di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attesa per iPhone. Fino a quando non si conferma, Le registrazioni continuano utilizzando il preset selezionato sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待つ iPhone. 確認されるまで、 録音は上記の選択したプレセットを使用して続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기다리는 iPhone. 확인할 때까지, 녹음은 위에서 선택한 프리셋을 사용하여 계속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten op iPhone. Totdat het bevestigd is, opnamen blijven gebruiken de geselecteerde voorinstelling hierboven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekając na iPhone. Dopóki nie zostanie potwierdzone, nagrywania za pomocą wybranego powyżej ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando por iPhone. Até que seja confirmado, As gravações continuam usando o preset selecionado acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ожидании iPhone. Пока не подтвердится, записей продолжают использовать выбранный выше предварительный набор."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காத்திருப்பதற்கான iPhone. உறுதிப்படுத்தும் வரை எழுத்துக்கள் மேல் தேர்வு செய்யப்பட்ட பதிவைப் பயன்படுத்தி"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรอ iPhone. จนกว่าจะได้รับการยืนยัน การบันทึกยังคงใช้การตั้งค่าล่วงหน้าที่เลือกไว้ข้างต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "beklemek için iPhone. doğrulanacak kadar, Yukarıda seçilen ön ayarları kullanarak kaydetmeye devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекаючи на iPhone. До того часу, поки не підтвердиться, Запис здійснюється за допомогою вибраного вище пристрою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظار کرنے کے لئے iPhone. جب تک کہ ثابت ہو جائے اس کے علاوہ، آپ کو منتخب کردہ پیشگی ترتیبات کا استعمال کرتے ہوئے جاری رکھیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "chờ đợi iPhone. Cho đến khi xác nhận, Các bản ghi tiếp tục sử dụng các thiết lập trước đã chọn ở trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 iPhone. 直到确认, 记录使用上方选择的预设。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 iPhone. 直到確認, 記錄使用上方選擇的預設。"
          }
        }
      }
    },
