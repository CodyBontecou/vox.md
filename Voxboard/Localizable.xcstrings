          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mô hình địa phương được tối ưu hóa tùy chọn mà bạn có thể tải xuống và chọn rõ ràng."
          }
        },
        "zh-Hans": {
