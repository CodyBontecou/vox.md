          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В стоимость покупки входит неограниченный доступ и семейное общение Apple."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வாழ்க்கைப் பணிக்கு Unlimited Access மற்றும் Apple Family Sharing உள்ளடக்கியது."
          }
