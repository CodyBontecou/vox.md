        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт был сохранен, но запрошенный аудио не мог быть экспортирован."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவைப் படித்தால், இடுகைகள் வெளியிடப்படவில்லை.இந்த பதிவை மீண்டும் பதிவிறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกถูกบันทึก แต่ไม่สามารถส่งออกเสียงที่ต้องการ การบันทึกถูกเก็บไว้เพื่อการกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript kaydedildi, ancak talep edilen ses çıkarılamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт був збережений, але запис не можна було експортувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسپیٹ محفوظ کیا گیا تھا، لیکن درخواست کردہ آڈیو کو برآمد نہیں کیا جا سکتا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao được lưu, nhưng âm thanh yêu cầu không thể được xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录被保存,但无法导出所要求的音频,记录被保存以恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉錄被保存,但無法導出所要求的音頻,記錄被保存以恢復。"
          }
        }
      }
    },
    "The transcription service did not provide a reason.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقدم خدمة الترجمة سببًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সপ্লোরেশন পরিষেবা একটি কারণ সরবরাহ করেনি।"
