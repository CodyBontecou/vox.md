    "Choose a Capture Preset for this recovered recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديد إمكانية الوصول إلى هذه الصورة المباشرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পুনরুদ্ধার রেকর্ডের জন্য একটি ক্যাপচার প্রাসঙ্গিক নির্বাচন করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Aufnahme-Preset für diese wiederhergestellte Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a Capture Preset for this recovered recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione un Predefinición de captura para este registro recuperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un préréglage de capture pour cet enregistrement récupéré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकॉर्ड के लिए एक कैप्चर पूर्वानुमान चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih preset capture untuk rekaman yang dipulihkan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionare un Pre-set di cattura per questo record recuperato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この回収されたレコードのための Capture Preset を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복구된 녹음에 대한 캡처 미리 설정을 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een Capture Preet voor deze herstelde opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ustawienie Capture Preset dla tego odzyskanego nagrania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um Predefinição de captura para esta gravação recuperada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите предварительный настройки для этой восстановленной записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவை எழுதி ஒரு பதிவிற்கு அனுப்பியிருக்கிறேன்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกการตั้งค่าล่วงหน้าการจับภาพสําหรับบันทึกที่กู้คืนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaydı geri yüklemek için bir Capture Preset seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть попереднє налаштування для цього відновленого запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
