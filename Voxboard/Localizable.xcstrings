          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md وہ فولڈر یاد نہیں رکھ سکا: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md không thể ghi nhớ thư mục đó: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 无法记住该文件夹：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 無法記住該資料夾：%@"
          }
        }
      }
    },
    "Vox.md did not keep a copy of this entry. Open the note to see what was written.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يحتفظ Vox.md بنسخة من هذا الإدخال. افتح الملاحظة لرؤية ما كُتب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md এই এন্ট্রির কোনো কপি রাখেনি। কী লেখা হয়েছে দেখতে নোটটি খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md hat keine Kopie dieses Eintrags aufbewahrt. Öffnen Sie die Notiz, um zu sehen, was geschrieben wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md did not keep a copy of this entry. Open the note to see what was written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md no guardó una copia de esta entrada. Abre la nota para ver lo que se escribió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md n’a pas conservé de copie de cette entrée. Ouvrez la note pour voir ce qui a été écrit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ने इस एंट्री की कॉपी नहीं रखी। क्या लिखा गया, यह देखने के लिए नोट खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md tidak menyimpan salinan entri ini. Buka catatan untuk melihat apa yang ditulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md non ha conservato una copia di questa voce. Apri la nota per vedere cosa è stato scritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.mdはこのエントリのコピーを保持していません。メモを開いて書き込まれた内容を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md가 이 항목의 사본을 보관하지 않았습니다. 기록된 내용을 보려면 메모를 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md heeft geen kopie van dit item bewaard. Open de notitie om te zien wat er is geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md nie zachował kopii tego wpisu. Otwórz notatkę, aby zobaczyć, co zostało zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vox.md não manteve uma cópia desta entrada. Abra a nota para ver o que foi escrito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md не сохранил копию этой записи. Откройте заметку, чтобы увидеть, что было записано."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md இந்தப் பதிவின் நகலை வைத்திருக்கவில்லை. என்ன எழுதப்பட்டது என்பதைக் காண குறிப்பைத் திறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ไม่ได้เก็บสำเนาของรายการนี้ไว้ เปิดโน้ตเพื่อดูสิ่งที่เขียนไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md bu girdinin bir kopyasını tutmadı. Neyin yazıldığını görmek için notu açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md не зберіг копію цього запису. Відкрийте нотатку, щоб побачити, що було записано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md نے اس اندراج کی کاپی نہیں رکھی۔ کیا لکھا گیا دیکھنے کے لیے نوٹ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md không lưu bản sao của mục nhập này. Mở ghi chú để xem nội dung đã ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 未保留此条目的副本。打开笔记以查看写入的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 未保留此項目的副本。打開筆記以檢視寫入的內容。"
          }
        }
      }
    },
