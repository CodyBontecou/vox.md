    "Deferred transcripts wait here so they never overwrite your clipboard later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتظر النصوص المكتوبة المؤجلة هنا حتى لا تستبدل محتوى الحافظة لاحقًا أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থগিত ট্রান্সক্রিপ্ট এখানে অপেক্ষা করে, যাতে পরে কখনও আপনার ক্লিপবোর্ড ওভাররাইট না হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgestellte Transkripte warten hier, damit sie Ihre Zwischenablage nie später überschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deferred transcripts wait here so they never overwrite your clipboard later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transcripciones aplazadas esperan aquí para no sobrescribir nunca tu portapapeles más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transcriptions différées attendent ici pour ne jamais écraser votre presse-papiers plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थगित ट्रांसक्रिप्ट यहाँ प्रतीक्षा करती हैं, ताकि वे बाद में कभी आपके क्लिपबोर्ड को ओवरराइट न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrip yang ditunda menunggu di sini sehingga tidak pernah menimpa papan klip Anda nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trascrizioni rinviate attendono qui, così non sovrascrivono mai gli Appunti in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で処理された文字起こしはここで待機するので、あとからクリップボードが上書きされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지연된 전사본은 여기에서 대기하므로 나중에 클립보드를 덮어쓰지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgestelde transcripten wachten hier, zodat ze je klembord later nooit overschrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odroczone transkrypcje czekają tutaj, aby nigdy później nie nadpisać schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrições adiadas aguardam aqui para nunca sobrescrever sua área de transferência depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложенные транскрипты ждут здесь, чтобы никогда не перезаписать буфер обмена позже."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒத்திவைக்கப்பட்ட உரைப்படிகள் பின்னர் உங்கள் கிளிப்போர்டை மேலெழுதாமல் இருக்க இங்கே காத்திருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความถอดเสียงที่เลื่อนไว้จะรออยู่ที่นี่เพื่อไม่ให้เขียนทับคลิปบอร์ดของคุณในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ertelenen transkriptler burada bekler; böylece panonuzun üzerine daha sonra asla yazmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкладені транскрипти чекають тут, щоб ніколи не перезаписати буфер обміну пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مؤخر ٹرانسکرپٹس یہاں انتظار کرتے ہیں تاکہ بعد میں کبھی آپ کا کلپ بورڈ اوور رائٹ نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản chép lời hoãn lại chờ ở đây để không bao giờ ghi đè bảng nhớ tạm của bạn sau này."
