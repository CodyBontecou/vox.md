    "Choose a Route for this recovered recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مسارًا لهذا التسجيل المستعاد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরুদ্ধার করা এই রেকর্ডিংয়ের জন্য একটি রুট বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Route für diese wiederhergestellte Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a Route for this recovered recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una ruta para esta grabación recuperada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un parcours pour cet enregistrement récupéré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिकवर की गई रिकॉर्डिंग के लिए रूट चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Rute untuk rekaman yang dipulihkan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un percorso per questa registrazione recuperata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この復元された録音のルートを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복구된 녹음에 사용할 루트를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een route voor deze herstelde opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz trasę dla tego odzyskanego nagrania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma rota para esta gravação recuperada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите маршрут для этой восстановленной записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்கப்பட்ட இந்தப் பதிவுக்கு ஒரு வழித்தடத்தைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเส้นทางสำหรับการบันทึกที่กู้คืนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarılan bu kayıt için bir Rota seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть маршрут для цього відновленого запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس بازیافت شدہ ریکارڈنگ کے لیے روٹ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một lộ trình cho bản ghi âm đã khôi phục này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为这段恢复的录音选择一条路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為這段復原的錄音選擇一條路線。"
          }
        }
      }
    },
    "Choose a Route on iPhone, then retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مسارًا على iPhone، ثم أعد المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
