    "Lifetime access — upgrade once to share with your family.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول الدائم - تحديث مرة واحدة لتشارك مع عائلتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইফটাইম অ্যাক্সেস – একবার আপগ্রেড করুন যাতে আপনি আপনার পরিবারের সাথে শেয়ার করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebenslanger Zugriff – einmal upgraden, um mit Ihrer Familie zu teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime access — upgrade once to share with your family."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso a toda la vida: actualiza una vez para compartirlo con tu familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès à vie – mise à niveau une fois pour le partager avec votre famille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जीवनकाल तक पहुंच – अपने परिवार के साथ साझा करने के लिए एक बार अपग्रेड करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses seumur hidup – upgrade sekali untuk dibagikan dengan keluarga Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso permanente: aggiornare una volta per condividere con la famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生涯のアクセス - 家族と共有するために一度アップグレードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생 액세스 - 한 번 업그레이드하여 가족과 공유합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Levenslange toegang – upgrade eenmaal om te delen met uw familie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do życia — raz uaktualnij, aby udostępnić go rodzinie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso ao vivo – atualize uma vez para compartilhar com sua família."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ пожизненный — обновление один раз, чтобы поделиться с семьей."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime access - ஒரு முறை உங்கள் குடும்பத்தினருடன் பகிர்ந்து கொள்ள."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงตลอดชีวิต – อัปเดตครั้งเดียวเพื่อแบ่งปันกับครอบครัวของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayat boyu erişim - ailenizle paylaşmak için bir kez yükseltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до життя — оновлення один раз, щоб поділитися з родиною."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زندگی بھر تک رسائی - آپ کے خاندان کے ساتھ اشتراک کرنے کے لئے ایک بار اپ گریڈ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truy cập suốt đời – nâng cấp một lần để chia sẻ với gia đình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终身访问 — 升级一次,与家人共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終身訪問 — 升級一次,與家人共享。"
          }
        }
      }
    },
