    "Apple Speech available; system asset may need preparation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech متاح؛ قد يحتاج المكونات النظامية إلى إعداد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech উপলব্ধ সিস্টেম সম্পদ প্রস্তুতি প্রয়োজন হতে পারে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech verfügbar; Systemasset muss eventuell vorbereitet werden"
