    "No frontmatter collection or inline location fields will be written. The {location} template token still works.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No frontmatter collection or inline location fields will be written. The {location} template token still works."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتم كتابة مجموعة frontmatter أو حقول موقع مضمنة. سيظل رمز القالب {location} يعمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো frontmatter সংগ্রহ বা ইনলাইন অবস্থান ফিল্ড লেখা হবে না। {location} টেমপ্লেট টোকেনটি তবুও কাজ করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden weder eine Frontmatter-Sammlung noch Inline-Standortfelder geschrieben. Das Vorlagen-Token {location} funktioniert weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se escribirá ninguna colección de frontmatter ni campos de ubicación en línea. El token de plantilla {location} seguirá funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune collection frontmatter ni aucun champ de localisation intégré ne sera écrit. Le jeton de modèle {location} fonctionne toujours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई frontmatter संग्रह या इनलाइन स्थान फ़ील्ड नहीं लिखी जाएगी। {location} टेम्प्लेट टोकन फिर भी काम करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksi frontmatter atau bidang lokasi sebaris tidak akan ditulis. Token templat {location} tetap berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non verranno scritti né una raccolta frontmatter né campi di posizione in linea. Il token del modello {location} continuerà a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "frontmatter コレクションやインラインの位置情報フィールドは書き込まれません。{location} テンプレートトークンは引き続き機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "frontmatter 컬렉션 또는 인라인 위치 필드를 작성하지 않습니다. {location} 템플릿 토큰은 계속 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er worden geen frontmatterverzameling of inline locatievelden geschreven. Het sjabloontoken {location} blijft werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zostanie zapisana żadna kolekcja frontmatter ani wbudowane pola lokalizacji. Token szablonu {location} nadal działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma coleção de frontmatter nem campos de localização embutidos serão gravados. O token de modelo {location} continuará funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коллекция frontmatter и встроенные поля местоположения записываться не будут. Токен шаблона {location} продолжит работать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "frontmatter தொகுப்போ இன்லைன் இருப்பிடப் புலங்களோ எழுதப்படாது. {location} டெம்ப்ளேட் டோக்கன் தொடர்ந்து செயல்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะไม่มีการเขียนคอลเลกชัน frontmatter หรือฟิลด์ตำแหน่งแบบอินไลน์ โทเค็นเทมเพลต {location} ยังคงใช้งานได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir frontmatter koleksiyonu veya satır içi konum alanı yazılmayacak. {location} şablon belirteci çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Колекція frontmatter та вбудовані поля місцезнаходження не записуватимуться. Токен шаблону {location} і далі працюватиме."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی frontmatter مجموعہ یا اِن لائن مقام کی فیلڈز نہیں لکھی جائیں گی۔ {location} ٹیمپلیٹ ٹوکن پھر بھی کام کرے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ không ghi bộ sưu tập frontmatter hoặc trường vị trí nội tuyến. Token mẫu {location} vẫn hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会写入 frontmatter 集合或内联位置字段。{location} 模板令牌仍然有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會寫入 frontmatter 集合或行內位置欄位。{location} 範本代碼仍然有效。"
          }
        }
      }
    },
