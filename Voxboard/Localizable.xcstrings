    "Camera access is required to take a photo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج إلى الوصول إلى الكاميرا لتسجيل الصورة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি তোলার জন্য ক্যামেরার অ্যাক্সেস প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Aufnahme eines Fotos ist der Kamerazugriff erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is required to take a photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere acceso a la cámara para tomar una foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la caméra est nécessaire pour prendre une photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक तस्वीर लेने के लिए कैमरा का उपयोग करना आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kamera diperlukan untuk mengambil foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è necessario per scattare una foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラのアクセスは写真を撮るために必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접속은 사진을 찍기 위해서 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera toegang is vereist om een foto te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do zrobienia zdjęcia potrzebny jest dostęp do kamery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera é necessário para tirar uma foto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для того чтобы сделать фотосъемку, необходим доступ к камере."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access தேவைப்படும் ஒரு photo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงกล้องต้องใช้เพื่อถ่ายภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf çekmek için kamera erişimi gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для того, щоб зробити фотографію, потрібен доступ до камери."
          }
        },
        "ur": {
