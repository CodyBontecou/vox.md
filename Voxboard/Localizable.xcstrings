    "Keep the new recording attached when adding it to the current draft. With Audio off, the transcript is still added when available.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ التسجيل الجديد مرفقًا عند إضافته إلى المسودة الحالية. عند إيقاف «الصوت»، يُضاف النص المكتوب عند توفره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমান খসড়ায় যোগ করার সময় নতুন রেকর্ডিংটি সংযুক্ত রাখুন। অডিও বন্ধ থাকলেও, উপলব্ধ হলে ট্রান্সক্রিপ্ট যোগ করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Aufnahme bleibt angehängt, wenn sie zum aktuellen Entwurf hinzugefügt wird. Bei deaktiviertem Audio wird das Transkript trotzdem hinzugefügt, sofern verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the new recording attached when adding it to the current draft. With Audio off, the transcript is still added when available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene adjunta la nueva grabación al añadirla al borrador actual. Con Audio desactivado, la transcripción se sigue añadiendo cuando está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez le nouvel enregistrement en pièce jointe lorsque vous l’ajoutez au brouillon actuel. Avec Audio désactivé, la transcription est quand même ajoutée si elle est disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा ड्राफ़्ट में जोड़ते समय नई रिकॉर्डिंग अटैच रखें। ऑडियो बंद होने पर भी, उपलब्ध होने पर ट्रांसक्रिप्ट जोड़ी जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan rekaman baru tetap terlampir saat menambahkannya ke draf saat ini. Dengan Audio nonaktif, transkrip tetap ditambahkan jika tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni allegata la nuova registrazione quando la aggiungi alla bozza attuale. Con Audio disattivato, la trascrizione viene comunque aggiunta se disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の下書きに追加するときに、新しい録音を添付したままにします。「オーディオ」がオフでも、利用可能な場合は文字起こしが追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 초안에 추가할 때 새 녹음을 첨부한 상태로 유지합니다. 오디오를 꺼도 전사본은 사용 가능한 경우 추가됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de nieuwe opname als bijlage wanneer je die aan het huidige concept toevoegt. Als Audio uit staat, wordt het transcript toch toegevoegd indien beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj nowe nagranie jako załącznik podczas dodawania go do bieżącej wersji roboczej. Gdy Audio jest wyłączone, transkrypcja i tak zostanie dodana, jeśli jest dostępna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a nova gravação anexada ao adicioná-la ao rascunho atual. Com Áudio desativado, a transcrição ainda é adicionada quando disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставлять новую запись прикрепленной при добавлении в текущий черновик. Если аудио выключено, транскрипт все равно добавляется, когда доступен."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்போதைய வரைவில் சேர்க்கும்போது புதிய பதிவை இணைத்தே வைக்கவும். ஒலி முடக்கப்பட்டிருந்தாலும், உரைப்படி கிடைக்கும்போது சேர்க்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนบการบันทึกใหม่ไว้เมื่อเพิ่มลงในฉบับร่างปัจจุบัน เมื่อปิดเสียง ข้อความถอดเสียงจะยังคงถูกเพิ่มเมื่อพร้อมใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli taslağa eklerken yeni kaydı ekli tutun. Ses kapalıyken, kullanılabilir olduğunda transkript yine de eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишати новий запис прикріпленим під час додавання до поточної чернетки. Якщо аудіо вимкнено, транскрипт однаково додається, коли доступний."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ ڈرافٹ میں شامل کرتے وقت نئی ریکارڈنگ منسلک رکھیں۔ آڈیو بند ہونے پر بھی دستیاب ہونے کی صورت میں ٹرانسکرپٹ شامل کیا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ bản ghi âm mới làm tệp đính kèm khi thêm vào bản nháp hiện tại. Khi tắt Âm thanh, bản chép lời vẫn được thêm nếu có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将新录音添加到当前草稿时保留其附件。关闭“音频”后，如有转录文本仍会添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將新錄音加入目前草稿時保留其附件。關閉「音訊」後，如有逐字稿仍會加入。"
          }
        }
      }
    },
