    "No camera is available. Connect a camera or enable Continuity Camera.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد أي كاميرا متوفرة.إذا قمت بتحميل الكاميرا أو تثبيت الكاميرات المستمرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরাটি ব্যবহার করা যাবে না. ক্যামেরার সাথে সংযোগ করুন অথবা ক্যামারটিতে অব্যাহত থাকার সুযোগটি সক্ষম করুন।"
