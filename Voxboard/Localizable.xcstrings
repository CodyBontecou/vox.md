    "Scans and journal pages are read on device and saved as Markdown, with the original image alongside.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ المستندات الممسوحة وصفحات اليوميات على الجهاز وتُحفظ بتنسيق Markdown، مع الصورة الأصلية بجانبها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান ও জার্নালের পাতা ডিভাইসেই পড়া হয় এবং মূল ছবিসহ Markdown হিসেবে সেভ হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans und Tagebuchseiten werden auf dem Gerät gelesen und als Markdown gesichert, mit dem Originalbild daneben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans and journal pages are read on device and saved as Markdown, with the original image alongside."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los escaneos y las páginas del diario se leen en el dispositivo y se guardan como Markdown, junto con la imagen original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les numérisations et pages de journal sont lues sur l’appareil et enregistrées en Markdown, avec l’image d’origine à côté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन और जर्नल पेज डिवाइस पर पढ़े जाते हैं और मूल इमेज के साथ Markdown के रूप में सहेजे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindaian dan halaman jurnal dibaca di perangkat dan disimpan sebagai Markdown, dengan gambar asli di sampingnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scansioni e le pagine di diario vengono lette sul dispositivo e salvate in Markdown, con l’immagine originale accanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンやジャーナルのページはデバイス上で読み取られ、元の画像と一緒にMarkdownとして保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔과 저널 페이지는 기기에서 읽혀 원본 이미지와 함께 Markdown으로 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans en dagboekpagina's worden op het apparaat gelezen en als Markdown bewaard, met de originele afbeelding ernaast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skany i strony dziennika są odczytywane na urządzeniu i zapisywane jako Markdown wraz z oryginalnym obrazem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalizações e páginas de diário são lidas no dispositivo e salvas como Markdown, com a imagem original ao lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканы и страницы дневника распознаются на устройстве и сохраняются в Markdown вместе с исходным изображением."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன்களும் நாட்குறிப்புப் பக்கங்களும் சாதனத்திலேயே படிக்கப்பட்டு, அசல் படத்துடன் Markdown ஆகச் சேமிக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนและหน้าบันทึกประจำวันจะถูกอ่านบนอุปกรณ์และบันทึกเป็น Markdown พร้อมภาพต้นฉบับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taramalar ve günlük sayfaları aygıtta okunur ve özgün görüntüyle birlikte Markdown olarak kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скани та сторінки щоденника розпізнаються на пристрої й зберігаються в Markdown разом з оригінальним зображенням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکینز اور جرنل کے صفحات آلے پر پڑھے جاتے ہیں اور Markdown کے طور پر محفوظ کیے جاتے ہیں، اصل تصویر کے ساتھ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản quét và trang nhật ký được đọc trên thiết bị và lưu dưới dạng Markdown, kèm theo hình ảnh gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描件和日记页面会在设备上识别，并以 Markdown 保存，同时附上原始图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描檔和日記頁面會在裝置上辨識，並以 Markdown 儲存，同時附上原始影像。"
          }
        }
      }
    },
