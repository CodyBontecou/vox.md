    "Start a recording that is delivered to the chosen Route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ تسجيلًا يُسلَّم إلى المسار المختار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এমন একটি রেকর্ডিং শুরু করুন যা বেছে নেওয়া রুটে ডেলিভার হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte eine Aufnahme, die an die gewählte Route zugestellt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a recording that is delivered to the chosen Route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una grabación que se entrega en la ruta elegida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez un enregistrement livré vers la route choisie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसी रिकॉर्डिंग शुरू करें जो चुने रूट पर डिलीवर हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai rekaman yang dikirim ke Rute yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una registrazione consegnata al percorso scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだルートに配信される録音を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 경로로 전달되는 녹음을 시작합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start een opname die naar de gekozen route gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij nagranie dostarczane do wybranej trasy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma gravação entregue na rota escolhida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните запись, которая будет доставлена в выбранный маршрут."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்த வழிக்கு டெலிவர் ஆகும் பதிவைத் தொடங்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มการบันทึกที่จะส่งไปยังเส้นทางที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen rotaya teslim edilecek bir kayıt başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть запис, який буде доставлено у вибраний маршрут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایسی ریکارڈنگ شروع کریں جو منتخب روٹ پر ڈیلیور ہو۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu bản ghi được gửi đến Tuyến đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始一段将送达所选路线的录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始一段將送達所選路線的錄音。"
          }
        }
      }
    },
    "Start and Stop leave an already-started or already-stopped recording unchanged. Start or Stop switches the current recording state.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغيّر «بدء» و«إيقاف» تسجيلًا بدأ أو توقف بالفعل. يبدّل «بدء أو إيقاف» حالة التسجيل الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "'শুরু' ও 'বন্ধ' আগে থেকে চালু বা বন্ধ রেকর্ডিং অপরিবর্তিত রাখে। 'শুরু বা বন্ধ' বর্তমান রেকর্ডিং অবস্থা বদলায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start und Stopp lassen eine bereits gestartete oder gestoppte Aufnahme unverändert. Start oder Stopp wechselt den aktuellen Aufnahmestatus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start and Stop leave an already-started or already-stopped recording unchanged. Start or Stop switches the current recording state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar y Detener no cambian una grabación ya iniciada o detenida. Iniciar o detener alterna el estado actual de la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer et Arrêter laissent inchangé un enregistrement déjà lancé ou arrêté. Démarrer ou arrêter bascule l’état actuel de l’enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू और रोकें पहले से चल रही या रुकी रिकॉर्डिंग को नहीं बदलते। शुरू या रोकें वर्तमान रिकॉर्डिंग स्थिति बदलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dan Berhenti tidak mengubah rekaman yang sudah dimulai atau dihentikan. Mulai atau Berhenti mengganti status rekaman saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia e Interrompi lasciano invariata una registrazione già avviata o interrotta. Avvia o interrompi alterna lo stato attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「開始」と「停止」は、すでに開始または停止している録音を変更しません。「開始/停止」は現在の録音状態を切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작과 중지는 이미 시작되었거나 중지된 녹음을 바꾸지 않습니다. 시작/중지는 현재 녹음 상태를 전환합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start en Stop laten een al gestarte of gestopte opname ongewijzigd. Start of stop wisselt de huidige opnamestatus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start i Stop nie zmieniają już rozpoczętego lub zatrzymanego nagrania. Start/Stop przełącza bieżący stan nagrywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar e Parar não alteram uma gravação já iniciada ou parada. Iniciar ou parar alterna o estado atual da gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Старт» и «Стоп» не меняют уже начатую или остановленную запись. «Старт или стоп» переключает текущее состояние записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடங்கு, நிறுத்து ஏற்கனவே தொடங்கிய அல்லது நின்ற பதிவை மாற்றாது. தொடங்கு/நிறுத்து தற்போதைய பதிவு நிலையை மாற்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่ม และ หยุด จะไม่เปลี่ยนการบันทึกที่เริ่มหรือหยุดอยู่แล้ว เริ่มหรือหยุด จะสลับสถานะการบันทึกปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlat ve Durdur, zaten başlamış veya durmuş bir kaydı değiştirmez. Başlat veya Durdur mevcut kayıt durumunu değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Старт» і «Стоп» не змінюють уже розпочатий чи зупинений запис. «Старт або стоп» перемикає поточний стан запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شروع اور روکیں پہلے سے شروع یا رکی ریکارڈنگ کو نہیں بدلتے۔ شروع یا روکیں موجودہ ریکارڈنگ کی حالت بدلتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu và Dừng giữ nguyên bản ghi đã bắt đầu hoặc đã dừng. Bắt đầu hay Dừng sẽ chuyển trạng thái ghi hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“开始”和“停止”不会改变已开始或已停止的录音。“开始或停止”会切换当前录音状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「開始」和「停止」不會改變已開始或已停止的錄音。「開始或停止」會切換目前的錄音狀態。"
          }
        }
      }
    },
    "Start or Stop": {
      "localizations": {
