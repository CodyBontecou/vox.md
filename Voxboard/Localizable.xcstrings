            "state": "translated",
            "value": "कैप्चर डिलीवरी सक्रिय है. फेंकने से पहले एक पल इंतजार करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiriman capture aktif. tunggu beberapa saat sebelum membuang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La consegna di capture è attiva. Attendere un attimo prima di scartare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ配信が有効です. 捨てる前に少し待つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 배달이 활성화되어 있습니다.배포하기 전에 잠시 기다려주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
