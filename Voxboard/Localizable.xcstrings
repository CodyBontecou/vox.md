    "Install Vox.md on your iPhone, pick a vault and routes, then they appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت Vox.md على iPhone واختر خزنة ومسارات، وستظهر هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone-এ Vox.md ইনস্টল করুন, একটি ভল্ট ও রুট বেছে নিন, তারপর সেগুলো এখানে দেখাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Vox.md auf deinem iPhone, wähle einen Vault und Routen – dann erscheinen sie hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Vox.md on your iPhone, pick a vault and routes, then they appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Vox.md en tu iPhone, elige un vault y rutas, y aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Vox.md sur votre iPhone, choisissez un coffre et des routes : ils apparaîtront ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone पर Vox.md इंस्टॉल करें, वॉल्ट और रूट चुनें, फिर वे यहाँ दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang Vox.md di iPhone, pilih vault dan rute, lalu semuanya muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Vox.md sull’iPhone, scegli un vault e i percorsi: appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone に Vox.md をインストールし、保管庫とルートを選ぶとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에 Vox.md를 설치하고 보관소와 경로를 선택하면 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer Vox.md op je iPhone, kies een kluis en routes, dan verschijnen ze hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj Vox.md na iPhone, wybierz sejf i trasy — pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Vox.md no iPhone, escolha um cofre e rotas, e eles aparecerão aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите Vox.md на iPhone, выберите хранилище и маршруты — они появятся здесь."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iPhone-இல் Vox.md-ஐ நிறுவி, ஒரு வால்ட் மற்றும் வழிகளைத் தேர்வுசெய்தால் அவை இங்கே தோன்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้ง Vox.md บน iPhone เลือกคลังและเส้นทาง แล้วจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’unuza Vox.md’yi yükleyin, bir kasa ve rotalar seçin; burada görünürler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Установіть Vox.md на iPhone, виберіть сховище й маршрути — вони з’являться тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے iPhone پر Vox.md انسٹال کریں، والٹ اور روٹس منتخب کریں، پھر وہ یہاں نظر آئیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài Vox.md trên iPhone, chọn kho và tuyến, rồi chúng sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上安装 Vox.md，选择资料库和路线后，它们会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上安裝 Vox.md，選擇資料庫和路線後，它們會顯示在這裡。"
          }
        }
      }
    },
    "It’ll deliver when iPhone reconnects.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُسلَّم عند إعادة اتصال iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone আবার সংযুক্ত হলে এটি ডেলিভার হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird zugestellt, sobald das iPhone wieder verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’ll deliver when iPhone reconnects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se entregará cuando el iPhone vuelva a conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera livré quand l’iPhone se reconnectera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone फिर से जुड़ने पर यह डिलीवर होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akan dikirim saat iPhone tersambung lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà consegnato quando l’iPhone si riconnette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone が再接続されると配信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 다시 연결되면 전달됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt afgeleverd zodra iPhone weer verbinding heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie dostarczone po ponownym połączeniu iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Será entregue quando o iPhone se reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет доставлено, когда iPhone снова подключится."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone மீண்டும் இணைந்ததும் டெலிவர் ஆகும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะส่งเมื่อ iPhone เชื่อมต่ออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone yeniden bağlandığında teslim edilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде доставлено, коли iPhone знову під’єднається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone دوبارہ جڑنے پر یہ ڈیلیور ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ được gửi khi iPhone kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 重新连接后会送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 重新連線後會送達。"
          }
        }
      }
    },
    "Keep audio as a draft attachment when Delivery is Add to Draft.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالصوت كمرفق مسودة عندما يكون التسليم «إضافة إلى المسودة»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেলিভারি 'ড্রাফটে যোগ করুন' হলে অডিওকে ড্রাফট সংযুক্তি হিসেবে রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio als Entwurfsanhang behalten, wenn die Zustellung „Zum Entwurf hinzufügen“ ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep audio as a draft attachment when Delivery is Add to Draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva el audio como adjunto del borrador cuando la entrega es «Añadir al borrador»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver l’audio en pièce jointe du brouillon quand la livraison est « Ajouter au brouillon »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिलीवरी 'ड्राफ़्ट में जोड़ें' होने पर ऑडियो को ड्राफ़्ट अटैचमेंट के रूप में रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan audio sebagai lampiran draf saat Pengiriman adalah Tambah ke Draf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni l’audio come allegato della bozza quando la consegna è «Aggiungi alla bozza»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信が「下書きに追加」のとき、オーディオを下書きの添付として残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전달이 '초안에 추가'일 때 오디오를 초안 첨부 파일로 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar audio als conceptbijlage wanneer Aflevering op Toevoegen aan concept staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj dźwięk jako załącznik szkicu, gdy dostarczanie to „Dodaj do szkicu”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o áudio como anexo do rascunho quando a entrega for Adicionar ao rascunho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять аудио как вложение черновика, если доставка — «Добавить в черновик»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டெலிவரி 'வரைவில் சேர்' ஆக இருக்கும்போது ஆடியோவை வரைவு இணைப்பாக வைத்திருக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บเสียงเป็นไฟล์แนบของแบบร่างเมื่อการส่งเป็น เพิ่มในแบบร่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teslim “Taslağa ekle” olduğunda sesi taslak eki olarak tut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігати аудіо як вкладення чернетки, коли доставка — «Додати до чернетки»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب ڈیلیوری 'ڈرافٹ میں شامل کریں' ہو تو آڈیو کو ڈرافٹ اٹیچمنٹ کے طور پر رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ âm thanh làm tệp đính kèm nháp khi Gửi là Thêm vào nháp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当送达方式为“添加到草稿”时，将音频保留为草稿附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當送達方式為「加入草稿」時，將音訊保留為草稿附件。"
          }
        }
      }
    },
