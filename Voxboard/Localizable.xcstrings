    "Show Vox.md status and Record/Stop controls on the Lock Screen and Dynamic Island while listening.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض حالة Vox.md وأزرار التسجيل والإيقاف على شاشة القفل وDynamic Island أثناء الاستماع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শোনার সময় লক স্ক্রিন ও Dynamic Island-এ Vox.md-এর অবস্থা এবং রেকর্ড/থামান নিয়ন্ত্রণ দেখান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt beim Zuhören Vox.md-Status und Aufnahme/Stopp-Steuerung auf Sperrbildschirm und Dynamic Island."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Vox.md status and Record/Stop controls on the Lock Screen and Dynamic Island while listening."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el estado de Vox.md y los controles Grabar/Detener en la pantalla bloqueada y Dynamic Island mientras escucha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’état de Vox.md et les commandes Enregistrer/Arrêter sur l’écran verrouillé et Dynamic Island pendant l’écoute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुनते समय लॉक स्क्रीन और Dynamic Island पर Vox.md की स्थिति और रिकॉर्ड/रोकें कंट्रोल दिखाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan status Vox.md dan kontrol Rekam/Hentikan di Layar Terkunci dan Dynamic Island saat mendengarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra lo stato di Vox.md e i controlli Registra/Interrompi sulla schermata di blocco e Dynamic Island durante l’ascolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞き取り中、ロック画面とDynamic IslandにVox.mdの状態と録音／停止コントロールを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣는 동안 잠금 화면과 Dynamic Island에 Vox.md 상태 및 녹음/중지 제어를 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon tijdens het luisteren de Vox.md-status en knoppen voor Opnemen/Stoppen op vergrendelscherm en Dynamic Island."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas nasłuchiwania pokazuj stan Vox.md oraz przyciski Nagraj/Zatrzymaj na ekranie blokady i Dynamic Island."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibe o status do Vox.md e controles Gravar/Parar na tela bloqueada e Dynamic Island durante a escuta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать состояние Vox.md и кнопки записи/остановки на экране блокировки и Dynamic Island во время прослушивания."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேட்கும்போது பூட்டுத் திரை மற்றும் Dynamic Island-இல் Vox.md நிலை மற்றும் பதிவு/நிறுத்து கட்டுப்பாடுகளைக் காட்டு."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงสถานะ Vox.md และปุ่มบันทึก/หยุดบนหน้าจอล็อกและ Dynamic Island ขณะฟัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlerken kilit ekranı ve Dynamic Island’da Vox.md durumunu ve Kaydet/Durdur denetimlerini gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати стан Vox.md і кнопки запису/зупинки на екрані блокування та Dynamic Island під час прослуховування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سنتے وقت لاک اسکرین اور Dynamic Island پر Vox.md کی حالت اور ریکارڈ/روکنے کے کنٹرول دکھائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị trạng thái Vox.md và nút Ghi/Dừng trên màn hình khóa và Dynamic Island khi đang nghe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监听时在锁定屏幕和灵动岛显示 Vox.md 状态及录音/停止控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聆聽時在鎖定畫面與動態島顯示 Vox.md 狀態和錄音/停止控制。"
          }
        }
      }
    },
