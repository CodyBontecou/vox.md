    "Recording controls offer their own Action and Open App choices, so you can configure each control independently.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توفر عناصر التحكم في التسجيل خيارات «الإجراء» و«فتح التطبيق» الخاصة بها، لتتمكن من إعداد كل عنصر تحكم بشكل مستقل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং কন্ট্রোলগুলোতে নিজস্ব ‘অ্যাকশন’ ও ‘অ্যাপ খুলুন’ বিকল্প আছে, তাই আপনি প্রতিটি কন্ট্রোল আলাদাভাবে কনফিগার করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme-Steuerelemente bieten eigene Optionen für Aktion und „App öffnen“, sodass Sie jedes Steuerelement unabhängig konfigurieren können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording controls offer their own Action and Open App choices, so you can configure each control independently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los controles de grabación ofrecen sus propias opciones de Acción y Abrir app, así que puedes configurar cada control por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes d’enregistrement proposent leurs propres choix Action et Ouvrir l’app, pour configurer chaque commande indépendamment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग कंट्रोल अपने ऐक्शन और ऐप खोलें विकल्प देते हैं, ताकि आप हर कंट्रोल को अलग से कॉन्फ़िगर कर सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol perekaman menawarkan pilihan Tindakan dan Buka App sendiri, sehingga Anda dapat mengonfigurasi setiap kontrol secara terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I controlli di registrazione offrono le proprie opzioni Azione e Apri app, così puoi configurare ogni controllo in modo indipendente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音コントロールにはそれぞれ「アクション」と「アプリを開く」の選択肢があるので、コントロールごとに個別に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 제어 항목마다 고유한 ‘동작’ 및 ‘앱 열기’ 선택 사항이 있어 각각 독립적으로 구성할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnameregelaars hebben hun eigen keuzes voor actie en ‘Open app’, zodat je elke regelaar afzonderlijk kunt configureren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełączniki nagrywania mają własne opcje akcji i otwierania aplikacji, więc każdy możesz skonfigurować niezależnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os controles de gravação oferecem suas próprias opções de Ação e Abrir App, para você configurar cada controle de forma independente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У элементов управления записью есть свои параметры «Действие» и «Открыть приложение», поэтому каждый можно настроить отдельно."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவுக் கட்டுப்பாடுகள் தங்கள் சொந்த செயல் மற்றும் ஆப்பைத் திற தேர்வுகளை வழங்குகின்றன, எனவே ஒவ்வொரு கட்டுப்பாட்டையும் தனித்தனியாக உள்ளமைக்கலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวควบคุมการบันทึกมีตัวเลือกการทำงานและ “เปิดแอป” ของตัวเอง คุณจึงกำหนดค่าตัวควบคุมแต่ละตัวได้อย่างอิสระ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt denetimleri kendi Eylem ve Uygulamayı Aç seçeneklerini sunar; böylece her denetimi bağımsız olarak yapılandırabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елементи керування записом мають власні параметри «Дія» та «Відкрити застосунок», тож кожен можна налаштувати окремо."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ کنٹرولز اپنی کارروائی اور ایپ کھولیں کے انتخاب پیش کرتے ہیں، تاکہ آپ ہر کنٹرول کو آزادانہ طور پر ترتیب دے سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi điều khiển ghi âm có lựa chọn Tác vụ và Mở ứng dụng riêng, nên bạn có thể cấu hình từng điều khiển độc lập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音控制提供各自的“操作”和“打开 App”选项，你可以独立配置每个控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音控制項提供各自的「動作」和「打開 App」選項，你可以獨立設定每個控制項。"
          }
        }
      }
    },
