    "To correct credentials, cancel and edit them in Routes first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتصحيح بيانات الاعتماد، ألغِ وعدّلها في «المسارات» أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্রেডেনশিয়াল ঠিক করতে, বাতিল করে আগে রুটগুলোতে সেগুলো সম্পাদনা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Anmeldedaten zu korrigieren, brechen Sie ab und bearbeiten Sie sie zuerst unter „Routen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To correct credentials, cancel and edit them in Routes first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para corregir las credenciales, cancela y edítalas primero en Rutas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour corriger les identifiants, annulez et modifiez-les d’abord dans Parcours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रेडेंशियल्स ठीक करने के लिए, रद्द करें और पहले रूट्स में उन्हें संपादित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memperbaiki kredensial, batalkan dan edit terlebih dahulu di Rute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per correggere le credenziali, annulla e modificale prima in Percorsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報を修正するには、キャンセルして先に「ルート」で編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명을 수정하려면 취소하고 먼저 루트에서 편집하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om inloggegevens te corrigeren, annuleer je en wijzig je ze eerst in Routes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby poprawić dane uwierzytelniające, anuluj i najpierw edytuj je w Trasach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para corrigir as credenciais, cancele e edite-as primeiro em Rotas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы исправить учетные данные, отмените и сначала измените их в разделе «Маршруты»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சான்றுகளைத் திருத்த, ரத்துசெய்து முதலில் வழித்தடங்களில் அவற்றைத் திருத்தவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการแก้ไขข้อมูลประจำตัว ให้ยกเลิกแล้วแก้ไขในเส้นทางก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik bilgilerini düzeltmek için iptal edin ve önce Rotalar'da düzenleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб виправити облікові дані, скасуйте й спершу змініть їх у розділі «Маршрути»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسناد درست کرنے کے لیے پہلے منسوخ کریں اور روٹس میں ان میں ترمیم کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sửa thông tin xác thực, hãy hủy và sửa chúng trong Lộ trình trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需更正凭证，请先取消，然后在“路线”中编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需更正憑證，請先取消，然後在「路線」中編輯。"
          }
        }
      }
    },
