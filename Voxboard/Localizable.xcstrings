    "Audio and transcripts stay on your devices and in your vault. No custom analytics.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى الصوت والنصوص المكتوبة على أجهزتك وفي خزنتك. لا توجد تحليلات مخصصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও ও ট্রান্সক্রিপ্ট আপনার ডিভাইসে এবং আপনার ভল্টে থাকে। কোনো কাস্টম অ্যানালিটিক্স নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio und Transkripte bleiben auf Ihren Geräten und in Ihrem Tresor. Keine eigenen Analysen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio and transcripts stay on your devices and in your vault. No custom analytics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio y las transcripciones se quedan en tus dispositivos y en tu bóveda. Sin analíticas personalizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio et les transcriptions restent sur vos appareils et dans votre coffre. Aucune analyse personnalisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो और ट्रांसक्रिप्ट आपके डिवाइस और आपके वॉल्ट में रहते हैं। कोई कस्टम एनालिटिक्स नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio dan transkrip tetap di perangkat dan vault Anda. Tanpa analitik kustom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio e trascrizioni restano sui tuoi dispositivi e nel tuo vault. Nessuna analisi personalizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオと文字起こしはお使いのデバイスと保管庫に保存されます。独自の分析は行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오와 전사본은 사용자의 기기와 볼트에만 저장됩니다. 자체 분석을 수행하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio en transcripten blijven op je apparaten en in je kluis. Geen eigen analyses."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio i transkrypcje pozostają na Twoich urządzeniach i w sejfie. Bez własnej analityki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Áudio e transcrições ficam nos seus dispositivos e no seu cofre. Sem análises personalizadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио и транскрипты остаются на ваших устройствах и в хранилище. Никакой собственной аналитики."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலியும் உரைப்படிகளும் உங்கள் சாதனங்களிலும் களஞ்சியத்திலும் இருக்கும். தனிப்பயன் பகுப்பாய்வுகள் இல்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงและข้อความถอดเสียงจะอยู่บนอุปกรณ์และในวอลต์ของคุณ ไม่มีการวิเคราะห์แบบกำหนดเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses ve transkriptler aygıtlarınızda ve kasanızda kalır. Özel analiz yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо й транскрипти залишаються на ваших пристроях і у сховищі. Жодної власної аналітики."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آڈیو اور ٹرانسکرپٹس آپ کے آلات اور آپ کے والٹ میں رہتے ہیں۔ کوئی حسب ضرورت اینالیٹکس نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh và bản chép lời ở lại trên thiết bị và trong kho của bạn. Không có phân tích tùy chỉnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频和转录文本保留在你的设备和仓库中。没有自定义分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊和逐字稿保留在你的裝置和儲存庫中。沒有自訂分析。"
          }
        }
      }
    },
