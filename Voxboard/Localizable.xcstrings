    "No usable audio was captured. Try recording again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تسجيل أي صوت قابل للاستخدام.حاول تسجيلها مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনও অডিও ক্যাপচার করা হয়নি. আবার রেকর্ডিং চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein nutzbares Audio wurde aufgezeichnet. Versuchen Sie erneut aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usable audio was captured. Try recording again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se capturó audio útil. Inténtalo de nuevo."
          }
        },
        "fr": {
