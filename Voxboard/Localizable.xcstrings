    "%@ · %@ · %@ is missing. Saved safely on this iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ مفقود. محفوظ بأمان على هذا الـ iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ পাওয়া যাচ্ছে না। এই iPhone-এ নিরাপদে সেভ করা আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ fehlt. Sicher auf diesem iPhone gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ is missing. Saved safely on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · falta %@. Guardada de forma segura en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ est introuvable. Enregistrée en lieu sûr sur cet iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ मौजूद नहीं है। इस iPhone पर सुरक्षित रूप से सहेजा गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ tidak ada. Tersimpan dengan aman di iPhone ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ non trovato. Salvata al sicuro su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@が見つかりません。このiPhoneに安全に保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ 항목이 없습니다. 이 iPhone에 안전하게 저장되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ ontbreekt. Veilig bewaard op deze iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · brakuje: %@. Bezpiecznie zapisano na tym iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ está ausente. Salva com segurança neste iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ отсутствует. Надежно сохранено на этом iPhone."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ காணவில்லை. இந்த iPhone இல் பாதுகாப்பாகச் சேமிக்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · ไม่พบ %@ บันทึกไว้อย่างปลอดภัยบน iPhone เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ eksik. Bu iPhone'da güvenle kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ відсутній. Надійно збережено на цьому iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · %@ موجود نہیں۔ اس iPhone پر محفوظ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · thiếu %@. Đã lưu an toàn trên iPhone này."
