    "Speaker identification was skipped because its model could not be prepared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker identification was skipped because its model could not be prepared."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطي تحديد المتحدثين لأنه تعذّر تجهيز النموذج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেল প্রস্তুত করা যায়নি বলে স্পিকার শনাক্তকরণ বাদ দেওয়া হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprechererkennung wurde übersprungen, weil das Modell nicht vorbereitet werden konnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitió la identificación de hablantes porque no se pudo preparar el modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identification des orateurs a été ignorée parce que le modèle n'a pas pu être préparé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल तैयार नहीं किया जा सका, इसलिए स्पीकर पहचान छोड़ दी गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifikasi pembicara dilewati karena model tidak dapat disiapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identificazione degli oratori è stata ignorata perché non è stato possibile preparare il modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを準備できなかったため、話者識別はスキップされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 준비할 수 없어 화자 식별을 건너뛰었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprekerherkenning is overgeslagen omdat het model niet kon worden voorbereid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominięto identyfikację mówców, ponieważ nie można było przygotować modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identificação de falantes foi ignorada porque não foi possível preparar o modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание говорящих пропущено, поскольку не удалось подготовить модель."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாதிரியைத் தயார் செய்ய முடியாததால் பேச்சாளர் அடையாளம் தவிர்க்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้ามการระบุผู้พูดเนื่องจากเตรียมโมเดลไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model hazırlanamadığı için konuşmacı tanımlama atlandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовців пропущено, оскільки не вдалося підготувати модель."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماڈل تیار نہ ہو سکنے کی وجہ سے اسپیکر شناخت چھوڑ دی گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bỏ qua nhận dạng người nói vì không thể chuẩn bị mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因无法准备模型，已跳过说话人识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因無法準備模型，已略過說話者識別。"
          }
        }
      }
    },
