    "Tap Capture Page, then press the camera shutter when the page is ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على Capture Page ، ثم اضغط على قفل الكاميرا عندما يكون الصفحة مستعدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৃষ্ঠা ক্যাপচার টপ করুন, তারপর ক্যামেরা চাপুন যখন পৃথিবী প্রস্তুত।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf „Seite erfassen“ und drücken Sie dann den Kameraauslöser, wenn die Seite bereit ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Capture Page, then press the camera shutter when the page is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Capture Page y pulse el apagador de la cámara cuando la página esté lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Capture Page, puis appuyez sur l'obturateur de l'appareil photo lorsque la page est prête."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेज कैप्चर पर टैप करें, फिर कैमरा शूट को दबाएं जब पृष्ठ तैयार हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Capture Page, lalu tekan tombol kamera ketika halaman sudah siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccare Capture Page, quindi premere il chiusore della fotocamera quando la pagina è pronta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページをタップして、ページが準備完了したときにカメラのシャッターを押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 페이지를 탭한 다음 페이지가 준비되면 카메라 닫기를 누릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Page Capture en druk vervolgens op de camera-sluiter wanneer de pagina klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij pozycję Zdjęcia strony, a następnie naciśnij wyłącznik kamery, gdy strona jest gotowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Capture Page e pressione o apertador da câmera quando a página estiver pronta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Захватывать страницу», а затем нажмите выключатель камеры, когда страница готова."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Page, பின்னர் Page முடிந்ததும் Camera shutter ஐ அழுத்தவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิก Capture Page จากนั้นกดเครื่องปิดกล้องเมื่อหน้าเว็บพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfa Kapatma tuşuna basın ve sayfayı hazırladığınızda kamera kapanışını basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку Захоплення сторінки, а потім натисніть вимкнення камери, коли сторінка готова."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحہ کی گرفتاری پر کلک کریں، پھر صفحہ تیار ہو جائے تو کیمرے کے بندے پر کلک کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào Capture Page, sau đó nhấn khóa máy ảnh khi trang đã sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 Capture Page,然后按下相机关机,当页面准备好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊 Capture Page,然後按下相機關機,當頁面準備好。"
          }
        }
      }
    },
    "Tap Sync Queue when your iPhone is nearby.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على \"الخلفية\" عندما تكون iPhone في القريب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টপ সিনাকলিঙ্ক যখন আপনার iPhone কাছাকাছি আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf „Warteschlange synchronisieren“, wenn Ihr iPhone in der Nähe ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Sync Queue when your iPhone is nearby."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Sync Queue cuando el iPhone Está cerca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Sync Queue lorsque votre iPhone est proche"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapp Sync Queue जब आपका iPhone निकट है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol Sync Queue ketika Anda iPhone berada di dekatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccare Sync Queue quando il tuo iPhone è vicino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップ Sync Queue When your iPhone 近いな"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭 Sync Queue When your iPhone 가까이에 있는"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op Sync Queue wanneer uw iPhone is in de buurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij Sync Queue, gdy Twoje iPhone Jest w pobliżu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Sync Queue quando o seu iPhone Está perto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите Sync Queue, когда ваш iPhone Он находится рядом."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் காதலன் உன் காதலன் உன் காதலன் iPhone நெருங்கியது"
          }
        },
        "th": {
