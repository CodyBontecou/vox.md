            "value": "Iniciar la grabación sin cambiar de app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer l’enregistrement sans changer d’app"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बदले बिना रिकॉर्डिंग शुरू करें"
