    "%@ audio exceeded the bounded rollover buffer and was dropped.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز صوت %@ سعة المخزن المؤقت المحدود وتم إسقاطه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ অডিও সীমিত রোলওভার বাফার ছাড়িয়ে যাওয়ায় বাদ পড়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Audio hat den begrenzten Rollover-Puffer überschritten und wurde verworfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ audio exceeded the bounded rollover buffer and was dropped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio (%@) superó el búfer de transición limitado y se descartó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio (%@) a dépassé la mémoire tampon de transition limitée et a été abandonné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ऑडियो सीमित रोलओवर बफ़र से अधिक हो गया और छोड़ दिया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio %@ melebihi buffer rollover yang dibatasi dan terbuang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio (%@) ha superato il buffer di transizione limitato ed è stato scartato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のオーディオが上限付きロールオーバーバッファを超えたため、破棄されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 오디오가 제한된 롤오버 버퍼를 초과하여 삭제되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio (%@) overschreed de begrensde overloopbuffer en is verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk (%@) przekroczył ograniczony bufor przełączania i został utracony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio (%@) excedeu o buffer de transição limitado e foi descartado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио (%@) превысило ограниченный буфер переключения и было потеряно."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஒலி வரம்புள்ள ரோல்ஓவர் இடையகத்தை மீறியதால் கைவிடப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียง%@เกินบัฟเฟอร์หมุนเวียนที่จำกัดไว้และถูกทิ้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sesi sınırlı geçiş arabelleğini aştı ve atıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо (%@) перевищило обмежений буфер перемикання і було втрачено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ آڈیو محدود رول اوور بفر سے تجاوز کر گئی اور چھوڑ دی گئی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh %@ vượt quá bộ đệm luân chuyển giới hạn và đã bị bỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@音频超出了有限的滚动缓冲区，已被丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@音訊超出了有限的輪替緩衝區，已被捨棄。"
          }
        }
      }
    },
