    "No Vox.md account needed. Purchases use your Apple Account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Vox.md account needed. Purchases use your Apple Account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حاجة إلى حساب Vox.md تستخدم عمليات الشراء Apple Account الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো Vox.md অ্যাকাউন্টের প্রয়োজন নেই। কেনাকাটা আপনার Apple Account ব্যবহার করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Vox.md -Konto erforderlich. Für Einkäufe verwenden Sie Ihr Apple Account ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se necesita una cuenta Vox.md Las compras utilizan su Apple Account ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte Vox.md n'est nécessaire. Les achats utilisent votre Apple Account ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md खाते की आवश्यकता नहीं. ख़रीदारी आपके Apple Account उपयोग करती है।"
          }
        },
        "id": {
