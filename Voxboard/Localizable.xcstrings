    "Could not access the microphone. Check macOS Privacy & Security settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الوصول إلى الميكروفون. تحقق من macOS إعدادات الخصوصية والسلامة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোনের মাধ্যমে সেটা করতে পারিনি। চেক করুন macOS গোপনীয়তা এবং নিরাপত্তা সেটিংস।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf das Mikrofon konnte nicht zugegriffen werden. Prüfen Sie die macOS-Einstellungen für Datenschutz & Sicherheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access the microphone. Check macOS Privacy & Security settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podía acceder al micrófono. Verificar macOS Configuración de privacidad y seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n'arrive pas à accéder au micro. Vérifiez macOS Confidentialité et paramètres de sécurité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफोन तक पहुंच नहीं पाई। जांच macOS गोपनीयता और सुरक्षा सेटिंग्स"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa mengakses mikrofon. Periksa macOS Privasi & Pengaturan Keamanan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può accedere al microfono. Check di macOS Configurazione e privacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクにアクセスできませんでした。 チェック macOS プライバシー&セキュリティ設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크에 접근할 수 없었다. 체크해 macOS 개인정보 및 보안 설정"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kon niet op de microfoon. Check het macOS Privacy & beveiligingsinstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogłem wejść do mikrofonu. Sprawdź macOS Prywatność i ustawienia bezpieczeństwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegui acessar o microfone. Verifique macOS Configurações de privacidade e segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не смог проникнуть в микрофон. Проверьте macOS Настройки конфиденциальности и безопасности."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்ரோபியன் கிடைக்கவில்லை. Check macOS Privacy & Security Settings - பாதுகாப்பு மற்றும் பாதுகாப்பு அமைப்புகள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเข้าถึงไมโครโฟนได้ ตรวจสอบ macOS การตั้งค่าความเป็นส่วนตัวและความปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonu açamıyorum. kontrol et macOS Gizlilik ve Güvenlik ayarları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо отримати доступ до мікрофона. Перевірка macOS Налаштування конфіденційності та безпеки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میک اپ تک رسائی نہیں مل سکی چیک کریں macOS Privacy & Security Settings کے لئے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập micro. Kiểm tra macOS Privacy & Security Settings (Cài đặt bảo mật và quyền riêng tư)"
          }
        },
        "zh-Hans": {
