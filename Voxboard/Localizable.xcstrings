    "Stop keyboard listening or finish the current recording before adding a voice attachment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف الاستماع إلى القفز أو الانتهاء من تسجيل الحدث قبل إضافة ملف صوت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ভয়েস অ্যাডমিন্ট যোগ করার আগে কীবোর্ড শুনতে বন্ধ করুন বা বর্তমান রেকর্ড শেষ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen Sie das Tastatur-Diktat oder beenden Sie die aktuelle Aufnahme, bevor Sie einen Sprachanhang hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop keyboard listening or finish the current recording before adding a voice attachment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje de escuchar el teclado o finalice la grabación actual antes de agregar un apéndice de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez l’écoute du clavier ou terminez l’enregistrement actuel avant d’ajouter une pièce jointe vocale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक वॉयस एडमिनिंग जोड़ने से पहले कीबोर्ड सुनना बंद करें या वर्तमान रिकॉर्डिंग को पूरा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan mendengarkan keyboard atau menyelesaikan rekaman saat ini sebelum menambahkan lampiran suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smettere di ascoltare la tastiera o terminare l'inserimento corrente prima di aggiungere un allegato vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声添付を追加する前に、キーボードの聴くのをやめたり、現在の録音を終了したりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 첨부 파일을 추가하기 전에 키보드 듣기를 중지하거나 현재 녹음을 완료합니다.Stop keyboard listening or finish the current recording before adding a voice attachment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop het luisteren naar het toetsenbord of voltooien van de huidige opname voordat u een spraakbijlage toevoegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestań słuchać klawiatury lub zakończ bieżącą nagrywanie przed dodaniem załącznika głosowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare de ouvir o teclado ou termine a gravação atual antes de adicionar um anexo de voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекратите прослушивание клавиатуры или закончите текущую запись, прежде чем добавить голосовую приставку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது நீங்கள் கேட்கும் பதிவை நிறுத்துங்கள் அல்லது ஒரு பேச்சு இணைப்பை சேர்க்க முன் இப்போது எழுத முடிவு."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดการฟังแป้นพิมพ์หรือเสร็จสิ้นการบันทึกปัจจุบันก่อนที่จะเพิ่มไฟล์แนบเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye dinlemeyi durdurun veya bir ses eklenmesi eklemeden önce geçerli kaydını tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Припиніть слухати клавіатуру або закінчуйте поточний запис, перш ніж додати голосовий додаток."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیبلٹ سننے کو روکیں یا ایک آواز کی ملحق شامل کرنے سے پہلے موجودہ ریکارڈنگ ختم کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngừng nghe bàn phím hoặc hoàn thành bản ghi hiện tại trước khi thêm tệp đính kèm giọng nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止键盘听取或完成当前录音,然后添加语音附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止鍵盤聽取或完成當前錄音,然後添加語音附件。"
          }
        }
      }
    },
