          "stringUnit": {
            "state": "translated",
            "value": "பதிவு பாதுகாப்பானது, ஆனால் அதன் நிறுத்த நிலையை ஜர்னல் செய்ய முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกมีความปลอดภัย แต่ไม่สามารถบันทึกสถานะหยุดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt güvenli ancak durma durumu günlüğe kaydedilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис безпечний, але стан зупинки не вдалося записати в журнал."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ محفوظ ہے، لیکن اس کی اسٹاپ سٹیٹ کو جرنل نہیں کیا جا سکا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình ghi vẫn an toàn nhưng trạng thái dừng của nó không thể được ghi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制是安全的，但无法记录其停止状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製是安全的，但無法記錄其停止狀態。"
          }
        }
      }
    },
