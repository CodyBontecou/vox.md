            "value": "Transcript oluşturuldu ama klipboard'a kopyalayamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт був створений, але не міг бути скопійований на кліпборд."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسفر پیدا کیا گیا تھا لیکن کلپ بورڈ پر کاپی نہیں کیا جا سکتا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao được tạo ra nhưng không thể sao chép vào clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录是创建的,但无法复制到剪辑板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉錄是創建的,但無法複製到剪輯板。"
          }
        }
      }
    },
    "The transcript was saved, but the requested audio could not be exported. The recording was preserved for recovery.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخزين الترجمة ، ولكن لم يتم نقل الصوت المطلوب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সক্রিপ্ট সংরক্ষিত হয়েছিল, কিন্তু অনুরোধিত অডিও রপ্তানি করা সম্ভব হয়নি. রেকর্ডিং পুনরুদ্ধার জন্য সংরক্ষিত হয়েছে."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Transkript wurde gespeichert, aber das angeforderte Audio konnte nicht exportiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript was saved, but the requested audio could not be exported. The recording was preserved for recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El transcripto se salvó, pero el audio solicitado no se pudo exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription a été enregistrée, mais l'audio demandé n'a pas pu être exporté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्ट को सहेजा गया था, लेकिन अनुरोधित ऑडियो को निर्यात नहीं किया जा सका. रिकॉर्डिंग को पुनर्प्राप्ति के लिए संरक्षित किया गया था."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript disimpan, tetapi audio yang diminta tidak dapat diekspor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione è stata salvata, ma l'audio richiesto non è stato esportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランスクリプトは保存されたが、要求されたオーディオはエクスポートできない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 트랜스크립트는 저장되었지만 요청된 오디오는 내보낼 수 없었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transcript werd opgeslagen, maar de gevraagde audio kon niet worden geëxporteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja została zapisana, ale żądany dźwięk nie mógł zostać wyeksportowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição foi salvo, mas o áudio solicitado não pôde ser exportado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт был сохранен, но запрошенный аудио не мог быть экспортирован."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவைப் படித்தால், இடுகைகள் வெளியிடப்படவில்லை.இந்த பதிவை மீண்டும் பதிவிறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกถูกบันทึก แต่ไม่สามารถส่งออกเสียงที่ต้องการ การบันทึกถูกเก็บไว้เพื่อการกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript kaydedildi, ancak talep edilen ses çıkarılamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт був збережений, але запис не можна було експортувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسپیٹ محفوظ کیا گیا تھا، لیکن درخواست کردہ آڈیو کو برآمد نہیں کیا جا سکتا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao được lưu, nhưng âm thanh yêu cầu không thể được xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录被保存,但无法导出所要求的音频,记录被保存以恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉錄被保存,但無法導出所要求的音頻,記錄被保存以恢復。"
          }
        }
      }
    },
    "The transcription service did not provide a reason.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقدم خدمة الترجمة سببًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সপ্লোরেশন পরিষেবা একটি কারণ সরবরাহ করেনি।"
          }
        },
        "de": {
