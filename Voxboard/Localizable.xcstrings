    "Unlimited on-device transcription. Routes on keyboard, Watch, Mac and widgets. Plain Markdown files you own.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخ صوتي غير محدود على الجهاز. مسارات على لوحة المفاتيح وWatch وMac والأدوات. ملفات Markdown عادية تمتلكها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনলিমিটেড ডিভাইসে ট্রান্সক্রিপশন। কীবোর্ড, Watch, Mac ও উইজেটে রুট। আপনার নিজের সাধারণ Markdown ফাইল।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzte Transkription auf dem Gerät. Routen auf Tastatur, Watch, Mac und in Widgets. Einfache Markdown-Dateien, die Ihnen gehören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited on-device transcription. Routes on keyboard, Watch, Mac and widgets. Plain Markdown files you own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripción ilimitada en el dispositivo. Rutas en el teclado, el Watch, el Mac y los widgets. Archivos Markdown sencillos que son tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription illimitée sur l’appareil. Parcours sur le clavier, la Watch, le Mac et les widgets. Des fichiers Markdown simples qui vous appartiennent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनलिमिटेड ऑन-डिवाइस ट्रांसक्रिप्शन। कीबोर्ड, Watch, Mac और विजेट पर रूट्स। सादी Markdown फ़ाइलें, जिनके मालिक आप हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsi di perangkat tanpa batas. Rute di papan ketik, Watch, Mac, dan widget. File Markdown biasa milik Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione illimitata sul dispositivo. Percorsi su tastiera, Watch, Mac e widget. File Markdown semplici che ti appartengono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無制限のデバイス上の文字起こし。キーボード、Watch、Mac、ウィジェットでルートを利用。自分のものになるプレーンなMarkdownファイル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무제한 기기 내 전사. 키보드, Watch, Mac 및 위젯에서 루트 사용. 내가 소유하는 일반 Markdown 파일."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbeperkte transcriptie op het apparaat. Routes op toetsenbord, Watch, Mac en in widgets. Gewone Markdown-bestanden die van jou zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieograniczona transkrypcja na urządzeniu. Trasy na klawiaturze, zegarku, Macu i w widżetach. Zwykłe pliki Markdown, które należą do Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrição ilimitada no dispositivo. Rotas no teclado, Watch, Mac e widgets. Arquivos Markdown simples que são seus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безлимитная транскрипция на устройстве. Маршруты на клавиатуре, часах, Mac и в виджетах. Обычные файлы Markdown, которые принадлежат вам."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரம்பற்ற சாதனத்திலேயே உரைமாற்றம். விசைப்பலகை, Watch, Mac மற்றும் விட்ஜெட்களில் வழித்தடங்கள். உங்களுக்குச் சொந்தமான எளிய Markdown கோப்புகள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถอดเสียงบนอุปกรณ์ได้ไม่จำกัด เส้นทางบนแป้นพิมพ์ Watch, Mac และวิดเจ็ต ไฟล์ Markdown ธรรมดาที่คุณเป็นเจ้าของ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırsız aygıt üzerinde transkripsiyon. Klavyede, Watch'ta, Mac'te ve widget'larda rotalar. Size ait düz Markdown dosyaları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необмежена транскрипція на пристрої. Маршрути на клавіатурі, годиннику, Mac і у віджетах. Звичайні файли Markdown, що належать вам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آلے پر لامحدود ٹرانسکرپشن۔ کی بورڈ، Watch، Mac اور ویجیٹس پر روٹس۔ سادہ Markdown فائلیں جو آپ کی ملکیت ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chép lời trên thiết bị không giới hạn. Lộ trình trên bàn phím, Watch, Mac và tiện ích. Tệp Markdown thuần thuộc về bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限次设备端转录。路线可用于键盘、手表、Mac 和小组件。归你所有的纯 Markdown 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無限次裝置端轉錄。路線可用於鍵盤、手錶、Mac 和小工具。歸你所有的純 Markdown 檔案。"
          }
        }
      }
    },
