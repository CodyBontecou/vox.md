            "value": "রেকর্ড Apple Watch সেখানে এটি স্বয়ংক্রিয়ভাবে প্রদর্শিত হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehmen Sie auf der Apple Watch auf – sie erscheint automatisch hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record on Apple Watch and it will appear here automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Record en Apple Watch Y aparecerá automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Record sur Apple Watch Il apparaîtra automatiquement ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड है Apple Watch यह यहां स्वचालित रूप से दिखाई देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekornya Apple Watch Dan akan muncul secara otomatis di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il record è Apple Watch E qui apparirà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レコード ON Apple Watch ここに自動的に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 Apple Watch 여기서 자동으로 나타날 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Record is Apple Watch Hier zal het automatisch verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekordzista jest Apple Watch I pojawi się tutaj automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Record em Apple Watch E isso vai aparecer aqui automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекорд на Apple Watch И он будет появляться здесь автоматически."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Record அறிய Apple Watch இதில் அது ஒரு automatic"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึก Apple Watch และจะปรากฏที่นี่โดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekorlar var Apple Watch Burada otomatik olarak ortaya çıkacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекорд на Apple Watch Тут він буде автоматично."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈ ہے Apple Watch یہ یہاں خود بخود ظاہر ہو جائے گا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "kỷ lục Apple Watch Và nó sẽ xuất hiện ở đây tự động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录在 Apple Watch 它会自动出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄在 Apple Watch 它會自動出現。"
          }
        }
      }
    },
    "Record on this Watch. Syncs to iPhone later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقى رسالة من هذا النوع.سماحة إلى iPhone في وقت لاحق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ঘড়ির রেকর্ড সিন্ধু iPhone পরে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dieser Watch aufnehmen. Synchronisiert später mit dem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record on this Watch. Syncs to iPhone later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Record en este reloj. Sinónimos iPhone Más tarde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le record de cette montre. Synchronisation à iPhone plus tard"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस घड़ी पर रिकॉर्ड। सिंक्रनाइज़ iPhone बाद में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman di jam tangan ini. Sync yang iPhone kemudian"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il record su questo orologio. Sincronizzati iPhone Più tardi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時計の記録 シンクス iPhone 後で"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시계에 기록된 Sync 이 iPhone 나중에"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorder op deze klok. Synchroniseren met iPhone Later nog"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis na zegarku. Synchronizacja iPhone Później"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresentação deste relógio. Sincronização iPhone Mais tarde"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись на этот часовник. Синхронизировать iPhone Позже"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மணிக்கு பதிவேடு. Sync இல் iPhone பிறகு"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกในนาฬิกานี้ สัญญาณ iPhone หลังจากนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatte kayıt yaptırın. Sinemalar iPhone Daha sonra"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис на цей годинник. Синхронізм iPhone Пізніше"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
