    "Vox.md can’t reach this vault folder right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ Vox.md الوصول إلى مجلد الخزنة هذا الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md এই মুহূর্তে এই ভল্ট ফোল্ডারে পৌঁছাতে পারছে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md kann diesen Tresorordner gerade nicht erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md can’t reach this vault folder right now."
          }
        },
        "es": {
