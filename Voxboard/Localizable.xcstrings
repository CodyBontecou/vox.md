        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द किया गया, क्योंकि रूट को मूल-समय की लोकेशन चाहिए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibatalkan karena rute memerlukan lokasi saat tangkapan dibuat"
