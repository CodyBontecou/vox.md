    "iPhone will ask about %lld unavailable locations.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يسأل iPhone عن %lld المواقع غير المتاحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone %lld অনুপলব্ধ অবস্থান সম্পর্কে জিজ্ঞাসা করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone fragt nach %lld nicht verfügbaren Standorten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone will ask about %lld unavailable locations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone preguntará sobre %lld ubicaciones no disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'iPhone vous demandera quels sont les emplacements indisponibles %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone %lld अनुपलब्ध स्थानों के बारे में पूछेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone akan menanyakan tentang %lld lokasi yang tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ti chiederà informazioni sulle %lld posizioni non disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone は%lld 利用できない場所について尋ねます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone은 %lld 사용할 수 없는 위치에 대해 묻습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone vraagt naar %lld niet-beschikbare locaties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone zapyta o niedostępne lokalizacje %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone perguntará sobre %lld locais indisponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone спросит о недоступных %lld местах."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld கிடைக்காத இடங்களைப் பற்றி iPhone கேட்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone จะถามเกี่ยวกับตำแหน่งที่ไม่ว่าง %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, %lld kullanılamayan konumları soracaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone запитає про %lld недоступні місця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone %lld غیر دستیاب مقامات کے بارے میں پوچھے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone sẽ hỏi về %lld vị trí không khả dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 将询问 %lld 不可用的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 將詢問 %lld 不可用的位置。"
          }
        }
      }
    },
