    "No camera is available. Connect a camera or enable Continuity Camera.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد أي كاميرا متوفرة.إذا قمت بتحميل الكاميرا أو تثبيت الكاميرات المستمرة."
