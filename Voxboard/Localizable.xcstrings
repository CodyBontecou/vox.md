          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowano, ponieważ trasa wymaga lokalizacji z chwili przechwycenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelada porque a rota exige a localização do momento de origem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменено: маршруту нужна геопозиция в момент захвата"
