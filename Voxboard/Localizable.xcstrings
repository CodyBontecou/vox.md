          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сочетания клавиш"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்துக் குறுக்குவழிகளும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มลัดทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm Kısayollar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі сполучення клавіш"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام شارٹ کٹس"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả phím tắt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
