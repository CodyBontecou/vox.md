    "Press one non-modifier key with Control, Option, or Command.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على مفتاح غير المتغير مع التحكم أو الخيار أو التحكيم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিয়ন্ত্রণ, অপশন বা কমান্ডের সাথে একটি অ-মডিফাইকারি কী চাপুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
