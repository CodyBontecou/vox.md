    "Use a letter, number, Space, arrow, or function key with ⌃ Control, ⌥ Option, or ⌘ Command. ⇧ Shift can be combined. Press Esc to cancel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم كلمة أو عدد أو مساحة أو ألقاب أو مفتاح العلامة التجارية مع  التحكم أو  الخيار أو   الدليل.  يمكنك الجمع بين Shift و Press Esc لتغيير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি চিঠি, সংখ্যা, স্পেস, পাইল বা ফাংশন কী ব্যবহার করুন  নিয়ন্ত্রণ,  বিকল্প, বা  কমান্ড.  Shift একত্রিত করা যেতে পারে. বাতিল করতে Esc চাপুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie einen Buchstaben, eine Zahl, einen Raum, einen Pfeil oder einen Funktionstasten mit  Steuerung,  Option oder  Befehl.  Shift kann kombiniert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a letter, number, Space, arrow, or function key with ⌃ Control, ⌥ Option, or ⌘ Command. ⇧ Shift can be combined. Press Esc to cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice una letra, número, espacio, flecha o tecla de función con  Control,  Opción o  Comando.  Shift se puede combinar. Presione Esc para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une lettre, un nombre, un espace, une flèche ou une clé de fonction avec  Contrôle,  Option ou  Commande.  Shift peut être combiné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पत्र, संख्या, अंतरिक्ष, तीर या कार्य कुंजी का उपयोग करें  नियंत्रण,  विकल्प, या  कमान.  Shift को जोड़ा जा सकता है. रद्द करने के लिए Esc दबाएं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan huruf, angka, ruang, panah, atau tombol fungsi dengan  Kontrol,  Opsi, atau  Perintah.  Shift dapat dikombinasikan. tekan Esc untuk membatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare una lettera, un numero, uno spazio, una freccia o una chiave di funzione con  Control,  Option o  Command.  Shift può essere combinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字、数字、スペース、矢印、または関数キーを使用して  コントロール、  オプション、または  コマンド  Shift を組み合わせることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어,  옵션 또는  명령을 사용하여 문자, 숫자, 공간, 화살표 또는 함수 키를 사용합니다.  Shift를 결합할 수 있습니다. Esc를 누르면 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een letter, getal, ruimte, pijl of functie-toets met  Besturing,  Optie of  Commando.  Shift kan worden gecombineerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj litery, liczby, przestrzeni, strzałki lub klawisza funkcji z  Sterowanie,  Opcja lub  Polecenie.  Można łączyć polecenia Shift."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma letra, número, espaço, seta ou tecla de função com  Controle,  Opção ou  Comando.  Shift pode ser combinado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте букву, число, пространство, стрелку или клавишу функции с помощью  Контроль,  Опция или  Команда.  Смена может быть объединена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு கதையை, ஒரு எண், ஒரு அறை, ஒரு பவுண்டரி, ஒரு துண்டு அல்லது ஒரு செயல்பாடு கிளிக்  Control,  Option, or  Command.  Shift ஒப்பிட முடியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ตัวอักษรหมายเลขพื้นที่ปุ่มลูกศรหรือคีย์ฟังก์ชั่นด้วย  ตัวควบคุม  ตัวเลือกหรือ  คําสั่ง  Shift สามารถรวมกันกด Esc เพื่อยกเลิกการใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir harf, sayı, uzay, ok veya işlev anahtarı ile  Kontrol,  Seçenek veya  Komut.  Shift birleştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте букву, число, проміжок, стрілку або функційний клавіш з  Контроль,  Опція або  Команда.  Зміна можна об'єднати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک خط، نمبر، جگہ، پائپ یا فائل کے کلید کا استعمال کریں  کنٹرول،  اختیارات، یا  کمانڈ.  Shift کو مجموعی طور پر شامل کیا جا سکتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng một chữ cái, số, không gian, mũi tên hoặc phím chức năng với  Điều khiển,  Tùy chọn, hoặc  Lệnh.  Shift có thể được kết hợp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用字母、数字、空间、箭头或函数键与  控制、  选项或  命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用字母、數字、空間、箭頭或函數鍵與  控制、  選項或  命令。"
          }
        }
      }
    },
