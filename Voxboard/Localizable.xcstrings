          "stringUnit": {
            "state": "translated",
            "value": "উদ্ধার করা হয়েছে দর্শকদের। টপ সিনাকলিটেড পরে আপনার iPhone কাছাকাছি আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Watch gesichert. Tippen Sie auf „Warteschlange synchronisieren“, wenn Ihr iPhone in der Nähe ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on Watch. Tap Sync Queue after your iPhone is nearby."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva en la vigilancia. Tap Sync Queue después de su iPhone Está cerca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvé par la veille. Tap Sync Queue après votre iPhone est proche"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बचाव में नजर आए। अपने बाद के लिए Sync Queue iPhone निकट है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamatkan di Watch. Tombol Sync Queue setelah Anda iPhone berada di dekatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvati in guardia. Tapp Sync Queue dopo il tuo iPhone è vicino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "救われたのは、ウォッチ。 タップ Sync Queue After Your iPhone 近いな"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구원받은 시계 탭 Sync Queue After your iPhone 가까이에 있는"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reddingsdienst op de wacht. Tap Sync Queue na uw iPhone is in de buurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uratował się na obserwacji. Tap Sync Queue po Twojej iPhone Jest w pobliżu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvação em vigilância. Tap Sync Queue após o seu iPhone Está perto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасенный на стороже. Tap Sync Queue после вашего iPhone Он находится рядом."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காத்திருப்பதை காப்பாற்ற பின்னூட்டத்திற்கு பின்னூட்டத்தில் iPhone நெருங்கியது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการตรวจสอบ Tap Sync Queue หลังจากของคุณ iPhone อยู่ใกล้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözlemci kurtarıldı Sync Queue After Your iPhone Yakınında var"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Врятували на сторожі. Натисніть Sync Queue після вашого iPhone Він є близьким."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نگاہ میں بچاؤ آپ کے بعد Sync Queue iPhone قریب ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cứu em trên Watch Tải Sync Queue After Your iPhone gần gũi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "救了在看。 按一下 Sync 接线后你的 iPhone 是近。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "救了在看。 按一下 Sync 接線後你的 iPhone 是近。"
          }
        }
      }
    },
