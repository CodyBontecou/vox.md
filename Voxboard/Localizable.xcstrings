    "Capture text is above the 100,000-character safety limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم ضبط النص فوق الحد الأدنى من 100,000 الحروف الأمنية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার টেক্সট 100,000 চিহ্ন সুরক্ষা সীমা অতিক্রম করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Erfassungstext liegt über dem Sicherheitslimit von 100.000 Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture text is above the 100,000-character safety limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de captura está por encima del límite de seguridad de 100,000 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte capturé est supérieur à la limite de sécurité de 100 000 caractères."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर पाठ 100,000-शैर सुरक्षा सीमा से ऊपर है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang ditangkap melebihi batas keamanan 100.000 karakter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo di cattura è al di sopra del limite di sicurezza di 100.000 caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの保存は、100,000文字のセキュリティ制限を超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 텍스트는 100,000자리 보안 제한을 초과합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekst is boven de veiligheidslimiet van 100.000 tekens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst jest przekraczany przez limit bezpieczeństwa 100 000 znaków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto capturado está acima do limite de segurança de 100 mil caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись текста превышает предел безопасности 100 000 символов."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "100,000 அம்சங்கள் பாதுகாப்பான அளவுக்கு அதிகமானது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์บันทึกข้อความเกินขีด จํากัด ความปลอดภัย 100,000 ตัว"
          }
        },
        "tr": {
