      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال دائمًا بدون الموقع لهذا المسار"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রুটের জন্য সবসময় লোকেশন ছাড়া পাঠান"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Route immer ohne Standort senden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Send Without Location for This Route"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar siempre sin ubicación para esta ruta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours envoyer sans position pour ce parcours"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रूट के लिए हमेशा बिना लोकेशन के भेजें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu Kirim Tanpa Lokasi untuk Rute Ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia sempre senza posizione per questo percorso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルートでは常に位置情報なしで送信"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 루트에서는 항상 위치 없이 보내기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd zonder locatie versturen voor deze route"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze wysyłaj bez lokalizacji dla tej trasy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre Enviar sem Localização para Esta Rota"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда отправлять без геопозиции для этого маршрута"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வழித்தடத்திற்கு எப்போதும் இருப்பிடம் இல்லாமல் அனுப்பு"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งโดยไม่มีตำแหน่งเสมอสำหรับเส้นทางนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Rota İçin Her Zaman Konumsuz Gönder"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди надсилати без геопозиції для цього маршруту"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس روٹ کے لیے ہمیشہ مقام کے بغیر بھیجیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn gửi không kèm vị trí cho lộ trình này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
