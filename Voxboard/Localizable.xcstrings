    "Make it yours": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعلها لك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজের মতো করে নিন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach sie zu deiner"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it yours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazla tuya"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites-la vôtre"
          }
        },
        "hi": {
          "stringUnit": {
