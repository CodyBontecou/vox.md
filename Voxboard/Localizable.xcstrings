    "Vox.md is finishing the Capture export": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md تنتهي إصدار Capture Export"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md চূড়ান্ত হচ্ছে রপ্তানি"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md schließt den Erfassungsexport ab"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md is finishing the Capture export"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Se acaba la exportación de capturas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md La fin de l’exportation est en cours"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md निर्यात के लिए कब्जा खत्म"
          }
        },
        "id": {
          "stringUnit": {
