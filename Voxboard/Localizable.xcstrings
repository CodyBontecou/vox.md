            "state": "translated",
            "value": "iPhone Il n’a pas pu sauver le transfert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone हमने इस ट्रांसफर को बचा नहीं पाया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Tidak bisa menyelamatkan transfer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Non si poteva salvare il trasferimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 移転を救えなかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 이송을 구할 수 없었다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone De overdracht kon niet gered worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Nie udało się uratować transferu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Não consegui salvar a transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Перевод не удалось спасти."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone transfer காப்பாற்ற முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ไม่สามารถบันทึกการถ่ายโอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Transferden kurtulamadık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Переїзду не врятувати не вдалося."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone انتقال کو بچانے کے قابل نہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Không thể cứu được chuyển nhượng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 无法挽救转会。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 無法挽救轉會。"
          }
        }
      }
