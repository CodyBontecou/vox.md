          "stringUnit": {
            "state": "translated",
            "value": "Öffnet „Transkriptionsmodelle“, um das ausgewählte Modell zu laden oder eine vorhandene Kopie auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Transcription Models to download the selected model or choose an existing copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Modelos de transcripción para descargar el modelo seleccionado o elegir una copia existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Modèles de transcription pour télécharger le modèle sélectionné ou choisir une copie existante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुना गया मॉडल डाउनलोड करने या मौजूदा कॉपी चुनने के लिए ट्रांसक्रिप्शन मॉडल खोलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Model Transkripsi untuk mengunduh model yang dipilih atau memilih salinan yang ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Modelli di trascrizione per scaricare il modello selezionato o scegliere una copia esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「文字起こしモデル」を開いて、選択したモデルをダウンロードするか既存のコピーを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사 모델을 열어 선택한 모델을 다운로드하거나 기존 사본을 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Transcriptiemodellen om het geselecteerde model te downloaden of een bestaande kopie te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Modele transkrypcji, aby pobrać wybrany model lub wybrać istniejącą kopię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Modelos de Transcrição para baixar o modelo selecionado ou escolher uma cópia existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает «Модели транскрипции», чтобы загрузить выбранную модель или выбрать существующую копию."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த மாதிரியைப் பதிவிறக்க அல்லது ஏற்கனவே உள்ள நகலைத் தேர்ந்தெடுக்க உரைமாற்ற மாதிரிகளைத் திறக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดโมเดลการถอดเสียงเพื่อดาวน์โหลดโมเดลที่เลือกหรือเลือกสำเนาที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen modeli indirmek veya mevcut bir kopyayı seçmek için Transkripsiyon Modelleri'ni açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває «Моделі транскрипції», щоб завантажити вибрану модель або вибрати наявну копію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب ماڈل ڈاؤن لوڈ کرنے یا موجودہ کاپی منتخب کرنے کے لیے ٹرانسکرپشن ماڈلز کھولتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Mô hình chép lời để tải về mô hình đã chọn hoặc chọn một bản sao có sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“转录模型”以下载所选模型或选择现有副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開「轉錄模型」以下載所選模型或選擇現有副本。"
          }
        }
      }
    },
    "Optional confirmation for Route sends. Turn it off in Settings › Capture Bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكيد اختياري لعمليات الإرسال عبر المسارات. أوقفه من الإعدادات › شريط الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুট দিয়ে পাঠানোর জন্য ঐচ্ছিক নিশ্চিতকরণ। সেটিংস › ক্যাপচার বার-এ এটি বন্ধ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Bestätigung für Routen-Sendungen. Deaktivieren Sie sie unter „Einstellungen“ › „Erfassungsleiste“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional confirmation for Route sends. Turn it off in Settings › Capture Bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmación opcional para envíos con ruta. Desactívala en Ajustes › Barra de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmation facultative pour les envois avec un parcours. Désactivez-la dans Réglages › Barre de capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूट से भेजने के लिए वैकल्पिक पुष्टि। इसे सेटिंग्ज़ › कैप्चर बार में बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasi opsional untuk pengiriman Rute. Matikan di Pengaturan › Bilah Tangkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma facoltativa per gli invii con un percorso. Disattivala in Impostazioni › Barra di acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルート送信時の確認（オプション）。「設定」›「キャプチャバー」でオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트로 보낼 때의 선택적 확인입니다. 설정 › 캡처 막대에서 끌 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionele bevestiging bij versturen met een route. Zet dit uit in Instellingen › Vastlegbalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne potwierdzenie wysyłania trasą. Wyłączysz je w Ustawienia › Pasek przechwytywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmação opcional para envios com rota. Desative-a em Ajustes › Barra de Captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательное подтверждение отправок по маршруту. Выключить можно в Настройки › Панель захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழித்தட அனுப்புதல்களுக்கான விருப்ப உறுதிப்படுத்தல். அமைப்புகள் › பிடிப்புப் பட்டியில் இதை முடக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยืนยันที่เลือกได้สำหรับการส่งด้วยเส้นทาง ปิดได้ในการตั้งค่า › แถบจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rota gönderimleri için isteğe bağlı onay. Ayarlar › Yakalama Çubuğu'ndan kapatabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язкове підтвердження надсилань за маршрутом. Вимкнути можна в Параметри › Панель захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روٹ کے ذریعے بھیجنے کی اختیاری تصدیق۔ اسے سیٹنگز › کیپچر بار میں بند کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận tùy chọn khi gửi bằng lộ trình. Tắt trong Cài đặt › Thanh ghi nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路线发送前的可选确认。可在“设置” › “采集栏”中关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路線傳送前的選用確認。可在「設定」›「擷取列」中關閉。"
          }
        }
      }
    },
