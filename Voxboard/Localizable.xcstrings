    "Wait for the current Capture export to finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر حتى تنتهي استيراد Capture الحالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমান ক্যাপচার রপ্তানি শেষ করার জন্য অপেক্ষা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, bis der aktuelle Export abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current Capture export to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere que la exportación de Capture actual se complete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendre que l'exportation de Capture actuelle soit terminée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान कब्जे निर्यात समाप्त होने के लिए प्रतीक्षा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunggu hingga ekspor Capture saat ini selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendere che l'esportazione di Capture corrente sia terminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の Capture 輸出が完了するまで待つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 Capture 수출이 완료되도록 기다립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot de huidige Export van Capture is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj, aż kończy się bieżący eksport Capture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde que a exportação atual do Capture termine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь окончания экспорта текущего Capture."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது முடிந்தவரை காத்திருங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอจนกว่าการส่งออก Capture ที่ปัจจุบันจะเสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut Capture ihracatının bitmesini bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дочекайтеся, поки експорт поточного Capture завершиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ کٹنگ کی برآمد ختم کرنے کے لئے انتظار کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chờ cho quá trình xuất khẩu Capture hiện tại hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待当前 Capture 出口完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待當前 Capture 出口完成。"
          }
        }
      }
    },
    "Wait for the current recording or Capture export to finish before quitting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر حتى يتم الانتهاء من تسجيل الحالي أو استيراد السيرك قبل الانتهاؤ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ করার আগে বর্তমান রেকর্ডিং বা ক্যাপচার রপ্তানি শেষ করার জন্য অপেক্ষা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, bis die aktuelle Aufnahme oder der Erfassungsexport abgeschlossen ist, bevor Sie beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current recording or Capture export to finish before quitting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere que la grabación o la exportación de captura actuales se complete antes de dejar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez que l'enregistrement ou l'exportation de capture actuel soit terminée avant de cesser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समाप्त होने से पहले वर्तमान रिकॉर्डिंग या कैप्चर निर्यात को पूरा करने के लिए प्रतीक्षा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunggu hingga perekaman saat ini atau ekspor Capture selesai sebelum berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendere che l'esportazione di registrazione o di cattura corrente sia terminata prima di interrompere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了する前に、現在の録音またはキャプチャ輸出が完了するのを待つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멈추기 전에 현재 녹음 또는 캡처 수출이 완료되도록 기다립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot de huidige opname of het Exporteren van de opname is voltooid voordat u stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj, aż aktualny nagrywanie lub eksportowanie przechwytywania zostanie zakończone przed zakończeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde que a gravação atual ou a exportação de captura termine antes de parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь окончания текущей записи или экспорта Capture, прежде чем прекратить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது எழுதப்பட்ட அல்லது வெளியிடப்பட்ட பதிவை முடித்துவிட்டு வெளியேற வேண்டும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอการบันทึกหรือการส่งออก Capture ที่ปัจจุบันจะเสร็จสิ้นก่อนที่จะหยุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatma veya kaydetme eksporu bitmeden önce bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекайте, поки поточний запис або експорт захоплення закінчиться, перш ніж припинити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ختم کرنے سے پہلے موجودہ ریکارڈنگ یا کٹنے برآمد کا انتظار کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chờ cho việc xuất bản ghi âm hoặc Capture hiện tại hoàn tất trước khi dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待当前录制或捕捉导出完成,然后停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待當前錄製或捕捉導出完成,然後停止。"
          }
        }
      }
    },
