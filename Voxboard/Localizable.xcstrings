            "state": "translated",
            "value": "La transcripción y el procesamiento se quedan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription et le traitement restent sur ce Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्शन और प्रोसेसिंग इसी Mac पर रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsi dan pemrosesan tetap di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione ed elaborazione restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしと処理はこのMac上で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사와 처리는 이 Mac에서 이루어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriptie en verwerking blijven op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja i przetwarzanie pozostają na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição e o processamento ficam neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипция и обработка остаются на этом Mac."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரைமாற்றமும் செயலாக்கமும் இந்த Mac இலேயே இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอดเสียงและการประมวลผลจะอยู่บน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsiyon ve işleme bu Mac'te kalır."
          }
        },
        "uk": {
          "stringUnit": {
