          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a captura rápida e adiciona capturas de tela com o Predefinição de captura selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откроет функцию Quick Capture и добавляет скриншоты с выбранной настройкой Capture Preset."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Capture திறந்து, தேர்வு செய்யப்பட்ட Capture Preset மூலம் Screenshots சேர்க்கும்."
