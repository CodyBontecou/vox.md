    "Do what you can, with what you have, where you are.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمل ما يمكنك، مع ما لديك، حيث أنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যা করতে পারেন, যা আছে, যেখানে আপনি আছেন, যা করতে পারবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tun Sie, was Sie können, mit dem, was Sie haben, wo Sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do what you can, with what you have, where you are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz lo que puedas, con lo que tienes, donde estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites ce que vous pouvez, avec ce que vous avez, où vous êtes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो कुछ आप कर सकते हैं, जो आपके पास है, जहां आप हैं, वहां करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakukan apa yang Anda bisa, dengan apa yang Anda miliki, di mana Anda berada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai quello che puoi, con ciò che hai, dove sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "できることをやれ、持っているものと、どこにいるか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신이 할 수있는 것을, 당신이 가진 것과, 당신이있는 곳에서."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe wat je kunt, met wat je hebt, waar je bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rób to, co możesz, z tym, co masz, gdzie jesteś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o que puder, com o que tem, onde estiver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делайте то, что можете, с тем, что у вас есть, где вы находитесь."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் செய்ய முடியும், நீங்கள் என்ன வேண்டும், நீங்கள் எங்கே இருக்கிறீர்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทําสิ่งที่คุณสามารถทําด้วยสิ่งที่คุณมีในที่ที่คุณอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapabileceğinizi yapın, sahip olduğunuzla, bulunduğunuz yerde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робіть те, що можете, з тим, що маєте, де ви знаходитесь."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو کچھ آپ کر سکتے ہیں، جس کے ساتھ آپ کو ہے، جہاں آپ ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy làm những gì bạn có thể, với những gì bạn có, ở đâu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做你能做的事,用你所拥有的,在你所在的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做你能做的事,用你所擁有的,在你所在的地方。"
          }
        }
      }
    },
