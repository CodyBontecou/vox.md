          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank to retain the existing automatic name. Typed extensions are replaced by the real audio extension, and unsafe path characters are sanitized."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en blanco para conservar el nombre automático actual. Las extensiones escritas se reemplazan por la extensión real del audio y los caracteres de ruta de acceso no seguros se limpian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour conserver le nom automatique existant. Les extensions saisies sont remplacées par la véritable extension audio, et les caractères de chemin non sûrs sont nettoyés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा स्वचालित नाम बनाए रखने के लिए खाली छोड़ें। टाइप किए गए एक्सटेंशन वास्तविक ऑडियो एक्सटेंशन से बदल दिए जाते हैं, और असुरक्षित पाथ वर्ण साफ़ कर दिए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kosong untuk mempertahankan nama otomatis yang ada. Ekstensi yang diketik diganti dengan ekstensi audio sebenarnya, dan karakter jalur yang tidak aman dibersihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per mantenere il nome automatico esistente. Le estensioni digitate vengono sostituite dall’estensione audio reale e i caratteri di percorso non sicuri vengono ripuliti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄のままにすると、既存の自動名が保持されます。入力した拡張子は実際のオーディオの拡張子に置き換えられ、安全でないパスの文字は整えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 자동 이름을 유지하려면 비워 두세요. 입력한 확장자는 실제 오디오 확장자로 대체되며, 안전하지 않은 경로 문자는 정리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om de bestaande automatische naam te behouden. Getypte extensies worden vervangen door de werkelijke audio-extensie en onveilige padtekens worden opgeschoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby zachować obecną automatyczną nazwę. Wpisane rozszerzenia są zastępowane rzeczywistym rozszerzeniem audio, a niebezpieczne znaki ścieżki są oczyszczane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para manter o nome automático atual. Extensões digitadas são substituídas pela extensão real do áudio, e caracteres de caminho inseguros são corrigidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы сохранить текущее автоматическое имя. Введенные расширения заменяются фактическим расширением аудио, а небезопасные символы пути очищаются."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்கனவே உள்ள தானியங்குப் பெயரைத் தக்கவைக்க காலியாக விடவும். தட்டச்சு செய்த நீட்டிப்புகள் உண்மையான ஒலி நீட்டிப்பால் மாற்றப்படும், பாதுகாப்பற்ற பாதை எழுத்துகள் சுத்திகரிக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เว้นว่างไว้เพื่อคงชื่ออัตโนมัติเดิม นามสกุลที่พิมพ์จะถูกแทนที่ด้วยนามสกุลเสียงจริง และอักขระพาธที่ไม่ปลอดภัยจะถูกปรับแก้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut otomatik adı korumak için boş bırakın. Yazılan uzantıların yerini gerçek ses uzantısı alır ve güvenli olmayan yol karakterleri temizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім, щоб зберегти поточну автоматичну назву. Введені розширення замінюються фактичним розширенням аудіо, а небезпечні символи шляху очищуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ خودکار نام برقرار رکھنے کے لیے خالی چھوڑ دیں۔ ٹائپ کردہ ایکسٹینشنز اصل آڈیو ایکسٹینشن سے بدل دی جاتی ہیں، اور راستے کے غیر محفوظ حروف صاف کیے جاتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống để giữ tên tự động hiện có. Phần mở rộng bạn nhập sẽ được thay bằng phần mở rộng âm thanh thực và ký tự đường dẫn không an toàn sẽ được làm sạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则保留现有的自动名称。输入的扩展名会替换为实际的音频扩展名，不安全的路径字符会被清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空則保留現有的自動名稱。輸入的副檔名會取代為實際的音訊副檔名，不安全的路徑字元會被清理。"
          }
        }
      }
    },
    "Leave the name blank to show only the icon in compact Capture controls.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك الاسم فارغًا لإظهار الأيقونة فقط في عناصر التحكم المضغوطة للالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংক্ষিপ্ত ক্যাপচার কন্ট্রোলে শুধু আইকন দেখাতে নামটি ফাঁকা রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie den Namen leer, um in kompakten Erfassungssteuerelementen nur das Symbol anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the name blank to show only the icon in compact Capture controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el nombre en blanco para mostrar solo el icono en los controles compactos de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez le nom vide pour n’afficher que l’icône dans les commandes de capture compactes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉम्पैक्ट कैप्चर कंट्रोल में केवल आइकन दिखाने के लिए नाम खाली छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan nama kosong untuk hanya menampilkan ikon di kontrol Tangkapan yang ringkas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto il nome per mostrare solo l’icona nei controlli di acquisizione compatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を空欄にすると、コンパクトなキャプチャコントロールではアイコンのみが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간결한 캡처 컨트롤에서 아이콘만 표시하려면 이름을 비워 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de naam leeg om alleen het symbool te tonen in compacte vastlegknoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw nazwę pustą, aby w kompaktowych elementach przechwytywania wyświetlać tylko ikonę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o nome em branco para mostrar apenas o ícone nos controles compactos de captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте имя пустым, чтобы в компактных элементах захвата показывался только значок."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கப் பிடிப்புக் கட்டுப்பாடுகளில் ஐகானை மட்டும் காட்ட பெயரைக் காலியாக விடவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เว้นชื่อว่างไว้เพื่อแสดงเฉพาะไอคอนในตัวควบคุมการจับภาพแบบกะทัดรัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakt Yakalama denetimlerinde yalnızca simgeyi göstermek için adı boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште назву порожньою, щоб у компактних елементах захоплення показувався лише значок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مختصر کیپچر کنٹرولز میں صرف آئیکن دکھانے کے لیے نام خالی چھوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống tên để chỉ hiện biểu tượng trong các điều khiển ghi nhanh thu gọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称留空则在紧凑的采集控制中只显示图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱留空則在精簡的擷取控制項中只顯示圖示。"
          }
        }
      }
    },
