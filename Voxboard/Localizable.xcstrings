        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャのドキュメント上のどこにでもファイルをドラッグすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
