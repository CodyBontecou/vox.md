    "What you sent to a Route today. Tap to open it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما أرسلته إلى مسار اليوم. اضغط لفتحه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ একটি রুটে যা পাঠিয়েছেন। খুলতে ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du heute an eine Route gesendet hast. Zum Öffnen tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you sent to a Route today. Tap to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que has enviado hoy a una ruta. Toca para abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez envoyé à une route aujourd’hui. Touchez pour l’ouvrir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आपने किसी रूट पर क्या भेजा। खोलने के लिए टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang Anda kirim ke Rute hari ini. Ketuk untuk membukanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che hai inviato oggi a un percorso. Tocca per aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日ルートに送った内容。タップして開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 경로로 보낸 내용입니다. 탭하여 엽니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je vandaag naar een route hebt gestuurd. Tik om te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co wysłano dziś do trasy. Stuknij, aby otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você enviou para uma rota hoje. Toque para abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы отправили в маршрут сегодня. Нажмите, чтобы открыть."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று ஒரு வழிக்கு நீங்கள் அனுப்பியவை. திறக்கத் தட்டவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณส่งไปยังเส้นทางวันนี้ แตะเพื่อเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün bir rotaya gönderdikleriniz. Açmak için dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що ви надіслали в маршрут сьогодні. Торкніться, щоб відкрити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج آپ نے کسی روٹ پر کیا بھیجا۔ کھولنے کے لیے ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì bạn đã gửi đến Tuyến hôm nay. Chạm để mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天发送到路线的内容。轻点即可打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天傳送到路線的內容。點一下即可打開。"
          }
        }
      }
    },
