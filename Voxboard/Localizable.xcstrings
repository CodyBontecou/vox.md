    "On — shared with your family group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُفعّل — تتم المشاركة مع مجموعتك العائلية"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু — আপনার ফ্যামিলি গ্রুপের সাথে শেয়ার করা"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An – mit Ihrer Familiengruppe geteilt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On — shared with your family group"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: compartido con tu grupo familiar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé — partagé avec votre groupe familial"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू — आपके फ़ैमिली ग्रुप के साथ शेयर किया गया"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif — dibagikan dengan grup keluarga Anda"
          }
        },
        "it": {
          "stringUnit": {
