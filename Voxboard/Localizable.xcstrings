        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı Yakalama'yı açar ve seçilen Rota ile tamamen aygıtta kayıt yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває «Швидке захоплення» й записує вибраним маршрутом повністю на пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فوری کیپچر کھولتا ہے اور منتخب روٹ کے ساتھ مکمل طور پر آلے پر ریکارڈ کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Ghi nhanh và ghi âm bằng lộ trình đã chọn, hoàn toàn trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开快速采集，并完全在设备上使用所选路线录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開快速擷取，並完全在裝置上使用所選路線錄音。"
          }
        }
      }
