          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestanden toestemming voor ‘%@‘Vervolgd Bewerk de bestemming en selecteer opnieuw de map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki do pozwolenia na »%@„Zakończył się. Edytuj cel i wybierz ponownie jego folder."
