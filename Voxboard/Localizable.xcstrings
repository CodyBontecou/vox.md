          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать любую предварительную настройку, которая в настоящее время выбрана в Capture."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது எடுத்த பதிவை தேர்வு செய்து எழுதலாம்."
          }
        },
        "th": {
