    "Fully hidden. Reopen Vox.md from Spotlight, Finder, or Launchpad to access it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة فتح Vox.md من Spotlight أو Finder أو Launchpad لتسجيل الوصول إليه مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পূর্ণ লুকিয়ে আছে। পুনরায় খোলা Vox.md স্পটলাইট থেকে খুঁজে পেয়েছি, অথবা আবারও লঞ্চ করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständig ausgeblendet. Öffnen Sie Vox.md über Spotlight, den Finder oder das Launchpad, um wieder darauf zuzugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fully hidden. Reopen Vox.md from Spotlight, Finder, or Launchpad to access it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "totalmente ocultos Reabierto Vox.md de la luz, Encuentro , o Launchpad para volver a acceder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "totalement caché. Réouverture Vox.md Avec Spotlight, à trouver, ou launchpad pour y accéder à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी तरह से छिपा हुआ। पुनरारंभ Vox.md Spotlight से खोजें , या फिर से इसे लॉन्च करने के लिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "sepenuhnya tersembunyi Reopen Vox.md dari spotlight, Menemukan , atau launchpad untuk mengaksesnya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto nascosto Riapertura Vox.md di Spotlight, Il Finder, o Launchpad per accedere nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に隠れ 再開 Vox.md Spotlightの、 見つけた、 また、Lunchpad でアクセスできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전히 숨겨져 있는 재개 Vox.md Spotlight에 관해서는, 찾기 또는 다시 접근하기 위해 Launchpad를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledig verborgen heropenen Vox.md van Spotlight, vinden van, of Launchpad om het opnieuw te kunnen gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Całkowicie ukryty ReOpen Vox.md z widokiem na światło, Znalezienie , lub Launchpad, aby ponownie uzyskać dostęp do niego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "totalmente ocultado Reabertura Vox.md Com o Spotlight, Encontrar o ou o Launchpad para acessá-lo novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью скрыт Реабилитация Vox.md В Spotlight, Найти , или Launchpad для повторного доступа к нему."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழுமையாக மறைந்த மீண்டும் திறந்த Vox.md Spotlight இல் தேடினேன் அல்லது மீண்டும் அதைப் பெறலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนอยู่อย่างสมบูรณ์ เปิดซ้ํา Vox.md จาก Spotlight ค้นหา หรือ Launchpad เพื่อเข้าถึงอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamen gizli Yeniden açılıyor Vox.md Spotlight Hakkında, bulmak için, Ya da yeniden açmak için bir başlangıç yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повністю приховані Відкриття Vox.md З точки зору спотсеріалу, знайдений , або завантажити його знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مکمل طور پر چھپایا. دوبارہ کھولنے Vox.md Spotlight سے متعلق تلاش کریں یا پھر دوبارہ اسے لوڈ کرنے کے لئے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn hoàn toàn ReOpen Vox.md Từ Spotlight, Tìm kiếm , hoặc Launchpad để truy cập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全隐藏。 重开 Vox.md 关于Spotlight, 找出, 或者,Lunchpad 再度访问它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完全隱藏。 重開 Vox.md 關於Spotlight, 找出, 或者,Lunchpad 再度訪問它。"
          }
        }
      }
    },
