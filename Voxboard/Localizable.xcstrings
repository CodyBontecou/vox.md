        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка обработки, маршрутов сейфа, форматирования входов, приложений и поведения ретри."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதாவது, கணிதத் துறையில், கணிதத் துறையில், கணிதத் துறையில், கணிதத் துறையில், கணிதத் துறையில், கணிதத் துறையில்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกําหนดค่าการประมวลผลเส้นทางกล่องการจัดรูปแบบการป้อนข้อมูลการแนบมาและพฤติกรรมการรีท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşleme, kuşak rotaları, giriş biçimlendirme, eklenmeler ve retry davranışlarını yapılandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте обробку, маршрути сейфу, форматирование входів, додавання та поведінку перегляду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پروسیسنگ، کوالٹ راؤٹس، انٹرویو فارمیٹنگ، ملحقوں اور ریٹری رویے کو ترتیب دیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình xử lý, đường dẫn vault, định dạng mục nhập, đính kèm và hành vi retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置处理、保险箱路径、输入格式化、附件和重置行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置處理、保險箱路徑、輸入格式化、附件和重置行為。"
          }
        }
      }
    },
