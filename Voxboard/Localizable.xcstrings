    "Choose the Route this Lock Screen widget uses. Leave empty to follow the selected Route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المسار الذي تستخدمه أداة شاشة القفل. اتركه فارغًا لاتباع المسار المحدد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই লক স্ক্রিন উইজেট কোন রুট ব্যবহার করবে বেছে নিন। নির্বাচিত রুট অনুসরণ করতে খালি রাখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Route für dieses Sperrbildschirm-Widget. Leer lassen, um der ausgewählten Route zu folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the Route this Lock Screen widget uses. Leave empty to follow the selected Route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la ruta que usa este widget de la pantalla de bloqueo. Déjalo vacío para seguir la ruta seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la route utilisée par ce widget de l’écran verrouillé. Laissez vide pour suivre la route sélectionnée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि यह लॉक स्क्रीन विजेट कौन-सा रूट उपयोग करे। चयनित रूट का अनुसरण करने के लिए खाली छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih Rute yang digunakan widget Layar Kunci ini. Kosongkan untuk mengikuti Rute yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il percorso usato da questo widget della schermata di blocco. Lascia vuoto per seguire il percorso selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このロック画面ウィジェットで使うルートを選択します。空欄にすると選択中のルートに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 잠금 화면 위젯이 사용할 경로를 선택하세요. 비워 두면 선택된 경로를 따릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de route voor deze toegangsschermwidget. Laat leeg om de geselecteerde route te volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz trasę dla tego widżetu na ekranie blokady. Pozostaw puste, aby używać wybranej trasy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a rota que este widget da Tela Bloqueada usa. Deixe vazio para seguir a rota selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите маршрут для этого виджета на экране блокировки. Оставьте пустым, чтобы использовать выбранный маршрут."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பூட்டுத் திரை விட்ஜெட் பயன்படுத்தும் வழியைத் தேர்வுசெய்க. தேர்ந்தெடுத்த வழியைப் பின்பற்ற காலியாக விடவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเส้นทางที่วิดเจ็ตหน้าจอล็อกนี้ใช้ เว้นว่างไว้เพื่อใช้เส้นทางที่เลือกอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Kilit Ekranı widget’ının kullanacağı rotayı seçin. Seçili rotayı izlemek için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть маршрут для цього віджета на замкненому екрані. Залиште порожнім, щоб використовувати вибраний маршрут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ لاک اسکرین ویجیٹ کون سا روٹ استعمال کرے، منتخب کریں۔ منتخب روٹ کی پیروی کے لیے خالی چھوڑ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Tuyến mà tiện ích Màn hình khóa này dùng. Để trống để theo Tuyến đang chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择此锁定屏幕小组件使用的路线。留空则跟随所选路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇此鎖定畫面小工具使用的路線。留空則依照所選路線。"
          }
        }
      }
    },
