        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限次设备端转录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無限次裝置端轉錄"
          }
        }
      }
