    "Builds Markdown meeting notes with useful sections and grounded action items from typed text, OCR, or voice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُدخل ملاحظات المؤتمر Markdown مع أجزاء مفيدة ومواقع العمل المرتبطة بالرسائل من النص المكتوب أو OCR أو صوت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্মাণ Markdown উপকারী বিভাগ এবং টাইপ করা পাঠ্য থেকে ভূমি কার্যকলাপ আইটেম সঙ্গে মিটিং নোট, অক্লান্ত বা কণ্ঠ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt Markdown-Besprechungsnotizen mit nützlichen Abschnitten und belegten Aktionspunkten aus getipptem Text, OCR oder Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds Markdown meeting notes with useful sections and grounded action items from typed text, OCR, or voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye Markdown Notas de reunión con secciones útiles y elementos de acción fundamentados de texto tipado, OCR  o la voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "bâtiments Markdown notes de réunion avec des sections utiles et des éléments d'action fondés à partir du texte tapé, OCR , ou de voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्माण Markdown उपयोगी अनुभागों और टाइप किए गए पाठ से आधारित कार्य आइटम के साथ बैठक नोट, ओसीआर या आवाज।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangunan Markdown catatan pertemuan dengan bagian yang berguna dan item tindakan yang didasarkan dari teks yang ditulis, OCR yang atau suara"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "costruzioni Markdown note di riunione con sezioni utili e elementi di azione fondati da testo digitato, di OCR, o la voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "建物 Markdown 役に立つセクションと、入力されたテキストから根付いたアクションアイテムを含む会議ノート OCR、 あるいは声。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건축 Markdown 유용한 섹션과 입력된 텍스트에서 토대로 된 액션 항목을 포함한 회의 메모, meeting notes with useful sections and grounded action items from typed text. OCR 를, 또는 목소리"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bouwen Markdown vergadernotes met nuttige secties en geaard actie-items uit ingevoerde tekst, OCR Of een stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "buduje Markdown notatki z przydatnymi sekcjami i elementami akcji uziemionymi z tekstu wpisanego, OCR lub głosem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Construções Markdown Notas de reunião com seções úteis e itens de ação baseados a partir de texto digitado, OCR Ou a voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "строить Markdown Заметки о встречах с полезными разделами и элементами действий, заложенными из введенного текста, ОКР , Или голос"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படைத்தல் Markdown அதாவது, அங்குள்ள பல்வேறு வகையான கடிதங்கள் மற்றும் பதிவுகள், OCR அளவு அல்லது Voice"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาคาร Markdown หมายเหตุการประชุมที่มีส่วนที่เป็นประโยชน์และรายการการกระทําที่สร้างพื้นฐานจากข้อความที่พิมพ์ OCR หรือเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "inşaat Markdown Yazılan metinlerden yararlı bölümler ve temel eylem öğeleri ile toplantı notları, OCR için, ya da ses."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будівництво Markdown Зазначення з корисними розділами та елементами дій, заснованими на вказаному тексті, ОКР , або голос"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمیر Markdown مفید حصوں اور ڈھانچے سے کام کرنے والے دستاویزات کے ساتھ ملاقات نوٹ، OCR کے یا آواز"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "xây Markdown Ghi chú cuộc họp với các phần hữu ích và các mục hành động dựa trên từ văn bản đã gõ, OCR thì hay giọng nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建 Markdown 会面笔记有用的部分和从输入文本中建立的基准操作项目, 奥克尔, 或声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
