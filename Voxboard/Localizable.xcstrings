    "Top inserts directly beneath the heading. Bottom appends to the end of the heading’s section, before the next heading.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«الأعلى» يُدرج مباشرةً أسفل العنوان. «الأسفل» يُلحق بنهاية قسم العنوان، قبل العنوان التالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "‘উপরে’ সরাসরি শিরোনামের নিচে যোগ করে। ‘নিচে’ পরবর্তী শিরোনামের আগে, শিরোনামের অংশের শেষে যোগ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Oben“ fügt direkt unter der Überschrift ein. „Unten“ hängt am Ende des Abschnitts der Überschrift an, vor der nächsten Überschrift."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top inserts directly beneath the heading. Bottom appends to the end of the heading’s section, before the next heading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba inserta justo debajo del encabezado. Abajo añade al final de la sección del encabezado, antes del siguiente encabezado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En haut insère directement sous le titre. En bas ajoute à la fin de la section du titre, avant le titre suivant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर विकल्प हेडिंग के ठीक नीचे जोड़ता है। नीचे विकल्प हेडिंग के सेक्शन के अंत में, अगली हेडिंग से पहले जोड़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atas menyisipkan langsung di bawah judul. Bawah menambahkan ke akhir bagian judul, sebelum judul berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In alto inserisce subito sotto l’intestazione. In basso aggiunge alla fine della sezione dell’intestazione, prima dell’intestazione successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「上」は見出しのすぐ下に挿入します。「下」は見出しのセクションの末尾、次の見出しの前に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘위’는 제목 바로 아래에 삽입합니다. ‘아래’는 다음 제목 앞, 해당 제목 섹션의 끝에 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Boven’ voegt direct onder de kop in. ‘Onder’ voegt toe aan het einde van de sectie van de kop, vóór de volgende kop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Góra wstawia bezpośrednio pod nagłówkiem. Dół dodaje na końcu sekcji nagłówka, przed następnym nagłówkiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Topo insere logo abaixo do título. Final adiciona ao fim da seção do título, antes do próximo título."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Вверху» вставляет сразу под заголовком. «Внизу» добавляет в конец раздела заголовка, перед следующим заголовком."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேல் என்பது தலைப்புக்குக் கீழே நேரடியாகச் செருகும். கீழ் என்பது அடுத்த தலைப்புக்கு முன், தலைப்பின் பிரிவின் இறுதியில் சேர்க்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้านบนจะแทรกไว้ใต้หัวข้อโดยตรง ด้านล่างจะต่อท้ายส่วนของหัวข้อ ก่อนหัวข้อถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst, doğrudan başlığın altına ekler. Alt, bir sonraki başlıktan önce, başlığın bölümünün sonuna ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Угорі» вставляє одразу під заголовком. «Унизу» додає в кінець розділу заголовка, перед наступним заголовком."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوپر سرخی کے بالکل نیچے داخل کرتا ہے۔ نیچے سرخی کے سیکشن کے آخر میں، اگلی سرخی سے پہلے شامل کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên cùng chèn ngay bên dưới tiêu đề. Dưới cùng thêm vào cuối phần của tiêu đề, trước tiêu đề tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“顶部”会直接插入在标题下方。“底部”会追加到该标题部分的末尾、下一个标题之前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「頂部」會直接插入在標題下方。「底部」會附加到該標題段落的結尾、下一個標題之前。"
          }
        }
      }
    },
