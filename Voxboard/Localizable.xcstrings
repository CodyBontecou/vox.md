        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu ghi vào bản nháp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始录音到草稿"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始錄音到草稿"
          }
        }
      }
    },
    "Start recording without switching apps": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء التسجيل دون تبديل التطبيقات"
