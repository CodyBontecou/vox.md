        }
      }
    },
    "Pick a vault and routes in Vox.md on your iPhone, then they appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر خزنة ومسارات في Vox.md على iPhone، وستظهر هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone-এর Vox.md-এ একটি ভল্ট ও রুট বেছে নিন, তারপর সেগুলো এখানে দেখাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Vault und Routen in Vox.md auf deinem iPhone – dann erscheinen sie hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a vault and routes in Vox.md on your iPhone, then they appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un vault y rutas en Vox.md en tu iPhone y aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un coffre et des routes dans Vox.md sur votre iPhone : ils apparaîtront ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone पर Vox.md में वॉल्ट और रूट चुनें, फिर वे यहाँ दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih vault dan rute di Vox.md pada iPhone, lalu semuanya muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un vault e i percorsi in Vox.md sull’iPhone: appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone の Vox.md で保管庫とルートを選ぶと、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 Vox.md에서 보관소와 경로를 선택하면 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een kluis en routes in Vox.md op je iPhone, dan verschijnen ze hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sejf i trasy w Vox.md na iPhone — pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um cofre e rotas no Vox.md do iPhone e eles aparecerão aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите хранилище и маршруты в Vox.md на iPhone — они появятся здесь."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் iPhone-இல் உள்ள Vox.md-இல் ஒரு வால்ட் மற்றும் வழிகளைத் தேர்வுசெய்தால் அவை இங்கே தோன்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกคลังและเส้นทางใน Vox.md บน iPhone แล้วจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’daki Vox.md’de bir kasa ve rotalar seçin; burada görünürler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть сховище й маршрути у Vox.md на iPhone — вони з’являться тут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے iPhone پر Vox.md میں والٹ اور روٹس منتخب کریں، پھر وہ یہاں نظر آئیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn kho và tuyến trong Vox.md trên iPhone, rồi chúng sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上的 Vox.md 中选择资料库和路线后，它们会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上的 Vox.md 中選擇資料庫和路線後，它們會顯示在這裡。"
          }
        }
      }
    },
    "Preserves existing background start/stop assignments. For new controls, use Vox.md Record and configure Action and Open App.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ على تعيينات البدء/الإيقاف الحالية في الخلفية. لعناصر التحكم الجديدة استخدم Vox.md Record واضبط «الإجراء» و«فتح التطبيق»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিদ্যমান ব্যাকগ্রাউন্ড শুরু/বন্ধ নির্ধারণ বজায় রাখে। নতুন কন্ট্রোলের জন্য Vox.md Record ব্যবহার করে অ্যাকশন ও অ্যাপ খুলুন সেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält bestehende Hintergrund-Start/Stopp-Zuweisungen bei. Verwende für neue Steuerungen „Vox.md Record“ und lege Aktion und App öffnen fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserves existing background start/stop assignments. For new controls, use Vox.md Record and configure Action and Open App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva las asignaciones existentes de inicio/parada en segundo plano. Para controles nuevos, usa Vox.md Record y configura Acción y Abrir app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les attributions existantes de démarrage/arrêt en arrière-plan. Pour les nouveaux contrôles, utilisez Vox.md Record et configurez Action et Ouvrir l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा बैकग्राउंड शुरू/रोकें असाइनमेंट बनाए रखता है। नए कंट्रोल के लिए Vox.md Record उपयोग करें और कार्रवाई व ऐप खोलें सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mempertahankan penetapan mulai/berhenti latar belakang yang ada. Untuk kontrol baru, gunakan Vox.md Record lalu atur Tindakan dan Buka App."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene le assegnazioni esistenti di avvio/interruzione in background. Per i nuovi controlli usa Vox.md Record e configura Azione e Apri app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のバックグラウンド開始/停止の割り当てを保持します。新しいコントロールでは Vox.md Record を使い、「アクション」と「アプリを開く」を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 백그라운드 시작/중지 할당을 유지합니다. 새 제어 항목에는 Vox.md Record를 사용하고 동작과 앱 열기를 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoudt bestaande start/stop-toewijzingen op de achtergrond. Gebruik voor nieuwe regelaars Vox.md Record en stel Actie en Open app in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje istniejące przypisania start/stop w tle. Dla nowych elementów użyj Vox.md Record i ustaw Akcję oraz Otwórz aplikację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva as atribuições existentes de iniciar/parar em segundo plano. Para novos controles, use o Vox.md Record e configure Ação e Abrir app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет существующие фоновые назначения старт/стоп. Для новых элементов используйте Vox.md Record и настройте «Действие» и «Открыть приложение»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்கனவேயுள்ள பின்னணி தொடக்க/நிறுத்த ஒதுக்கீடுகளைப் பாதுகாக்கும். புதிய கட்டுப்பாடுகளுக்கு Vox.md Record-ஐப் பயன்படுத்தி செயல் மற்றும் ஆப்பைத் திற அமைக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คงการกำหนดเริ่ม/หยุดเบื้องหลังที่มีอยู่ไว้ สำหรับตัวควบคุมใหม่ ให้ใช้ Vox.md Record แล้วตั้งค่า การทำงาน และ เปิดแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut arka plan başlat/durdur atamalarını korur. Yeni denetimler için Vox.md Record’u kullanıp Eylem ve Uygulamayı aç’ı ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає наявні фонові призначення старт/стоп. Для нових елементів використовуйте Vox.md Record і налаштуйте «Дія» та «Відкрити програму»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ بیک گراؤنڈ شروع/روکیں تفویضات برقرار رکھتا ہے۔ نئے کنٹرولز کے لیے Vox.md Record استعمال کریں اور کارروائی اور ایپ کھولیں ترتیب دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nguyên các gán bắt đầu/dừng nền hiện có. Với điều khiển mới, dùng Vox.md Record rồi cấu hình Tác vụ và Mở ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留现有的后台开始/停止分配。新控制请使用 Vox.md Record，并配置“操作”和“打开 App”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留現有的背景開始／停止指派。新控制項目請使用 Vox.md Record，並設定「動作」和「打開 App」。"
          }
        }
      }
    },
