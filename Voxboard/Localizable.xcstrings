    "What needs doing?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي يجب إنجازه؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী করতে হবে?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist zu tun?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What needs doing?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué hay que hacer?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que faut-il faire ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या करना है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang perlu dikerjakan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa c’è da fare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やるべきことは？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해야 할 일은 무엇인가요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat moet er gebeuren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co trzeba zrobić?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que precisa ser feito?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что нужно сделать?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்ன செய்ய வேண்டும்?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีอะไรต้องทำบ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne yapılması gerekiyor?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що треба зробити?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا کرنا ہے؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần làm gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有什么需要做？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有什麼需要做？"
          }
        }
      }
    },
    "What was captured, where it went and how the route handled it shows here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر هنا ما تم التقاطه، وإلى أين ذهب، وكيف عالجه المسار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী ক্যাপচার হয়েছে, কোথায় গেছে এবং রুট কীভাবে এটি পরিচালনা করেছে তা এখানে দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier sehen Sie, was erfasst wurde, wohin es ging und wie die Route damit umgegangen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was captured, where it went and how the route handled it shows here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se muestra qué se capturó, adónde se envió y cómo lo procesó la ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui a été capturé, où cela a été envoyé et comment le parcours l’a traité s’affiche ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या कैप्चर किया गया, वह कहाँ गया और रूट ने उसे कैसे संभाला, यह यहाँ दिखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ditangkap, ke mana perginya, dan bagaimana rute menanganinya akan ditampilkan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui vedi cosa è stato acquisito, dove è stato inviato e come lo ha gestito il percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャされた内容、配信先、ルートでの処理内容がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처된 내용, 전달된 위치, 루트의 처리 방식이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier zie je wat er is vastgelegd, waar het naartoe ging en hoe de route het heeft verwerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj zobaczysz, co zostało przechwycone, dokąd trafiło i jak obsłużyła to trasa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui aparece o que foi capturado, para onde foi e como a rota o processou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь показано, что было захвачено, куда отправлено и как маршрут это обработал."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எது பிடிக்கப்பட்டது, எங்கு சென்றது, வழித்தடம் அதை எவ்வாறு கையாண்டது என்பது இங்கே காண்பிக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่จับภาพไว้ ส่งไปที่ใด และเส้นทางจัดการอย่างไร จะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyin yakalandığı, nereye gittiği ve rotanın onu nasıl işlediği burada gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут показано, що було захоплено, куди надіслано і як маршрут це обробив."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا کیپچر ہوا، کہاں گیا اور روٹ نے اسے کیسے سنبھالا، یہاں دکھایا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung đã ghi, nơi được gửi đến và cách lộ trình xử lý sẽ hiển thị ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里会显示采集了什么内容、送往何处以及路线如何处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡會顯示擷取了什麼內容、送往何處，以及路線如何處理。"
          }
        }
      }
    },
