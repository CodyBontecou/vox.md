    "Record or send a Capture and its progress will appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل أو أرسل التقاطًا وسيظهر تقدمه هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ক্যাপচার রেকর্ড করুন বা পাঠান, এর অগ্রগতি এখানে দেখা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehmen Sie eine Erfassung auf oder senden Sie eine, und ihr Fortschritt erscheint hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record or send a Capture and its progress will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba o envía una captura y su progreso aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ou envoyez une capture : sa progression apparaîtra ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कैप्चर रिकॉर्ड करें या भेजें, उसकी प्रगति यहाँ दिखेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam atau kirim Tangkapan dan progresnya akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra o invia un’acquisizione e il suo avanzamento apparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャを録音または送信すると、その進行状況がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처를 녹음하거나 보내면 진행 상황이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een vastlegging op of verstuur er een, dan verschijnt de voortgang hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj lub wyślij przechwycenie, a jego postęp pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave ou envie uma captura e o progresso aparecerá aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите или отправьте захват, и здесь появится его ход выполнения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பிடிப்பைப் பதிவுசெய்யவும் அல்லது அனுப்பவும், அதன் முன்னேற்றம் இங்கே தோன்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกหรือส่งการจับภาพ แล้วความคืบหน้าจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Yakalama kaydedin veya gönderin; ilerlemesi burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть або надішліть захоплення, і тут з’явиться його перебіг."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر ریکارڈ کریں یا بھیجیں اور اس کی پیش رفت یہاں دکھائی دے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm hoặc gửi một bản ghi nhanh và tiến trình sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音或发送一个采集，其进度将显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音或傳送一個擷取，其進度會顯示在這裡。"
          }
        }
      }
    },
