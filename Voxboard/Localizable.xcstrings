    "Safely queued and waiting to process.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في حالة تأهب وحين انتظار عملية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিরাপদে অপেক্ষা করে মামলায় দাঁড়িয়ে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicher in der Warteschlange und wartet auf Verarbeitung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safely queued and waiting to process."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguramente en la cola y esperando el proceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sécurisé et en attente de procès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित रूप से लाइन में और प्रक्रिया के लिए इंतजार कर रहे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan dan menunggu proses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In sicurezza e in attesa di un processo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に待機して、待機する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하게 좌석을 닫고 재판을 기다립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veilig in de rij en wachten op proces."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpiecznie w kolejce i czekając na proces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguro e aguardando o processo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безопасно зарезервированы и ждут процесса."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதுகாப்பாக காத்திருப்பதாகவும், வழக்கு விசாரணை நடத்தப்படும் எனவும் கூறப்படுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอบพร้อมกันและรอการกระบวนการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli bir şekilde bekliyor ve işlem yapıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишається в черзі і чекає на процес."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ رہیں اور عمل کے لئے انتظار کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "An toàn và chờ đợi để xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全排队等待进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全排隊等待進程。"
          }
        }
      }
    },
    "Safely queued on iPhone and waiting to process.": {
      "localizations": {
