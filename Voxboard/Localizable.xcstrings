    "Image descriptions are unavailable in this app language.": {
      "comment": "On-device image descriptions: preset control, help, availability, or capture progress.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوصاف الصور غير متاحة بلغة التطبيق هذه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপের এই ভাষায় ছবির বর্ণনা উপলভ্য নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildbeschreibungen sind in dieser App-Sprache nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image descriptions are unavailable in this app language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descripciones de imágenes no están disponibles en este idioma de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les descriptions d’images ne sont pas disponibles dans cette langue de l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप की इस भाषा में छवि विवरण उपलब्ध नहीं हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsi gambar tidak tersedia dalam bahasa aplikasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le descrizioni delle immagini non sono disponibili in questa lingua dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの言語では画像の説明を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 언어에서는 이미지 설명을 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbeeldingsbeschrijvingen zijn niet beschikbaar in deze apptaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisy obrazów są niedostępne w tym języku aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As descrições de imagens não estão disponíveis neste idioma do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Описания изображений недоступны на этом языке приложения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்பாட்டின் இந்த மொழியில் பட விளக்கங்கள் கிடைக்கவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำอธิบายรูปภาพไม่พร้อมใช้งานในภาษาของแอปนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü açıklamaları uygulamanın bu dilinde kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Описи зображень недоступні цією мовою програми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کی اس زبان میں تصاویر کی وضاحتیں دستیاب نہیں ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả ảnh không khả dụng trong ngôn ngữ ứng dụng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 App 语言不支持图像描述。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的 App 語言不支援影像描述。"
          }
        }
      }
    },
    "Image descriptions require a device that supports Apple Intelligence.": {
      "comment": "On-device image descriptions: preset control, help, availability, or capture progress.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب أوصاف الصور جهازًا يدعم Apple Intelligence."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবির বর্ণনার জন্য Apple Intelligence সমর্থিত ডিভাইস প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildbeschreibungen erfordern ein Gerät, das Apple Intelligence unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image descriptions require a device that supports Apple Intelligence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descripciones de imágenes requieren un dispositivo compatible con Apple Intelligence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les descriptions d’images nécessitent un appareil compatible avec Apple Intelligence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि विवरण के लिए Apple Intelligence समर्थित डिवाइस चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsi gambar memerlukan perangkat yang mendukung Apple Intelligence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le descrizioni delle immagini richiedono un dispositivo compatibile con Apple Intelligence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の説明にはApple Intelligence対応デバイスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 설명에는 Apple Intelligence를 지원하는 기기가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbeeldingsbeschrijvingen vereisen een apparaat dat Apple Intelligence ondersteunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisy obrazów wymagają urządzenia obsługującego Apple Intelligence."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As descrições de imagens exigem um dispositivo compatível com Apple Intelligence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для описания изображений требуется устройство с поддержкой Apple Intelligence."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பட விளக்கங்களுக்கு Apple Intelligence ஐ ஆதரிக்கும் சாதனம் தேவை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำอธิบายรูปภาพต้องใช้อุปกรณ์ที่รองรับ Apple Intelligence"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü açıklamaları Apple Intelligence destekleyen bir aygıt gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для опису зображень потрібен пристрій із підтримкою Apple Intelligence."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
