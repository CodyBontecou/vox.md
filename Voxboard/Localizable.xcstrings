    "Recovered after Vox.md was interrupted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت الاستعادة بعد مقاطعة Vox.md."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md বাধাগ্রস্ত হওয়ার পরে পুনরুদ্ধার করা হয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einer Unterbrechung von Vox.md wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovered after Vox.md was interrupted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperada tras una interrupción de Vox.md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupéré après une interruption de Vox.md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md में रुकावट आने के बाद रिकवर किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipulihkan setelah Vox.md terganggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperata dopo un’interruzione di Vox.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.mdが中断されたあとに復元しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md가 중단된 후 복구되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hersteld nadat Vox.md werd onderbroken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odzyskano po przerwaniu działania Vox.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperada após o Vox.md ser interrompido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановлено после прерывания Vox.md."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md இடைநிறுத்தப்பட்ட பிறகு மீட்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนแล้วหลังจาก Vox.md ถูกขัดจังหวะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md kesintiye uğradıktan sonra kurtarıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлено після переривання Vox.md."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md میں رکاوٹ کے بعد بازیافت ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục sau khi Vox.md bị gián đoạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Vox.md 中断后恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Vox.md 中斷後復原。"
          }
        }
      }
    },
    "Recovered after an interrupted save. Choose a Route to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت الاستعادة بعد حفظ متقطع. اختر مسارًا للمتابعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাধাগ্রস্ত সেভের পরে পুনরুদ্ধার করা হয়েছে। চালিয়ে যেতে একটি রুট বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem unterbrochenen Sichern wiederhergestellt. Wählen Sie eine Route, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovered after an interrupted save. Choose a Route to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperada tras un guardado interrumpido. Elige una ruta para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupéré après un enregistrement interrompu. Choisissez un parcours pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने में रुकावट के बाद रिकवर किया गया। जारी रखने के लिए रूट चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipulihkan setelah penyimpanan terganggu. Pilih Rute untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperata dopo un salvataggio interrotto. Scegli un percorso per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断された保存から復元しました。続けるにはルートを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단된 저장에서 복구되었습니다. 계속하려면 루트를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hersteld na een onderbroken bewaaractie. Kies een route om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odzyskano po przerwanym zapisie. Wybierz trasę, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperada após um salvamento interrompido. Escolha uma rota para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановлено после прерванного сохранения. Выберите маршрут, чтобы продолжить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடைநின்ற சேமிப்புக்குப் பிறகு மீட்கப்பட்டது. தொடர ஒரு வழித்தடத்தைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนแล้วหลังจากการบันทึกถูกขัดจังหวะ เลือกเส้นทางเพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesintiye uğrayan bir kaydetmeden sonra kurtarıldı. Devam etmek için bir Rota seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлено після перерваного збереження. Виберіть маршрут, щоб продовжити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رکاوٹ والی محفوظ کاری کے بعد بازیافت ہوا۔ جاری رکھنے کے لیے روٹ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục sau khi việc lưu bị gián đoạn. Chọn một lộ trình để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在保存中断后恢复。选择一条路线以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在儲存中斷後復原。選擇一條路線以繼續。"
          }
        }
      }
    },
