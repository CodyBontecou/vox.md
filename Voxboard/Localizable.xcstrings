    "Opens an email draft to contact support with app diagnostics": {
      "comment": "Accessibility hint for the Send Feedback button",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح مسودة بريد إلكتروني للتواصل مع الدعم مع تشخيصات التطبيق"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ ডায়াগনস্টিকসসহ সহায়তার সাথে যোগাযোগের জন্য একটি ইমেইল খসড়া খুলে দেয়"
          }
