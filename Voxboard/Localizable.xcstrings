    "Your trial has ended. See plans to capture again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت فترتك التجريبية. اعرض الخطط لتلتقط مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ট্রায়াল শেষ হয়েছে। আবার ক্যাপচার করতে প্ল্যান দেখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Testzeitraum ist abgelaufen. Sieh dir die Pläne an, um wieder zu erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial has ended. See plans to capture again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba ha terminado. Consulta los planes para volver a capturar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai est terminé. Consultez les formules pour capturer à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका ट्रायल समाप्त हो गया। फिर से कैप्चर करने के लिए प्लान देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa uji coba Anda telah berakhir. Lihat paket untuk menangkap lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova è terminata. Consulta i piani per acquisire di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアルが終了しました。もう一度キャプチャするにはプランをご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 기간이 종료되었습니다. 다시 캡처하려면 요금제를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je proefperiode is afgelopen. Bekijk de abonnementen om weer vast te leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okres próbny się zakończył. Zobacz plany, aby znów przechwytywać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste terminou. Veja os planos para capturar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробный период закончился. Посмотрите планы, чтобы снова записывать."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சோதனைக் காலம் முடிந்தது. மீண்டும் பிடிக்கத் திட்டங்களைப் பாருங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงทดลองใช้สิ้นสุดแล้ว ดูแผนเพื่อจับภาพอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme süreniz sona erdi. Yeniden yakalamak için planlara göz atın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пробний період завершився. Перегляньте плани, щоб знову записувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ٹرائل ختم ہو گیا۔ دوبارہ کیپچر کرنے کے لیے پلانز دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dùng thử đã kết thúc. Xem các gói để ghi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的试用期已结束。查看方案以继续捕捉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的試用期已結束。查看方案以繼續擷取。"
          }
        }
      }
    },
