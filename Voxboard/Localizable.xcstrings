          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech for live text. Download a local model below to use as its fallback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech para el texto en vivo. Descarga un modelo local abajo para usarlo como alternativa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Speech pour le texte en direct. Téléchargez un modèle local ci-dessous comme solution de repli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव टेक्स्ट के लिए Apple Speech। इसके विकल्प के रूप में उपयोग करने के लिए नीचे कोई स्थानीय मॉडल डाउनलोड करें।"
