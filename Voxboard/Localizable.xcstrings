          }
        }
      }
    },
    "Turns captured tasks into `- [ ]` Markdown items without inventing new work. A deterministic local fallback is always available.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل المهام المكتوبة إلى عناصر `- [ ]` Markdown دون اختراع عمل جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জড়িত কাজগুলোকে বদলে দেয় `- [ ]` Markdown নতুন কাজের আবিষ্কার না করেই। একটি নির্দিষ্ট স্থানীয় ফ্যালব্যাক সবসময় উপলব্ধ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelt erfasste Aufgaben in `- [ ]`-Markdown-Punkte um, ohne neue Aufgaben zu erfinden. Ein deterministischer lokaler Fallback ist immer verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns captured tasks into `- [ ]` Markdown items without inventing new work. A deterministic local fallback is always available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma las tareas capturadas en `- [ ]` Markdown de los trabajos sin inventar nuevos. Un retroceso determinista local siempre está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformer les tâches en `- [ ]` Markdown des objets sans inventer de nouveaux ouvrages. Un déterminisme local est toujours disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संभालने वाले कार्यों को बदलते हैं `- [ ]` Markdown नए काम की खोज के बिना। एक निर्धारित स्थानीय प्लैपबैक हमेशा उपलब्ध है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah tugas yang ditempuh menjadi `- [ ]` Markdown Berbagai hal tanpa mengembangkan karya baru. Sebuah determinist lokal fallback selalu tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "trasforma i compiti in `- [ ]` Markdown senza inventare nuovi lavori. Un fallback locale deterministico è sempre disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "捕獲されたタスクを変える `- [ ]` Markdown 新しい作品を発明することなく、 決定的地元の倒産は常に利用可能である。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처된 작업을 변환 `- [ ]` Markdown 새로운 작품을 발명하지 않고도 결정적인 지역 낙관은 항상 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang de opgaven die in `- [ ]` Markdown Zonder nieuwe werken uit te vinden. Een deterministische lokale fallback is altijd beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekształca zadania w `- [ ]` Markdown Nie wymyślając nowych prac. Lokalny deterministyczny spadek jest zawsze dostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformar tarefas capturadas em `- [ ]` Markdown de trabalho sem inventar novos trabalhos. Um determinista local de falha está sempre disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превращает захваченные задачи в `- [ ]` Markdown Изобретать без изобретения новых работ. Детерминистский локальный отступление всегда доступен."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமித்த வேலைகளை மாற்ற `- [ ]` Markdown புதிய வேலைகளைத் தேடிப் போகும்போது ஒரு Deterministic Local Fallback எப்போதும் கிடைக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลงงานที่จับไว้ใน `- [ ]` Markdown สิ่งที่ไม่มีการคิดค้นงานใหม่ การลดลงของความผิดปกติในท้องถิ่นเป็นไปได้เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevleri yakalamak için `- [ ]` Markdown Yeni işler yaratmadan yeni işler üretmek. Determinist bir yerel geri dönüş her zaman mevcuttur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетворює зайняті завдання на `- [ ]` Markdown Виробництво без винайдення нових робіт. Детерміністичний локальний відступ завжди доступний."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاموں کو تبدیل کرنے کے لئے `- [ ]` Markdown نئے کام کے بغیر کچھ بھی نہیں ہے. ایک مقررہ مقامی فالوگ ہمیشہ دستیاب ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển các nhiệm vụ bị bắt thành `- [ ]` Markdown Những công việc không phải là phát minh ra công việc mới. Một sự suy giảm địa phương xác định luôn có sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将被捕获的任务转化为 `- [ ]` Markdown 没有发明新工作。 一个确定性的本地倒退总是可用的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將被捕獲的任務轉化為 `- [ ]` Markdown 沒有發明新工作。 一個確定性的本地倒退總是可用的。"
          }
        }
      }
    },
