    "Prevents duplicate entries when delivery is retried. This adds a vox-capture HTML comment to each captured entry, which may be visible while editing Markdown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع التسجيلات المتكررة عند إعادة توزيعها.هذا يضاف تعليق HTML فيديويًا لكل تسجيل تم تسجيله، والذي قد يكون مرئيًا أثناء تعديل Markdown."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাবল ইন্টারনেট প্রেরণ করা হয় যখন ডেলিভারি পুনরায়। এটি প্রতিটি ক্যাপচারিত নিবন্ধে একটি vox-capture HTML মন্তব্য যোগ করে, যা প্রদর্শনীতে দেখা যাবে। Markdown."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert doppelte Einträge bei wiederholter Zustellung. Dabei wird jedem erfassten Eintrag ein vox-capture-HTML-Kommentar hinzugefügt, der beim Bearbeiten von Markdown sichtbar sein kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevents duplicate entries when delivery is retried. This adds a vox-capture HTML comment to each captured entry, which may be visible while editing Markdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita duplicar entradas cuando se retira la entrega. Esto añade un comentario HTML de captura de vox a cada entrada capturada, que puede ser visible durante la edición Markdown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évite les doubles entrées lorsqu’une livraison est retardée. Cela ajoute un commentaire HTML de capture de vox à chaque entrée capturée, qui peut être visible lors de l'édition Markdown."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिलीवरी के बाद दोहराव दर्ज करने से रोकता है। यह प्रत्येक कैप्चर किए गए प्रविष्टि में एक vox-capture HTML टिप्पणी जोड़ता है, जो कि संपादित करते समय दिखाई दे सकता है Markdown."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghindari duplikasi ketika pengiriman dilakukan. Ini menambahkan komentar HTML vox-capture ke setiap entri yang ditangkap, yang dapat dilihat saat mengedit Markdown."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la duplicazione delle voci quando la consegna viene ritardata. Questo aggiunge un commento HTML di cattura vox a ogni voce catturata, che può essere visibile durante l'editing Markdown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配送が再開されたときに二重入力を防ぐ。 これにより、キャプチャされた各エントリにvox-capture HTML コメントを追加します。 編集の際に見られるもの Markdown."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배달이 재개될 때 두 배의 항목을 방지합니다. 이렇게 하면 각 캡처된 항목에 vox-capture HTML 코멘트를 추가합니다.This adds a vox-capture HTML comment to each captured 를 쓸 때 볼 수 있는 Markdown."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijdt dubbele invoer wanneer de levering wordt herhaald. Hiermee wordt een vox-capture HTML-commentaar toegevoegd aan elke vastgelegde post, die tijdens het bewerken zichtbaar kan zijn Markdown."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapobiega powielaniu wpisów podczas odwoływania dostawy. Dodaj komentarz HTML do każdego zarejestrowanego wpisu, które mogą być widoczne podczas edycji Markdown."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita duplicar as entradas quando a entrega é retardada. Isso adiciona um comentário HTML de captura de vox a cada entrada capturada, que pode ser visto durante a edição Markdown."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предотвращает дублирование записей при переносе доставки. Это добавляет комментарий HTML для вокс-захватывания к каждому захваченному вводу, которые могут быть видны при редактировании Markdown."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இரண்டாம் வகுப்பு வரைக்கும், மீண்டும் வகுப்புக்கு வரலாம். இந்தப் பதிவில், ஒரு HTML comment-ஐ vox-capture-ஐ சேர்க்கவும். எழுதப்பட்டால் பார்க்கப்படும் Markdown."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้องกันการเข้าสู่ระบบซ้ําเมื่อจัดส่งถอน นี้จะเพิ่มความคิดเห็น HTML vox-capture ไปยังแต่ละรายการที่จับภาพ ซึ่งสามารถมองเห็นได้ในขณะที่แก้ไข Markdown."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teslimat iptal edildiğinde çift katmanlı girişleri önler. Bu, yakalanan her giriş için bir vox-capture HTML yorumunu ekler, Görünürde görülebilir bir düzenleme Markdown."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забороняється дублювання записів при відстрочанні доставки. Це додає коментар HTML-вокс-захоплення до кожного захопленого входу, які можуть бути помітні під час редагування Markdown."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈبلکٹ درجے کو روکتا ہے جب ترسیل کی واپسی ہوتی ہے. یہ ہر پکڑنے والی داخلہ پر ایک vox-capture HTML تبصرہ شامل کرتا ہے، جو بھی ہو سکتا ہے دیکھنے کے لئے Markdown."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tránh các mục nhập trùng lặp khi giao hàng được trì hoãn. Điều này thêm một bình luận HTML vox-capture vào mỗi mục nhập được chụp, có thể được nhìn thấy trong khi chỉnh sửa Markdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免在交付延迟时重复输入。 这样,每一个被捕获的条目都会添加一个 vox-capture HTML 评论。 可以看见的,当编辑时。 Markdown."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免在交付延遲時重複輸入。 這樣,每一個被捕獲的條目都會添加一個 vox-capture HTML 評論。 可以看見的,當編輯時。 Markdown."
          }
        }
      }
    },
