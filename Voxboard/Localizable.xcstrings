        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও ও লাইভ ট্রান্সক্রিপ্ট ডিলিট করা হবে। কিছুই পাঠানো হবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio und das Live-Transkript werden gelöscht. Es wird nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio and live transcript are deleted. Nothing is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan el audio y la transcripción en vivo. No se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio et la transcription en direct sont supprimés. Rien n’est envoyé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो और लाइव ट्रांसक्रिप्ट डिलीट कर दिए जाते हैं। कुछ भी नहीं भेजा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio dan transkrip langsung dihapus. Tidak ada yang dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio e la trascrizione in tempo reale vengono eliminati. Non viene inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオとライブ文字起こしは削除されます。何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오와 실시간 전사본이 삭제됩니다. 아무것도 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audio en het live-transcript worden verwijderd. Er wordt niets verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio i transkrypcja na żywo zostaną usunięte. Nic nie zostanie wysłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio e a transcrição ao vivo são apagados. Nada é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио и транскрипт будут удалены. Ничего не отправляется."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒலியும் நேரலை உரைப்படியும் நீக்கப்படும். எதுவும் அனுப்பப்படாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงและข้อความถอดเสียงสดจะถูกลบ จะไม่มีการส่งข้อมูลใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses ve canlı transkript silinir. Hiçbir şey gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо й транскрипт буде видалено. Нічого не надсилається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آڈیو اور لائیو ٹرانسکرپٹ حذف ہو جاتے ہیں۔ کچھ نہیں بھیجا جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh và bản chép lời trực tiếp sẽ bị xóa. Không có gì được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频和实时转录文本将被删除，不会发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊和即時逐字稿將被刪除，不會傳送任何內容。"
          }
        }
      }
    },
    "The Capture Bar change could not be confirmed. Reload and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد تغيير شريط الالتقاط. أعد التحميل وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার বারের পরিবর্তন নিশ্চিত করা যায়নি। রিলোড করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung der Erfassungsleiste konnte nicht bestätigt werden. Laden Sie neu und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Capture Bar change could not be confirmed. Reload and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el cambio en la barra de captura. Recarga e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification de la barre de capture n’a pas pu être confirmée. Actualisez et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर बार के बदलाव की पुष्टि नहीं हो सकी। रीलोड करें और फिर से प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan Bilah Tangkapan tidak dapat dikonfirmasi. Muat ulang dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare la modifica alla barra di acquisizione. Ricarica e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャバーの変更を確認できませんでした。再読み込みしてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 막대 변경 사항을 확인할 수 없습니다. 다시 불러온 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijziging van de vastlegbalk kon niet worden bevestigd. Laad opnieuw en probeer het nog eens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić zmiany paska przechwytywania. Odśwież i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a alteração na Barra de Captura. Recarregue e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить изменение панели захвата. Обновите и повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிடிப்புப் பட்டி மாற்றத்தை உறுதிப்படுத்த முடியவில்லை. மீண்டும் ஏற்றி மீண்டும் முயற்சிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถยืนยันการเปลี่ยนแปลงแถบจับภาพได้ โหลดใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama Çubuğu değişikliği onaylanamadı. Yeniden yükleyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підтвердити зміну панелі захоплення. Оновіть і спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر بار کی تبدیلی کی تصدیق نہیں ہو سکی۔ دوبارہ لوڈ کریں اور پھر کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác nhận thay đổi của Thanh ghi nhanh. Tải lại và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认采集栏的更改。请重新载入并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認擷取列的變更。請重新載入並再試一次。"
          }
        }
      }
    },
    "The Capture Bar order changed. Review the reloaded order and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر ترتيب شريط الالتقاط. راجع الترتيب بعد إعادة التحميل وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার বারের ক্রম বদলে গেছে। রিলোড করা ক্রম পর্যালোচনা করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reihenfolge der Erfassungsleiste hat sich geändert. Prüfen Sie die neu geladene Reihenfolge und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Capture Bar order changed. Review the reloaded order and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El orden de la barra de captura cambió. Revisa el orden recargado e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordre de la barre de capture a changé. Vérifiez l’ordre actualisé et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर बार का क्रम बदल गया। रीलोड किए गए क्रम की समीक्षा करें और फिर से प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urutan Bilah Tangkapan berubah. Tinjau urutan yang dimuat ulang dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordine della barra di acquisizione è cambiato. Controlla l’ordine ricaricato e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャバーの順序が変更されました。再読み込みされた順序を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 막대 순서가 변경되었습니다. 다시 불러온 순서를 검토한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgorde van de vastlegbalk is gewijzigd. Bekijk de opnieuw geladen volgorde en probeer het nog eens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejność na pasku przechwytywania uległa zmianie. Przejrzyj odświeżoną kolejność i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ordem da Barra de Captura mudou. Revise a ordem recarregada e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок на панели захвата изменился. Проверьте обновленный порядок и повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிடிப்புப் பட்டியின் வரிசை மாறியது. மீண்டும் ஏற்றப்பட்ட வரிசையை மதிப்பாய்வு செய்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลำดับแถบจับภาพเปลี่ยนไป ตรวจสอบลำดับที่โหลดใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama Çubuğu sırası değişti. Yeniden yüklenen sırayı gözden geçirip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок на панелі захоплення змінився. Перегляньте оновлений порядок і спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر بار کی ترتیب بدل گئی۔ دوبارہ لوڈ شدہ ترتیب کا جائزہ لیں اور پھر کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thứ tự của Thanh ghi nhanh đã thay đổi. Xem lại thứ tự đã tải lại và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集栏的顺序已更改。请检查重新载入后的顺序并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取列的順序已變更。請檢查重新載入後的順序並再試一次。"
          }
        }
      }
    },
    "The Capture Bar uses this explicit hour cycle instead of inferring it from the device setting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم شريط الالتقاط نظام الساعات المحدد هذا بدلًا من استنتاجه من إعداد الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার বার ডিভাইসের সেটিং থেকে অনুমান না করে এই নির্দিষ্ট ঘণ্টা-চক্র ব্যবহার করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erfassungsleiste verwendet dieses explizite Stundenformat, statt es aus der Geräteeinstellung abzuleiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Capture Bar uses this explicit hour cycle instead of inferring it from the device setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de captura usa este formato horario explícito en lugar de deducirlo del ajuste del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre de capture utilise ce format horaire explicite au lieu de le déduire du réglage de l’appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर बार डिवाइस सेटिंग से अनुमान लगाने के बजाय इसी स्पष्ट घंटा चक्र का उपयोग करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah Tangkapan menggunakan siklus jam eksplisit ini alih-alih menyimpulkannya dari pengaturan perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra di acquisizione usa questo formato orario esplicito invece di dedurlo dall’impostazione del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャバーでは、デバイスの設定から推測せず、この時間表示形式を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 막대는 기기 설정에서 추론하지 않고 이 시간 형식을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vastlegbalk gebruikt deze expliciete uurnotatie in plaats van die af te leiden uit de apparaatinstelling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasek przechwytywania używa tego cyklu godzin zamiast ustalać go na podstawie ustawień urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Barra de Captura usa este ciclo de horas explícito em vez de deduzi-lo do ajuste do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель захвата использует этот формат часов, а не берет его из настроек устройства."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதன அமைப்பிலிருந்து ஊகிக்காமல், பிடிப்புப் பட்டி இந்த வெளிப்படையான மணிநேர சுழற்சியைப் பயன்படுத்துகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบจับภาพใช้รูปแบบชั่วโมงที่ระบุนี้แทนการอนุมานจากการตั้งค่าของอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama Çubuğu, saat biçimini aygıt ayarından çıkarmak yerine bu açık saat döngüsünü kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель захоплення використовує цей формат годин, а не бере його з налаштувань пристрою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر بار آلے کی سیٹنگ سے اندازہ لگانے کی بجائے یہ واضح گھنٹہ سائیکل استعمال کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh ghi nhanh dùng chu kỳ giờ được chỉ định này thay vì suy ra từ cài đặt của thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集栏使用此明确的小时制，而不是根据设备设置推断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取列使用此明確的小時制，而不是依裝置設定推斷。"
          }
        }
      }
    },
    "The downloaded file did not match the selected transcription model.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
