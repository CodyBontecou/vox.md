    "Removes the saved HTTP payload from this device. Existing notes and anything already received by the endpoint are not changed. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل حمولة HTTP المحفوظة من هذا الجهاز. لا تتغير الملاحظات الحالية ولا أي شيء استلمته نقطة النهاية بالفعل. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইস থেকে সেভ করা HTTP পেলোড সরিয়ে দেয়। বিদ্যমান নোট এবং এন্ডপয়েন্টে আগেই পৌঁছানো কিছু পরিবর্তন হয় না। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die gesicherten HTTP-Daten von diesem Gerät. Vorhandene Notizen und alles, was der Endpunkt bereits erhalten hat, bleiben unverändert. Dies kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the saved HTTP payload from this device. Existing notes and anything already received by the endpoint are not changed. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de este dispositivo la carga HTTP guardada. Las notas existentes y lo que el punto de conexión ya haya recibido no cambian. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime la charge utile HTTP enregistrée de cet appareil. Les notes existantes et tout ce que le point de terminaison a déjà reçu ne sont pas modifiés. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस से सहेजा गया HTTP पेलोड हटाता है। मौजूदा नोट और एंडपॉइंट को पहले से मिली कोई भी चीज़ नहीं बदलती। इसे पूर्ववत् नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus payload HTTP yang tersimpan dari perangkat ini. Catatan yang ada dan apa pun yang sudah diterima endpoint tidak diubah. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove il payload HTTP salvato da questo dispositivo. Le note esistenti e ciò che l’endpoint ha già ricevuto non vengono modificati. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたHTTPペイロードをこのデバイスから削除します。既存のメモと、エンドポイントですでに受信された内容は変更されません。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 HTTP 페이로드를 이 기기에서 제거합니다. 기존 메모와 엔드포인트가 이미 수신한 내용은 변경되지 않습니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert de bewaarde HTTP-gegevens van dit apparaat. Bestaande notities en alles wat het eindpunt al heeft ontvangen, worden niet gewijzigd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa zapisane dane HTTP z tego urządzenia. Istniejące notatki i to, co punkt końcowy już otrzymał, nie zostaną zmienione. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove deste dispositivo o conteúdo HTTP salvo. Notas existentes e o que o endpoint já recebeu não são alterados. Não é possível desfazer esta ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет сохраненные данные HTTP с этого устройства. Существующие заметки и то, что адрес уже получил, не изменятся. Это действие нельзя отменить."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமித்த HTTP தரவை இந்தச் சாதனத்திலிருந்து அகற்றும். ஏற்கனவே உள்ள குறிப்புகளும் முனைப்புள்ளி ஏற்கனவே பெற்றவையும் மாற்றப்படாது. இதைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาข้อมูล HTTP ที่บันทึกไว้ออกจากอุปกรณ์นี้ โน้ตที่มีอยู่และสิ่งที่ปลายทางได้รับไปแล้วจะไม่เปลี่ยนแปลง การกระทำนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı HTTP yükünü bu aygıttan kaldırır. Mevcut notlar ve uç noktanın zaten aldıkları değişmez. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє збережені дані HTTP з цього пристрою. Наявні нотатки й те, що адреса вже отримала, не зміняться. Цю дію не можна скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے سے محفوظ HTTP پے لوڈ ہٹاتا ہے۔ موجودہ نوٹس اور اینڈ پوائنٹ کو پہلے سے موصول کوئی بھی چیز تبدیل نہیں ہوتی۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa payload HTTP đã lưu khỏi thiết bị này. Các ghi chú hiện có và mọi thứ điểm cuối đã nhận sẽ không bị thay đổi. Bạn không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此设备移除已保存的 HTTP 负载。现有笔记以及端点已收到的内容不会更改。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此裝置移除已儲存的 HTTP 承載資料。現有筆記以及端點已收到的內容不會變更。此動作無法還原。"
          }
        }
      }
    },
    "Removes this route from Capture Bar quick actions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذا المسار من الإجراءات السريعة في شريط الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার বারের কুইক অ্যাকশন থেকে এই রুট সরিয়ে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt diese Route aus den Schnellaktionen der Erfassungsleiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this route from Capture Bar quick actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita esta ruta de las acciones rápidas de la barra de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire ce parcours des actions rapides de la barre de capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रूट को कैप्चर बार क्विक ऐक्शन से हटाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus rute ini dari tindakan cepat Bilah Tangkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove questo percorso dalle azioni rapide della barra di acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルートをキャプチャバーのクイックアクションから削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 막대 빠른 동작에서 이 루트를 제거합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert deze route uit de snelle acties van de vastlegbalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa tę trasę z szybkich akcji paska przechwytywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove esta rota das ações rápidas da Barra de Captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет этот маршрут из быстрых действий панели захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிடிப்புப் பட்டி விரைவுச் செயல்களிலிருந்து இந்த வழித்தடத்தை அகற்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาเส้นทางนี้ออกจากการทำงานด่วนบนแถบจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rotayı Yakalama Çubuğu hızlı eylemlerinden kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучає цей маршрут зі швидких дій панелі захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس روٹ کو کیپچر بار کی فوری کارروائیوں سے ہٹاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa lộ trình này khỏi tác vụ nhanh của Thanh ghi nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从采集栏快捷操作中移除此路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從擷取列快速動作中移除此路線。"
          }
        }
      }
    },
    "Renewal": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التجديد"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নবায়ন"
          }
