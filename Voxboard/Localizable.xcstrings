        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাকিদের Apple Watch রেকর্ডিংয়ের অভাব আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aufbewahrte Aufnahme der Apple Watch fehlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The retained Apple Watch recording is missing."
          }
        },
        "es": {
          "stringUnit": {
