    "Capture Presets can now add anonymous, best-effort speaker labels to meeting recordings entirely on your device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن الآن إضافة علامات الكاتب المفضلة، الأفضل في العمل، إلى المواقع التي تصل إلى المراسلات بالكامل على جهازك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার প্রিজেট এখন আপনার ডিভাইসে সম্পূর্ণরূপে রেকর্ডগুলি পূরণ করার জন্য অ্যানিমাইজড, সেরা প্রচেষ্টা স্পিকার লেবেল যোগ করতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme-Presets können Besprechungsaufnahmen jetzt vollständig auf Ihrem Gerät anonyme, nach bestem Bemühen erzeugte Sprecherkennzeichnungen hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets can now add anonymous, best-effort speaker labels to meeting recordings entirely on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets ahora puede agregar etiquetas anónimas de altofalantes de mejor esfuerzo a las grabaciones de reunión completamente en su dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets peut désormais ajouter des étiquettes de haut-parleur anonymes et de meilleure qualité pour rencontrer des enregistrements entièrement sur votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर पूर्वावलोकन अब आपके डिवाइस पर पूरी तरह से बैठक रिकॉर्डिंग के लिए अनाम, सर्वश्रेष्ठ प्रयास स्पीकर लेबल जोड़ सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets sekarang dapat menambahkan label speaker anonim dan efisien untuk memenuhi rekaman sepenuhnya di perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets può ora aggiungere etichette anonime e di miglior livello per le riunioni di registrazioni interamente sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets では、デバイス上で完全に会議録音に匿名で最適なスピーカータグを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets는 이제 익명으로 최적의 스피커 라벨을 기기에서 완전히 만나는 녹음에 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets kan nu anonieme, best-effort speaker labels toevoegen aan de opnames volledig op uw apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets umożliwia teraz dodanie anonimowych etykiet głośników o najlepszym wysiłku do nagrań spotkań w całości na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets agora pode adicionar etiquetas anônimas de alto-falantes de melhor esforço para reunir gravações inteiramente no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets теперь может добавлять анонимные, наилучшие звукозаписи для встреч записей полностью на вашем устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets இப்போது உங்கள் சாதனத்தில் முழுமையாக சந்திப்பு பதிவுகளை சேர்க்க அநியாயமான, சிறந்த முயற்சிகள் பேச்சுவார்த்தை அட்டவணைகள் சேர்க்க முடியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets สามารถเพิ่มฉลากผู้พูดแบบไม่ระบุชื่อและมีประสิทธิภาพสูงสุดเพื่อให้สามารถเข้าถึงการบันทึกการประชุมได้ทั้งหมดบนอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets artık anonim, en iyi çaba konuşma etiketlerini tamamen cihazınızda kayıtlarla buluşmak için ekleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets тепер може додавати анонімні, найсильніші звукозаписи для зустрічей записів повністю на вашому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Preset اب آپ کے آلے پر مکمل طور پر ملاقات کی ریکارڈنگ کے لئے نامعلوم، بہترین کوشش سپرٹر ٹیبلز شامل کرسکتے ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture Presets bây giờ có thể thêm các nhãn loa ẩn danh, nỗ lực tốt nhất để đáp ứng các bản ghi hoàn toàn trên thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉预设现在可以添加匿名、精力最强的扬声器标签,以完全在您的设备上完成会议记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉預設現在可以添加匿名、精力最強的揚聲器標籤,以完全在您的設備上完成會議記錄。"
          }
        }
      }
    },
