    "Lifetime totals stay on device. No captured content, filenames, or destinations are stored with stats.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم تخزين المحتوى المكتوب أو أسماء الملفات أو الأهداف مع الإحصاءات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইফটাইম মোটগুলি ডিভাইসে থাকবে. কোনও ক্যাপচারিত সামগ্রী, ফাইল নাম বা গন্তব্যগুলি পরিসংখ্যান সহ সংরক্ষণ করা হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebenslange Summen bleiben auf dem Gerät. Keine erfassten Inhalte, Dateinamen oder Ziele werden mit Statistiken gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime totals stay on device. No captured content, filenames, or destinations are stored with stats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales de vida permanecen en el dispositivo. No se almacenan ningún contenido capturado, nombres de archivos o destinos con estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totalisations de durée de vie restent sur l'appareil. Aucun contenu capturé, aucun nom de fichier ou aucune destination n'est stockée avec des statistiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जीवनकाल कुल डिवाइस पर रहते हैं. कोई कैप्चर सामग्री, फ़ाइल नाम या गंतव्य सांख्यिकी के साथ संग्रहीत नहीं होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Total total hidup tetap berada di perangkat. tidak ada konten yang ditangkap, nama file, atau tujuan disimpan dengan statistik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I totali di vita rimangono sul dispositivo. Nessun contenuto, nomi di file o destinazioni registrati vengono memorizzati con statistiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生涯合計はデバイスに残ります. 収集されたコンテンツ、ファイル名、または目的地は統計とともに保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생애 총계는 장치에 남아 있습니다. 캡처된 콘텐츠, 파일 이름 또는 목적지는 통계와 함께 저장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Levensduur totalen blijven op het apparaat. Geen vastgelegde inhoud, bestandsnamen of bestemmingen worden opgeslagen met statistieken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Całkowite dane o czasie trwania pozostają na urządzeniu. Nie przechowywane są żadne zapisane treści, nazwy plików ani miejsca docelowe wraz ze statystykami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os totais de vida permanecem no dispositivo. Nenhum conteúdo capturado, nomes de arquivos ou destinos são armazenados com estatísticas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общие показатели пожизненного срока остаются на устройстве. Никакого захваченного контента, имен файлов или пунктов назначения не сохраняется вместе со статистикой."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு முதியவன் பாதாளங்களைத் தாண்டும் தன் மந்திரக்கோலால் சாய்த்தபடியிருக்கிறான் நாட்சத்திரங்களை. .............................................................................................................................................................................. இது எத்தனையாவது [...]"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อายุการใช้งานทั้งหมดยังคงอยู่ในอุปกรณ์ ไม่มีเนื้อหาที่จับชื่อไฟล์หรือเป้าหมายจะถูกเก็บไว้พร้อมกับสถิติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayat süresi toplamları cihazda kalır. kaydedilen içerik, dosya adları veya hedefleri istatistikleri ile depolanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Життєві суми залишаються на пристрої. Ніякий зафіксований контент, імена файлів або місця призначення не зберігаються зі статистикою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زندگی کے مجموعی طور پر آلہ پر رہتا ہے. کوئی پکڑنے والی مواد، فائلوں کے نام یا مقاصد اعداد و شمار کے ساتھ محفوظ نہیں ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng số cuộc sống vẫn còn trên thiết bị. Không có nội dung, tên tệp hoặc điểm đến được lưu trữ với số liệu thống kê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终身总数仍然存在设备上. 没有捕获的内容、文件名或目的地被存储与统计数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終身總數仍然存在設備上. 沒有捕獲的內容、文件名或目的地被存儲與統計數據。"
          }
        }
      }
    },
