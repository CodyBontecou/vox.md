    "%@ · %@ · saved safely on this iPhone. Re-grant folder access to deliver.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · محفوظ بأمان على هذا الـ iPhone. امنح الوصول إلى المجلد مجددًا للتسليم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · এই iPhone-এ নিরাপদে সেভ করা আছে। ডেলিভার করতে আবার ফোল্ডার অ্যাক্সেস দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · sicher auf diesem iPhone gesichert. Erteilen Sie erneut Ordnerzugriff, um zuzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · saved safely on this iPhone. Re-grant folder access to deliver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · guardada de forma segura en este iPhone. Vuelve a conceder acceso a la carpeta para entregarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · enregistrée en lieu sûr sur cet iPhone. Accordez à nouveau l’accès au dossier pour la livrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · इस iPhone पर सुरक्षित रूप से सहेजा गया। डिलीवर करने के लिए फ़ोल्डर ऐक्सेस फिर से दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · tersimpan dengan aman di iPhone ini. Berikan ulang akses folder untuk mengirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · salvata al sicuro su questo iPhone. Concedi di nuovo l’accesso alla cartella per consegnarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · このiPhoneに安全に保存されています。配信するにはフォルダへのアクセスを再度許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · 이 iPhone에 안전하게 저장되었습니다. 전달하려면 폴더 접근 권한을 다시 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · veilig bewaard op deze iPhone. Geef opnieuw toegang tot de map om af te leveren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · bezpiecznie zapisano na tym iPhone. Ponownie przyznaj dostęp do folderu, aby dostarczyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · salva com segurança neste iPhone. Conceda novamente o acesso à pasta para entregar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · надежно сохранено на этом iPhone. Снова предоставьте доступ к папке для доставки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · இந்த iPhone இல் பாதுகாப்பாகச் சேமிக்கப்பட்டது. வழங்க கோப்புறை அணுகலை மீண்டும் வழங்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · บันทึกไว้อย่างปลอดภัยบน iPhone เครื่องนี้ อนุญาตการเข้าถึงโฟลเดอร์อีกครั้งเพื่อส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · bu iPhone'da güvenle kaydedildi. Teslim etmek için klasör erişimini yeniden verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · надійно збережено на цьому iPhone. Знову надайте доступ до папки для доставки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · اس iPhone پر محفوظ ہے۔ ڈیلیور کرنے کے لیے فولڈر تک رسائی دوبارہ دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · đã lưu an toàn trên iPhone này. Cấp lại quyền truy cập thư mục để gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · 已安全保存在此 iPhone 上。请重新授予文件夹访问权限以递送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · 已安全儲存在此 iPhone 上。請重新授與資料夾取用權限以傳送。"
          }
        }
      }
    },
