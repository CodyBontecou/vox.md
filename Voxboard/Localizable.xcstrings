      }
    },
    "Allow insecure local HTTP": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بـ HTTP محلي غير آمن"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনিরাপদ স্থানীয় HTTP অনুমতি দিন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsicheres lokales HTTP erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow insecure local HTTP"
          }
        },
        "es": {
          "stringUnit": {
