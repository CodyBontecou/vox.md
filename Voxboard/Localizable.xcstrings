    "Vibrate on key press. Requires Allow Full Access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اهتز عند الضغط على مفتاح. يتطلب السماح بالوصول الكامل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী চাপলে কম্পন দিন। সম্পূর্ণ অ্যাক্সেসের অনুমতি প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Tastendruck vibrieren. Erfordert „Vollen Zugriff erlauben“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrate on key press. Requires Allow Full Access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra al pulsar una tecla. Requiere permitir acceso total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibre à chaque appui. Nécessite l’autorisation d’accès complet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी दबाने पर कंपन करें। पूर्ण एक्सेस की अनुमति आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergetar saat tombol ditekan. Memerlukan Izinkan Akses Penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra alla pressione dei tasti. Richiede Consenti accesso completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを押したときに振動します。「フルアクセスを許可」が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 누를 때 진동합니다. 전체 접근 허용이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tril bij een toetsaanslag. Vereist Sta volledige toegang toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wibruj przy naciśnięciu klawisza. Wymaga pełnego dostępu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibra ao pressionar teclas. Requer Permitir Acesso Total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрация при нажатии клавиш. Требуется полный доступ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விசையை அழுத்தும்போது அதிரும். முழு அணுகலை அனுமதிக்க வேண்டும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สั่นเมื่อกดปุ่ม ต้องอนุญาตการเข้าถึงแบบเต็ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşa basıldığında titreşir. Tam Erişime İzin Verilmesi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вібрація під час натискання клавіш. Потрібен повний доступ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید دبانے پر وائبریٹ کریں۔ مکمل رسائی کی اجازت درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rung khi nhấn phím. Cần cho phép Truy cập đầy đủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键时振动。需要允许完全访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵時震動。需要允許完整取用權限。"
          }
        }
      }
    },
