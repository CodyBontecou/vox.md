            "value": "Транскрипція та обробка залишаються на цьому Mac."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسکرپشن اور پروسیسنگ اسی Mac پر رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc chép lời và xử lý diễn ra trên máy Mac này."
          }
        },
        "zh-Hans": {
