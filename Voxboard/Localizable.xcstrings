            "value": "Vox.md Unlimited"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 无限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 無限"
          }
        }
      }
    },
    "Vox.md waits rather than overwrite. It retries automatically every minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتظر Vox.md بدلًا من الكتابة فوق الملف. ويعيد المحاولة تلقائيًا كل دقيقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ওভাররাইট না করে অপেক্ষা করে। এটি প্রতি মিনিটে স্বয়ংক্রিয়ভাবে আবার চেষ্টা করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md wartet, statt zu überschreiben. Es wird jede Minute automatisch erneut versucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md waits rather than overwrite. It retries automatically every minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md espera en lugar de sobrescribir. Lo reintenta automáticamente cada minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md attend plutôt que d’écraser. Il réessaie automatiquement toutes les minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ओवरराइट करने के बजाय प्रतीक्षा करता है। यह हर मिनट अपने आप फिर से प्रयास करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md menunggu alih-alih menimpa, lalu mencoba lagi secara otomatis setiap menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md attende invece di sovrascrivere. Riprova automaticamente ogni minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.mdは上書きせずに待機し、1分ごとに自動的に再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md는 덮어쓰지 않고 기다리며 1분마다 자동으로 재시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md wacht in plaats van te overschrijven. Het wordt elke minuut automatisch opnieuw geprobeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md czeka zamiast nadpisywać. Ponawia automatycznie co minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vox.md aguarda em vez de sobrescrever. Ele tenta novamente a cada minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ждет, а не перезаписывает. Попытка повторяется автоматически каждую минуту."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md மேலெழுதாமல் காத்திருக்கும். இது ஒவ்வொரு நிமிடமும் தானாக மீண்டும் முயற்சிக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md จะรอแทนการเขียนทับ และจะลองอีกครั้งโดยอัตโนมัติทุกนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md üzerine yazmak yerine bekler. Her dakika otomatik olarak yeniden dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md чекає, а не перезаписує. Спроба повторюється автоматично щохвилини."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md اوور رائٹ کرنے کی بجائے انتظار کرتا ہے۔ یہ ہر منٹ خودکار طور پر دوبارہ کوشش کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md chờ thay vì ghi đè. Ứng dụng tự động thử lại mỗi phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 会等待而不会覆盖。它每分钟自动重试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 會等待而不會覆寫。它每分鐘自動重試一次。"
          }
        }
      }
    },
