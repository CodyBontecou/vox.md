    "Opens Vox.md and starts recording to this Route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Vox.md ويبدأ التسجيل إلى هذا المسار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md খোলে এবং এই রুটে রেকর্ডিং শুরু করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Vox.md und startet eine Aufnahme für diese Route."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Vox.md and starts recording to this Route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Vox.md y empieza a grabar en esta ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Vox.md et lance l’enregistrement vers cette route."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md खोलता है और इस रूट पर रिकॉर्डिंग शुरू करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Vox.md dan mulai merekam ke Rute ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Vox.md e avvia la registrazione in questo percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md を開き、このルートへの録音を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md를 열고 이 경로로 녹음을 시작합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Vox.md en start een opname naar deze route."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Vox.md i zaczyna nagrywać do tej trasy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Vox.md e começa a gravar nesta rota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Vox.md и начинает запись в этот маршрут."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md-ஐத் திறந்து இந்த வழிக்குப் பதிவைத் தொடங்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Vox.md และเริ่มบันทึกไปยังเส้นทางนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md’yi açar ve bu rotaya kayda başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває Vox.md і починає запис у цей маршрут."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md کھولتا ہے اور اس روٹ پر ریکارڈنگ شروع کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Vox.md và bắt đầu ghi âm vào Tuyến này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Vox.md 并开始录音到此路线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Vox.md 並開始錄音到此路線。"
          }
        }
      }
    },
    "Opens Vox.md. Does not send or record.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Vox.md. لا يرسل ولا يسجّل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md খোলে। পাঠায় বা রেকর্ড করে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Vox.md. Sendet oder nimmt nicht auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Vox.md. Does not send or record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Vox.md. No envía ni graba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Vox.md. N’envoie ni n’enregistre rien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md खोलता है। भेजता या रिकॉर्ड नहीं करता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Vox.md. Tidak mengirim atau merekam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Vox.md. Non invia né registra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md を開きます。送信や録音はしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md를 엽니다. 보내거나 녹음하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Vox.md. Verstuurt of neemt niets op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Vox.md. Nie wysyła ani nie nagrywa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Vox.md. Não envia nem grava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Vox.md. Ничего не отправляет и не записывает."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md-ஐத் திறக்கும். அனுப்பாது, பதிவு செய்யாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Vox.md ไม่ส่งหรือบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md’yi açar. Göndermez veya kaydetmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває Vox.md. Нічого не надсилає й не записує."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md کھولتا ہے۔ نہ بھیجتا ہے نہ ریکارڈ کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Vox.md. Không gửi hay ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Vox.md。不发送也不录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Vox.md。不傳送也不錄音。"
          }
        }
      }
    },
    "Opens the document scanner for this Route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح ماسح المستندات لهذا المسار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রুটের জন্য ডকুমেন্ট স্ক্যানার খোলে।"
          }
