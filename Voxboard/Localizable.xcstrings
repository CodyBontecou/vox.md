            "value": "Tokeny: {title} (pierwszy wiersz przechwytywania), {timestamp}, {date}, {time}, {hour}, {minute}, {second}, {year}, {YR} (rok dwucyfrowy), {month}, {day}, {id8}, {id}. Istniejące nazwy plików są automatycznie uzupełniane, aby były unikalne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens: {title} (primeira linha da captura), {timestamp}, {date}, {time}, {hour}, {minute}, {second}, {year}, {YR} (ano com 2 dígitos), {month}, {day}, {id8}, {id}. Nomes de arquivo existentes recebem um sufixo único automaticamente."
          }
        },
        "ru": {
