    "Capture attachments exceed the 250 MB total safety limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيد عدد الملفات المرفقة عن الحد الأدنى من السلامة الكاملة من 250 MB."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার অ্যাডেঞ্জগুলি মোট নিরাপত্তা সীমা 250 এমবি অতিক্রম করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anhänge der Erfassung überschreiten das Sicherheitslimit von 250 MB insgesamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture attachments exceed the 250 MB total safety limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos adjuntos de captura exceden el límite de seguridad total de 250 MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pièces jointes capturées dépassent la limite de sécurité totale de 250 Mo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर एडलीज 250 MB कुल सुरक्षा सीमा से अधिक हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan: File yang dicetak melebihi batas keamanan total 250 MB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file allegati di cattura superano il limite di sicurezza totale di 250 MB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャ アドレスは、250 MB の総セキュリティ制限を超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 첨부 파일은 250MB 총 보안 제한을 초과합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijlagen die worden vastgelegd, overschrijden de totale beveiligingsgrens van 250 MB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Załączniki do rejestracji przekraczają całkowity limit bezpieczeństwa 250 MB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os anexos de captura excedem o limite de segurança total de 250 MB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения для захвата превышают общий предел безопасности 250 МБ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடிக்கடி எழுதப்பட்ட அட்டவணைகள் 250 MB முழுமையான பாதுகாப்பு அளவுக்கு மேல்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพคเกจการจับภาพเกินขีด จํากัด ความปลอดภัยทั้งหมด 250 MB"
          }
        },
        "tr": {
