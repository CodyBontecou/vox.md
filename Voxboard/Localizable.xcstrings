    "Choose how long silence lasts before auto-stop responds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مدة الصمت قبل أن يستجيب الإيقاف التلقائي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অটো-স্টপ সাড়া দেওয়ার আগে কতক্ষণ নীরবতা থাকবে বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie fest, wie lange Stille dauert, bevor der automatische Stopp reagiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long silence lasts before auto-stop responds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto debe durar el silencio antes de que actúe la detención automática."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la durée du silence avant que l’arrêt automatique réagisse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि ऑटो-स्टॉप के जवाब देने से पहले कितनी देर तक चुप्पी रहे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama keheningan berlangsung sebelum henti otomatis merespons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quanto deve durare il silenzio prima che intervenga l’interruzione automatica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動停止が反応するまでの無音の長さを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 중단이 반응하기 전까지의 무음 지속 시간을 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe lang stilte duurt voordat automatisch stoppen reageert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo musi trwać cisza, zanim zadziała automatyczne zatrzymywanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quanto tempo o silêncio deve durar antes de a parada automática agir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, сколько должна длиться тишина до срабатывания автоостановки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கு நிறுத்தம் செயல்படுவதற்கு முன் அமைதி எவ்வளவு நேரம் நீடிக்க வேண்டும் என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกระยะเวลาที่เงียบก่อนที่การหยุดอัตโนมัติจะทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik durdurma tepki vermeden önce sessizliğin ne kadar süreceğini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, скільки має тривати тиша до спрацювання автозупинки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کریں کہ خودکار رکاؤ کے ردعمل سے پہلے خاموشی کتنی دیر رہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn khoảng lặng kéo dài bao lâu trước khi tính năng tự dừng phản hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
