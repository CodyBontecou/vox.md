      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على «تحدث» للكلام"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথা বলতে 'বলুন' ধরে রাখুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte „Sprechen“ gedrückt, um zu reden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Speak to talk"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado Hablar para hablar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez Parler pour parler"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलने के लिए 'बोलें' दबाए रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan Bicara untuk berbicara"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto Parla per parlare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「話す」を長押しして話す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하려면 '말하기'를 길게 누르세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd Spreken ingedrukt om te praten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj Mów, aby mówić"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha Falar pressionado para falar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте «Говорить», чтобы говорить"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பேச 'பேசு'-ஐ அழுத்திப் பிடிக்கவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ พูด ค้างไว้เพื่อพูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmak için Konuş’a basılı tutun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте «Говорити», щоб говорити"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بات کرنے کے لیے 'بولیں' دبائے رکھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ Nói để nói"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住“说话”即可讲话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住「說話」即可講話"
          }
        }
      }
    },
    "Release to stop. Tap once to record hands-free.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اترك للإيقاف. اضغط مرة للتسجيل دون استخدام اليدين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "থামাতে ছেড়ে দিন। হাত ছাড়া রেকর্ড করতে একবার ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Stoppen loslassen. Einmal tippen, um freihändig aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release to stop. Tap once to record hands-free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta para detener. Toca una vez para grabar sin manos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relâchez pour arrêter. Touchez une fois pour enregistrer sans les mains."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोकने के लिए छोड़ें। हैंड्स-फ़्री रिकॉर्ड करने के लिए एक बार टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepaskan untuk berhenti. Ketuk sekali untuk merekam tanpa tangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia per fermare. Tocca una volta per registrare a mani libere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指を離すと停止します。1回タップするとハンズフリーで録音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손을 떼면 중지됩니다. 한 번 탭하면 핸즈프리로 녹음합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat los om te stoppen. Tik één keer om handsfree op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puść, aby zatrzymać. Stuknij raz, aby nagrywać bez użycia rąk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte para parar. Toque uma vez para gravar sem as mãos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпустите, чтобы остановить. Нажмите один раз, чтобы записывать без рук."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிறுத்த விடுவிக்கவும். கைகளின்றிப் பதிவுசெய்ய ஒருமுறை தட்டவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปล่อยเพื่อหยุด แตะหนึ่งครั้งเพื่อบันทึกแบบไม่ต้องใช้มือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdurmak için bırakın. Eller serbest kaydetmek için bir kez dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відпустіть, щоб зупинити. Торкніться один раз, щоб записувати без рук."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روکنے کے لیے چھوڑ دیں۔ ہینڈز فری ریکارڈ کرنے کے لیے ایک بار ٹیپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả ra để dừng. Chạm một lần để ghi rảnh tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开即可停止。轻点一下可免手持录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放開即可停止。點一下可免手持錄音。"
          }
        }
      }
    },
    "Read and export your history anytime": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read and export your history anytime"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة وتصدير التاريخ الخاص بك في أي وقت"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে কোনো সময় আপনার ইতিহাস পড়ুন এবং রপ্তানি করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesen und exportieren Sie Ihren Verlauf jederzeit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee y exporta tu historial en cualquier momento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez et exportez votre historique à tout moment"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी समय अपना इतिहास पढ़ें और निर्यात करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca dan ekspor riwayat Anda kapan saja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi ed esporta la tua cronologia in qualsiasi momento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも履歴を読み取ってエクスポートできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든지 기록을 읽고 내보낼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees en exporteer uw geschiedenis op elk gewenst moment"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytaj i eksportuj swoją historię w dowolnym momencie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia e exporte seu histórico a qualquer momento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читайте и экспортируйте свою историю в любое время"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த நேரத்திலும் உங்கள் வரலாற்றைப் படித்து ஏற்றுமதி செய்யவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านและส่งออกประวัติของคุณได้ตลอดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişinizi istediğiniz zaman okuyun ve dışa aktarın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читайте та експортуйте свою історію будь-коли"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی وقت اپنی تاریخ پڑھیں اور برآمد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc và xuất lịch sử của bạn bất cứ lúc nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时阅读并导出您的历史记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時閱讀並匯出您的歷史記錄"
          }
        }
      }
    },
