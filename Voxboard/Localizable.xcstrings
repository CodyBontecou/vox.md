    "Optional optimized local models you can download and select explicitly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تحميل النماذج المحلية المبتكرة الخاصة بك وتحديدها بشكل واضح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অপশনীয় উন্নত স্থানীয় মডেলগুলি আপনি ডাউনলোড করতে পারেন এবং স্পষ্টভাবে নির্বাচন করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale optimierte lokale Modelle, die Sie herunterladen und explizit auswählen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional optimized local models you can download and select explicitly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos locales optimizados opcionales que puede descargar y seleccionar explícitamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèles locaux optimisés optionnels que vous pouvez télécharger et sélectionner explicitement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक अनुकूलित स्थानीय मॉडल आप डाउनलोड कर सकते हैं और स्पष्ट रूप से चयन कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsi model lokal yang dioptimalkan yang dapat Anda unduh dan pilih secara eksplisit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelli locali ottimizzati opzionali che puoi scaricare e selezionare esplicitamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択肢として最適化されたローカルモデルは、明示的にダウンロードして選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택적으로 다운로드하고 명시적으로 선택할 수 있는 최적화된 로컬 모델."
