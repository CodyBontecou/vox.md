          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure processamento, rotas de cofre, formatação de entrada, anexos e comportamento de retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка обработки, маршрутов сейфа, форматирования входов, приложений и поведения ретри."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதாவது, கணிதத் துறையில், கணிதத் துறையில், கணிதத் துறையில், கணிதத் துறையில், கணிதத் துறையில், கணிதத் துறையில்"
          }
        },
        "th": {
