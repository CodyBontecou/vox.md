    "Sending is disabled for this identity. Choose Discard again to finish removing its local payload.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإرسال معطّل لهذه الهوية. اختر «تجاهل» مرة أخرى لإكمال إزالة حمولتها المحلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আইডেন্টিটির জন্য পাঠানো নিষ্ক্রিয়। এর স্থানীয় পেলোড সরানো শেষ করতে আবার ‘বাতিল করুন’ বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Senden ist für diese Identität deaktiviert. Wählen Sie erneut „Verwerfen“, um das Entfernen der lokalen Daten abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending is disabled for this identity. Choose Discard again to finish removing its local payload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío está desactivado para esta identidad. Vuelve a elegir Descartar para terminar de eliminar su carga local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi est désactivé pour cette identité. Choisissez à nouveau Abandonner pour finir de supprimer sa charge utile locale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पहचान के लिए भेजना बंद है। इसका स्थानीय पेलोड हटाना पूरा करने के लिए फिर से हटाएँ चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiriman dinonaktifkan untuk identitas ini. Pilih Buang lagi untuk selesai menghapus payload lokalnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’invio è disattivato per questa identità. Scegli di nuovo Scarta per completare la rimozione del payload locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このIDでは送信が無効になっています。ローカルのペイロードの削除を完了するには、もう一度「破棄」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 ID에 대한 전송이 비활성화되었습니다. 로컬 페이로드 제거를 완료하려면 폐기를 다시 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versturen is uitgeschakeld voor deze identiteit. Kies nogmaals ‘Verwijder’ om het verwijderen van de lokale gegevens te voltooien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłanie jest wyłączone dla tej tożsamości. Wybierz ponownie Odrzuć, aby dokończyć usuwanie lokalnych danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio está desativado para esta identidade. Escolha Descartar novamente para concluir a remoção do conteúdo local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка для этого идентификатора отключена. Снова выберите «Удалить», чтобы завершить удаление локальных данных."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அடையாளத்திற்கு அனுப்புதல் முடக்கப்பட்டுள்ளது. அதன் உள்ளூர் தரவை அகற்றி முடிக்க மீண்டும் நிராகரி என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งถูกปิดใช้งานสำหรับข้อมูลระบุตัวตนนี้ เลือก “ละทิ้ง” อีกครั้งเพื่อเอาข้อมูลในเครื่องออกให้เสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kimlik için gönderim devre dışı. Yerel yükünü kaldırmayı tamamlamak için At'ı yeniden seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання для цього ідентифікатора вимкнено. Знову виберіть «Видалити», щоб завершити видалення локальних даних."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس شناخت کے لیے بھیجنا غیر فعال ہے۔ اس کا مقامی پے لوڈ ہٹانا مکمل کرنے کے لیے دوبارہ رد کریں منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc gửi đã bị tắt cho danh tính này. Chọn Hủy lần nữa để hoàn tất xóa payload cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此身份已停用发送。再次选择“丢弃”以完成移除其本地负载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此身分已停用傳送。再次選擇「丟棄」以完成移除其本機承載資料。"
          }
        }
      }
    },
