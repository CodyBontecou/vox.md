    "Wait until you choose Process Now in Activity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانتظار حتى تختار «المعالجة الآن» في «النشاط»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্যকলাপ-এ ‘এখনই প্রসেস করুন’ বেছে না নেওয়া পর্যন্ত অপেক্ষা করুন।"
          }
        },
        "de": {
