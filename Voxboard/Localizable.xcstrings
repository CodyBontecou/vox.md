    "Paused audio is excluded — resume to keep recording this note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصوت المتوقف مؤقتًا مستبعد — استأنف لمتابعة تسجيل هذه الملاحظة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরতির অডিও বাদ যাবে — এই নোট রেকর্ড করা চালিয়ে যেতে আবার শুরু করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiertes Audio wird ausgeschlossen – fortsetzen, um diese Notiz weiter aufzunehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused audio is excluded — resume to keep recording this note"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio en pausa se excluye; reanuda para seguir grabando esta nota"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio en pause est exclu ; reprenez pour continuer l’enregistrement de cette note"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉज़ किया गया ऑडियो शामिल नहीं होता — यह नोट रिकॉर्ड करते रहने के लिए फिर से शुरू करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio yang dijeda tidak disertakan — lanjutkan untuk terus merekam catatan ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio in pausa è escluso: riprendi per continuare a registrare questa nota"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中の音声は含まれません — 再開するとこのメモの録音を続けられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지된 오디오는 제외됩니다 — 이 메모를 계속 녹음하려면 재개하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerde audio wordt uitgesloten – hervat om deze notitie verder op te nemen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymany fragment nie jest nagrywany — wznów, aby kontynuować nagrywanie tej notatki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio em pausa é excluído — retome para continuar gravando esta nota"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио на паузе не сохраняется — продолжите, чтобы записывать эту заметку"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடைநிறுத்தப்பட்ட ஒலி சேர்க்கப்படாது — இந்தக் குறிப்பைப் பதிவுசெய்வதைத் தொடர மீண்டும் தொடங்கவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงที่หยุดชั่วคราวจะไม่ถูกรวม — ดำเนินการต่อเพื่อบันทึกโน้ตนี้ต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatılan ses dahil edilmez — bu notu kaydetmeye devam etmek için sürdürün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо на паузі не зберігається — продовжте, щоб записувати цю нотатку"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موقوف آڈیو شامل نہیں — یہ نوٹ ریکارڈ کرتے رہنے کے لیے دوبارہ شروع کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh lúc tạm dừng bị loại trừ — tiếp tục để ghi tiếp ghi chú này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停期间的音频不会保留——继续录音以完成此笔记"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停期間的音訊不會保留——繼續錄音以完成此筆記"
          }
        }
      }
    },
