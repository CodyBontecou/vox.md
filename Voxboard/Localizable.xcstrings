    "Open to see route steps and the “will write” preview": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح لرؤية خطوات المسار ومعاينة «ما سيُكتب»"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রুটের ধাপ ও “যা লেখা হবে” প্রিভিউ দেখতে খুলুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen, um Routenschritte und die Vorschau „Wird geschrieben“ zu sehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open to see route steps and the “will write” preview"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre para ver los pasos de la ruta y la vista previa de “se escribirá”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez pour voir les étapes du parcours et l’aperçu « sera écrit »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूट के चरण और “लिखा जाएगा” प्रीव्यू देखने के लिए खोलें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka untuk melihat langkah rute dan pratinjau “Akan ditulis”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri per vedere i passaggi del percorso e l’anteprima “Verrà scritto”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開くとルートの手順と「書き込み予定」のプレビューを表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열어서 루트 단계와 ‘기록 예정’ 미리보기 보기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open om de routestappen en het voorbeeld ‘wordt geschreven’ te zien"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz, aby zobaczyć kroki trasy i podgląd „zostanie zapisane”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra para ver as etapas da rota e a prévia de “será escrito”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте, чтобы увидеть шаги маршрута и предпросмотр «будет записано»"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழித்தடப் படிகளையும் “எழுதப்படும்” முன்னோட்டத்தையும் காண திறக்கவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเพื่อดูขั้นตอนของเส้นทางและตัวอย่าง “สิ่งที่จะเขียน”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rota adımlarını ve “yazılacak” önizlemesini görmek için açın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте, щоб побачити кроки маршруту та попередній перегляд «буде записано»"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
