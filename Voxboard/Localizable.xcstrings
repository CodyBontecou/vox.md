            "state": "translated",
            "value": "Eve uzun yoldan gidin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдіть довгу дорогу додому."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھر کا لمبا راستہ لیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi đường dài về nhà."
