          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Vox.md в Системные настройки › Основные › Объекты входа."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணினி அமைப்புகள் › பொது › உள்நுழைவு உருப்படிகள் என்பதில் Vox.md ஐ அனுமதிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาต Vox.md ในการตั้งค่าระบบ › ทั่วไป › รายการเข้าสู่ระบบ"
          }
