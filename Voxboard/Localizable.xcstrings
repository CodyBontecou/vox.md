    "Nested mappings and list items are supported. Use placeholders such as `{{coordinates}}`, `{{city}}`, `{{timestamp}}`, and `{{id}}`.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم دعم التعيينات المتداخلة وعناصر القائمة. استخدم العناصر النائبة مثل `{{coordinates}}`، و`{{city}}`، و`{{timestamp}}`، و`{{id}}`."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেস্টেড ম্যাপিং এবং তালিকা আইটেম সমর্থিত. `{{coordinates}}`, `{{city}}`, `{{timestamp}}`, এবং `{{id}}` এর মতো স্থানধারক ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschachtelte Zuordnungen und Listenelemente werden unterstützt. Verwenden Sie Platzhalter wie `{{coordinates}}`, `{{city}}`, `{{timestamp}}` und `{{id}}`."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nested mappings and list items are supported. Use placeholders such as `{{coordinates}}`, `{{city}}`, `{{timestamp}}`, and `{{id}}`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se admiten asignaciones anidadas y elementos de lista. Utilice marcadores de posición como `{{coordinates}}`, `{{city}}`, `{{timestamp}}` y `{{id}}`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mappages imbriqués et les éléments de liste sont pris en charge. Utilisez des espaces réservés tels que `{{coordinates}}`, `{{city}}`, `{{timestamp}}` et `{{id}}`."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेस्टेड मैपिंग और सूची आइटम समर्थित हैं। `{{coordinates}}`, `{{city}}`, `{{timestamp}}`, और `{{id}}` जैसे प्लेसहोल्डर्स का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemetaan bertumpuk dan item daftar didukung. Gunakan placeholder seperti `{{coordinates}}`, `{{city}}`, `{{timestamp}}`, dan `{{id}}`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono supportati i mapping nidificati e gli elementi dell'elenco. Utilizza segnaposto come `{{coordinates}}`, `{{city}}`, `{{timestamp}}` e `{{id}}`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネストされたマッピングとリスト項目がサポートされています。 `{{coordinates}}`、`{{city}}`、`{{timestamp}}`、`{{id}}` などのプレースホルダーを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중첩된 매핑 및 목록 항목이 지원됩니다. `{{coordinates}}`, `{{city}}`, `{{timestamp}}`, `{{id}}` 등의 자리 표시자를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geneste toewijzingen en lijstitems worden ondersteund. Gebruik tijdelijke aanduidingen zoals `{{coordinates}}`, `{{city}}`, `{{timestamp}}` en `{{id}}`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsługiwane są zagnieżdżone mapowania i elementy listy. Używaj symboli zastępczych, takich jak `{{coordinates}}`, `{{city}}`, `{{timestamp}}` i `{{id}}`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapeamentos aninhados e itens de lista são suportados. Use espaços reservados como `{{coordinates}}`, `{{city}}`, `{{timestamp}}` e `{{id}}`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживаются вложенные сопоставления и элементы списков. Используйте заполнители, такие как `{{coordinates}}`, `{{city}}`, `{{timestamp}}` и `{{id}}`."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளமைக்கப்பட்ட மேப்பிங் மற்றும் பட்டியல் உருப்படிகள் ஆதரிக்கப்படுகின்றன. `{{coordinates}}`, `{{city}}`, `{{timestamp}}` மற்றும் `{{id}}` போன்ற ஒதுக்கிடங்களைப் பயன்படுத்தவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รองรับการแมปแบบซ้อนและรายการ ใช้ตัวยึดตำแหน่ง เช่น `{{coordinates}}`, `{{city}}`, `{{timestamp}}` และ `{{id}}`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İç içe eşlemeler ve liste öğeleri desteklenir. `{{coordinates}}`, `{{city}}`, `{{timestamp}}` ve `{{id}}` gibi yer tutucuları kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримуються вкладені зіставлення та елементи списку. Використовуйте заповнювачі, такі як `{{coordinates}}`, `{{city}}`, `{{timestamp}}` та `{{id}}`."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیسٹڈ میپنگ اور لسٹ آئٹمز تعاون یافتہ ہیں۔ پلیس ہولڈرز جیسے کہ `{{coordinates}}`، `{{city}}`، `{{timestamp}}`، اور `{{id}}` استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ánh xạ lồng nhau và các mục danh sách được hỗ trợ. Sử dụng các phần giữ chỗ như `{{coordinates}}`, `{{city}}`, `{{timestamp}}` và `{{id}}`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持嵌套映射和列表项。使用占位符，例如 `{{coordinates}}`、`{{city}}`、`{{timestamp}}` 和 `{{id}}`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援巢狀映射和列表項目。使用佔位符，例如 `{{coordinates}}`、`{{city}}`、`{{timestamp}}` 和 `{{id}}`。"
          }
        }
      }
    },
