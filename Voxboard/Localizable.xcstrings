        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং নিরাপদ, কিন্তু তার রেখা আপডেট করা যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist sicher, aber ihre Warteschlange konnte nicht aktualisiert werden."
