    "Saved on Watch. Tap Sync Queue after your iPhone is nearby.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر فوق \"دخول الشاشة\" بعد أن تمكن iPhone من الوصول إلى المكان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উদ্ধার করা হয়েছে দর্শকদের। টপ সিনাকলিটেড পরে আপনার iPhone কাছাকাছি আছে।"
          }
        },
        "de": {
          "stringUnit": {
