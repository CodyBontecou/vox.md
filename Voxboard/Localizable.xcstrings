        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹیبلٹ بھی شامل کر سکتے ہیں multiline Markdown یا YAML frontmatter کے لئے ٹوکری شامل ہے {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {source}, اور {id8}, {location}."
