    "Paused, %@ recorded. Tap to stop, or use Resume to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف مؤقتًا، مدة التسجيل %@. اضغط للإيقاف، أو استخدم «استئناف» للمتابعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিরতিতে আছে, %@ রেকর্ড হয়েছে। বন্ধ করতে ট্যাপ করুন, বা চালিয়ে যেতে ‘আবার শুরু’ ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert, %@ aufgenommen. Tippen Sie zum Stoppen oder auf „Fortsetzen“, um weiterzumachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused, %@ recorded. Tap to stop, or use Resume to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa, %@ grabado. Toca para detener o usa Reanudar para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause, %@ enregistré. Touchez pour arrêter ou utilisez Reprendre pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉज़ किया गया, %@ रिकॉर्ड हुआ। बंद करने के लिए टैप करें या जारी रखने के लिए फिर से शुरू करें का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda, %@ terekam. Ketuk untuk berhenti, atau gunakan Lanjutkan untuk meneruskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa, %@ registrati. Tocca per interrompere o usa Riprendi per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中、%@録音済み。タップで停止、または「再開」で続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지됨, %@ 녹음됨. 탭하여 중단하거나 ‘재개’를 눌러 계속하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd, %@ opgenomen. Tik om te stoppen of gebruik ‘Hervat’ om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymano, nagrano %@. Stuknij, aby zatrzymać, lub użyj Wznów, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa, %@ gravado. Toque para parar ou use Retomar para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза, записано %@. Коснитесь, чтобы остановить, или нажмите «Продолжить»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடைநிறுத்தப்பட்டது, %@ பதிவுசெய்யப்பட்டது. நிறுத்த தட்டவும், அல்லது தொடர “தொடர்” என்பதைப் பயன்படுத்தவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดชั่วคราว บันทึกแล้ว %@ แตะเพื่อหยุด หรือใช้ “ดำเนินการต่อ” เพื่อบันทึกต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldı, %@ kaydedildi. Durdurmak için dokunun veya devam etmek için Sürdür'ü kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза, записано %@. Торкніться, щоб зупинити, або натисніть «Продовжити»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موقوف، %@ ریکارڈ ہوا۔ بند کرنے کے لیے تھپتھپائیں، یا جاری رکھنے کے لیے دوبارہ شروع کریں استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng, đã ghi %@. Chạm để dừng hoặc dùng Tiếp tục để ghi tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停，已录制 %@。轻点以停止，或使用“继续”接着录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停，已錄製 %@。點一下以停止，或使用「繼續」接著錄。"
          }
        }
      }
    },
