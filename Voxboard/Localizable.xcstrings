    "Record or send a Capture to create your first history item.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسجيل أو إرسال تصوير لإنشاء أول جزء من التاريخ الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রথম ইতিহাস আইটেম তৈরি করার জন্য একটি ক্যাপচার রেকর্ড করুন বা পাঠান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehmen Sie eine Erfassung auf oder senden Sie sie, um Ihren ersten Verlaufseintrag zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record or send a Capture to create your first history item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabe o envíe una captura para crear su primer elemento de historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ou envoyez une capture pour créer votre premier élément d'historique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पहले इतिहास आइटम बनाने के लिए एक कैप्चर रिकॉर्ड करें या भेजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam atau kirim Capture untuk membuat item riwayat pertama Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione o invio di una Cattura per creare il tuo primo elemento di storia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャを録画または送信して、最初の履歴項目を作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처를 기록하거나 보내면 첫 번째 역사 항목을 만들 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnemen of een Capture verzenden om uw eerste geschiedeniselement te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie lub wysyłanie pozycji Zdjęcia, aby utworzyć swój pierwszy element historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave ou envie uma captura para criar seu primeiro item de histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте или отправляйте запись для создания первого элемента истории."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு Capture எழுத அல்லது உங்கள் முதல் History item உருவாக்க அனுப்பவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกหรือส่งการจับภาพเพื่อสร้างรายการประวัติแรกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk geçmiş öğesini oluşturmak için bir Kayıt kaydedin veya gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте або відправте запис, щоб створити перший елемент історії."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی پہلی تاریخ کے عنصر کو بنانے کے لئے ایک کٹ یا بھیجیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi hoặc gửi một Capture để tạo mục lịch sử đầu tiên của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制或发送捕获以创建您的第一个历史项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製或發送捕獲以創建您的第一個歷史項目。"
          }
        }
      }
    },
