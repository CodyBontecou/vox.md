    "Voice and text stay on-device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال الصوت والرسالة على الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শব্দ এবং টেক্সট ডিভাইসের উপর থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache und Text bleiben auf dem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice and text stay on-device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz y el texto permanecen en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix et le texte restent sur l'appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस और टेक्स्ट डिवाइस पर रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara dan teks tetap pada perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voce e il testo rimangono sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声とテキストはデバイス内で残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성과 텍스트는 장치에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst en spraak blijven op het apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głos i tekst pozostają na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voz e texto permanecem no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос и текст остаются на устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இசை மற்றும் Text-இல் இணைக்கப்படும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงและข้อความยังคงอยู่ในอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses ve metin cihazda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос і текст залишаються на пристрої."
          }
        },
