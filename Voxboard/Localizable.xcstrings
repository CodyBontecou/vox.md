            "value": "捕捉附件超過 250 MB 的總安全限制。"
          }
        }
      }
    },
    "Capture canceled because this route requires an origin-time location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء الالتقاط لأن هذا المسار يتطلب الموقع وقت الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার বাতিল হয়েছে, কারণ এই রুটের জন্য উৎস-সময়ের লোকেশন প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassung abgebrochen, da diese Route einen Standort zum Erfassungszeitpunkt erfordert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture canceled because this route requires an origin-time location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura cancelada porque esta ruta requiere la ubicación del momento de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture annulée, car ce parcours exige la position au moment de la capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर रद्द किया गया, क्योंकि इस रूट को मूल-समय की लोकेशन चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan dibatalkan karena rute ini memerlukan lokasi saat tangkapan dibuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisizione annullata perché questo percorso richiede la posizione al momento dell’acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルートでは記録時の位置情報が必要なため、キャプチャはキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 루트에는 캡처 시점의 위치가 필요하므로 캡처가 취소되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastlegging geannuleerd omdat deze route een locatie op het moment van vastleggen vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowano przechwycenie, ponieważ ta trasa wymaga lokalizacji z chwili przechwycenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura cancelada porque esta rota exige a localização do momento de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват отменен: этому маршруту нужна геопозиция в момент захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வழித்தடத்திற்கு தொடக்க நேர இருப்பிடம் தேவைப்படுவதால் பிடிப்பு ரத்துசெய்யப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการจับภาพแล้วเนื่องจากเส้นทางนี้ต้องใช้ตำแหน่ง ณ เวลาต้นทาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rota kaynak zamanı konumu gerektirdiği için yakalama iptal edildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоплення скасовано: цьому маршруту потрібна геопозиція в момент захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر منسوخ کر دیا گیا کیونکہ اس روٹ کو آغاز کے وقت کا مقام درکار ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy bản ghi nhanh vì lộ trình này yêu cầu vị trí tại thời điểm ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集已取消，因为此路线需要采集时的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取已取消，因為此路線需要擷取當下的位置。"
          }
        }
      }
    },
