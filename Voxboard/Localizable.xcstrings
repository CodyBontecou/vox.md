          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo một mẫu để tái sử dụng tiền tố, frontmatter và hậu tố trên Presets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个模板,在预设中重复使用前缀、前置和后缀。"
