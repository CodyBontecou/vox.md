    "Start or stop a temporary transcription. Immediate results are copied; deferred results wait for an explicit Copy action in Activity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء أو إيقاف نسخ صوتي مؤقت. تُنسخ النتائج الفورية؛ وتنتظر النتائج المؤجلة إجراء «نسخ» صريحًا في «النشاط»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি অস্থায়ী ট্রান্সক্রিপশন শুরু বা বন্ধ করুন। তাৎক্ষণিক ফলাফল কপি হয়; স্থগিত ফলাফল কার্যকলাপ-এ স্পষ্ট ‘কপি’ অ্যাকশনের জন্য অপেক্ষা করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet oder stoppt eine temporäre Transkription. Sofortige Ergebnisse werden kopiert; zurückgestellte Ergebnisse warten in „Aktivität“ auf eine ausdrückliche Kopieraktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start or stop a temporary transcription. Immediate results are copied; deferred results wait for an explicit Copy action in Activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o detiene una transcripción temporal. Los resultados inmediatos se copian; los aplazados esperan una acción Copiar explícita en Actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez ou arrêtez une transcription temporaire. Les résultats immédiats sont copiés ; les résultats différés attendent une action Copier explicite dans Activité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्थायी ट्रांसक्रिप्शन शुरू या बंद करें। तुरंत मिले परिणाम कॉपी हो जाते हैं; स्थगित परिणाम गतिविधि में स्पष्ट कॉपी ऐक्शन की प्रतीक्षा करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai atau hentikan transkripsi sementara. Hasil langsung disalin; hasil yang ditunda menunggu tindakan Salin eksplisit di Aktivitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia o interrompi una trascrizione temporanea. I risultati immediati vengono copiati; quelli rinviati attendono un’azione Copia esplicita in Attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的な文字起こしを開始または停止します。すぐに処理された結果はコピーされ、後で処理された結果はアクティビティで明示的に「コピー」を選ぶまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 전사를 시작하거나 중단합니다. 즉시 처리된 결과는 복사되며, 지연된 결과는 활동에서 직접 복사할 때까지 대기합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start of stop een tijdelijke transcriptie. Directe resultaten worden gekopieerd; uitgestelde resultaten wachten in Activiteit tot je ze expliciet kopieert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij lub zatrzymaj tymczasową transkrypcję. Natychmiastowe wyniki są kopiowane; odroczone wyniki czekają w Aktywności na jawną akcję Kopiuj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie ou pare uma transcrição temporária. Resultados imediatos são copiados; resultados adiados aguardam uma ação Copiar explícita na Atividade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать или остановить временную транскрипцию. Мгновенные результаты копируются; отложенные ждут явного действия «Скопировать» в разделе «Активность»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்காலிக உரைமாற்றத்தைத் தொடங்கு அல்லது நிறுத்து. உடனடி முடிவுகள் நகலெடுக்கப்படும்; ஒத்திவைக்கப்பட்ட முடிவுகள் செயல்பாட்டில் வெளிப்படையான நகலெடு செயலுக்காகக் காத்திருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มหรือหยุดการถอดเสียงชั่วคราว ผลลัพธ์ทันทีจะถูกคัดลอก ส่วนผลลัพธ์ที่เลื่อนไว้จะรอการคัดลอกด้วยตนเองในกิจกรรม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçici bir transkripsiyonu başlatın veya durdurun. Anında sonuçlar kopyalanır; ertelenen sonuçlar Etkinlik'te açık bir Kopyala eylemini bekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почати або зупинити тимчасову транскрипцію. Миттєві результати копіюються; відкладені чекають явної дії «Скопіювати» в розділі «Активність»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عارضی ٹرانسکرپشن شروع یا بند کریں۔ فوری نتائج کاپی ہو جاتے ہیں؛ مؤخر نتائج سرگرمی میں واضح کاپی کارروائی کا انتظار کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu hoặc dừng một lần chép lời tạm thời. Kết quả tức thì được sao chép; kết quả hoãn lại chờ bạn chủ động chọn Sao chép trong Hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始或停止临时转录。即时结果会被拷贝；延后的结果会等待你在“活动”中明确执行“拷贝”操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始或停止暫時轉錄。即時結果會被拷貝；延後的結果會等待你在「活動」中明確執行「拷貝」動作。"
          }
        }
      }
    },
