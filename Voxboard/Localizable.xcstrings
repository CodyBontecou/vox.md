    "Your recording remains safe while it moves to iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الحفاظ على سلامة تسجيلك أثناء نقلها إلى iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রেকর্ডটি নিরাপদ থাকবে যখন এটি এগিয়ে যায় iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Aufnahme bleibt sicher, während sie zum iPhone übertragen wird."
