    "Microphone access is required to attach a voice recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الوصول إلى ميكروفون لإدخال تسجيل صوت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি শব্দ রেকর্ডিং যোগ করার জন্য মাইক্রোফোন অ্যাক্সেস প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Anhängen einer Sprachaufnahme ist Mikrofonzugriff erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is required to attach a voice recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere acceso al micrófono para conectar una grabación de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un microphone est nécessaire pour enregistrer une voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक वॉच रिकॉर्डिंग जोड़ने के लिए माइक्रोफोन पहुंच की आवश्यकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon diperlukan untuk menempelkan rekaman suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario un accesso al microfono per collegare una registrazione vocale."
          }
        },
        "ja": {
