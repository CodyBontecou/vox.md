    "Clean prose, create a todo checklist, format meeting notes, or follow your custom instruction.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظيف النار، إنشاء قائمة التحقق من كل شيء، وتصميم رسائل الاجتماع، أو اتبع إرشاداتك المخصصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিষ্কার প্রসেস, একটি টোটো চেকলিস্ট তৈরি করুন, মিটিং নোট ফরম্যাট করুন, বা আপনার কাস্টম নির্দেশাবলী অনুসরণ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text überarbeiten, eine Todo-Checkliste erstellen, Besprechungsnotizen formatieren oder Ihrer benutzerdefinierten Anweisung folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean prose, create a todo checklist, format meeting notes, or follow your custom instruction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpiar prosa, crear una lista de verificación todo, formatear notas de reunión o seguir las instrucciones personalizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer la prose, créer une liste de contrôle todo, formater les notes de réunion ou suivre vos instructions personnalisées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साफ प्रोजेक्ट, एक टोक्यो चेकलिस्ट बनाएं, मीटिंग नोट्स प्रारूप करें, या अपने कस्टम निर्देशों का पालन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersihkan prosa, buat daftar cek todo, format catatan pertemuan, atau ikuti instruksi kustom Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulire la prosa, creare una checklist todo, formattare le note di riunione o seguire le istruzioni personalizzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "清潔な小説を、Todo チェックリストを作成し、会議ノートをフォーマットしたり、カスタムの指示に従ったりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨끗한 프로즈, todo 체크리스트 만들기, 모임 노트를 형식하거나 사용자 지정 지침을 따르십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schoon prose, maak een todo-checklist, formatter vergadernootjes of volg uw aangepaste instructies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyste prozy, utwórz listę kontrolną todo, sformatuj notatki z spotkań lub postępuj zgodnie z niestandardowymi instrukcjami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe a prosa, crie uma lista de verificação todo, formate as notas de reunião ou siga suas instruções personalizadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чистая проза, создайте контрольный список todo, форматируйте заметки о встречах или следуйте инструкциям по набору."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean prose, create a todo checklist, format meeting notes, or follow your custom instructions. - சுத்தமான புரட்சியை, ஒரு todo சோதனை பட்டியல் உருவாக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทําความสะอาดโปรโซสสร้างรายการตรวจสอบ todo รูปแบบบันทึกการประชุมหรือทําตามคําแนะนําที่กําหนดเองของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temiz prosa, todo kontrol listesi oluşturun, toplantı notlarını biçimlendirin veya özel talimatlarınızı izleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чисті прози, створити перевірний список todo, форматувати нотатки на засідання або виконувати ваші індивідуальні інструкції."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صاف پروز، ایک ٹوٹو چیک لسٹ بنائیں، اجلاس نوٹ فارمیٹ کریں یا اپنی مرضی کے لئے ہدایات کی پیروی کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
