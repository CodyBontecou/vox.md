    "No activity matches “%@”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد نشاط يطابق «%@»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”-এর সাথে কোনো কার্যকলাপ মেলে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Aktivität entspricht „%@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No activity matches “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna actividad coincide con “%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune activité ne correspond à « %@ »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” से कोई गतिविधि मेल नहीं खाती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada aktivitas yang cocok dengan “%@”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna attività corrisponde a “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に一致するアクティビティはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’와(과) 일치하는 활동이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen activiteit komt overeen met ‘%@‘."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna aktywność nie pasuje do „%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma atividade corresponde a “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет активности, соответствующей «%@»."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” உடன் பொருந்தும் செயல்பாடு இல்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีกิจกรรมที่ตรงกับ “%@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ile eşleşen etkinlik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає активності, що відповідає «%@»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی سرگرمی “%@” سے مماثل نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có hoạt động nào khớp với “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有与“%@”匹配的活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有與「%@」相符的活動。"
          }
        }
      }
    },
