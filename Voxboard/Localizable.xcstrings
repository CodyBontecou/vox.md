    "Relative to the unified Markdown destination. Leave blank to use its default attachment folder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعلق بالهدف المشترك Markdown. تترقب الفوركس لتستخدم ملف ملف المرفق الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযুক্তির সাথে সম্পর্কিত Markdown ডেস্টিভেন্ট ফাইলটি ফাঁকা রাখুন তার ডিফল্ট ফাইল ফোল্ডার ব্যবহার করতে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relativ zum zusammengeführten Markdown-Ziel. Leer lassen, um den Standard-Anhangordner zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relative to the unified Markdown destination. Leave blank to use its default attachment folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En relación con la unidad Markdown El destino. Dejar vacío para usar su carpeta de archivos adjuntos por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ce qui concerne l’unité Markdown La destination . Laisser vide pour utiliser son dossier d'adhésion par défaut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संयुक्त के संबंध में Markdown गंतव्य डिफ़ॉल्ट फ़ोल्डर का उपयोग करने के लिए खाली छोड़ दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terkait dengan Unifikasi Markdown Untuk tujuan Tinggalkan kosong untuk menggunakan folder attachment default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "rispetto al comune Markdown La destinazione. Lascia vuoto per utilizzare la cartella allegati predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統一に関して Markdown 目的地 空のままにして、デフォルトの添付ファイルフォルダを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유니버드에 관한 내용 Markdown 목적지 빈 상태로 남겨두면 기본 첨부 파일을 사용합니다.Leave empty to use its default attachment folder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In relatie tot de verenigde Markdown De bestemming . Laat leeg om de standaard bijlage map te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W stosunku do zjednoczonego Markdown docelowego celu. Pozostaw pustą, aby użyć folderu załączników domyślnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em relação ao Unificado Markdown O destino . Deixe em branco para usar sua pasta de anexos padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В отношении единого Markdown в дестинации. Оставьте пустую для использования ее папки по умолчанию."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Unified யைப் பற்றியும் Markdown இலக்கு தங்கள் சொந்த ஊடகத்தை பயன்படுத்தும் வகையில்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกี่ยวกับสหภาพ Markdown จุดหมายปลายทาง ให้ว่างเพื่อใช้โฟลเดอร์ที่แนบมาเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleşik ile ilgili Markdown Amacımız var Varsayılan dosyayı kullanmak için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щодо об'єднаної Markdown Доріжка Залишити порожнім, щоб використовувати його за замовчуванням папку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متحد کے بارے میں Markdown مقصود کے لئے. اپنے ڈپازٹ ملحقہ فارم کا استعمال کرنے کے لئے خالی چھوڑیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên quan đến thống nhất Markdown đích đến Để lại trống để sử dụng thư mục đính kèm mặc định của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与统一的关系 Markdown 目的地 空白,使用其默认附件文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與統一的關係 Markdown 目的地 空白,使用其默認附件文件夾。"
          }
        }
      }
    },
