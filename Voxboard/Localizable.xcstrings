    "Improves casing and punctuation on device while preserving meaning and Markdown structure.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحسين الحفرة والخسارة على الجهاز مع الحفاظ على المعنى وملء Markdown الهيكل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসের কাস্টম এবং পুনরাবৃত্তি উন্নত করে, যখন অর্থ এবং Markdown কাঠামো"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessert Groß-/Kleinschreibung und Zeichensetzung auf dem Gerät, ohne Bedeutung und Markdown-Struktur zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improves casing and punctuation on device while preserving meaning and Markdown structure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora el casamiento y la puntuación en el dispositivo, al tiempo que conserva el significado y Markdown La estructura ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliore le casier et la ponctuation sur l'appareil tout en conservant le sens et la signification Markdown La structure ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर कैशिंग और अंकन में सुधार, जबकि अर्थ और Markdown संरचना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meningkatkan penutup dan titik pada perangkat sambil mempertahankan makna dan Markdown Struktur yang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Migliora il cassi e la punteggiatura sul dispositivo, pur mantenendo il significato e Markdown La struttura ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのキャッシングと点字を改善し、意味と Markdown 構造"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장치의 캐싱 및 점수를 개선하면서 의미와 Markdown 구조를"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbetert het omhulsel en de punctuatie op het apparaat, terwijl betekenis en Markdown De structuur ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprawia obudowę i punktację urządzenia przy zachowaniu znaczenia i Markdown Struktura"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhora a casagem e pontuação no dispositivo, preservando o significado e Markdown estruturação ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшает корпус и пунктуацию на устройстве, сохраняя при этом смысл и Markdown Структура"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதாவது, அலுவலகத்தில் உள்ள பல்வேறு வகையான கட்டிடங்கள் மற்றும் Markdown அறையணி"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับปรุงการปกคลุมและจุดหมายบนอุปกรณ์ในขณะที่รักษาความหมายและ Markdown โครงสร้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazda kutu ve pürüzsüzlük geliştirir, anlamı korur ve Markdown Yapılandırma yapısı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покращує обробку і пунктування пристрою, зберігаючи значення та Markdown Структура"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آلہ پر اسٹاک اور پوائنٹس کو بہتر بناتا ہے جبکہ معنی اور Markdown ساخت کا"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cải thiện hộp và điểm trên thiết bị trong khi giữ lại ý nghĩa và Markdown cấu trúc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改进设备上的装置和点击,同时保持意义和 Markdown 结构。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改進設備上的裝置和點擊,同時保持意義和 Markdown 結構。"
          }
        }
      }
    },
