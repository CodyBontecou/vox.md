    "Choose individual or Family lifetime access for unlimited local Capture and private, on-device transcription.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الوصول الفردي أو العائلية لمدى الحياة لإنشاء إخراج محلي غير محدود ومقاطع خاصة على الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যক্তিগত বা পরিবারের লাইফটাইম অ্যাক্সেস নির্বাচন করুন সীমাহীন স্থানীয় ক্যাপচার এবং ব্যক্তিবাহী, ডিভাইস ট্রান্সপ্লিকেশন জন্য।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie lebenslangen Einzel- oder Familienzugriff für unbegrenzte lokale Erfassung und private Transkription auf dem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose individual or Family lifetime access for unlimited local Capture and private, on-device transcription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione el acceso individual o familiar para un acceso local ilimitado y la transcripción privada en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'accès à vie individuel ou familial pour une capture locale illimitée et une transcription privée sur appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असीमित स्थानीय कैप्चर और निजी, डिवाइस पर ट्रांसक्रिप्शन के लिए व्यक्तिगत या परिवार जीवनकाल तक पहुंच का चयन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih akses seumur hidup individu atau Keluarga untuk capture lokal tanpa batas dan transkrip pribadi, pada perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliere l'accesso individuale o familiare per tutta la vita per la registrazione locale illimitata e la trascrizione privata su dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人または家族のライフタイムアクセスを選択して、無制限のローカルキャプチャとデバイス上のプライベートトランスクリプションを取得できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 또는 가족 라이프티브 액세스를 선택하여 무제한 로컬 캡처 및 개인, 장치 전송을 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies voor individuele of gezinsleven toegang voor onbeperkte lokale opname en privé-transcriptie op het apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz dostęp indywidualny lub rodzinny na całe życie, aby uzyskać nieograniczone lokalne przechwytywanie i prywatną transkrypcję na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o acesso individual ou familiar para captura local ilimitada e transcrição privada no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите индивидуальный или семейный доступ на всю жизнь для неограниченного локального захвата и частной транскрипции на устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு தனிப்பட்ட அல்லது குடும்ப வாழ்க்கை அணுகல் தேர்வு எளிதான இடத்தில் Capture மற்றும் தனிப்பட்ட, சாதனத்தில் transcription."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกการเข้าถึงแบบส่วนตัวหรือแบบครอบครัวตลอดชีวิตสําหรับการจับภาพในท้องถิ่นไม่ จํากัด และการถ่ายโอนข้อมูลส่วนตัวบนอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırsız yerel Kapatma ve özel, aygıt transcription için bireysel veya Aile ömür boyu erişim seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть індивідуальний або сімейний дохід для необмеженого локального захоплення та приватного транскрипту на пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انفرادی یا خاندان کی زندگی کے لئے رسائی کا انتخاب کریں، غیر محدود مقامی کٹ اور ذاتی، آلات پر ٹرانسپیشن."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn truy cập cá nhân hoặc Gia đình suốt đời cho không giới hạn Capture địa phương và riêng tư, trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择个人或家庭终身访问,获取无限的本地捕捉和私人设备转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇個人或家庭終身訪問,獲取無限的本地捕捉和私人設備轉錄。"
          }
        }
      }
    },
    "Choose the Capture Preset this control uses when starting a recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديد الإعدادات المحددة التي يستخدمها هذا التحكم عند بدء تسجيل."
          }
        },
        "bn": {
          "stringUnit": {
