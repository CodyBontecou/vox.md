    "Voice input from the Vox.md keyboard now transcribes into your text field without also activating or sending an in-app Capture.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إرسال الدخول الصوتية من لوحة المفاتيح Vox.md الآن إلى مجلد النص الخاص بك دون أيضًا تشغيل أو إرساله في التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভয়েস ইনপুট থেকে Vox.md কীবোর্ড এখন আপনার টেক্সট ফিল্ডে একটি অ্যাপ্লিকেশন ক্যাপচার সক্রিয় বা পাঠানোর ছাড়া ট্রান্সক্রিপ্ট করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracheingabe über die Vox.md-Tastatur transkribiert jetzt direkt in Ihr Textfeld, ohne zusätzlich eine In-App-Erfassung zu starten oder zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input from the Vox.md keyboard now transcribes into your text field without also activating or sending an in-app Capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada de voz de la Vox.md El teclado ahora transcribe a su campo de texto sin activar o enviar una captura en la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée vocale de la Vox.md Le clavier transcrit désormais dans votre champ de texte sans également activer ou envoyer une capture dans l’application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज से आती है Vox.md अब कीबोर्ड आपके पाठ क्षेत्र में अनुवाद करता है, बिना भी सक्रिय करने या ऐप में कैप्चर भेजने के।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "input suara dari Vox.md Keyboard sekarang mencatat ke dalam bidang teks Anda tanpa juga mengaktifkan atau mengirimkan Capture dalam aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ingresso vocale da Vox.md Il tastierino ora trascrive nel campo di testo senza attivare o inviare un'immagine in-app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力から Vox.md キーボードは、アプリ内キャプチャを有効化したり送信することなくテキストフィールドに転写します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input from the 소리 입구 Vox.md 이제 키보드가 앱 내 캡처를 활성화하거나 보낼 필요 없이 텍스트 필드에 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De steminvoer van de Vox.md Het toetsenbord transcribeert nu naar uw tekstveld zonder ook een in-app Capture te activeren of te verzenden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wejście głosowe z Vox.md klawiatura teraz transkrybuje do pola tekstowego bez również aktywacji lub wysyłania w aplikacji Capture."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A entrada de voz do Vox.md O teclado agora transcreve para o seu campo de texto sem também ativar ou enviar uma captura no aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовой вход из Vox.md клавиатура теперь транскриптирует в ваше текстовое поле, не активируя или не отправляя запись в приложении."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input - இன் விளைவு Vox.md இப்போது உங்கள் கணிப்பு அட்டவணைக்கு ஒரு பதிவிறக்க அல்லது ஒரு ஆப்-அப் Capture அனுப்பும் இல்லாமல்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงเสียงจาก Vox.md คีย์บอร์ดตอนนี้จะถ่ายโอนลงในฟิลด์ข้อความของคุณโดยไม่ต้องเปิดใช้งานหรือส่งการจับภาพภายในแอพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses girişinden gelen Vox.md Klavye artık uygulama içi bir Capture etkinleştirmeden veya göndermeden metin alanınıza transkriptiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос вхід від Vox.md клавіатура тепер транскрибує в текстове поле без також активування або надсилання у програмі Capture."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سے آواز کے اندرونی Vox.md ٹیبلڈ اب آپ کے متن کے میدان میں ٹرانسفر کرتا ہے بغیر بھی فعال یا ایپ میں ایک کٹنگ بھیجنے کے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input từ the Vox.md Bây giờ bàn phím sẽ chuyển đổi sang trường văn bản của bạn mà không kích hoạt hoặc gửi một Capture trong ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自声的输入 Vox.md 键盘现在转录到文本字段,而不同时激活或发送应用中的 Capture。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自聲的輸入 Vox.md 鍵盤現在轉錄到文本字段,而不同時激活或發送應用中的 Capture。"
          }
        }
      }
    },
