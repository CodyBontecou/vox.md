        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกแล้วเนื่องจากเส้นทางต้องใช้ตำแหน่ง ณ เวลาต้นทาง"
          }
        },
        "tr": {
