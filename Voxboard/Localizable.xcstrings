    "Resume to continue, Stop to save, or Cancel to delete.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمرار التمديد، وقف حفظ، أو إلغاء إزالة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চলতে শুরু করুন, সঞ্চয় বন্ধ করুন, বা বাতিল করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Fortsetzen wiederaufnehmen, zum Sichern stoppen oder zum Löschen abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume to continue, Stop to save, or Cancel to delete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar para continuar, dejar de guardar o cancelar para eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez pour continuer, Arrêtez de sauvegarder ou Annuler pour supprimer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए फिर से, सहेजें बंद करें, या हटाने के लिए रद्द करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan untuk melanjutkan, Hentikan menyimpan, atau Batalkan untuk menghapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi per continuare, smetti di salvare o cancella di eliminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存を停止するか、削除をキャンセルするかを続ける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 하려면 다시 니다, 저장 중지 또는 삭제를 취소 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga door om verder te gaan, Stop opslaan of Annuleren om te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wznowienie, aby kontynuować, zatrzymać zapisywanie lub Anuluj, aby usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue para continuar, Pare de salvar ou Cancelar para excluir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновить, чтобы продолжить, прекратить сохранять или аннулировать для удаления."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் மீண்டும், நிறுத்த அல்லது காப்புரிமை இழக்க."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทํางานต่อเพื่อต่อการหยุดการบันทึกหรือยกเลิกการลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için devam edin, kaydetmeyi durdurun veya silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишити, припинити зберігання або скасувати для видалення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاری کرنے کے لئے دوبارہ، محفوظ کرنے سے روکنے، یا حذف کرنے کے لئے لٹکاؤ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục để tiếp tục, dừng lưu hoặc hủy để xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续继续,停止保存或取消删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續繼續,停止保存或取消刪除。"
          }
        }
      }
    },
