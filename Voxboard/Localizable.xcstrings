    "Say it.\nIt lands in\nMarkdown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قلها.\nوتصل إلى\nMarkdown."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বলুন।\nতা পৌঁছে যাবে\nMarkdown-এ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagen Sie es.\nEs landet\nin Markdown."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say it.\nIt lands in\nMarkdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilo.\nY aparece en\nMarkdown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-le.\nIl arrive\nen Markdown."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलिए।\nयह पहुँचता है\nMarkdown में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapkan.\nLangsung jadi\nMarkdown."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dillo.\nFinisce\nin Markdown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すだけ。\nMarkdownに\n届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하기만 하면\nMarkdown으로\n저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg het.\nHet komt in\nMarkdown."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz to.\nTrafi do\nMarkdown."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale.\nE vira\nMarkdown."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите.\nИ это станет\nMarkdown."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சொல்லுங்கள்.\nஅது Markdown இல்\nசேரும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูดออกมา\nแล้วจะไปอยู่ใน\nMarkdown"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söyleyin.\nMarkdown'a\nyazılsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть.\nІ це стане\nMarkdown."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بولیں۔\nیہ پہنچ جاتا ہے\nMarkdown میں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói ra.\nThành ngay\nMarkdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说出来。\n就会变成\nMarkdown。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說出來。\n就會變成\nMarkdown。"
          }
        }
      }
    },
    "Scanned document": {
