    "Start or stop the persistent listening session used by the Vox.md keyboard. This is not another attachment mode.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء أو إيقاف جلسة الاستماع المستمرة التي تستخدمها لوحة مفاتيح Vox.md. هذا ليس وضع إرفاق آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md কীবোর্ডের ব্যবহৃত স্থায়ী শোনার সেশন শুরু বা বন্ধ করুন। এটি আরেকটি অ্যাটাচমেন্ট মোড নয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet oder stoppt die dauerhafte Zuhörsitzung der Vox.md-Tastatur. Dies ist kein weiterer Anhangmodus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start or stop the persistent listening session used by the Vox.md keyboard. This is not another attachment mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o detiene la sesión de escucha persistente que usa el teclado de Vox.md. No es otro modo de adjuntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez ou arrêtez la session d’écoute persistante utilisée par le clavier Vox.md. Il ne s’agit pas d’un autre mode de pièce jointe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md कीबोर्ड द्वारा उपयोग किया जाने वाला लगातार सुनने का सेशन शुरू या बंद करें। यह कोई दूसरा अटैचमेंट मोड नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai atau hentikan sesi mendengarkan persisten yang digunakan oleh papan ketik Vox.md. Ini bukan mode lampiran lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia o interrompi la sessione di ascolto persistente usata dalla tastiera Vox.md. Non è un’altra modalità di allegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.mdキーボードで使用する常時聞き取りセッションを開始または停止します。これは添付モードではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 키보드에서 사용하는 지속 듣기 세션을 시작하거나 중단합니다. 이것은 또 다른 첨부 모드가 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start of stop de blijvende luistersessie van het Vox.md-toetsenbord. Dit is geen extra bijlagemodus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij lub zatrzymaj trwałą sesję słuchania używaną przez klawiaturę Vox.md. Nie jest to kolejny tryb załączania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie ou pare a sessão de escuta persistente usada pelo teclado do Vox.md. Este não é outro modo de anexo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск или остановка постоянного сеанса прослушивания для клавиатуры Vox.md. Это не еще один режим вложений."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md விசைப்பலகை பயன்படுத்தும் நிலையான கேட்கும் அமர்வைத் தொடங்கு அல்லது நிறுத்து. இது மற்றொரு இணைப்புப் பயன்முறை அல்ல."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มหรือหยุดเซสชันการฟังต่อเนื่องที่แป้นพิมพ์ Vox.md ใช้ นี่ไม่ใช่โหมดการแนบอีกแบบหนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md klavyesinin kullandığı kalıcı dinleme oturumunu başlatın veya durdurun. Bu başka bir ek modu değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск або зупинка постійного сеансу прослуховування для клавіатури Vox.md. Це не ще один режим вкладень."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md کی بورڈ کا مستقل سننے کا سیشن شروع یا بند کریں۔ یہ کوئی اور منسلکہ موڈ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu hoặc dừng phiên nghe liên tục mà bàn phím Vox.md sử dụng. Đây không phải là một chế độ đính kèm khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始或停止 Vox.md 键盘使用的持续聆听会话。这不是另一种附件模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始或停止 Vox.md 鍵盤使用的持續聆聽工作階段。這不是另一種附件模式。"
          }
        }
      }
    },
    "Start processing as soon as the microphone is free.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء المعالجة بمجرد أن يصبح الميكروفون متاحًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোন খালি হলেই প্রসেসিং শুরু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verarbeitung starten, sobald das Mikrofon frei ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start processing as soon as the microphone is free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a procesar en cuanto el micrófono esté libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer le traitement dès que le micro est libre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन खाली होते ही प्रोसेसिंग शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai memproses segera setelah mikrofon tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia l’elaborazione non appena il microfono è libero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクが空き次第、処理を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 사용할 수 있게 되는 즉시 처리를 시작합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met verwerken zodra de microfoon vrij is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij przetwarzanie, gdy tylko mikrofon będzie wolny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a processar assim que o microfone fica livre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинать обработку, как только микрофон освободится."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்ரோஃபோன் இலவசமானதும் செயலாக்கத்தைத் தொடங்கு."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มประมวลผลทันทีที่ไมโครโฟนว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon boşalır boşalmaz işlemeye başla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починати обробку, щойно мікрофон звільниться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مائیکروفون فارغ ہوتے ہی پروسیسنگ شروع کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu xử lý ngay khi micrô rảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风空闲后立即开始处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風空閒後立即開始處理。"
          }
        }
      }
    },
