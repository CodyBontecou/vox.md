    "Keeps typed Markdown, OCR, and voice text exactly as captured. Static frontmatter and route settings still apply.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل Markdown، OCR، والرسائل الصوتية المكتوبة على النحو المطلوب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাইপ রাখুন Markdown, অক্লান্ত যেমনটা কপি করেছিলেন ঠিক তেমনিই লেখা ছিল। স্ট্যাটিক ফ্রন্টম্যাট এবং রুট সেটিংস এখনও প্রযোজ্য।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
