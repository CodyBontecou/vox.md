    "Retry sends the saved JSON only. It does not write another note or audio attachment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيد «إعادة المحاولة» إرسال ملف JSON المحفوظ فقط. ولا تكتب ملاحظة أخرى أو مرفقًا صوتيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার চেষ্টা করলে শুধু সেভ করা JSON পাঠানো হয়। এটি আরেকটি নোট বা অডিও অ্যাটাচমেন্ট লেখে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Erneut versuchen“ sendet nur das gesicherte JSON. Es wird keine weitere Notiz und kein Audioanhang geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry sends the saved JSON only. It does not write another note or audio attachment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar solo envía el JSON guardado. No escribe otra nota ni otro archivo de audio adjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer envoie uniquement le JSON enregistré. Aucune autre note ni pièce jointe audio n’est écrite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर से प्रयास करें केवल सहेजा गया JSON भेजता है। यह कोई दूसरा नोट या ऑडियो अटैचमेंट नहीं लिखता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba Lagi hanya mengirim JSON yang tersimpan. Tidak menulis catatan atau lampiran audio lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova invia solo il JSON salvato. Non scrive un’altra nota o un altro allegato audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行では保存済みのJSONのみを送信します。メモやオーディオの添付ファイルは書き込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시도는 저장된 JSON만 보냅니다. 메모나 오디오 첨부 파일을 다시 기록하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Probeer opnieuw’ verstuurt alleen de bewaarde JSON. Er wordt geen nieuwe notitie of audiobijlage geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponów wysyła tylko zapisany JSON. Nie zapisuje kolejnej notatki ani załącznika audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar novamente envia apenas o JSON salvo. Não escreve outra nota nem outro anexo de áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повтор отправляет только сохраненный JSON. Новая заметка или аудиовложение не записываются."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் முயற்சிப்பது சேமித்த JSON ஐ மட்டுமே அனுப்பும். அது வேறொரு குறிப்பையோ ஒலி இணைப்பையோ எழுதாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลองอีกครั้งจะส่งเฉพาะ JSON ที่บันทึกไว้ ไม่เขียนโน้ตหรือไฟล์เสียงแนบเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden Dene yalnızca kayıtlı JSON'u gönderir. Başka bir not veya ses eki yazmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повтор надсилає лише збережений JSON. Нова нотатка чи аудіовкладення не записуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ کوشش صرف محفوظ JSON بھیجتی ہے۔ یہ کوئی اور نوٹ یا آڈیو منسلکہ نہیں لکھتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử lại chỉ gửi JSON đã lưu. Không ghi thêm ghi chú hay tệp âm thanh đính kèm nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“重试”仅发送已保存的 JSON，不会再写入笔记或音频附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「重試」僅傳送已儲存的 JSON，不會再寫入筆記或音訊附件。"
          }
        }
      }
    },
