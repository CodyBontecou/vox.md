        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt Capture Preset để sử dụng cho các bản ghi bắt đầu bằng điều khiển này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
