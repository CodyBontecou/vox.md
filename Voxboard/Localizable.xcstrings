        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সপ্লোর পরে স্পিকার ট্যাবলেট যোগ করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprecherkennzeichnungen werden nach der Transkription hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker labels are added after transcription."
          }
        },
