          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک مکمل ایموجی درج کریں۔ کریکٹر ویور کھولنے کے لیے Control–Command–Space استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập một emoji hoàn chỉnh. Dùng Control–Command–Phím cách để mở Trình xem ký tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入一个完整的表情符号。按下 Control–Command–空格键可打开字符检视器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
