          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva su Watch, la sincronizzazione non è riuscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチで保存しましたが、sync が失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
