    "Capturing %@ with separate System and Mic audio.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التقاط %@ مع صوت منفصل للنظام والميكروفون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলাদা সিস্টেম ও মাইক অডিওসহ %@ ক্যাপচার হচ্ছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme von „%@“ mit separatem System- und Mikrofonaudio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturing %@ with separate System and Mic audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturando %@ con audio del sistema y del micrófono por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture de %@ avec audio système et micro séparés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलग सिस्टम और माइक ऑडियो के साथ %@ कैप्चर किया जा रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merekam %@ dengan audio Sistem dan Mik yang terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisizione di %@ con audio di sistema e microfono separati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をシステムとマイクのオーディオに分けてキャプチャ中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템과 마이크 오디오를 분리하여 %@ 캡처 중."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt vastgelegd met aparte systeem- en microfoonaudio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechwytywanie: %@ z osobnym audio systemu i mikrofonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturando %@ com áudio do sistema e do microfone separados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват %@ с раздельным звуком системы и микрофона."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனித்தனி கணினி மற்றும் மைக் ஒலியுடன் %@ பிடிக்கப்படுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังจับภาพ %@ โดยแยกเสียงระบบและไมค์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ayrı Sistem ve Mikrofon sesiyle yakalanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоплення %@ з окремим звуком системи та мікрофона."
          }
        },
        "ur": {
