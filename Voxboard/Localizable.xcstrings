        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tersebut berhenti ketika Vox.md meninggalkan latar depan. Audio sudah siap untuk ditambahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione si è interrotta quando Vox.md Lasciate il fronte. L’audio è pronto per aggiungere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音が止まるときに Vox.md 前線を離れた。 オーディオは追加の準備が整いました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 중단되었을 때 Vox.md 앞선을 떠나게 되었습니다. 오디오는 추가할 준비가 되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname stopte toen Vox.md De voorgrond verlaten. De audio is klaar om toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie zostało przerwane, gdy Vox.md Zostawił przedstawienie Audio jest gotowe do dodania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi interrompida quando Vox.md Deixando o primeiro plano. O áudio está pronto para ser adicionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись прекращается, когда Vox.md Оставьте передний план. Аудио готов к добавлению."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுத்து முடிந்துவிட்டது எப்போது Vox.md முன்னேற்றம் விட்டு Audio Added செய்யவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกหยุดเมื่อ Vox.md ปิดหน้า ออดิชั่นพร้อมที่จะเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar durduğunda Vox.md Önceki İçerikBırakın öncü. Audio eklemeye hazır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис припинився, коли Vox.md Залишив передній план. Аудіо готовий до додавання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈ ختم ہونے کے بعد Vox.md آگے بڑھنے کا موقع آڈیو شامل کرنے کے لئے تیار ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đĩa ghi âm ngừng khi Vox.md rời khỏi mặt trước. Audio sẵn sàng để thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音停止时 Vox.md 离开前沿。 音频准备好添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音停止時 Vox.md 離開前沿。 音頻準備好添加。"
          }
        }
      }
    },
    "Recording stopped, but its file could not be deleted from this Watch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم وقف تسجيلها، ولكن لم يتم حذف ملفها من هذا الساعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং বন্ধ হয়ে গেল, কিন্তু এই ঘড়ি থেকে তার ফাইলটি মুছে ফেলা সম্ভব হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde gestoppt, aber ihre Datei konnte nicht von dieser Watch gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped, but its file could not be deleted from this Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se detuvo, pero su archivo no pudo ser eliminado de este Reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement a été arrêté, mais son fichier ne pouvait pas être supprimé de cette montre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग बंद हो गई, लेकिन इस घड़ी से इसकी फाइल को हटाया नहीं जा सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman dihentikan, tetapi filenya tidak dapat dihapus dari Watch ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è stata interrotta, ma il suo file non è stato possibile eliminare da questo orologio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は停止しましたが、この時計からファイルを削除することはできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 중단되었지만 이 시계에서 파일을 삭제할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname werd gestopt, maar het bestand kon niet worden verwijderd uit deze Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie zostało zatrzymane, ale jego pliku nie można usunąć z tego zegarka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação parou, mas o arquivo não pôde ser excluído deste Relógio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись прекращена, но ее файл не удалили из этого Часа."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவை எழுதிவிட்டு, இந்த பதிவை வெளியிட முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกหยุด แต่ไฟล์ของมันไม่สามารถลบได้จากนาฬิกานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt durdu, ancak dosyası bu Saat'ten silinemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис зупинився, але його файл не можна було видалити з цього годинника."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ بند ہو گئی ہے، لیکن اس کی فائل اس گھڑی سے حذف نہیں کی جا سکتی."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm đã dừng lại, nhưng tệp của nó không thể bị xóa khỏi Đồng hồ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制停止了,但无法从此手表中删除该文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製停止了,但無法從此手錶中刪除該文件。"
          }
        }
      }
    },
