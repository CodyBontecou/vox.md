        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dostęp do aplikacji przez całe życie jest nieograniczony, a obsługa usługi Apple Family Sharing jest możliwa."
          }
        },
        "pt-BR": {
