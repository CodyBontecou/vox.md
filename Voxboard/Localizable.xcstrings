          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar {period} Para o dia a dia escolhido, Semana do Dia, mensalidade , Quartos de trabalho, ou de um bucket anual. Os tokens também incluem {date}, {year}, {YR} (dois anos de idade) {month}, {day}, e {week}."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте {period} Для выбранного дня, Недельный → Месячные , в квартале, Или ежегодный букет. Токены также включают {date}, {year}, {YR} (в два года) {month}, {day}, и {week}."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்படுத்த {period} நாளைய தினம் தேர்வு, வாரம் , மாதம் மூன்றாவது அல்லது வருமான வரிசை. Tokens கூட உள்ளன {date}, {year}, {YR} (2 ஆண்டுகள் கழித்து) {month}, {day}, அ {week}."
          }
        },
        "th": {
          "stringUnit": {
