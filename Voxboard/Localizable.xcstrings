    "The transcript is saved locally while its note and requested audio finish exporting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تخزين الترجمة المحلية في حين أن تقييمها والتصوير المطلوب ينتهي بتصدير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সক্রিপ্টটি স্থানীয়ভাবে সংরক্ষণ করা হয় যখন তার নোট এবং অনুরোধিত অডিও রপ্তানি শেষ হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Transkript wird lokal gesichert, während seine Notiz und das angeforderte Audio den Export abschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript is saved locally while its note and requested audio finish exporting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción se guarda localmente mientras su nota y audio solicitado terminan exportando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription est enregistrée localement pendant que sa note et l'audio demandé finissent par être exportés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसक्रिप्ट को स्थानीय रूप से संग्रहीत किया जाता है जबकि इसकी नोट और अनुरोधित ऑडियो निर्यात समाप्त हो जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript disimpan secara lokal saat catatan dan audio diminta selesai diekspor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione viene salvata localmente mentre la sua nota e l'audio richiesto finiscono l'esportazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランスクリプトは、そのノートと要求されたオーディオがエクスポートする際にローカルに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 트랜스크립트는 메모와 요청된 오디오가 내보내는 동안 로컬로 저장됩니다.The transcript is saved locally while its note and requested audio finishing exporting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transcript wordt lokaal opgeslagen terwijl de notitie en de gevraagde audio worden geëxporteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja jest zapisywana lokalnie, podczas gdy jej notatka i żądany dźwięk kończą się eksportowaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição é salvo localmente enquanto sua nota e o áudio solicitado terminam a exportação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт сохраняется локально, пока его записка и запрошенный аудиокончается экспортом."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதன் மூலம், இடுகை மற்றும் தேவைப்பட்ட ஆடியோ வெளியேற்ற முடிந்துவிடும்.The transcript is saved locally while its note and requested audio finish exporting."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถ่ายภาพจะถูกบันทึกในท้องถิ่นในขณะที่บันทึกและเสียงที่ร้องขอเสร็จสิ้นการส่งออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript, not ve talep edilen ses eksporu bittiğinde yerel olarak kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт зберігається локально, а його записка та запитуваний аудіо закінчується експортом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسپیٹ مقامی طور پر محفوظ کیا جاتا ہے جبکہ اس کے نوٹ اور درخواست آڈیو کو برآمد کرنے کے لئے ختم ہوتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao được lưu cục bộ trong khi ghi chú và âm thanh yêu cầu kết thúc xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录在本地保存,而其注释和所请求的音频完成导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉錄在本地保存,而其註釋和所請求的音頻完成導出。"
          }
        }
      }
    },
