          "stringUnit": {
            "state": "translated",
            "value": "iPhone 無法挽救轉會。"
          }
        }
      }
    },
    "iPhone could not save this transfer. Tap Sync on Watch to retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone لم يتم حفظ هذا التحويل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone এই স্থানান্তর বাঁচাতে পারিনি। Watch to retry এর উপর Sync ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone konnte diese Übertragung nicht sichern. Tippen Sie auf der Watch auf „Synchronisieren“, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone could not save this transfer. Tap Sync on Watch to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone No se pudo salvar esta transferencia. Tapar Sync en Watch to retry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Je n'ai pas pu sauver ce transfert. Tapez Sync sur Watch to retry."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone इस हस्तांतरण को बचा नहीं जा सका। देखें पर क्लिक करें RETRY पर"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Saya tidak bisa menyelamatkan transfer ini. Tekan Sync pada Watch to Retry."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Non poteva salvare questo trasferimento. Toccare Sync su Watch to retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone この移転を救えなかった。 タップ Sync on Watch to retry"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 이 전송을 구할 수 없었다. Watch to retry를 탭합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Deze overdracht kon ik niet redden. Tik op Sync op Watch to retry."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Nie udało się uratować tego transferu. Kliknij Sync na Watch to retry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Não consegui salvar essa transferência. Toque em Sincronizar para ver retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Не удалось спасти этот переход. Нажмите Sync на Watch to retry."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone இந்த மாற்றத்தை காப்பாற்ற முடியவில்லை. Watch to Retry என்ற படத்தை இணைத்துள்ளேன்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ไม่สามารถบันทึกการถ่ายโอนนี้ได้ คลิก Sync on Watch to retry"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Bu transferden kurtulamadık. Sync tuşuna basın Watch to retry."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Цього переходу не вдалося врятувати. Натисніть Sync на Watch to retry."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone اس نقل و حمل کو بچانے کے قابل نہیں تھے. چیک کریں Retry پر Sync پر کلک کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Không thể cứu được sự chuyển nhượng này. Nhấn Sync on Watch to Retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 无法挽救这一转移。 点击“观看”来重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 無法挽救這一轉移。 點擊“觀看”來重複。"
          }
        }
      }
    },
