        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時計にローカルに保存されているレコーディングを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시계에 로컬로 저장된 녹음이 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start een opname die lokaal op deze klok is opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczyna nagrywanie przechowywane lokalnie na tym zegarku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma gravação armazenada localmente neste Relógio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинается запись, локально сохраненная на этом Часе."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மணல் மீது உள்ள ஒரு இடத்தில் சேமிக்கப்பட்ட ஒரு எழுத்து தொடங்குகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มการบันทึกที่เก็บไว้ในท้องถิ่นบนนาฬิกานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatte yerel olarak depolanan bir kayıt başlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починається запис, що зберігається локально на цьому годиннику."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس گھڑی پر مقامی طور پر ذخیرہ کردہ ایک ریکارڈ شروع ہوتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu một bản ghi được lưu trữ cục bộ trên đồng hồ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始本地存储在此手表上的录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始本地存儲在此手錶上的錄音。"
          }
        }
      }
    },
    "Starts or stops the selected route from anywhere": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ المسار المحدد أو يوقفه من أي مكان"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো জায়গা থেকে বেছে নেওয়া রুট শুরু বা বন্ধ করে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet oder stoppt die ausgewählte Route von überall"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts or stops the selected route from anywhere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o detiene la ruta seleccionada desde cualquier lugar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre ou arrête le parcours sélectionné depuis n’importe où"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कहीं से भी चुने गए रूट को शुरू या बंद करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulai atau menghentikan rute yang dipilih dari mana saja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia o interrompe il percorso selezionato da qualsiasi punto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこからでも選択したルートを開始または停止します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디에서나 선택한 루트를 시작하거나 중단합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start of stopt de geselecteerde route vanaf elke plek"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia lub zatrzymuje wybraną trasę z dowolnego miejsca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia ou para a rota selecionada de qualquer lugar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает или останавливает выбранный маршрут откуда угодно"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எங்கிருந்தும் தேர்ந்தெடுத்த வழித்தடத்தைத் தொடங்கும் அல்லது நிறுத்தும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มหรือหยุดเส้นทางที่เลือกจากที่ใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili rotayı her yerden başlatır veya durdurur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускає або зупиняє вибраний маршрут звідусіль"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب روٹ کو کہیں سے بھی شروع یا بند کرتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu hoặc dừng lộ trình đã chọn từ bất cứ đâu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从任意位置开始或停止所选路线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從任何位置開始或停止所選路線"
          }
        }
      }
    },
    "Starts the persistent listening session used by the Vox.md keyboard. This does not attach audio to the Capture.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ جلسة الاستماع المستمرة التي تستخدمها لوحة مفاتيح Vox.md. لا يرفق هذا صوتًا بالالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md কীবোর্ডের ব্যবহৃত স্থায়ী শোনার সেশন শুরু করে। এটি ক্যাপচারে অডিও সংযুক্ত করে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die dauerhafte Zuhörsitzung der Vox.md-Tastatur. Dadurch wird kein Audio an die Erfassung angehängt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts the persistent listening session used by the Vox.md keyboard. This does not attach audio to the Capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la sesión de escucha persistente que usa el teclado de Vox.md. No adjunta audio a la captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre la session d’écoute persistante utilisée par le clavier Vox.md. Cela ne joint pas d’audio à la capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md कीबोर्ड द्वारा उपयोग किया जाने वाला लगातार सुनने का सेशन शुरू करता है। यह कैप्चर में ऑडियो अटैच नहीं करता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulai sesi mendengarkan persisten yang digunakan oleh papan ketik Vox.md. Ini tidak melampirkan audio ke Tangkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la sessione di ascolto persistente usata dalla tastiera Vox.md. Non allega audio all’acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.mdキーボードで使用する常時聞き取りセッションを開始します。オーディオはキャプチャに添付されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 키보드에서 사용하는 지속 듣기 세션을 시작합니다. 오디오가 캡처에 첨부되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de blijvende luistersessie van het Vox.md-toetsenbord. Hiermee wordt geen audio aan de vastlegging toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczyna trwałą sesję słuchania używaną przez klawiaturę Vox.md. Nie dołącza to audio do przechwycenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia a sessão de escuta persistente usada pelo teclado do Vox.md. Isso não anexa áudio à captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает постоянный сеанс прослушивания для клавиатуры Vox.md. Аудио к захвату не прикрепляется."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md விசைப்பலகை பயன்படுத்தும் நிலையான கேட்கும் அமர்வைத் தொடங்கும். இது பிடிப்பில் ஒலியை இணைக்காது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มเซสชันการฟังต่อเนื่องที่แป้นพิมพ์ Vox.md ใช้ การดำเนินการนี้ไม่แนบเสียงไปกับการจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md klavyesinin kullandığı kalıcı dinleme oturumunu başlatır. Bu, Yakalamaya ses eklemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускає постійний сеанс прослуховування для клавіатури Vox.md. Аудіо до захоплення не прикріплюється."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md کی بورڈ کا مستقل سننے کا سیشن شروع کرتا ہے۔ اس سے کیپچر کے ساتھ آڈیو منسلک نہیں ہوتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu phiên nghe liên tục mà bàn phím Vox.md sử dụng. Thao tác này không đính kèm âm thanh vào bản ghi nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始 Vox.md 键盘使用的持续聆听会话。这不会将音频附加到采集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始 Vox.md 鍵盤使用的持續聆聽工作階段。這不會將音訊附加到擷取。"
          }
        }
      }
    },
