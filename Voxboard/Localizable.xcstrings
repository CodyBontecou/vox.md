          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانسپیٹ مقامی طور پر محفوظ کیا جاتا ہے جبکہ اس کے نوٹ اور درخواست آڈیو کو برآمد کرنے کے لئے ختم ہوتا ہے."
