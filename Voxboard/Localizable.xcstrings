    "%lld queued Captures could not be delivered. Their content is still stored locally.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الالتقاطات في قائمة الانتظار التي تعذّر تسليمها: %lld. لا يزال محتواها مخزنًا محليًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সারিতে থাকা %lld টি ক্যাপচার ডেলিভার করা যায়নি। সেগুলোর কনটেন্ট এখনও স্থানীয়ভাবে সংরক্ষিত আছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld wartende Erfassungen konnten nicht zugestellt werden. Ihr Inhalt ist weiterhin lokal gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld queued Captures could not be delivered. Their content is still stored locally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron entregar %lld capturas en cola. Su contenido sigue guardado localmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld captures en file d’attente n’ont pas pu être livrées. Leur contenu est toujours stocké localement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कतार वाले %lld कैप्चर डिलीवर नहीं हो सके। उनकी सामग्री अब भी स्थानीय रूप से संग्रहित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tangkapan dalam antrean tidak dapat dikirim. Kontennya masih tersimpan secara lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile consegnare %lld acquisizioni in coda. Il loro contenuto è ancora archiviato in locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュー内の%lld件のキャプチャを配信できませんでした。内容はローカルに保存されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기열의 캡처 %lld개를 전달할 수 없습니다. 콘텐츠는 여전히 로컬에 저장되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld vastleggingen in de wachtrij konden niet worden afgeleverd. De inhoud is nog lokaal opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedostarczone przechwycenia z kolejki: %lld. Ich zawartość jest nadal przechowywana lokalnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível entregar %lld capturas na fila. O conteúdo delas continua armazenado localmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось доставить захваты из очереди (%lld). Их содержимое по-прежнему хранится локально."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரிசையிலுள்ள %lld பிடிப்புகளை வழங்க முடியவில்லை. அவற்றின் உள்ளடக்கம் இன்னும் உள்ளூரில் சேமிக்கப்பட்டுள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถส่งการจับภาพในคิว %lld รายการได้ เนื้อหายังคงจัดเก็บไว้ในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruktaki %lld Yakalama teslim edilemedi. İçerikleri hâlâ yerel olarak saklanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося доставити захоплення з черги (%lld). Їхній вміст і далі зберігається локально."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطار میں موجود کیپچرز ڈیلیور نہیں ہو سکے: %lld۔ ان کا مواد اب بھی مقامی طور پر محفوظ ہے۔"
          }
        },
