    "A LITTLE SPACE FOR YOU": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A LITTLE SPACE FOR YOU"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة صغيرة لك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জন্য একটু জায়গা"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EIN WENIG PLATZ FÜR SIE"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UN PEQUEÑO ESPACIO PARA TI"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UN PEU D'ESPACE POUR VOUS"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लिए थोड़ी सी जगह"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SEDIKIT RUANG UNTUK ANDA"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UN PICCOLO SPAZIO PER TE"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのための小さなスペース"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신을 위한 작은 공간"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "EEN KLEIN RUIMTE VOOR JOU"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MAŁA PRZESTRZEŃ DLA CIEBIE"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UM POUCO ESPAÇO PARA VOCÊ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "НЕМНОГО ПРОСТРАНСТВА ДЛЯ ВАС"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்காக ஒரு சிறிய இடம்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่เล็กๆ สำหรับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SİZE KÜÇÜK BİR YER"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ТРОХИ МІСЦЯ ДЛЯ ВАС"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے لیے تھوڑی سی جگہ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MỘT KHÔNG GIAN NHỎ DÀNH CHO BẠN"
          }
        },
        "zh-Hans": {
          "stringUnit": {
