    "Start typing or speaking — the Markdown this route writes appears here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ الكتابة أو التحدث — يظهر هنا ملف Markdown الذي يكتبه هذا المسار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টাইপ করা বা বলা শুরু করুন — এই রুট যে Markdown লিখবে তা এখানে দেখা যাবে।"
          }
        },
        "de": {
