            "state": "translated",
            "value": "Segmen dikte tidak dapat disimpan dan akan dicoba lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare un segmento di dettatura: verrà riprovato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力のセグメントを保存できませんでした。再試行されます"
