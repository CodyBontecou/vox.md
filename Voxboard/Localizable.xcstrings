    "The link remains in the durable Capture draft until it is sent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل الرابط في مشروع السماح المستمر حتى يتم إرسالها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিঙ্কটি পাঠানো পর্যন্ত স্থায়ী ক্যাপচার নোটিশে থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link bleibt im dauerhaften Erfassungsentwurf, bis er gesendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link remains in the durable Capture draft until it is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace permanece en el proyecto de captura duradero hasta que se envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien reste dans le projet de capture durable jusqu'à son envoi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक भेजे जाने तक स्थायी कैप्चर डिजाइन में रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Link tetap berada di rancangan Capture yang tahan lama sampai dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link rimane nel progetto di Capture duraturo fino a quando non viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクは、送信されるまで持続可能なキャプチャプロジェクトに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크는 보내질 때까지 지속적인 캡처 프로젝트에 남아 있습니다.The link remains in the durable Capture draft until it is sent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De link blijft in de duurzame Capture-ontwerp totdat het wordt verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link pozostaje w trwałym projekcie przechwytywania, aż zostanie wysłany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link permanece no projeto de captura duradouro até ser enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка остается в долговременном проекте Capture, пока не будет отправлена."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த படத்தின் காப்புரிமை முடிந்தவரை எழுதப்பட்ட படம் வெளியாகும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมโยงยังคงอยู่ในโครงการ Capture ที่คงทนจนกว่าจะถูกส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı, gönderilene kadar kalıcı Capture taslakında kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання залишається в довгостроковому проекті захоплення, поки не буде відправлено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لنک بھیجنے تک بیک اپ ڈراپ میں باقی رہتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết vẫn còn trong bản thảo Capture lâu dài cho đến khi nó được gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接在持久捕捉草案中,直到发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏈接在持久捕捉草案中,直到發送。"
          }
        }
      }
    },
