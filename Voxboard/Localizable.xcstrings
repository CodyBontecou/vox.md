    "Plain Markdown, saved to the folders you choose. Voice transcription stays on your device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain Markdown, saved to the folders you choose. Voice transcription stays on your device."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown بسيط، محفوظ في المجلدات التي تختارها. يبقى النسخ الصوتي على جهازك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্লেইন Markdown , আপনার বেছে নেওয়া ফোল্ডারে সংরক্ষিত। ভয়েস ট্রান্সক্রিপশন আপনার ডিভাইসে থেকে যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfacher Markdown , gespeichert in den von Ihnen ausgewählten Ordnern. Die Sprachtranskription bleibt auf Ihrem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain Markdown , guardado en las carpetas que elijas. La transcripción de voz permanece en su dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain Markdown , enregistré dans les dossiers que vous choisissez. La transcription vocale reste sur votre appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सादा Markdown , आपके द्वारा चुने गए फ़ोल्डरों में सहेजा गया। वॉयस ट्रांसक्रिप्शन आपके डिवाइस पर रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown Biasa, disimpan ke folder yang Anda pilih. Transkripsi suara tetap ada di perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown semplice, salvato nelle cartelle scelte. La trascrizione vocale rimane sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain Markdown 、選択したフォルダーに保存されます。音声文字起こしはデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더에 저장되는 일반 Markdown 입니다. 음성 전사는 장치에 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain Markdown , opgeslagen in de mappen die u kiest. Spraaktranscriptie blijft op uw apparaat staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykły Markdown , zapisany w wybranych folderach. Transkrypcja głosu pozostaje na Twoim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown simples, salvo nas pastas que você escolher. A transcrição de voz permanece no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычный Markdown , сохраненный в выбранных вами папках. Транскрипция голоса останется на вашем устройстве."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எளிய Markdown , நீங்கள் தேர்வு செய்யும் கோப்புறைகளில் சேமிக்கப்படும். குரல் டிரான்ஸ்கிரிப்ஷன் உங்கள் சாதனத்தில் இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain Markdown บันทึกลงในโฟลเดอร์ที่คุณเลือก การถอดเสียงเป็นคำจะยังคงอยู่ในอุปกรณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düz Markdown , seçtiğiniz klasörlere kaydedilir. Sesin transkripsiyonu cihazınızda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звичайна Markdown , збережена у вибраних папках. Транскрипція голосу залишається на вашому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سادہ Markdown ، آپ کے منتخب کردہ فولڈرز میں محفوظ کیا جاتا ہے۔ صوتی ٹرانسکرپشن آپ کے آلے پر رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain Markdown , được lưu vào thư mục bạn chọn. Phiên âm giọng nói vẫn còn trên thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯Markdown ，保存到您选择的文件夹中。语音转录保留在您的设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "純Markdown ，儲存到您選擇的資料夾中。語音轉錄保留在您的裝置上。"
          }
        }
      }
    },
