            "value": "사용 가능한 오디오가 캡처되지 않았습니다.더 보기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen gebruikbare audio vastgelegd. Probeer opnieuw te opnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie został zarejestrowany żaden użyteczny dźwięk. Spróbuj ponownie nagrać."
