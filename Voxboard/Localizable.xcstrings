            "value": "所有操作均已固定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有動作均已釘選。"
          }
        }
      }
    },
    "Every capture,\nrouted into your vault.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل التقاط،\nيُوجَّه إلى خزنتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ক্যাপচার,\nআপনার ভল্টে পৌঁছে যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Erfassung,\nin Ihren Tresor geleitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every capture,\nrouted into your vault."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada captura,\ndirecta a tu bóveda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque capture,\nacheminée dans votre coffre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर कैप्चर,\nरूट होकर आपके वॉल्ट में।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tangkapan,\ndirutekan ke vault Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni acquisizione,\ninstradata nel tuo vault."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのキャプチャを、\nあなたの保管庫へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 캡처를\n나의 볼트로."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke vastlegging,\nnaar je kluis geleid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde przechwycenie\ntrafia do Twojego sejfu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada captura,\ndireto para o seu cofre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый захват —\nпрямо в ваше хранилище."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு பிடிப்பும்,\nஉங்கள் களஞ்சியத்திற்கு வழிநடத்தப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการจับภาพ\nส่งตรงเข้าวอลต์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yakalama,\nkasanıza yönlendirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне захоплення —\nпрямо у ваше сховище."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر کیپچر،\nآپ کے والٹ تک روٹ کیا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi bản ghi nhanh,\nđược đưa vào kho của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次采集，\n都送进你的仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次擷取，\n都送進你的儲存庫。"
          }
        }
      }
    },
    "Everything runs on this iPhone. Routes can override the model.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل كل شيء على هذا الـ iPhone. يمكن للمسارات تجاوز النموذج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবকিছু এই iPhone-এ চলে। রুট মডেলটি ওভাররাইড করতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft auf diesem iPhone. Routen können das Modell überschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything runs on this iPhone. Routes can override the model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se ejecuta en este iPhone. Las rutas pueden usar otro modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout s’exécute sur cet iPhone. Les parcours peuvent remplacer le modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ इसी iPhone पर चलता है। रूट्स मॉडल को ओवरराइड कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya berjalan di iPhone ini. Rute dapat menggantikan model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto avviene su questo iPhone. I percorsi possono sostituire il modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこのiPhone上で実行されます。ルートごとにモデルを変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 처리는 이 iPhone에서 실행됩니다. 루트에서 모델을 재정의할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles draait op deze iPhone. Routes kunnen het model overschrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko działa na tym iPhone. Trasy mogą zastąpić model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo é executado neste iPhone. As rotas podem substituir o modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все работает на этом iPhone. Маршруты могут переопределять модель."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்தும் இந்த iPhone இல் இயங்கும். வழித்தடங்கள் மாதிரியை மேலெழுதலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างทำงานบน iPhone เครื่องนี้ เส้นทางสามารถแทนที่โมเดลได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu iPhone'da çalışır. Rotalar modeli geçersiz kılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе працює на цьому iPhone. Маршрути можуть перевизначати модель."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب کچھ اسی iPhone پر چلتا ہے۔ روٹس ماڈل کو اوور رائیڈ کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ chạy trên iPhone này. Lộ trình có thể ghi đè mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在此 iPhone 上运行。路线可以覆盖模型设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在此 iPhone 上執行。路線可以覆寫模型設定。"
          }
        }
      }
    },
