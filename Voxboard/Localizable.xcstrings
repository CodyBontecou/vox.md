            "value": "没有录制可用音频,请尝试再次录制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有錄製可用音頻,請嘗試再次錄製。"
          }
        }
      }
    },
