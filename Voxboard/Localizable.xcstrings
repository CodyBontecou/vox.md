    "The Route to use for recordings started by this control.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسار المستخدم للتسجيلات التي يبدأها عنصر التحكم هذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কন্ট্রোল দিয়ে শুরু হওয়া রেকর্ডিংয়ের জন্য ব্যবহার করার রুট।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Route für Aufnahmen, die über dieses Steuerelement gestartet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Route to use for recordings started by this control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta que se usará para las grabaciones iniciadas desde este control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parcours à utiliser pour les enregistrements lancés par cette commande."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कंट्रोल से शुरू की गई रिकॉर्डिंग के लिए उपयोग होने वाला रूट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rute yang digunakan untuk rekaman yang dimulai oleh kontrol ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il percorso da usare per le registrazioni avviate da questo controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコントロールで開始した録音に使用するルート。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제어로 시작한 녹음에 사용할 루트입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De route voor opnamen die via deze regelaar worden gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasa używana dla nagrań uruchamianych tym przełącznikiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rota a ser usada nas gravações iniciadas por este controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маршрут для записей, запускаемых этим элементом управления."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கட்டுப்பாட்டால் தொடங்கப்படும் பதிவுகளுக்குப் பயன்படுத்த வேண்டிய வழித்தடம்."
          }
        },
        "th": {
