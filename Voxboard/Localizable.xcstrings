    "Recording is safe on Watch. Retrying automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل محفوظ على الساعة. تجري إعادة المحاولة تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং Watch-এ নিরাপদ আছে। স্বয়ংক্রিয়ভাবে আবার চেষ্টা করা হচ্ছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist auf der Watch sicher. Neuer Versuch erfolgt automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is safe on Watch. Retrying automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación está a salvo en el Watch. Reintentando automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement est en sécurité sur la Watch. Nouvel essai automatique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग Watch पर सुरक्षित है। अपने आप फिर से कोशिश हो रही है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman aman di Watch. Mencoba lagi secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è al sicuro su Watch. Nuovo tentativo automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は Watch に保存されています。自動的に再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 Watch에 안전하게 저장되어 있습니다. 자동으로 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname staat veilig op de Watch. Wordt automatisch opnieuw geprobeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagranie jest bezpieczne na Watch. Ponawianie automatyczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação está segura no Watch. Tentando novamente automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись сохранена на Watch. Повтор выполняется автоматически."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு Watch-இல் பாதுகாப்பாக உள்ளது. தானாக மீண்டும் முயல்கிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกปลอดภัยบน Watch กำลังลองใหม่อัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt Watch’ta güvende. Otomatik olarak yeniden deneniyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис збережено на Watch. Повтор виконується автоматично."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ Watch پر محفوظ ہے۔ خودکار طور پر دوبارہ کوشش ہو رہی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi an toàn trên Watch. Đang tự động thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音已安全保存在手表上。正在自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音已安全儲存在手錶上。正在自動重試。"
          }
        }
      }
    },
