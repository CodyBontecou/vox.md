    "Private capture and on-device transcription for Markdown workflows.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقاط خاص ونسخ صوتي على الجهاز لسير عمل Markdown."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown ওয়ার্কফ্লোর জন্য ব্যক্তিগত ক্যাপচার ও ডিভাইসে ট্রান্সক্রিপশন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Erfassung und Transkription auf dem Gerät für Markdown-Abläufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private capture and on-device transcription for Markdown workflows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura privada y transcripción en el dispositivo para flujos de trabajo con Markdown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture privée et transcription sur l’appareil pour vos flux Markdown."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown वर्कफ़्लो के लिए निजी कैप्चर और ऑन-डिवाइस ट्रांसक्रिप्शन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan pribadi dan transkripsi di perangkat untuk alur kerja Markdown."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisizione privata e trascrizione sul dispositivo per i flussi di lavoro Markdown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdownワークフローのための、プライベートなキャプチャとデバイス上の文字起こし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown 워크플로를 위한 비공개 캡처 및 기기 내 전사."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privé vastleggen en transcriptie op het apparaat voor Markdown-workflows."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatne przechwytywanie i transkrypcja na urządzeniu dla procesów opartych na Markdown."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura privada e transcrição no dispositivo para fluxos de trabalho em Markdown."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватный захват и транскрипция на устройстве для процессов на Markdown."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown பணிப்பாய்வுகளுக்கான தனிப்பட்ட பிடிப்பும் சாதனத்திலேயே உரைமாற்றமும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจับภาพแบบส่วนตัวและการถอดเสียงบนอุปกรณ์สำหรับเวิร์กโฟลว์ Markdown"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown iş akışları için gizli yakalama ve aygıt üzerinde transkripsiyon."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватне захоплення й транскрипція на пристрої для процесів на Markdown."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown ورک فلوز کے لیے نجی کیپچر اور آلے پر ٹرانسکرپشن۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nhanh riêng tư và chép lời trên thiết bị cho quy trình Markdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密采集和设备端转录，专为 Markdown 工作流程打造。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私密擷取和裝置端轉錄，專為 Markdown 工作流程打造。"
          }
        }
      }
    },
