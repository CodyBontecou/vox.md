    "Watch recordings use this preset's normal on-device transcription and Capture destination workflow.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم إخراج المراقبة عملية الترجمة المستمرة على الجهاز ومرور العمل الهدف هذا الإعداد المتوقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং দেখুন এই পূর্ব সেটের স্বাভাবিক ডিভাইস ট্রান্সকিপশন এবং ক্যাপচার ডিজাইন ওয়ার্কফ্লো ব্যবহার করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-Aufnahmen nutzen die normale geräteseitige Transkription und den Erfassungsziel-Workflow dieses Presets."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch recordings use this preset's normal on-device transcription and Capture destination workflow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones de visualización utilizan la transcripción normal en el dispositivo y el flujo de trabajo de captura de destino de este preset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements de suivi utilisent la transcription normale sur l'appareil et le flux de travail de capture de destination de ce paramètre prédéfinit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड्स का उपयोग करें इस पूर्वावलोकन के सामान्य डिवाइस ट्रांसक्रिप्शन और कैप्चर गंतव्य कार्यप्रणाली का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman menonton menggunakan transkripsi normal pada perangkat dan alur kerja Pencatatan tujuan preset ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le registrazioni di visualizzazione utilizzano la normale trascrizione sul dispositivo e il flusso di lavoro di destinazione di Cattura di questo preconfigurato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画の観察は、このプレセットの通常のデバイストランスクリプションとカプセル・ディレクトリワークフローを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 시청은 이 프리셋의 일반적인 장치 전송 및 캡처 대상 작업 흐름을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk opnamen gebruiken de normale transcriptie op het apparaat en de werkstroom van de bestemming van Capture."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania z oglądania używają normalnego przepływu pracy transkrypcji na urządzeniu i przepływu pracy docelowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações de visualização usam a transcrição normal no dispositivo e o fluxo de trabalho de captura do destino deste predefinição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наблюдательные записи используют обычную транскрипцию на устройстве и рабочий процесс «Захват» цели этого предварительного набора."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch பதிவுகள் இந்த முன்தொகுப்பின் வழக்கமான சாதனத்திலேயே நடைபெறும் உரைமாற்றம் மற்றும் பிடிப்பு இலக்கு பணிப்பாய்வைப் பயன்படுத்தும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกการบันทึกใช้กระบวนการทํางานแบบกําหนดค่าเริ่มต้นปกติบนอุปกรณ์และ Capture destination"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleyici kayıtları, bu önceden ayarlanan normal cihaz transcription ve Capture destination iş akışı kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис відео використовує нормальний перепис на пристрої та робочий процес «Захоплення місця призначення» цього попереднього налаштування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس پیشکش کے معمول آلہ ٹرانسپیشن اور ریکارڈنگ مقصد کام کے عمل کے عملے کا استعمال کرتے ہوئے دیکھیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm xem sử dụng dòng công việc chuyển đổi trên thiết bị bình thường và Capture destination của thiết lập trước này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观看录制使用此预设的正常设备转录和捕捉目标工作流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀看錄製使用此預設的正常設備轉錄和捕捉目標工作流。"
          }
        }
      }
    },
