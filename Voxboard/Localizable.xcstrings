    "Access is off in Privacy & Security": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول متوقف في الخصوصية والأمن"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গোপনীয়তা ও নিরাপত্তায় অ্যাক্সেস বন্ধ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff ist unter „Datenschutz & Sicherheit“ deaktiviert"
          }
        },
