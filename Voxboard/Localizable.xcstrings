    "This route is unavailable. Reload before pinning it to the Capture Bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المسار غير متاح. أعد التحميل قبل تثبيته في شريط الالتقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রুটটি অনুপলব্ধ। ক্যাপচার বারে পিন করার আগে রিলোড করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Route ist nicht verfügbar. Laden Sie neu, bevor Sie sie an die Erfassungsleiste anheften."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This route is unavailable. Reload before pinning it to the Capture Bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ruta no está disponible. Recarga antes de fijarla en la barra de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce parcours n’est pas disponible. Actualisez avant de l’épingler à la barre de capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रूट उपलब्ध नहीं है। कैप्चर बार पर पिन करने से पहले रीलोड करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rute ini tidak tersedia. Muat ulang sebelum menyematkannya ke Bilah Tangkapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo percorso non è disponibile. Ricarica prima di fissarlo alla barra di acquisizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルートは利用できません。キャプチャバーにピン留めする前に再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 루트를 사용할 수 없습니다. 캡처 막대에 고정하기 전에 다시 불러오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze route is niet beschikbaar. Laad opnieuw voordat je hem vastzet in de vastlegbalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta trasa jest niedostępna. Odśwież przed przypięciem jej do paska przechwytywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rota não está disponível. Recarregue antes de fixá-la na Barra de Captura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот маршрут недоступен. Обновите, прежде чем закреплять его на панели захвата."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வழித்தடம் கிடைக்கவில்லை. பிடிப்புப் பட்டியில் பொருத்தும் முன் மீண்டும் ஏற்றவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นทางนี้ไม่พร้อมใช้งาน โหลดใหม่ก่อนปักหมุดไว้ที่แถบจับภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rota kullanılamıyor. Yakalama Çubuğu'na sabitlemeden önce yeniden yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей маршрут недоступний. Оновіть, перш ніж закріплювати його на панелі захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ روٹ دستیاب نہیں۔ کیپچر بار پر پن کرنے سے پہلے دوبارہ لوڈ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lộ trình này không khả dụng. Tải lại trước khi ghim vào Thanh ghi nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此路线不可用。请先重新载入，再将其固定到采集栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此路線無法使用。請先重新載入，再將其釘選到擷取列。"
          }
        }
      }
    },
    "This saved endpoint uses unencrypted HTTP. Your capture and credentials will be sent without encryption.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم نقطة النهاية المحفوظة هذه HTTP غير مشفر. سيتم إرسال الالتقاط وبيانات الاعتماد بدون تشفير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সেভ করা এন্ডপয়েন্টটি এনক্রিপশনবিহীন HTTP ব্যবহার করে। আপনার ক্যাপচার ও ক্রেডেনশিয়াল এনক্রিপশন ছাড়াই পাঠানো হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser gesicherte Endpunkt verwendet unverschlüsseltes HTTP. Ihre Erfassung und Anmeldedaten werden unverschlüsselt gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved endpoint uses unencrypted HTTP. Your capture and credentials will be sent without encryption."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este punto de conexión guardado usa HTTP sin cifrar. Tu captura y tus credenciales se enviarán sin cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point de terminaison enregistré utilise le HTTP non chiffré. Votre capture et vos identifiants seront envoyés sans chiffrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सहेजा गया एंडपॉइंट बिना एन्क्रिप्शन वाला HTTP उपयोग करता है। आपका कैप्चर और क्रेडेंशियल्स बिना एन्क्रिप्शन के भेजे जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint tersimpan ini menggunakan HTTP tanpa enkripsi. Tangkapan dan kredensial Anda akan dikirim tanpa enkripsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo endpoint salvato usa HTTP non crittografato. L’acquisizione e le credenziali verranno inviate senza crittografia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保存済みエンドポイントは暗号化されていないHTTPを使用します。キャプチャと認証情報は暗号化されずに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장된 엔드포인트는 암호화되지 않은 HTTP를 사용합니다. 캡처와 자격 증명이 암호화되지 않고 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bewaarde eindpunt gebruikt onversleutelde HTTP. Je vastlegging en inloggegevens worden zonder versleuteling verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten zapisany punkt końcowy używa nieszyfrowanego HTTP. Przechwycenie i dane uwierzytelniające zostaną wysłane bez szyfrowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endpoint salvo usa HTTP sem criptografia. Sua captura e suas credenciais serão enviadas sem criptografia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сохраненный адрес использует незашифрованный HTTP. Ваш захват и учетные данные будут отправлены без шифрования."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சேமித்த முனைப்புள்ளி குறியாக்கப்படாத HTTP ஐப் பயன்படுத்துகிறது. உங்கள் பிடிப்பும் சான்றுகளும் குறியாக்கம் இல்லாமல் அனுப்பப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลายทางที่บันทึกไว้นี้ใช้ HTTP ที่ไม่เข้ารหัส การจับภาพและข้อมูลประจำตัวของคุณจะถูกส่งโดยไม่เข้ารหัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıtlı uç nokta şifrelenmemiş HTTP kullanıyor. Yakalamanız ve kimlik bilgileriniz şifrelenmeden gönderilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збережена адреса використовує незашифрований HTTP. Ваше захоплення й облікові дані буде надіслано без шифрування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ محفوظ اینڈ پوائنٹ غیر انکرپٹ شدہ HTTP استعمال کرتا ہے۔ آپ کا کیپچر اور اسناد بغیر انکرپشن کے بھیجے جائیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm cuối đã lưu này dùng HTTP không mã hóa. Bản ghi nhanh và thông tin xác thực của bạn sẽ được gửi mà không mã hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此已保存的端点使用未加密的 HTTP。你的采集和凭证将以未加密方式发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此已儲存的端點使用未加密的 HTTP。你的擷取和憑證將以未加密方式傳送。"
          }
        }
      }
    },
