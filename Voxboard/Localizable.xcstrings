    "Vox.md needs permission to save notes for the \"%@\" Capture Preset.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md يحتاج إلى إمكانية حفظ الملاحظات لـ \"%@\" الإعداد المتقدم لتسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md নোটগুলি সংরক্ষণ করার জন্য অনুমতি প্রয়োজন \"%@‘প্রাক্তন আটকে রাখা।"
          }
        },
        "de": {
          "stringUnit": {
