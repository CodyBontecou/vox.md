    "For you, across your Apple devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For you, across your Apple devices."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لك، عبر أجهزة Apple الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জন্য, আপনার Apple ডিভাইস জুড়ে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Sie, auf Ihren Apple -Geräten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ti, en todos tus dispositivos Apple ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vous, sur vos appareils Apple ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लिए, आपके संपूर्ण Apple डिवाइस पर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk Anda, di seluruh perangkat Apple Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per te, su tutti i tuoi dispositivi Apple ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのAppleデバイス全体で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신을 위해, 당신의 Apple 기기 전반에 걸쳐."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor jou, op al je Apple apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla Ciebie, na wszystkich Twoich urządzeniach Apple ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para você, em todos os seus dispositivos Apple ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вас, на ваших устройствах Apple ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுக்காக, உங்கள் Apple சாதனங்கள் முழுவதும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับคุณในทุกอุปกรณ์ Apple ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin için, Apple aygıtlarınızın tamamında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вас на ваших пристроях Apple ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے لیے، آپ کے Apple آلات پر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dành cho bạn, trên các thiết bị Apple của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为您提供跨Apple设备的服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為您提供跨Apple裝置的服務。"
          }
        }
      }
    },
    "For your Apple Family Sharing group. Each person keeps their own notes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your Apple Family Sharing group. Each person keeps their own notes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمجموعة Apple Family Sharing الخاصة بك. كل شخص يحتفظ بملاحظاته الخاصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Apple Family Sharing গ্রুপের জন্য। প্রত্যেক ব্যক্তি তাদের নিজস্ব নোট রাখে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Ihre Apple Family Sharing -Gruppe. Jede Person führt ihre eigenen Notizen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tu grupo Apple Family Sharing . Cada persona guarda sus propias notas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour votre groupe Apple Family Sharing . Chaque personne garde ses propres notes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Apple Family Sharing ग्रुप के लिए। प्रत्येक व्यक्ति अपने-अपने नोट्स रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk grup Apple Family Sharing Anda. Setiap orang menyimpan catatannya masing-masing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per il tuo gruppo Apple Family Sharing . Ogni persona tiene i propri appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Family Sharingグループ用。人はそれぞれ自分のメモを保持しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Family Sharing 그룹의 경우. 각 사람은 자신의 메모를 보관합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor uw Apple Family Sharing groep. Iedereen houdt zijn eigen aantekeningen bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla Twojej grupy Apple Family Sharing . Każda osoba prowadzi własne notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o seu grupo Apple Family Sharing . Cada pessoa mantém suas próprias anotações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вашей группы Apple Family Sharing . Каждый человек ведет свои записи."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Apple Family Sharing குழுவிற்கு. ஒவ்வொரு நபரும் தங்கள் சொந்த குறிப்புகளை வைத்திருக்கிறார்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับกลุ่ม Apple Family Sharing ของคุณ แต่ละคนเก็บบันทึกของตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Family Sharing grubunuz için. Her kişi kendi notlarını tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вашої групи Apple Family Sharing . Кожен веде свої записи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے Apple Family Sharing گروپ کے لیے۔ ہر شخص اپنے اپنے نوٹ رکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dành cho nhóm Apple Family Sharing của bạn. Mỗi người giữ ghi chú của riêng mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于您的Apple Family Sharing群组。每个人都有自己的笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於您的Apple Family Sharing群組。每個人都有自己的筆記。"
          }
        }
      }
    },
