            "value": "录制中断 - 请再次尝试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製中斷 - 請再次嘗試"
          }
        }
      }
    },
    "Recording is safe on Watch. Tap Sync Queue to retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تسجيلها بأمان على Watch.Tap Sync Queue to retry."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং নিরাপদ। টপ করুন Sync Queue to retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist sicher auf der Watch. Tippen Sie auf „Warteschlange synchronisieren“, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is safe on Watch. Tap Sync Queue to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación es segura en Watch. Tapar Sync Queue para volver a rodar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement sécurisé sur Watch. Tapez Sync Queue pour rediriger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग सुरक्षित है. Retry करने के लिए Sync Queue पर टैप करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman aman pada Watch. ketuk Sync Queue untuk mengedit ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è sicura su Watch. Tappate Sync Queue per riprendere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は Watch で安全です。Tap Sync Queue to retry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 Watch에서 안전합니다.Tap Sync Queue to retry."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname is veilig op Watch. Tik op Sync-keten om te herstarten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie jest bezpieczne na Watch. Dotknij Sync Queue, aby ponownie odtworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação é segura no Watch. Toque em Sync Queue para reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись безопасна на Watch. Нажмите Sync Queue для перезагрузки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதாவது, காட்சியில் இணைக்கப்படும் கண்காணிப்பு முறைகள், Sync Queue எனும் அட்டவணைக்குள் இணைக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกปลอดภัยบน Watch คลิก Sync Queue เพื่อรีด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar Watch'ta güvenli. Retry için Sync Queue'a dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис безпечний на Watch. Натисніть Sync Queue для перегляду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ بھی پڑھیں: ڈرائیوروں کی ہدایت پر ٹپ کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm an toàn trên Watch. Chạm Sync Queue để quay lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制是安全的在 Watch 上。 点击 Sync 队列以重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製是安全的在 Watch 上。 點擊 Sync 隊列以重複。"
          }
        }
      }
    },
    "Recording paused. Resume when you're ready, or stop to save it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة ضبط عندما تكون جاهزة، أو التوقف لتخزينها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং থামিয়ে গেছে. আপনি প্রস্তুত হলে পুনরায়, বা এটি সংরক্ষণ করতে থামান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme pausiert. Setzen Sie sie fort, wenn Sie bereit sind, oder stoppen Sie, um sie zu sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording paused. Resume when you're ready, or stop to save it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar cuando esté listo o detener para guardarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement arrêté.Réécupérez lorsque vous êtes prêt, ou arrêtez pour le sauvegarder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग बंद हो गया है. जब आप तैयार हैं, तो फिर से शुरू करें, या इसे सहेजने के लिए बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman terhenti. melanjutkan ketika Anda siap, atau berhenti untuk menyimpannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendere quando si è pronti, o fermarsi per salvarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音停止 準備が整ったときに再開するか、または保存するために停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중단되었습니다. 준비가 되었을 때 다시 녹음하거나, 멈추어 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnemen onderbroken. Ga opnieuw opnemen wanneer u klaar bent, of stop om het op te slaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie wstrzymane. Wznowienie, gdy jesteś gotowy, lub zatrzymać, aby zapisać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupere quando estiver pronto ou pare para salvá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись остановлена. Возобновите, когда вы готовы, или остановитесь, чтобы сохранить ее."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுதப்பட்டால் மீண்டும் எழுதுங்கள், அல்லது எழுதப்பட்டால் மீண்டும் எழுதுங்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกหยุด ระงับเมื่อคุณพร้อมหรือหยุดเพื่อบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt durduruldu. Hazır olduğunuzda tekrar edin veya kaydetmek için durun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис зупинений.Відновлюйте, коли ви готові, або зупиніться, щоб зберегти його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ بند ہو گئی ہے. جب آپ تیار ہیں تو دوبارہ شروع کریں، یا اسے بچانے کے لئے روکیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại khi bạn đã sẵn sàng, hoặc dừng lại để lưu nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制暂停. 当你准备好时,重启或停止保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製暫停. 當你準備好時,重啟或停止保存。"
          }
        }
      }
    },
    "Recording reached the 9:45 safety limit and was stopped automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت تسجيلات إلى الحد الأدنى من الأمن في 9:45 ووقفت تلقائيا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং 9:45 সীমা পৌঁছায় এবং স্বয়ংক্রিয়ভাবে বন্ধ করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme erreichte die Sicherheitsgrenze von 9:45 Uhr und wurde automatisch gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording reached the 9:45 safety limit and was stopped automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación alcanzó el límite de seguridad de 9:45 y se detuvo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement a atteint la limite de sécurité 9:45 et a été arrêté automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग 9:45 सुरक्षा सीमा तक पहुंच गया और स्वचालित रूप से बंद कर दिया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman mencapai batas keamanan 9:45 dan dihentikan secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione ha raggiunto il limite di sicurezza alle 9:45 e è stata interrotta automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音は9時45分の安全限度に達し、自動的に停止した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 9:45의 안전 한도를 달성하고 자동으로 중단되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname bereikte de veiligheidslimiet van 9:45 en werd automatisch gestopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie osiągnął 9:45 granicę bezpieczeństwa i został zatrzymany automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação atingiu o limite de segurança das 9:45 e foi interrompida automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись достигла 9:45 и была остановлена автоматически."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "9:45 மணிக்கு பாதுகாப்பு அளவுக்கு இழுத்து, காவல் நிலையம் அமைக்கப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกถึงขีด จํากัด ความปลอดภัย 9:45 และถูกหยุดโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar 9:45'e ulaştı ve otomatik olarak durduruldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис досяг 9:45 і був зупинений автоматично."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ 9:45 کی حفاظت کی حد تک پہنچ گئی اور خود کار طریقے سے روک دیا گیا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc ghi âm đạt đến giới hạn an toàn 9:45 và đã tự động dừng lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制达到9点45分的安全限度,并自动停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製達到9點45分的安全限度,並自動停止。"
          }
        }
      }
    },
