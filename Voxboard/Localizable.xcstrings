          }
        }
      }
    },
    "Shown above the keyboard when you type into **%@**. Pin as many as you like — the row scrolls sideways. Everything else stays under •••.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر فوق لوحة المفاتيح عند الكتابة في **%@**. ثبّت العدد الذي تريده — يمكن تمرير الصف أفقيًا. يبقى كل ما عدا ذلك ضمن •••."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@**-এ টাইপ করার সময় কীবোর্ডের উপরে দেখানো হয়। যত খুশি পিন করুন — সারিটি পাশে স্ক্রোল হয়। বাকি সবকিছু ••• এর নিচে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird über der Tastatur angezeigt, wenn Sie in **%@** tippen. Heften Sie beliebig viele an – die Leiste scrollt seitwärts. Alles andere bleibt unter •••."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown above the keyboard when you type into **%@**. Pin as many as you like — the row scrolls sideways. Everything else stays under •••."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran sobre el teclado cuando escribes en **%@**. Fija todas las que quieras; la fila se desplaza de lado. Todo lo demás queda en •••."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichées au-dessus du clavier lorsque vous écrivez dans **%@**. Épinglez-en autant que vous voulez : la rangée défile horizontalement. Tout le reste se trouve sous •••."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप **%@** में टाइप करते हैं, तब कीबोर्ड के ऊपर दिखता है। जितने चाहें पिन करें — पंक्ति बगल में स्क्रोल होती है। बाकी सब ••• में रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditampilkan di atas papan ketik saat Anda mengetik di **%@**. Sematkan sebanyak yang Anda mau — barisnya dapat digulir ke samping. Semua lainnya tetap ada di bawah •••."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrate sopra la tastiera quando scrivi in **%@**. Fissane quante vuoi: la riga scorre in orizzontale. Tutto il resto rimane sotto •••."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@**に入力するとキーボードの上に表示されます。好きなだけピン留めできます — 行は横にスクロールします。その他はすべて•••に入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@**에 입력할 때 키보드 위에 표시됩니다. 원하는 만큼 고정할 수 있으며 행은 옆으로 스크롤됩니다. 나머지는 모두 ••• 아래에 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt boven het toetsenbord getoond als je typt in **%@**. Zet er zoveel vast als je wilt – de rij scrolt zijwaarts. Al het andere blijft onder •••."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlane nad klawiaturą, gdy piszesz w **%@**. Przypnij dowolnie wiele — rząd przewija się w bok. Cała reszta pozostaje pod •••."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecem acima do teclado quando você digita em **%@**. Fixe quantas quiser — a fileira rola para os lados. Todo o resto fica em •••."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается над клавиатурой при вводе в **%@**. Закрепляйте сколько угодно — ряд прокручивается вбок. Все остальное остается под •••."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** இல் தட்டச்சு செய்யும்போது விசைப்பலகைக்கு மேலே காண்பிக்கப்படும். விரும்பும் அளவுக்குப் பொருத்தவும் — வரிசை பக்கவாட்டில் உருளும். மற்றவை அனைத்தும் ••• இன் கீழ் இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเหนือแป้นพิมพ์เมื่อคุณพิมพ์ใน **%@** ปักหมุดได้มากเท่าที่ต้องการ — แถวจะเลื่อนไปด้านข้าง รายการอื่นทั้งหมดจะอยู่ใต้ •••"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** içine yazdığınızda klavyenin üstünde gösterilir. İstediğiniz kadar sabitleyin — satır yana kayar. Diğer her şey ••• altında kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показується над клавіатурою під час введення в **%@**. Закріплюйте скільки завгодно — ряд прокручується вбік. Усе інше залишається під •••."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ **%@** میں ٹائپ کرتے ہیں تو کی بورڈ کے اوپر دکھایا جاتا ہے۔ جتنے چاہیں پن کریں — قطار بغلی سمت میں اسکرول ہوتی ہے۔ باقی سب کچھ ••• کے تحت رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị phía trên bàn phím khi bạn nhập vào **%@**. Ghim bao nhiêu tùy thích — hàng này cuộn ngang được. Mọi thứ khác vẫn nằm trong •••."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@** 中输入时显示在键盘上方。可固定任意数量——该行可横向滚动。其他所有操作都保留在 ••• 下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 **%@** 中輸入時顯示在鍵盤上方。可釘選任意數量——該列可橫向捲動。其他所有動作都保留在 ••• 下。"
          }
        }
      }
    },
