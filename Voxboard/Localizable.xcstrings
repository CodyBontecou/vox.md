    "Use multiline Markdown or a leading --- YAML frontmatter block. Available tokens: {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {year}, {YR} (2-digit year), {month}, {day}, {week}, {source}, {id8}, {id}, {location}.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام Multilin Markdown أو من يريد أن يُدعى له، YAML الـ Frontmatter Block. تكنولوجيا تكنولوجية متاحة: {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {year}, {YR} (بعد عامين من الزمن) {month}, {day}, {week}, {source}, {id8}, {id}, {location}."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাল্টিলাইন ব্যবহার Markdown অথবা নেতৃত্বে। YAML ফ্রন্টম্যাটার ব্লক উপলব্ধ টোকেন: {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {year}, {YR} (২০ বছর পর) {month}, {day}, {week}, {source}, {id8}, {id}, {location}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie mehrzeiliges Markdown oder einen führenden --- YAML-Frontmatter-Block. Verfügbare Tokens: {date}, {time}, {hour}, {minute}, {second}, {timestamp}, {year}, {YR} (zweistelliges Jahr), {month}, {day}, {week}, {source}, {id8}, {id}, {location}."
          }
        },
        "en": {
