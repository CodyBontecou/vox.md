    "Capture on Watch. Syncs to iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل على Watch. تتم المزامنة مع iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-এ রেকর্ড করুন। iPhone-এর সঙ্গে সিঙ্ক হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
