    "Configure processing, vault routes, entry formatting, attachments, and retry behavior.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكوين معالجة، مسارات الحفر، وتشكيل الدخول، والتحف، وممارسة التعامل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রক্রিয়াকরণ, কভল রুট, ইন্ট্রি ফরম্যাটিং, অ্যাডেঞ্জিং এবং রিট্রাই আচরণ কনফিগার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie Verarbeitung, Vault-Routen, Eintragsformatierung, Anhänge und Wiederholungsverhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
