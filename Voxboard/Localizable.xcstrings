          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione è sicura con il suo stato di posizione dell'ora di origine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画は、発信時の位置ステータスにより安全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 원본 시간 위치 상태로 안전합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
