    "Your words.\nYour own space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your words.\nYour own space."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلماتك. \n مساحتك الخاصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমার কথা। \n আপনার নিজস্ব স্থান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Worte. \n Dein eigener Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus palabras. \n Tu propio espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos mots. \n Votre propre espace."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके शब्द. \n आपका अपना स्थान।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-katamu. \n Ruang Anda sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue parole. \n Il tuo spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの言葉。 \nあなただけのスペース。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 말. \n 나만의 공간."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw woorden. \n Je eigen ruimte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje słowa. \n Twoja własna przestrzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas palavras. \n Seu próprio espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши слова. \n Ваше личное пространство."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் வார்த்தைகள். \n உங்கள் சொந்த இடம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำพูดของคุณ \n พื้นที่ของคุณเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senin sözlerin. \n Kendi alanınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші слова. \n Ваш власний простір."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے الفاظ. \n آپ کی اپنی جگہ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nói của bạn. \n Không gian riêng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的话。 \n您自己的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的話。 \n您自己的空間。"
          }
        }
      }
    },
