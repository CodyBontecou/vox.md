        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play sounds when recording starts, stops and sends"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir sonidos al iniciar, detener y enviar grabaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Émettre des sons au démarrage, à l’arrêt et à l’envoi d’un enregistrement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग शुरू होने, बंद होने और भेजे जाने पर साउंड चलाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar suara saat perekaman dimulai, berhenti, dan mengirim"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci suoni quando la registrazione inizia, si interrompe e viene inviata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音の開始、停止、送信時にサウンドを再生"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 시작, 중단 및 보내기 시 사운드 재생"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel geluiden af wanneer een opname start, stopt en wordt verstuurd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzaj dźwięki przy rozpoczęciu, zatrzymaniu nagrywania i wysłaniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduzir sons ao iniciar, parar e enviar gravações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводить звуки при начале, остановке и отправке записи"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு தொடங்கும்போது, நிற்கும்போது மற்றும் அனுப்பும்போது ஒலிகளை இயக்கு"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นเสียงเมื่อเริ่ม หยุด และส่งการบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt başladığında, durduğunda ve gönderildiğinde ses çal"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворювати звуки під час початку, зупинки й надсилання запису"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ شروع، بند اور بھیجنے پر آوازیں چلائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát âm thanh khi bắt đầu ghi, dừng ghi và gửi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音开始、停止和发送时播放声音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音開始、停止和傳送時播放聲音"
          }
        }
      }
    },
