        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกใน Watch, sync ไม่สามารถเข้าถึงได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleyin, Sync başarısız oldu"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти на годиннику, синхронізація не вдалося."
          }
        },
        "ur": {
