    "Capture could not be delivered. The transcript and audio are saved for retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إرسال السجلات. يتم تخزين الترجمة والفيديو لترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচারটি সরবরাহ করা সম্ভব হয়নি. ট্রান্সক্রিপ্ট এবং অডিও রিট্রির জন্য সংরক্ষিত হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erfassung konnte nicht zugestellt werden. Transkript und Audio sind für einen erneuten Versuch gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture could not be delivered. The transcript and audio are saved for retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo entregar la captura. El transcripto y el audio se guardan para retracer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture n'a pas pu être livrée.La transcription et l'audio sont enregistrées pour la révision."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर वितरित नहीं किया जा सका. ट्रांसक्रिप्ट और ऑडियो रीट्री के लिए संग्रहीत किए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat disampaikan. transcript dan audio disimpan untuk retry."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia non è stata consegnata.La trascrizione e l'audio sono salvati per la riproduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャは配信できませんでした. トランスクリプトとオーディオはリリースのために保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처가 전달되지 않았습니다. 트랜스프리트와 오디오는 리트리를 위해 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname kon niet worden geleverd.De transcript en audio worden opgeslagen voor retry."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można było dostarczyć nagrania. transkrypcja i audio są zapisywane do ponownego przetestowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A captura não foi possível.A transcrição e o áudio são salvos para retrabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись не могла быть доставлена. Транскрипт и аудио сохраняются для ретри."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது எழுத முடியாது.அதிகப்படியான பதிவுகள் மற்றும் பதிவிறக்கங்கள் மீண்டும் பதிவிறக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถส่งภาพถ่ายได้ การถ่ายภาพและเสียงจะถูกบันทึกไว้เพื่อรีเซ็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt yapılamadı.Kayıt ve ses kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис не вдалося доставити. Транскрипт і аудіо зберігаються для перегляду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپٹن فراہم نہیں کیا جا سکتا. ٹرانسپیٹ اور آڈیو ریڈنگ کے لئے محفوظ کیا جاتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp không thể được chuyển giao. Bản ghi và âm thanh được lưu để xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉无法交付. 转录和音频被保存为重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捕捉無法交付. 轉錄和音頻被保存為重複。"
          }
        }
      }
    },
    "Capture delivery is active. Wait a moment before discarding.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال الإرسال فعال. انتظر بضعة دقائق قبل إزالة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার ডেলিভারি সক্রিয়। অপেক্ষা করুন কিছু মুহূর্ত আগে বর্জ্য।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
