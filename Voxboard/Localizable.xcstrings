    "Allow the Quick Record widget/control to open Vox.md and immediately start recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لأداة التسجيل السريع بفتح Vox.md وبدء التسجيل فورًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত রেকর্ড উইজেটকে Vox.md খুলে সঙ্গে সঙ্গে রেকর্ডিং শুরু করতে দিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt dem Quick-Record-Widget/-Steuerelement, Vox.md zu öffnen und sofort mit der Aufnahme zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the Quick Record widget/control to open Vox.md and immediately start recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el widget Grabación rápida abra Vox.md e inicie la grabación de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise le widget Enregistrement rapide à ouvrir Vox.md et à démarrer immédiatement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्विक रिकॉर्ड विजेट को Vox.md खोलकर तुरंत रिकॉर्डिंग शुरू करने दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan widget Rekam Cepat membuka Vox.md dan langsung mulai merekam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti al widget Registrazione rapida di aprire Vox.md e iniziare subito a registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック録音ウィジェットからVox.mdを開き、すぐに録音を開始できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 녹음 위젯이 Vox.md를 열고 즉시 녹음을 시작하도록 허용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toe dat de widget Snel opnemen Vox.md opent en direct begint met opnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól widżetowi Szybkie nagrywanie otworzyć Vox.md i natychmiast rozpocząć nagrywanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o widget Gravação Rápida abra o Vox.md e comece a gravar imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить виджету быстрой записи открыть Vox.md и сразу начать запись."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரைவுப் பதிவு விட்ஜெட் Vox.md-ஐத் திறந்து உடனே பதிவைத் தொடங்க அனுமதி."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้วิดเจ็ตบันทึกด่วนเปิด Vox.md และเริ่มบันทึกทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı Kayıt araç takımının Vox.md’yi açıp hemen kayda başlamasına izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити віджету швидкого запису відкрити Vox.md і негайно почати запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فوری ریکارڈ ویجیٹ کو Vox.md کھول کر فوراً ریکارڈنگ شروع کرنے دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép tiện ích Ghi âm nhanh mở Vox.md và bắt đầu ghi ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许快速录音小组件打开 Vox.md 并立即开始录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許快速錄音小工具開啟 Vox.md 並立即開始錄音。"
          }
        }
      }
    },
