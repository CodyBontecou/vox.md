        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa bản lưu trong Hoạt động và Thư viện. Mọi tệp Markdown đã gửi vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除活动和资料库记录。已递送的 Markdown 文件会保留在原处。"
