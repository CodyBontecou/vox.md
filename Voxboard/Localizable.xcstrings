        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคำขอตำแหน่งที่กำลังดำเนินการอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir konum isteği zaten sürüyor."
          }
        },
        "uk": {
