    "Microphone access is required to attach a voice recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الوصول إلى ميكروفون لإدخال تسجيل صوت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি শব্দ রেকর্ডিং যোগ করার জন্য মাইক্রোফোন অ্যাক্সেস প্রয়োজন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Anhängen einer Sprachaufnahme ist Mikrofonzugriff erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is required to attach a voice recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere acceso al micrófono para conectar una grabación de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un microphone est nécessaire pour enregistrer une voix."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक वॉच रिकॉर्डिंग जोड़ने के लिए माइक्रोफोन पहुंच की आवश्यकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon diperlukan untuk menempelkan rekaman suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario un accesso al microfono per collegare una registrazione vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声録音を付けるにはマイクが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 녹음 첨부에 마이크 접속이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoon is vereist om een spraakopname aan te sluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołączanie mikrofonu jest wymagane do podłączenia nagrania głosowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone é necessário para anexar uma gravação de voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для записи голоса требуется доступ к микрофону."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மைக்ரோபிக் சேமிப்பு ஒரு Voice Recording சேமிப்பு தேவைப்படுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงไมโครโฟนเป็นสิ่งจําเป็นสําหรับการเชื่อมต่อการบันทึกเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kaydı eklemek için mikrofon erişimi gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до мікрофона необхідний для приєднання голосового запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک آواز کی ریکارڈنگ کے لئے مائیکروفون رسائی کی ضرورت ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truy cập microphone là cần thiết để đính kèm một bản ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麦克风接入才能附上语音录制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麥克風接入才能附上語音錄製。"
          }
        }
      }
    },
