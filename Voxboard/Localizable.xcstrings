            "state": "translated",
            "value": "Exemple de note · le vôtre peut commencer n'importe où"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उदाहरण नोट · आपकी शुरुआत कहीं से भी हो सकती है"
          }
        },
        "id": {
