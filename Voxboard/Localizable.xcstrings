    "Create a template to reuse prefixes, frontmatter, and suffixes across Presets.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء نموذج لاستخدام إعادة استخدام المفاتيح والمناهج الأساسية والمتعمدة في جميع أنواع الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefix, Frontmatter, এবং Prefix এর মাধ্যমে প্রাক-নাম ব্যবহার করার জন্য একটি টেম্পলেট তৈরি করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie eine Vorlage, um Präfixe, Frontmatter und Suffixe über Presets hinweg wiederzuverwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a template to reuse prefixes, frontmatter, and suffixes across Presets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear un modelo para reutilizar prefixos, frontmatter y sufixos en Presets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer un modèle pour réutiliser les préfixes, les frontmathères et les suffixes sur les Préfixes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefix, Frontmatter, और Prefix के माध्यम से प्लगइसेस का पुनः उपयोग करने के लिए एक टेम्पलेट बनाएं।"
