    "Vox.md could not get an origin-time location. Your Capture draft is preserved.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على Vox.md الحصول على موقع وقت الأصل. يتم الاحتفاظ بمسودة الالتقاط الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md একটি উৎপত্তি-সময় অবস্থান পেতে পারেনি। আপনার ক্যাপচার ড্রাফ্ট সংরক্ষিত আছে."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md konnte keinen Ursprungs-Zeit-Standort ermitteln. Ihr Capture-Entwurf bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md could not get an origin-time location. Your Capture draft is preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md no pudo obtener una ubicación de tiempo de origen. Su borrador de captura se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md n'a pas pu obtenir un emplacement origine-heure. Votre brouillon de Capture est conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md को मूल-समय स्थान नहीं मिल सका। आपका कैप्चर ड्राफ्ट सुरक्षित है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md tidak bisa mendapatkan lokasi waktu asal. Draf Tangkap Anda dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md non è riuscito a ottenere la posizione dell'ora di origine. La bozza di Capture viene conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md は原点時間の位置を取得できませんでした。キャプチャのドラフトは保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md가 원본 시간 위치를 가져올 수 없습니다. 귀하의 Capture 초안은 보존됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md kan geen oorsprong-tijdlocatie verkrijgen. Je Capture-concept blijft behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md nie mógł uzyskać lokalizacji w czasie pochodzenia. Wersja robocza programu Capture zostanie zachowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md não conseguiu obter a localização do horário de origem. Seu rascunho do Capture é preservado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md не удалось получить исходное время. Ваш черновик Capture сохраняется."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md மூலம் தோற்ற நேர இருப்பிடத்தைப் பெற முடியவில்லை. உங்கள் பிடிப்பு வரைவு பாதுகாக்கப்பட்டுள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ไม่สามารถรับตำแหน่งเวลาต้นทางได้ ร่างการจับภาพของคุณจะถูกเก็บรักษาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md başlangıç zamanı konumunu alamadı. Yakalama taslağınız korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md не вдалося отримати місце походження. Ваш проект Capture збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md کو اصل وقت کا مقام نہیں مل سکا۔ آپ کا کیپچر ڈرافٹ محفوظ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md không thể có được vị trí thời gian gốc. Bản nháp Capture của bạn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 无法获取起始时间位置。您的 Capture 草稿将被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 無法取得起始時間位置。您的 Capture 草稿將會保留。"
          }
        }
      }
    },
