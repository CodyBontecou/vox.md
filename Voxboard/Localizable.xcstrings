    "Adds an Obsidian-style `![[recording.m4a]]` link to the note so you can replay the recording while reviewing the transcript.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضاف الرابط Obsidian-style `![[recording.m4a]]` إلى الملاحظة حتى يمكنك إعادة إعطاء المسجل أثناء مراجعة الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ করুন Obsidianস্টাইল `![[recording.m4a]]` নোটের সাথে লিঙ্ক করুন যাতে আপনি রেকর্ডটি পুনরায় পুনরায় পুনরায় পুনরায় পুনরায় পুনরায় প"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt der Notiz einen Obsidian-Link im Stil `![[recording.m4a]]` hinzu, damit Sie die Aufnahme beim Durchsehen des Transkripts wiedergeben können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds an Obsidian-style `![[recording.m4a]]` link to the note so you can replay the recording while reviewing the transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "añade un Obsidian- Estilo `![[recording.m4a]]` enlace a la nota para que pueda reproducir la grabación mientras revisaba el transcripto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une Obsidian- style `![[recording.m4a]]` lien vers la note afin que vous puissiez reproduire l'enregistrement tout en examinant la transcription."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक जोड़ें Obsidianशैली `![[recording.m4a]]` नोट पर लिंक करें ताकि आप प्रतिलिपि की समीक्षा करते समय रिकॉर्ड को फिर से खेलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan satu Obsidiangaya `![[recording.m4a]]` menghubungkan ke catatan sehingga Anda dapat memainkan rekaman kembali saat meninjau transkrip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un Obsidian- Stile `![[recording.m4a]]` collegamento alla nota in modo da poter riprodurre la registrazione durante la revisione della trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加 1 Obsidianスタイル `![[recording.m4a]]` メモにリンクし、レコーディングを再生する際にトランスクリプトをレビューできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가하기 Obsidian스타일 `![[recording.m4a]]` 메모에 링크하여 기록을 재생할 수 있도록 트랜스프리스트를 검토합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een Obsidian- stijl `![[recording.m4a]]` een link naar de notitie, zodat u de opname kunt herspelen terwijl u de transcript bekijkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj do Obsidian- styl `![[recording.m4a]]` link do notatki, aby można było odtwarzać nagranie podczas przeglądania transkrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um Obsidian- Estilo `![[recording.m4a]]` ligação à nota para que você possa reproduzir a gravação enquanto rever a transcrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить 1 Obsidian- стиль `![[recording.m4a]]` ссылка на запись, чтобы вы могли воспроизводить запись во время просмотра транскрипта."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு சேர்க்க ObsidianStyle `![[recording.m4a]]` நீங்கள் எழுதப்பட்ட பதிவை மீண்டும் பார்க்கும் போது எழுதப்பட்ட பதிவை மீண்டும் எழுத முடியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม Obsidianสไตล์ `![[recording.m4a]]` เชื่อมโยงไปยังบันทึกเพื่อให้คุณสามารถเล่นซ้ําการบันทึกขณะตรวจสอบการถ่ายภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekleme yapın Obsidiantarzı `![[recording.m4a]]` Not'a bağlantı kurarak kayıtları kopyalama sırasında tekrar oynatabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте один Obsidianстиль `![[recording.m4a]]` посилання на ноту, щоб ви могли відтворювати запис під час перегляду транскрипту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شامل کریں Obsidianسٹائل `![[recording.m4a]]` نوٹ پر لنک کریں تاکہ آپ ٹرانسفر کو دیکھتے وقت ریکارڈ دوبارہ کھیل سکتے ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một Obsidian- Phong cách `![[recording.m4a]]` liên kết đến ghi chú để bạn có thể phát lại bản ghi trong khi xem lại bản ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个 Obsidian风格 `![[recording.m4a]]` 链接到笔记,这样您可以在审查转录时重播录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一個 Obsidian風格 `![[recording.m4a]]` 鏈接到筆記,這樣您可以在審查轉錄時重播錄音。"
          }
        }
      }
    },
    "Adds an Obsidian-style audio link to the unified Markdown note at the selected position.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضاف رابط الصوت في شكل Obsidian إلى الملاحظة Markdown المتوافق مع المكان المختار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ করুন Obsidian-স্টাইল অডিও লিঙ্ক ইউনিফাইড Markdown নির্বাচনকৃত অবস্থানে নোট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt der zusammengeführten Markdown-Notiz an der gewählten Position einen Obsidian-Audiolink hinzu."
          }
        },
        "en": {
          "stringUnit": {
