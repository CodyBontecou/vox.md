    "The transcript could not be attached, but the audio recording is safely staged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إدخال الترجمة ، ولكن يتم ضبط الصوت بأمان."
