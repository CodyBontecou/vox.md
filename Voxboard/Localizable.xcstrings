    "Retained for existing shortcuts. New shortcuts should choose only a Capture Preset.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تختار المفاجآت الجديدة فقط إعداداً سابقاً للانتقال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন সংক্ষিপ্তগুলি শুধুমাত্র একটি ক্যাপচার প্রাসঙ্গিক নির্বাচন করতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für bestehende Tastenkürzel beibehalten. Neue Tastenkürzel sollten nur ein Aufnahme-Preset wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retained for existing shortcuts. New shortcuts should choose only a Capture Preset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenido para los cortes existentes.Los nuevos cortes deben elegir sólo un Predefinición de captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenu pour les raccourcis existants. Les raccourcis ne doivent choisir qu'un Préfet de capture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा त्वरित कनेक्शन के लिए रखा गया है. नए त्वरित कनेक्शन को केवल एक कैप्चर पूर्वावलोकन चुनना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk pemutakhiran yang sudah ada, pemutakhiran baru harus memilih preset Capture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritenuto per le scorciatoie esistenti. Le nuove scorciatoie dovrebbero scegliere solo una preimpostazione di cattura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のショートカットのために保存されます 新しいショートカットは、キャプチャプレセットのみを選択する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존의 단축을 위해 유지됩니다.새로운 단축은 캡처 미리 설정만 선택해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard voor bestaande snelkoppelingen. Nieuwe snelkoppelingen moeten alleen een Capture Preet kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymane dla istniejących skrótów. Nowe skróty powinny wybrać tylko ustawienie Predefiniowania przechwytywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenção para atalhos existentes. Novos atalhos devem escolher apenas uma Predefinição de Capture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые штрихи должны выбирать только предварительный настройки."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய விதிமுறைகள், புதிய விதிமுறைகள் மட்டுமே ஒரு Capture Preset தேர்வு செய்ய வேண்டும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกสําหรับสั้น ๆ ที่มีอยู่ สั้น ๆ ใหม่ควรเลือกการตั้งค่าล่วงหน้าการจับภาพเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni anahtar kelimeler sadece bir Capture Preset seçmelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишається для існуючих коротких прокладок. Нові короткі проклади повинні вибрати тільки попереднє налаштування захоплення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودہ سکرین کے لئے محفوظ کیا گیا. نئے سکرین کو صرف ایک کٹنگ پیشگی ترتیبات کا انتخاب کرنا چاہئے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ lại cho các phím tắt hiện có. phím tắt mới chỉ nên chọn một Pre-Set Capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有的快捷捷捷径被保留,新快捷捷捷径只应选择 Capture Preet。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有的快捷捷捷徑被保留,新快捷捷捷徑只應選擇 Capture Preet。"
          }
        }
      }
    },
