    "Speaker labels are added after transcription.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إضافة علامات الكاتب بعد الترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সপ্লোর পরে স্পিকার ট্যাবলেট যোগ করা হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
