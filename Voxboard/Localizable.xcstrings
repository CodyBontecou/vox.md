        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기 세그먼트를 저장할 수 없어 재시도합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dicteersegment kon niet worden bewaard en wordt opnieuw geprobeerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać fragmentu dyktowania; zostanie ponowiony"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar um segmento de ditado; ele será tentado novamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить фрагмент диктовки; попытка будет повторена"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு டிக்டேஷன் பகுதியைச் சேமிக்க முடியவில்லை, மீண்டும் முயற்சிக்கப்படும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกส่วนการป้อนตามคำบอกได้ และจะลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dikte bölümü kaydedilemedi ve yeniden denenecek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти фрагмент диктування; спробу буде повторено"
