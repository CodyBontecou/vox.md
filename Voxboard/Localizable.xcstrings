    "Capture drafts, Library, routes, templates, and diagnostics remain in local app storage.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى مسودات الالتقاط والمكتبة والمسارات والقوالب والتشخيصات في التخزين المحلي للتطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপচার খসড়া, লাইব্রেরি, রুট, টেমপ্লেট ও ডায়াগনস্টিকস অ্যাপের স্থানীয় স্টোরেজে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassungsentwürfe, Mediathek, Routen, Vorlagen und Diagnosedaten bleiben im lokalen App-Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture drafts, Library, routes, templates, and diagnostics remain in local app storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los borradores de captura, la biblioteca, las rutas, las plantillas y el diagnóstico permanecen en el almacenamiento local de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les brouillons de capture, la bibliothèque, les parcours, les modèles et les diagnostics restent dans le stockage local de l’app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर ड्राफ़्ट, लाइब्रेरी, रूट्स, टेम्पलेट और डायग्नोस्टिक्स स्थानीय ऐप स्टोरेज में रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf tangkapan, Pustaka, rute, templat, dan diagnostik tetap berada di penyimpanan app lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozze di acquisizione, Libreria, percorsi, modelli e diagnostica restano nello spazio locale dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャの下書き、ライブラリ、ルート、テンプレート、診断情報はローカルのアプリストレージに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처 초안, 보관함, 루트, 템플릿 및 진단 정보는 로컬 앱 저장 공간에 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastlegconcepten, bibliotheek, routes, sjablonen en diagnostische gegevens blijven in de lokale appopslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersje robocze przechwyceń, Biblioteka, trasy, szablony i diagnostyka pozostają w lokalnej pamięci aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rascunhos de captura, Biblioteca, rotas, modelos e diagnósticos permanecem no armazenamento local do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновики захватов, библиотека, маршруты, шаблоны и диагностика остаются в локальном хранилище приложения."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிடிப்பு வரைவுகள், நூலகம், வழித்தடங்கள், வார்ப்புருக்கள் மற்றும் கண்டறிதல்கள் உள்ளூர் ஆப் சேமிப்பகத்திலேயே இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉบับร่างการจับภาพ คลัง เส้นทาง เทมเพลต และข้อมูลการวินิจฉัยจะอยู่ในพื้นที่จัดเก็บของแอปในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakalama taslakları, Arşiv, rotalar, şablonlar ve tanılama verileri yerel uygulama depolamasında kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чернетки захоплень, бібліотека, маршрути, шаблони й діагностика залишаються в локальному сховищі застосунку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپچر ڈرافٹس، لائبریری، روٹس، ٹیمپلیٹس اور تشخیص ایپ کے مقامی اسٹوریج میں رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản nháp ghi nhanh, Thư viện, lộ trình, mẫu và dữ liệu chẩn đoán được giữ trong bộ nhớ cục bộ của ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集草稿、资料库、路线、模板和诊断信息都保留在本地 App 存储中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取草稿、資料庫、路線、範本和診斷資訊都保留在本機 App 儲存空間中。"
          }
        }
      }
    },
