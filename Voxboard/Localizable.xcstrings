    "Finding your location took too long. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق تحديد موقعك وقتًا طويلًا. حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লোকেশন খুঁজতে খুব বেশি সময় লেগেছে। আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standortbestimmung hat zu lange gedauert. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding your location took too long. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tardó demasiado en encontrar tu ubicación. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche de votre position a pris trop de temps. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लोकेशन पता करने में बहुत समय लगा। पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian lokasi Anda terlalu lama. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rilevamento della posizione ha richiesto troppo tempo. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の取得に時間がかかりすぎました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 찾는 데 너무 오래 걸렸습니다. 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bepalen van je locatie duurde te lang. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustalanie lokalizacji trwało zbyt długo. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrar sua localização demorou demais. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определение геопозиции заняло слишком много времени. Повторите попытку."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இருப்பிடத்தைக் கண்டறிய அதிக நேரம் ஆனது. மீண்டும் முயலவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาตำแหน่งของคุณใช้เวลานานเกินไป ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuzu bulmak çok uzun sürdü. Tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначення геопозиції тривало надто довго. Спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مقام معلوم کرنے میں بہت وقت لگ گیا۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm vị trí của bạn mất quá nhiều thời gian. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找你的位置耗时过长。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找你的位置花費太久。請再試一次。"
          }
        }
      }
    },
