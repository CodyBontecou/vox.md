    "Update Vox.md on iPhone to use this recording's Route.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّث Vox.md على iPhone لاستخدام مسار هذا التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডিংয়ের রুট ব্যবহার করতে iPhone-এ Vox.md আপডেট করুন।"
