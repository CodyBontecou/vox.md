    "The recording is safe with its origin-time location status.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل آمن مع حالة موقعه الأصلي والوقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং এর উৎপত্তি-সময় অবস্থান অবস্থার সাথে নিরাপদ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist mit ihrem Standortstatus zum Ursprungszeitpunkt sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is safe with its origin-time location status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación es segura con su estado de ubicación de hora de origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement est sécurisé grâce à son statut de localisation origine-heure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग अपनी मूल-समय स्थान स्थिति के साथ सुरक्षित है।"
          }
        },
        "id": {
          "stringUnit": {
