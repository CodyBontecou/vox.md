    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy prompt explaining speech recognition.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md يستخدم Apple Speech لتسجيل تسجيلك المحلي أثناء الكلام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ব্যবহার Apple Speech আপনি কথা বলার সময় আপনার রেকর্ডটি স্থানীয়ভাবে ট্রান্সক্রিপ্ট করতে পারেন।"
