    "NSCameraUsageDescription": {
      "comment": "Privacy prompt explaining optional camera access.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md يستخدم الكاميرا فقط عندما تختار الصورة أو تشفيرها إلى الملاحظات المحلية Markdown."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ক্যামেরাটি কেবলমাত্র ব্যবহার করুন যখন আপনি একটি ছবি আঁকতে বা আপনার স্থানীয় Markdown নোট"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md die Kamera nur verwenden, wenn Sie sich entscheiden, ein Foto zu machen oder in Ihre Markdown Die Notizen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md uses the camera only when you choose to capture a photo or scan into your local Markdown notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md utiliza la cámara sólo cuando elija capturar una foto o escanear en su Markdown de notas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md n’utilisez l’appareil photo que lorsque vous choisissez de prendre une photo ou de scanner dans votre Markdown Les notes ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md केवल तब कैमरा का उपयोग करें जब आप एक तस्वीर लेने या अपने स्थानीय Markdown नोट्स"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md menggunakan kamera hanya ketika Anda memilih untuk mengambil foto atau memindai ke Markdown dengan nota."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md utilizza la fotocamera solo quando si sceglie di scattare una foto o di scansionare il Markdown di note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md カメラを使用する場合にのみ、写真を撮影するか、またはローカルにスキャンすることを選択します。 Markdown ノート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 카메라를 사용하면 사진을 찍거나 로컬로 스캔할 때만 사용합니다. Markdown 노트"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md gebruik de camera alleen wanneer u kiest om een foto te nemen of te scannen naar uw Markdown met notities."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md używać aparatu tylko wtedy, gdy wybierzesz możliwość wykonania zdjęcia lub skanowania do Markdown Notatki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md utilizar a câmera apenas quando optar por capturar uma foto ou digitalizar para o seu local de Markdown Notas de ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md использует фотокамеру только тогда, когда вы выбираете снять фотографию или сканировать в Markdown Ноты"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md நீங்கள் ஒரு படத்தை எழுதி அல்லது உங்கள் அலுவலகத்தில் ஸ்கேனிக்க விரும்பும் போது மட்டுமே கேமரா பயன்படுத்துகிறீர்கள். Markdown பதிவுகள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ใช้กล้องเฉพาะเมื่อคุณเลือกที่จะถ่ายภาพหรือสแกนไปยังสถานีของคุณ Markdown หมายเหตุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Kamerayı sadece fotoğraf çekmeyi veya yerel Markdown Notlar için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md використовує камеру тільки тоді, коли ви вирішите зробити знімки або сканувати в Markdown Нотатки"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md صرف جب آپ ایک تصویر کو پکڑنے یا آپ کے مقامی Markdown نوٹیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md chỉ sử dụng máy ảnh khi bạn chọn chụp ảnh hoặc quét vào Markdown ghi chú"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 仅当您选择拍摄照片或扫描到您的本地时使用相机。 Markdown 笔记本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 僅當您選擇拍攝照片或掃描到您的本地時使用相機。 Markdown 筆記本"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy prompt explaining optional location access.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحصل Vox.md على موقعك مرة واحدة فقط عند إدراج رابط خريطة، أو عند الإرسال أو إيقاف التسجيل باستخدام مسار مفعّل للموقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি মানচিত্রের লিঙ্ক ঢোকালে অথবা অবস্থান-সক্রিয় রুট দিয়ে পাঠালে বা রেকর্ডিং থামালে Vox.md একবারই আপনার অবস্থান নেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ermittelt deinen Standort einmalig, wenn du einen Kartenlink einfügst oder mit einer standortfähigen Route sendest bzw. eine Aufnahme stoppst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md gets your location once when you insert a map link, or when you send or stop recording with a location-enabled Route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md obtiene tu ubicación una sola vez al insertar un enlace de mapa, o al enviar o detener una grabación con una ruta que tenga activada la ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md obtient votre position une seule fois lorsque vous insérez un lien cartographique, ou lorsque vous envoyez ou arrêtez un enregistrement avec un parcours utilisant la localisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप मानचित्र लिंक डालते हैं, या स्थान-सक्षम रूट से भेजते हैं अथवा रिकॉर्डिंग रोकते हैं, तब Vox.md केवल एक बार आपका स्थान प्राप्त करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md mengambil lokasi Anda satu kali saat Anda menyisipkan tautan peta, atau saat mengirim atau menghentikan rekaman dengan Rute yang mengaktifkan lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md rileva la tua posizione una sola volta quando inserisci un link a una mappa oppure quando invii o interrompi una registrazione con un percorso abilitato alla posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md は、地図リンクを挿入するとき、または位置情報を有効にしたルートで送信もしくは録音を停止するときに、位置情報を一度だけ取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md는 지도 링크를 삽입하거나 위치가 활성화된 루트로 전송 또는 녹음을 중지할 때 위치를 한 번만 가져옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md bepaalt je locatie één keer wanneer je een kaartlink invoegt of wanneer je verzendt of een opname stopt met een route waarvoor locatie is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md pobiera Twoją lokalizację jeden raz, gdy wstawiasz łącze do mapy albo wysyłasz lub zatrzymujesz nagrywanie przy użyciu trasy z włączoną lokalizacją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vox.md obtém sua localização uma única vez quando você insere um link de mapa ou quando envia ou interrompe uma gravação com uma Rota que usa localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md однократно получает вашу геопозицию, когда вы вставляете ссылку на карту либо отправляете данные или останавливаете запись с помощью маршрута, в котором включена геопозиция."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் வரைபட இணைப்பைச் சேர்க்கும்போது அல்லது இருப்பிடம் இயக்கப்பட்ட வழித்தடத்துடன் அனுப்பும்போது அல்லது பதிவை நிறுத்தும்போது Vox.md உங்கள் இருப்பிடத்தை ஒருமுறை மட்டும் பெறுகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md จะรับตำแหน่งของคุณเพียงครั้งเดียวเมื่อคุณแทรกลิงก์แผนที่ หรือเมื่อส่งหรือหยุดการบันทึกด้วยเส้นทางที่เปิดใช้ตำแหน่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md, harita bağlantısı eklediğinizde veya konumun etkin olduğu bir rotayla gönderim yaptığınızda ya da kaydı durdurduğunuzda konumunuzu yalnızca bir kez alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md одноразово отримує вашу геопозицію, коли ви вставляєте посилання на карту або надсилаєте дані чи зупиняєте запис за допомогою маршруту з увімкненою геопозицією."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ نقشے کا لنک شامل کرتے ہیں، یا مقام فعال روٹ کے ساتھ بھیجتے یا ریکارڈنگ روکتے ہیں تو Vox.md صرف ایک بار آپ کا مقام حاصل کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md chỉ lấy vị trí của bạn một lần khi bạn chèn liên kết bản đồ, hoặc khi gửi hay dừng ghi âm bằng một lộ trình có bật vị trí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你插入地图链接，或使用已启用位置的路线发送内容或停止录音时，Vox.md 仅获取一次你的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你插入地圖連結，或使用已啟用位置的路線傳送內容或停止錄音時，Vox.md 僅取得一次你的位置。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy prompt explaining microphone access.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Vox.md الميكروفون عند اختيار الترجمة أو إدراج تسجيل صوت إلى ملاحظة Markdown المحلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md মাইক্রোফোন ব্যবহার করে যখন আপনি একটি ভাষণ ট্রান্সক্রিপশন বা একটি স্থানীয় Markdown নোট"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md das Mikrofon verwendet, wenn Sie die Rede transkribieren oder eine Sprachaufnahme an einen lokalen Markdown Notiz zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md uses the microphone when you choose to transcribe speech or attach a voice recording to a local Markdown note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md utiliza el micrófono cuando elige transcribir el habla o unir una grabación de voz a un Markdown Nota de ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Utilisez le microphone lorsque vous choisissez de transcrire une voix ou d’attacher une enregistrement vocale à un Markdown Note à noter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md जब आप भाषण का ट्रांसक्रिप्शन करने या एक स्थानीय Markdown नोट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md menggunakan mikrofon ketika Anda memilih untuk mencatat suara atau menempelkan rekaman suara ke Markdown Catatan yang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md utilizza il microfono quando si sceglie di trascrivere la voce o di collegare un'inserzione vocale a un Markdown di nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md マイクを使用して、スピーチを転写するか、ローカルに音声録音を付けることを選択する場合 Markdown ノート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md 마이크를 사용하여 음성을 전송하거나 로컬 녹음에 음성 녹음을 연결할 때 Markdown 노트"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md gebruikt de microfoon wanneer u kiest om spraak te transcriberen of een spraakopname aan een lokale Markdown Note op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md używa mikrofonu, gdy wybierasz transkrypcję mowy lub dołączanie nagrania głosowego do lokalnego Markdown Notatka"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md utiliza o microfone quando opta por transcrever a fala ou anexar uma gravação de voz a um Markdown Notas em ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md использует микрофон, когда вы выбираете транскрипцию речи или прикрепление записи голоса к локальному Markdown Нотарий ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md நீங்கள் பேச்சை transcribe அல்லது ஒரு இடத்தில் ஒரு பேச்சு எழுத்து இணைக்க தேர்வு போது மைக்ரோபிக் பயன்படுத்துகிறது. Markdown எழுதினேன்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md ใช้ไมโครโฟนเมื่อคุณเลือกที่จะถ่ายทอดการพูดหรือแนบบันทึกเสียงไปยัง Markdown หมายเหตุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md Konuşmayı transkripte etmeyi veya bir ses kaydı yerel bir Markdown Notları"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vox.md використовує мікрофон, коли ви вирішите транскритувати мовлення або приєднати голосовий запис до локального Markdown Нотація ."
