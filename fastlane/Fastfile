default_platform(:ios)

APP_ID = "bontecou.Voxboard"
API_KEY_ID = "T7KGDK4Y4V"
API_ISSUER_ID = "6c3b3640-c6bf-40a9-b6e5-57cda2c7776e"
API_KEY_PATH = "/Users/codybontecou/dev/AuthKey_T7KGDK4Y4V.p8"

# The App Store version every lane targets: the app's MARKETING_VERSION
# (Voxboard.xcodeproj), unless VOX_APP_VERSION overrides it. deliver creates
# the version in App Store Connect if it does not exist yet.
def app_version
  return ENV["VOX_APP_VERSION"] if ENV["VOX_APP_VERSION"].to_s != ""
  pbxproj = File.read(File.expand_path("../Voxboard.xcodeproj/project.pbxproj", __dir__))
  versions = pbxproj.scan(/"?MARKETING_VERSION"?\s*=\s*"?([0-9][0-9.]*)"?;/).flatten.uniq
  UI.user_error!("Expected one MARKETING_VERSION in the project, found #{versions.inspect}") unless versions.length == 1
  versions.first
end

def connect_api_key
  app_store_connect_api_key(
    key_id: API_KEY_ID,
    issuer_id: API_ISSUER_ID,
    key_filepath: API_KEY_PATH,
    in_house: false
  )
end

platform :ios do
  desc "Show current app info on App Store Connect"
  lane :info do
    connect_api_key
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.message("App: #{app.name} (#{app.bundle_id})")

    edit = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    if edit
      UI.message("Edit version: #{edit.version_string} — state: #{edit.app_store_state}")
      build = edit.build
      if build
        UI.message("  Attached build: #{build.version} (id: #{build.id})")
      else
        UI.message("  No build attached to edit version")
      end
      localizations = edit.get_app_store_version_localizations
      localizations.each do |loc|
        UI.message("  Locale: #{loc.locale}")
        sets = loc.get_app_screenshot_sets
        sets.each do |set|
          UI.message("    #{set.screenshot_display_type}: #{set.app_screenshots.count} screenshots")
        end
      end
    else
      UI.message("No edit version found")
    end

    live = app.get_live_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    if live
      UI.message("Live version: #{live.version_string} — state: #{live.app_store_state}")
    else
      UI.message("No live version found")
    end
  end

  desc "Upload metadata only"
  lane :upload_metadata do
    api_key = connect_api_key
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: app_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      force: true,
      platform: "ios"
    )
  end

  desc "Upload screenshots only"
  lane :upload_screenshots do
    api_key = connect_api_key
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: app_version,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true,
      platform: "ios"
    )
  end

  desc "Upload metadata + screenshots"
  lane :upload_all do
    api_key = connect_api_key
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: app_version,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true,
      platform: "ios"
    )
  end

  desc "Submit for review (uploads metadata + screenshots first)"
  lane :submit do
    api_key = connect_api_key
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      app_version: app_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      platform: "ios",
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end

  desc "List recent builds and processing state"
  lane :builds do
    connect_api_key
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      sort: "-uploadedDate",
      limit: 5,
      includes: "preReleaseVersion,buildBetaDetail"
    )
    builds.each do |b|
      ver = b.pre_release_version&.version || "?"
      UI.message("Build #{ver} (#{b.version}) — processing: #{b.processing_state}, uploaded: #{b.uploaded_date}")
    end
  end
