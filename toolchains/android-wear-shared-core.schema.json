          "const": "Packages/vox-core-rust/scripts/generate-kotlin-bindings.sh"
        },
        "swiftOutputPaths": {
          "const": [
            "Packages/vox-core-rust/generated/swift/VoxCore.swift",
            "Packages/vox-core-rust/generated/swift/VoxCoreFFI.h",
            "Packages/vox-core-rust/generated/swift/VoxCoreFFI.modulemap"
          ]
        },
        "kotlinOutputPaths": {
          "const": [
            "Packages/vox-core-rust/generated/kotlin/md/vox/core/vox_core_uniffi.kt"
          ]
        },
        "hashStatus": {
          "const": "governed-implemented"
        }
      }
    },
    "governedImplementationFiles": {
      "type": "array",
      "minItems": 101,
      "maxItems": 101,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
